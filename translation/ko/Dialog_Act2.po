#.     - dabae899-687d-63cd-74ea-746f1b4dd5ca_A = False
#.     - dabae899-687d-63cd-74ea-746f1b4dd5ca_C = False
#.     - dabae899-687d-63cd-74ea-746f1b4dd5ca_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister:5ea33568-c9af-43b8-8a99-f9af829ac392
msgctxt "h01cb1841g5d47g4aa6g8904gddc9c13a2eaa"
msgid "*Sigh*"
msgstr "*한숨*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister
#. Speaker = Lia
#. NodeID = 91bda6ab-b5e2-4b9c-8264-f0e73ac4959b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dabae899-687d-63cd-74ea-746f1b4dd5ca_B = True
#. SetFlags:
#.   Local:
#.     - dabae899-687d-63cd-74ea-746f1b4dd5ca_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister:91bda6ab-b5e2-4b9c-8264-f0e73ac4959b
msgctxt "h3589e521g2ac7g411bg8424g305474c526b2"
msgid "I could leave - walk into the darkness and never look back."
msgstr "뒤도 돌아 보지 않고 어둠 속으로 떠날 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister
#. Speaker = Lia
#. NodeID = 9dff8080-d705-4c46-a0ae-7a36494fe9af
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - dabae899-687d-63cd-74ea-746f1b4dd5ca_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister:9dff8080-d705-4c46-a0ae-7a36494fe9af
msgctxt "h0438baa1g1026g4daeg97c8g9419e7fabb34"
msgid "Insufferable, arrogant little prick. <i>Argh.</i>"
msgstr "저 건방진 새끼는, 참을 수가 없어. <i>아휴.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister
#. Speaker = Lia
#. NodeID = c60126c9-e9b7-7ffd-c6ff-11172d1255df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister:c60126c9-e9b7-7ffd-c6ff-11172d1255df
msgctxt "hf7f9c40fg55e3g45e3gb5b9g780723da75c4"
msgid "Rolan isn't a kid - who says I have to keep an eye on him?"
msgstr "롤란은 애가 아니야. 대체 내가 왜 걜 돌봐야 하는 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister
#. Speaker = Lia
#. NodeID = fc1288b2-bac9-400a-a191-ce6ae0a61c56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dabae899-687d-63cd-74ea-746f1b4dd5ca_A = True
#. SetFlags:
#.   Local:
#.     - dabae899-687d-63cd-74ea-746f1b4dd5ca_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_AngrySister:fc1288b2-bac9-400a-a191-ce6ae0a61c56
msgctxt "h46fd712cg5b1cg4ba8g897dg4eea7fc16862"
msgid "Cal..."
msgstr "칼..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Umi
#. NodeID = 281c3595-d1b5-2011-eb44-db3d72afe60b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_MolKidnapped = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:281c3595-d1b5-2011-eb44-db3d72afe60b
msgctxt "h9115957agf339g4174gbc66g61206f3b0551"
msgid "I know. I just wish Mol was here."
msgstr "나도 알아. 그냥 몰이 여기 있었으면 좋겠다 싶어서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Umi
#. NodeID = 310faeed-46b2-4c9f-abb2-603ebbd87ba8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:310faeed-46b2-4c9f-abb2-603ebbd87ba8
msgctxt "h15bca131gd364g42c3ga772g28767464a1f8"
msgid "Mol says if you like it, it means you're a grown-up."
msgstr "몰이 그러는데 그게 맛있으면 어른이 됐다는 증거래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Umi
#. NodeID = 3222e29f-5e19-026a-8cf6-3b98b8ff845b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:3222e29f-5e19-026a-8cf6-3b98b8ff845b
msgctxt "h490e4c0fg1db6g4fb6g9e12g22dc0bbd3c6f"
msgid "Yeah. For now."
msgstr "그렇지, 지금은."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Umi
#. NodeID = 401c7da4-38d7-29fb-4d25-ad088c1d0870
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:401c7da4-38d7-29fb-4d25-ad088c1d0870
msgctxt "h94167309g7711g4b3bg81a3ga4214dd6c0e2"
msgid "I dunno. I don't think Mol would like that..."
msgstr "글쎄. 몰이 좋아할 것 같진 않은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Umi
#. NodeID = 4a4678ac-5543-bf29-7601-91803c16373a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:4a4678ac-5543-bf29-7601-91803c16373a
msgctxt "h58f82542ge727g4f8bg9d3dg48cb4eebce55"
msgid "Yeah... yeah, she did."
msgstr "그래... 그랬었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Ide
#. NodeID = 50d1dea4-b5eb-9074-52d5-9e2899129382
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:50d1dea4-b5eb-9074-52d5-9e2899129382
msgctxt "h4d38dcc9g01e8g46c5gaa69g8edacc86a011"
msgid "It's all right, at least we're safe."
msgstr "괜찮아, 적어도 우린 무사하잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Umi
#. NodeID = 5898d356-71d8-4d3b-8953-887b9a26d1c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:5898d356-71d8-4d3b-8953-887b9a26d1c3
msgctxt "h77e95413gf2c8g4566g9871gd963602eb1d1"
msgid "Yeah, let's ask Mol!"
msgstr "그래, 몰한테 물어보자!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Umi
#. NodeID = 73a7b3d6-83ef-cdda-5c5b-5ca6389c3c3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:73a7b3d6-83ef-cdda-5c5b-5ca6389c3c3d
msgctxt "he8a5d067g4b8cg4f6ega9a7gd76bf73ad376"
msgid "No. I'm all right."
msgstr "아니. 괜찮아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Ide
#. NodeID = 7bc1463f-df6c-4b38-9870-c88d8a5b7b8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Unprotected = False
#.      - HAV_Mood_State_Alert = False
#.   Local:
#.      - 16f542b8-5ef8-49a4-33e7-495ec95944b2_B = True
#. SetFlags:
#.   Local:
#.     - 16f542b8-5ef8-49a4-33e7-495ec95944b2_B = False
#.     - 16f542b8-5ef8-49a4-33e7-495ec95944b2_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:7bc1463f-df6c-4b38-9870-c88d8a5b7b8b
msgctxt "h0c916802g6e9dg4491ga59eg2f3748ad30f6"
msgid "Careful, don't drop anything."
msgstr "조심해, 아무것도 떨어트리면 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Umi
#. NodeID = 7f88a907-d5e9-b1e8-21d4-46b41fa201a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:7f88a907-d5e9-b1e8-21d4-46b41fa201a6
msgctxt "hde18b25ag508ag46f2g9399g467752a50448"
msgid "Those stupid ghouls - they ruined everything!"
msgstr "이 멍청한 구울같으니, 죄다 부셔놨잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Ide
#. NodeID = 84e025a3-0932-fd77-c968-94b1543d4976
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:84e025a3-0932-fd77-c968-94b1543d4976
msgctxt "hed40c601g119cg4c49g8b82g894c846c9f28"
msgid "'Course! Mol said we would."
msgstr "당연하지! 몰이 할 수 있다고 했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Ide
#. NodeID = 88550632-6ca4-462e-9876-627906e7de8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Unprotected = False
#.      - HAV_Mood_State_Alert = False
#. SetFlags:
#.   Local:
#.     - 16f542b8-5ef8-49a4-33e7-495ec95944b2_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:88550632-6ca4-462e-9876-627906e7de8c
msgctxt "ha9d85335gb074g4c20gb26ega4cc9fd068c3"
msgid "I had a sip from a bottle someone didn't finish. It wasn't very nice."
msgstr "누가 남긴 게 있어서 살짝 마셔봤거든, 되게 별로더라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Ide
#. NodeID = 8e1e24f9-82c4-4d7f-85de-94fc9f2d89b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Unprotected = False
#.      - HAV_Mood_State_Alert = False
#.   Local:
#.      - 16f542b8-5ef8-49a4-33e7-495ec95944b2_A = True
#. SetFlags:
#.   Local:
#.     - 16f542b8-5ef8-49a4-33e7-495ec95944b2_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:8e1e24f9-82c4-4d7f-85de-94fc9f2d89b5
msgctxt "h2667845fg909bg45efg953fg35aa0e8f5f71"
msgid "This is easy! We should open our own place in Baldur's Gate."
msgstr "완전 쉬운데! 발더스 게이트에 우리만의 가게를 여는 건 어떨까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Ide
#. NodeID = a9680ee8-803d-2af9-6e1c-06a82de5be4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 16f542b8-5ef8-49a4-33e7-495ec95944b2_A = True
#. SetFlags:
#.   Local:
#.     - 16f542b8-5ef8-49a4-33e7-495ec95944b2_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:a9680ee8-803d-2af9-6e1c-06a82de5be4b
msgctxt "hd7317274g27d3g4fbegb7f3gda7cd0a11d9d"
msgid "Found another broken glass."
msgstr "깨진 유리잔이 또 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Ide
#. NodeID = ac165984-caa4-f0c5-c937-69c79793c6d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:ac165984-caa4-f0c5-c937-69c79793c6d3
msgctxt "h53e3fac8g4c45g4c1egb455gff9c1c79083f"
msgid "Still said it, didn't she? And Mol's not been wrong yet."
msgstr "몰이 말한 거잖아, 그치? 걔 말은 한 번도 틀린 적 없다구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Ide
#. NodeID = af247868-fbbd-5a67-7c7c-a2e062ee6896
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:af247868-fbbd-5a67-7c7c-a2e062ee6896
msgctxt "hd77e3c1fg5591g4a8cgaa8fgde2bcddee23f"
msgid "I thought maybe we could just do it ourselves?"
msgstr "그냥 우리끼리 하면 안 될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Ide
#. NodeID = b5ee5db0-c0eb-12a1-94e8-d752a97c399c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 16f542b8-5ef8-49a4-33e7-495ec95944b2_B = True
#. SetFlags:
#.   Local:
#.     - 16f542b8-5ef8-49a4-33e7-495ec95944b2_B = False
#.     - 16f542b8-5ef8-49a4-33e7-495ec95944b2_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:b5ee5db0-c0eb-12a1-94e8-d752a97c399c
msgctxt "he8426c40gdb8fg4ec1g9a9ega10e0777dace"
msgid "Want to mix up some drinks and see what we make?"
msgstr "여기 음료들 섞으면 뭐가 만들어지나 한번 해보지 않을래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Umi
#. NodeID = be12f1ab-926f-4551-ab05-63b82572af94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:be12f1ab-926f-4551-ab05-63b82572af94
msgctxt "h58586071g8bfag4ccfg9543g5bde10933c31"
msgid "I didn't drop anything!"
msgstr "안 떨어트렸거든!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Umi
#. NodeID = ce288df1-9632-90bf-054a-dd51846a5e33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_MolKidnapped = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:ce288df1-9632-90bf-054a-dd51846a5e33
msgctxt "hb0d51283g5ba1g4c8bgb584g0c7d298d4412"
msgid "But Mol isn't here, though."
msgstr "그치만 몰은 여기 없는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Umi
#. NodeID = d78d9ef4-314a-5933-a3cc-5f47cef3dce6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 16f542b8-5ef8-49a4-33e7-495ec95944b2_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:d78d9ef4-314a-5933-a3cc-5f47cef3dce6
msgctxt "h8922b979gb6b2g4199gb5c2g001a4115e6c2"
msgid "You think we're ever gonna get to Baldur's Gate?"
msgstr "우리가 발더스 게이트에 도착할 수 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Ide
#. NodeID = f4f93876-c6e8-eb88-5b0d-47f4dbaeda74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:f4f93876-c6e8-eb88-5b0d-47f4dbaeda74
msgctxt "h42dabe2agbe54g4252gbf8cgf6739e8367ad"
msgid "Good! Keep not dropping things."
msgstr "좋아! 계속 그렇게 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids
#. Speaker = Ide
#. NodeID = fb1b948c-1c3a-85cf-d8ac-9c022d41eef7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BartendingKids:fb1b948c-1c3a-85cf-d8ac-9c022d41eef7
msgctxt "h78f0b3e9gf9dbg41cagb217gf1b8c4d843a5"
msgid "Being a grown-up tastes awful."
msgstr "어른의 맛은 쓰구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = 03b9c46d-9bfc-43ba-95d9-6f067d24c830
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:03b9c46d-9bfc-43ba-95d9-6f067d24c830
msgctxt "h3886779bgcc59g4278g88efg78b954175989"
msgid "Run through the escape again, leave nothing out."
msgstr "한 번 더 탈출해, 아무도 남기지 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = 072e3a0c-229d-1269-6841-1e7d5a103e00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:072e3a0c-229d-1269-6841-1e7d5a103e00
msgctxt "hccf614e2ge9d6g4922gab22gcaddd70fcac5"
msgid "I need details - time, place, perpetrator."
msgstr "더 자세하게 알아야 해. 시간, 장소, 범인."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Lia
#. NodeID = 0ef0258e-1cd6-4981-92b4-9858de579c23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:0ef0258e-1cd6-4981-92b4-9858de579c23
msgctxt "hb139e92aga765g44e3g9514g88d504f346f0"
msgid "No."
msgstr "안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = 1fd24a99-0d58-4fcf-b720-ee9a2d3db9fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 28259eb0-5f20-5094-45f1-3292253ae1ed_C = True
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_A = False
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_C = False
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:1fd24a99-0d58-4fcf-b720-ee9a2d3db9fa
msgctxt "h968deefcg2d5bg4a23g845dg88085f91bcf9"
msgid "None of this would have happened if you had simply listened to me."
msgstr "내 말만 들었어도 이런 일은 일어나지 않았을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Lia
#. NodeID = 24edaf68-09ee-4c23-a357-d0c2e7ab0f1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 28259eb0-5f20-5094-45f1-3292253ae1ed_B = True
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:24edaf68-09ee-4c23-a357-d0c2e7ab0f1b
msgctxt "h033ecc71gf952g40e2gaee7g5e01447cab8e"
msgid "Gods, you smell like a <i>brewery.</i>"
msgstr "와, 무슨 <i>양조장</i>냄새가 나냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Cal
#. NodeID = 2ad2c532-031b-4398-a8da-5d72480c5d82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:2ad2c532-031b-4398-a8da-5d72480c5d82
msgctxt "h67ed8315g4abfg4e61ga57ag5fb9dc328274"
msgid "Rolan, please."
msgstr "롤란, 제발."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = 2e5702d4-d6ec-4cab-a300-fea42be3cb2b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:2e5702d4-d6ec-4cab-a300-fea42be3cb2b
msgctxt "h54bf72aegc741g44edga0fbg2b9de3a1b8d0"
msgid "I've been worried sick!"
msgstr "걱정돼 죽는 줄 알았다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = 32da8a27-acc1-4aed-9a7e-ea98026a8ea6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:32da8a27-acc1-4aed-9a7e-ea98026a8ea6
msgctxt "h52f64e70g0be9g46bdgbc9fg741127d39854"
msgid "Please, what? I deserve to know what happened."
msgstr "제발, 뭐? 난 무슨 일이 있었는지 알 자격이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = 33bfa70b-f298-4276-b426-409599b263c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_SisterReturned = False
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:33bfa70b-f298-4276-b426-409599b263c0
msgctxt "h171b59ccg25b5g438bg9fb9g1aa782eb554b"
msgid "Speak plainly, where is Lia?"
msgstr "솔직하게 말해, 리아는 어딨어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Lia
#. NodeID = 396c37c9-0613-4e8b-9623-dbd15fb04a2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = False
#.   Local:
#.      - 28259eb0-5f20-5094-45f1-3292253ae1ed_B = True
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:396c37c9-0613-4e8b-9623-dbd15fb04a2b
msgctxt "h17b28289g2686g456fga6c3gd42d4e37ab57"
msgid "Not all of us react to everything by getting drunk and hysterical."
msgstr "우리 전부가 술 취해 오만 군데 히스테리 부리고 그러지는 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Cal
#. NodeID = 42401092-bb03-44c0-aa69-9ca3afc728b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:42401092-bb03-44c0-aa69-9ca3afc728b3
msgctxt "h219d1713g47c5g4167g89d9g8a62621bf261"
msgid "We weren't exactly on holiday, Rolan."
msgstr "우린 놀러 다녀온 게 아니야, 롤란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = 59be2d36-e82a-4ae5-b764-afe935db92ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:59be2d36-e82a-4ae5-b764-afe935db92ea
msgctxt "h420177adg2aa6g4cd7g96cega47dccfb4987"
msgid "You saw Cal <i>die.</i>"
msgstr "칼이 <i>죽는 걸</i> 봤잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = 7fefdfce-88b4-4c29-b4b9-e0268e56a5d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = False
#.   Local:
#.      - 28259eb0-5f20-5094-45f1-3292253ae1ed_C = True
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_A = False
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_C = False
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:7fefdfce-88b4-4c29-b4b9-e0268e56a5d0
msgctxt "h175dda60g7f30g4292ga649g23c20b5e0e09"
msgid "Cal could still be alive, he could still be in Moonrise!"
msgstr "칼이 살아있을 수도 있잖아, 아직 문라이즈에 있을 수도 있다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Cal
#. NodeID = 9479df0f-f2f9-444c-ae5b-9a9401631dda
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_SisterReturned = False
#.   Local:
#.      - 28259eb0-5f20-5094-45f1-3292253ae1ed_C = True
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_A = False
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_C = False
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:9479df0f-f2f9-444c-ae5b-9a9401631dda
msgctxt "h54b24df9g2cc8g4499ga2f4gf6bd530bd38d"
msgid "Lia is <i>dead. </i>I don't know what else to tell you."
msgstr "리아는 <i>죽었어.</i> 뭐라 더 네게 말해줄 수 있는 게 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Lia
#. NodeID = 96e34baa-a803-41ee-a2ad-35edcdbd407b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:96e34baa-a803-41ee-a2ad-35edcdbd407b
msgctxt "h5b0b6bd6g6798g406dga9afg60caab5403c9"
msgid "You're enough of an arse when you're sober, never mind drunk."
msgstr "멀쩡할 때도 개새낀데, 취하니까 말할 것도 없네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Lia
#. NodeID = 97008726-9809-4bdb-9c9e-a95751bc4ee5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:97008726-9809-4bdb-9c9e-a95751bc4ee5
msgctxt "hb9860f46gf05dg4568g81abg4cae1a2685c4"
msgid "Cal is dead, all right? <i>Dead.</i>"
msgstr "칼은 죽었어, 알겠어? <i>죽었다고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Lia
#. NodeID = b6380389-ae98-47f2-b368-e17bb5441745
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:b6380389-ae98-47f2-b368-e17bb5441745
msgctxt "hb468a7dbg3d9eg4af8gae62gb4011d2abab8"
msgid "You think I wasn't?"
msgstr "나는 안 그랬을까 봐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = b6b189c4-809f-4a55-b963-31d0a19076d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:b6b189c4-809f-4a55-b963-31d0a19076d7
msgctxt "h497bef47g132cg4427g840bg6f87949cfad5"
msgid "What does that have to do with anything?"
msgstr "그래서 뭘 어쩌라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = bc2810eb-f77d-c213-9982-8265d071bb0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:bc2810eb-f77d-c213-9982-8265d071bb0d
msgctxt "ha672aa8cg6349g4aebgb81bgf36e794c4df6"
msgid "Oh, don't get all high and mighty with me, Lia."
msgstr "아이고, 잘난척은 그쯤하라구, 리아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = d2611718-028d-4e5d-b918-64675cd8875b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 28259eb0-5f20-5094-45f1-3292253ae1ed_A = True
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:d2611718-028d-4e5d-b918-64675cd8875b
msgctxt "ha8829cbag8f12g4676g839dg8026ef2a899e"
msgid "Why did you rush those cultists? You should have run away!"
msgstr "왜 추종자들에게 뛰어든 거야? 도망쳤어야지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = d7edc4ad-e279-48b1-af26-8867760f4179
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = False
#.   Local:
#.      - 28259eb0-5f20-5094-45f1-3292253ae1ed_A = True
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:d7edc4ad-e279-48b1-af26-8867760f4179
msgctxt "he6839efaga24ag4aa8gb547g1e265f759d47"
msgid "How are you not more upset by this?"
msgstr "어떻게 이러고도 더 화를 안 낼 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Cal
#. NodeID = dcdfb0f7-6157-4d21-8283-afe25e22d463
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_SisterReturned = False
#.   Local:
#.      - 28259eb0-5f20-5094-45f1-3292253ae1ed_A = True
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:dcdfb0f7-6157-4d21-8283-afe25e22d463
msgctxt "h4f32d117g943dg4ac9g9af4g03c1b0d5fa8d"
msgid "I've told you everything I know."
msgstr "내가 아는 건 모두 말했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Lia
#. NodeID = df7c7e86-b26a-4889-9683-7bc0ae3c6e74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:df7c7e86-b26a-4889-9683-7bc0ae3c6e74
msgctxt "h1b0992c6g7fe5g43d8g8f83g7a75ed20f807"
msgid "Should we have let them kill everyone?!"
msgstr "그럼 모두를 죽게 내버려 뒀어야 해?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Lia
#. NodeID = e0c252a5-2e3f-4ce8-8b0d-295ad563e3b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:e0c252a5-2e3f-4ce8-8b0d-295ad563e3b2
msgctxt "hf16fd0e5g960fg42e0g8484g663251d97804"
msgid "You don't have a choice - neither of us do."
msgstr "너한테 선택권은 없어. 우리 둘 다 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = e0db7aef-03b8-4251-8f21-2a920a488607
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:e0db7aef-03b8-4251-8f21-2a920a488607
msgctxt "h4c82d8e8g73cbg4a3fgbf8fg4d885392caf7"
msgid "Wishing isn't good enough!"
msgstr "좋겠다는 말론 모자라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = e121838f-cf6b-499c-abc2-218aee4c51db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_BrotherReturned = False
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:e121838f-cf6b-499c-abc2-218aee4c51db
msgctxt "hd229e0e2g05bcg4372gb19bg3c9d2106a232"
msgid "No, I will not accept this."
msgstr "아니, 난 인정 못 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Lia
#. NodeID = e2e00679-2408-4fad-ae57-3a3096390fb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:e2e00679-2408-4fad-ae57-3a3096390fb7
msgctxt "hca9e2b06gdbf3g4ac2g9a70g96a8b4e4cda9"
msgid "Don't speak to me a like a <i>child. </i>"
msgstr "날 <i>어린애</i> 취급하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Cal
#. NodeID = eb6749ee-8daa-41b9-b7bf-016f7ce5952a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_SisterReturned = False
#.   Local:
#.      - 28259eb0-5f20-5094-45f1-3292253ae1ed_B = True
#. SetFlags:
#.   Local:
#.     - 28259eb0-5f20-5094-45f1-3292253ae1ed_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:eb6749ee-8daa-41b9-b7bf-016f7ce5952a
msgctxt "h29f2e5aage96cg4244gbfbcg3ceb57e87327"
msgid "I know Lia should be here! I wish she was!"
msgstr "리아가 여기 있어야 된단 건 나도 알아! 있었으면 좋겠어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = ef6b1d37-b0c0-4892-9a53-db21add0ebfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:ef6b1d37-b0c0-4892-9a53-db21add0ebfb
msgctxt "h1e001f90g3931g4fc6g99c4g5b2b48411e17"
msgid "That is not what I said!"
msgstr "그런 뜻이 아니잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = f87e9e73-af8d-432d-a08e-f54b88c60e02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:f87e9e73-af8d-432d-a08e-f54b88c60e02
msgctxt "h1d78b2a2ga880g452fga473gac466c9cde10"
msgid "Yet I still don't understand. Lia should be here."
msgstr "그런데 여전히 이해가 안 가. 리아는 여기 있어야 한다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Rolan
#. NodeID = f8a252a6-ef9e-49c6-a3e5-e3e9adaaba95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:f8a252a6-ef9e-49c6-a3e5-e3e9adaaba95
msgctxt "h357e8da6g8e76g4710ga482gc7f928147e4d"
msgid "I expect better than this vague nonsense."
msgstr "이런 애매한 헛소리보단 나은 말을 기대했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Cal
#. NodeID = fb3e1ad0-bcb5-45c0-8159-e2089b0b5501
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:fb3e1ad0-bcb5-45c0-8159-e2089b0b5501
msgctxt "h4b4386f1g7204g4bbdgb885g28a3634fc780"
msgid "*Sigh.*"
msgstr "*한숨.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion
#. Speaker = Lia
#. NodeID = ffb5d3ea-dbbf-4c15-9579-6512d4a44f42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BeforeReunion:ffb5d3ea-dbbf-4c15-9579-6512d4a44f42
msgctxt "h579af6e9g2786g49b7g8b86g3f6e1ceb7a8c"
msgid "The hells is that supposed to mean?"
msgstr "대체 뭔 소리야 그게?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone
#. Speaker = Cal
#. NodeID = 19d726a0-6aa1-45f4-968c-9e52098380e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7cf65f2f-1a29-daa2-940e-1159a8940b4e_C = True
#. SetFlags:
#.   Local:
#.     - 7cf65f2f-1a29-daa2-940e-1159a8940b4e_C = False
#.     - 7cf65f2f-1a29-daa2-940e-1159a8940b4e_A = False
#.     - 7cf65f2f-1a29-daa2-940e-1159a8940b4e_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone:19d726a0-6aa1-45f4-968c-9e52098380e0
msgctxt "h7c863260g8793g41b9g9ba4gf07d5154efe4"
msgid "Please be safe, Rolan. Please, come back soon."
msgstr "제발 무사해 줘, 롤란. 제발, 빨리 돌아와 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone
#. Speaker = Cal
#. NodeID = 204a6dcb-0316-4f07-8096-e419c972028c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7cf65f2f-1a29-daa2-940e-1159a8940b4e_B = True
#. SetFlags:
#.   Local:
#.     - 7cf65f2f-1a29-daa2-940e-1159a8940b4e_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone:204a6dcb-0316-4f07-8096-e419c972028c
msgctxt "h784dc1d7gbb33g4067g98c3gff44fef5846d"
msgid "How am I going to tell him about Lia?"
msgstr "리아에 대해선 뭐라고 말하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone
#. Speaker = Cal
#. NodeID = 6bc31c82-37d2-4918-38a0-632dd1b35754
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone:6bc31c82-37d2-4918-38a0-632dd1b35754
msgctxt "h4b405959g661bg40b7gbd09g1b3463429a9d"
msgid ""
"No, no his message was clear. He's coming back - I just need to be patient."
msgstr "아냐, 아냐. 메시지는 명확했어. 그는 돌아올 거야. 참을성을 가져야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone
#. Speaker = Cal
#. NodeID = 6bcbeda4-2732-455c-ab56-435a0ab2c0b6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7cf65f2f-1a29-daa2-940e-1159a8940b4e_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone:6bcbeda4-2732-455c-ab56-435a0ab2c0b6
msgctxt "h2a3a155cgb003g4f9dg876cged20d60b9a4e"
msgid "We should be in the city - hunting for work, making our fortunes."
msgstr "지금쯤 발더스 게이트에 도착해서 일거리를 찾고 돈을 벌었어야 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone
#. Speaker = Cal
#. NodeID = 7190932b-35f0-461d-a991-ad98309181f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7cf65f2f-1a29-daa2-940e-1159a8940b4e_A = True
#. SetFlags:
#.   Local:
#.     - 7cf65f2f-1a29-daa2-940e-1159a8940b4e_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone:7190932b-35f0-461d-a991-ad98309181f2
msgctxt "h694f9cb0g8916g4d55g9356g3ba3e722f7e8"
msgid "Should I head out and look for Rolan?"
msgstr "나가서 롤란을 찾아봐야 할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone
#. Speaker = Cal
#. NodeID = 7d679e04-7eee-86b0-f700-a2b1c0074026
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone:7d679e04-7eee-86b0-f700-a2b1c0074026
msgctxt "he0e83ee2g4b2ag4d62g86c1gcecc4bb95fe9"
msgid "'Lia didn't make it...' Gods, it doesn't sound real."
msgstr "'리아는 성공하지 못했어...' 맙소사, 실감이 안 나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone
#. Speaker = Cal
#. NodeID = 9d61dc6f-c240-3182-7814-cd40fb152c43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone:9d61dc6f-c240-3182-7814-cd40fb152c43
msgctxt "h0ac2137bgad96g4505ga6ebg6b13b8ee1de4"
msgid "Instead, Lia's gone, Rolan's missing... how did it come to this?"
msgstr "대신, 리아는 죽었고, 롤란은 행방불명이야... 어쩌다 이렇게 됐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone
#. Speaker = Cal
#. NodeID = f3e38c90-87e4-be3a-1dbd-f3f5dbdb5809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_BrotherWaitingAlone:f3e38c90-87e4-be3a-1dbd-f3f5dbdb5809
msgctxt "h4a9aa569gc20fg46f0gbc2egca775652fe41"
msgid "'We escaped Moonrise, but things went wrong?'"
msgstr "'문라이즈를 탈출하긴 했는데, 일이 틀어졌어?'"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid
#. Speaker = Umi
#. NodeID = 4a526f92-6874-3c6a-ac3d-590926f3e253
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid:4a526f92-6874-3c6a-ac3d-590926f3e253
msgctxt "hf17c9a26g38bdg472cgb0ebg00755854980a"
msgid "I don't want to."
msgstr "그러기 싫어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid
#. Speaker = Rolan
#. NodeID = 64b06578-6685-701f-f4fc-7a0a1a8b0a49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid:64b06578-6685-701f-f4fc-7a0a1a8b0a49
msgctxt "h96426e2cg776cg4710gb31fgc67fb30dbe73"
msgid "If I wanted water, I would bloody ask for it."
msgstr "물 마시고 싶었으면, 달라고 했겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid
#. Speaker = Rolan
#. NodeID = 67cf91ca-dbbb-b4d8-856b-d1c5c6ad49d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid:67cf91ca-dbbb-b4d8-856b-d1c5c6ad49d6
msgctxt "h1088cee4g0c41g431dga0fbg0c2b92ca3d5a"
msgid "I'M NOT SHOUTING."
msgstr "<b>소리 안 지르거든.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid
#. Speaker = Rolan
#. NodeID = 96bbfd33-59d6-da0c-8cb2-cf6867689455
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ed580a24-9949-7b59-1735-c6db6cda5a6c_B = True
#. SetFlags:
#.   Local:
#.     - ed580a24-9949-7b59-1735-c6db6cda5a6c_B = False
#.     - ed580a24-9949-7b59-1735-c6db6cda5a6c_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid:96bbfd33-59d6-da0c-8cb2-cf6867689455
msgctxt "h5008678cgc868g4725g9a3bg5f1755d7e508"
msgid "Your job is to serve drinks, you little devil. Do it."
msgstr "네 일은 술 시중이야, 작은 데빌아. 얼른 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid
#. Speaker = Rolan
#. NodeID = 99b70098-d2af-1dca-0092-0e91c5a22501
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ed580a24-9949-7b59-1735-c6db6cda5a6c_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid:99b70098-d2af-1dca-0092-0e91c5a22501
msgctxt "h01c893a6g1f7fg484cg84adg6dc3df222a22"
msgid "Get the bottle, hand me the bottle - it's not hard."
msgstr "병을 집어서, 나한테 병을 줘. 어렵지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid
#. Speaker = Umi
#. NodeID = c51c1efb-d2cb-a072-90ed-343139c2e7db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ed580a24-9949-7b59-1735-c6db6cda5a6c_A = True
#. SetFlags:
#.   Local:
#.     - ed580a24-9949-7b59-1735-c6db6cda5a6c_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid:c51c1efb-d2cb-a072-90ed-343139c2e7db
msgctxt "he813f2fdg113eg4583gb79fg982c963965d0"
msgid "How about some water, Mr Rolan?"
msgstr "물 좀 드시면 어때요, 롤란 씨?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid
#. Speaker = Umi
#. NodeID = e873d44a-9895-e5e0-68db-ff40be0dabbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid:e873d44a-9895-e5e0-68db-ff40be0dabbd
msgctxt "h18b2a149g99f1g4604g8493g9c3eb7794cd2"
msgid "Please stop shouting."
msgstr "제발 소리지르지 마세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid
#. Speaker = Rolan
#. NodeID = f2141bdc-87fa-c804-cdc9-123b76f4f246
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanAndKid:f2141bdc-87fa-c804-cdc9-123b76f4f246
msgctxt "h7ea659ccgde50g485fg8539ga5234be05d95"
msgid "And I don't want to give you a lashing, but I will, damn it."
msgstr "나도 널 때리기 싫은데, 때릴 거야. 제기랄."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Rolan
#. NodeID = 069a4a55-556c-dd98-ba7f-eb017f130595
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:069a4a55-556c-dd98-ba7f-eb017f130595
msgctxt "h4141114agd51cg4966g91fbg6119d88b85e7"
msgid "Lia - answer me. Where is Cal?"
msgstr "리아, 대답해. 칼은 어딨어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Lia
#. NodeID = 1a872676-fd65-d0d6-b46a-edcace880345
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:1a872676-fd65-d0d6-b46a-edcace880345
msgctxt "hcc0e3f51g9664g420fg8087g786cb95590b2"
msgid "You arsehole, where have you been?"
msgstr "멍청이, 어디 있었어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Rolan
#. NodeID = 304bd89b-4e90-44df-b7b7-45c585b9d27a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:304bd89b-4e90-44df-b7b7-45c585b9d27a
msgctxt "h90733bc5ge9f1g469cgb4fcg5393688a1eab"
msgid "Of course. Where is Lia?"
msgstr "물론이지. 리아는 어딨어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Rolan
#. NodeID = 3693686e-aaba-454b-91af-821828efa5e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:3693686e-aaba-454b-91af-821828efa5e3
msgctxt "h8544fff8g619fg41aeg9e59g76d553ef33b2"
msgid "Blessed gods, you're here."
msgstr "세상에, 여기 있었구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Cal
#. NodeID = 3e66d924-8854-4725-85c4-f84520fceb35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:3e66d924-8854-4725-85c4-f84520fceb35
msgctxt "hebc5d436g3b3fg42c2g9f26g85c374bc6db3"
msgid "I'm so sorry, Rolan."
msgstr "정말 미안해, 롤란."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Rolan
#. NodeID = 4601dcb2-a703-476d-812b-87f848104417
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:4601dcb2-a703-476d-812b-87f848104417
msgctxt "he4c0f694gcc69g4524gbd24g25423e10bb08"
msgid "Cal! Thanks the gods."
msgstr "칼! 신이시여 감사합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Lia
#. NodeID = 5e28e3fc-33fc-4a9a-9106-ae406ac6d265
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:5e28e3fc-33fc-4a9a-9106-ae406ac6d265
msgctxt "h3a2478bcgad98g4969ga4a2g9aae0a7c1c62"
msgid "You arsehole! It's about time!"
msgstr "이 멍청이! 시간 거의 다 됐잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Cal
#. NodeID = 9de912e4-efb7-4517-9030-428478e32676
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:9de912e4-efb7-4517-9030-428478e32676
msgctxt "h0cff4beeg9b7ag44fcgaffbg49df5578d42c"
msgid "Rolan!"
msgstr "롤란!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Lia
#. NodeID = c7ffa388-d2fd-4d5d-b72c-537649268009
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:c7ffa388-d2fd-4d5d-b72c-537649268009
msgctxt "h323ad768g98aeg4ac7g8fe4g70323f453692"
msgid "Rolan, I'm sorry."
msgstr "롤란, 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Rolan
#. NodeID = d7371dcf-1b39-487b-805c-588fa30d9d52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:d7371dcf-1b39-487b-805c-588fa30d9d52
msgctxt "hd68f7ea4ge9a2g49e2g86c6gdf8f4a04d15e"
msgid "Lia! Thank the gods."
msgstr "리아! 신이시여 감사합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Cal
#. NodeID = e08bc56b-6db6-2081-0e50-48235067b7c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:e08bc56b-6db6-2081-0e50-48235067b7c1
msgctxt "h18b07f07g193cg4de4gb2e6g7fb017729a76"
msgid "Rolan! You're all right!"
msgstr "롤란! 무사했구나!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns
#. Speaker = Rolan
#. NodeID = ece6dd75-f06d-f8bd-c973-bc49d29c2362
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_RolanReturns:ece6dd75-f06d-f8bd-c973-bc49d29c2362
msgctxt "h5dbb8786gce0ag4d2cga114gdaa4818daee4"
msgid "Cal - answer me. Where is Lia?"
msgstr "칼, 대답해. 리아는 어딨어?"

