#.     - 94cd0a22-c842-d9f3-8121-f8ac16410656_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture:3ea7b946-570c-4ac7-9be9-08f6c5786198
msgctxt "h0fae2c12gc06dg4b37gb190g938587b49af2"
msgid "When will we have new playthings, sister?"
msgstr "언제쯤 새 장난감을 받아 볼 수 있겠나, 자매여?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture
#. Speaker = Questioner Jasin
#. NodeID = 64095700-bd16-47be-8dfc-33f88f337616
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 94cd0a22-c842-d9f3-8121-f8ac16410656_B = True
#. SetFlags:
#.   Local:
#.     - 94cd0a22-c842-d9f3-8121-f8ac16410656_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture:64095700-bd16-47be-8dfc-33f88f337616
msgctxt "he1794a5cg7b96g4b22g8c51g108f3c580a47"
msgid "The gnomes are rebellious."
msgstr "저 노움들은 반항적이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture
#. Speaker = Questioner Jasin
#. NodeID = 8ff8c58c-33f4-464a-a1ca-c658f09657da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture:8ff8c58c-33f4-464a-a1ca-c658f09657da
msgctxt "hed0e604bgdb52g4545ga27bgf5eb9d6ce98a"
msgid ""
"Soon. Those in the cells are not to be touched, but the Absolute always "
"provides for us."
msgstr "곧. 저 감옥에 있는 녀석들은 건들면 안 되지만, 절대자께서는 항상 장난감을 제공해주시지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture
#. Speaker = Questioner Jasin
#. NodeID = 9daa351a-4698-4b38-ac9f-55123df763d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture:9daa351a-4698-4b38-ac9f-55123df763d2
msgctxt "ha531de21g0cf4g4b46ga59dg7d5a5fe9ee62"
msgid "Only if the Warden gives the order."
msgstr "먼저 간수장의 허락이 떨어져야겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture
#. Speaker = Questioner Sumera
#. NodeID = acc67add-2243-4c34-b37f-eccea62cbd33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture:acc67add-2243-4c34-b37f-eccea62cbd33
msgctxt "ha23e9fccg33b5g414fgbb88gbc190fece572"
msgid ""
"I hope She brings us someone resilient - the last ones broke too quickly."
msgstr "그분께서 탄탄한 녀석을 데려오셨으면 좋겠군. 저번 녀석은 너무 쉽게 망가졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture
#. Speaker = Questioner Sumera
#. NodeID = b31ddfee-61a7-4f05-b261-cba871e3b7cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 94cd0a22-c842-d9f3-8121-f8ac16410656_A = True
#. SetFlags:
#.   Local:
#.     - 94cd0a22-c842-d9f3-8121-f8ac16410656_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture:b31ddfee-61a7-4f05-b261-cba871e3b7cb
msgctxt "h863f2fc4g0459g4f97g9d92g397e1a54ce69"
msgid "Do you hear the Absolute's voice, sister?"
msgstr "절대자님의 음성이 들리나, 자매여?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture
#. Speaker = Questioner Sumera
#. NodeID = c32ac605-a2ec-468f-9d1d-0fad96460b30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture:c32ac605-a2ec-468f-9d1d-0fad96460b30
msgctxt "h6c7c640cg25d0g4e18gb784g504ccbd568ab"
msgid "We should throw them in the oubliette."
msgstr "놈들을 지하 구덩이에 던져버려야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture
#. Speaker = Questioner Sumera
#. NodeID = dbd0830f-21f8-40cb-a381-2c66462df189
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersBeforeTorture:dbd0830f-21f8-40cb-a381-2c66462df189
msgctxt "h1f1691edg8e20g4cf4gb0dagdc69613bce38"
msgid "To mete out the Absolute's justice, I hear."
msgstr "절대자님의 정의를 실현하시겠다더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersInCombat
#. Speaker = Questioner Jasin
#. NodeID = 20c7b7fd-4d01-4819-b8d4-2e80f0310e83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersInCombat:20c7b7fd-4d01-4819-b8d4-2e80f0310e83
msgctxt "hc039da98gdcbcg4e78gae2fgf63f2d048d7a"
msgid "Prisoners aren't supposed to fight back!"
msgstr "죄수들이 반격할 리 없을 텐데!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersInCombat
#. Speaker = Questioner Sumera
#. NodeID = 28fe7b01-7b60-f14e-0eef-320ca089d44e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersInCombat:28fe7b01-7b60-f14e-0eef-320ca089d44e
msgctxt "hb9b6c187g350ag448ega4e6g3b557e107518"
msgid "Warden! Aid us!"
msgstr "간수! 여기다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Jasin
#. NodeID = 12e67902-3969-c620-1e65-066ec88f00d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:12e67902-3969-c620-1e65-066ec88f00d4
msgctxt "h1f9acffagc2c1g4f39g898bg1c446564e8c9"
msgid "And so many minds for us to break."
msgstr "우리가 부술 수많은 정신도 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Jasin
#. NodeID = 2e6a4250-73df-6c29-1599-025a1e8c8c7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:2e6a4250-73df-6c29-1599-025a1e8c8c7c
msgctxt "hfedcb3c5g793cg43e0g8e3cg3ac1acb7815e"
msgid "She will thrive - we helped make her beautiful again."
msgstr "그녀는 번창할 것이다. 우리가 다시 아름답게 개조해 주었으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Jasin
#. NodeID = 306dde56-3c4d-3ab0-bcd1-0397a7d7072d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:306dde56-3c4d-3ab0-bcd1-0397a7d7072d
msgctxt "hbb8d99d3g9c6cg4b13g8735g9d2fb48c0146"
msgid "Soon, we will be in Baldur's Gate. What say you to that, sister?"
msgstr "곧, 우리는 발더스 게이트에 도착한다. 어떻게 생각하나, 자매여?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Nightwarden Minthara
#. NodeID = 37475db6-2886-494a-86e7-f696532f7624
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8916beac-0385-3df9-de07-8be3cc6752a7_A = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Local:
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:37475db6-2886-494a-86e7-f696532f7624
msgctxt "ha4350d86g9beeg4d65gaab4gf8d63b874d55"
msgid "Any orders?"
msgstr "무엇이 필요하십니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Nightwarden Minthara
#. NodeID = 3bb01ab6-9161-cfd4-8f4e-fe42ec7ee588
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:3bb01ab6-9161-cfd4-8f4e-fe42ec7ee588
msgctxt "h735fb5f9g10d1g47a8ga0c3g57a42a67d102"
msgid "If the Absolute wills it."
msgstr "절대자께서 바라시는 대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Sumera
#. NodeID = 3e128506-1795-5ad7-3c7d-cbbe1b03eff8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:3e128506-1795-5ad7-3c7d-cbbe1b03eff8
msgctxt "h1cb3ab2cg46e0g4c74g9d79g732bd00b0a5e"
msgid "We should have her fetch our supper from the kitchens."
msgstr "부엌에서 우리 저녁을 좀 가져오라고 해야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Jasin
#. NodeID = 477cdae4-b9dc-b264-4fa2-bee93b015c3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Florrick_Event_RavengardInTowers = False
#.   Local:
#.      - 8916beac-0385-3df9-de07-8be3cc6752a7_B = True
#. SetFlags:
#.   Local:
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_A = False
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:477cdae4-b9dc-b264-4fa2-bee93b015c3a
msgctxt "h34439d05g02aag4e60g904cg2bee0450127e"
msgid "It felt good to break a drow."
msgstr "드로우의 정신을 부수는 건 건 기분이 참 좋았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Sumera
#. NodeID = 5035222c-f765-1cd2-bd40-3fd3f2286e75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Florrick_Event_RavengardInTowers = True
#.   Local:
#.      - 8916beac-0385-3df9-de07-8be3cc6752a7_B = True
#. SetFlags:
#.   Local:
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_A = False
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:5035222c-f765-1cd2-bd40-3fd3f2286e75
msgctxt "h9b2fc712g4c89g4a5bg891bg070087cee51f"
msgid "It is a shame Ravengard didn't pass through our chamber."
msgstr "레이븐가드가 우리 작업실을 거치지 않은 게 아깝군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Sumera
#. NodeID = 59923f9d-11c9-0370-62ba-bc41b2fabb29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:59923f9d-11c9-0370-62ba-bc41b2fabb29
msgctxt "hd681ec6ag9efcg4255g867bgb97a87c6e7aa"
msgid "They have formidable minds."
msgstr "놈들은 강한 정신을 지니고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Jasin
#. NodeID = 5dc5c5d9-a7fa-7a8d-bc14-f5a52616215f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:5dc5c5d9-a7fa-7a8d-bc14-f5a52616215f
msgctxt "hf9898a15g9319g46cag9045gdb0de837c1ca"
msgid "And what joy it would be to hear a duke beg for mercy."
msgstr "대공이 자비를 구걸하는 걸 듣노라면 얼마나 즐거울까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Sumera
#. NodeID = 752a183b-97c0-9236-317f-78b04d2ce576
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:752a183b-97c0-9236-317f-78b04d2ce576
msgctxt "h606851f6g5e64g48dbgb917g0b9607947db7"
msgid "Such a pity - the Absolute hates you."
msgstr "어쩐다나 - 절대자께서는 네가 싫다시던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Nightwarden Minthara
#. NodeID = 76e25492-3665-20dc-786e-215be66a4232
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:76e25492-3665-20dc-786e-215be66a4232
msgctxt "h669a6067g8002g4cc3g9393g38f9b50b55e1"
msgid "The Absolute."
msgstr "오직 절대자 뿐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Sumera
#. NodeID = 7f94fc6b-77a4-42b2-8e04-37034828aa17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8916beac-0385-3df9-de07-8be3cc6752a7_B = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Local:
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:7f94fc6b-77a4-42b2-8e04-37034828aa17
msgctxt "ha7ce70abga27ag4bcdg9692g9ad61bb479b5"
msgid "When the Sword Coast is ours, we'll set out sights on the Underdark."
msgstr "우리가 소드 코스트를 지배하면, 다음엔 언더다크에 시선을 돌리겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Jasin
#. NodeID = 83bed11f-dd06-bffa-20ae-f1ce54f64c63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:83bed11f-dd06-bffa-20ae-f1ce54f64c63
msgctxt "h6d2ffacdg0e56g423fg8841g22ed0b9f17e3"
msgid "But cannot compare to ours."
msgstr "하지만 우리에 비할 순 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Sumera
#. NodeID = 93707658-9e68-9771-46ed-f94bc44146bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8916beac-0385-3df9-de07-8be3cc6752a7_A = True
#. SetFlags:
#.   Local:
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:93707658-9e68-9771-46ed-f94bc44146bf
msgctxt "h33254980gf672g4b61gb58bg697e6eb2b20e"
msgid "What will become of Minthara, I wonder."
msgstr "민타라는 무엇으로 거듭날지 궁금하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Sumera
#. NodeID = aa7434f7-4ca1-7568-9a00-73d5eea4d823
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:aa7434f7-4ca1-7568-9a00-73d5eea4d823
msgctxt "h163f8e00g38a3g4822g9a10g5eff32139355"
msgid "Indeed, sister. We could have learned a great deal from him."
msgstr "사실이다, 자매여. 놈에게서 근사한 정보들을 얻어낼 수 있었을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Sumera
#. NodeID = bad190df-3133-6324-347d-953eac6e89ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:bad190df-3133-6324-347d-953eac6e89ef
msgctxt "h1391b694g51e3g4f08g99a5gcbf846e96cae"
msgid "A whole city in service of the Absolute - it will be glorious."
msgstr "도시 전체가 절대자님을 섬기겠지, 영광스러울 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Jasin
#. NodeID = c1b66c6d-cda2-2510-e4c0-89a5b41b8134
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:c1b66c6d-cda2-2510-e4c0-89a5b41b8134
msgctxt "hbd6ceca1g2c6bg4037g8984gf12028639dfc"
msgid ""
"We'll find your family, Minthara. And slaughter them. Would you enjoy that?"
msgstr "네 가족을 찾아내겠어, 민타라. 그리고 죽일 거야. 그걸 즐길 테냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Jasin
#. NodeID = c6e0a296-e323-e409-418f-50a5508ff06c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:c6e0a296-e323-e409-418f-50a5508ff06c
msgctxt "hc965f888gbdcdg4fb4gb867g338b31515eb9"
msgid "Or command her to empty the latrines."
msgstr "아니면 변소를 비우라고 하는 건 어때."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Nightwarden Minthara
#. NodeID = e18a501c-7b9c-c84c-7675-6c79df3e73ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:e18a501c-7b9c-c84c-7675-6c79df3e73ed
msgctxt "hf06e8fddg75f5g4aedgabacg2576b199255e"
msgid "Whatever you wish. I live to serve."
msgstr "바라시는 대로. 이 목숨은 당신을 섬기기 위해 존재할 뿐입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Jasin
#. NodeID = e766ed90-992b-49bd-a0b6-8a3bfe4869d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Local:
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:e766ed90-992b-49bd-a0b6-8a3bfe4869d2
msgctxt "h312609ddg8277g49c3gb3d0gc895a23cea27"
msgid "Would you bite off your tongue if we commanded you to, Minthara?"
msgstr "우리 네 혀를 깨물어 끊으라고 하면 할 테냐, 민타라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Sumera
#. NodeID = ec5a6ad6-8002-db0b-10bf-9860a9f0fffb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:ec5a6ad6-8002-db0b-10bf-9860a9f0fffb
msgctxt "h5a4e7acega367g42e4gbb1ag3513c40076db"
msgid "It's so tempting - but the Absolute wants her alive."
msgstr "구미가 당기는군, 하지만 절대자께서는 살려두길 원하신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture
#. Speaker = Questioner Jasin
#. NodeID = fe5b0a0f-fe32-4d73-9faa-d034650303e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8916beac-0385-3df9-de07-8be3cc6752a7_C = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Local:
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_A = False
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_B = False
#.     - 8916beac-0385-3df9-de07-8be3cc6752a7_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_TorturersPostTorture:fe5b0a0f-fe32-4d73-9faa-d034650303e2
msgctxt "h320ae121g090bg4143g824egd5ffc14a1980"
msgid "Who do you love, Minthara?"
msgstr "네가 사랑하는 사람은 누구지, 민타라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_WelcomingMinthara
#. Speaker = Questioner Sumera
#. NodeID = 97ddb960-2e2d-bb5e-8fab-538dd53392d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_WelcomingMinthara:97ddb960-2e2d-bb5e-8fab-538dd53392d7
msgctxt "h89fe4b38gc9d1g48ebgb0dagbc093dd1e6e5"
msgid "Your sentence is purification."
msgstr "너를 정화형에 처한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_WelcomingMinthara
#. Speaker = Questioner Jasin
#. NodeID = cdecb4ee-47fd-e990-1241-5faf65ad7ee0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_WelcomingMinthara:cdecb4ee-47fd-e990-1241-5faf65ad7ee0
msgctxt "h78b04050g540cg4dc9g92c0g52b06cb6fc20"
msgid "We will cleanse you."
msgstr "네 존재를 지워 주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_WelcomingMinthara
#. Speaker = Questioner Sumera
#. NodeID = f9b0428f-ff24-4687-b077-b3fac1f42dd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_AD_WelcomingMinthara:f9b0428f-ff24-4687-b077-b3fac1f42dd8
msgctxt "hb04fa066g118dg4fd1ga2cdg6cef40376dd3"
msgid ""
"Nightwarden Minthara - your dereliction of duty has finally caught up with "
"you."
msgstr "밤지기 민타라, 마침내 네 녀석의 직무 유기가 탄로 났구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Player
#. NodeID = 00316c4c-f054-45da-9fed-6dde8505c669
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:00316c4c-f054-45da-9fed-6dde8505c669
msgctxt "h7583bc18ge90eg4c29gb686g72dfc4af2f56"
msgid "She's completely loyal to me. I'll keep her in line."
msgstr "이자는 내게 복종한다. 앞으로는 내가 맡도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Zealot Malik
#. NodeID = 04b748df-3497-4155-abf4-cdf37c80fca0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_CheckpointCleared = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:04b748df-3497-4155-abf4-cdf37c80fca0
msgctxt "h09669592g6633g4b8cg8d61g351fadb72d51"
msgid "Apologies, True Soul. Perhaps I misunderstood the General's orders."
msgstr "사과드립니다, 참된 영혼. 제가 장군님의 명령을 잘못 이해했나 보군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Nightwarden Minthara
#. NodeID = 24791da6-9f3b-4461-a896-c5d3813a5952
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:24791da6-9f3b-4461-a896-c5d3813a5952
msgctxt "h42af92ebg1591g492bg81c3g76b473db1ffb"
msgid "Deal with them. Or I will."
msgstr "저놈들을 처리해. 아니면 내가 하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Zealot Malik
#. NodeID = 2593866f-c7f3-48c2-9389-c59a32b30311
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:2593866f-c7f3-48c2-9389-c59a32b30311
msgctxt "h99e14786g7023g495cgb7dcg588549333300"
msgid "And where do your loyalties lie? Not to the Absolute."
msgstr "그렇다면 네놈은 누굴 섬기지? 절대자님은 아닌 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Zealot Malik
#. NodeID = 3f284681-43d0-4137-9552-d3b79bafca4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MintharaFate_State_MintharaAllowedInMOO = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:3f284681-43d0-4137-9552-d3b79bafca4d
msgctxt "h0374485cgf8fbg4826g932dg0a6042ff9abb"
msgid ""
"We heard she'd been escorted from her cell - not that she could leave the "
"tower."
msgstr "이자를 수감동에서 호송해 오라는 말은 들었지만, 탑을 떠나도 좋다는 명령은 없었습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Player
#. NodeID = 43d1aa63-7232-4b4a-869e-8e6837b3394e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:43d1aa63-7232-4b4a-869e-8e6837b3394e
msgctxt "h64af68e2g336bg4fadg80abge912cba665c9"
msgid "She's entirely repurposed, and has no will of her own."
msgstr "이자는 완전히 재설계됐다. 제정신이 아닌 상태지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Zealot Malik
#. NodeID = 4c39a394-77bc-4242-b921-1fda37a63741
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:4c39a394-77bc-4242-b921-1fda37a63741
msgctxt "h3f3aa71fg27deg4f64g8eceg0baa8c20b808"
msgid "The drow is not to leave the tower."
msgstr "이 드로우는 탑을 떠날 수 없습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Zealot Malik
#. NodeID = 5544eea9-8a99-41e4-adf8-fff2ebaa535e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:5544eea9-8a99-41e4-adf8-fff2ebaa535e
msgctxt "h4f2b9f45g237eg446agb7c3g5121cd7544be"
msgid "As loyal as a golem. Use her well."
msgstr "골렘만큼이나 충직해 보이는군요. 잘 써먹으시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Player
#. NodeID = 7b3124fd-a299-4c12-af66-75e0a6591f00
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:7b3124fd-a299-4c12-af66-75e0a6591f00
msgctxt "h15877e62g0a86g4b16gaea7g9f8afe5ab3f7"
msgid "She goes where I take her - get out of my way."
msgstr "이자는 내가 맡겠다. 길을 비켜라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Nightwarden Minthara
#. NodeID = 87cb8714-1b65-417d-9bf0-578807cef9ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:87cb8714-1b65-417d-9bf0-578807cef9ff
msgctxt "hced1cdf8gbc12g49d8g822bgec81a4f5a4e8"
msgid "I live to serve."
msgstr "이 목숨 다 바쳐 섬기겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Zealot Malik
#. NodeID = 90acb6b5-9f36-0aa1-aac1-ffd1e7485fc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:90acb6b5-9f36-0aa1-aac1-ffd1e7485fc2
msgctxt "h77170aedg7791g4edbg870bg378212481cab"
msgid "You overstep your authority - and you stink of treachery."
msgstr "월권행위다. 그리고 네놈에겐 배신의 냄새가 나는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Adept Merim
#. NodeID = 9cf133c8-fcb4-4250-ba57-bd16e485055f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:9cf133c8-fcb4-4250-ba57-bd16e485055f
msgctxt "h629cf6e3g8117g4e80g9935gafa293412317"
msgid "The General ordered that she be repurposed. Not freed."
msgstr "장군께서는 석방이 아니라 재설계를 명하셨습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Zealot Malik
#. NodeID = aa9f245a-53f6-419e-8d68-25c1fc95efe3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_CheckpointCleared = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:aa9f245a-53f6-419e-8d68-25c1fc95efe3
msgctxt "he3370d6agd3cdg4a14ga937g3d2cb10444ec"
msgid ""
"Creatures like her don't understand the concept of loyalty. Keep her on a "
"tight leash."
msgstr "이자가 속한 부류는 충성심이라는 개념을 이해하지 못합니다. 경계를 놓지 마십시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Zealot Malik
#. NodeID = b9c275a2-4c90-45a4-9809-58d8099c82d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:b9c275a2-4c90-45a4-9809-58d8099c82d4
msgctxt "hf33607cfg7c7fg4c31gb2e7g3fead1d3253f"
msgid "Halt!"
msgstr "정지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Adept Merim
#. NodeID = d3cd224c-3e74-21ed-9533-d2aa0a313a3f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_CheckpointCleared = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:d3cd224c-3e74-21ed-9533-d2aa0a313a3f
msgctxt "h9aa3f215g74e7g4ff6g8511gc6c6f9a454b7"
msgid ""
"Excellent. Hers was a difficult mind to erase, no doubt - she was fierce, "
"and erratic."
msgstr "훌륭하군요. 이자는 실로 다루기 어려운 정신의 소유자였습니다. 사납고, 변덕스러웠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Zealot Malik
#. NodeID = e4dd3dc7-6511-ede4-5d33-cc5a70312d7b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:e4dd3dc7-6511-ede4-5d33-cc5a70312d7b
msgctxt "h9123b0b2g6bedg4c4aga57agafca4febe07d"
msgid "Kill them!"
msgstr "놈들을 죽여라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Zealot Malik
#. NodeID = ec432bb8-c52e-6a78-c7c1-64d5c4ba4272
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:ec432bb8-c52e-6a78-c7c1-64d5c4ba4272
msgctxt "ha464ff58g5346g4687g8744g5f54180de737"
msgid ""
"And yet, I see a glimmer of her old ferocity behind the eyes. And I hear the "
"lie on your lips."
msgstr "이자의 눈빛은 사나움을 숨기지 못하고 있군 그래. 네놈의 입술이 거짓을 숨기지 못하는 것처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint
#. Speaker = Adept Merim
#. NodeID = f17ce9a7-6d93-46b9-bb74-5056566fb77b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Checkpoint:f17ce9a7-6d93-46b9-bb74-5056566fb77b
msgctxt "hcbefa5e6g3e4ag4cfeg8189gfd918d7ae36c"
msgid "For the Absolute."
msgstr "절대자를 위하여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Player
#. NodeID = 0f21b4e1-64a2-45ca-65ba-e59a0e8e3007
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:0f21b4e1-64a2-45ca-65ba-e59a0e8e3007
msgctxt "ha78d3bdfg2e20g493cg8007gf829dba1a7d0"
msgid "I came here for the pleasure of killing you myself."
msgstr "여기에 온 건 단지 내 손으로 네 목을 수집하기 위해서다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 32e167bd-2ea3-db84-d361-0d49186b7d64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:32e167bd-2ea3-db84-d361-0d49186b7d64
msgctxt "ha39df043gac7ag4977gbdc5gc803827ef311"
msgid ""
"Erasing my thoughts, and my will. Even I could not have endured for much "
"longer."
msgstr "내 기억과 의지를 지우는 것. 나조차도 더 이상 버틸 수 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 34b196b0-7dc3-cde6-673f-047872975271
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:34b196b0-7dc3-cde6-673f-047872975271
msgctxt "h5bc4320cg90fcg4d3bg8167gf4dd1b094600"
msgid "Lead the way."
msgstr "안내해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 402baaac-771b-719c-dc46-2d4bd88bb4a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:402baaac-771b-719c-dc46-2d4bd88bb4a7
msgctxt "h32a21c99g9d54g40b1gbf1bg969c9ca54625"
msgid "I think not - the pleasure will be all mine."
msgstr "웃기는군 - 목이 따이는 건 네놈이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Player
#. NodeID = 428f33b7-48e2-6aa2-879e-2c2a72e177ff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Following = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:428f33b7-48e2-6aa2-879e-2c2a72e177ff
msgctxt "h73df7bcdgbca6g45ccg8dd0g3eb75c7ab4fe"
msgid "Let's go."
msgstr "해 보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 69876d16-ad19-eb61-593f-31bcdc99c039
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:69876d16-ad19-eb61-593f-31bcdc99c039
msgctxt "h0015fce9g1db0g4833gb04dg26bccd5fc7d9"
msgid "Agreed."
msgstr "좋은 생각이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 765f652a-5775-14e9-4306-47076584a43e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:765f652a-5775-14e9-4306-47076584a43e
msgctxt "h3ab7f898g19d1g40f9g9d5dgdc610c4a65e7"
msgid "Make haste. I fear that insidious voice will return if I linger here."
msgstr "그럼 서둘러. 여기 계속 있으면 그 교활한 목소리가 다시 들려올 것 같으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 7a055193-fb5f-3ad8-a534-7c300b32914c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:7a055193-fb5f-3ad8-a534-7c300b32914c
msgctxt "h8fd6d796g3a0ag4cffg826age5110ef18f7b"
msgid "I didn't think anyone would come for me."
msgstr "아무도 날 구하러 오지 않을 거라 생각했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 7be9494c-7baf-eda8-4ea8-c7ccb943ffa3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Satisfied = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:7be9494c-7baf-eda8-4ea8-c7ccb943ffa3
msgctxt "h59e918a7g566eg4413gb2dcg1cafa8cc6c22"
msgid ""
"Oh, darling - I wish it hadn't come to this. But the pleasure will be all "
"mine."
msgstr "오, 자기 - 이렇게 되지 않길 바랐는데. 하지만 벽을 장식하는 건 네 목이 될 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 8f746402-7af8-faea-9ff2-0cd3b402f429
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MintharaFate_State_Torture = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:8f746402-7af8-faea-9ff2-0cd3b402f429
msgctxt "h5f8bd8ccge523g477dg8e35g67d194f0bf2e"
msgid ""
"I will pretend the interrogators finished their work, and feign obedience. "
"They will think me a thrall."
msgstr "내가 완전히 노예가 됐다고 여기게끔, 심문이 성공한 것처럼 연기할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Player
#. NodeID = 93c41360-1d19-aa81-469a-bd42a540d157
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Waiting = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:93c41360-1d19-aa81-469a-bd42a540d157
msgctxt "hc9e4933cga44fg47dagaf7eg22f40fb567ee"
msgid "Hide here a while - I'll come back."
msgstr "그냥 여기 숨어있어 - 금방 돌아올게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Player
#. NodeID = 9b75326e-c757-f701-2811-36bc871975dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:9b75326e-c757-f701-2811-36bc871975dc
msgctxt "h320103fcgcf8fg4eb2gb695g8307c73d1394"
msgid "What were they doing to you?"
msgstr "그놈들이 네게 무슨 짓을 하고 있었던 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = ab6a72a2-43ac-7361-084d-ce0f4f8d7e98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MintharaFate_State_Waiting = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:ab6a72a2-43ac-7361-084d-ce0f4f8d7e98
msgctxt "h88772e9agce2eg4e4eg9c1bg337f55b698c3"
msgid "We must leave. Now."
msgstr "떠나야 해. 지금 당장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = aeba53e0-617d-58a9-6c08-1d51e699e3b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Freed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:aeba53e0-617d-58a9-6c08-1d51e699e3b7
msgctxt "hef25bcd1g5db8g48fega203gf1f19e72e3c6"
msgid "The voice... silenced. And my abusers, dead."
msgstr "목소리가... 사라졌어. 날 괴롭히던 놈들도, 전부."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = b2616968-614a-4fc5-22f7-f4a4464fba8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MintharaFate_State_Pacified = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:b2616968-614a-4fc5-22f7-f4a4464fba8b
msgctxt "hef4fa2d8g7417g4a08g8640g02285c5a0f31"
msgid "I serve the Absolute."
msgstr "나의 충성은 절대자의 것."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = bdd07992-8b56-10c6-afd5-dce5d5e991d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MintharaFate_State_Freed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:bdd07992-8b56-10c6-afd5-dce5d5e991d0
msgctxt "h9ac87398gfd81g4676gb1a1gb39099c68833"
msgid ""
"I expected to be greeted as a hero - but the wretches imprisoned me, and "
"tried to tear my mind apart."
msgstr "영웅 대접을 받을 거라 생각했지만, 이 비열한 놈들은 날 가두고 내 정신을 산산조각 내려 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow
#. Speaker = Player
#. NodeID = c8a78673-745e-dddd-ebb5-974770b0a210
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Drow:c8a78673-745e-dddd-ebb5-974770b0a210
msgctxt "h63500138gbd37g4aa1g829bgaf3df97421d8"
msgid "We need to get out of here."
msgstr "여기서 당장 떠나야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing
#. Speaker = Nightwarden Minthara
#. NodeID = 16803c0b-7c75-4521-8970-391fcf1c5970
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing:16803c0b-7c75-4521-8970-391fcf1c5970
msgctxt "h1cf9f1f4gc604g413eg8937g28b792a30f5b"
msgid "We're between the Absolute's teeth and you ask me to sit still?"
msgstr "지금 절대자가 언제든 우릴 씹어먹으려 들 수 있는 상황에 나보고 손 놓고 기다리라는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing
#. Speaker = Player
#. NodeID = 28ed5cc0-1235-9c32-c416-fc985b2fe6e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing:28ed5cc0-1235-9c32-c416-fc985b2fe6e8
msgctxt "h8696a44ag71feg41a9g8c61g3dfba8e07a87"
msgid "Let's get moving."
msgstr "그래, 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing
#. Speaker = Player
#. NodeID = 5aacf9d1-ee67-8c00-0d88-030690fc6dd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing:5aacf9d1-ee67-8c00-0d88-030690fc6dd6
msgctxt "h70975f6bg611bg4419g94a8g7530f5054bc1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing
#. Speaker = Player
#. NodeID = 5f780b70-519d-4e31-9b91-18ce9116a97d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Waiting = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing:5f780b70-519d-4e31-9b91-18ce9116a97d
msgctxt "h1a4bc976ge192g4d65g8770gcb049966a4a5"
msgid "I need you to wait here."
msgstr "넌 여기서 기다려 줘야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing
#. Speaker = Nightwarden Minthara
#. NodeID = 82612355-3493-e05a-9c51-4f1e8ce969e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_MintharaFate_State_FollowedPlayer(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing:82612355-3493-e05a-9c51-4f1e8ce969e8
msgctxt "h3dbb545egdb7cg480cgbc64g0f970edbc11a"
msgid "I will speak when I am free."
msgstr "여유 있을 때 이야기하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing
#. Speaker = Nightwarden Minthara
#. NodeID = 8e044e2b-330a-6c27-6a46-310619edcc26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing:8e044e2b-330a-6c27-6a46-310619edcc26
msgctxt "h807634a5g3653g4776g942cgc81e68cdab86"
msgid "Be. <i>Swift.</i>"
msgstr "<i>빨리</i> 처리해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing
#. Speaker = Nightwarden Minthara
#. NodeID = b17d67be-1bb6-ccf8-8771-dd3ae4ae4f27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MintharaFate_Event_EnteredForbiddenArea = True
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Waiting = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing:b17d67be-1bb6-ccf8-8771-dd3ae4ae4f27
msgctxt "hb58b1ecfg7ca9g43b7gbf1bg16c0d7ee3fa1"
msgid ""
"I will follow you to freedom, not into greater peril. I will hold here until "
"you are done."
msgstr "자유를 위해서라면 얼마든지 따라가겠지만, 지금보다 더한 위험은 사양하겠어. 네가 일을 마칠 때까지 여기서 기다릴게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing
#. Speaker = Nightwarden Minthara
#. NodeID = c4458780-01a3-52f1-0666-9e3a3949b136
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MintharaFate_Event_TravelInterrupted = True
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_Event_TravelInterrupted = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing:c4458780-01a3-52f1-0666-9e3a3949b136
msgctxt "hd753988fg197eg47aagb2c5ge1caa4cfac99"
msgid "Go on. <i>Move.</i>"
msgstr "뭐해. 어서 <i>움직이자.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing
#. Speaker = Nightwarden Minthara
#. NodeID = d9d12b58-a8dd-4ca3-a167-64afba757c3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing:d9d12b58-a8dd-4ca3-a167-64afba757c3d
msgctxt "hc8218810g6e9fg4b24g9b74g6e5aa24bc176"
msgid "What is it? What's wrong?"
msgstr "뭐야? 왜그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing
#. Speaker = Nightwarden Minthara
#. NodeID = e47b5b47-a229-51f1-c635-f863a582f44d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_DrowFollowing:e47b5b47-a229-51f1-c635-f863a582f44d
msgctxt "h7d6e3be0g90e5g42ffg82d9gbbcdbbcb9e99"
msgid "The quicker, the better."
msgstr "빠를수록 좋지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = 0894fdb0-c6ad-1b34-4cde-49cfd3dc3ec7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:0894fdb0-c6ad-1b34-4cde-49cfd3dc3ec7
msgctxt "h31b8e807g5b37g4a72g8f92g8f1dae79feb2"
msgid "There is much we must discuss. Do you have a safe place to camp nearby?"
msgstr "의논할 게 많아. 근처에 야영할 만한 안전한 장소 없을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = 0d7a6ad2-5cd0-63d3-7a08-a00326910076
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:0d7a6ad2-5cd0-63d3-7a08-a00326910076
msgctxt "h78656293g7efbg4466g8864g8c67b46d0dad"
msgid "Thank you."
msgstr "고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Narrator
#. NodeID = 0f0ac942-252e-6ed3-e6b6-95fe5478c2fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:0f0ac942-252e-6ed3-e6b6-95fe5478c2fb
msgctxt "h9c2b8ea9g0b96g42fdga046ga68c76771c5d"
msgid ""
"*Her mind reels, but is no longer clouded. She accepts the truth... she has "
"no choice.*"
msgstr "*그녀의 정신이 휘청거리지만, 더 이상 흐리지 않습니다. 그녀는 진실을 받아들입니다... 선택의 여지가 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Narrator
#. NodeID = 2d211ad6-0ca0-c1ab-6115-b63b1c7dcc87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:2d211ad6-0ca0-c1ab-6115-b63b1c7dcc87
msgctxt "h14d5d674g7ffdg4615g8d43g771606b1962e"
msgid ""
"*The artefact connects with her, pulling your minds together, and showing "
"her all that you have seen.*"
msgstr "*아티팩트가 민타라와 연결되며, 당신의 그녀의 정신이 하나로 통합되고, 그녀에게 당신이 본 것을 모두 보여줍니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Player
#. NodeID = 33daf056-73ce-a61a-8fdc-1b4844c63809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:33daf056-73ce-a61a-8fdc-1b4844c63809
msgctxt "h6f018d44gf833g4939g89e0geb0f116673e7"
msgid "No. I only saved you for the pleasure of killing you myself."
msgstr "아니, 널 살려둔 건 오직 내 손으로 널 죽이는 즐거움을 만끽하기 위해서였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = 35ab3c45-4e0a-e3de-c192-9b2be60e0a93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:35ab3c45-4e0a-e3de-c192-9b2be60e0a93
msgctxt "h540d2456g5804g4df7g990agb49b3dcc58ad"
msgid "Goodbye for now. I will see you soon."
msgstr "그럼 나중에 보자. 곧 다시 만나도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = 3addc060-04fe-ae80-ceda-1c41bd6abecd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:3addc060-04fe-ae80-ceda-1c41bd6abecd
msgctxt "h594e0935gc652g439dgb639g1fdddcee9155"
msgid ""
"Now I leave as an exile. But you risked your life to rescue me - for that, I "
"am grateful."
msgstr "이번엔 추방자로서 떠나야 하겠지만, 넌 나를 구하기 위해 네 목숨까지 걸었어. 그 점에 대해서는, 고맙게 생각해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = 3d6fcd28-0369-000e-d67f-f903651d3cba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:3d6fcd28-0369-000e-d67f-f903651d3cba
msgctxt "h97e65a53g13f7g42deg9de6g7446fcf8c617"
msgid "More than you know."
msgstr "그건 잘 알고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Player
#. NodeID = 4b1e777f-d55d-20e5-2531-249054587db5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_Event_LeavesForCamp = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:4b1e777f-d55d-20e5-2531-249054587db5
msgctxt "h87d51f68ga22dg4a94gb54fg054e8efb4196"
msgid "<i>Tell her where to find your camp.</i>"
msgstr "<i>민타라에게 야영지의 위치를 알려준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Narrator
#. NodeID = 6f6d8b13-f1b6-5548-ee27-14d4ebac30f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:6f6d8b13-f1b6-5548-ee27-14d4ebac30f3
msgctxt "hb186a620g92fag4dbdg8b2cg75ce51259854"
msgid ""
"*The Prism, your dream visitor, the protection that keeps you from obeying "
"the Absolute, and becoming illithid. She knows it all in a moment.*"
msgstr ""
"*프리즘, 당신의 꿈의 방문자, 절대자에게 복종하는 것과 일리시드가 되는 것을 막아주는 보호 장치. 그녀가 그 모든 것을 단숨에 "
"이해합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Player
#. NodeID = 72d3725c-39dd-00c6-cf08-a643282d81d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:72d3725c-39dd-00c6-cf08-a643282d81d6
msgctxt "h464eef59g5b37g4ec0g9607g1f12010eda07"
msgid "Correction - when we meet again, <i>you</i> will die."
msgstr "정정하지 - 다음번에 우리가 만난다면, <i>네가</i> 죽게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = badd367b-387a-44f9-aad2-3c92e42c3d82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:badd367b-387a-44f9-aad2-3c92e42c3d82
msgctxt "h6c2747b3gf72ag49d7g982cg201a495a5967"
msgid ""
"I last left Moonrise as a commander in the Absolute's army, obeying the "
"voice of a god. I thought I had found a home... and a purpose."
msgstr ""
"전에 문라이즈를 떠났을 땐 신의 목소리에 복종하는 절대자의 군대의 지휘관이었지. 난 집이 되어 줄 곳과... 목적을 찾았다고 생각했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Player
#. NodeID = d50bd175-3e0b-432c-65bf-634cbb1f37b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_Event_LeavesForCamp = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:d50bd175-3e0b-432c-65bf-634cbb1f37b2
msgctxt "h5ebf85e2g4b71g4f2eg8853ged1a7efe9969"
msgid "Fine - go to my camp."
msgstr "알았어 - 내 야영지로 가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = d8178452-3811-a788-4d07-02ac86880947
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Satisfied = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:d8178452-3811-a788-4d07-02ac86880947
msgctxt "hec451220g7d84g479ag8b41gd5c57bc44daf"
msgid "Vile beast - you are crueller than the cultists."
msgstr "역겨운 짐승 같으니, 광신도 놈들보다 더 잔혹하구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = e620c4da-3d5f-9e0d-748e-46420d6006d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:e620c4da-3d5f-9e0d-748e-46420d6006d3
msgctxt "hc3ae4638gf6f3g4967g84a8g0a2251e0f82a"
msgid "Goodbye."
msgstr "그럼 잘있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = e6685cf9-8caa-283f-5941-ea22048b029d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:e6685cf9-8caa-283f-5941-ea22048b029d
msgctxt "hf21c6912gaa61g480dg8ae4g8940f802b1fd"
msgid "The cult couldn't break me - what chance do you have?"
msgstr "광신도들 조차도 날 무너뜨리지 못했는데, 네가 무슨 수로?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = e849de7d-226b-d7b8-83b1-4d6a40e64a5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Annoyed = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:e849de7d-226b-d7b8-83b1-4d6a40e64a5c
msgctxt "h97863eeag2f75g4aefga256g5fa66e0a01d0"
msgid "I think not - <i>this</i> time, the pleasure will be all mine."
msgstr "내 생각은 좀 다른데, <i>지금</i> 그 즐거움을 만끽하는 건 내가 될 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = f7f87873-37f0-d79a-0d74-719e7658f61d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:f7f87873-37f0-d79a-0d74-719e7658f61d
msgctxt "hddd98c12g766cg4db4g901egb46121046289"
msgid ""
"If I leave you, I fear the Absolute's voice will reach me again. And the "
"next time we meet, one of us will die."
msgstr "하지만 너를 떠나면 절대자의 목소리가 다시 손길을 뻗을 거야. 다음에 만나면, 너와 나 둘 중 한 명은 죽게 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = f9d9ec8b-5c36-a76a-d05b-7c1e6b63540f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:f9d9ec8b-5c36-a76a-d05b-7c1e6b63540f
msgctxt "hff8e0837gb223g4fcbgab19g7f173f0045d9"
msgid ""
"I admire your confidence. But when you next see me, I may have the "
"Absolute's armies at my back."
msgstr "네 자신감은 정말 부럽군. 하지만 다음에 널 다시 보게 될 때, 내 뒤에 절대자의 군대가 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Player
#. NodeID = fca63f75-76c6-77cd-61dc-0b748af719e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:fca63f75-76c6-77cd-61dc-0b748af719e9
msgctxt "h5ca744acgf895g4a2bg8d40gbf76c30fafa3"
msgid "Then stay out of my way."
msgstr "그럼 내 앞길을 막지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Player
#. NodeID = fdcdec4c-aefe-9e5b-83b8-41f20b880cc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:fdcdec4c-aefe-9e5b-83b8-41f20b880cc4
msgctxt "he40db029ga081g4811g99c1g58326490962d"
msgid "I freed you, Minthara, but you're on your own now."
msgstr "난 너에게 자유를 줬어, 민타라. 하지만 이제부터는 혼자 헤쳐나가야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped
#. Speaker = Nightwarden Minthara
#. NodeID = ffadb892-eac7-d4c6-395d-32183560c85d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Escaped:ffadb892-eac7-d4c6-395d-32183560c85d
msgctxt "h4cb12974gc919g47e4g806ag7e1978464b4b"
msgid ""
"I would - but I fear that without you, I will not be able to choose my own "
"path."
msgstr "안 그래도 그럴 생각이지만, 네가 없으면 내 자신의 통제권을 상실하게 될 지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara
#. Speaker = Player
#. NodeID = 8efb3173-a4ef-465d-bf08-012408fff1be
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara:8efb3173-a4ef-465d-bf08-012408fff1be
msgctxt "he9790accg5593g4444g906bge61064c78f21"
msgid ""
"You know, Minthara's still locked up somewhere in there. We could save "
"her... Or not."
msgstr "있잖아, 민타라가 아직 저기 어딘가에 갇혀 있어. 우리가 꺼내줄 수도 있겠지... 아님 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara
#. Speaker = Player
#. NodeID = 8efb3173-a4ef-465d-bf08-012408fff1be
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara:8efb3173-a4ef-465d-bf08-012408fff1be
msgctxt "hab5accfbg6d5cg4df3gbd45g15b807634649"
msgid ""
"Minthara's still locked in the towers. I am hardly fond of her - but she "
"might be of use."
msgstr "민타라가 아직 탑에 갇혀 있다. 그자가 마음에 들진 않지만, 유용하게 써먹을 수 있을지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara
#. Speaker = Player
#. NodeID = 8efb3173-a4ef-465d-bf08-012408fff1be
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara:8efb3173-a4ef-465d-bf08-012408fff1be
msgctxt "h4c658e10g387ag49a8g95a1g6296f4e8eddd"
msgid ""
"Minthara's still locked in the cells below Moonrise. We should go back for "
"her - she'd do the same for us. Probably."
msgstr "민타라가 아직 탑 지하 감방에 갇혀 있어. 돌아가서 구해 줘야 해. 걔도 우릴 구해 줬을 테니까. 추측이지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara
#. Speaker = Player
#. NodeID = 8efb3173-a4ef-465d-bf08-012408fff1be
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara:8efb3173-a4ef-465d-bf08-012408fff1be
msgctxt "h2a341fdeg4b80g48f4ga3a9gc345dd7ed4a6"
msgid ""
"Perhaps we should consider helping Minthara. She may be a useful person to "
"owe us a favour."
msgstr "아무래도 민타라를 도와주는 게 좋겠어. 신세를 지워서 유용하게 써먹을 수 있을지도 모르잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara
#. Speaker = Player
#. NodeID = 8efb3173-a4ef-465d-bf08-012408fff1be
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara:8efb3173-a4ef-465d-bf08-012408fff1be
msgctxt "hcc4af421gf524g4e8cg8e28g1fdfa04cac5d"
msgid ""
"Minthara's still imprisoned in Moonrise. If I were inclined, I could save "
"her. Not that I'm inclined."
msgstr "민타라가 아직 문라이즈에 갇혀 있어. 마음만 먹으면 꺼내 주는 것쯤이야 간단하지. 별로 내키진 않지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara
#. Speaker = Player
#. NodeID = 8efb3173-a4ef-465d-bf08-012408fff1be
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara:8efb3173-a4ef-465d-bf08-012408fff1be
msgctxt "h24aeea46gc8b0g4822ga05eg1e63f939b669"
msgid ""
"Minthara's imprisoned here. She could <i>probably </i>be saved, if you "
"didn't have a conscience."
msgstr "민타라가 여기 갇혀 있어. <i>어쩌면</i> 감방에서 빼낼 수도 있겠지. 네 양심만 허락한다면 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara
#. Speaker = Player
#. NodeID = 8efb3173-a4ef-465d-bf08-012408fff1be
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara:8efb3173-a4ef-465d-bf08-012408fff1be
msgctxt "h2b847462ge95eg4675ga4a7gf4e8e3b36dd4"
msgid "Minthara may prove useful to us, should we wish to save her..."
msgstr "민타라에게 기회를 줄 수도 있겠지. 정 구하고 싶다면야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara
#. Speaker = Player
#. NodeID = 8efb3173-a4ef-465d-bf08-012408fff1be
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_PAD_HelpMinthara:8efb3173-a4ef-465d-bf08-012408fff1be
msgctxt "h124099d6g1d9dg467cgb928gb6a9d24f350f"
msgid ""
"Minthara was dragged to the prison in Moonrise. If she's still there, this "
"is our last chance to save her."
msgstr "민타라는 문라이즈의 수감동으로 끌려갔어. 걔가 아직 거기 갇혀 있다면, 지금이 마지막 기회겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 017620d5-b696-d339-bd25-77a52881a981
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:017620d5-b696-d339-bd25-77a52881a981
msgctxt "h2f555164g026dg4620g9d19gdc9c4b91c7ef"
msgid "I did. Well done, True Soul. Minthara - how do you feel?"
msgstr "그래. 잘했어, 참된 영혼. 기분이 어때, 민타라?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 032821d4-2ef5-bac3-27db-26e2c285d8fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:032821d4-2ef5-bac3-27db-26e2c285d8fb
msgctxt "h7f2172a4g7527g44c6g8e5ag204b7095771f"
msgid "No more anger, no more doubt. She is perfect."
msgstr "분노도, 의심도 없어 보이는군. 완벽해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 03374120-cbf4-3f6c-c148-280d96538987
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_Event_FightTorturers = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:03374120-cbf4-3f6c-c148-280d96538987
msgctxt "h77008fe6g8495g472egaec5g0b7cd07d200d"
msgid "<i>Tsk</i>, Minthara. A good little servant does not <i>sulk.</i>"
msgstr "<i>훗</i>, 민타라. 착한 종복은 주인에게 <i>삐지거나</i>하지 않는단다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 044a138e-e1d4-57bb-43bf-c9d32df3a5d2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_Event_FightTorturers = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:044a138e-e1d4-57bb-43bf-c9d32df3a5d2
msgctxt "h59c53f18gdbfeg4c66g9334ga6470120fae3"
msgid "Infidel!"
msgstr "불신자다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 05e4bd3a-4f14-7bcc-fe6c-2a78d408e7da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:05e4bd3a-4f14-7bcc-fe6c-2a78d408e7da
msgctxt "h78e2ec9bg652eg477bgaeaegbc1b6cb2b6f9"
msgid "I expected her to be dismembered. Disappointing."
msgstr "지금쯤 조각조각 잘라 놓았을 거라 기대했는데, 실망이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 067aa429-2811-5edf-826d-bc86da3103cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:067aa429-2811-5edf-826d-bc86da3103cf
msgctxt "h3580718aga26fg4a26ga32cg1a813599117a"
msgid "Bloodlust. Murder. Chaos."
msgstr "피. 살인. 혼돈."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 06ae1228-1d57-caef-bb47-d042145e20e3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Freed = True
#.     - MOO_MintharaFate_Event_MintharaFightsTorturers = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:06ae1228-1d57-caef-bb47-d042145e20e3
msgctxt "hc69df9efg629eg435cgb138g03e637fdc9af"
msgid "Share my strength, and strike the guards down."
msgstr "내 힘을 나누어줄게, 간수들을 쓰러뜨리자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 0714040d-514f-29da-77bf-2dd4b56cfb07
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:0714040d-514f-29da-77bf-2dd4b56cfb07
msgctxt "haf358ea4gb17cg4bb5g8996gede64232a439"
msgid "She is cleansed, as ordered. Were my methods too subtle for you?"
msgstr "명령받은 대로 그녀를 정화시켰어. 내 방식이 너무 고급져서 느끼지 못한 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 08140544-4e84-ad0a-5ce6-a6b8a025f10e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_Event_FightTorturers = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:08140544-4e84-ad0a-5ce6-a6b8a025f10e
msgctxt "h1719a0faga61dg4455gb4f2ge740f496db03"
msgid "I think not - you're dead."
msgstr "끝나는 건 네놈이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 08bb1af6-b6be-5068-2181-2d00aa983344
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:08bb1af6-b6be-5068-2181-2d00aa983344
msgctxt "h4c99d99eg1fd9g4f89g9e4eg0044898e0950"
msgid "I'm putting a stop to this."
msgstr "이 짓거리를 끝내 주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 0a0108d5-6895-ba91-7ab4-72555acb158c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_MintharaFate_HasMet_Torture(4) = True
#.   Global:
#.     - MOO_MintharaFate_State_Torture = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:0a0108d5-6895-ba91-7ab4-72555acb158c
msgctxt "h453aaa74g3173g446cga76aga20d4cef9dd0"
msgid ""
"You were adored, Minthara. Brought up from the darkness, and into the "
"Absolute's light."
msgstr "넌 사랑받았어, 민타라. 어둠에서 절대자님의 빛으로 들어 올려짐 받았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 0b2e106f-656c-2f32-ad19-74a35ae0405c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:0b2e106f-656c-2f32-ad19-74a35ae0405c
msgctxt "h7c95283eg2b12g410fg9e8eg0637fac52e43"
msgid "Weak. You shouldn't have interfered with our work."
msgstr "약해 빠졌긴. 처음부터 우리 일에 관여하지 말았어야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 0b892eb4-3098-fe24-4ec4-5222461a2519
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Following = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:0b892eb4-3098-fe24-4ec4-5222461a2519
msgctxt "h74e477e7ge1bdg432egb3a3gac93a6d6fd7a"
msgid ""
"Prudent. Let us go, then - I will be your mute and faithful slave. For now."
msgstr "현명하군. 그럼 가자, 충실한 벙어리 노예가 되어 주겠어. 적어도 지금은."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 0cb87d38-4c6d-abe7-d129-041811a653ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:0cb87d38-4c6d-abe7-d129-041811a653ff
msgctxt "h20b4bdb6g1720g4ca3ga8f3gd67b64d8fa6d"
msgid "A <i>challenge</i>, sister. Who would be so bold?"
msgstr "<i>도전</i>이로군, 자매여. 참 대담하지 않은가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 0e35b043-e16d-2a44-73f0-a4f41f6fa5f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Annoyed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:0e35b043-e16d-2a44-73f0-a4f41f6fa5f6
msgctxt "h77bdb15cg9208g4573g8346gd8ae68264b5c"
msgid ""
"We saw the memory of the pain you caused, while she was vulnerable in your "
"arms."
msgstr "네가 그녀를 네 품 안에 안았을 때 주었던 고통의 기억을 보았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 0efba0a3-182c-d36c-7d4a-61c612673443
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:0efba0a3-182c-d36c-7d4a-61c612673443
msgctxt "hd8e0364ag029bg4ba1g92bbg872b39e19d8e"
msgid "I obeyed to the best of my ability."
msgstr "내가, 할 수 있는, 최선을 다해, 복종했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 132715a0-1f0e-5a2f-a92b-3e63d4ed2c83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:132715a0-1f0e-5a2f-a92b-3e63d4ed2c83
msgctxt "h410c20b2gdfb4g4d80g8c16gf8b6d4ea1235"
msgid ""
"I don't know who you are, True Soul, but under General Thorm's command "
"everybody has their duties. Learn yours, and stick to them."
msgstr ""
"참된 영혼이여, 자네가 누군지는 모르겠지만, 쏨 장군의 지휘 아래 우리 모두 각자의 역할이 있다네. 자네는 자네 역할에 집중하도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 14c566c6-e4b8-08cc-862b-0de1f05f70b0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:14c566c6-e4b8-08cc-862b-0de1f05f70b0
msgctxt "headf8197g28a9g43aagaaabga0cd2683bb21"
msgid "Stand aside. I'm taking charge here."
msgstr "물러나. 이제 내가 주도할 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 18c3ca2e-b4eb-832a-be3d-0f951eb9f59d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_Event_FightTorturers = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:18c3ca2e-b4eb-832a-be3d-0f951eb9f59d
msgctxt "h5c0c34c9g0c0eg45ebgb965g812ce0291d6b"
msgid "Offal, sister. Meat that doesn't yet know it is dead."
msgstr "고기 찌꺼기지, 자매여. 이미 자신이 죽은지도 모르고 나불대는 고기."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 1c22feb6-1423-2931-edbc-835542d522db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:1c22feb6-1423-2931-edbc-835542d522db
msgctxt "h5bb84fe8g17acg4b68g9be7g7e4c3390f0d1"
msgid "We are erasing her."
msgstr "우리는 그녀를 '지우는' 중이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 1c7406a6-84fc-ad4f-2097-534366da6456
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Following = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:1c7406a6-84fc-ad4f-2097-534366da6456
msgctxt "h2d9d3c84g398eg4320gbd3egb38a6fdd89c3"
msgid ""
"And look at you, right here with me. I suggest we leave - <i>silently.</i>"
msgstr "그렇게 말하는 너도 여기 내 옆에 있지. 이제 가는 게 좋겠어. <i>조용하게.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 1e901a89-f4a4-2a6f-66ed-a5e1caf4e34b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:1e901a89-f4a4-2a6f-66ed-a5e1caf4e34b
msgctxt "h1c1ec7d5g4296g4954g8425ga736de17ed54"
msgid "She does look a little... <i>vacant</i>, sister."
msgstr "좀... <i>공허해 보이긴 하는데</i>, 자매여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 220a8e78-63b5-bb0d-ca42-df8f14834178
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:220a8e78-63b5-bb0d-ca42-df8f14834178
msgctxt "hcacd9c0fga438g434dg8265g43c1846bf9ae"
msgid "Excellent - I'd like to watch."
msgstr "훌륭해 - 이건 꼭 봐야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 22c157fc-b53d-ef6b-03b7-596a0993c80f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:22c157fc-b53d-ef6b-03b7-596a0993c80f
msgctxt "hd2fe190dgf0ceg4028g9131gd26f477d276f"
msgid ""
"There is little left to take charge of. We have already pushed her mind to "
"the brink - the task is ours to finish."
msgstr "너한테 맡길 만한 일은 별로 남지 않았어. 이미 정신을 벼랑 끝으로 밀어붙였으니, 마무리하는 일만 남았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 237ab588-47c4-cc67-eaa1-a73fe95642f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Satisfied = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:237ab588-47c4-cc67-eaa1-a73fe95642f0
msgctxt "hda768ee6gc8a8g4179gb3e2g95e73607e232"
msgid "I didn't dare hope... I owe you more than my life."
msgstr "이런 기회가 오다니... 너에겐 내 목숨보다 큰 빚을 지게 되는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Narrator
#. NodeID = 2439017c-7b8e-668f-e094-78bc2cafa35f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Tentacle_EnteredVoid = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:2439017c-7b8e-668f-e094-78bc2cafa35f
msgctxt "h5e9f9203g0658g491agb12cg7ceaaed426e0"
msgid ""
"*Her torturers are not dominating her - they are destroying her mental "
"defences, and exposing her to the presence that claims to be the Absolute.*"
msgstr ""
"*고문자들은 그녀를 지배하려는 게 아닙니다. 그들은 정신의 방벽을 파괴해서 '절대자'라 불리는 존재에게 노출시키려 하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 24d41b14-e562-37b3-bf10-bcc47fecf6ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:24d41b14-e562-37b3-bf10-bcc47fecf6ff
msgctxt "ha42659e9g3965g4bc9g8e9dg905a3ee6a99c"
msgid "Please."
msgstr "제발."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 284032e2-92c3-97e0-932b-ac9d504561f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:284032e2-92c3-97e0-932b-ac9d504561f3
msgctxt "hc0fe5757ge0ffg48d0ga889g11c47c73be28"
msgid "Her mind is yours. Break it."
msgstr "그럼 네 손에 맡기지. 부숴 버려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 28ed80be-f10b-4a03-58a5-fb6e66c9d59c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Pacified = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:28ed80be-f10b-4a03-58a5-fb6e66c9d59c
msgctxt "h27a8ef40gd15bg4b57g9a7fg3c6ab906735f"
msgid "Apologies - I won't interfere."
msgstr "미안, 더 이상 간섭하지 않을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 2ec4c97a-91e7-5e59-dc4f-8161ac0d0635
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:2ec4c97a-91e7-5e59-dc4f-8161ac0d0635
msgctxt "h2116a1dcg90a7g43a8gbfe1g80d597330137"
msgid "<i>Reach out for Minthara's mind.</i>"
msgstr "<i>드로우의 정신에 접근한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 30cab97f-5803-29ea-8a22-7e75e0f7b9bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:30cab97f-5803-29ea-8a22-7e75e0f7b9bb
msgctxt "h56a24266g1923g47afgbbd8gc0139b1069ef"
msgid "Her feelings for you made her weak - you were cunning to exploit them."
msgstr "너에 대한 감정이 그녀를 약하게 만들었지 - 우린 그걸 교활하게 써먹었을 뿐이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 3305cf73-c94a-791c-bc64-975f824445ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:3305cf73-c94a-791c-bc64-975f824445ed
msgctxt "h5db542aeg6a70g47b0g8dc3g5dac81af15ef"
msgid "<i>Attack the guards.</i>"
msgstr "<i>간수들을 공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 336920d2-de2c-aa07-45e9-c8e537992ef4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:336920d2-de2c-aa07-45e9-c8e537992ef4
msgctxt "h21aaed59g5bc3g4c6dg9fbcg9ae19f27069d"
msgid "This ends now - and so do you."
msgstr "이제 이 짓거리를 끝낼 때가 됐어 - 물론 네 목숨도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 346e33a1-7a8a-b481-9c48-af849ffb7a50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:346e33a1-7a8a-b481-9c48-af849ffb7a50
msgctxt "h326a39b1g164fg453cgb3abg1adc25265ad2"
msgid "<i>Attack the guards.</i>"
msgstr "<i>간수들을 공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 3b946e1a-e652-ea86-77cd-c82990c2b82c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:3b946e1a-e652-ea86-77cd-c82990c2b82c
msgctxt "hbfc43ac2g46e7g4c54g9a7ege7c9f983add9"
msgid "Impossible - she was broken!"
msgstr "이건 불가능해 - 저년은 완전히 무너졌을 텐데!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 3f2691bc-2116-f971-fa38-b76331073929
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:3f2691bc-2116-f971-fa38-b76331073929
msgctxt "h89ea73e2gac88g4f1eg980fgd1a337d3d976"
msgid "No - this is <i>our</i> duty."
msgstr "아니, 이건 <i>우리가</i> 할 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 415e604d-7ea9-cc6a-18eb-9e8271d75a2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:415e604d-7ea9-cc6a-18eb-9e8271d75a2b
msgctxt "h7f722d78gd28eg48edg95feg5e5136613428"
msgid "And we will stick to ours. Goodbye, Minthara."
msgstr "그리고 우리는 우리 역할을 다 해야겠지. 잘가, 민타라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 44410746-40ef-e539-578c-0f5761551a1d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Satisfied = False
#.      - MOO_WallTentacle_Tentacle_EnteredVoid = False
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Annoyed = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:44410746-40ef-e539-578c-0f5761551a1d
msgctxt "hf6288386g5db3g460cg9c5bg1e618ae6c5d2"
msgid "<i>Push past the presence, towards Minthara.</i>"
msgstr "<i>그 존재를 밀쳐내고 민타라를 향해 나아간다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 44ff2797-705d-c2ce-ea9d-4738006b58ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:44ff2797-705d-c2ce-ea9d-4738006b58ba
msgctxt "h67897954g5487g4714g9cebge6b9f8f4ac67"
msgid ""
"I have a plan - fake obedience, and the guards will leave without raising "
"the alarm."
msgstr "좋은 생각이 있어. 복종하는 척을 하면, 경보를 울리지 않고도 저 간수들이 떠나게 만들 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Disembodied Voice
#. NodeID = 4967d3d1-79de-f15a-6882-4b708e7d59da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:4967d3d1-79de-f15a-6882-4b708e7d59da
msgctxt "h6a8111dcg63f5g4281ga96cg97247cf69097"
msgid ""
"<b>-CANNOT-</b><i>\n"
"                   -hide-\n"
"<b>-SUBMIT-\n"
"</b>                   -embrace-\n"
"</i>"
msgstr ""
"<b>-안 돼-</b><i>\n"
"                   -숨어-\n"
"<b>-포.기.해-\n"
"</b>                   -받아들여-\n"
"</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 4a883f39-8e95-2b1a-feae-8bd4e1b0fe9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:4a883f39-8e95-2b1a-feae-8bd4e1b0fe9b
msgctxt "hd2760985g6284g41fag8e75g8c116c4ddddf"
msgid "None of you will break me."
msgstr "너희 중 누구도 날 무너뜨리지는 못할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 4b163d10-2c49-42e6-56a6-f35b1e7d8345
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Satisfied = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:4b163d10-2c49-42e6-56a6-f35b1e7d8345
msgctxt "h07ca0e86g4154g4390g9e6dg65a2e63d12cf"
msgid "We saw her memories of how you spoke with her. And lay with her."
msgstr "네가 그녀에게 어떻게 이야기하고, 품에 안았는지 기억을 통해 다 보았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Disembodied Voice
#. NodeID = 4f3b6f5f-2655-f084-1ff4-119f0a17ff3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:4f3b6f5f-2655-f084-1ff4-119f0a17ff3e
msgctxt "hb345bd37g50e6g4917g81cag721e82f56014"
msgid ""
"<i>-your-</i>\n"
"                -ally/foe/<b>PREY</b>-\n"
"\n"
"<i>-my-</i>\n"
"                -gift/offering/<b>CLAIM</b>-"
msgstr ""
"<i>-너의-</i>\n"
"                -아군/적군/<b>먹.잇.감</b>-\n"
"\n"
"<i>-나의-</i>\n"
"                -선물/제물/<b>내.거.야</b>-"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 5209b390-aeda-4900-7368-deffbe9096b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:5209b390-aeda-4900-7368-deffbe9096b1
msgctxt "h415d20cbgca1ag4bdbgac61g0b5dff713f71"
msgid "Well done, True Soul. We will put her to work."
msgstr "잘했어, 참된 영혼. 이제 민타라에게 일 거리를 좀 줘야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 52f88666-fa24-cfa2-ed81-34d622b556ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:52f88666-fa24-cfa2-ed81-34d622b556ed
msgctxt "h30882414ga31eg4979gb3bdge012d70a168b"
msgid "She will not be utterly destroyed. What is useful shall remain."
msgstr "완전히 망가지진 않을 거야. 쓸모 있어 보이는 건 남겨둬야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Narrator
#. NodeID = 534443f5-4689-2ed7-1dba-91daa2f2d430
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:534443f5-4689-2ed7-1dba-91daa2f2d430
msgctxt "hd57bef85g7213g4a24g8b06g6c834cee9fc6"
msgid ""
"*Navigating the storm, you reach the nexus of her mind. It is a wound, "
"bleeding raw emotion and shattered memories. But she senses your arrival.*"
msgstr ""
"*폭풍을 뚫고 나아가자, 정신의 중심부에 도착합니다. 그곳은 열린 상처이자, 피범벅 된 감정과, 산산이 조각난 기억입니다. 하지만 그녀는 "
"당신의 도착을 감지합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 5497ac28-c5f8-44e7-31ad-1cec3fae8571
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:5497ac28-c5f8-44e7-31ad-1cec3fae8571
msgctxt "h065d820ega915g44a2g8517g9baa9a1697e0"
msgid "I will put my faith in you, and pretend to be their slave."
msgstr "널 믿고, 저놈들의 노예가 된 척할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 557d33b4-0391-42dd-9b7d-acaa146ebed1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:557d33b4-0391-42dd-9b7d-acaa146ebed1
msgctxt "h4fc216b5g5af4g4615g9d7egc5ab50d6dcb4"
msgid "We do not need assistance. Little of her remains."
msgstr "도움은 필요없어. 이제 거의 다 끝났으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 572bcce2-c70f-c944-60c9-58fd19204e76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:572bcce2-c70f-c944-60c9-58fd19204e76
msgctxt "hc24314aeg38c2g4f75gb7d2gea3a50aa9990"
msgid "Come. We'd better move."
msgstr "가자. 어서 움직이는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 57ea62a3-6928-db1e-d386-742dc6d615cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:57ea62a3-6928-db1e-d386-742dc6d615cf
msgctxt "he64c91a4g4117g49ffg9ce2g980460010042"
msgid "Whatever it is, I sense it, somewhere below - furious, and hungry."
msgstr "뭐가 됐든, 저 아래 어딘가에 있는 게 느껴져 - 분노하고, 굶주리고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 5a589b5c-816f-8cf3-2f30-13f4ffba855e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:5a589b5c-816f-8cf3-2f30-13f4ffba855e
msgctxt "h9b97d2efgab97g4a40g8ad9gee7343f732e9"
msgid "Sister... look at her. Closely."
msgstr "자매여... 그녀를 자세히 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 5d4333eb-9188-3d29-063d-18aff101191b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(4) = True
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Pacified = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:5d4333eb-9188-3d29-063d-18aff101191b
msgctxt "h33ca4e41g2c54g4ba1ga3c4g4a84cfd1cb38"
msgid "Nothing! Make her <b>NOTHING!</b>"
msgstr "껍데기! 그년을 <b>빈껍데기</b>로 만들어 버려!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 5dbc28eb-6246-a028-6541-2dab0e24b821
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:5dbc28eb-6246-a028-6541-2dab0e24b821
msgctxt "h405321d7gd059g4a7ag9308g8623357bf41c"
msgid "N-no! My sister only meant to compliment your delicate work."
msgstr "아-아니! 우리 자매는 그저 네 섬세한 작업을 칭찬하려던 것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 615fe6c9-2c2f-7633-efdb-2f374a62a6ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:615fe6c9-2c2f-7633-efdb-2f374a62a6ee
msgctxt "h9af22367gac6eg4513g8277g29e6959122ec"
msgid "That bond made her vulnerable - you were cunning to exploit it."
msgstr "그 유대감이 그녀를 약하게 만들었지 - 우린 그걸 교활하게 써먹었을 뿐이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 6c784adc-0444-763e-c952-7bdbeff252b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Satisfied = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:6c784adc-0444-763e-c952-7bdbeff252b2
msgctxt "hf7bc081dgd3cfg4171g9926g4e1d754756c0"
msgid "You came. I prayed that you would, but there are no gods left to me."
msgstr "와줬구나. 네가 와주기를 기도했지만, 내 곁에 더이상 신은 남아있지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 6c8c208e-a0ba-b8dd-ab39-e3a7c5f4512b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:6c8c208e-a0ba-b8dd-ab39-e3a7c5f4512b
msgctxt "h8e6d236bg585dg49b9g8218g1cfc32a86e2b"
msgid ""
"Yes - your authority is great. We can learn, watching you break what little "
"remains of her mind."
msgstr "좋아 - 네 권위는 굉장하군. 네가 이 년의 정신에 남아있는 찌꺼기를 부수는 걸 보면서, 우리가 뭔가 배울지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 6fc166c9-9498-fd04-6f99-c7cc05d9e491
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:6fc166c9-9498-fd04-6f99-c7cc05d9e491
msgctxt "ha7ce004bg3c91g4410ga884gb92b260b8995"
msgid "Seems to me it's back-stabbing that got you where you are."
msgstr "그렇게 등 뒤에서 쑤시고 다니니까 이런 꼴이 된 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 6ff173ef-7aca-cd5f-582e-419ebe588e20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:6ff173ef-7aca-cd5f-582e-419ebe588e20
msgctxt "h931b4747gd152g4248g93f1gf571d6480549"
msgid "So it is you who will end me."
msgstr "결국 나를 끝내는 건 너로구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 73f9d814-8f66-98c1-242f-11b11d9f1fd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:73f9d814-8f66-98c1-242f-11b11d9f1fd7
msgctxt "hbb3ac4acg7d30g4eadgab49g60156a1ebc8b"
msgid "The only thing I'm going to break is you."
msgstr "내가 부수는 건, 네놈들이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 754aee51-8cb6-748b-4f3c-c3c054cc1f67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Satisfied = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:754aee51-8cb6-748b-4f3c-c3c054cc1f67
msgctxt "h9bc8e8a3g8c85g4a59gb629g75218b6757bc"
msgid "No - please. Not you."
msgstr "안돼, 제발. 너에게만은 보이기 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 7576e2a8-ac81-e68f-d4c6-c5ecfecf79a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:7576e2a8-ac81-e68f-d4c6-c5ecfecf79a4
msgctxt "hf84d0c64g7ce8g4346gbe67g3986bd80d64e"
msgid "You need to wait here."
msgstr "여기서 기다려 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 761e2ae0-782c-cf5b-6b89-b5cfb05f6dab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:761e2ae0-782c-cf5b-6b89-b5cfb05f6dab
msgctxt "h11fd806dg5ca2g44f2g8d2eg8963f1add640"
msgid "Ngh..."
msgstr "으윽..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 773ef8e0-fc77-37ca-302f-b73cff397799
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:773ef8e0-fc77-37ca-302f-b73cff397799
msgctxt "ha1dbdeaag9a23g4bafg9543g5000aa9ff14b"
msgid "Look at her. The True Soul Minthara you knew is gone."
msgstr "이것 봐, 네가 알던 참된 영혼 민타라는 이제 없다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 78662546-114b-4c01-4298-bf4e7430e956
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:78662546-114b-4c01-4298-bf4e7430e956
msgctxt "h236f3180g5c4bg4c2dgbd9eg8e6a327ff408"
msgid "Is this really wise? She's a valuable asset."
msgstr "이게 과연 현명한 행동일까? 민타라는 귀중한 자산이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 78c23b16-4809-7e3a-5683-89d439c8b3ed
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:78c23b16-4809-7e3a-5683-89d439c8b3ed
msgctxt "h4fabd38ag5622g427ega915gecaea91d567f"
msgid "I've been instructed to handle this prisoner myself."
msgstr "이 포로를 직접 처리하라는 지시를 받았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 7b42e6da-f37d-05c1-6a2c-00f962bcae3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:7b42e6da-f37d-05c1-6a2c-00f962bcae3f
msgctxt "h7929f8dbg473bg4a57g8622g4b0954c7a94e"
msgid "Yes - I'm looking forward to watching her break."
msgstr "좋아 - 그녀가 어떻게 망가질지 기대되는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 7d17bb9d-16bf-fde3-2379-f13622e8291c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:7d17bb9d-16bf-fde3-2379-f13622e8291c
msgctxt "hc3a5a9b7ga005g4165g9a58g5a0315beb83a"
msgid "<i>Reach out, try to comfort her.</i>"
msgstr "<i>손을 뻗어, 그녀를 위로하려 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 7d17bb9d-16bf-fde3-2379-f13622e8291c
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:7d17bb9d-16bf-fde3-2379-f13622e8291c
msgctxt "h83e466b3gb862g42degaf91g443f887f1961"
msgid "Stop this!"
msgstr "당장 멈춰!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 7e3b170c-a11a-906b-83fe-21cdb657311e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:7e3b170c-a11a-906b-83fe-21cdb657311e
msgctxt "h4f03b7ebg2beeg4f75ga41agbb3af748aca7"
msgid ""
"We ought to return to our posts, sister. There'll be plenty more prisoners "
"to practice on."
msgstr "일단 돌아가는 게 좋겠어, 자매여. 연습에 사용할 죄수가 많이 필요할 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 805c3952-c96e-879b-ac7d-51ebc0a7999a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:805c3952-c96e-879b-ac7d-51ebc0a7999a
msgctxt "h5be92c0cgd79fg4bc2g9d5eg51017b8f2307"
msgid ""
"When the body suffers, we retreat into the mind. But when the mind breaks, "
"all is lost."
msgstr "단순한 육체의 고통은, 정신이라는 도피처를 없앨 수 없지. 하지만 정신이 붕괴하면, 존재 자체가 소멸하는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 8127603d-b039-bc16-aa3d-2817eb3520f2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_Event_TorturersLeave = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:8127603d-b039-bc16-aa3d-2817eb3520f2
msgctxt "h670f03cag1832g4cabga573gf894741f9e4e"
msgid "An ill thing, to let an enemy show their back and live."
msgstr "적이 등을 돌려 살아 나가는 걸 지켜만 보고 있는 건 역겹기 짝이 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Narrator
#. NodeID = 8663aae8-f3e7-4a52-98b0-ca9dcd5ac2b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:8663aae8-f3e7-4a52-98b0-ca9dcd5ac2b9
msgctxt "hf368c9b2g4ed7g48c0g8925g9a0df6b28a06"
msgid ""
"*The presence pushes back against your intrusion, expanding to occupy every "
"inch of Minthara's mind - until you are forced out.*"
msgstr ""
"*그 존재가 당신의 침입에 반발하며, 민타라의 정신 구석구석을 차지하기 위해 뻗어져 나갑니다 - 당신은 민타라의 정신 밖으로 밀려 "
"나갑니다*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 8879793b-e09c-8c30-7704-714d50f58c14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:8879793b-e09c-8c30-7704-714d50f58c14
msgctxt "h42d3bcd4g3d99g441dg8785gebb752148c2e"
msgid ""
"I would prefer to make these bastards bleed, but I trust that you speak from "
"caution rather than cowardice."
msgstr "당장이라도 이 개자식들을 두들겨 패주고 싶지만, 네가 그렇게 말하는 건 겁이 나서가 아니라 신중하기 때문이란 걸 믿을 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Narrator
#. NodeID = 8b531070-cb31-6c5d-7b80-9b3cbce7f351
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:8b531070-cb31-6c5d-7b80-9b3cbce7f351
msgctxt "h175911feg6f0cg4835g94c8g1bd876b9109d"
msgid ""
"*Minthara's mind connects with yours. Not strong, as you remember it, but "
"fractured... disintegrating.*"
msgstr "*민타라의 정신이 당신의 연결됩니다. 당신이 기억하는 강함은 남아있지 않고, 조각나고... 분해되고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 8bbfbb43-dd10-9d06-0aa9-c928092686d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:8bbfbb43-dd10-9d06-0aa9-c928092686d0
msgctxt "h41b34eb0gad14g40f2g99adg467d8f1b38de"
msgid "But first, let's make these bastards bleed."
msgstr "일단은, 저 개새끼들을 두들겨 패주자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 8c87ee4e-eec6-3a8b-eef0-06c0d2aa1a87
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Pacified = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:8c87ee4e-eec6-3a8b-eef0-06c0d2aa1a87
msgctxt "h82b4f33bg39cag47a9g83b4gf472b82862b4"
msgid "<i>Erase her.</i>"
msgstr "<i>그녀를 지워버린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 8e1658e0-1c67-eff0-d61a-36e8f372684b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:8e1658e0-1c67-eff0-d61a-36e8f372684b
msgctxt "h55450c22g66e9g45c5gb731g2b70e122e34a"
msgid ""
"Make it swift, then. Anything to silence that thing - that <i>voice</i>."
msgstr "그럼 빨리 해줘. 저 <i>목소리</i>를 닥치게 할 수 있는 것이라면 뭐든지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 8eee042a-460a-ad6a-974c-a542ab8d2018
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Waiting = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:8eee042a-460a-ad6a-974c-a542ab8d2018
msgctxt "h9f36cfdeg7fb9g495dg819dgb555afa5dfa6"
msgid "Not an instant longer than I must. Make haste."
msgstr "필요 이상으로 기다리진 않을 거야. 서둘러."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 90e1087f-c761-25b2-cc11-8a12d0b15a68
#. HandlePath = RollAdvantageReason
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Tentacle_EnteredVoid = False
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Annoyed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:90e1087f-c761-25b2-cc11-8a12d0b15a68
msgctxt "he93da5dfg9af4g440bgb8e9g628d000873a9"
msgid "Relationship"
msgstr "Relationship"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 90e1087f-c761-25b2-cc11-8a12d0b15a68
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Tentacle_EnteredVoid = False
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Annoyed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:90e1087f-c761-25b2-cc11-8a12d0b15a68
msgctxt "h8df7ccb4g6bbcg4057gaf57g4f1c8ee8604d"
msgid "<i>Push past the presence, towards Minthara.</i>"
msgstr "<i>그 존재를 밀쳐내고 민타라를 향해 나아간다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = 9324d4b1-eef6-9045-5ac5-c00773ea6d84
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_Event_FightTorturers = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:9324d4b1-eef6-9045-5ac5-c00773ea6d84
msgctxt "ha6ceb27ag6ac4g45f7g9f2bgaa758cb0cd15"
msgid "You won't break us. And you won't leave here alive."
msgstr "넌 우리를 '부수지' 못해. 살아서 여기서 나가지도 못할 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = 9501129a-17b5-e8c3-ebbf-cd33fea87409
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:9501129a-17b5-e8c3-ebbf-cd33fea87409
msgctxt "h2e536a98g0113g4084gad4bg8c9c6ddb117c"
msgid "Quickly. Kill them - we must leave."
msgstr "서둘러. 간수들을 죽여줘 - 우린 떠나야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = 97c50639-b184-26d1-f576-d1381aed45ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Tentacle_EnteredVoid = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:97c50639-b184-26d1-f576-d1381aed45ef
msgctxt "h87eb56ceg86a2g4656g88f7gfaa931a9d521"
msgid "<i>Acknowledge the presence - ask it to let you pass.</i>"
msgstr "<i>나아가도 되는지 허락을 구한다</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 9da78133-78c4-9110-45b6-205d13f03178
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:9da78133-78c4-9110-45b6-205d13f03178
msgctxt "h8f8a2477g079bg4cfbgb27ag09e5f4266163"
msgid ""
"Wilful, though. But you are right - whatever is useful, we will leave intact."
msgstr "'자아가 있는' 자산이지. 하지만 네 말대로야. 쓸모 있는 건 뭐든지 건드리지 않고 내버려 둘거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = 9eb92168-1ab7-883c-d16f-36bd7d4aace0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:9eb92168-1ab7-883c-d16f-36bd7d4aace0
msgctxt "hae600808gc02ag4986g836aga25469e38e2d"
msgid "For the Absolute."
msgstr "절대자를 위하여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Narrator
#. NodeID = 9ffe3d81-819e-a127-9369-4a31a343865a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:9ffe3d81-819e-a127-9369-4a31a343865a
msgctxt "h5d66d518g6028g4bdag9a80gb29fdb147c5f"
msgid ""
"*Her torturers are not dominating her - they are destroying her mental "
"defences, and exposing her to something <i>else</i>. The Absolute?*"
msgstr ""
"*고문자들은 그녀를 지배하려는 게 아닙니다. 그들은 정신의 방벽을 파괴해서 어떤 <i>다른</i> 존재에게 노출시키려 하고 있습니다. 그 "
"존재는 절대자일까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = a1d4b066-e585-a9dd-4cef-56ea0da7c707
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(4) = True
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Pacified = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:a1d4b066-e585-a9dd-4cef-56ea0da7c707
msgctxt "hea857aaeg900fg4211ga466g4f9a015be399"
msgid "Shatter her mind. Carve it apart."
msgstr "그년의 정신을 산산조각내자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Narrator
#. NodeID = a25cad06-eeda-4c27-71c4-017a18e56a3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:a25cad06-eeda-4c27-71c4-017a18e56a3f
msgctxt "h69c0ead2ga211g42f3ga923g25ae01031c46"
msgid ""
"*All it takes is a thought, and Minthara's essence dissolves. You are "
"released from her mind.*"
msgstr "*그렇게 의도하는 것만으로, 민타라의 본질을 분해합니다. 당신은 그녀의 정신에서 떠납니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = a5b0c3e1-c388-9e4d-09b3-beff9eb654a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:a5b0c3e1-c388-9e4d-09b3-beff9eb654a1
msgctxt "h585e08b1g1fd0g4fb1g865dgbadac935bb48"
msgid "For the Absolute."
msgstr "절대자를 위하여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Narrator
#. NodeID = aaa529c0-93ab-d2de-ef55-7843646bc7db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:aaa529c0-93ab-d2de-ef55-7843646bc7db
msgctxt "h7c5bf996ge492g40f1g9f98gcc9b7db32a73"
msgid ""
"*Immediately, your mind is swept into a greater vortex. A psionic storm with "
"Minthara at its centre.*"
msgstr "*그 순간, 당신의 정신이 큰 소용돌이에 빨려들어갑니다. 민타라를 중심으로 몰아치는 사이오닉 폭풍입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = b22f39d4-9d2c-15ec-6186-c0501a3f5151
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Tentacle_EnteredVoid = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:b22f39d4-9d2c-15ec-6186-c0501a3f5151
msgctxt "hac11ff8ag3593g47dcg99ebga5d925483f92"
msgid ""
"That <i>thing</i> is your precious Absolute - what it truly sounds like."
msgstr "그 <i>이놈</i>은 너의 소중한 절대자님의 원래 목소리인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = b58f26ea-8952-abd2-5d94-c3b3e28eda88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:b58f26ea-8952-abd2-5d94-c3b3e28eda88
msgctxt "h800cb9b2gfb82g42cdga4adg6f8625d068d6"
msgid "I don't know what came over me. I am <i>loving </i>your work."
msgstr "나도 내가 왜 그랬는지 모르겠어. 네 작품은 정말 <i>끝내주는</i> 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = b6dd9472-7a97-bf14-61a3-7fb1e164d046
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:b6dd9472-7a97-bf14-61a3-7fb1e164d046
msgctxt "h03773d62g5c51g4ac7gbfb3g3d2c2c0b9742"
msgid "A mortal who disappointed you in ways the Absolute never would."
msgstr "절대자께선 절대 하시지 않을 방식으로 너를 실망시킨 필멸자에게서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = b9000fab-0034-7f51-10db-ec8f472f9c76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:b9000fab-0034-7f51-10db-ec8f472f9c76
msgctxt "h9da43936g1618g4b61g9755gddb4a7c6a319"
msgid "Excellent. A job well done, sister."
msgstr "훌륭하군. 잘했다, 자매여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = ba24f212-dc9e-94ca-2f5e-6f88ab74c8f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:ba24f212-dc9e-94ca-2f5e-6f88ab74c8f1
msgctxt "h96a28402g1c6ag434eg9ef2gb8cbaed62b38"
msgid "And most damning of all, an inability to follow orders."
msgstr "그리고 무엇보다, 명령을 따르지도 못했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = bc5ce619-a9ae-8d40-a47e-e63db1c8ec21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_WallTentacle_Tentacle_EnteredVoid = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:bc5ce619-a9ae-8d40-a47e-e63db1c8ec21
msgctxt "h4e5ff3e0ga23bg414cga480g9617a1d8717c"
msgid "<i>Push past the presence, towards the drow.</i>"
msgstr "<i>그 존재를 밀쳐내고 드로우를 향해 나아간다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = c1766fc0-772d-6894-38a8-28f2e255184c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:c1766fc0-772d-6894-38a8-28f2e255184c
msgctxt "hfdc27861gd1a9g4ad7ga9d6g8c01de5d2355"
msgid "Indeed. Seems I have a bit to learn, yet."
msgstr "맞아. 아직도 나도 배워야 할 게 남아있는 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = c8f63c79-560d-6e42-ada7-30e42d9dc087
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:c8f63c79-560d-6e42-ada7-30e42d9dc087
msgctxt "h77d1c550gc4dfg4ba8g902eg525b69255885"
msgid "You are nothing."
msgstr "너는 아무것도 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = ca0f35cd-47db-7345-fc83-f00fd59a292f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:ca0f35cd-47db-7345-fc83-f00fd59a292f
msgctxt "ha5f8ff92g8e52g4ee7g8887g59cbc954967e"
msgid ""
"This thing, that speaks inside me - it has all but destroyed me. But... it "
"fears you."
msgstr "이놈, 내 안에서 말하는 이놈이, 내 정신을 완전히 무너뜨릴 뻔했어. 그런데... 이게 널 두려워하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = cc582b7c-093f-8c3e-db1f-a05432efc635
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:cc582b7c-093f-8c3e-db1f-a05432efc635
msgctxt "h12d8b280g0d36g4345gbb64g388ec2283e84"
msgid "You have no right - hnngnn."
msgstr "네 놈들에겐 아무런 권리도 - 으윽."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = cf0a29f3-6fea-3aea-19a9-8dfaf64f2082
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:cf0a29f3-6fea-3aea-19a9-8dfaf64f2082
msgctxt "h3a2e92c4gcd35g42e1g9ea0ga3af7a52ab9e"
msgid ""
"She cherished you. But it wasn't enough - you were distracted by your own "
"desires."
msgstr "그분은 널 아꼈어. 하지만 그걸로 충분하지 않았지 - 넌 제 욕망에만 정신이 팔려있었으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = d24a3abf-61d0-814d-6f6d-dcaef3c9a54a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:d24a3abf-61d0-814d-6f6d-dcaef3c9a54a
msgctxt "h011701aeg63efg4fdaga3d2g1f2f2380e237"
msgid "And isn't that <i>depressing?</i>"
msgstr "그것 참 <i>슬프지 않아?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = d2ba4eea-194e-d14e-5a2b-4cb598478a2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:d2ba4eea-194e-d14e-5a2b-4cb598478a2d
msgctxt "h154db408g5397g4adag85c4ge9c6c0d7b968"
msgid ""
"Peace, sister. Let us observe the True Soul's methods - perhaps we can learn "
"from them."
msgstr "진정해, 자매여. 이 참된 영혼이 어떻게 처리하는지 보자고 - 우리가 뭔가 배울 점이 있을지도 모르니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = d2e45991-db95-17cf-f709-2b2d746c5678
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:d2e45991-db95-17cf-f709-2b2d746c5678
msgctxt "h7a072639g9014g4575gb392ga0a976fdd05d"
msgid ""
"Because I reshaped her. If it is breaking you desire, I can snap you like a "
"twig."
msgstr "나는 그녀를 재구축했을 뿐이니까. 정 무언가 부러뜨리는 걸 원한다면, 널 나뭇가지처럼 부러뜨려 줄 수는 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = d70a46e6-2eb3-63ed-d4d9-eb0a41186813
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:d70a46e6-2eb3-63ed-d4d9-eb0a41186813
msgctxt "h15ad4f5bgcf1dg49dagb765g4a11de1b0300"
msgid ""
"Come to observe, True Soul? She is a lesson - none can rise so high that "
"they cannot fall again."
msgstr "와서 보겠나, 참된 영혼이여? 그녀는 참 좋은 교훈을 보여주고 있지 - 높이 올라갈수록 추락의 고통은 크다는 것."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = d86db83c-0b24-5d0e-7e31-5c3eee76835d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Satisfied = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:d86db83c-0b24-5d0e-7e31-5c3eee76835d
msgctxt "h166b8585ga297g4ae6g9ac6gfaf4ac259cc8"
msgid ""
"And most damning of all, an unexpected weakness - a longing for acceptance, "
"and affection. From a mortal."
msgstr "그리고 무엇보다, 예상치 못한 약점이 있었지 - 필멸자에게서 인정받고 사랑받길 바라다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = dc0dd9f7-4f14-f596-f5f7-2d5878f5afc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:dc0dd9f7-4f14-f596-f5f7-2d5878f5afc0
msgctxt "h0f5ca522g6d85g415dg9423gcadbff0b8137"
msgid "Ecstatic. Devoted. Inspired."
msgstr "황홀합니다. 헌신하겠습니다. 위대함이 느껴집니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Narrator
#. NodeID = e0154267-d823-7ee9-e5bf-e6761b045712
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:e0154267-d823-7ee9-e5bf-e6761b045712
msgctxt "h7988be63ga0c6g4028g96efg609ca2bab515"
msgid ""
"*At your familiar touch, the presence withdraws. Still there, you sense, but "
"letting you pass. Waiting.*"
msgstr "*당신의 익숙한 손길에, 그 존재가 서서히 물러납니다. 여전히 그곳에 있지만, 당신을 통과시켜주고, 기다립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = e05e807b-5469-b710-8791-4c8b17da05aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:e05e807b-5469-b710-8791-4c8b17da05aa
msgctxt "h332de5c0g1f97g4c0cg85bbg901c5d604da8"
msgid "I hope her punishment won't be too severe - she tried her best."
msgstr "너무 심하게 굴진 마 - 그녀도 나름 최선을 다했으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = e068ccc5-9cbe-35b5-6080-9390f2d73d96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:e068ccc5-9cbe-35b5-6080-9390f2d73d96
msgctxt "hc8aa88dbgdb59g48fdg940dgbc0a39118a80"
msgid "Let it go. You can plot your revenge once we're free."
msgstr "가게 둬. 복수는 자유로워진 후에 계획하면 되니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Narrator
#. NodeID = e138b867-c298-fc43-f579-f323cf2a84dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_HasMet(4) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:e138b867-c298-fc43-f579-f323cf2a84dd
msgctxt "h6d636bdegcb87g444ag81a7g1b0a258ff8a6"
msgid ""
"*The drow reaches out to you psychically, connecting with you for a moment. "
"She is infected, like you, and her mind is disintegrating.*"
msgstr "*드로우가 당신의 정신으로 손을 뻗자, 순간 당신과 그녀는 연결됩니다. 그녀도 당신처럼 감염되었고, 정신이 붕괴하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = e4141498-15dc-3952-4d6f-7ca77d0ecba6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:e4141498-15dc-3952-4d6f-7ca77d0ecba6
msgctxt "h6280f13ag2c0cg46f0g8020g29c490f8a06f"
msgid "Even so, I cannot resist it while my tormentors live."
msgstr "그렇다 해도, 저 고문자들이 살아있는 한, 더 이상 저항하는 건 힘들 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = e4bee57d-2737-b01f-4daa-437c5be48248
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:e4bee57d-2737-b01f-4daa-437c5be48248
msgctxt "h4079838fg8af9g4130g9794g21132e3d4026"
msgid "<i>Retreat.</i>"
msgstr "<i>물러난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = ead6ec96-c7bb-4c61-8430-cff8f83f6875
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:ead6ec96-c7bb-4c61-8430-cff8f83f6875
msgctxt "h28ddf085gecb5g429fg93a1g9cdc1df816eb"
msgid "Hello, Minthara. How do you feel?"
msgstr "안녕, 민타라. 기분이 좀 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = ec9b895b-cae6-75c4-20a2-1cd6ac5c34e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:ec9b895b-cae6-75c4-20a2-1cd6ac5c34e2
msgctxt "h200693d1ge742g4b7bg8ed0g614b3dfd1161"
msgid "Is it done? I did not feel her mind break."
msgstr "다 끝났나? 그녀의 정신이 부서지는 게 느껴지지 않았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = ed93f946-2e88-9392-fca5-24317be0af75
#. HandlePath = RollAdvantageReason
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Satisfied = True
#.      - MOO_WallTentacle_Tentacle_EnteredVoid = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:ed93f946-2e88-9392-fca5-24317be0af75
msgctxt "h1a298ed3g4002g4532gb5e0g92cdcc9d45f8"
msgid "Relationship"
msgstr "Relationship"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = ed93f946-2e88-9392-fca5-24317be0af75
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_NightWithDrow_Satisfied = True
#.      - MOO_WallTentacle_Tentacle_EnteredVoid = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:ed93f946-2e88-9392-fca5-24317be0af75
msgctxt "h5d46e612g986dg43ddgb6eagdc5424d1f169"
msgid "<i>Push past the presence, towards Minthara.</i>"
msgstr "<i>그 존재를 밀쳐내고 민타라를 향해 나아간다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = f10e1f6d-7a33-54d0-92f4-9425e9e941a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(4) = False
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Pacified = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:f10e1f6d-7a33-54d0-92f4-9425e9e941a1
msgctxt "h2f294564g5dd3g4d01gb77fgc9b3676cb47b"
msgid "Finish her."
msgstr "끝장내버려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = f1ec570a-a931-be33-776c-1f47f0c700a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:f1ec570a-a931-be33-776c-1f47f0c700a2
msgctxt "hd14f553cgfcb5g4f60gb45dg484d5ad8f9e5"
msgid "Wrong!"
msgstr "땡!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = f20736b5-5aba-4583-ffbe-2d5d2c3e80f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:f20736b5-5aba-4583-ffbe-2d5d2c3e80f0
msgctxt "h027cc383g03edg47e8g8aecg18d239ace372"
msgid "We have every right."
msgstr "있지, 있고말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = f34143ab-f71a-b19e-db9d-a0a9c9523a7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:f34143ab-f71a-b19e-db9d-a0a9c9523a7c
msgctxt "h2f742931g0e75g4fc0g9e02ge23d9368a06a"
msgid "<i>Reach out for the drow's mind.</i>"
msgstr "<i>드로우의 정신에 접근한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = f34ff746-4ff9-88a5-f9bc-77310aed7fdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:f34ff746-4ff9-88a5-f9bc-77310aed7fdf
msgctxt "ha91e8efcg4320g4b46g9730g0668a9aebd81"
msgid "Are you quite mad? Or maybe defective."
msgstr "정신이 나간 건가? 아님 그냥 좀 모자란 놈인 건가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = f79f5f34-4f7e-de9b-d612-a5aee9e8f900
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:f79f5f34-4f7e-de9b-d612-a5aee9e8f900
msgctxt "he7ce7085gd710g4c0aga000g8760a0de6ef8"
msgid ""
"You're the one she slept beside? Oh, excellent. You open the wound, and we "
"shall press."
msgstr "네가 이년과 잠자리 한 자인가? 오, 완벽해. 그럼 네가 상처를 열고, 우리가 힘을 가하면 되겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Sumera
#. NodeID = f8c6578a-c403-e73a-587a-ff8daea6c885
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:f8c6578a-c403-e73a-587a-ff8daea6c885
msgctxt "h720cca05g764cg48edg9055gb2e395860464"
msgid "Did you feel it, sister? The exquisite snap as her mind gave way."
msgstr "느껴졌나, 자매여? 정신이 무너지는 순간의 그 아름다운 파열음이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = f8ea0311-9161-98a8-58e8-c239757a531a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:f8ea0311-9161-98a8-58e8-c239757a531a
msgctxt "he0f0b6fcg3288g4344ga586g89c1a758dd01"
msgid ""
"The drow's mind is resilient, even now. Do not be ashamed that you could not "
"break it."
msgstr "그 드로우의 정신은 지금도 놀라운 회복력을 보이고 있어. 무너뜨리지 못해도 부끄러워할 필요는 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Player
#. NodeID = f9ad7496-2c6c-2c72-c0f3-dd0f021bc5d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:f9ad7496-2c6c-2c72-c0f3-dd0f021bc5d6
msgctxt "h0bbdcaaagdae4g4a00gb393g9caec1297e77"
msgid "What are you doing to her?"
msgstr "무슨 짓이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Questioner Jasin
#. NodeID = fb5362b3-26dd-2c60-b751-102d95414d03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:fb5362b3-26dd-2c60-b751-102d95414d03
msgctxt "h8d7ac2degf7e4g453fga847geb79d622698c"
msgid ""
"What is this - pity? Rebellion? Blasphemy? Stand down, or we will <i>put</i> "
"you down."
msgstr "동정하는 건가? 반항하는 건가? 아니면 신을 모독할 셈인가? 가만히 있어, 아니면 <i>평생 못 움직이게</i> 해줄 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Nightwarden Minthara
#. NodeID = fb6bf387-24db-7c9e-62e4-054b96705482
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_Following = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:fb6bf387-24db-7c9e-62e4-054b96705482
msgctxt "hcf6a6261g4b33g4f88g9441g376427e3a693"
msgid "Lead, then."
msgstr "그럼, 앞장서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture
#. Speaker = Narrator
#. NodeID = fcca9b45-8c75-cbb6-409a-613bc70aaf75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torture:fcca9b45-8c75-cbb6-409a-613bc70aaf75
msgctxt "hd2f4eb35g2933g4afegadffg590ff05fbdcd"
msgid "*Her mind fills with warmth, and she gently releases you.*"
msgstr "*그녀의 정신이 따뜻함으로 가득 찹니다. 그러고는 당신을 부드럽게 놓아줍니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1
#. Speaker = Questioner Sumera
#. NodeID = 0da747c0-1c49-4d4c-8af6-87a8ada82ec5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Guard001(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1:0da747c0-1c49-4d4c-8af6-87a8ada82ec5
msgctxt "hd51234adg9de6g4805g88ceg4331d2ec60fa"
msgid "A new face? Do as the Warden says, when she says, and you'll be fine."
msgstr "신입이야? 간수장이 말하면, 그대로 하면 돼, 그럼 괜찮을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1
#. Speaker = Questioner Sumera
#. NodeID = 6411e378-16dc-abd2-6137-f7ef4a968c7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Guard001(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1:6411e378-16dc-abd2-6137-f7ef4a968c7d
msgctxt "h5794080bg5970g43a7g9510gc7f70f79b676"
msgid ""
"The prisoners will say anything to get your attention. Do not acknowledge "
"them."
msgstr "죄수들은 네 주의를 끌려고 아무말이나 할 거야. 그냥 무시하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1
#. Speaker = Questioner Sumera
#. NodeID = 8731660a-5f75-049c-0b01-218e174ebf98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_MintharaFate_HasMet_Torture(1) = True
#.   Global:
#.      - MOO_MintharaFate_Event_TorturersLeave = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1:8731660a-5f75-049c-0b01-218e174ebf98
msgctxt "hef1f9021g05cbg4e11g8bb5g6e45fb3f0d2d"
msgid ""
"Apostates must suffer - by your own hand, when needed. It is the Absolute's "
"way."
msgstr "필요하다면 네 손으로 변절자들에게 고통을 주어라. 그것이 절대자님의 방식이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1
#. Speaker = Questioner Sumera
#. NodeID = a3194a3e-9f68-c490-e27c-6de0cf4aa08e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_MintharaFate_HasMet_Torture(1) = True
#.   Global:
#.      - MOO_MintharaFate_State_Pacified = True
#. SetFlags:
#.   Dialog:
#.     - MOO_MintharaFate_HasMet2_Torturer1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1:a3194a3e-9f68-c490-e27c-6de0cf4aa08e
msgctxt "h4362716bg01acg4ec7gafbcga19fbc7d151c"
msgid "Minthara sustains the Absolute's unhealing wound."
msgstr "절대자께서 민타라에게 치유할 수 없는 상처를 입히셨다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1
#. Speaker = Questioner Sumera
#. NodeID = a7d1bbb7-41fa-52c5-6485-ebdb855f4fae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_MintharaFate_HasMet_Torture(1) = True
#.      - MOO_MintharaFate_HasMet2_Torturer1(1) = True
#.   Global:
#.      - MOO_MintharaFate_State_Pacified = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1:a7d1bbb7-41fa-52c5-6485-ebdb855f4fae
msgctxt "h62a367f5gbf11g42a8gb728gb372880ab681"
msgid "Let no enemy escape Her justice."
msgstr "누구도 그 분의 정의를 피할 수 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1
#. Speaker = Questioner Sumera
#. NodeID = dbdffb35-a24b-1f7c-db93-8dbb61a6ca59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer1:dbdffb35-a24b-1f7c-db93-8dbb61a6ca59
msgctxt "h4050cdf4gaa32g4c1egb7bfga99d7faf7431"
msgid "There will be more traitors still. They too must suffer - see to it."
msgstr "변절자들이 더 있을 거다. 그놈들도 똑같은 고통을 겪어야 해, 반드시."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2
#. Speaker = Questioner Jasin
#. NodeID = 35c9c058-f5c5-4672-801b-e7895a6fc436
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Guard003(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2:35c9c058-f5c5-4672-801b-e7895a6fc436
msgctxt "h5a9e877bg423fg4bc2gb1d9g57914d07972a"
msgid ""
"Plant one foot in front of the other. Head forward, back straight. Make them "
"fear you."
msgstr "한쪽 발을 다른 발 앞에 두고. 머리는 정면, 허리는 펴. 널 두려워하게 만들란 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2
#. Speaker = Questioner Jasin
#. NodeID = 4a500328-e312-1b87-4c4d-682fb4d915b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_MintharaFate_HasMet2_Torturer2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2:4a500328-e312-1b87-4c4d-682fb4d915b3
msgctxt "h4a26a8b7gb69bg4d0dg84a6gfd1f071c5245"
msgid "Find a ripe prisoner, and a reason to beat them. I miss the screams."
msgstr "적당한 죄수를 찾아봐, 그리고 때릴 이유를 찾아. 비명소리가 듣고 싶군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2
#. Speaker = Questioner Jasin
#. NodeID = 8958ca1b-9af5-b171-dafa-d05b8e9715b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2:8958ca1b-9af5-b171-dafa-d05b8e9715b1
msgctxt "he6e7f64cg4cc6g461ega1feg019a303e3bcb"
msgid "And I <i>do</i> hope she commands it."
msgstr "그리고 그 명령을 <i>간절히</i> 기다리고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2
#. Speaker = Questioner Jasin
#. NodeID = a4b9ec33-101b-42c5-0102-dd175d73f4e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_MintharaFate_HasMet_Torture(1) = True
#.   Global:
#.      - MOO_MintharaFate_State_Pacified = True
#. SetFlags:
#.   Dialog:
#.     - MOO_MintharaFate_HasMet2_Torturer2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2:a4b9ec33-101b-42c5-0102-dd175d73f4e7
msgctxt "h3b4bf746g8396g4f1eg86cbgbb92dba610f8"
msgid "Minthara has broken. Find another to break - and let me be witness."
msgstr "민타라는 이미 망가졌어. 다른 망가뜨릴 걸 찾아와, 내가 볼 수 있도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2
#. Speaker = Questioner Jasin
#. NodeID = cc1b09be-7918-a27d-89c5-172f3be6e3ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Guard003(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2:cc1b09be-7918-a27d-89c5-172f3be6e3ba
msgctxt "hf605f934g7930g4aedg9b4bg06ecb0faf878"
msgid "Pay the prisoners no mind, and show them no mercy."
msgstr "포로들에게는 마음 쓸 필요없어, 자비를 보이지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2
#. Speaker = Questioner Jasin
#. NodeID = e9ff36b1-035c-4a89-ccb0-43462e7896e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_MintharaFate_HasMet_Torture(1) = True
#.   Global:
#.      - MOO_MintharaFate_Event_TorturersLeave = True
#. SetFlags:
#.   Dialog:
#.     - MOO_MintharaFate_HasMet2_Torturer2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MintharaFate_Torturer2:e9ff36b1-035c-4a89-ccb0-43462e7896e5
msgctxt "h5be36f85g3744g478bg8e04g27aec4f91c09"
msgid ""
"I'd bruise every traitor's mind a thousand times over, if the Warden "
"commanded it."
msgstr "간수장께서 명령만 하시면, 변절자들 마음을 천번도 더 상하게 할 수 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Misc_DaisyAD_Audience
#. Speaker = GROUP_Daisy
#. NodeID = 03248ff5-f919-4161-b27b-ab63e4a97eaa
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Misc_DaisyAD_Audience:03248ff5-f919-4161-b27b-ab63e4a97eaa
msgctxt "hc12c97ecge49ag488dg9482g92ad4e1298ae"
msgid ""
"There can be no doubt. This is the place. This is where we'll discover the "
"secret of the Absolute."
msgstr "의심할 여지 없어. 여기다. 여기가 절대자의 비밀을 알아낼 수 있는 곳이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Misc_DaisyAD_Audience
#. Speaker = GROUP_Daisy
#. NodeID = 03248ff5-f919-4161-b27b-ab63e4a97eaa
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Misc_DaisyAD_Audience:03248ff5-f919-4161-b27b-ab63e4a97eaa
msgctxt "haf33dc95gf3dbg4296gb622g1ff158992110"
msgid ""
"There can be no doubt. This is the place. This is where we'll discover the "
"secret of the Absolute."
msgstr "의심할 여지 없어. 여기다. 여기가 절대자의 비밀을 알아낼 수 있는 곳이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MonkAmulet_AD_PrisonComment
#. Speaker = Sentient Amulet
#. NodeID = 178a541e-39e6-63c5-352d-a01373de66cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_MonkAmulet_AD_PrisonComment:178a541e-39e6-63c5-352d-a01373de66cd
msgctxt "hdce1e191g0c04g4182g8841gab3e79d71c43"
msgid "Hohohoooo! Conditions most grim, courtesy of Ketheric Thorm."
msgstr "으흐흐흐! 분위기가 아주 음산한데. 다 케서릭 쏨 덕이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime
#. Speaker = Narrator
#. NodeID = 112432ca-5dac-74cb-65dd-c601dd42b12e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_SpeakToGnomesWarning(1) = True
#. SetFlags:
#.   Object:
#.     - CRIME_FoundGuiltyPlayer(0) = True
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime:112432ca-5dac-74cb-65dd-c601dd42b12e
msgctxt "h3a23a0beg3f8fg41b0g8ff3g4ea2b361f482"
msgid ""
"*You've been caught in the act. This time, however, there is no talking your "
"way out of it.*"
msgstr "*당신은 규칙을 위반하다 걸렸습니다. 하지만, 이번엔 대화로 풀 방법은 없어 보이는군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime
#. Speaker = Narrator
#. NodeID = 129d10de-cf50-2c95-7370-d5f6bb6227f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_GnomesHaveTools = True
#. SetFlags:
#.   Object:
#.     - CRIME_FoundGuiltyPlayer(0) = True
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime:129d10de-cf50-2c95-7370-d5f6bb6227f9
msgctxt "h5cef535eg5b73g4ca5g8b66g82233b071151"
msgid ""
"*You've been spotted helping the prisoners. Prepare to defend yourself.*"
msgstr "*죄수를 돕다가 발각되었습니다. 스스로를 방어할 준비를 하십시오.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime
#. Speaker = Narrator
#. NodeID = 18ef485b-d5f3-c3af-26b2-52d0fdb6e955
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime:18ef485b-d5f3-c3af-26b2-52d0fdb6e955
msgctxt "h42735eb6ge892g4f40gac2cgcb3e6fb92cf5"
msgid "*Your words fail to be convincing.*"
msgstr "*당신의 말은 설득력이 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime
#. Speaker = Narrator
#. NodeID = 25ce2063-c16c-a466-92d2-d78803600db0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_SpeakToTieflingsWarning(1) = True
#.     - MOO_Jailbreak_Event_SpeakToGnomesWarning(1) = True
#.   Global:
#.     - MOO_Jailbreak_State_WulbrenAlerted = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime:25ce2063-c16c-a466-92d2-d78803600db0
msgctxt "h28e4322eg2529g4cafg8a49g742e0ce0dc70"
msgid ""
"*Your conversation has been cut short. These prisoners are for Disciple "
"Balthazar's attention only.*"
msgstr "*당신의 대화는 중지되었습니다. 이 죄수들은 신봉자 발타자르만이 다룰 수 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime
#. Speaker = Narrator
#. NodeID = 5efe460c-0023-3437-796a-a62eec85d1e1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_State_WulbrenAlerted = False
#.     - MOO_Jailbreak_State_WulbrenSuspicious = True
#.     - MOO_Jailbreak_State_PrisonerInterogationAllowed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime:5efe460c-0023-3437-796a-a62eec85d1e1
msgctxt "hab8dd010g10edg44c1gb630g12f497c8df11"
msgid ""
"*Your association with Disciple Balthazar inspires respect and a touch of "
"fear. You are free to speak to the prisoners.*"
msgstr "*신봉자 발타자르와 당신과의 관계는 존경과 두려움을 불러일으킵니다. 죄수들과 대화할 수 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime
#. Speaker = Narrator
#. NodeID = 719a35fd-d1b9-b40f-3ce5-caddfccfd10a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime:719a35fd-d1b9-b40f-3ce5-caddfccfd10a
msgctxt "he8503af4g4ec8g4e52g87b2g0bc8f27de562"
msgid ""
"*You have been let off with a warning, but you will not be so lucky next "
"time.*"
msgstr "*이번에는 경고로 끝났지만, 다음번에는 그렇게 운이 좋지 않을 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime
#. Speaker = Player
#. NodeID = 81950ff8-e68c-1060-b881-cd0e6c666edf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime:81950ff8-e68c-1060-b881-cd0e6c666edf
msgctxt "hba00efbbg6b63g444bg95b2g8d726248c05e"
msgid "I have permission from Balthazar. Ask him."
msgstr "발타자르에게 허가를 받았다. 그 자에게 물어 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime
#. Speaker = Player
#. NodeID = 8b47ecbd-af6f-0544-7d8a-07f780235446
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime:8b47ecbd-af6f-0544-7d8a-07f780235446
msgctxt "h3dc34725gaec2g4165ga0a5g901a5050f0a5"
msgid "What are the prisoners going to do? Talk me to death?"
msgstr "죄수들이 뭘 어쩌겠어? 말로 날 죽이기라도 할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime
#. Speaker = Narrator
#. NodeID = 9f4a7d38-81a4-d60f-7e4f-5afdfd608f1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime:9f4a7d38-81a4-d60f-7e4f-5afdfd608f1f
msgctxt "hcd6cb02dgbbf3g4ed0gb2eag22f6f604e743"
msgid ""
"*Your argument is dismissed. Only the Warden can grant such exceptions.*"
msgstr "*당신의 주장을 받아들이지 않습니다. 오직 간수장만이 그런 예외를 허가할 수 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime
#. Speaker = Narrator
#. NodeID = c3856b04-d287-b1a7-493a-82bd9a96ecb3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_State_WulbrenAlerted = False
#.     - MOO_Jailbreak_State_WulbrenSuspicious = True
#.     - MOO_Jailbreak_State_PrisonerInterogationAllowed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime:c3856b04-d287-b1a7-493a-82bd9a96ecb3
msgctxt "h4f789531gaf54g4bdbga514ge50aa601187b"
msgid ""
"*Your reasoning is hard to argue with. You're free to speak to the "
"prisoners.*"
msgstr "*당신의 논리는 반박하기 어렵습니다. 죄수들과 대화할 수 있게 되었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime
#. Speaker = Player
#. NodeID = fb2b3322-1342-9fdb-9197-46bae7056c32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_Jailbreak_SpeakToPrisonerCrime:fb2b3322-1342-9fdb-9197-46bae7056c32
msgctxt "hfc5c4a10gbc40g4a44g93c9g99da8ceb5516"
msgid "My apologies - won't happen again."
msgstr "사과하지. 다시는 이런 일 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 0a7d0d9d-e2f6-40c5-a4df-a58b54a4e4a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:0a7d0d9d-e2f6-40c5-a4df-a58b54a4e4a5
msgctxt "h993b9e43g371dg46f3gb7e4gb7d698d215a2"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 1e522595-1fa5-47c1-57c1-4244788f23bd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_MintharaAllowedInMOO = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:1e522595-1fa5-47c1-57c1-4244788f23bd
msgctxt "he0cb8d06g98fbg415ag903eg8b8445b65e5e"
msgid "*Pacified, the guard allows you and Minthara to pass.*"
msgstr "*흥분이 가라앉자, 경비가 당신과 민타라에게 길을 비켜 줍니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 227ce0da-f1b6-4dfe-ab26-f8400e014d89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:227ce0da-f1b6-4dfe-ab26-f8400e014d89
msgctxt "hc06d163bg565dg4f98gb251g426d813fa4f4"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 264d0d70-7053-4d44-a63b-f23c73a1ddef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:264d0d70-7053-4d44-a63b-f23c73a1ddef
msgctxt "he7fe6240g8ca0g4063g8c60g7ef7f73182dc"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 3498a7b8-9fbd-549c-cb5e-384ba85c05ea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:3498a7b8-9fbd-549c-cb5e-384ba85c05ea
msgctxt "hf7c890efg3ef9g49e4g8537g661bc2578d99"
msgid "*The guard isn't convinced - you'll have to fight your way out.*"
msgstr "*경비병을 설득하는 데 실패했습니다. 직접 싸워서 빠져나가야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Player
#. NodeID = 34a1cd35-99cd-4e8c-8992-c1db024fded8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(2) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:34a1cd35-99cd-4e8c-8992-c1db024fded8
msgctxt "hf5126587g70cdg440fgbc85gc8132b1534d7"
msgid "What prisoner?"
msgstr "어느 포로 말이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 3f26f589-514c-1eee-6128-d3564a594faa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_MintharaAllowedInMOO = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:3f26f589-514c-1eee-6128-d3564a594faa
msgctxt "h80bf0ba4g3486g4a53gae65g17e61ef4b9da"
msgid ""
"*The guard is happy to let you pass - Minthara is rather less happy about "
"your choice of words.*"
msgstr "*경비병은 기꺼이 길을 비켜 주지만, 민타라는 당신의 단어 선택이 썩 마음에 들지 않는 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 505b8cce-98ad-40db-8fae-e8a292ce3a37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:505b8cce-98ad-40db-8fae-e8a292ce3a37
msgctxt "h15c3ec4agb385g43afg9d2fg9fdd885ecf6e"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 6449588d-3a2f-4067-bae7-c809fe52bdb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:6449588d-3a2f-4067-bae7-c809fe52bdb2
msgctxt "hd0760128gf56eg4bd7gbac4g81a6fee670e9"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Player
#. NodeID = 7630e789-0dbc-4a05-b273-42e92fcbb2e1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(2) = False
#.      - ILLITHID(2) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:7630e789-0dbc-4a05-b273-42e92fcbb2e1
msgctxt "h71b8562ag892fg42e6ga250gdf4adc081761"
msgid "She's with me - stand down."
msgstr "내 일행이다. 물러나도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 7f098e17-c210-19df-7901-274a0031f3aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_MintharaFate_State_MintharaAllowedInMOO = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:7f098e17-c210-19df-7901-274a0031f3aa
msgctxt "he7d93f03gdc7bg472ag9300g777aadc737e4"
msgid ""
"*You avoided a fight this time, but bullying your way out of Moonrise is a "
"risky proposition.*"
msgstr "*이번에는 싸움을 피했지만, 문라이즈를 무력으로 탈출하려는 것은 위험한 계획입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 7ff295fc-e418-4ad7-9db4-b71353afb482
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(2) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:7ff295fc-e418-4ad7-9db4-b71353afb482
msgctxt "h3907a4cagf602g4e35gaf7bg62c321f3633e"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 82a4184f-bb98-4b47-8d0d-52961bd59577
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:82a4184f-bb98-4b47-8d0d-52961bd59577
msgctxt "hc9fbd753g86c6g4174gbba8gaa18715bb948"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 8487448f-6eb7-4b3e-870a-fb1b02579b9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:8487448f-6eb7-4b3e-870a-fb1b02579b9e
msgctxt "hd9771585ga911g45dag8539gbde822d70c7d"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = 87044c97-d2d5-f22a-ab2e-9a8dad13b945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:87044c97-d2d5-f22a-ab2e-9a8dad13b945
msgctxt "h8f9b6d65gadd5g46ceg949ag8e836c70edda"
msgid ""
"*Minthara is supposed to be in a cell - you have some explaining to do.*"
msgstr "*민타라는 감방에 갇혀 있어야 합니다. 약간의 설명이 필요하겠군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Player
#. NodeID = a5299230-18c3-278c-bc8c-56a5ef117748
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:a5299230-18c3-278c-bc8c-56a5ef117748
msgctxt "h751779f5g1d4dg4cb1ga235g5076ab39bbbd"
msgid "I think she serves rather well as my personal servant, don't you?"
msgstr "개인 하인으로 부리기에 제법 괜찮은 여자로군, 어떻게 생각하나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Player
#. NodeID = ae1eeade-2dba-2444-874a-40b941fae85c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:ae1eeade-2dba-2444-874a-40b941fae85c
msgctxt "he79f686agabefg402cgb348g1d54af434376"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Player
#. NodeID = b1341aec-8756-9f8e-0b0e-751dd53f2bb4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:b1341aec-8756-9f8e-0b0e-751dd53f2bb4
msgctxt "h485d7f94g987eg49cbg85edg3f260e946edd"
msgid ""
"Minthara's been released - and that frees up a cell for people like you, who "
"challenge their betters."
msgstr "민타라는 석방됐다. 그러니 너처럼 주제도 모르고 기어오르는 놈들로 감방을 다시 채우면 되겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Player
#. NodeID = bbbe8068-df8b-ac55-1d4c-30d47868aff7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:bbbe8068-df8b-ac55-1d4c-30d47868aff7
msgctxt "h683441fbg014eg43cdg9328g1e34d8fd840c"
msgid "Just look at her. You've nothing to fear from this drooling idiot."
msgstr "이 여자를 좀 보라고. 침이나 질질 흘리는 등신을 겁낼 필요 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = beaaff21-1fe5-4b87-9d73-e044d39dcb2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:beaaff21-1fe5-4b87-9d73-e044d39dcb2d
msgctxt "h360c9ae0gff45g42f6g9ddcg1d84717aa6bf"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = d0c4f4d0-acf5-4aca-99d3-cf740456d3da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:d0c4f4d0-acf5-4aca-99d3-cf740456d3da
msgctxt "h2403825cgcf32g42aaga19fg7928d4dc204f"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara
#. Speaker = Narrator
#. NodeID = fc8671e9-5dab-ea51-1adf-f997c44b4ae5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NGB_MintharaFate_SpottedWithMinthara:fc8671e9-5dab-ea51-1adf-f997c44b4ae5
msgctxt "hcde8eb4bg7f2eg4b10gad57g062d4e850034"
msgid "*You have no authority here - the guards serve a more powerful master.*"
msgstr "*당신은 이곳에서 어떤 권위도 없습니다. 경비병은 더 강력한 주인을 섬깁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NecromancerLab_AD_DUBackgroundBook
#. Speaker = GROUP_ORI_DU
#. NodeID = 9dbc03e3-26ad-49f3-8eb0-20c57d158135
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NecromancerLab_AD_DUBackgroundBook:9dbc03e3-26ad-49f3-8eb0-20c57d158135
msgctxt "h90a585b3ga0bdg4d62g8833g3ea573a6fb5a"
msgid "Tendays of dissections of a still-living victim."
msgstr "살아있는 표본을 대상으로 한 10일간의 해부."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NecromancersRoom_AD_Minthara_EnteredNecromancerRoom
#. Speaker = Nightwarden Minthara
#. NodeID = cc31c41e-91ec-32fd-6194-73fbd9176367
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NecromancersRoom_AD_Minthara_EnteredNecromancerRoom:cc31c41e-91ec-32fd-6194-73fbd9176367
msgctxt "hb4555864gc880g4610ga375gf5a633f79629"
msgid ""
"Balthazar's chamber. Digging through the offal is unappealing, but may be "
"worthwhile."
msgstr "발타자르의 방이군. 쓰레기 속을 뒤집는 건 별로지만, 그럴 만한 가치가 있을지도 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NightsongDeath_AD_ZrellWaiting
#. Speaker = Disciple Z'rell
#. NodeID = 410a6e81-a5b4-427a-b02b-0723432a7fa7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f54e2f42-da4b-474c-8fc5-c1cd2e433bbf_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NightsongDeath_AD_ZrellWaiting:410a6e81-a5b4-427a-b02b-0723432a7fa7
msgctxt "ha6d9a790ged21g4744g81ccg5d5726592ef5"
msgid "If so much as a rat crosses that bridge, cut its throat."
msgstr "저 다리로 쥐새끼 한 마리 못 지나가게 해. 발견 즉시 목을 그어버려라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_NightsongDeath_AD_ZrellWaiting
#. Speaker = Disciple Z'rell
#. NodeID = 5e51de0f-9de4-478b-a019-8909eb1589d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
