#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Tollhouse_State_PeacefulResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:7c2d066b-fe34-4bbb-dd05-845753e6e1d1
msgctxt "h25dfc374g528eg49e2gb3bbgac494bd5d05b"
msgid "ME? NO! GOLD! GOLD... GOLD..."
msgstr "나? 아니야! 금! 금... 금..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 87432f0d-47ba-cb50-2242-176303cac8bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:87432f0d-47ba-cb50-2242-176303cac8bb
msgctxt "hf52cc414g9b44g4746gb70eg4cd8dcbe1284"
msgid ""
"Magical expertise. I have a presentation on Weave dissonance, if you'd like?"
msgstr "마법 전문 지식. 원한다면 위브 부조화에 대해 수업이라도 해 줄까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 88aef2b3-f21c-8f72-3d45-62d784c4217c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:88aef2b3-f21c-8f72-3d45-62d784c4217c
msgctxt "h3f736fcegfc90g4415gb39cg703108b3249d"
msgid ""
"Look, I've run this scam myself - I <i>know</i> it's a trick. A basic one at "
"that."
msgstr "이봐, 나도 이 사기 수법 써 봤어 - 그러니 <i>이게</i> 기술이라는 걸 알지. 아주 기초적인 수준의 기술 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 8ab643ad-62c2-a617-e250-e68e197840a2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:8ab643ad-62c2-a617-e250-e68e197840a2
msgctxt "haf45f521g5942g4ab3g9339g96325004a99c"
msgid ""
"Haven't you heard? The local authority has decreed the gold belongs to the "
"toll collector - you."
msgstr "아직 못 들었어? 지방 당국이 통행료는 모두 네 소유라고 결정했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = 8fdcee6c-716d-40d4-e2bf-e48d6ae64338
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Tollhouse_State_PeacefulResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:8fdcee6c-716d-40d4-e2bf-e48d6ae64338
msgctxt "h4728e252g6c27g4667gbc5fg7ac67b21e969"
msgid "I... REQUIRE GOLD?"
msgstr "난... 금화가 필요하다?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = 98567c7f-9514-5522-d672-6d360c5c3df2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Tollhouse_State_PeacefulResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:98567c7f-9514-5522-d672-6d360c5c3df2
msgctxt "h19eee3f5g52a6g4174ga08cg1beae821cf66"
msgid "BUT... I... REQUIRE... GOLD..."
msgstr "하지만... 금이... 필요해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = 99c44e13-7054-e702-8c4b-5403bbd75a90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Tollhouse_TollhouseMaster_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:99c44e13-7054-e702-8c4b-5403bbd75a90
msgctxt "h1522b687g1c21g45d0g9210gac2dd6384569"
msgid "I COLLECT THE GOLD. THE GOLD SO YOU MAY PASS."
msgstr "나는 금을 모은다. 금을 내면 통과시켜 주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = 9a6c9073-e381-bf12-f897-fa281958b1a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:9a6c9073-e381-bf12-f897-fa281958b1a9
msgctxt "h72b88a29gc010g43f4g8685gb3625cecebbb"
msgid "Only a fool's easily parted with gold - what's in it for me?"
msgstr "순진한 바보들이나 금을 버리지 - 나한테 좋을 게 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = 9afd7a59-4860-3822-e0ce-e4348d69c1a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:9afd7a59-4860-3822-e0ce-e4348d69c1a1
msgctxt "h25095d45ga918g4328g89c0gfb671b46e8e7"
msgid "YOU CANNOT LEAVE. YOU MUST PAY."
msgstr "떠날 수 없다. 금을 내놓아라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = 9d6ee5e8-6d19-deb8-8809-f0d51f4972fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:9d6ee5e8-6d19-deb8-8809-f0d51f4972fd
msgctxt "hce5bb75dgc2cdg4837gbf6fgf45ae93815ae"
msgid "NO. I PAY IT BACK!"
msgstr "아니. 나는 되갚는다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = a72fc852-8122-9198-4605-c55c62bef51e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:a72fc852-8122-9198-4605-c55c62bef51e
msgctxt "hf91edca7g52afg472ega8efgd5a69dd71970"
msgid "You're an endless pit of avarice. I won't bow to your corrupt demands."
msgstr "너는 만족할 줄 모르는 탐욕 덩어리로구나. 네놈의 타락한 요구에 굴복하지 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = a858b8ab-268d-43c2-01eb-5ed298c17e1f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:a858b8ab-268d-43c2-01eb-5ed298c17e1f
msgctxt "h7f561a90gaa5ag4b6cga57dg174e59de68e6"
msgid "Yes, a trick - you're a trickster! You don't <i>deserve </i>the gold!"
msgstr "그래, 기술 - 사기꾼이잖아! 넌 금을 받을 <i>자격</i>이 없어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = a86a4fae-10c7-cedd-3676-157c0bddac72
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - TWN_Tollhouse_State_PeacefulResolution = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:a86a4fae-10c7-cedd-3676-157c0bddac72
msgctxt "he58a24bcgd5c4g4f55g99f5g08f1dafa7010"
msgid "A TRICK... <i>I </i>TRICK? NO NO NO!"
msgstr "수법... <i>내가</i> 수법을 쓴다고? 아냐, 아냐, 아냐!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Gerringothe Thorm
#. NodeID = aa80353c-9fa7-a856-526c-8b567d0303ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:aa80353c-9fa7-a856-526c-8b567d0303ac
msgctxt "hac36ef74g44a9g4f1ag8931g5dff6401ef8f"
msgid "UNLESS..."
msgstr "그러니까..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
#. Speaker = Player
#. NodeID = aed2fd8a-9a7f-bda0-1899-4daae84302cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster:aed2fd8a-9a7f-bda0-1899-4daae84302cf
msgctxt "h5e8eb5c8gc0bcg4233g891fg6d44b41f8b16"
msgid "Greater balance to the natural and civilised world, I hope."
msgstr "대자연과 문명 세계 사이의 위대한 균형."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_TollhouseMaster
