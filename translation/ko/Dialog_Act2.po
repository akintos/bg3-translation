#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Displacer_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:465d7288-253b-f4b3-a642-dddd03caafe8
msgctxt "h1645e191g9661g4a38g9579gc7d3c5a51daa"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 473cb451-7f06-37a4-a576-92624edde4d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:473cb451-7f06-37a4-a576-92624edde4d4
msgctxt "h65f787d9g05eag479eg91a5g8734afaea2f9"
msgid "Now LEAVE."
msgstr "이제 꺼져라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 4bb10dee-3b78-de71-2c91-99cad729bfdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:4bb10dee-3b78-de71-2c91-99cad729bfdc
msgctxt "h728927d6g2b0fg4dabg8f9cg43b7766f5a4d"
msgid "How does that even work?"
msgstr "대체 어떻게 그럴 수가 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 4be08e38-901b-8c3a-fe0e-ccf0478b93b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:4be08e38-901b-8c3a-fe0e-ccf0478b93b7
msgctxt "h7232ae8ag8aa3g4660g8ed1g8398b4ce59ee"
msgid "Very much. Now get out of our territory."
msgstr "아주 많이. 이제 우리 영역에서 나가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 4eeb8caf-5aae-ae0d-d65d-796e385dc0df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:4eeb8caf-5aae-ae0d-d65d-796e385dc0df
msgctxt "hf9c67219gdf58g4a4fg86e4gc6b5ebf436e7"
msgid ""
"Not just any orthon. Master is the darkest of desire. None compare to him."
msgstr "그냥 오르쏜이 아니다. 주인님은 가장 어두운 욕망의 존재다. 그 누구도 비할 바가 못 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 56d8ec2a-1eb3-1d16-3b2a-fadc8e7b1940
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:56d8ec2a-1eb3-1d16-3b2a-fadc8e7b1940
msgctxt "h7e71f901g98d8g4ae0g9776g4d83d3705efb"
msgid "You're in love with an <i>orthon</i>?"
msgstr "<i>오르쏜</i>과 사랑에 빠졌다는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 584f6a15-c9a5-f39b-8884-64ec3ce9e73c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:584f6a15-c9a5-f39b-8884-64ec3ce9e73c
msgctxt "heba09e18g508cg478cga481g25356f8e4dd6"
msgid "*Light seems to bend around the beast's body.*"
msgstr "*빛이 짐승의 몸을 휘감는 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 5fb45255-5435-420f-35e3-7aa46cb8304a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_State_MeatPersuasionAttempted(1) = False
#.      - SHA_Displacer_State_KillOrthonPersuasionAttempted(1) = False
#.   Global:
#.      - SHA_OrthonLair_Knows_MeatPoisoned = True
#.      - SHA_Displacer_State_AlliesPlayers = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:5fb45255-5435-420f-35e3-7aa46cb8304a
msgctxt "hffa283c9gd386g42e3gaa6cgae0896136210"
msgid "*You smell sour milk and rot on its breath.*"
msgstr "*당신은 저 생물의 숨결에서 시큼하게 썩은 우유 냄새를 맡습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 61bc9d39-fddf-28fd-79c0-4e46e7ab455a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_SwA_HasMet(1) = False
#.   Global:
#.      - SHA_Displacer_State_AlliesPlayers = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Displacer_SwA_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:61bc9d39-fddf-28fd-79c0-4e46e7ab455a
msgctxt "hf3318e80ga714g48e7gab71gec905d0a3772"
msgid "I'm ready."
msgstr "난 준비됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 62618bf0-c18f-dd78-2c5c-5e097aec461e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_SwA_HasMet(1) = True
#.   Global:
#.      - SHA_Displacer_State_AlliesPlayers = True
#.      - SHA_Orthon_State_Defeated = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:62618bf0-c18f-dd78-2c5c-5e097aec461e
msgctxt "h68d82ea3gcb7dg44d7gaf95ge1ca495d7664"
msgid "Leave. Before I get hungry again."
msgstr "떠나라. 내가 다시 배고파지기 전에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 6524e3d9-34a2-dddc-2c78-421a78a87e68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:6524e3d9-34a2-dddc-2c78-421a78a87e68
msgctxt "h70f2b48fgc651g4147g8f69ge47b18c4cb8f"
msgid "False master! Hind-legged liars, all! I'll shred you."
msgstr "거짓 주인! 뒷다리로 걷는 거짓말쟁이들, 전부 다! 갈기갈기 찢어 주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 70859c28-de63-1908-729a-c8e33b69af10
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:70859c28-de63-1908-729a-c8e33b69af10
msgctxt "h2c5ebeebge37eg48e1g9bd7g8e2f45a45aec"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 71c5a68e-d836-aca7-7e02-1d1cf84e84d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:71c5a68e-d836-aca7-7e02-1d1cf84e84d7
msgctxt "h07c1a074g0f77g4becg8c45g84aeb4e63b7a"
msgid "Poor servant, poor poor servant. My master would never be so cruel."
msgstr "가엾은 종복이다, 불쌍하고 가엾은 종복. 내 주인님은 그렇게 잔인하실 리가 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 7748c03e-31fa-032f-602c-f3926e98081c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_Event_DeceptionAttempted(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Displacer_Event_DeceptionAttempted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:7748c03e-31fa-032f-602c-f3926e98081c
msgctxt "hb5776945gab38g4819g919dga8fcffeaab0f"
msgid "The orthon sold you to me. I'm your master now."
msgstr "오르쏜이 널 나에게 팔았다. 이제 내가 너의 주인님이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 7a05b5cd-a159-120f-f717-28e078410839
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:7a05b5cd-a159-120f-f717-28e078410839
msgctxt "hfa546ab3g7910g44bdg9ca0gb3b583e85363"
msgid "I've a wounded pride. Leave me to nurse it."
msgstr "자존심이 상했다. 치유할 수 있게 날 내버려 둬라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 8008f145-dcb9-1356-07b3-1ed27f1870df
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 16
#. CheckFlags:
#.   Object:
#.      - SHA_Displacer_Event_NatureAttempted(1) = False
