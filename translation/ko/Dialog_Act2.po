#.      - MOO_Jailbreak_Event_ADPrepareBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 00a82e63-fae8-cc02-0b2b-314c9d21ce6c_D = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02:e45a7b09-d0ba-4ec5-b005-bbfd877a0202
msgctxt "he9ee714dg594fg42a4gbcabg33344c3e89cb"
msgid "The metal will break. It <i>will.</i>"
msgstr "부술 수 있어. 부숴질 <i>거야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = ed6c3274-d0e6-4593-a988-f7abc7a5681d
