msgctxt "hfb593618g4d65g4893g99e7gfebd9b5f2a0b"
msgid "I routed your spy, didn't I?"
msgstr "제가 그쪽 첩자를 밝혀내지 않았나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint
