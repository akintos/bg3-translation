msgctxt "ha16f874eg473eg484egbfadgbbbe0b7c457d"
msgid ""
"I saw a very <i>large</i> heron flying overhead. I admit, it was rather "
"beautiful."
msgstr "엄청나게 <i>큰</i> 왜가리가 날아가는 걸 봤어. 정말 아름다운 모습이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
#. Speaker = Player
#. NodeID = e4ed644b-f901-b5ea-f3d8-da62590c7d6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000:e4ed644b-f901-b5ea-f3d8-da62590c7d6d
msgctxt "h5878df0fgd451g4613gb7bdg3e4ebfdc15a0"
msgid "Glad to see you made it, too."
msgstr "네가 무사해서 나도 기뻐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
#. Speaker = Ox
#. NodeID = ef024a9d-e63e-91cc-5d73-631e7437fcb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_LastLightO002_Aggro = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000:ef024a9d-e63e-91cc-5d73-631e7437fcb4
msgctxt "hd59d8a65g6412g4094g8868g97080c8a0fed"
msgid "You were making quite a ruckus over there. Hope everything's all right."
msgstr "그쪽에서 꽤 소란을 피우던데 모든 게 괜찮길 바랄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001
#. Speaker = Ox
#. NodeID = 1b21f4b8-8d4d-1fbd-e404-19308e4b1529
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LastLightOx001_NightsongFreedHasmet(1) = False
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - HAV_LastLightOx001_NightsongFreedHasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001:1b21f4b8-8d4d-1fbd-e404-19308e4b1529
msgctxt "h6856a531g0b07g4ccdga8b6gebc17be9b4a8"
msgid ""
"Something seems different. I don't know what. But I do know it's something."
msgstr "뭔가 다르게 느껴져. 무엇인진 모르겠지만, 뭔가가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001
#. Speaker = Ox
#. NodeID = 22d9c336-e794-a81a-7d99-50da3b40287d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_LastLightO002_Aggro = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001:22d9c336-e794-a81a-7d99-50da3b40287d
msgctxt "h885ad50ag53bcg410fgbf10ga59322218089"
msgid "Strange fellow, that one. You sure made a mess of him."
msgstr "저거 참 괴상한 녀석일세. 아주 곤죽으로 만들어버렸는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001
#. Speaker = Ox
#. NodeID = 4cd1a8e6-3aec-596b-ed20-9311fb530325
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_DevilishOx_LastLight_HasMet_SwA = False
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001:4cd1a8e6-3aec-596b-ed20-9311fb530325
msgctxt "h97cde33fgb117g49b5gaf7fg6ce67a647be0"
msgid "It's toasty in here."
msgstr "여긴 정말 밝고 따뜻해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001
#. Speaker = Ox
#. NodeID = 99ce5742-8e46-019b-3859-882da5f3b637
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LastLightOx001_NightsongFreedHasmet(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001:99ce5742-8e46-019b-3859-882da5f3b637
msgctxt "he3e20c8cg63b5g4cc1g88d5g6f6392a397eb"
msgid "Hope we're not leaving. I wouldn't care to leave."
msgstr "떠나는 게 아니면 좋겠어. 떠나고 싶지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001
#. Speaker = Ox
#. NodeID = bee7a0b7-f7fa-05c5-cbb7-8e1e91a8538f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_DevilishOx_LastLight_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001:bee7a0b7-f7fa-05c5-cbb7-8e1e91a8538f
msgctxt "h79f2587dge5fdg4dcegb6a7gfc5de433ce38"
msgid "*Bellow!*"
msgstr "*울부짖음!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001
#. Speaker = Ox
#. NodeID = ddb09a27-1d6b-2143-6381-a4997b7a3378
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_DevilishOx_LastLight_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001:ddb09a27-1d6b-2143-6381-a4997b7a3378
msgctxt "hee4609cfg4b98g44e1g85f5g70eded5f43b6"
msgid "<i>*Mooo!*</i>"
msgstr "<i>*무우우우!*</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001
#. Speaker = Ox
#. NodeID = f5678fde-2293-96f5-a3c8-bf9c1b06c5ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_DevilishOx_LastLight_HasMet_SwA = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx001:f5678fde-2293-96f5-a3c8-bf9c1b06c5ca
msgctxt "ha3bc18a3gc126g4cfdgbc79g639ea37cb2e6"
msgid "D'you like our new friend? He's new."
msgstr "새 친구가 마음에 들어? 신입이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 03d2fcc4-dcdd-3365-762c-f89b8d33cfba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:03d2fcc4-dcdd-3365-762c-f89b8d33cfba
msgctxt "he419a4a6g0a56g4da7gaa4eg22a630b68a2a"
msgid "Fine. I'll go."
msgstr "알겠어. 갈게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 069acf00-24df-2a44-c347-c5923865804e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:069acf00-24df-2a44-c347-c5923865804e
msgctxt "he5a6d497ga313g43ceg834ag8b69aebc0e94"
msgid "It's a talent."
msgstr "타고난 재능이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 0b13e259-cfec-8c8d-d525-4ef58d92aa36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:0b13e259-cfec-8c8d-d525-4ef58d92aa36
msgctxt "hec8b2348g8635g43e5g8e25g88a86d0125dd"
msgid "Oohoohoo! This day has ended so much better than it started."
msgstr "오호호! 오늘은 하루의 시작보다 끝이 훨씬 좋군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 0beffd33-d727-755e-a288-4493b7e0c87c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:0beffd33-d727-755e-a288-4493b7e0c87c
msgctxt "hd263b4aagddc3g40dfg8e4cg22ad90c1ddd0"
msgid ""
"Now, you don't worry about me. I'll be a good, quiet little apple you can "
"tuck into the corner of your pack, just until we're inside the city walls."
msgstr ""
"자 일단, 도시의 벽 안으로 들어갈 때까지는 난 배낭 구석에 집어넣을 수 있는 착하고 작은 사과 한 알이 될 거야. 그러니 걱정 할 "
"필요는 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 0c714d71-6837-7699-4085-21221000e0fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:0c714d71-6837-7699-4085-21221000e0fe
msgctxt "he9b43f42gf644g4b54g9bd4g5039d097ef5b"
msgid ""
"Which begs the question... would you be willing to help me achieve me one "
"and greatest goal?"
msgstr "묻고 싶은 게 하나 있어... 내 가장 크고 유일한 소망을 이루는데 도움을 줄 수 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 0cacc986-350d-3fe6-77d0-9deaf19b5b3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:0cacc986-350d-3fe6-77d0-9deaf19b5b3f
msgctxt "h31cc419bg56cfg40fdg9760g9cb40de5dd63"
msgid "Glad the road to the city treated you kindly."
msgstr "도시로 가는 길이 순탄했다니 다행이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 0cbe3bde-e825-17ff-b814-30c545d89c03
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 16
#. CheckFlags:
#.   Dialog:
#.      - HAV_LastLightOx002_State_AnimalHandlingFailed(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:0cbe3bde-e825-17ff-b814-30c545d89c03
msgctxt "hec2054c5g0455g4139g86d0g210210690d46"
msgid "<i>Peer at the ox with interest. There's something in its eyes...</i>"
msgstr "<i>흥미로운 눈길로 소를 노려본다. 그 눈에는 뭔가가 있다...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 105ec928-7033-27c4-7fa9-86164c409eb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:105ec928-7033-27c4-7fa9-86164c409eb4
msgctxt "hbc1217d6g4d07g43e9ga580g568eb1db44fb"
msgid "Is that a threat?"
msgstr "협박하는 거냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 134dbc0b-157f-11ca-51ea-8a2b2e3b8d9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:134dbc0b-157f-11ca-51ea-8a2b2e3b8d9b
msgctxt "h5fc63fb3g457eg48ecg9d3ag903135ffcbc7"
msgid "I'll show you incapable..."
msgstr "자격이 없는 게 뭔지 보여주지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 1422cb12-202d-7a15-a61f-8706853e2d7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:1422cb12-202d-7a15-a61f-8706853e2d7c
msgctxt "hb3619269g9d3cg4a2bgb642g6d2b7ede0c81"
msgid "Not until you tell me exactly what you are."
msgstr "네가 진짜 뭔지 알려주기까지는 안돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 15f3eebe-838e-df97-6400-13f4a2bcf858
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:15f3eebe-838e-df97-6400-13f4a2bcf858
msgctxt "h94d68318gc778g4a07g86aag110c2102d10a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 170e77a3-4b2b-76aa-1121-d075f7774f36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:170e77a3-4b2b-76aa-1121-d075f7774f36
msgctxt "h4415bf3ag0c9dg49e2gb543gb3f33124e79d"
msgid ""
"And I don't want to be a homicidal maniac, but we can't always get what we "
"want."
msgstr "그리고 나도 살인광이 되고 싶지 않아, 우리 둘 다 항상 원하는 걸 이루지는 못하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 1d7f2aa3-1003-c709-14cf-d86894b03db4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:1d7f2aa3-1003-c709-14cf-d86894b03db4
msgctxt "h474ad04dg367cg4b51g8945g10cbaa78544d"
msgid ""
"I'm not a busybody. You ought to use me as an example, or you might get "
"yourself in trouble."
msgstr "난 참견쟁이가 아니야, 내게서 교훈을 얻지 않는다면 곤경에 처할지도 모를걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 1e2285e7-7b49-e893-6088-2a701bfe6b06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:1e2285e7-7b49-e893-6088-2a701bfe6b06
msgctxt "h69b15ab3g65f0g4655g9eb9gce6b843548c0"
msgid ""
"I hate to be rude, but this stall is taken. I fear you won't like what "
"happens if you don't leave <i>now.</i>"
msgstr ""
"무례하게 굴기는 싫지만 여긴 이미 자리가 있어. <i>당장</i> 떠나지 않는 다면 네 마음에 들지 않는 일이 일어날까 봐 우려스럽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 1f3b717c-0d6b-4b0f-837f-0f001c40fd98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:1f3b717c-0d6b-4b0f-837f-0f001c40fd98
msgctxt "h021c5d2dg0a6ag46a8g8f32g30088fe46f99"
msgid "Fine."
msgstr "좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 1fdb0be3-4b98-1e43-fcc0-60475d4755ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_DevilishOx_SmallBarn_HasMet_SwA = False
#.   Object:
#.      - HAV_DevilishOx_State_InRegion(0) = True
#. SetFlags:
#.   Global:
#.     - HAV_DevilishOx_LastLight_PeacefulPath = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:1fdb0be3-4b98-1e43-fcc0-60475d4755ea
msgctxt "h5ec93190gf9d5g4feag964egda9e12a2d73d"
msgid "Toodle-oo."
msgstr "안녕히."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 209f1522-9293-2e19-b09e-7bd3ae1b1158
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:209f1522-9293-2e19-b09e-7bd3ae1b1158
msgctxt "hb49fbeecg0251g4bccg9c19gd68bd532dda5"
msgid "<i>Refuse to tear the creature apart, though you yearn to.</i>"
msgstr "<i>황소를 찢어 발기고 싶은 갈망을 거부한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Narrator
#. NodeID = 232d95fc-d97d-64d4-f215-c7c21924a7e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CharacterDieAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:232d95fc-d97d-64d4-f215-c7c21924a7e9
msgctxt "h91e45e8ag9be7g4ac6g91e5gbec45acf8cd1"
msgid ""
"*It chooses to die docile in animal form. Only after its eyes fade does it "
"become the monster it once was.*"
msgstr "*황소는 동물의 모습으로 얌전히 죽기를 택했죠, 눈에서 생기가 사그라든 후에야 본래의 괴물 모습이 되었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 26f43db9-18cd-27b9-a555-f8bdc1012b1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:26f43db9-18cd-27b9-a555-f8bdc1012b1a
msgctxt "he438e508g8ae1g4cc5g987eg0ab68b0fcb67"
msgid "You're trying to run from violent thoughts, too, aren't you?"
msgstr "너도 폭력적인 생각에서 벗어나려는 게 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 272cd169-8e94-0f79-66c0-4f484b1d2cc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:272cd169-8e94-0f79-66c0-4f484b1d2cc6
msgctxt "h1e497e00g8686g4e66g9155g5d7b2fea62ba"
msgid "Keep quiet, and you won't have to find out."
msgstr "조용히 해. 넌 알 필요가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 2927576b-2aac-85c0-e549-2ddc9e82a017
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:2927576b-2aac-85c0-e549-2ddc9e82a017
msgctxt "hb5846754g3fb7g415egb06fgc65f87e0421b"
msgid "Right you are. Goodbye."
msgstr "네 말이 맞아, 안녕."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 2a7c33f1-56c9-789d-319e-299044ef4c99
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_HAV_LastLightO002_Aggro = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:2a7c33f1-56c9-789d-319e-299044ef4c99
msgctxt "h8017f959g4d9ag41d6gadcfg467b297e8f46"
msgid ""
"All I wanted was a bit of hay, a good brushing, and a clean stall. The "
"simple life. <i>IS THAT SO MUCH TO ASK?!</i>"
msgstr ""
"내가 바란 건 약간의 건초와 적절한 빗질, 깨끗한 우리가 전부였어. 간단한 삶 말이야. <i><b>그게 그렇게 과도한 "
"요구야?!</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 2b745ba6-3224-74ae-ca94-fff3ecd520b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:2b745ba6-3224-74ae-ca94-fff3ecd520b0
msgctxt "h7fc4cc20g77b4g48e2gb2a2g32c4692af872"
msgid "I could ask you the same question. What are you <i>really?</i>"
msgstr "너한테 똑같이 물어 보고 싶은데. <i>정확하게</i> 네 정체가 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 31711edb-4f76-65d9-1c53-6438ffd01f1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:31711edb-4f76-65d9-1c53-6438ffd01f1c
msgctxt "h65d69e36ga1f4g4ef4g8ff9gd59f5077e5d9"
msgid ""
"I admire your ability to graciously suffer the frustration of your desires."
msgstr "바램이 좌절되는 걸 곱게 받아들이는 네 능력은 높이 평가할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 338cc673-eebf-82d8-eefa-20e8ca539941
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:338cc673-eebf-82d8-eefa-20e8ca539941
msgctxt "he4758439gea86g46b1ga9c9gd863f85393c2"
msgid ""
"But what if I were smaller? More discreet? Maybe then a kind soul might "
"bring me through, right in their little pocket?"
msgstr "하지만 내 더 작다면? 더 은밀하다면? 그러면 어느 친절한 사람이 날 주머니에 넣어서 데려다 줄 지도 모를 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 36f34e7e-5dca-53f5-8b69-186819cc5f27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_DevilishOx_LastLight_HasMet(1) = True
#.   Global:
#.      - HAV_DevilishOx_LastLight_HasMet_SwA = False
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:36f34e7e-5dca-53f5-8b69-186819cc5f27
msgctxt "ha8ec877eg5076g4c42gb61ag5d3f899cadb8"
msgid "*Snuff!*"
msgstr "*킁!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 37857a97-abfd-e59f-db09-d3998d76b896
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:37857a97-abfd-e59f-db09-d3998d76b896
msgctxt "h52edc76ag77bcg4e7dga227g7451590fa19b"
msgid "Incapable of what?"
msgstr "무슨 자격?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 41e45e66-b2ab-81d5-8cf0-ab15809f6422
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:41e45e66-b2ab-81d5-8cf0-ab15809f6422
msgctxt "he8feb54eg8711g4ef5g9d34g1863ef07beea"
msgid "You're on your own."
msgstr "네가 알아서 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 432142ee-2be4-2ca5-0522-ee88701c68ad
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - DEN_DevilishOx_MeetAtDruidsGrove_HasMet_SwA = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:432142ee-2be4-2ca5-0522-ee88701c68ad
msgctxt "h58f0f02egd85ag4acfg8363g6a9812d76782"
msgid ""
"You're the ox I met back in the grove. You were very hungry then; I saved "
"you all, and now you have food."
msgstr "넌 숲에서 만났던 황소잖아. 그때 너희는 매우 배고팠지만 내가 모두를 구했고, 이제 너희는 먹을 것이 생겼지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 436bd8e5-c71f-0ff9-9b35-895298f66ee6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:436bd8e5-c71f-0ff9-9b35-895298f66ee6
msgctxt "h73050e79g95f8g45d2g9a27g217e0814f116"
msgid "<i>Reach out to pet the ox.</i>"
msgstr "<i>소를 쓰다듬기 위해 손을 뻗는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 459bf97d-378f-0c88-f8e4-f4d0a906dd4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LastLightOx002_HasMet_Siege(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.   Object:
#.      - HAV_DevilishOx_State_InRegion(0) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:459bf97d-378f-0c88-f8e4-f4d0a906dd4e
msgctxt "h40918bc7g0295g4f0bgb19bg8c98f8b5dfd3"
msgid "My skin is tingling. What will happen next?"
msgstr "좀이 쑤시는군. 다음엔 무슨 일이 일어날까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 472a2e2f-67ad-7bc8-2bf9-15ece84215a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_DevilishOx_SmallBarn_HasMet = True
#. SetFlags:
#.   Global:
#.     - WYR_DevilishOx_SmallBarn_HasMet = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:472a2e2f-67ad-7bc8-2bf9-15ece84215a5
msgctxt "hd639ad7fg1ccfg43cfgb78dg6b934659ab27"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 4a8857ab-b556-b50b-9f13-bc14f5fd7cdb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:4a8857ab-b556-b50b-9f13-bc14f5fd7cdb
msgctxt "hdf358ae5g6b23g4a53g8837g92c1733524eb"
msgid "Oh, goody. The ox with murder on its mind."
msgstr "오, 그래. 살인 생각으로 가득찬 황소 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 4b0ad855-6c37-ff6a-de07-7679c218fdf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:4b0ad855-6c37-ff6a-de07-7679c218fdf3
msgctxt "h74d912c9g4ac7g40adg9683gf775d8d4812f"
msgid "*Huff!*"
msgstr "*크흥!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Narrator
#. NodeID = 4d9a3f5b-8675-85ef-9c87-2a6c655dc44d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:4d9a3f5b-8675-85ef-9c87-2a6c655dc44d
msgctxt "he5ad7c82gf3f0g4b1dg983ag8dbd50c29250"
msgid ""
"*You deliver the ox a death by a thousand cuts, trying to taunt it into "
"revealing its old form with every slice.*"
msgstr "*당신은 황소를 난도질해 죽입니다, 한번 도려낼 때마다 옛 모습을 드러내게 하여 조롱하려 하면서 말입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 4f8fe93a-6ba6-37f5-d532-f6a1db59dcd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:4f8fe93a-6ba6-37f5-d532-f6a1db59dcd9
msgctxt "h775dd8c9g425fg4498g9b4bg692109a9987f"
msgid "<i>Hold out your hand to the ox.</i>"
msgstr "<i>황소에게 손을 뻗는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 51c5321a-2dc8-954c-61a9-1f6afbd92af1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LastLightOx002_HasMet_Siege(1) = False
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.   Object:
#.      - HAV_DevilishOx_State_InRegion(0) = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HarperGuard_002_Hasmet_Siege(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:51c5321a-2dc8-954c-61a9-1f6afbd92af1
msgctxt "hf1c1f077gfab7g4b17gb580g241ebb826eb3"
msgid "Those shades might come streaming in any moment now..."
msgstr "조만간 저 그림자들이 흘러 들어올 것 같아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 5270941c-bd66-d2bc-c840-c7b901fd788b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:5270941c-bd66-d2bc-c840-c7b901fd788b
msgctxt "he87a06c6gb03dg4302gb84ag9a07f49c6617"
msgid "My friend, you make me look like the very picture of sanity."
msgstr "이 친구야, 넌 내가 제정신으로 보이게 할 정도야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 557e69b4-71e7-947b-a1f1-302412adb4b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:557e69b4-71e7-947b-a1f1-302412adb4b4
msgctxt "h214809adg6debg48e0g8f19g348e1b698b70"
msgid ""
"I want to get into the city. Now. But it's hard to shuffle your way to the "
"front of the queue when you're, well, as big as an ox."
msgstr "도시로 들어가고 싶지만, 음, 황소처럼 몸집이 커서야 들어가는 줄 앞자리로 가기가 힘들지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 55efd033-ad87-d351-ac78-e2d5dda9677a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_DevilishOx_LastLight_HasMet_SwA = True
#.   Object:
#.      - WYR_DevilishOx_State_InRegion(0) = False
#.      - HAV_DevilishOx_State_InRegion(0) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:55efd033-ad87-d351-ac78-e2d5dda9677a
msgctxt "h0187e900g9b4eg4326g8210g03b73819918e"
msgid "Scurry on, now."
msgstr "가던 길 가, 어서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 55efffcb-9d5b-ee0b-84b8-1234705aaa0d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_DevilishOx_LastLight_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_DevilishOx_LastLight_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:55efffcb-9d5b-ee0b-84b8-1234705aaa0d
msgctxt "h68a1ab75gb482g4938g9002g1c13b7b47781"
msgid "*LOW!*"
msgstr "*음머!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 562d75d6-20d2-9562-779c-7831d45a53d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:562d75d6-20d2-9562-779c-7831d45a53d6
msgctxt "h3684bd08g81d6g4826g8c9cg4d34d16dda53"
msgid ""
"Brutality? Don't be silly. I like grass; I like my harness; I like the "
"warmth of the stable."
msgstr "잔혹함이라니? 멍청한 소리 마. 난 풀을 좋아하고 또 내 마구도 좋아해, 외양간의 온기도 좋아하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 56d084fd-56e3-5ebe-9b2c-52a0b0b2d8e5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_HAV_LastLightO002_Aggro = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:56d084fd-56e3-5ebe-9b2c-52a0b0b2d8e5
msgctxt "h16f33cabgb845g4a10gb769ge8c711352580"
msgid ""
"All I wanted was a bit of hay, a good brushing, and a clean stall. The "
"simple life. <i>IS THAT SO MUCH TO ASK?!</i>"
msgstr ""
"내가 바란 건 약간의 건초와 적절한 빗질, 깨끗한 우리가 전부였어. 간단한 삶 말이야. <i><b>그게 그렇게 과도한 "
"요구야?!</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 59aa8ffb-ef4f-ba0e-ff6c-d7541a141b17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:59aa8ffb-ef4f-ba0e-ff6c-d7541a141b17
msgctxt "hcd79c65dga85cg47b1gb053geff4a83105c6"
msgid "Excellent, the mad offal. What cruel visions do you have for me?"
msgstr "훌륭해, 그 미친 내장이군. 어떤 잔인한 환상을 내게 보여줄 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 5a3859d8-724e-d32b-a63e-bb5ed7128cb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_DevilishOx_SmallBarn_HasMet_SwA = True
#.   Object:
#.      - WYR_DevilishOx_State_InRegion(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:5a3859d8-724e-d32b-a63e-bb5ed7128cb2
msgctxt "h6da1e024g1cccg4e15g9b8bg52e566845960"
msgid "Your kindness gives me the courage to ask for a favour..."
msgstr "네 친절함에 기대어 부탁을 하나 하고 싶군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 5ae60714-fa40-bb05-47cc-4845b24cc025
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:5ae60714-fa40-bb05-47cc-4845b24cc025
msgctxt "h0ad4b1fdg413cg412egb175g0204058c8655"
msgid "How does an ox like yourself have such horrifying thoughts?"
msgstr "어떻게 너같은 황소가 이렇게 끔찍한 생각을 하고 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 5c0ac47f-0d45-14b1-acc3-d24c0d995db9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:5c0ac47f-0d45-14b1-acc3-d24c0d995db9
msgctxt "hd60076e8ge2b8g4a3dg839bgacef038dc97a"
msgid ""
"And mine. Oh-ho! And mine. Though one thing I find <i>quite </i>distasteful "
"is being kept outside our intended city."
msgstr ""
"나도 그래, 오호! 나도 그렇지. 그런데 한가지 <i>꽤나</i> 마음에 안드는 점은, 우리가 가고자 하는 도시 밖에 있어야 한다는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 5f5bc136-1f9c-bb39-bf5b-5c4c2a88c324
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:5f5bc136-1f9c-bb39-bf5b-5c4c2a88c324
msgctxt "he8bbcbddg99b0g4b75g98f2g70e4417f2c83"
msgid "Leave it alone, while you still have the chance."
msgstr "알려고 하지 마라. 아직 기회가 있을 때 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 5f849fe7-fa12-99b7-1c10-0ab6be1f2bca
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WYR_DevilishOx_SmallBarn_HasMet_SwA = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:5f849fe7-fa12-99b7-1c10-0ab6be1f2bca
msgctxt "h793949cegd91cg40d1gad42gbf8b8ccebebb"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 626108d1-75c9-5c79-5150-43da0712cf12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_DevilishOx_LastLight_HasMet(1) = True
#.   Global:
#.      - HAV_DevilishOx_LastLight_HasMet_SwA = False
#.   Local:
#.      - b5e75bbb-eec4-741b-b65f-c53dc7bbfbf3_AnimalHandlingSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:626108d1-75c9-5c79-5150-43da0712cf12
msgctxt "h6819aa53g94bbg42c3gbbd5gc726378cffb3"
msgid "*Moo!*"
msgstr "*음메!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 67290665-e224-231b-454c-43c1e7362e8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:67290665-e224-231b-454c-43c1e7362e8f
msgctxt "h2292ef0fg1dbbg49dfgafb1gc97c923d11ba"
msgid ""
"I need to get into the city. But it's hard to shuffle your way to the front "
"of the queue when you're, well, big as an ox."
msgstr "도시로 들어가야 하지만, 음, 황소처럼 몸집이 커서야 들어가는 줄 앞자리로 가기가 힘들지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 68198dff-73a3-0514-3827-0c063d765e85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:68198dff-73a3-0514-3827-0c063d765e85
msgctxt "ha58a6e66gb154g41b5g918ag97532e723cf9"
msgid "Your mind... the unwanted visions... we are much alike."
msgstr "네 정신... 원치 않은 환영... 우린 서로 닮았군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 6d22926c-b0d3-7fe0-b1de-b9a8a6e01983
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:6d22926c-b0d3-7fe0-b1de-b9a8a6e01983
msgctxt "h2265e34bg0dacg40a1g9a8ag250040392f2a"
msgid ""
"After our little interlude at Last Light, I was worried you'd gone quite mad."
msgstr "최후의 빛 여관에서 있었던 우리의 작은 사건 이후로 네가 꽤 화나지는 않았을까 걱정했거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 6ee97364-49ad-3a6f-1652-0454d66fc7fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:6ee97364-49ad-3a6f-1652-0454d66fc7fa
msgctxt "h85af138eg3935g4c03g8a0ag214ccc43452d"
msgid "Fine. I'll help you. Let us leave it at that."
msgstr "좋아, 이쯤 해 두지. 도와주도록 할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 72c99983-4914-963b-877b-362c0ed779d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:72c99983-4914-963b-877b-362c0ed779d1
msgctxt "ha27e5fcagf1fdg4611ga5ffgdff9b9be164a"
msgid "How very kind."
msgstr "이 어찌나 친절한지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 74c0d93f-75f2-cf81-41a1-680b5f85e3db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:74c0d93f-75f2-cf81-41a1-680b5f85e3db
msgctxt "h90d03b6cg33f1g4bc1gb99cg1d459ba4ca17"
msgid "I remain unshown."
msgstr "더 해줄 말은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 77628f4c-9059-3984-997d-d858d0b23f4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:77628f4c-9059-3984-997d-d858d0b23f4d
msgctxt "h38325fafga815g4b04ga32fgda7a6f038bad"
msgid ""
"It may not be today, it may not be tomorrow, but you will lose control "
"eventually."
msgstr "오늘은 괜찮을지도 몰라, 내일도 넘어갈지도 몰라. 하지만 언젠가는 통제력을 상실하고 말거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 79a4c258-6e83-4327-bd28-b73a8c8ffee4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:79a4c258-6e83-4327-bd28-b73a8c8ffee4
msgctxt "hb5b8e545gedd1g4bf6g8410g56a02ef5655f"
msgid "It takes worse than a bit of gore to turn my gullet."
msgstr "피바다 약간으로 날 역겹게 만들긴 부족하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 79d4e735-2407-4a53-2cd5-70610a925cff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#. TagRule: CLERIC_EVIL or PALADIN_EVIL or REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:79d4e735-2407-4a53-2cd5-70610a925cff
msgctxt "h136fcebag785ag43b7g9e6fg85f776221ad0"
msgid "That was wonderful! A little messy, but wonderful."
msgstr "정말 훌륭했어! 좀 지저분하지만, 그래도 훌륭해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 7a761a69-aa19-703d-d71a-6b5140812669
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_DevilishOx_SmallBarn_HasMet_SwA = False
#.   Object:
#.      - HAV_DevilishOx_State_InRegion(0) = True
#. SetFlags:
#.   Global:
#.     - HAV_DevilishOx_LastLight_PeacefulPath = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:7a761a69-aa19-703d-d71a-6b5140812669
msgctxt "h478e1272g11beg4738gbc19g66283d05afe8"
msgid "Good little hero."
msgstr "착한 꼬마 영웅이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 7ed0c4be-3f54-03b8-3a32-3288c79bd611
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:7ed0c4be-3f54-03b8-3a32-3288c79bd611
msgctxt "ha09cd50cgd7e9g4962gb80fg25470adb0492"
msgid "I pity you."
msgstr "안타깝군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 7f55ba68-4815-d8c0-ed69-1f7057d32cd0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_DevilishOx_LastLight_HasMet_SwA = True
#.   Object:
#.      - WYR_DevilishOx_State_InRegion(0) = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Global:
#.     - WYR_DevilishOx_SmallBarn_HasMet_SwA = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:7f55ba68-4815-d8c0-ed69-1f7057d32cd0
msgctxt "h5de00669gd541g4cb4g811bgd67328fa4ee0"
msgid ""
"My, my! The fates move in strange and scrumptious ways. I am <i>delighted </"
"i>to see you again."
msgstr "이런, 이런! 운명이란 이상하고도 감미로운 방향으로 흘러가는군. 널 다시 만나게 되어 <i>매우 기뻐.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 81387b2a-5729-e127-4235-6ec5deae48fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:81387b2a-5729-e127-4235-6ec5deae48fd
msgctxt "hc91e8c09g0ab4g499dgba72g3b14f66f7c6f"
msgid "*MOO!*"
msgstr "*음메!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 8259019c-d2ad-fbeb-49b3-5f94b8849b26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:8259019c-d2ad-fbeb-49b3-5f94b8849b26
msgctxt "h08c22ba0g19f5g4cf1g87acg24c5758bad80"
msgid "Are you satisfied?"
msgstr "만족스럽나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 82c977d7-c95b-02d8-47f6-554c95da3de1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_DevilishOx_SmallBarn_HasMet_SwA = False
#.   Object:
#.      - HAV_DevilishOx_State_InRegion(0) = True
#. SetFlags:
#.   Global:
#.     - HAV_DevilishOx_LastLight_PeacefulPath = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:82c977d7-c95b-02d8-47f6-554c95da3de1
msgctxt "hd926d841gb71cg463cg9cebgbca0e0e96593"
msgid ""
"You believe in your own doom; I believe in the life I can make for myself."
msgstr "너는 네 비운을 믿지만 난 내가 개척할 수 있는 스스로의 삶을 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 840005bd-19e9-3bd7-8aaf-c22510260fc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:840005bd-19e9-3bd7-8aaf-c22510260fc1
msgctxt "h87aebc15gddbdg463fga1b9g507a8e5c61eb"
msgid "Maybe some kind soul might. But not me."
msgstr "그런 친절한 사람이 있을지도 모르지. 하지만 난 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 8540c2f8-1b3f-f801-c31a-7f127042f94e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_DevilishOx_SmallBarn_HasMet_SwA = True
#.      - WYR_DevilishOx_SmallBarn_PeacefulPath = True
#.   Object:
#.      - WYR_DevilishOx_State_InRegion(0) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:8540c2f8-1b3f-f801-c31a-7f127042f94e
msgctxt "h02fcf205g78b3g47b6g82afg0d6c5a097adb"
msgid "You've changed your mind about helping me into the city, haven't you?!"
msgstr "도시로 들어가는 걸 도와주지 않는 쪽으로 마음을 바꾼 거야?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 86cdd469-bc03-3428-2011-b961b57fd8e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:86cdd469-bc03-3428-2011-b961b57fd8e0
msgctxt "h16d8b958g7595g4a91g828fg68ce90e6af6c"
msgid ""
"You're so very welcome. Now - you must have better things to do than hang "
"around in a stable, surely?"
msgstr "천만의 말씀. 그래서, 외양간에서 어슬렁거리는 것보다 다른 할 일이 있겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 8a17298d-357c-06b1-e6dd-7e7fbd3b9da7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DevilishOx_MeetAtDruidsGrove_HasMet_SwA = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:8a17298d-357c-06b1-e6dd-7e7fbd3b9da7
msgctxt "ha0bc7675gffd1g4851g9916gbb79e18e2a7f"
msgid ""
"I remember you from the druid's grove. Are you ready to reveal your secrets "
"yet?"
msgstr "드루이드 숲에서 널 본 기억이 나. 네 비밀을 밝힐 준비는 되었어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 8ce3642f-0a37-e73a-9923-c473c60e7ef0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:8ce3642f-0a37-e73a-9923-c473c60e7ef0
msgctxt "h048b6a11g7d88g424fg8707gd8fb25b7f5ea"
msgid "Well..."
msgstr "그렇다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 8d1a6ac7-e468-62a1-d026-a4478efc603d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:8d1a6ac7-e468-62a1-d026-a4478efc603d
msgctxt "h68749bfeg6b0fg47d7g84e5g3bc6247ff5f5"
msgid "Whatever you are, you're coming out of hiding. <i>Now.</i>"
msgstr "네가 무엇이든 정체를 밝혀. <i>당장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 8d27c472-74d3-7fe8-3aca-2602e252cf1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:8d27c472-74d3-7fe8-3aca-2602e252cf1b
msgctxt "hc334a32aga1c9g4b3dg833fgd98e8e1e410f"
msgid "What are you <i>really?</i>"
msgstr "너 <i>정말로</i> 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 8e2a4dd2-fd15-8398-cee6-17a295759045
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:8e2a4dd2-fd15-8398-cee6-17a295759045
msgctxt "he319bd76gfca7g42c6g94ccg48578916a817"
msgid "Coward. You aren't worth my time."
msgstr "겁쟁이군. 너 따위에게 시간을 낭비할 순 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 8e598869-393c-c2af-2461-f183ea243da2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:8e598869-393c-c2af-2461-f183ea243da2
msgctxt "h9fae2b89g17b9g4f3fga184g0cb81f04956c"
msgid "And while I'm on the topic... I'd like to settle into my new home."
msgstr "말 나온 김에 하는 말인데, 새 집에 정착하고 싶기도 하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 8f15c975-b9d7-4847-4a12-bd4ae8bf5c04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:8f15c975-b9d7-4847-4a12-bd4ae8bf5c04
msgctxt "haff161cbg318eg4d67gb1bcg2705bad0dfba"
msgid "I want to know what you are."
msgstr "네가 무엇인지 알고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 9ab974bb-b2eb-8b47-b28a-c32c96cca0a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:9ab974bb-b2eb-8b47-b28a-c32c96cca0a6
msgctxt "h843ea343gcb4fg468fg8120gb5d841339381"
msgid "Your secret - whatever it is - is safe with me."
msgstr "그 정체가 뭐든, 네 비밀은 안전해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 9b325843-946f-010f-1855-c5a2a4553102
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:9b325843-946f-010f-1855-c5a2a4553102
msgctxt "h20f33954gbd4fg495ega6a9g68d2bdf3e34e"
msgid ""
"<i>I am an ox</i>. All I've got on my mind is grass... stables... and a "
"steady cart to pull."
msgstr "<i>난 황소야</i>. 내가 생각하는 것이라고는 풀... 마구간... 그리고 끌고 다닐 튼튼한 수레라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 9cad9817-5092-e2e7-be55-a962d0bab95e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:9cad9817-5092-e2e7-be55-a962d0bab95e
msgctxt "h0dd3bb8bg78c5g4974ga022gbf034da6864e"
msgid "A kindred spirit. But I only wish to be an ox. Do you understand?"
msgstr "우린 동족이로군. 하지만 난 그저 황소가 되고 싶을 뿐이야, 알겠나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = 9da95b54-482a-4617-a768-e8e4505cd597
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_DevilishOx_LastLight_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - HAV_DevilishOx_LastLight_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:9da95b54-482a-4617-a768-e8e4505cd597
msgctxt "h522f49d8ged5dg44a8g8f5fgc8baca2be745"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = 9eeeef68-e362-c6de-b88f-48873074c720
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:9eeeef68-e362-c6de-b88f-48873074c720
msgctxt "h05f80245g233cg4812ga599g30128b562a39"
msgid "Come close. Your mind to mine."
msgstr "가까이 와 봐. 네 정신을 내게로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = a6637cb7-a3e3-5149-88ad-c481311acfdd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DevilishOx_MeetAtDruidsGrove_Incapable = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:a6637cb7-a3e3-5149-88ad-c481311acfdd
msgctxt "hc8828062g7597g4b76g8f4cgc0384b3fec83"
msgid "You've said that twice now. I demand an explanation."
msgstr "두 번이나 말했잖아. 난 설명을 원해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = a827c260-f611-4348-de1b-c336cd8b20e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:a827c260-f611-4348-de1b-c336cd8b20e7
msgctxt "hd695433fg2e97g4560g9073gec4275b115d9"
msgid "Not for you to know."
msgstr "알 필요 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Narrator
#. NodeID = ac96672b-2f3c-bbcf-db20-5a2d4e9aa001
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CharacterDieAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:ac96672b-2f3c-bbcf-db20-5a2d4e9aa001
msgctxt "hf99bd598gf400g4257ga56eg2dff308b9cd3"
msgid ""
"*It chooses to die docile in animal form. Only after its eyes fade does it "
"become the monster it once was.*"
msgstr "*황소는 동물의 모습으로 얌전히 죽기를 택했죠, 눈에서 생기가 사그라든 후에야 본래의 괴물 모습이 되었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = ae9f014c-37ca-1ee8-1fc8-f199aeaa38b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_DevilishOx_SmallBarn_HasMet_SwA = True
#.   Object:
#.      - WYR_DevilishOx_State_InRegion(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:ae9f014c-37ca-1ee8-1fc8-f199aeaa38b5
msgctxt "h8f0bcd3dg1fafg4874gba64gbae4d45118e2"
msgid ""
"Actually - before we part ways - I wonder if I could appeal to you for a "
"little favour."
msgstr "실은 말이지, 헤어지기 전에 말이야, 작은 부탁을 좀 해도 괜찮을까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = b1561889-2f26-0460-7410-e476a021b935
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:b1561889-2f26-0460-7410-e476a021b935
msgctxt "hbeadcb0eg3568g4272g8316g474dabbc5a8e"
msgid "Then you go your way, and I'll go mine."
msgstr "그럼 넌 네 길을 가, 난 내 길을 갈테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Narrator
#. NodeID = b55f7960-370a-bb2f-ad23-47154d8f58f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:b55f7960-370a-bb2f-ad23-47154d8f58f5
msgctxt "h93360078gebf7g4f1bg93e7g173757a1496c"
msgid ""
"*You deliver the ox a death by a thousand cuts, trying to taunt it into "
"revealing its old form with every slice.*"
msgstr "*당신은 황소를 난도질해 죽입니다, 한번 도려낼 때마다 옛 모습을 드러내게 하여 조롱하려 하면서 말입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = b76871a8-1ec2-7c3a-02ef-3007bc8933e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:b76871a8-1ec2-7c3a-02ef-3007bc8933e3
msgctxt "hcb7f6bd6gb057g4ae1ga1b6g7523eb76530e"
msgid "I <i>want </i>to know what you are."
msgstr "네가 무엇인지 알고 <i>싶어</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = b8178674-2352-ad64-2970-1b41c9a944c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:b8178674-2352-ad64-2970-1b41c9a944c8
msgctxt "h30e3c0ceg7c43g47acg8a9fg474077967f9e"
msgid "My little secret."
msgstr "내 작은 비밀."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = bc5c251c-d82f-47da-42e2-7649873c4d97
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_LastLightOx002_State_AnimalHandlingFailed(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:bc5c251c-d82f-47da-42e2-7649873c4d97
msgctxt "hd0162d5dgdcedg48bfgb26fg4569b615ebc3"
msgid "*HNR!*"
msgstr "*흐엉!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = bd4eafcc-6441-3b22-16f4-3e73c62deb10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:bd4eafcc-6441-3b22-16f4-3e73c62deb10
msgctxt "he7cf6ff2g4812g45e8gaef3g701f1a916e9d"
msgid "I suppose so. What form will you take?"
msgstr "그렇겠군, 어떤 형태를 취할 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = bfeb0f9a-4510-a1bd-c972-8af3985f03a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:bfeb0f9a-4510-a1bd-c972-8af3985f03a9
msgctxt "h1b18453cgb8a9g416bgb2a7g714e8583493a"
msgid "You proved yourself capable of the truth. Now here's another."
msgstr "넌 진실을 알 자격이 있음을 증명했다. 하나 더 알려주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = c066ed66-7a04-2772-f1c0-77dfc7d37bea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:c066ed66-7a04-2772-f1c0-77dfc7d37bea
msgctxt "h1d7cd0c3g1dbbg4c45g9d9fg0f6c49032fc1"
msgid ""
"Charge, charge through the city streets with me, leaving virgin hearts as "
"smear-stains."
msgstr "함께 도시의 거리를 가로질러 돌격하자, 순수한 마음은 얼룩 자국으로 남기고 함께 돌진하자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = c06b6fd7-c5e3-71a3-7bc9-51e6af2c37bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_DevilishOx_SmallBarn_HasMet_SwA = True
#.   Object:
#.      - WYR_DevilishOx_State_InRegion(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:c06b6fd7-c5e3-71a3-7bc9-51e6af2c37bb
msgctxt "hc391ebfegaddbg47c9g8127g6df0a62b77c0"
msgid "Good little hero."
msgstr "착한 꼬마 영웅이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = c0ad97aa-21a4-e673-8026-d377a5bef02b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:c0ad97aa-21a4-e673-8026-d377a5bef02b
msgctxt "h4b990240gd542g4d8dg8c90gcfe0fceeff0c"
msgid "I don't think you want to travel this road, my friend."
msgstr "꼭 이렇게 가고 싶지는 않을 텐데, 친구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = c3e910a7-b0bf-4ac5-7988-2d51a599aa16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_DevilishOx_LastLight_HasMet_SwA = True
#. SetFlags:
#.   Global:
#.     - HAV_DevilishOx_LastLight_HasMet_SwA = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:c3e910a7-b0bf-4ac5-7988-2d51a599aa16
msgctxt "h2a35b7b2g0cb0g49a5gb57ag82328b50b509"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = c53bcef6-ffa0-4d89-ecc7-299ed4c2e62c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:c53bcef6-ffa0-4d89-ecc7-299ed4c2e62c
msgctxt "h1f455fd6ga4c3g49cbgb802gd76365aba0b9"
msgid "<i>Sneer at the disgusting beast.</i>"
msgstr "<i>흉측한 짐승을 보며 조롱하듯 웃는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = c78c717e-710a-91dc-8956-3e461364c89b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:c78c717e-710a-91dc-8956-3e461364c89b
msgctxt "h3bd3aaddgc57fg4403ga9b9g6f1bc92898ea"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = cabee461-ac91-977a-a2af-964388ceab6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:cabee461-ac91-977a-a2af-964388ceab6d
msgctxt "he835ccffg6ed7g4b80g944cgfaf63e8cb3d8"
msgid ""
"I'd quite like to get inside. But it's difficult to shuffle your way to the "
"top of the queue when you're, well, as big as an ox."
msgstr "도시 안으로 들어가고 싶지만, 음, 황소처럼 몸집이 커서야 들어가는 줄 앞자리로 가기가 어렵지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = cdc99d20-fdb0-a131-662b-43ed733b4e29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_DevilishOx_SmallBarn_HasMet_SwA = False
#.   Object:
#.      - HAV_DevilishOx_State_InRegion(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:cdc99d20-fdb0-a131-662b-43ed733b4e29
msgctxt "h9b57a48fg1742g452fga230gd49ee615f5d3"
msgid "I'm so glad you understand."
msgstr "알아줘서 기쁘군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = cde38286-089e-b35f-ba13-e5342e09ac6d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_LastLightOx002_GaveReward(1) = True
#.   Global:
#.     - HAV_DevilishOx_LastLight_PeacefulPath = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:cde38286-089e-b35f-ba13-e5342e09ac6d
msgctxt "h09eb1f71gda4fg446eg9a60gcbb84f9d87b9"
msgid "Here. A little token between friends - for your discretion."
msgstr "여기. 비밀을 지켜준 친구에게 주는 작은 선물이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = d0a3ccb7-82c7-134d-5f67-d21c5a0a3e79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:d0a3ccb7-82c7-134d-5f67-d21c5a0a3e79
msgctxt "he9d06996g83ffg4285g8c60g485cd720aba0"
msgid "Not really."
msgstr "딱히 그렇진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = d2e8b308-97bd-c56d-f7db-9844b99c02ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:d2e8b308-97bd-c56d-f7db-9844b99c02ca
msgctxt "hc26c6026g1f67g4db4g82d2gffbe9da401f8"
msgid "I assure you, you do not."
msgstr "장담하지, 그러고 싶지 않을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = d3a37a5e-6413-7558-039a-1237d2f99cd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(1) = True
#.     - ORI_DarkUrge_Event_IndulgedUrge(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:d3a37a5e-6413-7558-039a-1237d2f99cd5
msgctxt "h85203c90gd4bbg4209g9f71g6e396701b362"
msgid "<i>Acquaint the cow with the depths of your depravity.</i>"
msgstr "<i>황소에게 당신의 타락이 얼마나 깊은지 알려준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = d5674660-b7d9-b048-32b4-d96b036e4221
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:d5674660-b7d9-b048-32b4-d96b036e4221
msgctxt "h58f6dbd5gce35g4515g9475g71fa018e00f6"
msgid "Is that a threat?"
msgstr "그거 위협이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = d645a752-7b28-4eb8-07d5-297ef95d6c1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:d645a752-7b28-4eb8-07d5-297ef95d6c1a
msgctxt "h7bbc8478gfa3dg4041gb540gaddbcc68317b"
msgid "*Hnr!*"
msgstr "*크-흠!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = da9b4849-7394-0cc2-e343-c1fec2cc47ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:da9b4849-7394-0cc2-e343-c1fec2cc47ba
msgctxt "hc7cd7b1bg246dg4f23ga4cfgcfc061cf7936"
msgid "I'll trade you your secret for one of mine."
msgstr "네 비밀을 알려주면 내 비밀도 하나 알려줄 게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = dcd4c904-83b9-d923-4ef1-21be90fd9d96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_DevilishOx_LastLight_HasMet_SwA = False
#.      - DEN_DevilishOx_MeetAtDruidsGrove_HasMet_SwA = True
#.      - DEN_DevilishOx_MeetAtDruidsGrove_Incapable = True
#.   Object:
#.      - HAV_DevilishOx_State_InRegion(0) = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_DevilishOx_LastLight_HasMet_SwA = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:dcd4c904-83b9-d923-4ef1-21be90fd9d96
msgctxt "h03c774ceg9d8cg4f15gbdb0g50e6bb40374b"
msgid "Hm. No. Still incapable."
msgstr "안돼. 아직도 자격이 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = dfe2544a-94d2-9794-b15a-d35573e448f3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WYR_DevilishOx_SmallBarn_PeacefulPath = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:dfe2544a-94d2-9794-b15a-d35573e448f3
msgctxt "hc646387egaeceg46a1ga0d1g4a1874674745"
msgid ""
"Pity. I would have looked upon you with mercy, if the time for such things "
"ever came to pass."
msgstr "애석하군. 만약 네가 부탁을 들어줬다면, 자비롭게 대해줬을 텐데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = e0cf83ae-6314-6b75-d0b8-9097a82c74f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:e0cf83ae-6314-6b75-d0b8-9097a82c74f1
msgctxt "h7f041b67gbf35g4dd6g9a24gbbcb554082c4"
msgid ""
"I assure you I do. Tell me what you <i>really </i>are, or I'll strike you "
"down myself."
msgstr "장담하는데, 네가 <i>진짜</i> 뭔지 밝히지 않는다면 널 내 손으로 죽여버리겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = e3da5913-1edd-fa43-5002-89369225ac95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_DevilishOx_SmallBarn_HasMet_SwA = True
#.   Object:
#.      - WYR_DevilishOx_State_InRegion(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:e3da5913-1edd-fa43-5002-89369225ac95
msgctxt "h0e1349d6g7313g4a90g8f75g0ac60c2dc60d"
msgid ""
"You believe in your own doom; I believe in the life I can make for myself."
msgstr "너는 네 비운을 믿지만 난 내가 개척할 수 있는 스스로의 삶을 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = e47444f1-5c44-8a68-5f48-70cc9b7854fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:e47444f1-5c44-8a68-5f48-70cc9b7854fd
msgctxt "h57fb70ddg7e4ag4d27g8cacgace8c9fd3536"
msgid "Did it? I'm not so sure. I'm not in the city yet, you see."
msgstr "그런가? 난 잘 모르겠군, 보다시피 아직 도시에 들어간 건 아니거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Narrator
#. NodeID = e704ba8b-d6d3-c508-4ca1-4b07d5b5280e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b5e75bbb-eec4-741b-b65f-c53dc7bbfbf3_AnimalHandlingSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:e704ba8b-d6d3-c508-4ca1-4b07d5b5280e
msgctxt "hdf3c6d63g9efeg42f3g8d7cgadb73f603178"
msgid "*There's an invitation behind its great, brown eyes.*"
msgstr "*이 황소의 커다란 갈색 눈 뒤로는 뭔가 초대라고 할 만한 게 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = e87d9f6a-b9ad-84b8-3eae-75be437fcdc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:e87d9f6a-b9ad-84b8-3eae-75be437fcdc6
msgctxt "h918c79fdg0b41g4869ga4d4g13d588a56313"
msgid "What the hells was that?"
msgstr "방금 그건 도대체 뭐였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = e88de6a6-68b9-14aa-6aaa-89887fa58018
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:e88de6a6-68b9-14aa-6aaa-89887fa58018
msgctxt "he0893b17gfc68g4a4cga328g1cae10de36fe"
msgid "I don't care what you might be behind it all; you're an ox to me."
msgstr "네 정체가 뭔지에 대해 관심없어. 나에겐 그냥 소일 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = ea2b126a-7e74-2909-f8e1-49737d8f1548
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_DevilishOx_FailedCheck = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:ea2b126a-7e74-2909-f8e1-49737d8f1548
msgctxt "hafd81702gde3dg4668g82adgc012a4b11bd1"
msgid "I <i>said </i>incapable."
msgstr "자격이 없다고 <i>말했다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = ebd79770-69c2-df69-77c6-84432c4869a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:ebd79770-69c2-df69-77c6-84432c4869a7
msgctxt "h5779e046ge5d7g4825g8ff1gae518859ad81"
msgid ""
"Though... perhaps your better nature would extend a little further, for "
"little old me."
msgstr "그렇지만... 어쩌면 그런 선한 본성이 나 같은 늙은이에게 뻗칠 수도 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = eddd637a-0de5-1965-f830-9831f11ca37a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:eddd637a-0de5-1965-f830-9831f11ca37a
msgctxt "ha4bdb1e0ga27dg463dgbdb5g1d9cbaa46de8"
msgid ""
"Those are the least bovine thoughts I've ever seen. What are you "
"<i>really?</i>"
msgstr "내가 본 것 중에 가장 소답지 않은 생각들인데. 네 <i>진짜</i> 정체가 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = ede2f2d7-0563-38cd-8fd5-2e8f6bfaddd3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_DevilishOx_LastLight_HasMet_SwA = False
#.      - DEN_DevilishOx_MeetAtDruidsGrove_HasMet_SwA = True
#.      - DEN_DevilishOx_MeetAtDruidsGrove_Incapable = False
#.   Object:
#.      - HAV_DevilishOx_State_InRegion(0) = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_DevilishOx_LastLight_HasMet_SwA = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:ede2f2d7-0563-38cd-8fd5-2e8f6bfaddd3
msgctxt "h35b4c8f6gda28g4dacg923eg90c1609fd1ad"
msgid "Hm. No. Incapable."
msgstr "흐음. 안돼. 자격이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = f1c18b47-6458-a9e1-c1b7-9afb6e2c9909
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:f1c18b47-6458-a9e1-c1b7-9afb6e2c9909
msgctxt "h9551e67dg8bdeg40aag84eegc0ed7feaf0bf"
msgid "Yes. Thank you."
msgstr "그래. 고맙군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = f2645d03-f406-f203-fe59-a84147718ff8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:f2645d03-f406-f203-fe59-a84147718ff8
msgctxt "h2d9f3de8g14e1g4ca0ga216gfe425ceae6b0"
msgid "Ah c'mon, now you've piqued my curiosity..."
msgstr "제발 좀. 계속 호기심을 자극하네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = f63a67b3-9d00-f12a-2088-daa276f7b72e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WYR_DevilishOx_SmallBarn_HasMet_SwA = True
#. SetFlags:
#.   Global:
#.     - WYR_DevilishOx_SmallBarn_HasMet_SwA = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:f63a67b3-9d00-f12a-2088-daa276f7b72e
msgctxt "hf6f4c7d5ga3f2g477bgba5eg7c391d45df7e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = f697046d-b897-5f6e-9922-699e522fc5c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:f697046d-b897-5f6e-9922-699e522fc5c3
msgctxt "h71e61556gdc25g4984ga4fdgeb82025c7c29"
msgid "Pathetic! Do not conceal your exalted brutality!"
msgstr "한심하군! 너의 숭고한 잔혹성을 숨기지 마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = fd637f0a-3d16-dc78-79af-a6843232ea8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:fd637f0a-3d16-dc78-79af-a6843232ea8d
msgctxt "h800328e5gbb4dg46a5gac04gc5f90ccfe19d"
msgid "That's up to you."
msgstr "그건 너에게 달려있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Phasm
#. NodeID = fdd87557-0e2f-33bc-d867-23208da5f152
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WYR_DevilishOx_Event_PlayerAgreesToHelpOx = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:fdd87557-0e2f-33bc-d867-23208da5f152
msgctxt "h6432495fgbe83g4fe5g88d7g268e017b5abd"
msgid "Hail Cyric, I can't <i>wait </i>to get inside."
msgstr "시어릭 만세, 도시로 들어가는걸 <i>못 참겠군</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002
#. Speaker = Player
#. NodeID = fed8393e-3584-c7ca-df5d-2336995f1c3e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx002:fed8393e-3584-c7ca-df5d-2336995f1c3e
msgctxt "h23387fceg2efcg46e7g8f7dgaeb9bd18e01b"
msgid ""
"You're a rare breed. An authentic Red-Backed River Ox. I thought you'd be "
"more discerning..."
msgstr "넌 정통 붉은등 강 황소잖아, 희귀 품종이라고. 좀 더 분별력이 있을 거라 여겼는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Alone
#. Speaker = Bex
#. NodeID = 81ecdbb0-a7f8-4cc9-ad21-21ee493bffbd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 737176de-0d4d-9901-733d-0050384a66ec_A = True
#. SetFlags:
#.   Local:
#.     - 737176de-0d4d-9901-733d-0050384a66ec_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Alone:81ecdbb0-a7f8-4cc9-ad21-21ee493bffbd
msgctxt "h31dd7093g6fb3g46dagaa48gcc60627793dc"
msgid "*Sob.*"
msgstr "*흐느낌.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Alone
#. Speaker = Bex
#. NodeID = 9d6119a5-e367-40e4-998b-218432f27ce2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 737176de-0d4d-9901-733d-0050384a66ec_B = True
#. SetFlags:
#.   Local:
#.     - 737176de-0d4d-9901-733d-0050384a66ec_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Alone:9d6119a5-e367-40e4-998b-218432f27ce2
msgctxt "h86a30cb6g3183g4476gae29ged17a99875dd"
msgid "I can't, I <i>can't</i>..."
msgstr "안 돼, <i>안 된다고</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Alone
#. Speaker = Bex
#. NodeID = c714e818-9795-4955-8b9b-20e791176bd7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 737176de-0d4d-9901-733d-0050384a66ec_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Alone:c714e818-9795-4955-8b9b-20e791176bd7
msgctxt "h8cddfdfdge918g4cf3gabb8gfa48982afcc1"
msgid "What am I going to do?"
msgstr "이제 난 어떡해야 해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Alone
#. Speaker = Bex
#. NodeID = e1597e27-c764-4220-8617-9fceb129daa8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 737176de-0d4d-9901-733d-0050384a66ec_C = True
#. SetFlags:
#.   Local:
#.     - 737176de-0d4d-9901-733d-0050384a66ec_C = False
#.     - 737176de-0d4d-9901-733d-0050384a66ec_B = False
#.     - 737176de-0d4d-9901-733d-0050384a66ec_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Alone:e1597e27-c764-4220-8617-9fceb129daa8
msgctxt "h09f2ae51g1988g4765g829eg081ba79a9c7a"
msgid "Danis..."
msgstr "다니스..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Bex
#. NodeID = 0c45c006-4b92-4dcb-9fcb-fb94dfb2572e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_PromenadeAtFountain = True
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_State_PromenadeAtFountain = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:0c45c006-4b92-4dcb-9fcb-fb94dfb2572e
msgctxt "h5548dff3g61cbg4881g8b32g5adf150367c2"
msgid "This place isn't much, but it's home now I'm here with you."
msgstr "여긴 별 것 아닌 곳이지만, 너와 함께 있으니 집이나 다름없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Danis
#. NodeID = 0ea7a337-5603-4b50-acf6-30b0ef80c642
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_PromenadeOnBridge = True
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_State_PromenadeOnBridge = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:0ea7a337-5603-4b50-acf6-30b0ef80c642
msgctxt "h1ceb924fg89fdg40d6g8220gf9af1230d93e"
msgid ""
"Don't worry - we'll just sail all the way down the Chionthar to Baldur's "
"Gate!"
msgstr "걱정 마. 그냥 치온타르 강을 타고 발더스 게이트까지 가면 되니까!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Danis
#. NodeID = 1dd7fbec-17ba-4892-a063-28f850184cd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:1dd7fbec-17ba-4892-a063-28f850184cd9
msgctxt "hbc7d68a0g2f9fg4e7fg9658g3349c23d1a8f"
msgid "It must have been quite a view before the curse."
msgstr "꽤 멋진 경치였을 거야. 저주 받기 전엔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Bex
#. NodeID = 3aa53922-e7f5-4132-a7de-8d507a48109e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:3aa53922-e7f5-4132-a7de-8d507a48109e
msgctxt "hc3c345f8gd03ag4c53gbd64g7c547de454f2"
msgid "You fool."
msgstr "이 바보야.."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Bex
#. NodeID = 4c903b02-bb62-41fc-8688-602af9b95e70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:4c903b02-bb62-41fc-8688-602af9b95e70
msgctxt "hb126e893g6b89g4736g980fg4d141062ffc3"
msgid "You <i>do </i>still need that bath, though..."
msgstr "그래도 그 욕조는 <i>정말</i> 필요해 보이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Bex
#. NodeID = 61325d1c-1451-4166-a8d1-fe867cc949ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:61325d1c-1451-4166-a8d1-fe867cc949ff
msgctxt "hc27b9ce4g1ff0g4c30g9c12gdf1cdde12041"
msgid "I hope we get there. <i>Together</i>."
msgstr "그럴 수 있으면 좋겠네. <i>함께</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Bex
#. NodeID = 829490bd-7caf-4eb1-82d8-3731026df105
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:829490bd-7caf-4eb1-82d8-3731026df105
msgctxt "hdee7182fg32bdg49b5ga72egce1c50c4ad33"
msgid "I missed you so much."
msgstr "정말 보고 싶었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Bex
#. NodeID = 86abe450-3dcb-4f1b-accd-f0599918f65b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_PromenadeSideInn = True
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_State_PromenadeSideInn = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:86abe450-3dcb-4f1b-accd-f0599918f65b
msgctxt "h0a454c1cg1cf9g4420g8c21g9c9362010b81"
msgid "It's so <i>dark</i> out there."
msgstr "저 밖은 너무 <i>어두워</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Bex
#. NodeID = 988705c9-0003-3acd-2008-071929e105f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:988705c9-0003-3acd-2008-071929e105f2
msgctxt "ha8ecce0ag88c5g416eg857agf2a15eae445f"
msgid "They all seemed to be coping so much better than I was."
msgstr "모두 나보다 훨씬 잘 극복하고 있는 것 같아서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Danis
#. NodeID = afc36d9b-dabc-427a-bdf1-0bebdd8f1d4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_PromenadeSidePath = True
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_State_PromenadeSidePath = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:afc36d9b-dabc-427a-bdf1-0bebdd8f1d4d
msgctxt "h01553095g79fdg4612gad5eg2d56df266774"
msgid "Fancy a swim?"
msgstr "수영할래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Bex
#. NodeID = b6f366ad-0684-414b-911c-59f9bdcb2da8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:b6f366ad-0684-414b-911c-59f9bdcb2da8
msgctxt "haaf3a0b3g01b8g4058g816bgf51ca3206516"
msgid "Well, at least there are still flowers here!"
msgstr "뭐, 그래도 여긴 아직 꽃이 있네!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Danis
#. NodeID = d98c0d88-6608-4a27-9d10-a0baa6565eb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:d98c0d88-6608-4a27-9d10-a0baa6565eb6
msgctxt "hadcd71f2g1e2cg4cc0g895cgc472505beb00"
msgid "Please don't start crying again - then <i>I'll </i>cry."
msgstr "제발 더는 울지 마, <i>나까지</i> 눈물 나잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Bex
#. NodeID = e295d915-365e-36b7-5173-0aaee61b41a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:e295d915-365e-36b7-5173-0aaee61b41a6
msgctxt "h725c4f3bg9678g4b28g913cg1c6719f73281"
msgid "I couldn't bear to be around the others."
msgstr "다른 사람들과 있는 게 견디기 힘들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Bex
#. NodeID = ecb026ea-db9f-43ab-aa1a-53709e012fa6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:ecb026ea-db9f-43ab-aa1a-53709e012fa6
msgctxt "h3c93d895ge2c2g46c6gaa8agd89157c1e9eb"
msgid "You must be joking!"
msgstr "농담이겠지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade
#. Speaker = Danis
#. NodeID = fff03b15-fcfe-edc4-a8b6-4827418f2e7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_PromenadeUnderBridge = True
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_State_PromenadeUnderBridge = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Promenade:fff03b15-fcfe-edc4-a8b6-4827418f2e7d
msgctxt "h50a14eaeg32b7g4375gab0cg615af2ee6d21"
msgid "Spend a long time moping down here, did you?"
msgstr "여기서 한참을 우울하게 넋 놓고 있었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Danis
#. NodeID = 1c6c6e3f-3179-4f69-9ed4-976c79cb1953
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 88c2a54f-df16-19d8-1f97-2c67947bdf74_A = True
#. SetFlags:
#.   Local:
#.     - 88c2a54f-df16-19d8-1f97-2c67947bdf74_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:1c6c6e3f-3179-4f69-9ed4-976c79cb1953
msgctxt "hefa751d2gc00ag41d7g8facgc01508a6c0f4"
msgid "I can't believe it. To see you again with my own eyes. To hold you..."
msgstr "믿을 수가 없어. 두 눈으로 다시 널 보게 된다니. 널 안을 수 있다니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Danis
#. NodeID = 34d3e064-9d84-490f-b116-c94d34b3d59f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 88c2a54f-df16-19d8-1f97-2c67947bdf74_B = True
#. SetFlags:
#.   Local:
#.     - 88c2a54f-df16-19d8-1f97-2c67947bdf74_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:34d3e064-9d84-490f-b116-c94d34b3d59f
msgctxt "hea52fe96gdb45g4706g9001g8092aed4c16a"
msgid "I need a hug."
msgstr "안아야겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Bex
#. NodeID = 56cf7748-4e9d-4e3c-8427-5d603aa281ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:56cf7748-4e9d-4e3c-8427-5d603aa281ee
msgctxt "h4041b2deg02b1g49fagbb47gba96b5dd3c09"
msgid "My gods, Danis!"
msgstr "세상에, 다니스!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Bex
#. NodeID = 58f5cbe8-c5c2-4114-ae99-b3ceba9b9e0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:58f5cbe8-c5c2-4114-ae99-b3ceba9b9e0d
msgctxt "h6b5dc6c8g89c2g4fa6gbce7g0dfaad029d9f"
msgid "Perhaps we should dunk you in the Chionthar..."
msgstr "아무래도 치온타르 강에 풍덩 담가줘야겠는걸..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Bex
#. NodeID = 5f6a8e88-6ed1-4585-b466-ea5b8623b196
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:5f6a8e88-6ed1-4585-b466-ea5b8623b196
msgctxt "hd554d676g97d8g42feg8d22g037d67e13dff"
msgid "Don't you ever get yourself captured again!"
msgstr "또 붙잡혀 가기만 해봐!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Bex
#. NodeID = 634e0dc0-411e-42a5-ae80-bfb33b7f974d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:634e0dc0-411e-42a5-ae80-bfb33b7f974d
msgctxt "ha5d578f5g91f2g410dg9c34g1c8992de69ee"
msgid "Don't cry..."
msgstr "울지 마..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Danis
#. NodeID = 76baa130-13a2-429c-8172-9ee27a8acdb2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 88c2a54f-df16-19d8-1f97-2c67947bdf74_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:76baa130-13a2-429c-8172-9ee27a8acdb2
msgctxt "h2f5fe839gbaf1g4d58gb641gaa843e94a1ec"
msgid "Bex!"
msgstr "벡스!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Bex
#. NodeID = be0f52e9-a2e1-4e72-a97f-c72f7b0dc24d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 88c2a54f-df16-19d8-1f97-2c67947bdf74_C = True
#. SetFlags:
#.   Local:
#.     - 88c2a54f-df16-19d8-1f97-2c67947bdf74_C = False
#.     - 88c2a54f-df16-19d8-1f97-2c67947bdf74_B = False
#.     - 88c2a54f-df16-19d8-1f97-2c67947bdf74_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:be0f52e9-a2e1-4e72-a97f-c72f7b0dc24d
msgctxt "h218baab1gf64ag489fgaca6g6259517f8358"
msgid ""
"I missed you so much! When I heard the screams, I thought... I thought..."
msgstr "너무 보고 싶었어! 비명을 들었을 때, 난 네가... 네가..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Bex
#. NodeID = c03beef2-dc66-d0db-9f3f-cfa8a0f02fcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:c03beef2-dc66-d0db-9f3f-cfa8a0f02fcc
msgctxt "hf4ba172dgfe97g4069g9fdeg838ac1e9deef"
msgid "No, you need a bath!"
msgstr "아니, 목욕해야겠지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Danis
#. NodeID = d965b86d-32e2-4758-9871-322ac6d515b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:d965b86d-32e2-4758-9871-322ac6d515b1
msgctxt "ha8f29b5ega5e4g4735g823dg0d9d4c32be7c"
msgid "You're all right!"
msgstr "무사했구나!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Danis
#. NodeID = db1ea483-13f2-4bc5-87b7-7418960e809f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:db1ea483-13f2-4bc5-87b7-7418960e809f
msgctxt "h1b421b08g893cg445dgb25bgde23eb5e11f6"
msgid "You're already crying!"
msgstr "넌 벌써 울고 있잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited
#. Speaker = Danis
#. NodeID = f6303de4-e9ed-48f9-baf1-e621a64b545e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_Reunited:f6303de4-e9ed-48f9-baf1-e621a64b545e
msgctxt "h85acf74fge6ebg4721g9ceegc2a9da02c6a0"
msgid ""
"I thought the worst, too - but now we're together again none of that matters."
msgstr "나도 최악의 상황을 생각했었어. 하지만 우리가 다시 만났으니까 그런 건 아무래도 상관없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_StartLoverPromenade
#. Speaker = Danis
#. NodeID = c5caa881-7eae-d7ae-3b1b-29d78419b334
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_StartLoverPromenade:c5caa881-7eae-d7ae-3b1b-29d78419b334
msgctxt "h3588b2f6g29bdg4499g9355g686457b9f889"
msgid "Anywhere, my love - I go where you go."
msgstr "어디든, 내 사랑. 네가 가는 곳이라면 어디든 갈게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_StartLoverPromenade
#. Speaker = Bex
#. NodeID = c5f70595-4d7c-4793-8bd1-1cafda3b5356
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_AD_StartLoverPromenade:c5f70595-4d7c-4793-8bd1-1cafda3b5356
msgctxt "ha2d71d64g5176g4542gb575g174e3799b836"
msgid "So... shall we go for a walk?"
msgstr "그럼... 좀 걸을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 062c3e87-085b-3c6e-6d39-3b0aee57d8bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_AllPrisonersDied = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:062c3e87-085b-3c6e-6d39-3b0aee57d8bb
msgctxt "h42e5100bga64dg4e56g993cgbf8559ef024b"
msgid "Danis still hasn't come back. None of them have."
msgstr "다니스가 아직 돌아오지 않았어. 아무도 돌아오지 않았다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 0cc429d5-38cd-d91b-7e4b-912fecc1bc6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:0cc429d5-38cd-d91b-7e4b-912fecc1bc6c
msgctxt "h149798abgca4eg4e2egba49g37462fa4fe52"
msgid ""
"I know. And I know it was only thanks to you that we made it out of the "
"Grove in the first place."
msgstr "나도 알아. 애초에 우리가 숲에서 살아 나온 것도 전부 네 덕분이었다는 것도 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 0e332b1e-cc9e-0e29-1e8d-c77d825d3115
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:0e332b1e-cc9e-0e29-1e8d-c77d825d3115
msgctxt "h79a48900ge14bg44begb329g24d107f55d82"
msgid "I managed to get away, but my love Danis... <i>Mar zindur vroshan.</i>"
msgstr "난 어떻게든 도망쳤지만, 내 사랑 다니스는... <i>마르 진두르 브로샨.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 133b0dd9-238a-e246-8a86-ea1ab945c4c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:133b0dd9-238a-e246-8a86-ea1ab945c4c5
msgctxt "h19fa0203g691dg4639g9011gfa4674c2e09d"
msgid "Gone."
msgstr "죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 14e27445-fb55-856e-3df9-ca1895459b3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:14e27445-fb55-856e-3df9-ca1895459b3f
msgctxt "h747006c0g0b45g4cfegae60g0a75ef8dd12f"
msgid "Sounds like your boy toy's goblin chow."
msgstr "네 남자 친구는 고블린 밥이 됐겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 176d0e42-6d61-ac42-f9bd-67462e03e735
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_LoneLover_HasMet_DanisDied(1) = True
#.   Global:
#.     - HAV_SavingPrisoners_State_ReturnCompleted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:176d0e42-6d61-ac42-f9bd-67462e03e735
msgctxt "h12c94df0g2febg470fgb85ag003a7e14ae73"
msgid "I tried my best, but nobody else made it - I'm sorry."
msgstr "최선을 다했지만, 다른 생존자는 없어. 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 1aba1998-7b52-6244-12fc-e7d2bd193d5b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_LoneLover_HasMet_DanisDied(1) = True
#.   Global:
#.     - HAV_SavingPrisoners_State_ReturnCompleted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:1aba1998-7b52-6244-12fc-e7d2bd193d5b
msgctxt "h03b7891dge525g4dcdg9200g6240cc96dfad"
msgid "They're all dead."
msgstr "그들은 전부 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 252ad630-7be4-0767-aa22-a301feb22e1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:252ad630-7be4-0767-aa22-a301feb22e1f
msgctxt "h195b9f0fg608dg43f6g8d93gaea0abb4368d"
msgid ""
"It's hard to imagine him making it after everything that happened, but if "
"you find him..."
msgstr "그가 그 모든 것으로부터 살아남았을 거라 상상하기 힘들지만, 네가 그를 찾아낸다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 2f3a58a1-45cb-7b14-5473-db06e575da30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:2f3a58a1-45cb-7b14-5473-db06e575da30
msgctxt "ha4526710g799bg4a9cg85fegc153c84da290"
msgid ""
"From what I've heard, they've probably killed and eaten him. In that order, "
"if he's lucky."
msgstr "내가 들은 바에 의하면 그들은 이미 그를 죽여서 먹어버렸을 거고, 그 순서대로라면 운이 좋은 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 30677afb-4ae9-7267-dff8-8113f49b071c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_DanisDiedBeforeHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:30677afb-4ae9-7267-dff8-8113f49b071c
msgctxt "hc416ac8cg9c5fg41b0g9412g6533927fa488"
msgid "I'm sorry, Danis."
msgstr "미안해, 다니스."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 32fabbdb-920f-cb0b-cbaa-0d3fadbc2834
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:32fabbdb-920f-cb0b-cbaa-0d3fadbc2834
msgctxt "h65988ef8g746bg4898g8e53g2c592d762344"
msgid "I'm sorry - we got out as many as we could."
msgstr "미안해. 최대한 많이 구하려고 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 335b7675-0db0-a4f2-e3d1-e8bdf1597268
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:335b7675-0db0-a4f2-e3d1-e8bdf1597268
msgctxt "h4132baacga257g46c0g98bfgc3dc5b61a539"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 341a0fb9-fc84-6263-32f6-a9e89b920c52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ba6b8bdd-f714-8826-5a2e-d586aa069a86_Mentionedmoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:341a0fb9-fc84-6263-32f6-a9e89b920c52
msgctxt "hebdf20cag2b6dg4fbag88d5g9978dc84072d"
msgid ""
"He <i>is</i> still locked in a cultist's tower - he might be better off dead."
msgstr "그가 아직 추종자들의 타워에 갇혀 <i>있다면</i> 차라리 죽는 편이 나을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 3487fc9b-80b9-92e0-ba2e-ad0e19631884
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:3487fc9b-80b9-92e0-ba2e-ad0e19631884
msgctxt "hbe9e3c03g6b6ag4fdag91d9ga9a5832bb49b"
msgid "You think he's dead?"
msgstr "그가 죽었다고 생각해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 35b174e5-32e0-c153-bf90-861aa209ceef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:35b174e5-32e0-c153-bf90-861aa209ceef
msgctxt "hbe86dd84g209fg4adbgbf56g91bb49ec065a"
msgid "The Towers are a terrible place. We're lucky anyone made it out alive."
msgstr "문라이즈 타워는 끔찍한 곳이야. 누구라도 살아나온 게 다행이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 360762ef-47cd-14bd-5c6c-b7ad8e180662
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_YoungLovers_State_MetPlayer = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:360762ef-47cd-14bd-5c6c-b7ad8e180662
msgctxt "h6b4a5571g1e3fg49d6g878egf447dce13401"
msgid "I remember you - Bex, right? Where's your man?"
msgstr "너 기억나. 벡스, 맞지? 네 남자는 어디 갔어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 3cca635e-9cae-4cd0-196b-f32db10cb5bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:3cca635e-9cae-4cd0-196b-f32db10cb5bb
msgctxt "h5a25e201g6e3ag420ag9b21g468281e5c2a8"
msgid "Why are you crying?"
msgstr "왜 울고 있는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 3f88c8ba-3baa-7247-3bd9-c550dc0f1b34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_ReturnCompleted = True
#.      - HAV_SavingPrisoners_State_LoverReturned = False
#. SetFlags:
#.   Dialog:
#.     - HAV_LoneLover_HasMet_DanisDied(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:3f88c8ba-3baa-7247-3bd9-c550dc0f1b34
msgctxt "h14ab9a67g8344g4a5egacc0g9acf3344c264"
msgid "Danis didn't make it back, did he?"
msgstr "다니스는 돌아오지 못 했구나, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 44ba6e2a-75af-2e68-3bbb-8405eadeb370
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:44ba6e2a-75af-2e68-3bbb-8405eadeb370
msgctxt "h8756a5e7g09ecg40d4g8bc3gc9f9d9b6b2e8"
msgid "We were going to open a teahouse together in Baldur's Gate."
msgstr "우린 발더스 게이트에서 함께 찻집을 차릴 예정이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 4e440802-f815-81ad-ebb8-17798a5e4d99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:4e440802-f815-81ad-ebb8-17798a5e4d99
msgctxt "h50bf88c3g2346g4ee8gb458ge37386a5ed76"
msgid "I just wish I could have said goodbye."
msgstr "단지 작별 인사를 할 수만 있었다면 싶을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 50e47b3f-1187-77ac-3fe7-77eac8d7943d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:50e47b3f-1187-77ac-3fe7-77eac8d7943d
msgctxt "habcea70dg2ecbg4c11gad0eg06a6f881a56d"
msgid "How couldn't he be?"
msgstr "무슨 수로 살아있겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 53e9e6cf-1c23-85fd-9d87-8c9be0b34415
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:53e9e6cf-1c23-85fd-9d87-8c9be0b34415
msgctxt "h5d448151gfd05g4a06gb1f3g33683ab16dcc"
msgid ""
"So what you're saying is you saved yourself and left your soulmate to die?"
msgstr "그러니까, 너 하나 살겠다고 네 소울메이트를 죽게 놔두고 왔다는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 5599c493-a864-dc5c-d37d-3cbe74b77dd7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_Event_PromisedRescue = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:5599c493-a864-dc5c-d37d-3cbe74b77dd7
msgctxt "he59a52c0gfa64g466fg918bg19ed1a1c5e74"
msgid "I'll find Danis and bring him back to you."
msgstr "다니스를 찾아서 네게 돌려줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 5629b457-19e7-c59e-7545-b664076e5f8b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_LoneLover_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:5629b457-19e7-c59e-7545-b664076e5f8b
msgctxt "h309bd06age00bg4e53g86acg7d5da19a0220"
msgid "Please, I just want to be alone."
msgstr "제발요, 혼자 있고 싶어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 5bf0c2e7-7abb-668f-2277-b99d2ed26a16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:5bf0c2e7-7abb-668f-2277-b99d2ed26a16
msgctxt "hf677064cg36ddg4e77g97d5gd9413852754e"
msgid "Don't shout at me!"
msgstr "나한테 소리 지르지 마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 5ddf64d8-8d8b-3b50-273a-61e15e070974
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LoneLover_Bex_NightsongFreedHasMet(1) = True
#.      - HAV_LoneLover_HasMet(1) = True
#.   Global:
#.      - IMPOSSIBLE = True
#.      - COL_KethericShowdown_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:5ddf64d8-8d8b-3b50-273a-61e15e070974
msgctxt "h27630f9eg6360g4168g80b5g8ea25441bab8"
msgid ""
"Stay alive a little longer, and we may all find ourselves en route to the "
"city. Would you believe it?"
msgstr "이제 조금만 더 버티면 모두가 도시로 들어갈 길이 열린다니. 믿기 어렵지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 644ad1ce-2f15-9bc1-9a3f-d579c645576e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:644ad1ce-2f15-9bc1-9a3f-d579c645576e
msgctxt "hd0871463gffdbg4565g9dc6g4b2e5cf65fb4"
msgid "I was going to ask him to marry me!"
msgstr "그에게 청혼할 작정이었단 말이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 67f32102-19f2-78a7-c701-54ea895f851c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:67f32102-19f2-78a7-c701-54ea895f851c
msgctxt "h0456d7c6g1713g4d1fga5dag9a86e389c372"
msgid "I wish I hadn't let go of him."
msgstr "내가 그를 놓치지만 않았다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 68a0d19d-5897-f03e-34bd-18cb71d7184d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:68a0d19d-5897-f03e-34bd-18cb71d7184d
msgctxt "h13420422g6f49g40c8g8ae3g7beb53711e0a"
msgid ""
"They rounded us up... <i>cut</i> us up... Said they were taking whoever "
"could still walk to Moonrise Towers."
msgstr "그들이 우릴 한곳에 몰아넣고... <i>난도질</i>했어... 걸을 수 있는 사람은 문라이즈 타워로 데려간다고 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 6a9818b9-abde-42da-ed37-45f1687616c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LoneLover_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:6a9818b9-abde-42da-ed37-45f1687616c9
msgctxt "hd331ba04g17f7g418ag8a58g24f27b193f13"
msgid "I wish I hadn't left him behind."
msgstr "그들 두고 오지 않았다면 좋았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 7145ff6f-3181-3b29-9224-31c7340fda2a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_Event_PromisedRescue = True
#. TagRule: PALADIN
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:7145ff6f-3181-3b29-9224-31c7340fda2a
msgctxt "hdd84feadgc2c3g48bcgaac2g724d6150e2fc"
msgid "You have my word - I <i>will </i>find him."
msgstr "약속할게. 그를 <i>꼭</i> 찾아내겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 7145ff6f-3181-3b29-9224-31c7340fda2a
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_Event_PromisedRescue = True
#. TagRule: CLERIC
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:7145ff6f-3181-3b29-9224-31c7340fda2a
msgctxt "h5b762eb8g978dg47b7gb0cbge13f158ee482"
msgid "By the gods, I promise you I'll bring Danis back safely."
msgstr "신들께 맹세코 다니스를 무사히 데려올 거라 약속해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 7260b289-1f76-a092-b184-c543f712b8d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:7260b289-1f76-a092-b184-c543f712b8d9
msgctxt "he3af2b4eg65d2g4089g9d79gedbdf1558f3b"
msgid "Not unless you can bring him back."
msgstr "다니스를 다시 데려와 줄 수 있다면 모를까, 말곤 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 7741b9c8-268b-2a11-9a7a-5d5ac97aeb26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:7741b9c8-268b-2a11-9a7a-5d5ac97aeb26
msgctxt "h62107528gd759g4398ga7adg96c2bcc78af7"
msgid ""
"To be fair, he's probably better off dead than abandoned in Moonrise Towers."
msgstr "솔직히 말하면, 문라이즈 타워에 버려지느니 죽는 게 나았을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 78d9f08f-1aee-e022-dd8e-c93fe0ab185b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LoneLover_Bex_NightsongFreedHasMet(1) = False
#.      - HAV_LoneLover_HasMet(1) = False
#.   Global:
#.      - IMPOSSIBLE = True
#.      - COL_KethericShowdown_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_LoneLover_Bex_NightsongFreedHasMet(1) = True
#.     - HAV_LoneLover_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:78d9f08f-1aee-e022-dd8e-c93fe0ab185b
msgctxt "h28d6e511g7fadg46b0g8cd2gd8bf8a2a90b0"
msgid ""
"Oh - you! I almost didn't recognise you. Glad you made it. But I don't know "
"how much longer we'll be here. Something's... <i>happening.</i>"
msgstr ""
"오, 너구나! 못 알아볼 뻔했어. 살아남아서 다행이다. 그런데 우리가 얼마나 여기 있을지 모르겠어. 뭔가... <i>일어나고 있어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 794747e6-a1e2-ac25-cbe6-d39b02015f6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:794747e6-a1e2-ac25-cbe6-d39b02015f6f
msgctxt "hd57e2180gd46bg4a9bga9a9ge7902a25701c"
msgid "Do you really think so? By the gods, I hope you're right."
msgstr "정말 그렇게 생각해? 오 신들이시여, 네가 옳았으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 7e71663b-a7d2-4a0d-3b51-d440674b4847
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:7e71663b-a7d2-4a0d-3b51-d440674b4847
msgctxt "h2990a724ge5edg4c2ega2bbg2a220d7987f7"
msgid "It sounds like he meant a lot to you."
msgstr "그는 너에게 소중했나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 847b38fd-66d8-a800-07ab-5e8ba43d4c5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:847b38fd-66d8-a800-07ab-5e8ba43d4c5c
msgctxt "h5fb9159fg4ab2g4775ga55age7e5b8034f78"
msgid "Can you?"
msgstr "데려올 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 865b1349-1da0-c650-0228-ba0358603379
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_SavingPrisoners_Knows_CapturedTieflings = True
#.     - HAV_SavingPrisoners_Event_BexJournalIntro = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:865b1349-1da0-c650-0228-ba0358603379
msgctxt "hea6fc458g79b9g4644g9224g9fa4eb74f8ce"
msgid ""
"Cultists... It was so dark I didn't realise until the children started "
"screaming."
msgstr "사교도들이야... 너무 어두워서 아이들이 소리 지르기 전까지 알지도 못했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 86aae6ba-2d27-be0f-a992-639b62dc050c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:86aae6ba-2d27-be0f-a992-639b62dc050c
msgctxt "h063ca213g1151g4567g98a3g97dbfe6ae62b"
msgid "Everything."
msgstr "내 전부였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 8dee2a55-2d30-66d7-6964-f69247cf570a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:8dee2a55-2d30-66d7-6964-f69247cf570a
msgctxt "h3a8a9f38g41adg4c56ga5c3g800fd6816925"
msgid "What? But that means... Danis..."
msgstr "뭐라고? 하지만 그렇다면... 다니스는..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 8e4092fe-3d79-f993-5c67-47ab1f9a0f57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:8e4092fe-3d79-f993-5c67-47ab1f9a0f57
msgctxt "he0137ea5g6f95g4ca4g971agd1b22796a589"
msgid "Please. I don't want to think about it."
msgstr "부탁해. 생각하고 싶지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = 90f411d0-ed7c-c74b-e134-2fb9b5c47cee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:90f411d0-ed7c-c74b-e134-2fb9b5c47cee
msgctxt "h173c303bg1c9dg40bagbf4fg01fa0c5e9cb0"
msgid "You ought to be careful - there are dangerous people about."
msgstr "여기선 늘 조심해야 해. 주위에 위험한 놈들 천지라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 91c172b9-75fd-77ea-fe9f-11a9e1bf96d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:91c172b9-75fd-77ea-fe9f-11a9e1bf96d8
msgctxt "h92ae531dg83d5g4762ga20dg79c246fc0543"
msgid "I've always been good at running - unlike Danis."
msgstr "난 언제나 잘 달렸어. 다니스와는 다르게 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = 9e335eb9-5801-3dbb-c6fc-7edbd353cf0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_HatesPlayer = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:9e335eb9-5801-3dbb-c6fc-7edbd353cf0b
msgctxt "he6a058dcg2940g47e0g8fadg597d34ec1383"
msgid "Go. Away."
msgstr "저리 가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = a2a7fd21-816f-dfbd-4c36-3b68efae237b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:a2a7fd21-816f-dfbd-4c36-3b68efae237b
msgctxt "hc13ed9eeg31afg4b6dgaf5ag19b0b64cf5ab"
msgid "Danis could still be alive - don't give up on him yet."
msgstr "다니스는 살아있을 수도 있어. 아직 그를 포기하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = a3300acb-506b-060c-966e-635b3ba1421a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:a3300acb-506b-060c-966e-635b3ba1421a
msgctxt "h5482d32ag287bg4d1fga123g5fb48dd322dc"
msgid "I'm sorry, it's just..."
msgstr "미안해, 이건 그저..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = ae4e59f1-3b52-3d57-cfef-d28e61e4f5e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:ae4e59f1-3b52-3d57-cfef-d28e61e4f5e7
msgctxt "hbce08c71ga671g49b6gbea1ge9ab6167b9bc"
msgid "Really? Fine, fine. I'm Bex - I was travelling to Baldur's Gate."
msgstr "기억 안 난다고? 그래, 좋아. 난 벡스야. 발더스 게이트로 가고 있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = b4f4d1e8-64bf-1d5a-15bd-db1d5e668da4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:b4f4d1e8-64bf-1d5a-15bd-db1d5e668da4
msgctxt "h7cd7e48dgf421g4d0agac77g23aa88364a82"
msgid "How did you manage to get away?"
msgstr "어떻게 도망칠 수 있었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = bd3818fc-9454-ecad-02df-4c9699f6afcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_YoungLovers_State_MetPlayer = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:bd3818fc-9454-ecad-02df-4c9699f6afcb
msgctxt "h40aa263cg406cg4001gb64eg7095bf85c716"
msgid "Who are you?"
msgstr "넌 누구야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = c7ad30a9-0358-e27e-e629-8db5e8a5939e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:c7ad30a9-0358-e27e-e629-8db5e8a5939e
msgctxt "hb0926d51g52bcg4aa3ga25fg666dea5adfd7"
msgid "Is there anything I can do to help?"
msgstr "내가 도와줄 수 있는 일이 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = d452d10c-65a8-3c96-9cb6-6d5781aa0bd8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ba6b8bdd-f714-8826-5a2e-d586aa069a86_Mentionedmoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:d452d10c-65a8-3c96-9cb6-6d5781aa0bd8
msgctxt "he69dfabeg905eg4242g82d6g30128e014b1f"
msgid ""
"If they didn't kill him when we ran, they probably will once they get to "
"Moonrise."
msgstr "우리가 도망칠 때 죽이지 않았어도, 문라이즈에 도착하자마자 죽이고 말 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = da773b55-9058-bae0-81a5-8055c6ed8034
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:da773b55-9058-bae0-81a5-8055c6ed8034
msgctxt "he6659289g7ffeg4d17gb021gcbae6e7183d1"
msgid "I know, I know, but..."
msgstr "알아, 나도 아는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = de421e1f-b214-9be1-0619-68acf17510fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_Event_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:de421e1f-b214-9be1-0619-68acf17510fc
msgctxt "h6e3565f7g9874g4c7bg8c6fg595654507884"
msgid ""
"Thank you for bringing Danis back to me - I really don't know what I'd do "
"without him."
msgstr "다니스를 구해줘서 고마워. 다니스가 없었다면 어떻게 살아갈지 상상도 못할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = df00ef54-50f2-230b-97ef-1fa553897868
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:df00ef54-50f2-230b-97ef-1fa553897868
msgctxt "h3bb46920g4a3fg45c0ga4dag3bdfb74a12bf"
msgid "What does it matter?"
msgstr "그게 무슨 상관이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = e046e610-05ee-6aed-0222-23af086aecc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:e046e610-05ee-6aed-0222-23af086aecc3
msgctxt "hbd7514a6g6c63g4097ga876ga86676bdf991"
msgid "It's Danis. He's gone."
msgstr "다니스 때문이야. 다니스가 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = efc14dea-4777-b34d-2aef-4661b92faba6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:efc14dea-4777-b34d-2aef-4661b92faba6
msgctxt "h336219aeg50a0g460cgad0cg31db4b856d58"
msgid "Stop snivelling and tell me what's wrong, then."
msgstr "그럼 그만 질질 짜고 뭐가 문제인지 말하지 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = f25ef8f1-a601-ec4d-49b6-73e45fbbd7f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:f25ef8f1-a601-ec4d-49b6-73e45fbbd7f5
msgctxt "h37c08342gd1fcg4396gaee7gcfef236b19a0"
msgid "I didn't realise one day our lives would depend on it."
msgstr "그게 우리 목숨을 좌지우지할 줄은 몰랐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = f262795d-d3a2-ab6b-2107-b684d204228a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:f262795d-d3a2-ab6b-2107-b684d204228a
msgctxt "hc2c1956fg1403g425eg9e4cg32fbca270a37"
msgid "I know what you're saying is true, but..."
msgstr "네 말이 사실인 건 알지만, 그래도..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = f2d2078a-2a04-3cc1-d1c6-b8ff96eb81e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LoneLover_Bex_NightsongFreedHasMet(1) = False
#.      - HAV_LoneLover_HasMet(1) = True
#.   Global:
#.      - IMPOSSIBLE = True
#.      - COL_KethericShowdown_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_LoneLover_Bex_NightsongFreedHasMet(1) = True
#.     - HAV_LoneLover_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:f2d2078a-2a04-3cc1-d1c6-b8ff96eb81e8
msgctxt "h6088b965g0319g49beg9edeg855e9a9c2693"
msgid ""
"You're still going to kill that madman, aren't you? There's enough evil to "
"go around without him."
msgstr "그 미친놈을 죽인다는 계획에는 변함이 없는 거지? 그놈 아니어도 악은 차고 넘친다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = f3ce72cf-c1c8-c3ca-1f5d-7e81f772ed1a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_State_HatesPlayer = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:f3ce72cf-c1c8-c3ca-1f5d-7e81f772ed1a
msgctxt "h734226e4g738fg48e9g987ag1c23f9a09eed"
msgid "Piss off, <i>mragreshem</i>!"
msgstr "꺼져, <i>므라그레셤</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = f9d60198-0c29-1316-fbbc-8be2c3100dc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:f9d60198-0c29-1316-fbbc-8be2c3100dc1
msgctxt "h33b9a5ddg6f24g4a33g96cag10aaa91b6120"
msgid "It would mean the world to me."
msgstr "내게 그보다 기쁜 일은 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Bex
#. NodeID = fb0d97d8-40e0-77ac-7a1c-b4dc933c4d3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:fb0d97d8-40e0-77ac-7a1c-b4dc933c4d3c
msgctxt "h8c7a741aga0f0g4061gbd20g8893dc88695e"
msgid "I don't know what to do now."
msgstr "뭘 해야 할지 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex
#. Speaker = Player
#. NodeID = fca47ae1-596e-570b-dc4d-46c9cd276857
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_Event_PromisedRescue = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Bex:fca47ae1-596e-570b-dc4d-46c9cd276857
msgctxt "hb113adabg06b1g466bga846g0c64cb826786"
msgid "I'll do my best to find him, but I can't promise anything."
msgstr "그를 찾기 위해 최선을 다하겠지만 아무것도 약속할 수는 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis
#. Speaker = Danis
#. NodeID = 00094278-c365-2b06-eaa3-c45a4cff182f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis:00094278-c365-2b06-eaa3-c45a4cff182f
msgctxt "h927a1aa1gd7c8g425bgaf86gda22e070752c"
msgid "I owe you my life. That's not a debt I'll soon forget. Thank you."
msgstr "네게 목숨을 빚졌어. 결코 쉽게 잊지 않을 거야. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis
#. Speaker = Danis
#. NodeID = 04402fc2-4fee-33f5-6985-1543e448ae93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_Danis_NightsongFreedHasMet = True
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis:04402fc2-4fee-33f5-6985-1543e448ae93
msgctxt "h97e87ad3g3544g4cfeg86ebg575caec926a4"
msgid "Good luck out there."
msgstr "행운을 빌게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis
#. Speaker = Danis
#. NodeID = 09a40db8-141f-0360-ba0b-92cec537b7b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_Danis_NightsongFreedHasMet = False
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_Danis_NightsongFreedHasMet = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis:09a40db8-141f-0360-ba0b-92cec537b7b0
msgctxt "h631ebfb1gab32g47e2ga9d2g6505c426c18b"
msgid ""
"I just want to make it to Baldur's Gate. We've come this far, right? Just a "
"little longer yet."
msgstr "그저 발더스 게이트에 도착하고 싶을 뿐이야. 이만큼이나 왔잖아, 그렇지? 이제 얼마 안 남았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis
#. Speaker = Danis
#. NodeID = 2d4b6a2f-3893-e846-604a-b44af48b8886
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_LoneLover_HasMet_Danis(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis:2d4b6a2f-3893-e846-604a-b44af48b8886
msgctxt "hbb0b25e9gf7f5g49a2gaffagaacdf6394029"
msgid "Bex said the gods sent you to us. I think she's right."
msgstr "벡스가 그러는데 신들이 널 보내준 거래. 그 말이 맞는 거 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis
#. Speaker = Danis
#. NodeID = 54bcbab0-3e9d-4059-2964-c3bf11ae59db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LoneLover_HasMet_DanisGrieving(1) = True
#.   Global:
#.      - DEN_YoungLover02_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis:54bcbab0-3e9d-4059-2964-c3bf11ae59db
msgctxt "h00e1dbf0g7e95g4f83g9202g375fb3b61967"
msgid "It's good to have you here. Thanks for everything you've done."
msgstr "네가 있어서 정말 다행이야. 고마워. 전부 다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis
#. Speaker = Danis
#. NodeID = 557b012a-d1dc-e284-e542-24ef229207b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LoneLover_HasMet_Danis(1) = True
#.   Global:
#.      - HAV_Mood_State_Protected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis:557b012a-d1dc-e284-e542-24ef229207b8
msgctxt "hd9569610g51d7g4354gb78ag431c889a083e"
msgid ""
"Thank you for saving us - <i>again</i>. I'm never leaving Bex's side again. "
"Never ever."
msgstr "구해줘서 고마워, <i>다시 한번</i> 말이야. 이제 벡스 곁을 떠나지 않을 거야. 절대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis
#. Speaker = Danis
#. NodeID = 5aec9276-7f8c-6f57-e9ed-9c68567f192d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_HatesPlayer = True
#. SetFlags:
#.   Dialog:
#.     - HAV_LoneLover_HasMet_DanisUpset(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis:5aec9276-7f8c-6f57-e9ed-9c68567f192d
msgctxt "hb821388cg8783g4f09g9506gc1a321524103"
msgid ""
"Bex isn't easily offended, so gods know what you said to upset her so much."
msgstr "벡스는 그렇게 쉽게 화를 낼 사람이 아닌데. 네가 대체 무슨 말을 했길래 그렇게 화가 난 건지 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis
#. Speaker = Danis
#. NodeID = 6364a502-dd73-dbd8-007a-0998a5398b65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_YoungLover02_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - HAV_LoneLover_HasMet_DanisGrieving(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis:6364a502-dd73-dbd8-007a-0998a5398b65
msgctxt "h5097e837g0d6fg40e6ga23cgb207d2eb6812"
msgid ""
"It isn't the same here - not without Bex. Gods... if I could just hold her "
"in my arms one more time."
msgstr "예전 같지 않아, 벡스가 없다니. 신이시여... 벡스를 한 번만이라도 더 안아볼 수 있다면 좋으련만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis
#. Speaker = Danis
#. NodeID = 66d9f4e8-dbf9-3c08-426c-28c8689b4ef8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_BexDiedBeforeHaven = False
#.      - DEN_YoungLover02_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - HAV_LoneLover_HasMet_DanisGrieving(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis:66d9f4e8-dbf9-3c08-426c-28c8689b4ef8
msgctxt "hdeb8f07bg1586g4e3eg9c1egf622ceff4be4"
msgid ""
"She's dead. Bex. How can she be dead? After everything - Elturel, the "
"druids, <i>this </i>place. It makes no sense at all."
msgstr ""
"벡스가 죽었어. 어떻게 그럴 수 있지? 엘투렐, 드루이드, 그리고 <i>여기</i>까지, 모든 걸 헤쳐왔는데. 이럴 수는 없는 거잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis
#. Speaker = Danis
#. NodeID = 6e0744fa-e62a-6bbd-bd9c-b9c262830884
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis:6e0744fa-e62a-6bbd-bd9c-b9c262830884
msgctxt "h07e708a4g51f0g4e57g8127g053eeb3d3168"
msgid ""
"After everything you've done for us, she'll come around eventually, I'm sure."
msgstr "네가 우리에게 해준 일들이 있으니까, 결국엔 화를 풀 거야, 진짜로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis
#. Speaker = Danis
#. NodeID = 776e4332-6482-2991-8073-5c631eae2f81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_LoneLover_HasMet_DanisUpset(1) = True
#.   Global:
#.      - HAV_LoneLover_State_HatesPlayer = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Danis:776e4332-6482-2991-8073-5c631eae2f81
msgctxt "h40c5cc25g0893g4a2aga1d4g1aca63a98566"
msgid "You should probably go."
msgstr "그냥 가는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = 04873f89-96c5-447b-b1e3-003f100ec6bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:04873f89-96c5-447b-b1e3-003f100ec6bd
msgctxt "he0fea683g17e2g45b0gaedfga9416985f6e0"
msgid "Don't get too comfortable. We won't be safe here for long."
msgstr "너무 편안해 하지는 말라고. 여기라고 영원히 안전하진 않을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = 09787b7a-5ce6-abc9-1c85-cc6545e2622f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:09787b7a-5ce6-abc9-1c85-cc6545e2622f
msgctxt "hda02d318g8371g47bfgb22eg9ecc1452ead8"
msgid "You were in trouble - I wanted to help. Simple as that."
msgstr "넌 곤경에 처해 있었고, 난 그걸 돕고 싶었어. 그게 다야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = 0bd7eec1-541a-2004-fbca-04b166fb1a4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:0bd7eec1-541a-2004-fbca-04b166fb1a4c
msgctxt "hfb23620fg7c96g4058gb17cg7054b2538a4d"
msgid "<i>You are.</i> And we'll never forget it - never ever."
msgstr "<i>진심이야.</i> 절대로 잊지 않을게, 절대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = 14fb594b-dcc4-3cde-d396-acdbfe40b4ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:14fb594b-dcc4-3cde-d396-acdbfe40b4ee
msgctxt "h0c1a7032gcc9eg4df2g82d2g1065ae5d7c3b"
msgid "Thank you. <i>Really.</i>"
msgstr "고마워. <i>진심이야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = 1c442502-e5d4-4fec-a6e0-ae34cbbebc6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:1c442502-e5d4-4fec-a6e0-ae34cbbebc6a
msgctxt "h2fa95d39gdfb8g4d66g924eg771af093f535"
msgid ""
"Maybe not. But we have each other now. We have this <i>moment </i>now - "
"thanks to you."
msgstr "그럴지도. 그래도 이제 우리에겐 서로가 있어. 우린 <i>이 순간</i> 함께야. 다 네 덕이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = 1f5495e6-6e63-1008-c070-4f90a009b03a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GOOD or PALADIN_GOOD
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:1f5495e6-6e63-1008-c070-4f90a009b03a
msgctxt "h530ffeb1g9a48g4cc7g86deg9b8b1fc54c70"
msgid "It was the right thing to do."
msgstr "옳은 일을 한 것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = 2331a8dd-35ab-25e4-32c5-448fd53436a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:2331a8dd-35ab-25e4-32c5-448fd53436a8
msgctxt "h24ef8959g8ff0g4616gaa9eg633a5502d267"
msgid "It was convenient. Next time, it might not be."
msgstr "별일 아냐. 다음번엔 또 어떻게 될 지 모르는 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Danis
#. NodeID = 245c02a2-38f2-4bc1-8f03-d4697b9a8137
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_Event_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:245c02a2-38f2-4bc1-8f03-d4697b9a8137
msgctxt "hb9296b67g192fg4e95g8cd2g5aeaa1d4f21e"
msgid "Come here, darling."
msgstr "이리 와, 내 사랑."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = 273c9321-8312-413b-b34f-e2ea4672f1bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:273c9321-8312-413b-b34f-e2ea4672f1bd
msgctxt "h35f19b35gafddg4743g824dg507c8cfb1862"
msgid "I was so scared I'd lost you."
msgstr "네가 죽은 줄 알고 너무 무서웠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = 332ac584-9e8b-c92c-6753-616cbde411c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_State_HatesPlayer = False
#.     - HAV_LoneLover_Event_GiveCookies = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:332ac584-9e8b-c92c-6753-616cbde411c5
msgctxt "hcc563bbbg5a33g4b09gb25cgff8960bc62c5"
msgid "Here - take these for the road. It's the least I can do."
msgstr "여기. 이거 가져가. 내 최소한의 감사 표시야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = 3f396b18-bf89-bb55-72cc-cbe1a2c015ad
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_NEUTRAL or PALADIN_NEUTRAL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:3f396b18-bf89-bb55-72cc-cbe1a2c015ad
msgctxt "h900f7f1eg0dd5g4f80gb78bg5dd7ec876a98"
msgid "I suppose it seemed pertinent."
msgstr "합당한 행동이라는 생각이 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = 481dd167-ed12-35dd-0991-f32ec9ffe39c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:481dd167-ed12-35dd-0991-f32ec9ffe39c
msgctxt "h65587daagd0f7g4ef5g9bd1g66b2b3723b3a"
msgid "We'll take it."
msgstr "네 생각이 그렇다면야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = 4919d8b2-5704-58d6-d2d7-2e5cb36c177e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:4919d8b2-5704-58d6-d2d7-2e5cb36c177e
msgctxt "heb7a524bg22f5g4f5fg95bdg15470afc2b6b"
msgid ""
"How lucky we are to have met you. I believe you're the noblest person I've "
"ever known."
msgstr "널 만난 게 얼마나 행운인지. 내 평생 만난 사람 중 가장 고결한 사람이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = 4d67194e-b3da-5206-2493-201f4e347398
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:4d67194e-b3da-5206-2493-201f4e347398
msgctxt "h88b19b3bg832dg4785gbd13g406079788f30"
msgid "I wouldn't get too comfortable - it won't be safe here forever."
msgstr "너무 안심하진 마. 여긴 계속 안전하진 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = 4fc45ab5-9050-e40b-527b-51e5701beaad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:4fc45ab5-9050-e40b-527b-51e5701beaad
msgctxt "h9e6128bcg06d2g4108ga1f2ga6bcb26d494f"
msgid ""
"This isn't the first time you've helped us - saved our lives, really. Why?"
msgstr "우리를 도와준 게, 아니, 목숨을 구해준 게 이번이 처음도 아니잖아. 대체 이유가 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = 66827084-e644-f772-b83a-8114338bd7b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:66827084-e644-f772-b83a-8114338bd7b5
msgctxt "hf5e72ee8gfa3fg4d82g949agdefebd053db7"
msgid "A beautiful sight, and all thanks to me."
msgstr "아름다운 광경이로군. 다 내 덕이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Danis
#. NodeID = 73164a52-9ac6-3d33-8880-26ce1ef7486f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:73164a52-9ac6-3d33-8880-26ce1ef7486f
msgctxt "h882c9b98gcaedg4a6bg8988ga258c142cef7"
msgid ""
"Credit where it's due - Bex, this is the one who helped me and the others "
"escape."
msgstr "물론 네 덕이지. 벡스, 나를 비롯한 모두가 탈출할 수 있도록 도와준 게 바로 이 사람이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = 75a9d3c4-77e4-46cb-890a-47a35fc53101
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:75a9d3c4-77e4-46cb-890a-47a35fc53101
msgctxt "hed0c2a48g1026g43c1ga2dcgfbddc1c87f94"
msgid "<i>Smile. They look so happy.</i>"
msgstr "<i>미소 짓는다. 그들은 무척 행복해 보인다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = 78597bca-ca9f-819c-fc15-5756885149aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:78597bca-ca9f-819c-fc15-5756885149aa
msgctxt "heb0ab232gd97cg427egaad7gcdc3aa9560b9"
msgid ""
"It's hard to believe. You were so callous, I didn't think you gave a damn "
"about us. And yet you helped us - <i>again</i>. Why?"
msgstr "믿을 수 없어. 우리 따윈 신경 쓰지 않는 냉혈한인 줄 알았는데. 이번에도 우리를 <i>또</i> 도와줬어. 대체 어째서지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = 7f2d2256-4618-fda6-5556-39fe00b485fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:7f2d2256-4618-fda6-5556-39fe00b485fd
msgctxt "h14c011bag822bg4d69g89d7g90c14fa77afb"
msgid "We'll never forget it. Never ever."
msgstr "절대로 잊지 않을게. 평생."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = 896a9cd5-2444-074f-f0b2-8add0d24d54e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:896a9cd5-2444-074f-f0b2-8add0d24d54e
msgctxt "h3de8b48dg1d6fg44b4g838bgd8b0e1bf2584"
msgid "<i>Leave them to it.</i>"
msgstr "<i>그들을 내려버려 둔다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Danis
#. NodeID = 9fbba2c4-189c-af5a-09a4-b155f42c0298
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:9fbba2c4-189c-af5a-09a4-b155f42c0298
msgctxt "hd314d85agbdedg444egac3eg3e0374151da9"
msgid "Hey!"
msgstr "벡스!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Danis
#. NodeID = ab460022-26ac-e2e7-f896-75ca71755f98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:ab460022-26ac-e2e7-f896-75ca71755f98
msgctxt "h695d3e14gc58bg48aegbf16gbf53d992ce40"
msgid ""
"Whatever your motivation, we're grateful. We've had a tough row to hoe - but "
"thanks to you, we just might make it."
msgstr "동기야 어찌 됐든, 정말 고마워. 너무나도 고된 여정이었지만, 덕분에 이겨낼 수 있을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = ae4d7523-d06e-4b47-ac1d-0b2bf27d1488
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:ae4d7523-d06e-4b47-ac1d-0b2bf27d1488
msgctxt "h5f84c1f0ga12bg4c0fg9a73gd6908fdf200a"
msgid "You're all right. My gods, you're all right!"
msgstr "무사했구나. 신이시여, 무사했어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = afb9f6db-63de-1ccc-0927-26221bd6c581
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_HatesPlayer = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:afb9f6db-63de-1ccc-0927-26221bd6c581
msgctxt "h424ef700g3bfcg4dafga1d7g14a31e977691"
msgid ""
"You might have the manners of an imp, but I believe you're the noblest "
"person I've ever known."
msgstr "매너는 좀 꽝이지만, 그 누구보다 고결한 사람인 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = b5982876-743d-d225-03b2-bb2526099576
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:b5982876-743d-d225-03b2-bb2526099576
msgctxt "h5c75ba17g9f26g4badga05eg60e8079d9eb2"
msgid "Let's hope there is no next time."
msgstr "다음번은 없기를 바라자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = b9291519-1f96-b895-74e3-167713eff94a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:b9291519-1f96-b895-74e3-167713eff94a
msgctxt "h7e78d273g6d5cg4a28ga862g3aae6684a60c"
msgid ""
"You make it sound so easy. But I know the lengths you've gone to on our "
"behalf."
msgstr "별일 아닌 것 처럼 말하네. 그래도 나는 네가 얼마나 고생했는지 알고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Danis
#. NodeID = c2278c9e-f534-13a9-e9fa-c2ee9177b6b8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_State_HatesPlayer = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:c2278c9e-f534-13a9-e9fa-c2ee9177b6b8
msgctxt "h1582bd11g7aebg4bf0ga279gc4ee29323efa"
msgid ""
"Thanks aren't enough, but we'll give them anyway. Every day, for the rest of "
"our <i>very </i>long lives."
msgstr "감사 인사로는 부족하겠지만, 그래도 고맙단 말을 해야겠어. 매일, 남은 <i>평생</i>동안 감사하며 살게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Danis
#. NodeID = c3a92b1c-30f0-8db8-f8b0-5697c5aa8b94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:c3a92b1c-30f0-8db8-f8b0-5697c5aa8b94
msgctxt "h626c5cbfg86deg4f49ga585ga19c917a8cc1"
msgid ""
"Whoa! Darling, this is the person who helped me escape that wretched place."
msgstr "어어! 자기야, 이 친구가 바로 우릴 그 끔찍한 곳에서 구해준 사람이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = c5d25c6c-417f-ee1a-2d8a-09909ea8b88c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:c5d25c6c-417f-ee1a-2d8a-09909ea8b88c
msgctxt "ha4948c89g116dg4885gb00bg40c760e39154"
msgid "I could ask myself the same question."
msgstr "나 스스로도 그게 궁금할 지경이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Danis
#. NodeID = c97390a3-1b7d-dd5e-59b0-f5480911daf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:c97390a3-1b7d-dd5e-59b0-f5480911daf4
msgctxt "h4e7f4eddgbd65g4457gbb49gddc35c550489"
msgid "Me too. But we're here now. Safe."
msgstr "나도. 하지만 이젠 만났잖아. 안전하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Danis
#. NodeID = ca5b4261-2e9b-4e70-ada1-0e3366eb24c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:ca5b4261-2e9b-4e70-ada1-0e3366eb24c9
msgctxt "h04ce8026g20ebg4541ga3e3g15e4ed00c900"
msgid ""
"Let me get a good look at you. My gods, Bex. I can't believe we almost lost "
"each other."
msgstr "그 얼굴 제대로 한 번 다시 보자. 신이시여, 벡스. 우리가 서로 영영 헤어질 뻔했다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Danis
#. NodeID = dcef6d26-1279-e8f8-fee4-beac340f5955
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:dcef6d26-1279-e8f8-fee4-beac340f5955
msgctxt "h3e9a8b87g0c5cg423aga3b3g1286549aaddb"
msgid ""
"Here we're fighting for our lives and you're working on your memoir. Well - "
"I'll take it, after all you've done."
msgstr "우리에겐 목숨을 건 싸움인데 네겐 그저 좋은 경험이라니. 뭐, 상관없겠지. 여태 네가 해준 걸 생각하면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = eb9c2e19-d51b-915f-0507-68011a5b5ec9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:eb9c2e19-d51b-915f-0507-68011a5b5ec9
msgctxt "heea27f0fg4e4dg407fg91e8g23c6dbdac0c0"
msgid "It's wonderful to see you two back together."
msgstr "둘이 다시 만난 모습을 보니 참으로 기쁘군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = efc2e2a6-bff9-ad24-f5d8-07f23f24c8d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:efc2e2a6-bff9-ad24-f5d8-07f23f24c8d7
msgctxt "h0bd210acge039g44e4g92fbg929311a01335"
msgid "For the experience, I guess."
msgstr "그냥 경험 좀 쌓으려고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = f535fbdd-330b-d499-b628-f59fe010a4b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_HatesPlayer = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:f535fbdd-330b-d499-b628-f59fe010a4b4
msgctxt "hbf4fe190gb328g4205g8aefg1f083616d38f"
msgid "I'd be much more comfortable if you'd leave us the hells alone."
msgstr "날 좀 가만히 내버려 두면 훨씬 더 편안해질 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Player
#. NodeID = f71d268d-8b36-446c-93f7-4f7ab2e34876
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_State_HatesPlayer = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:f71d268d-8b36-446c-93f7-4f7ab2e34876
msgctxt "he16b776cgf10fg4fdfg9744g0dd0ce6548be"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = fb4542ba-d63c-92a6-3991-31e5951b4d89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_State_HatesPlayer = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:fb4542ba-d63c-92a6-3991-31e5951b4d89
msgctxt "h013b2904gd172g4589gbbc9gcd4d3abd79be"
msgid ""
"You might have the manners of an imp, but you have a noble heart. Thank you."
msgstr "남을 대하는 태도는 최악이지만, 마음속만큼은 고결한 것 같네. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited
#. Speaker = Bex
#. NodeID = fcc10286-1280-5222-8433-73884bd8451c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LoneLover_State_HatesPlayer = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LoneLover_Reunited:fcc10286-1280-5222-8433-73884bd8451c
msgctxt "h839e1dccg0751g44ddg89cfg22129098bb8e"
msgid "Never again. You hear me? <i>Never.</i>"
msgstr "다시는 떨어지지 말자. 알겠지? <i>절대로</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Marcus_DismissesHalsin
#. Speaker = Narrator
#. NodeID = 4472caf8-ff3c-4fcc-bc53-3705d5328cfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Marcus_DismissesHalsin:4472caf8-ff3c-4fcc-bc53-3705d5328cfd
msgctxt "he441f7e2gdd0ag4563g80e4gdec603159561"
msgid ""
"*The Flaming Fist looks past your shoulder; it seems he'd prefer not to "
"speak to you.*"
msgstr "*플레이밍 피스트는 눈길도 주지 않습니다. 말을 섞고 싶지 않은 것 같군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_AD_Blackboard
#. Speaker = Narrator
#. NodeID = 5695a581-c971-4199-91e4-81b988d8d6ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_AD_Blackboard:5695a581-c971-4199-91e4-81b988d8d6ea
msgctxt "hc22af1d2g331ag4efdga09bg4ef9ddb25fdd"
msgid ""
"*Mug of ale, 4 cp\n"
"Chopped cheek, 3 sp\n"
"Daily special, inquire*"
msgstr ""
"*에일 한 잔, 4 cp\n"
"길게 썬 소 볼살, 3 sp\n"
"오늘의 특별 메뉴, 문의 바람*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 36d2bf93-23ee-debb-43b6-dfd53f494796
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Misc_State_PassedMeenlockArcanaCheck = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:36d2bf93-23ee-debb-43b6-dfd53f494796
msgctxt "h91256ddfg0ec9g4ce9ga99ega0966125b711"
msgid "Meenlocks! They're nearly as sensitive to light as I was."
msgstr "민록이다! 예전의 나 만큼이나 빛에 민감한 놈들이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 36d2bf93-23ee-debb-43b6-dfd53f494796
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Misc_State_PassedMeenlockArcanaCheck = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:36d2bf93-23ee-debb-43b6-dfd53f494796
msgctxt "h33f36eb7g93c5g4c4egb573gb6d45e54ef57"
msgid "Watch out - meenlocks."
msgstr "조심해 - 민록이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 36d2bf93-23ee-debb-43b6-dfd53f494796
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Misc_State_PassedMeenlockArcanaCheck = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:36d2bf93-23ee-debb-43b6-dfd53f494796
msgctxt "h0783b0bfga8d2g4987g9c6bg4cde422e15f0"
msgid "Careful - those are meenlocks. Fire or light should put them off."
msgstr "조심해, 민록이야. 불이나 빛으로 혼란시킬 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 36d2bf93-23ee-debb-43b6-dfd53f494796
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Misc_State_PassedMeenlockArcanaCheck = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:36d2bf93-23ee-debb-43b6-dfd53f494796
msgctxt "h076b8e43g2952g40a3g80fcg9d5acd372221"
msgid "Tender-eyed meenlocks. Fire and light will wear them down."
msgstr "눈이 약점인 민록이군. 불과 빛이 효과적일 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 36d2bf93-23ee-debb-43b6-dfd53f494796
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Misc_State_PassedMeenlockArcanaCheck = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:36d2bf93-23ee-debb-43b6-dfd53f494796
msgctxt "h5478bd88g4c9fg49f7gb5e7g01d77cd79139"
msgid "Meenlocks. Easily blinded by light - I need a torch or something."
msgstr "민록이군. 빛을 보면 눈이 머는 놈들이지. 횃불 같은 게 필요하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 36d2bf93-23ee-debb-43b6-dfd53f494796
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Misc_State_PassedMeenlockArcanaCheck = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:36d2bf93-23ee-debb-43b6-dfd53f494796
msgctxt "hd7bf01e9g0a3ag466dgb60egefe977d4973b"
msgid ""
"Meenlocks - damnable things. A bit of light or fire should scorch those "
"tender eyes."
msgstr "민록이군. 지독한 놈들이지. 약간의 빛이나 불이면 연약한 눈을 태워버릴 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 36d2bf93-23ee-debb-43b6-dfd53f494796
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Misc_State_PassedMeenlockArcanaCheck = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:36d2bf93-23ee-debb-43b6-dfd53f494796
msgctxt "h1c8822ddge8dfg466fga6cbg361cfc658f07"
msgid "Meenlocks! Their eyes are sensitive - light or fire is my friend."
msgstr "민록이다! 눈이 예민한 놈들이지. 빛이나 불이 있으면 아주 요긴하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 53bca118-1921-4cfe-8a8a-761f0a572002
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Misc_State_PassedMeenlockArcanaCheck = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:53bca118-1921-4cfe-8a8a-761f0a572002
msgctxt "hb892d1e7g4534g4f63gbf72gcdafb87687c1"
msgid "Look out - meenlocks!"
msgstr "조심해 - 민록이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction
#. Speaker = Player
#. NodeID = 53bca118-1921-4cfe-8a8a-761f0a572002
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Misc_State_PassedMeenlockArcanaCheck = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Misc_PAD_MeenlockReaction:53bca118-1921-4cfe-8a8a-761f0a572002
msgctxt "hb41ee775gf890g4139gb56bgd91f86b98abd"
msgid "Meenlocks!"
msgstr "민록이다!"

