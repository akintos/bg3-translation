#. SetFlags:
#.   Local:
#.     - 7cf6069c-f0dc-482c-bf10-eea39f59d778_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_TauntPlayer:8f59ca10-fa20-4c22-8de1-e74e1f396971
msgctxt "hd1b98a61gd0d0g4630gb978gcc6785bd512c"
msgid "Where are your guts? Your brawn?"
msgstr "용맹은 어디다 팔아먹고 온 게냐? 심지가 그리 가냘퍼서야 되겠느냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Nightsong_AD_NightsongAttacked
