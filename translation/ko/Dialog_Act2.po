msgid "Cell Four"
msgstr "수감실 4"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Prison_AD_CellPlaque5
#. Speaker = Narrator
#. NodeID = cd308804-1187-4a27-9291-e12ce3d64e1b
