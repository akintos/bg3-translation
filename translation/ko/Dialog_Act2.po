msgctxt "h4cd311c3g32d9g423dgbefegc125e64b874b"
msgid "The shadow curse is snuffing out the torches."
msgstr "그림자 저주가 횃불을 꺼버리고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
#. Speaker = Player
#. NodeID = 4ef4b11f-4366-4107-9062-539d468fc2b6
