msgctxt "h3c5748d9g0c00g4abeg8b58gc1e02a52a6c5"
msgid "<i>Check the ground for signs of other paw prints.</i>"
msgstr "<i>지면에 다른 발자국 흔적이 있는지 확인합니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
