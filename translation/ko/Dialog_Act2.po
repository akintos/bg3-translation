msgctxt "ha1c0c5f8g13bag49b2g94a6g20fc5d380201"
msgid ""
"I'm [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]. Pleased to meet "
"you."
msgstr ""
"나는 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53] (이)라고 한다. 만나서 반갑군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint
#. Speaker = Player
#. NodeID = e4d986a6-a5e8-c7ac-1eb8-05cca619852b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint:e4d986a6-a5e8-c7ac-1eb8-05cca619852b
msgctxt "ha79bf2edgd7eeg49f1gb542gb968f701f916"
msgid "Please - ma'am - I'm from Baldur's Gate. Like you. I'm on your side."
msgstr "부인, 제발요. 전 당신과 마찬가지로 발더스 게이트에서 왔어요. 그쪽 편이라고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint
#. Speaker = Jaheira
#. NodeID = e4ee4a1c-f6fb-c55a-86d8-f9686abec07d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_ClawsKilledLongAgo = True
#.      - HAV_EnteringHaven_Event_ClawsKilled = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint:e4ee4a1c-f6fb-c55a-86d8-f9686abec07d
msgctxt "h65a4c674gd45cg40a7ga654gd047ac7e3e37"
msgid ""
"There you are! I thought those vile claws dragged you into a terrible grave."
msgstr "거깄구나! 그 더러운 발톱들이 널 끔찍한 무덤으로 끌고 간 줄 알았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint
#. Speaker = Jaheira
#. NodeID = e8589fff-d172-b0a1-e34c-a69b4b0a7a1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint:e8589fff-d172-b0a1-e34c-a69b4b0a7a1f
msgctxt "hca5d9bb3gda7eg456dg93c5g6aaec2474960"
msgid "You have not experienced my hatred, stranger. Not yet, at least."
msgstr "낯선 이여, 그대는 내 증오를 겪어보지 않았어. 적어도 아직은 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint
#. Speaker = Jaheira
#. NodeID = ea070495-3a5c-c34a-57c4-445ebf153f65
#. HandlePath = TaggedText[0].TagText[0]
