#.     - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = True
#. TagRule: BARD
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:f08bc0d9-ad44-6f28-eef6-c0b92950d7e3
msgctxt "ha1c1f1c3g8c80g480agb5d6g154c76f54594"
msgid ""
"Quite the powerful spell - bet there's a great story behind you learning it."
msgstr "제법 강력한 주문인걸. 분명 배움에 얽힌 대단한 이야기가 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = f08bc0d9-ad44-6f28-eef6-c0b92950d7e3
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = False
#.   Tag:
#.      - DRUID(1) = False
#. SetFlags:
#.   Dialog:
#.     - TWN_ArabellasPowers_Event_AskedAboutPowers(1) = True
#. TagRule: WARLOCK
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction:f08bc0d9-ad44-6f28-eef6-c0b92950d7e3
msgctxt "h1536953dg644fg4a64gbb31ge73d8740021f"
msgid "Magic that strong usually isn't free, child. Where did you acquire it?"
msgstr "그렇게 강력한 마법은 보통 거저 주어지는 게 아니란다, 얘야. 어디서 얻었니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_TownIntroduction
#. Speaker = Player
#. NodeID = f08bc0d9-ad44-6f28-eef6-c0b92950d7e3
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
