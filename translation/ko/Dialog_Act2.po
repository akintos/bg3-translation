msgctxt "hac961308gc214g4dd0g90daga9a5d00a4b0e"
msgid "I know one of them. Enver Gortash."
msgstr "저 중 한 명은 내가 알아. 엔버 고타쉬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_KethericShowdown_CrownController
#. Speaker = GROUP_Daisy
#. NodeID = 06066bfe-9d00-4b53-2fec-f29460975165
