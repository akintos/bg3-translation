#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = 0127caa8-c85b-c7e1-9d54-b2d370141b75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:0127caa8-c85b-c7e1-9d54-b2d370141b75
msgctxt "h801988ffg19c5g42a3gb308g7ee3bb1b14c1"
msgid "She's in the audience chamber. Go on inside."
msgstr "그녀께선 알현실에 계신다. 들어 가봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Karlach
#. NodeID = 03b531cc-26fd-42e7-a895-d2e3927f91e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_KARLACH(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:03b531cc-26fd-42e7-a895-d2e3927f91e7
msgctxt "h0fc359acga538g4c37g9e3fgfe2133653311"
msgid ""
"That's what I call an invitation. Let's find Z'rell and get this caravan "
"moving."
msgstr "이 정도는 돼야 초대라고 할 수 있지. 이제 즈렐을 찾아서 앞으로 나아가자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = 0be29ad1-92ee-bf5c-5070-eb2b44468ed2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:0be29ad1-92ee-bf5c-5070-eb2b44468ed2
msgctxt "h43b8817fg3941g43dcg84b6g28a03708ebfb"
msgid ""
"I've hid in some fetid places in my time - but the land around here "
"<i>really</i> takes the cake."
msgstr "나도 시궁창 같은 곳에서 숨어 지낸 경험이라면 꽤 있는데, 여긴 <i>정말이지</i> 그 중에서도 최악이로군. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = 243ee882-4a3b-9a78-32f2-9c0ef2f1a261
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:243ee882-4a3b-9a78-32f2-9c0ef2f1a261
msgctxt "ha4204236g622cg4433gb473g95305aab49cd"
msgid "Surprise - I'm here to take your head."
msgstr "짜잔, 네 목을 따려고 왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Lae'zel
#. NodeID = 2b11bac1-1252-43b6-8958-7a7eee69aaec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:2b11bac1-1252-43b6-8958-7a7eee69aaec
msgctxt "h387fd967g91dbg4513g8c0fg16dba444937d"
msgid "Our path leads to Z'rell. Let us not keep her waiting."
msgstr "우리는 즈렐에게 가야만 해. 지체하지 않도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Wyll
#. NodeID = 373f8b9d-6347-4ae9-903f-fb057ef2e607
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:373f8b9d-6347-4ae9-903f-fb057ef2e607
msgctxt "he7f2afbagd430g4bceg8efdgefcb720da5a0"
msgid ""
"Z'rell - fancy name. Let's put our best foot forward. Or is it best feet?"
msgstr "즈렐이라, 멋진 이름이네. 첫 단추를 잘 끼워 보자고. 단추들이라고 해야 맞나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = 37fc81a9-e2f1-e91f-116c-3cb2ee37ee51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:37fc81a9-e2f1-e91f-116c-3cb2ee37ee51
msgctxt "hba04aa2bgbcbcg49c7g8123g7c9f13082b33"
msgid "'Welcome back'? I've never been here before."
msgstr "'돌아온 걸 환영한다'? 난 여기 처음인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = 41f67745-6c72-ec92-4f38-1b3e9b2a9a87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_GeneralHaven_State_HavenDestroyed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:41f67745-6c72-ec92-4f38-1b3e9b2a9a87
msgctxt "hb6606907g79b9g4fa6g9fadgfed568953ec3"
msgid ""
"My my - it's you<i>.</i> Disciple Z'rell will be most pleased to meet the "
"person who took down all those Harpers. She was <i>delighted </i>when our "
"scouts reported your victory."
msgstr ""
"아, 너로군<i>.</i> 하퍼 놈들을 싹 다 쓸어버린 사람이 왔으니 신봉자 즈렐 님도 아주 기뻐하시겠어. 그분은 우리 정찰병이 네 "
"승리를 보고했을 때도 매우 <i>만족하셨다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Shadowheart
#. NodeID = 4df46f2c-bf9d-47a8-84df-d2d67414e5a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:4df46f2c-bf9d-47a8-84df-d2d67414e5a2
msgctxt "h7e230dc4gbf14g4b69g9f71g9b86d08fc76f"
msgid "Let's hope this Z'rell likes what we have to say."
msgstr "이 즈렐이란 자가 우리 얘기를 좋아하길 빌자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = 603b9c5a-5e98-85f0-5a89-59cfbea38c3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:603b9c5a-5e98-85f0-5a89-59cfbea38c3b
msgctxt "hbe43b758g5696g4f20gb786gfafb1c71f427"
msgid "Nowhere of importance. What news inside?"
msgstr "중요한 곳은 아니다. 안에선 별 소식 없나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = 667674c6-1dcd-85ab-2445-024d451e73e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:667674c6-1dcd-85ab-2445-024d451e73e6
msgctxt "h940d6bc3gfc58g4b8dgb2a9g7f26cb990a81"
msgid "Impressive."
msgstr "놀랍군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = 72a72786-3a23-a867-9cc1-5aa26df0406d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:72a72786-3a23-a867-9cc1-5aa26df0406d
msgctxt "hcae9ede6gc90dg4ea1gbe40gf3d460df8854"
msgid ""
"My my - it's you<i>.</i> Disciple Z'rell will be most pleased to meet the "
"person who aided Balthazar. She was <i>delighted </i>to see him return with "
"the Nightsong."
msgstr ""
"아, 너로군<i>.</i> 발타자르를 도운 사람이 왔으니 신봉자 즈렐 님도 매우 기뻐하시겠어. 밤의 노래랑 같이 돌아온 걸 보고 아주 "
"<i>만족</i>해하셨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = 7cd6a296-daf3-80b8-d0a3-ac989195ad38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:7cd6a296-daf3-80b8-d0a3-ac989195ad38
msgctxt "hc49a4fdbg708bg4589g8174g809e2e789c7c"
msgid ""
"My mistake - your mind tastes familiar. Where <i>are</i> you reporting from?"
msgstr "실수했군. 네 정신이 친숙하게 느껴졌다. 어느 <i>지역</i>에서 보고를 가져왔나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Adept Merim
#. NodeID = 8eeeb515-9073-64e2-e777-3922c6c4eef2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:8eeeb515-9073-64e2-e777-3922c6c4eef2
msgctxt "hf38cd209g387bg47eegb515g87f264f4d2e6"
msgid "Did I ever."
msgstr "들었고 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Gale
#. NodeID = 98ac46e4-8d5c-4f46-9d55-6295edf177e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_GALE(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:98ac46e4-8d5c-4f46-9d55-6295edf177e5
msgctxt "h5a7c1ad9gf813g4421g8976g060e215e5b23"
msgid "If it's an audience she desires, an audience let us provide."
msgstr "알현을 원하신다면야, 그렇게 해 드려야겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = 9c8da194-4970-9da5-2924-b79826bc6afd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_TheDrowNere_HasMet(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:9c8da194-4970-9da5-2924-b79826bc6afd
msgctxt "h3abf5a29gcf87g410cgaadeg021bf18dfc99"
msgid "Grymforge - I ran into some trouble, but I handled it."
msgstr "그림포지에서, 문제에 휘말리긴 했는데, 해결했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = a17393ec-39e0-60fd-d455-e12f1e5fcd5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(2) = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:a17393ec-39e0-60fd-d455-e12f1e5fcd5e
msgctxt "h1283c153g9bbfg4728g9070g1259478ac325"
msgid "But you're... a <i>non-believer</i>. Traitor!"
msgstr "하지만 넌... <i>불신자</i>로군. 이 배신자!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Astarion
#. NodeID = ad5ffa68-a4b3-4cb8-bb89-b4c3906e5304
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_ASTARION(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:ad5ffa68-a4b3-4cb8-bb89-b4c3906e5304
msgctxt "hca5bdb40g8764g4bcdga306g3f1596ec097e"
msgid "Well then, let's not keep her waiting."
msgstr "좋아 그럼, 기다리게 할 순 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = c96581fc-4f4c-b5f1-4414-de5ac3fd06ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:c96581fc-4f4c-b5f1-4414-de5ac3fd06ac
msgctxt "h48c7dbd2g5bc1g401fga26eg271ac0b7545c"
msgid "I infiltrated a group of Harpers at an Inn, out in the shadows."
msgstr "그림자 너머 한 여관에 있는 하퍼 무리에 잠입했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = e4306d8c-e23b-8501-2396-722482f7dd84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:e4306d8c-e23b-8501-2396-722482f7dd84
msgctxt "hc3fe9760gd5e7g4c57gab9ag05b908186624"
msgid ""
"What need have you of <i>hiding, </i>friend? You need not skulk like a "
"vagrant, this land belongs to us."
msgstr "<i>숨을</i> 필요가 뭐가 있나, 동지여? 부랑자처럼 웅크리고 다닐 필요는 없네. 이 땅은 우리 것이니까. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = ebcfa76c-a20c-fd30-5cf5-4ebf37f9fd37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_GeneralHaven_State_HavenDestroyed = False
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:ebcfa76c-a20c-fd30-5cf5-4ebf37f9fd37
msgctxt "h86071386gc595g44b6gaac5g0e6cbf31c726"
msgid "My apologies. Welcome back, True Soul - what news?"
msgstr "사과하지. 돌아온 걸 환영한다, 참된 영혼. 새로운 소식이라도 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = fc42e115-7d3f-ee0e-604a-6671a0f0da29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:fc42e115-7d3f-ee0e-604a-6671a0f0da29
msgctxt "ha48e1cb5gc3c9g4acegb88bgaea8cd1004c7"
msgid "Did you hear that, sister?"
msgstr "들었나, 자매여?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls
#. Speaker = Ghoul
#. NodeID = 6b4b1f1f-4f60-4ef0-8d47-ea22d6d3561c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - LocalFlag_01 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls:6b4b1f1f-4f60-4ef0-8d47-ea22d6d3561c
msgctxt "h3d3f6c5dg6a1cg41c4ga003g5d76c6ee144d"
msgid "Winged brother... took my meat."
msgstr "날개달린 형제가... 내 고기를 뺏어갔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls
#. Speaker = Ghoul
#. NodeID = 93497b07-ffc8-4c08-9c2d-ba6a539bb29d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls:93497b07-ffc8-4c08-9c2d-ba6a539bb29d
msgctxt "hbe9e8a6egd206g47b3ga66dgbdc618f91f68"
msgid "We stoop... and struggle."
msgstr "우리는 구부정해... 빼앗긴다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls
#. Speaker = Ghoul
#. NodeID = a619722b-a8fe-47a1-9db9-8c2696234c6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls:a619722b-a8fe-47a1-9db9-8c2696234c6b
msgctxt "h53af0b19gf8a2g49b0ga9fdgd4fa7590ec6b"
msgid "Need... visitors."
msgstr "필요해... 방문자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls
#. Speaker = Ghoul
#. NodeID = bfbda0e4-6f44-4ecf-bb00-a07b6a543f10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls:bfbda0e4-6f44-4ecf-bb00-a07b6a543f10
msgctxt "h09451270g95bfg4b0bgbf4cg058f1876c69b"
msgid "Make meat."
msgstr "고기 만들자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls
#. Speaker = Ghoul
#. NodeID = c1c6ddc3-f7a4-41c0-a4d6-2799dbafccee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls:c1c6ddc3-f7a4-41c0-a4d6-2799dbafccee
msgctxt "h02c7f468g5018g4f89gbda1gb9a18e4ebc0c"
msgid "Many-legs. Many-voices."
msgstr "다리 많아. 목소리 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls
#. Speaker = Ghoul
#. NodeID = da455d32-378f-4ea6-8e70-20b569397fe6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls:da455d32-378f-4ea6-8e70-20b569397fe6
msgctxt "haaafeaf7g4908g4cbdgbb9dg957a0df728dc"
msgid "They swoop... and steal."
msgstr "그들은 급습해... 빼앗는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls
#. Speaker = Ghoul
#. NodeID = def8a3b0-7ec2-4232-ad22-dec8681dcade
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls:def8a3b0-7ec2-4232-ad22-dec8681dcade
msgctxt "h2cf6d8c9g0effg4030g87d1g9a16397cb22d"
msgid "Many eyes."
msgstr "눈도 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls
#. Speaker = Ghoul
#. NodeID = f3638909-aab1-4ae4-8eda-f8fbf2ed8f30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - LocalFlag_04 = True
#.      - 9fa3c6d0-1262-f627-4738-98bd81d41774_2-f86e57f22a0e = True
#. SetFlags:
#.   Local:
#.     - LocalFlag_02 = False
#.     - LocalFlag_03 = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls:f3638909-aab1-4ae4-8eda-f8fbf2ed8f30
msgctxt "ha0d4c2c8g54c1g4d22ga4b2gcc7e39363a6e"
msgid "Need... meat."
msgstr "필요해... 고기."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls
#. Speaker = Ghoul
#. NodeID = f97c9153-a6a4-44f5-9861-f604dd16391f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - LocalFlag_01 = True
#. SetFlags:
#.   Local:
#.     - LocalFlag_06 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Ghouls:f97c9153-a6a4-44f5-9861-f604dd16391f
msgctxt "he22e6a7bg042eg40dfg9b8cgd7fc7601b5f4"
msgid "Spiders... in the dark."
msgstr "거미... 어둠 속에 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting
#. Speaker = Zealot Malik
#. NodeID = 0757c9ea-4aaf-42db-ba6a-ccd031c01bd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MutuallyExclusive_State_BalthazarReturn = True
#.   Local:
#.      - 550fa509-db7a-cd6d-0854-705de6d21f37_A = True
#. SetFlags:
#.   Local:
#.     - 550fa509-db7a-cd6d-0854-705de6d21f37_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting:0757c9ea-4aaf-42db-ba6a-ccd031c01bd5
msgctxt "h29fd9d8dg9599g4e88g85ffg2144ab517a6b"
msgid ""
"You brought Balthazar back from the darkness, I hear. The General will be "
"pleased."
msgstr "어둠 속에서 발타자르 님을 데리고 돌아왔다고 들었다. 장군님께서 기뻐하실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting
#. Speaker = Zealot Malik
#. NodeID = 48139a7d-8a88-47c2-b7f7-70e6d709bcdb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Local:
#.     - 550fa509-db7a-cd6d-0854-705de6d21f37_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting:48139a7d-8a88-47c2-b7f7-70e6d709bcdb
msgctxt "h0bd38ff8g3473g4305gb508gfe92192ac61b"
msgid ""
"The preparations are done - we march for Baldur's Gate. I hope you'll be "
"with us."
msgstr "준비는 끝났다. 우린 이제 발더스 게이트로 진군한다. 너도 함께 했으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting
#. Speaker = Zealot Malik
#. NodeID = 924bed5d-36f3-4a7a-927d-41ba6ef21fb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 550fa509-db7a-cd6d-0854-705de6d21f37_A = True
#. SetFlags:
#.   Local:
#.     - 550fa509-db7a-cd6d-0854-705de6d21f37_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting:924bed5d-36f3-4a7a-927d-41ba6ef21fb9
msgctxt "h9497e4a0g797fg4503ga35ege3f2f9c1967b"
msgid "In Her name, true soul."
msgstr "그분의 이름으로, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_AD_Guard001Greeting
#. Speaker = Zealot Malik
