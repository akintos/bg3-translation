#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_UpperFloor_TrespassWarning:4ad03a77-f8d1-4b43-8f42-c649926a3f64
msgctxt "hf1ca752ege81dg4f0dg99fcg1f61a6e6b3f6"
msgid "<i>Draw on the power within to enforce your will.</i>"
msgstr "<i>몸 속에 흐르는 힘을 끌어내 본인의 의지를 관철한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_UpperFloor_TrespassWarning
#. Speaker = Narrator
#. NodeID = 55a0583e-f04d-4f41-9d33-c183939971db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_UpperFloor_TrespassWarning:55a0583e-f04d-4f41-9d33-c183939971db
msgctxt "h60b0e229g94aag4f73gab36gd2aa1310f012"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_UpperFloor_TrespassWarning
#. Speaker = Narrator
#. NodeID = 7dbef344-df32-4d6b-a1bd-94e18ae83a4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_UpperFloor_TrespassWarning:7dbef344-df32-4d6b-a1bd-94e18ae83a4b
msgctxt "h510f441cg22d8g4aadgb3e4ga68386828654"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_UpperFloor_TrespassWarning
#. Speaker = Player
#. NodeID = 9089aa12-0586-48bd-905d-52a7ef1cb06d
