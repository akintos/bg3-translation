#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut:4ef4b11f-4366-4107-9062-539d468fc2b6
msgctxt "hf767bd26g81c8g4754gb102gb46563c4cc9f"
msgid "Even fire is swallowed in this darkness."
msgstr "불마저 이 어둠 속에서 삼켜지는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
