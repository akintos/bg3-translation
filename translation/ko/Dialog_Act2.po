#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Drider_AD:ed31e7c5-e887-4e65-b110-33066304856e
msgctxt "hecdcb3fdg1d2ag4311ga0d1gf03fbc8faf0a"
msgid "*Sob.*"
msgstr "*흐느끼는 소리.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Drider_AD_Combat
#. Speaker = Kar'niss
#. NodeID = 29029dfa-ff42-4ae2-b09c-a5f29de6e20e
