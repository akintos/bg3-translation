msgctxt "h54abc088g31afg4d2fgb9e3g9a0c5e9667fa"
msgid "I'm worried about what I might do to my allies..."
msgstr "내가 동료들에게 무슨일을 저지를지 걱정돼..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/GLO_GatherYourAllies_DaisyJournalBegin
#. Speaker = Player
