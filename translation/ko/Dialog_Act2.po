#.   Dialog:
#.     - SHA_LastJusticiar_RatsCalm_Event_AttemptedNatureCheck(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:70663da4-0ab2-894c-859c-edd5cbdc519b
msgctxt "h8f92db29gc63bg42b5g8cabg65b4fb5574a4"
msgid "<i>Study the rat's appearance.</i>"
msgstr "<i>쥐의 겉모습을 유심히 관찰한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Shadowheart
#. NodeID = 76db72c5-6390-4ff1-a108-c105bfd66c99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:76db72c5-6390-4ff1-a108-c105bfd66c99
msgctxt "h334fe124ged6dg4517gad9egbd9f38e212c5"
msgid ""
"There's something strange about the vermin in this place. Can't put my "
"finger on what though."
msgstr "여기 있는 쥐들은 뭔가 이상해. 뭐라 딱 꼬집어 말할 수는 없지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Rat
#. NodeID = 7a6111c2-c5bf-f321-d8a6-b40d92a50cab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsCalm_Event_CompanionSuggestsLeave(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:7a6111c2-c5bf-f321-d8a6-b40d92a50cab
msgctxt "h86c4e7b6gec19g48e0gafb9g8e7141deb24c"
msgid "We are small, but many. Leave, or see what happens."
msgstr "우린 작지만, 많지. 떠나지 않으면 어떻게 되나 보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Player
#. NodeID = 818f968e-b400-af6b-9dd0-6e879c4a8aef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsCalm_State_ImportanceQueried(1) = False
#.      - SHA_LastJusticiar_RatsCalm_Event_InsightSuccess(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsCalm_State_ImportanceQueried(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:818f968e-b400-af6b-9dd0-6e879c4a8aef
msgctxt "h783e389agbb29g4562g8523g32708e383dc3"
msgid "Seems this place is important to you. Why?"
msgstr "너에게 중요한 장소 같은데. 이유가 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Rat
#. NodeID = 8c8d541d-2094-8a33-ff83-fe591ff97f4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:8c8d541d-2094-8a33-ff83-fe591ff97f4b
msgctxt "h332db26fg3a6eg41f3g9ddcg170be482a40a"
msgid "*Chitter.*"
msgstr "*찍찍*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Rat
#. NodeID = 959a69df-14d6-daf3-349d-afd74ac3ba37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_LastJusticiar_RatsCalm_Event_CompanionSuggestsLeave(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:959a69df-14d6-daf3-349d-afd74ac3ba37
msgctxt "h34f2c15fge7a3g47c8gb916g1c2ecaa2a905"
msgid ""
"We've always been here - it's <i>ours</i>. We watch over it. You do not "
"belong."
msgstr "우린 항상 여기 있었어. 여긴 <i>우리 거</i>야. 우리가 지켜보고 있어. 넌 여기 어울리지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Rat
#. NodeID = 96adc8eb-92a4-6816-6394-47e01376d9d5
#. HandlePath = TaggedText[0].TagText[0]
