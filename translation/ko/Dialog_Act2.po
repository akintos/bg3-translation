#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Haruspicy:2bc95026-d77c-45e6-8bfb-3884d04cb408
msgctxt "hfa14cf6agea56g499fgaab7ge556c80a393e"
msgid "<i>Medullis et sanguis...</i>"
msgstr "<i>메둘리스 엣 생귀스...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Haruspicy
