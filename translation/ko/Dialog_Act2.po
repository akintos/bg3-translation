#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_State_BoatReady = True
#.   Local:
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_B = False
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_A = False
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:81a5bb56-ed49-a707-c4f9-151cf6f8476a
msgctxt "h9a18d783gb4a1g40c0g8848ga52c493b5b82"
msgid "The boat's free! Come on!"
msgstr "배를 풀었어! 가자!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = 83089a8a-dc51-4793-83f9-e84615779ea3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4951b7ce-8495-b2c8-badc-beaff0e3d807_F = True
