msgctxt "hde6cf6dbg2b87g4a3egaecbg6a90212569d5"
msgid "Lady Shar... what will she do to me...?"
msgstr "샤 여신이시여... 그분이 내게 어떤 처분을 내리실까...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
