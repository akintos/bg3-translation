#.      - TWN_ArabellaPowers_State_MovedToTown = True
#.      - TWN_ArabellasPowers_State_ParentA_DeadBeforeTown = False
#.      - TWN_ArabellasPowers_State_ParentB_DeadBeforeTown = False
#. SetFlags:
#.   Global:
#.     - TWN_ArabellasPowers_State_RecognisedParents = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:29a0282d-1f01-5ed5-6f52-eaeb6ae1db6c
msgctxt "hdedacb0ag20dcg4c37gafbcg78535a13a285"
msgid ""
"*Her patient is a tiefling - one you don't recognise, though clearly long "
"dead.*"
msgstr "*그녀가 돌보는 환자는 티플링입니다, 누군지 알아볼 수는 없지만, 확실히 죽은지는 오래된 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = 2fb7371f-a2bd-2e47-8611-73076f9ae905
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_CorpseTender_State_PassedCorpseCheck = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:2fb7371f-a2bd-2e47-8611-73076f9ae905
msgctxt "h081cba03g8726g4a68gbdc7g166fb95074b7"
msgid "I will sell you what I can once I've stabilised the patient."
msgstr "우선 환자를 안정시키고 나서 팔 수 있는 걸 둘러볼게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Astarion
#. NodeID = 37989741-bf95-f5d5-ec8f-248feaa61ca9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:37989741-bf95-f5d5-ec8f-248feaa61ca9
msgctxt "h6611fa95g6c45g40c2gb1b0gdc0e71aa2bf1"
msgid "A tiefling corpse - odds are that's sweet Arabella's father."
msgstr "티플링 시체라, 그 귀엽던 아라벨라의 아버지일 가능성이 커."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = 3ab14198-14af-4822-9f72-6849684109ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Hospital_Reception_CorpseTender_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:3ab14198-14af-4822-9f72-6849684109ad
msgctxt "hb951aef6g79abg4b1dg8acag9acb6cc59f0e"
msgid ""
"I'll do better, and the patients will be better, and it will all be fine..."
msgstr "내가 더 잘할 거야, 환자도 나아질 거고, 전부 괜찮아질 거야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = 3c40e677-f848-d724-a137-2b45c5e0ca0d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - TWN_CorpseTender_Event_FailedCheck(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:3c40e677-f848-d724-a137-2b45c5e0ca0d
msgctxt "he23cb1fag20bcg4fd3g983cg0462c2e355a4"
msgid "Hey! Don't do that to my patient!"
msgstr "야! 환자분께 손대지 마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Wyll
#. NodeID = 3f42d545-62c4-966d-d325-a59dfd8fb64a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:3f42d545-62c4-966d-d325-a59dfd8fb64a
msgctxt "h57478feagcb61g486agb7eag92a66c893d31"
msgid "That tiefling's seen better days. Arabella's father, I wager."
msgstr "저 티플링도 좋은 시절이 있었겠지. 틀림없는 아라벨라의 아버지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = 4a0c4cfc-54a6-9c53-8870-95db1d856cd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:4a0c4cfc-54a6-9c53-8870-95db1d856cd5
msgctxt "he776d685g4e20g44fegb931g03be1fb1f89a"
msgid "Now if you'll excuse me, I've got to tend to my patient."
msgstr "그럼 이만 가보셔요. 저는 환자분을 돌보러 갈게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Karlach
#. NodeID = 4ef6903c-574e-4ce9-a390-1d175a95ee61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:4ef6903c-574e-4ce9-a390-1d175a95ee61
msgctxt "h0668bda3g3f22g4e43gb740ga63ec0a148d8"
msgid "That body she's working on - that's Arabella's father."
msgstr "쟤가 돌보고 있는 시체 말이야, 아라벨라의 아버지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Sister Lidwin
#. NodeID = 596fa7f8-474e-8c3a-56a3-c7e26ef666c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_CorpseTender_HasMet2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:596fa7f8-474e-8c3a-56a3-c7e26ef666c8
msgctxt "hb47f1963ge515g447eg9d3egeeefc2b1dbfb"
msgid ""
"The doctor's teachings live on. I will be fine, the patients will be fine, "
"everything fine."
msgstr "선생님의 가르침은 여전해. 난 괜찮을 거야, 환자들도 괜찮을 거고, 모두 괜찮을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Shadowheart
#. NodeID = 5a66d2b3-6f9a-68aa-9043-9fc76962b3d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:5a66d2b3-6f9a-68aa-9043-9fc76962b3d1
msgctxt "h0027d991gfc30g4fe9gaa17g8a425f918828"
msgid ""
"A tiefling. That's Arabella's father, I wager - or <i>was </i>Arabella's "
"father."
msgstr "티플링. 아라벨라의 아버지야, 확실해, 아버지 <i>였던 것</i>이든지."

