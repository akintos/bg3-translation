#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:b5fc879d-d2d2-4d60-ad88-949aeb3cb6a0
msgctxt "h748ce6e8g7be1g485bgb40ag4eb03be00942"
msgid "Hells, Shadowheart. You just... handed her over."
msgstr "맙소사, 섀도하트. 그냥 그렇게... 밤의 노래를 넘겨 버리다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = b5fc879d-d2d2-4d60-ad88-949aeb3cb6a0
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:b5fc879d-d2d2-4d60-ad88-949aeb3cb6a0
msgctxt "h01a37d0dg339cg4b21ga52eg535a7afacc45"
msgid "How could you, Shadowheart?"
msgstr "어떻게 그럴 수가 있어, 섀도하트?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = b5fc879d-d2d2-4d60-ad88-949aeb3cb6a0
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:b5fc879d-d2d2-4d60-ad88-949aeb3cb6a0
msgctxt "hb9866c67g8d79g40c3ga617gd03e46a254d6"
msgid ""
"We just surrendered her...? She could have helped us put a stop to Ketheric "
"Thorm!"
msgstr "이런 식으로 밤의 노래를 줘 버리다니...? 그자가 케서릭 쏨에게 맞서는 데 도움을 줄 수도 있었을 텐데!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = b5fc879d-d2d2-4d60-ad88-949aeb3cb6a0
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:b5fc879d-d2d2-4d60-ad88-949aeb3cb6a0
msgctxt "h4dccac4bgf453g4e97gb10eg3f25562a0723"
msgid "She was defiant for a caged beast. Moonrise will break her."
msgstr "우리에 갇힌 짐승치고는 반항적이었군. 문라이즈 타워에 가면 부서질 터."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = b5fc879d-d2d2-4d60-ad88-949aeb3cb6a0
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#. TagRule: !REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:b5fc879d-d2d2-4d60-ad88-949aeb3cb6a0
msgctxt "h59d39796gfba7g4cecg8d63ge8996dc6dd1a"
msgid "Ketheric has her now. It's done."
msgstr "밤의 노래는 이제 케서릭 손에 들어갔어. 끝난 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = d8bd46d8-d128-4b2f-a388-da49a67ec789
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:d8bd46d8-d128-4b2f-a388-da49a67ec789
msgctxt "h646e1d01g388ag4776gabfega80f9dd68f2a"
msgid "Ketheric has form when it comes to cruelty, I'll give him that."
msgstr "케서릭 놈, 잔혹한 짓을 저지르기로는 따라올 자가 없군. 그거 하나는 인정해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = d8bd46d8-d128-4b2f-a388-da49a67ec789
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:d8bd46d8-d128-4b2f-a388-da49a67ec789
msgctxt "hd5442daegbc9fg45aega978gcd316fe65a73"
msgid "Ketheric Thorm has a lot to answer for."
msgstr "케서릭 쏨이 치러야 할 죗값이 깊어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = d8bd46d8-d128-4b2f-a388-da49a67ec789
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:d8bd46d8-d128-4b2f-a388-da49a67ec789
msgctxt "ha7ab62e8ga55ag460fgbac7gde10adad6be5"
msgid ""
"The quest for power has driven lesser men than Ketheric to worse cruelties."
msgstr "힘에 대한 야욕은 케서릭보다 한미한 이들로 하여금 더 악독한 짓을 행하게끔 만든 바 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = d8bd46d8-d128-4b2f-a388-da49a67ec789
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:d8bd46d8-d128-4b2f-a388-da49a67ec789
msgctxt "h3431275fg5ec0g4ecdgb6e0g775df4e12b2a"
msgid "All that pain, for the sake of Ketheric's enduring power. Sickening."
msgstr "케서릭의 힘을 지탱하기 위해서 이토록 지독한 고통을 견뎌야 했다니. 욕지기가 나려고 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = d8bd46d8-d128-4b2f-a388-da49a67ec789
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:d8bd46d8-d128-4b2f-a388-da49a67ec789
msgctxt "h8f1c5c74g2b66g4480g8280g5139d98981ff"
msgid "And all for Ketheric's greed. What a bastard."
msgstr "이게 다 케서릭 자식의 욕심 때문이라니. 개새끼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = d8bd46d8-d128-4b2f-a388-da49a67ec789
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:d8bd46d8-d128-4b2f-a388-da49a67ec789
msgctxt "hf349ac89g8e06g4cebg8218g3c5fade346e5"
msgid ""
"I knew Ketheric Thom was ruthless, but this is more than I could have "
"fathomed he was capable of."
msgstr "케서릭 쏨이 잔학무도한 자라는 건 알고 있었네만, 이런 짓까지 할 수 있을 줄은 정말이지 몰랐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = d8bd46d8-d128-4b2f-a388-da49a67ec789
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: !REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:d8bd46d8-d128-4b2f-a388-da49a67ec789
msgctxt "hd393b4f8g68bdg453dg8129g026de64a4ef7"
msgid "Ketheric and his minions were clever. Cruel, but clever."
msgstr "케서릭 놈과 그 수하들이 영리했군. 사악하지만, 영리하기는 했다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = e6ea8522-a951-413b-8e29-da35187ce2e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:e6ea8522-a951-413b-8e29-da35187ce2e6
msgctxt "h4e753b34ge091g4506g9b9eg4b6813ddd462"
msgid "Well, she's Ketheric's now. Her fate's in his hands."
msgstr "뭐, 이제는 케서릭의 것이 되었네. 밤의 노래의 운명은 그자 손에 달렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = e6ea8522-a951-413b-8e29-da35187ce2e6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:e6ea8522-a951-413b-8e29-da35187ce2e6
msgctxt "h0dd6a183g8247g4d87gb95ag6c588d9cf332"
msgid "Rather ruthless of you to just hand her over like that."
msgstr "그냥 그런 식으로 밤의 노래를 줘 버리다니 잔혹해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = e6ea8522-a951-413b-8e29-da35187ce2e6
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:e6ea8522-a951-413b-8e29-da35187ce2e6
msgctxt "h6896c557g4a86g4139g84eag501f2c7ffb3d"
msgid "The choice is made, and fate is written."
msgstr "결정은 내려졌고, 운명은 매듭지어졌다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = e6ea8522-a951-413b-8e29-da35187ce2e6
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:e6ea8522-a951-413b-8e29-da35187ce2e6
msgctxt "hbe9a7689g09c8g4fefgb05bg9abe65fa4b36"
msgid "Doomed to suffer. A tragedy many times over."
msgstr "끝까지 고통받는 파멸의 운명을 타고나다니. 그야말로 비극적이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = e6ea8522-a951-413b-8e29-da35187ce2e6
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:e6ea8522-a951-413b-8e29-da35187ce2e6
msgctxt "h4c5dfe41g2448g47dag83edgafa1651e51eb"
msgid "How could you just let him take her?!"
msgstr "어떻게 케서릭 새끼가 그냥 덜렁 밤의 노래를 데려가게 둘 수가 있어?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = e6ea8522-a951-413b-8e29-da35187ce2e6
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:e6ea8522-a951-413b-8e29-da35187ce2e6
msgctxt "hbe236d1dg90c3g4416g8ec3g4b4cd1537d13"
msgid ""
"We just surrendered her...? She could have helped us put a stop to Ketheric "
"Thorm!"
msgstr "이런 식으로 밤의 노래를 줘 버리다니...? 그자가 케서릭 쏨에게 맞서는 데 도움을 줄 수도 있었을 텐데!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = e6ea8522-a951-413b-8e29-da35187ce2e6
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:e6ea8522-a951-413b-8e29-da35187ce2e6
msgctxt "h6084a9bcg25a3g4600g8902gd6b652911b30"
msgid "We just gave General Thorm exactly what he wants. Was that wise?"
msgstr "우리는 방금 쏨 장군이 원하는 것을 정확히 안겨 주고 말았다. 이게 현명한 행동이었을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction
#. Speaker = Player
#. NodeID = e6ea8522-a951-413b-8e29-da35187ce2e6
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.      - SHA_NightsongPrison_Event_ShadowheartThereForFate = False
#. TagRule: !REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction:e6ea8522-a951-413b-8e29-da35187ce2e6
msgctxt "h704e31d5g3f62g4189g8c44gd8911995cec3"
msgid "It's done."
msgstr "이제 끝난 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
msgctxt "hc3019a3ag3d22g4314g8c89g8f4cf1ab7ae2"
msgid "I just hope we've done enough to take him down."
msgstr "이 정도 했으면 이제 놈을 쓰러뜨릴 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
msgctxt "h3817d7a1g8473g49dbg97c8g605e118ff43b"
msgid ""
"Ketheric will come to regret his abuse of her powers. I'll make sure of that."
msgstr "케서릭은 에일린의 힘을 마음대로 사용한 걸 후회하게 될 거야. 내가 그렇게 만들겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
msgctxt "h99eba468g3a37g474fg9e96g9c0d240a7343"
msgid "The time is nigh: Ketheric will fall at our hands."
msgstr "드디어 때가 왔다. 케서릭은 우리 손에 쓰러질 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
msgctxt "h8d5d96b4ge687g45d9g8564g22827d721fbe"
msgid ""
"The Nightsong will tear Ketheric to shreds. I wouldn't miss it for the world."
msgstr "밤의 노래가 케서릭을 갈기갈기 찢어 버릴 거야. 그런 광경이라면 반드시 봐야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
msgctxt "ha085708agbccag4ea0g81b8g3aaa48f6177c"
msgid "Can't wait to see her cleave Ketheric's head in two."
msgstr "밤의 노래가 케서릭의 대가리를 둘로 쪼개는 광경을 얼른 보고 싶네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
msgctxt "h170bfa4cgb4adg4f97gb773g302ab13baadd"
msgid "Ketheric Thorm is vulnerable now. Now is the time to strike."
msgstr "케서릭 쏨은 이제 취약해졌네. 지금이 공격할 기회일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
msgctxt "h5d0009a8gc36eg42beg90e5g6acbe7faa4ab"
msgid ""
"We must hurry. If she kills Ketheric before we reach Moonrise, I will be "
"sorely disappointed."
msgstr "서둘러야 한다. 우리가 문라이즈에 닿기도 전에 그녀가 케서릭을 죽여버린다면, 무척이나 아쉬울 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:09f6a38d-2ecf-4fcc-b2ab-f023858f54a0
msgctxt "hb30d07d8g12c4g43deg844cgdd6e73af575c"
msgid "Ketheric's vulnerable now. All we have to do is strike."
msgstr "케서릭도 이제는 취약해졌어. 놈을 공격하기만 하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 144c8259-e83b-4e50-a0aa-c2a51e367736
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:144c8259-e83b-4e50-a0aa-c2a51e367736
msgctxt "hc40fb846g9c85g44d4ga9b4gba59c4049ee0"
msgid "I... I failed. I let the Nightsong just be <i>taken</i>."
msgstr "난... 난 실패했어. 밤의 노래를 <i>데려가도록</i> 내버려 두다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 32471cbd-3f40-4796-8ee9-5f1ff275e673
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:32471cbd-3f40-4796-8ee9-5f1ff275e673
msgctxt "h2beeb1d4ge29fg423dgae6cg949a07ceb6b6"
msgid "I just hope the old man's true to his word."
msgstr "그 늙은이 말이 맞길 바랄 수밖에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 32471cbd-3f40-4796-8ee9-5f1ff275e673
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:32471cbd-3f40-4796-8ee9-5f1ff275e673
msgctxt "hf9e251a1g63feg429fgabafgd8bc7c05d1a4"
msgid ""
"A dismal place for an aasimar to spend her existence. Especially with that "
"necrotic toad for company."
msgstr "아시마르가 있기에는 너무나도 음울한 곳이야. 특히나 저 썩어 문드러진 두꺼비와 함께라면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 32471cbd-3f40-4796-8ee9-5f1ff275e673
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:32471cbd-3f40-4796-8ee9-5f1ff275e673
msgctxt "ha456f41fg27bag482cg9995gba7ceb099b7c"
msgid "Let's hope our choice is to our advantage."
msgstr "우리의 선택이 이점으로 작용하길 빌어야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 32471cbd-3f40-4796-8ee9-5f1ff275e673
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:32471cbd-3f40-4796-8ee9-5f1ff275e673
msgctxt "ha57a91e7gb592g46d8ga1f5g5acf2a0ec6ed"
msgid "This doesn't sit right with me. I hope I've chosen wisely."
msgstr "난 아무래도 거슬려. 내가 현명하게 선택했기를 바랄 뿐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 32471cbd-3f40-4796-8ee9-5f1ff275e673
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
