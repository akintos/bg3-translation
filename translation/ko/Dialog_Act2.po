msgctxt "h1fda672fg9067g4dafgba43g92c4a8d7e997"
msgid "The language of the mind flayers. As indecipherable as it is unnatural."
msgstr "마인드 플레이어들의 언어군. 부자연스러워. 해독불가야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_MemoryLibrary_PAD_Manuscripts
