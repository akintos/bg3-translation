#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Cat:fbad62d1-b41a-80e2-bb48-2e0c5ca6b036
msgctxt "h13733d78g5a5eg494dg8c5bg15d9d72aa821"
msgid "*Hiss!*"
msgstr "*하악!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Checkpoint_AD_Combat_Jaheira_000
#. Speaker = Jaheira
#. NodeID = d8207533-29a6-4bc5-afc8-ba90f3748504
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Checkpoint_AD_Combat_Jaheira_000:d8207533-29a6-4bc5-afc8-ba90f3748504
msgctxt "h350032ccgc6b7g4480ga080ga13fe8f934b6"
msgid "You should have stayed in your tower."
msgstr "탑에서 기어 나오지 말지 그랬어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Checkpoint_AD_Combat_Jaheira_001
#. Speaker = Jaheira
#. NodeID = 63c4704c-7219-4579-8ac8-c337e2d15934
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Checkpoint_AD_Combat_Jaheira_001:63c4704c-7219-4579-8ac8-c337e2d15934
msgctxt "hb4a937begd606g47c4gb545gd70c23ebf16d"
msgid "It's as good as done."
msgstr "끝난 거나 마찬가지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Checkpoint_AD_Combat_Jaheira_002
#. Speaker = Jaheira
#. NodeID = dad8cee5-ed38-405b-8fb3-f8eeb4ff439b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Checkpoint_AD_Combat_Jaheira_002:dad8cee5-ed38-405b-8fb3-f8eeb4ff439b
msgctxt "h7f3f9214g1a3cg4c7cg80acga8464f694eb1"
msgid "You'll make excellent fertiliser."
msgstr "넌 훌륭한 비료가 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 012a89f5-60f1-6ac8-35d6-e222e44822a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:012a89f5-60f1-6ac8-35d6-e222e44822a9
msgctxt "h3ac61886gf3dbg4d6cgbbe3g70640bfddf1c"
msgid "I can't help you. But I've done a great deal for you already."
msgstr "이미 당신에게 많은 걸 해줬어, 더 이상은 못 도와줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 013e8fde-6c21-5a39-ed6d-15836d8ceacc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_CursedFist_Knows_HalsinNotAvailable(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:013e8fde-6c21-5a39-ed6d-15836d8ceacc
msgctxt "hc3c989aagb2dfg443fg86fdg57435a6c18a5"
msgid ""
"What?! But... Thaniel said he could save him. He knew the way. <i>Only </"
"i>he knew the way."
msgstr ""
"뭐?! 하지만... 테니엘은 자신을 구할 수 있는 건 할신이라고 했어. 그가 방법을 알고 있어. <i>할신만이</i> 방법을 알고 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 028b70e0-3a9b-f34a-8e9c-d5d3aa77b7ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:028b70e0-3a9b-f34a-8e9c-d5d3aa77b7ac
msgctxt "h08539071g4f6fg45dbg8845g0b4e6b3d9f71"
msgid ""
"Oh, thank the gods. Maybe I'll even get to see him again, once we're both "
"well."
msgstr "신이시여, 감사합니다. 우리 둘 다 괜찮아진다면 다시 볼 수 있을지도 모르겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 03706365-d6d9-87fc-839c-2dde8224d33c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:03706365-d6d9-87fc-839c-2dde8224d33c
msgctxt "h10d69525g338bg4974ga6f6gfe73bfa5399b"
msgid ""
"We found a letter in his pocket. - I can't seem to find it now, but  he "
"doesn't seem to have any reaction to it anyway. Held onto it for a hundred "
"years, though."
msgstr ""
"그의 주머니에서 편지를 찾았는데, 어디 갔는지 모르겠네요. 어쨌든 편지에 반응을 보이진 않았어요. 그래도 백 년은 꼭 쥐고 있었던 것 "
"같았어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 06e885ca-6506-38c2-7306-bf1d2e62a1be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_CursedFistNotAlone = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:06e885ca-6506-38c2-7306-bf1d2e62a1be
msgctxt "ha85a334dg5a7cg4de5gbcebg299b304d8eda"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 073eabb8-c501-2a18-41fb-8c9a806d5b6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:073eabb8-c501-2a18-41fb-8c9a806d5b6b
msgctxt "hc739d2e1gdce9g46d3ga995g1053aebb774c"
msgid "Do you hear that, sir? You're safe."
msgstr "들리시나요? 이제 안전해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 084504ea-342e-09e6-c3e7-c2a6649a14d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:084504ea-342e-09e6-c3e7-c2a6649a14d0
msgctxt "h1080605ag1cf4g422dga297g983f2dda6184"
msgid "No - not until I met Art, anyway. It seems to be all he remembers."
msgstr "아뇨 - 적어도 아트를 만나기 전까지는요. 그가 기억하는 전부인 것 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 08aa3381-7143-43b8-8251-eea7aca42190
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_MindHasBeenRead = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:08aa3381-7143-43b8-8251-eea7aca42190
msgctxt "h7c9b2574g90fag42f3gaf45g77effa7a4be8"
msgid "<i>Repeat what you heard in his mind: 'Thaniel'.</i>"
msgstr "<i>'테니엘', 그의 정신 속에서 들은 말을 다시 되뇌어 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = 094c93e8-553e-0577-0a30-4d907667ee21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinAvailableForFist = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:094c93e8-553e-0577-0a30-4d907667ee21
msgctxt "he05342aag7f30g4c9dgbdc6ga5a70c1a621d"
msgid ""
"Calm. <i>Breathe</i>. You've been trapped in the Shadowfell for a century - "
"take a moment to clear your mind."
msgstr "진정하시고, <i>심호흡하세요</i>. 당신은 섀도펠에 한 세기 동안이나 갇혀 있었습니다. 잠시 마음을 정리해 보시죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 0a1e87fe-a7cf-71eb-0630-d391dccfe6f9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Knows_WasInCurse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:0a1e87fe-a7cf-71eb-0630-d391dccfe6f9
msgctxt "he54ef965g5f9eg48abg8d17gec4dc2f8c635"
msgid "<i>Thaniel... Thaniel...</i>"
msgstr "<i>테니엘... 테니엘...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 0d1ab38b-a922-4ba0-4a1e-850747fefdca
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Knows_WasInCurse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:0d1ab38b-a922-4ba0-4a1e-850747fefdca
msgctxt "he20da88dge342g4fcdgb190g7cca95ff2aad"
msgid "A century locked inside a Sharran curse will do things to a man."
msgstr "샤의 저주에 한 세기 동안 갇혀 있으면 이렇게 되고 말죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 0d6697dc-e6f2-9ac7-f19f-7593e3913c47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_AncientFist_HasMet(1) = False
#.   Global:
#.      - SCL_AncientFist_State_KnowsLuteImportant = True
#.   Object:
#.      - SCL_AncientFist_ItemCollected(1) = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_State_HasWokenUpFist = True
#.     - SCL_AncientFist_ItemReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:0d6697dc-e6f2-9ac7-f19f-7593e3913c47
msgctxt "hc791a357ga7edg4d74g9318ged703c05e6a3"
msgid "<i>Pull out the old lute and play it.</i>"
msgstr "<i>오래된 류트를 꺼내 연주한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = 0f21c279-9555-d629-a75b-0ff694cde63e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:0f21c279-9555-d629-a75b-0ff694cde63e
msgctxt "h9616eed7g7adeg4971gae96g459f564e2ca8"
msgid ""
"*His soul wandering in a dark space. He isn't just lost, but he has <i>lost</"
"i>... An object. Something dear to him. The vision fades.*"
msgstr ""
"*이 자의 영혼은 어둠 속을 헤매고 있습니다. 그냥 길을 잃은 게 아니라 소중히 여기던 무언가를 <i>잃어버렸습니다.</i> 환영이 "
"서서히 흐려집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 11405258-0bb9-3a6d-8a9d-6d68581b4990
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = True
#. SetFlags:
#.   Dialog:
#.     - HAV_CursetFist_State_CurseLifted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:11405258-0bb9-3a6d-8a9d-6d68581b4990
msgctxt "hadbbfee6gfdb9g49deg8311g4d60cd42aa9d"
msgid "Any word on Thaniel? Is he all right? Is he safe?"
msgstr "테니엘은 어떤가요? 괜찮은가요? 안전하겠죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 1269fd01-80e5-5513-082b-2d4936f5d152
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:1269fd01-80e5-5513-082b-2d4936f5d152
msgctxt "ha33174dfg1fdag45b6ga5e7gc304fd574fe3"
msgid "Do you know him?"
msgstr "그 사람이 누군지 알고 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Karlach
#. NodeID = 12705697-7d1f-4622-a057-6102f69b3215
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_KARLACH(9) = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:12705697-7d1f-4622-a057-6102f69b3215
msgctxt "hec7f389agf627g4f19g8492g3312ee83ff9f"
msgid ""
"That name rings a bell. Halsin mentioned a Thaniel, right? Part of his "
"'spirit of the land' mission."
msgstr "저 이름 들어본 적 있어. 할신도 테니엘이라는 이름을 언급했었지? '대지의 정령' 임무에 대해 얘기하면서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 12a0864c-1c6b-8067-8e5e-b87b66d6f67a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:12a0864c-1c6b-8067-8e5e-b87b66d6f67a
msgctxt "h50f542c8geea6g4546ga1ccgcfd58e1a9355"
msgid "I hope you're wrong."
msgstr "당신이 틀렸다면 좋겠네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 12f24d1c-5d91-5742-a9e1-f33d41ac61bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:12f24d1c-5d91-5742-a9e1-f33d41ac61bb
msgctxt "h75c8d869ge770g4504g84b3g4728c38e9de8"
msgid ""
"He's an expert on the curse. He was here when it all began, Thaniel said."
msgstr "저주에 대해 일가견이 있는 사람이라고, 테니엘 그러더군요. 예전에 이 모든 일이 일어났을 때, 여기에 있었다고도 하고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 13f4b046-c32e-8004-e92f-40a9804ff11d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:13f4b046-c32e-8004-e92f-40a9804ff11d
msgctxt "h994b1056g5da4g4467g84dfgdefe081ce4af"
msgid ""
"I've been lost in the shadows so long. And I met a boy there too - Thaniel. "
"He's the only reason my mind survived that emptiness, that... loss."
msgstr ""
"난 어둠 속을 너무나 오래 헤매고 있었어. 그러다 한 소년을 만났지. 테니엘. 그 아이 덕에 공허와... 상실감 속에서 제정신을 유지할 "
"수 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 15285651-aed3-93d3-fafa-725fb5af661f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_CursetFist_State_CurseLifted(1) = True
#.   Global:
#.      - GLO_LiftingTheCurse_State_BreathHasBeenRestored = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:15285651-aed3-93d3-fafa-725fb5af661f
msgctxt "hf57bb6b7g514fg4978gacabg6761a8f2ad92"
msgid "Thank you again, but I need to rest. The curse has left me weak."
msgstr "다시 한번 감사드립니다. 그런데 조금 쉬어야겠어요. 저주 때문에 많이 약해졌어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 17f7726d-ba13-7399-91e0-c8fd7c08b588
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = False
#.      - GLO_LiftingTheCurse_State_HalsinIsInAct2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:17f7726d-ba13-7399-91e0-c8fd7c08b588
msgctxt "h5222380fgebb2g4ca5g8aa0gbd6b9000b6d3"
msgid "I know Halsin. I can bring him soon."
msgstr "알아. 금방 데려올게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Lae'zel
#. NodeID = 19c402ef-c0ee-4000-b628-f5c0fac4e9cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_LAEZEL(7) = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:19c402ef-c0ee-4000-b628-f5c0fac4e9cb
msgctxt "h6b4e545dg2447g4acdga19fg5364b974f3b1"
msgid "'Thaniel', he said. Halsin's young target, yes?"
msgstr "'테니엘'이라고했어. 할신의 어린 사냥감 이잖아. 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 1cdb72bc-b72a-8da7-5ac9-e35050b6763a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHAR(1) = True
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:1cdb72bc-b72a-8da7-5ac9-e35050b6763a
msgctxt "ha19e2e57g7f6dg4d9cga3dbgca7ef8656c99"
msgid ""
"You - Art Cullagh. Note the light of the lamps. The colour of my face. You "
"are not in the Shadowfell anymore."
msgstr "아트 컬라흐. 등불빛을 보고, 내 낯빛을 보아라. 그대는 더이상 섀도펠이 있지 않으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = 1cdeab43-9c40-5df1-6234-94f61c6e57e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:1cdeab43-9c40-5df1-6234-94f61c6e57e3
msgctxt "h203c0d77g2fa6g4cc0g92ccgfc7c453cc3ef"
msgid "*You can't determine the nature of his ailment.*"
msgstr "*그가 가진 병이 어떤 것인지 파악할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 1e287c06-c717-0344-19cb-9f0c2907c001
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_CursedFist_NightsongFreedHasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.      - SCL_AncientFist_ItemReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:1e287c06-c717-0344-19cb-9f0c2907c001
msgctxt "h8e15a015g45bbg4827ga212g04a7b991f9b5"
msgid "It's almost over. Do you feel it? The nightmare is almost over."
msgstr "거의 끝났어. 느껴져? 악몽이 거의 끝나가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 1e4325ae-9923-7f33-55cc-eaee57414375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:1e4325ae-9923-7f33-55cc-eaee57414375
msgctxt "h6498797cgd7ddg4dd7gaf73ge4098ac50539"
msgid ""
"<i>Mm, mm, Thaniel and me are... \n"
"Climb, climb, climbing up a tree...</i>"
msgstr ""
"<i>음, 음, 테니엘하고 나랑... \n"
"올라, 올라, 나무를 올라가...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = 1f7e4dea-303f-ee81-6b04-294ec61bb506
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_CursedFist_Event_HalsinReactsToThanielMention(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:1f7e4dea-303f-ee81-6b04-294ec61bb506
msgctxt "hd6a461dcgaf53g4f32gaaf3gc1175eff66ae"
msgid ""
"He keeps saying Thaniel's name - he must know more. We need to rouse him."
msgstr "계속해서 테니엘의 이름을 부르고 있군. 분명히 더 아는 게 있네. 아트를 깨워야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 20dbb8b6-5ef5-d86e-8050-fec21a064fbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCL_AncientFist_HasWrit(2) = True
#. SetFlags:
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_Letter = True
#.   Object:
#.     - SCL_AncientFist_WritHandOver(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:20dbb8b6-5ef5-d86e-8050-fec21a064fbb
msgctxt "h52fc3182gb801g4f4fg8281g6a2dbdd390a2"
msgid ""
"Wait - take this letter. It was in his pocket. He doesn't seem to have any "
"reaction to it now, but it might help."
msgstr "잠깐만요 - 이 편지를 받으세요. 그의 주머니에 있었어요. 지금은 편지에 반응을 보이진 않지만, 도움이 될지도요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 21fe1ed3-b0bd-e5c5-ef30-cc36bdfa057b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:21fe1ed3-b0bd-e5c5-ef30-cc36bdfa057b
msgctxt "h35f6a5fegb624g4909ga652g4101b0fba017"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 2249654a-5016-20eb-f487-209c441ee086
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:2249654a-5016-20eb-f487-209c441ee086
msgctxt "h90add007gadb2g4947gb283gde335ee97dac"
msgid ""
"He saved me, and all I can do is sit here while he suffers, alone and "
"afraid. I'm useless. <i>Useless.</i>"
msgstr ""
"테니엘이 나를 구해줬어. 그런데 그 애가 혼자 고통받으며 두려워하는 동안 내가 할 수 있는 거라곤 여기 앉아있는 것뿐이군. 난 쓸모가 "
"없어. <i>쓸모없어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = 24c27483-4eed-c61b-ad61-ed44f9f02477
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:24c27483-4eed-c61b-ad61-ed44f9f02477
msgctxt "hdcec762cga036g422dg949fg4f7893a03684"
msgid ""
"*The patient is physically well, but psychologically detached, dissociated "
"from himself.*"
msgstr "*환자는 신체적으로는 건강하지만, 심리적으로는 자신과 분리되고 해리되어 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 24c8abd2-e759-7911-c311-c62cfb96b728
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Knows_WasInCurse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:24c8abd2-e759-7911-c311-c62cfb96b728
msgctxt "h0b0240a9g9855g4874g9619g73565a58739c"
msgid ""
"<i>Mm, mm, Thaniel and me are... \n"
"Climb, climb, climbing up a tree...</i>"
msgstr ""
"<i>음, 음, 테니엘하고 나랑... \n"
"올라, 올라, 나무를 올라가...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 2525c605-f098-4656-b0ce-9040861b0bba
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:2525c605-f098-4656-b0ce-9040861b0bba
msgctxt "h6b73afd7gb997g4817g97b4g2171388d01b1"
msgid "<i>Thaniel... Thaniel...</i>"
msgstr "<i>테니엘... 테니엘...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Wyll
#. NodeID = 25de147b-ad47-4fb7-9a84-99c99449302d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:25de147b-ad47-4fb7-9a84-99c99449302d
msgctxt "h771096b5g6da0g436cga523g100a767364b9"
msgid ""
"Thaniel? I know the name. Halsin spoke of him - something about the 'spirit "
"of the land'."
msgstr "테니엘? 익숙한 이름이군요. 할신이 말한 적 있는데... '대지의 정령' 이라고 했던가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 299d7a89-d311-be69-bd43-5424efeeadf7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:299d7a89-d311-be69-bd43-5424efeeadf7
msgctxt "h95258a51gcf58g460fg9be2g98b5d6036057"
msgid ""
"Something... <i>wrong</i>? He withstood the shadows for so long; whatever's "
"overcome him now must be something different... something worse."
msgstr ""
"뭔가... <i>문제</i>가 있다고요? 그 아이는 너무 오랫동안 그림자 저주를 견뎌냈어요, 테니엘을 굴복시킨 게 뭐든 간의 그건 무언가 "
"이질적이고... 더 나쁜 것이겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 299f06ad-43b4-c60d-5e51-034a26c2eafa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_AncientFist_HasMet(1) = True
#.   Global:
#.      - HAV_CursedFist_State_CursedFistNotAlone = False
#. SetFlags:
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_metartagain = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:299f06ad-43b4-c60d-5e51-034a26c2eafa
msgctxt "h271c8d19gd5fag4055ga4b2g080922742fec"
msgid ""
"<i>We are fearsome, black and red... \n"
"We are living, they are dead...</i>"
msgstr ""
"<i>우린 무시무시하다네, 까맣고 빨갛지...\n"
"우린 살아있고, 저들은 죽었다네...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = 2aeabf0d-268f-63e4-dd5d-c1d767138ccb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HalsinQuest_Halsin_Event_AcknowledgedNightsongFreed(1) = False
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HalsinQuest_Halsin_Event_AcknowledgedNightsongFreed(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:2aeabf0d-268f-63e4-dd5d-c1d767138ccb
msgctxt "he9bc1fc1g4f8dg4e1dgb9efga4af2b3b1145"
msgid ""
"I saw a winged aasimar fly overhead, and now an assault on Moonrise is "
"brewing - time is not on our side, I fear. We find Thaniel soon."
msgstr ""
"날개를 단 아시마르가 날아가는 것을 보았네. 문라이즈 공격이 임박했다는 뜻이겠지. 시간은 우리 편이 아닐세. 어서 테니엘을 찾아야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 2cdf7540-b6aa-868d-028c-077f7b35699b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_CursedFist_NightsongFreedHasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.      - SCL_AncientFist_ItemReturned = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:2cdf7540-b6aa-868d-028c-077f7b35699b
msgctxt "hbae99cebgdfc5g482ega12fg1b2465cddf87"
msgid ""
"<i>We see shadows, they get darker... \n"
"But our hiding place is brighter...</i>"
msgstr ""
"<i>그림자는 점점 더 어두워지네...\n"
"하지만 우리 은신처는 더 밝다네...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = 2d4b0364-16ae-a484-16b3-7da9f0cb9b6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:2d4b0364-16ae-a484-16b3-7da9f0cb9b6e
msgctxt "h82863463g4806g4d2fg80f5g6495b610c343"
msgid "I can work with that. Rest now."
msgstr "그 정도면 충분하네. 이제 좀 쉬게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 2e42257e-86f1-5e57-7af1-edd1ee299bd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:2e42257e-86f1-5e57-7af1-edd1ee299bd0
msgctxt "h82244476g1781g4487gb904g3fdb71135edc"
msgid "No. Thaniel is more than a boy, you see. He's the spirit of the land."
msgstr "없어. 테니엘은 단순한 아이가 아니야. 대지의 정령이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = 3061f6c9-586d-bd4d-0cce-4ff9de844c08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:3061f6c9-586d-bd4d-0cce-4ff9de844c08
msgctxt "h27a3f7bag6013g4035g99c5g922230aa4085"
msgid ""
"*The tether connecting this man to his soul is frail as frost. Too frail to "
"be of use to you.*"
msgstr "*이 남자와 그의 영혼을 연결하는 끈은 서리처럼 연약합니다. 당신이 이용하기에는 너무나 약한 상태입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 33bb016d-da66-57df-f763-91546ede80b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HalsinQuest_Halsin_Event_AskedForFistAdvice(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_HalsinQuest_Halsin_Event_AskedForFistAdvice(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:33bb016d-da66-57df-f763-91546ede80b0
msgctxt "h45c718a8g5becg4149g9f99g0329abe0afdd"
msgid "Any ideas?"
msgstr "좋은 생각이라도?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 3560b89c-5d39-9cc5-6e42-86722608ea75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_CursedFistNotAlone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:3560b89c-5d39-9cc5-6e42-86722608ea75
msgctxt "h66431389g03acg4f50gbb30g3b529147016c"
msgid "Flame Cullagh - do you know where you are?"
msgstr "플레임 컬라흐, 여기가 어딘지 알겠나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = 366a4402-1c93-9c2b-3be8-df28a65afdea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:366a4402-1c93-9c2b-3be8-df28a65afdea
msgctxt "ha131b7adgbbc9g4915ga4f5g0564f6ed6df1"
msgid "*You notice nothing that might indicate a prognosis.*"
msgstr "*당신은 예후가 될만한 것을 찾아내지 못했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 391ba565-6745-9f66-72c0-93102e231782
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:391ba565-6745-9f66-72c0-93102e231782
msgctxt "h06304c22g88ddg40cfgafe7geb8c82e0ae59"
msgid ""
"Wait - there's something else. We found a letter in his pocket. He doesn't "
"seem to have any reaction to it now, but it might help. I'd let you look at "
"it, except I must've misplaced it."
msgstr ""
"잠깐, 말해줄 게 있어요. 주머니에 편지가 하나 있었어요. 당장은 편지에 반응을 보이지 않지만, 도움이 될지도 몰라요. 그걸 보여주려 "
"했는데, 아무래도 잃어버린 것 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 3a8e88b8-0e0e-a559-409e-358b0069ab04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinAvailableForFist = False
#.      - HAV_CursedFist_State_CursedFistNotAlone = True
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:3a8e88b8-0e0e-a559-409e-358b0069ab04
msgctxt "hb6b85c8bg2809g4b41ga3fagda06cbcaa4c9"
msgid "Please, if you have any idea how to get through to him..."
msgstr "부탁이에요, 뭐가 됐든 그를 치료할 방법을 알고 계신다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 3ae861aa-664d-24b1-1e0a-134cbe56a3e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:3ae861aa-664d-24b1-1e0a-134cbe56a3e4
msgctxt "h6c7c8006g721bg4508g94c2g4a71ff7d3fd0"
msgid ""
"You killed a <i>Thorm?</i> They're Ketheric's elite, how did you - never "
"mind. <i>He </i>needs us, needs our help."
msgstr ""
"<i>쏨을</i> 죽였다고? 그들은 케서릭의 정예병인데 어떻게 - 아니, 됐어. <i>그는</i>는 우리를, 우리의 도움을 필요로 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 3b4c9fb0-872f-4661-84e2-aff696d98700
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_MindReadFailed = False
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:3b4c9fb0-872f-4661-84e2-aff696d98700
msgctxt "hdb69abc2g01a0g4771gae28gf6e9f6180f05"
msgid "<i>Probe his mind.</i>"
msgstr "<i>그의 정신을 탐색한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 3c8a2a30-6e49-8751-127a-375ab32fcd03
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_BardBranchChosen = False
#.   Tag:
#.      - BARD(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:3c8a2a30-6e49-8751-127a-375ab32fcd03
msgctxt "h307c533cg12a0g4d2fg9fd6g7312ef7891fa"
msgid "<i>Look closer at him. There may be something you missed.</i>"
msgstr "<i>좀 더 가까이서 들여다 본다. 뭔가 놓친 것이 있을지도 모른다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = 3d8f5f8c-3ed1-524f-baa7-c113093d7289
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:3d8f5f8c-3ed1-524f-baa7-c113093d7289
msgctxt "hf51b2120gca74g42d8gad0eg7adcfd3b7fab"
msgid "*You're not sure if you've heard it before.*"
msgstr "*들어본 적이 있는지 확실하지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = 40359485-2777-9a35-ea99-b29dfd60a028
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_SongIsOriginal = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:40359485-2777-9a35-ea99-b29dfd60a028
msgctxt "h9ff60f0ag0388g42bfgabc2gf1ac21a39605"
msgid "*It's from no songbook you know of - likely an original.*"
msgstr "*당신이 아는 노래책에는 없는 것입니다. 이 사람 고유의 노래인 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 4172c106-7346-ef2d-630f-a95afb2ea0c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:4172c106-7346-ef2d-630f-a95afb2ea0c3
msgctxt "h414131bcg592dg446cg9c18gbacb9e200285"
msgid ""
"And without the druid, Thaniel is trapped - and the curse can never be "
"lifted."
msgstr "그리고 그 드루이드가 없다면 테니엘을 풀어줄 수 없어. 저주도 절대 풀 수 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Gale
#. NodeID = 41da793c-b3a3-424b-ac85-7a6f7c4c38e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:41da793c-b3a3-424b-ac85-7a6f7c4c38e0
msgctxt "h6d5790e1ge2a9g4e4fgb2c0ge68b90992b1e"
msgid ""
"Music's a powerful source of memories. We might be able to bring him around "
"if we find what he used to play."
msgstr "음악은 기억의 강력한 근원이야. 이 사람이 연주했던 악기를 찾는다면 깨울 수 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 44b50d63-23ba-1970-426d-f8c7890705aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:44b50d63-23ba-1970-426d-f8c7890705aa
msgctxt "h79c2e55agd580g4bb0g93a1g5425fea38779"
msgid ""
"Really? Could you bring him here? You'd be glad of the help, wouldn't you, "
"sir?"
msgstr "정말인가요? 그를 데려와 줄 수 있나요? 도움이 된다면 당신도 기쁠 거예요. 그렇죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 463109d7-e8de-9c1d-0bdb-b8ef52f66bd1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_Event_HalsinClosesPortal = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:463109d7-e8de-9c1d-0bdb-b8ef52f66bd1
msgctxt "hcf955437gd0d6g4bbbg8238gea0c7696ae42"
msgid ""
"Halsin found Thaniel  in the Shadowfell, but there's something wrong with "
"him."
msgstr "할신이 섀도펠에서 테니엘을 찾아냈는데, 문제가 좀 있는 것 같더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 46832ad1-ff52-5da9-023b-43da126e0afd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:46832ad1-ff52-5da9-023b-43da126e0afd
msgctxt "h7fdfe2fag07d9g4009gaa96gfe0e962c8dc1"
msgid "Depends. Why do you want him?"
msgstr "그럴지도. 왜 묻는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 46d17da3-4190-a695-71b1-bb173b8912d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_CursedFistNotAlone = True
#.   Object:
#.      - SCL_AncientFist_WritHandOver(1) = False
#.      - SCL_AncientFist_ItemCollected(1) = False
#. SetFlags:
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_Letter = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:46d17da3-4190-a695-71b1-bb173b8912d2
msgctxt "hc1d0f605g8c41g415agb80cge378b7adfda2"
msgid "Did you already check for personal effects?"
msgstr "소지품은 이미 확인했나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 4a21b9b5-9dee-c1fb-1f39-99c6299c8e4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:4a21b9b5-9dee-c1fb-1f39-99c6299c8e4a
msgctxt "hca7356adg8722g4183g9f24g0fe704e65683"
msgid ""
"Without him, the curse won't lift. He said Halsin could help. Find Halsin - "
"please."
msgstr "그 사람 없이는 저주를 물리 칠 수 없어요. 테니엘이 그 사람이 필요하다고 했어요. 부디 할신을 데려 와주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = 4b670aa1-3533-da21-754c-878fc12e4484
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:4b670aa1-3533-da21-754c-878fc12e4484
msgctxt "h0de59507g47d9g4af6g84fdg2ad7bad47b45"
msgid "*He seems unaware of you or his surroundings.*"
msgstr "*당신을 비롯한 주변을 의식하지 못하는 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 4cc5b76e-fca7-6217-8de7-67dd8885379c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:4cc5b76e-fca7-6217-8de7-67dd8885379c
msgctxt "h1d514cffg5cb0g4861g807ag06b0136b9a5c"
msgid "I'll see what I can do."
msgstr "방법을 찾아보겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 4d793677-7d1c-a361-db6a-e1dc7aa3696d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:4d793677-7d1c-a361-db6a-e1dc7aa3696d
msgctxt "h0afe9150gd555g4513ga696gbe6b0c2331b4"
msgid "I'll see what I can discover."
msgstr "뭘 알아낼 수 있을지 볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 50a1d910-b22f-518b-4db9-51aa9162c121
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:50a1d910-b22f-518b-4db9-51aa9162c121
msgctxt "hbd3f9f00g8261g408bg8204gaf74ea784abf"
msgid ""
"If you'd seen the Shadowfell, seen what hides in that darkness, you'd have "
"been worried too."
msgstr "섀도펠과 그 어둠 속에 무엇이 있는지 보았다면 당신도 걱정을 멈추지 못했을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 50ca35d8-5c39-d372-03fe-b339fe4f49f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_metartagain = False
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:50ca35d8-5c39-d372-03fe-b339fe4f49f2
msgctxt "h645cbb2dgf4b4g447dgba9fg865b9d6f2e17"
msgid "<i>I know that name. Halsin is looking for Thaniel.</i>"
msgstr "<i>아는 이름이야. 할신이 테니엘을 찾고 있어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 51939db3-8e27-b909-7933-0276a8b6c1b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_CursedFist_NightsongFreedHasMet(1) = False
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.      - SCL_AncientFist_ItemReturned = False
#. SetFlags:
#.   Dialog:
#.     - HAV_CursedFist_NightsongFreedHasMet(1) = True
#.   Global:
#.     - SCL_AncientFist_Knows_WasInCurse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:51939db3-8e27-b909-7933-0276a8b6c1b3
msgctxt "heeb06288g15dbg4196g8c6agba5823be6e43"
msgid ""
"<i>Mm, mm, Thaniel and me... \n"
"Waiting for the sun forever...</i>"
msgstr ""
"<i>음, 음, 테니엘과 난...\n"
"영원히 태양을 기다리고 있어...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 53966bc9-f18e-93b6-7651-acfc39710fdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:53966bc9-f18e-93b6-7651-acfc39710fdd
msgctxt "h65056198g5d8cg4a61g8485gba8caa3d23d5"
msgid ""
"We found him out in the shadows, just...<i>wandering</i>. Nothing survives "
"out there for long. Don't know how he made it, or where he came from..."
msgstr ""
"저 밖의 그림자에서 그냥...<i>돌아다니는 걸</i> 찾았어요. 밖에선 아무것도 그렇게 오래 살아남을 수 없죠. 그가 어떻게 "
"살아있는지, 어디서 왔는지도 몰라요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 56d0f3e3-bbb6-aa46-7af5-46fe388405ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:56d0f3e3-bbb6-aa46-7af5-46fe388405ea
msgctxt "hcdd22cdcg39d9g4a85ga3f5g9ecc2096cc8b"
msgid "<i>Thaniel and me... Thaniel and me... Thaniel...</i>"
msgstr "<i>테니엘하고 나랑... 테니엘하고 나랑... 테니엘...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 57acf5d9-1172-d8d9-7357-357f2ea9d1cf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAV_CursedFist_LeftOnSecondQuestionBank(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:57acf5d9-1172-d8d9-7357-357f2ea9d1cf
msgctxt "h064f7cecgc622g4e18ga0degae25e78f353f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 584ff553-4f80-021d-8141-72ef76db8a4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:584ff553-4f80-021d-8141-72ef76db8a4c
msgctxt "h3da03821g58e2g4f12ga71fgaed684ff50a8"
msgid ""
"The pull of the darkness, the twisted creatures it manifests - you've seen "
"it, right? Felt it? We can end it. Find Thaniel - Halsin knows how."
msgstr ""
"어둠의 속삭임과 그것이 실체화하는 뒤틀린 크리쳐들 - 넌 보았지? 느꼈지? 우리가 끝낼 수 있어. 테니엘을 찾아, 할신이 방법을 알 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 58a018e4-3010-dca8-c8fc-cf0d4c01a04c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:58a018e4-3010-dca8-c8fc-cf0d4c01a04c
msgctxt "h88c74a20g007fg4ba2gba60gf851b2ce718f"
msgid "Thank you."
msgstr "고마워요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = 59197b96-ac90-af51-72dd-a234d8883f52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:59197b96-ac90-af51-72dd-a234d8883f52
msgctxt "h5ae133d8g6b2bg4b25g9181g824318a6f0f0"
msgid ""
"*The tether connecting this man to his soul is stretched taught. You follow "
"it, wading through inky shadows.*"
msgstr ""
"*이 남자와 그의 영혼을 연결하는 밧줄이 팽팽하게 당겨져 있습니다. 당신은 그 밧줄을 따라 먹물 같은 그림자를 헤치고 나아갑니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 59947407-cbe7-1a37-50d9-beefb7c05403
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_Event_SidedWithPrisoner = True
#.      - GLO_Halsin_State_PermaDefeated = False
#.      - GLO_LiftingTheCurse_State_HalsinIsInAct2 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:59947407-cbe7-1a37-50d9-beefb7c05403
msgctxt "h1ecc5e26g0515g450bga84dg13e383a9c4d7"
msgid "I'm afraid Halsin was left in a goblin camp - he can't come."
msgstr "유감이지만 할신은 고블린 야영지에 남겨졌어, 오지 못할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 5aada807-f9de-5b98-d41b-9a4a1bf1b098
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:5aada807-f9de-5b98-d41b-9a4a1bf1b098
msgctxt "h3daea1aagf317g4456g8633g61c538375e8b"
msgid "<i>Try to commune with the man's soul. </i>"
msgstr "<i>남자의 영혼과 소통을 시도해본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 5e545c64-469f-ae21-f95a-2d5f518cc7f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:5e545c64-469f-ae21-f95a-2d5f518cc7f9
msgctxt "hdd32145dg131eg45e1gb506g8590f7b9b6c2"
msgid "I've heard the name 'Thaniel' from a friend of mine - Halsin."
msgstr "제 친구 할신으로부터 '테니엘'이라는 이름을 들어본 것 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 5edf72a4-4821-2b50-0028-b275e7020926
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:5edf72a4-4821-2b50-0028-b275e7020926
msgctxt "h342d4126g563bg4a57gaa88ga95c2ffb4aa0"
msgid ""
"A century... you're Halsin. Thaniel said to find you. You must help him - "
"<i>please.</i>"
msgstr "한 세기라니... 당신이 할신이군요. 테니엘이 당신을 찾으라고 했어요. 반드시 그를 도와줘야 해요 - <i>부탁드려요.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 63dab720-78e0-192a-8e44-9f5c996f98b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_SongIsOriginal = False
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_BardBranchChosen = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:63dab720-78e0-192a-8e44-9f5c996f98b5
msgctxt "h0241a003g8991g4f8ega47ag7ab79e3cff8e"
msgid ""
"<i>He seems musically-inclined. Look him over for any related clues.</i>"
msgstr "<i>음악에 반응하는 듯하다. 관련된 단서가 있는지 살펴본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 655f1f8e-08b9-4a8b-8258-fbada5dd9fd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_Got Letter = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:655f1f8e-08b9-4a8b-8258-fbada5dd9fd5
msgctxt "hb9afc9bfg3bedg48d6g9359g50ec72562377"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Shadowheart
#. NodeID = 66a81c0c-0a9d-9634-ed82-565e192ce701
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_MedicineCheckAttempted = False
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Knows_WasInCurse = True
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_GotSHIncl = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:66a81c0c-0a9d-9634-ed82-565e192ce701
msgctxt "hbba741bag0d2bg4c5eg91ccg3bdf7359ddb6"
msgid ""
"His mind lingers in the Shadowfell, but perhaps it can be returned. We need "
"to remind him who he is - some personal effects, maybe."
msgstr ""
"저 사람의 정신은 섀도펠에 붙들려 있지만, 다시 돌아올 수 있을지도 몰라. 자신이 어떤 사람이었는지 일깨워줘야 해. 개인적인 물건 같은 "
"게 도움이 될 수도 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 67904feb-19df-464b-3074-54fec1eafa32
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_MedicineCheckAttempted = False
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_MedicineCheckAttempted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:67904feb-19df-464b-3074-54fec1eafa32
msgctxt "h2eebf1b4gc362g4a95ga7d0g19618756493e"
msgid "<i>Observe his present condition.</i>"
msgstr "<i>그의 상태를 관찰합니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 6a760dab-e959-86b0-b4ef-8caa5e389719
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAV_CursedFist_LeftOnSecondQuestionBank(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:6a760dab-e959-86b0-b4ef-8caa5e389719
msgctxt "h076d0febgb3f0g4461ga5cfg558c9871a86e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = 6b8339cd-abf3-15ca-ca75-33bf964f0e0e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LiftingTheCurse_State_HalsinGoToLake = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:6b8339cd-abf3-15ca-ca75-33bf964f0e0e
msgctxt "h03f8a113gd436g4e6dgb215gb34867b3eaeb"
msgid ""
"Meet me by the lakeshore. I have what we need to proceed, but I'll need your "
"help. Be ready, this may prove... perilous."
msgstr "호숫가에서 만나세. 다른 준비는 끝났지만, 당신 도움이 필요하네. 단단히 준비하게나... 위험할 수도 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 6d39527d-698a-d1d4-acc0-85e97361eb61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:6d39527d-698a-d1d4-acc0-85e97361eb61
msgctxt "hddccf317g9125g4655g82e5g95f66d9e27d1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 6e4f9e01-cc57-37d4-287e-5bf37b095c57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:6e4f9e01-cc57-37d4-287e-5bf37b095c57
msgctxt "h44ae9fc0gb2b2g4e0dg8412ga80d83ac9925"
msgid ""
"You hear me, don't you, sir? You might not be able to answer, but you hear "
"me."
msgstr "내 말 들리죠? 대답은 할 수 없지만 내 말이 들릴 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 6edbc7b8-ad8d-bd14-3f32-c9e32584dab9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_State_KnowsLuteImportant = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:6edbc7b8-ad8d-bd14-3f32-c9e32584dab9
msgctxt "hf43e837ag52f4g4c64gb205gb5ec65f25706"
msgid "<i>Lute...</i>"
msgstr "<i>류트...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 6efc814c-439d-5f33-6acf-10cb1f3cd594
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_MedicineCheckAttempted = False
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_MedicineCheckAttempted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:6efc814c-439d-5f33-6acf-10cb1f3cd594
msgctxt "hd4a3a8cdg1665g4edcga64ag05d3e909f813"
msgid "<i>Observe his present condition.</i>"
msgstr "<i>그의 상태를 관찰한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = 6f64d7c5-fd56-9ef7-1380-d507b4f7b61f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_State_KnowsLuteImportant = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:6f64d7c5-fd56-9ef7-1380-d507b4f7b61f
msgctxt "h7b0910c8g6778g45b5gaf61g04dccb1f98e0"
msgid "Good - its music might help restore him. Show it to him."
msgstr "좋습니다. 류트 연주가 회복을 도울지도 모릅니다. 연주를 들려주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = 7115e5f2-5b66-781a-acff-40fd725d44ff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_State_KnowsLuteImportant = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:7115e5f2-5b66-781a-acff-40fd725d44ff
msgctxt "h36a50222geaffg488eg84cfgbda4ed427c9f"
msgid ""
"*You consider the cadence of his singing - an instrument would make this "
"song whole.*"
msgstr "*그가 부르는 노래의 운율을 고려하면, 어떤 악기가 있다면 이 노래를 완전하게 만들어 줄 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 71a4401b-630f-0a5e-1f2a-9f89d96d16c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_State_HasWokenUpFist = False
#.   Object:
#.      - SCL_AncientFist_ItemCollected(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:71a4401b-630f-0a5e-1f2a-9f89d96d16c9
msgctxt "h727445b8g6a1bg4867g87e2g67d2d80778b1"
msgid "I found a lute. It seems to have belonged to the Flaming Fist."
msgstr "어떤 류트를 찾았어요. 이 플레이밍 피스트 단원의 물건이었던 것 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Shadowheart
#. NodeID = 71a7eeb3-db78-43dd-be6d-ee0af6283f91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:71a7eeb3-db78-43dd-be6d-ee0af6283f91
msgctxt "h79cb2654gbe2ag4fc1gb918gec5c2335ef79"
msgid ""
"Thaniel? We've heard that name before - from Halsin. That's who he's looking "
"for."
msgstr "테니엘? 할신한테 들었던 이름인데, 할신이 찾는 사람이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 74b4095f-65db-7164-c8c6-b0acd0ff31e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:74b4095f-65db-7164-c8c6-b0acd0ff31e9
msgctxt "h846d8ea4g3864g456cg9ceagf9a231b50663"
msgid "I might be all right, but Thaniel isn't. Not by a long shot."
msgstr "난 괜찮은데 테니엘은 그렇지 않아요. 오래 버티지 못할 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 75eada70-c422-64db-4074-2f7dd7127ef5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:75eada70-c422-64db-4074-2f7dd7127ef5
msgctxt "h1f209916ge313g4009gbf6dgf906704ed8f0"
msgid "You think you're mad? You think YOU'RE MAD?"
msgstr "네가 미쳤다고 생각하나? 정말 <b>미쳤다고 생각해?</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 771fe5f0-57d3-387f-673e-178b94418e15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_AncientFist_HasMet(1) = False
#.   Global:
#.      - HAV_CursedFist_State_CursedFistNotAlone = True
#. SetFlags:
#.   Dialog:
#.     - SCL_AncientFist_HasMet(1) = True
#.   Global:
#.     - SCL_AncientFist_Knows_WasInCurse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:771fe5f0-57d3-387f-673e-178b94418e15
msgctxt "hb5bdbd6dg5373g450bg95b1gab318fde1782"
msgid ""
"Flame Cullagh - that's your name, isn't it? Art Cullagh? I'm Fist J'ehlar."
msgstr "플레임 컬라흐 - 당신 이름, 맞죠? 아트 컬라흐? 난 피스트 제라예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = 78670a7c-ff02-9313-5a6a-4c7cde56246a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:78670a7c-ff02-9313-5a6a-4c7cde56246a
msgctxt "h551c7506ga329g4c83g8054ge95a5f01e021"
msgid ""
"We need to wake him. He must know something about where to find Thaniel."
msgstr "이 자를 깨워야 하네. 테니엘을 어디서 찾아야 하는지 아는 바가 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 78671b3c-d06d-8011-ff78-2f7854383867
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAV_CursedFist_LeftOnFirstQuestionBank(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:78671b3c-d06d-8011-ff78-2f7854383867
msgctxt "hb62fc61eg63c0g46fcg8f2egf2bb1f5d2bdd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = 79c75ea5-4e34-b3fe-0919-1d257c068e5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:79c75ea5-4e34-b3fe-0919-1d257c068e5d
msgctxt "hf545d74ag3d82g4862ga3cbgcd5a7d8a91c1"
msgid ""
"If he was able to escape the Shadowfell, then it mustn't have managed to "
"consume his spirit - not all of it, anyway."
msgstr "컬라흐가 섀도펠을 탈출할 수 있었다는 건 결국 그의 영혼이 완전히 잠식되지는 않았다는 얘기겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 7d840f27-ffb2-9e0b-5576-8f14b2801fc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:7d840f27-ffb2-9e0b-5576-8f14b2801fc4
msgctxt "h0ad82591g19a1g446cg9616g4f2c1f925b1d"
msgid "What's wrong with him?"
msgstr "무슨 문제야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 7dc143a7-bae2-2078-7313-9f2312b56931
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:7dc143a7-bae2-2078-7313-9f2312b56931
msgctxt "h500050d2g0052g4cadg8e5bg78a67c609669"
msgid ""
"He's been wandering the Shadowfell for too long. His mind will be there "
"still."
msgstr "섀도펠을 너무 오랫동안 떠돌았어, 이 자의 정신은 아직도 거기 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 7dc7477c-493c-716c-bad2-a43e551f5476
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCL_AncientFist_HasWrit(2) = True
#. SetFlags:
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_Letter = True
#.   Object:
#.     - SCL_AncientFist_WritHandOver(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:7dc7477c-493c-716c-bad2-a43e551f5476
msgctxt "h9c1ab655ga8e5g4e70gbca0g3a499faec98b"
msgid ""
"This was in his pocket. He doesn't seem to have any reaction to it now, but "
"he held on to it for a hundred years, anyway."
msgstr "그의 주머니에 있었어요. 지금은 편지에 반응을 보이진 않지만, 그래도 백 년간 들고 있었으니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Shadowheart
#. NodeID = 7e996fc6-88c2-592d-3d9c-d144187942fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:7e996fc6-88c2-592d-3d9c-d144187942fb
msgctxt "h6b2f8f14gbc19g4fabg908aga4b3dded4d46"
msgid ""
"Poor fool. He resisted the Shadowfell - and suffered all the more for it."
msgstr "가엾은 바보 같으니, 섀도펠에 저항한 탓에 더 크게 고통 받는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = 7ec16b93-276b-85f6-5aa9-297e8bce0c19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:7ec16b93-276b-85f6-5aa9-297e8bce0c19
msgctxt "h878919bdg2915g4305gbb37g2ba616ff42b7"
msgid ""
"See what you can learn from it. It might reveal something about his actions "
"before the curse - then we may find means to wake him."
msgstr "내용을 확인해 보게. 저주에 걸리기 전 컬라흐가 뭘 했는지 알 수 있을 거야 - 그러면 그를 깨울 방법을 찾을 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 7f6df4a2-029c-332b-7faa-2d4191a1ee59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:7f6df4a2-029c-332b-7faa-2d4191a1ee59
msgctxt "h0f7a0871gce96g486eg9cc9g2ee751af8108"
msgid "Isn't there anything else we can do?"
msgstr "우리가 도와줄 다른 건 없을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 7fdd7c48-ceae-6267-d8f2-bf3f362c04a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_SongIsOriginal = True
#. TagRule: BARD
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:7fdd7c48-ceae-6267-d8f2-bf3f362c04a1
msgctxt "hca84733cg28cdg4035g8737g99a52dc06e84"
msgid "I've never heard that tune. Might be an original composition."
msgstr "저런 노래는 처음 들어봐. 자작곡인 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 80e1c8c8-35e9-43bb-c93b-3762230ebec0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_CursedFist_State_PlayerToldArtThanielOk(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:80e1c8c8-35e9-43bb-c93b-3762230ebec0
msgctxt "hf5d7712fgd96ag4a30ga760gc65535708fa6"
msgid ""
"Now that Thaniel's all right, Halsin can banish the curse from this place. "
"Thaniel spoke it - and now it's coming true."
msgstr "테니엘이 무사하니 할신이 이 땅에서 저주를 쫓아낼 수 있겠죠. 그 아이가 말한 대로 됐네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 8108481d-efc8-506d-3a36-cb7db05cbb54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:8108481d-efc8-506d-3a36-cb7db05cbb54
msgctxt "ha961f557g0313g4ce7gbc1fgffaa00728170"
msgid "I had to slay a monster or two."
msgstr "괴물 한둘을 죽여야 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 8145f728-cf73-6eb8-f363-86e8df4adce9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - HAV_LiftingTheCurse_State_ToldHalsinIsDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:8145f728-cf73-6eb8-f363-86e8df4adce9
msgctxt "hf430d5a1gd892g4be8g808dg855aa6177e60"
msgid "I'm afraid Halsin is dead."
msgstr "유감이지만 할신은 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = 82bea469-fee3-0a24-9b79-00a822e79cc9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HalsinQuest_Halsin_Event_AcknowledgedNightsongFreed(1) = False
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HalsinQuest_Halsin_Event_AcknowledgedNightsongFreed(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:82bea469-fee3-0a24-9b79-00a822e79cc9
msgctxt "hbba9d956g4741g4418g94bbga5afaa1cb5be"
msgid ""
"We need to wake him and learn what he knows - change is afoot ever since "
"that winged aasimar tore through the skies above us."
msgstr ""
"이 자를 깨워서 정보를 알아내야 하네. 날개 달린 아시마르가 하늘을 찢으며 우리 위를 지나간 이래로 상황이 시시각각 변하고 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 8764053a-c92c-b85b-3ac3-2578c9168b7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_HalsinIsInAct2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:8764053a-c92c-b85b-3ac3-2578c9168b7d
msgctxt "h717ca9f1gf43bg420eg8745gca32fb4adb74"
msgid "I'm on it."
msgstr "찾고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 876c4b43-0ec4-556a-0236-007eb39b2370
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_SongIsOriginal = True
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_BardBranchChosen = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:876c4b43-0ec4-556a-0236-007eb39b2370
msgctxt "hc35126b1g4dfeg4fb5g8493g3193b9f41f34"
msgid "<i>Search his body for any indication of a preferred instrument.</i>"
msgstr "<i>이 자의 몸을 조사하여 자주 사용했을 악기의 단서를 찾아본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 87775fe2-680e-b62b-1702-7cce65e16bfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:87775fe2-680e-b62b-1702-7cce65e16bfb
msgctxt "h1b3da646gbfa7g492dgb082g9ad4d31bbf82"
msgid "There must be another way to lift the curse."
msgstr "저주를 풀 다른 방법이 있을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 88d26577-6c96-1a2e-0aee-58c0fae83c72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:88d26577-6c96-1a2e-0aee-58c0fae83c72
msgctxt "h35969021g5ea8g4d77g9beeg227f22c1b417"
msgid "Maybe he was a musician."
msgstr "어쩌면 음악가였는지도 몰라요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 897360f8-8e23-66d2-ad77-6406476b78e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:897360f8-8e23-66d2-ad77-6406476b78e5
msgctxt "hb7398b56g0006g456dgb43fg589d70b88960"
msgid ""
"I'll bring Halsin - he told me about Thaniel, about the spirit of the land."
msgstr "할신을 데려오지. 그가 대지의 정령, 테니엘에 대해 이야기 해줬거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 8a02944e-afaa-456d-8ef0-21e710a5f2d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:8a02944e-afaa-456d-8ef0-21e710a5f2d0
msgctxt "h2a4f636bg60d6g439fg9edbgf1ef48657f55"
msgid ""
"He told me about someone he knew. Someone called 'Halsin' -  a druid. "
"Thaniel spoke of little else."
msgstr "그 아이는 이전에 알고 지내던 할신이라는 드루이드에 대해 말해줬어요. 다른 말은 별로 하지 않았죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = 8a1b2e0a-cf2b-d0e1-959b-4d4c2cfd9377
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_State_KnowsLuteImportant = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:8a1b2e0a-cf2b-d0e1-959b-4d4c2cfd9377
msgctxt "hb530c310g7b86g4e60gbd7fge37a533b90d0"
msgid ""
"We need to unlock whatever's left of him, inside his head. There must be "
"something to trigger him - a word, a memory, an item. We just need to find "
"it."
msgstr ""
"뭐가 됐건 이 남자의 머릿속에 든 걸 알아내야 하네. 그를 깨울 수 있는 무언가가 분명 있을거야. 단어, 기억, 혹은 물건일 수도 "
"있겠지. 그걸 찾기만 하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 8ad4e7cb-82a5-f692-bded-a3a724342030
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:8ad4e7cb-82a5-f692-bded-a3a724342030
msgctxt "h753e015fgee7bg46d0gbc3bg5cf40960367f"
msgid ""
"If you can take on monsters, you can help <i>him </i>- you must, please."
msgstr "괴물을 처리할 수 있다면, <i>그 아이</i>도 구할 수 있어. 제발 부탁이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 8b8b80d4-2758-4f81-e009-48e6300a6b73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:8b8b80d4-2758-4f81-e009-48e6300a6b73
msgctxt "h4318a687gedb8g4ac6g915bga1c7c85acd36"
msgid ""
"No idea, I'm afraid. Whoever it is, must be someone important to him. He's "
"been saying the same thing over and over, ever since we found him..."
msgstr ""
"죄송하지만, 잘 모르겠어요. 하지만 이 사람에게 중요한 사람인 건 확실해요. 구조 이후로 계속 그 이름을 반복하고 있는 것을 보면요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 8c3336c0-3629-eb35-b040-a6c21e15d4ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_CursedFistNotAlone = True
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_Letter = False
#.   Object:
#.      - SCL_AncientFist_WritHandOver(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:8c3336c0-3629-eb35-b040-a6c21e15d4ce
msgctxt "hab331ad0gedbfg4aa1g8611g8bb6df4bc072"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 8f7980de-3093-f481-a95d-2665bf45ec37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:8f7980de-3093-f481-a95d-2665bf45ec37
msgctxt "hc57b6ca7g2003g43d4gaed4g949cbbfde99d"
msgid ""
"<i>Imagine yourself in this half-life. Incapacitated, rambling, gone.</i>"
msgstr "<i>이 자처럼 반쪽짜리 생명체가 된 자신을 상상합니다. 움직이지 못한 채 횡설수설하고 영혼이 빠져나간 모습입니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 8f826933-9976-0283-39c3-b5409bbc8f70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:8f826933-9976-0283-39c3-b5409bbc8f70
msgctxt "h4ad6d184g9286g4524g8d80g3994427606b4"
msgid "That name he mentioned - 'Thaniel'. Who is that?"
msgstr "그가 말하는 '테니엘'이 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 909c3bcc-135d-dbbc-b658-8493ff804a09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:909c3bcc-135d-dbbc-b658-8493ff804a09
msgctxt "hf8358ab3g4399g4210g8093gac13b709cb42"
msgid "Don't worry about that now. I'm glad to see you well."
msgstr "그건 지금 걱정하지 마. 네가 괜찮아서 기쁘네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = 919adbb4-d586-58fa-906f-cefa0e99cc77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:919adbb4-d586-58fa-906f-cefa0e99cc77
msgctxt "h6992c02cg1a89g478dg8f9agf30038a0c32f"
msgid ""
"We... we need you, sir. One of our own's been taken - a Grand Duke. You "
"might know something that could help us bring him back."
msgstr ""
"우린... 우린 당신이 필요해요. 일원이 잡혀갔답니다. 대공님이시죠. 당신이 그 분을 데려올 수 있도록 우릴 도와줄 무언가를 알고 "
"있을지도 몰라요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 91e8ed9e-1309-d533-7f63-92cd93e12794
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:91e8ed9e-1309-d533-7f63-92cd93e12794
msgctxt "h5c2b3419gf9eag4a13gb272gca0d59fc7b46"
msgid "<i>Let Halsin handle this.</i>"
msgstr "<i>할신에게 맡겨둔다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 931b3e01-94c0-28a9-9ac5-069f06b87c47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - HAV_LiftingTheCurse_State_ToldHalsinIsDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:931b3e01-94c0-28a9-9ac5-069f06b87c47
msgctxt "h5a5d6e0fg075ag471dgbb0ag133152552151"
msgid "I'm afraid Halsin is dead."
msgstr "유감이지만 할신은 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 94ce6f85-8104-e540-0146-e063442cee8b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:94ce6f85-8104-e540-0146-e063442cee8b
msgctxt "h3d94e961gd5c6g4783ga741g36ad6d3f5aa8"
msgid "He is damaged beyond repair. Better to put him out of his misery."
msgstr "회복할 수 없는 상처야. 고통에서 해방시켜주는 게 좋을 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = 98259ea9-67da-984c-303e-fdeb3703f795
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_CursedFistNotAlone = True
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_BardBranchChosen = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:98259ea9-67da-984c-303e-fdeb3703f795
msgctxt "ha3551bd9g6871g4953gb7f3g00720fcfe57b"
msgid "That song - have you heard it before?"
msgstr "저 노래 - 전에 들어본 적이 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = 9e184a30-0317-e20e-12dd-475ab7c86f1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_CursedFist_ThanielBeingSaved_HasMet(1) = False
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinLiftingCurse = True
#.      - SCL_AncientFist_State_HasWokenUpFist = True
#. SetFlags:
#.   Dialog:
#.     - HAV_CursedFist_ThanielBeingSaved_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:9e184a30-0317-e20e-12dd-475ab7c86f1f
msgctxt "h26075a6eg43c8g40d9gaff1ge8be09469181"
msgid ""
"Thaniel will be so scared there alone. We looked after each other for such a "
"long time. I hope he's all right..."
msgstr ""
"섀도펠에 있을 때 테니엘과 저는 서로를 오래도록 돌봐줬었죠, 지금은 그 아이 혼자 무서워 하고 있을 거예요. 무사하면 좋으련만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = a02f752c-6a35-d680-7437-ac29c0dfc3d7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_ArcanaCheckAttempted = False
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_ArcanaCheckAttempted = True
#. TagRule: SORCERER
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a02f752c-6a35-d680-7437-ac29c0dfc3d7
msgctxt "h3730339eg18c5g4aa2g83e7gb410ceefb002"
msgid "<i>Look for any signs of errant magic afflicting this man. </i>"
msgstr "<i>이 남자에게 해를 끼치는 악의적인 마법의 징후를 찾아본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = a02f752c-6a35-d680-7437-ac29c0dfc3d7
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_ArcanaCheckAttempted = False
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_ArcanaCheckAttempted = True
#. TagRule: WIZARD
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a02f752c-6a35-d680-7437-ac29c0dfc3d7
msgctxt "hed268188g6cbag4253g824dgeb711cf214f2"
msgid "<i>Recall your studies... What could be causing this?</i>"
msgstr "<i>배웠던 것들을 떠올려 본다... 어떤 게 이런 증상을 일으킬 수 있을까?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = a1a727c3-81a2-fba5-c483-3fa7791e1de7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_SongIsOriginal = False
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a1a727c3-81a2-fba5-c483-3fa7791e1de7
msgctxt "ha04455d7ge7e9g4da9g8724g1d4008e11564"
msgid "<i>Hum the tune he was singing - try to identify it.</i>"
msgstr "<i>그가 부르던 선율을 따라 부르면서 어떤 노래인지 파악해 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = a2955f81-0926-9ba4-c242-c86eb14f6f1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a2955f81-0926-9ba4-c242-c86eb14f6f1c
msgctxt "he2a91ae0g4949g4c3dgacecgd5d3d77628c9"
msgid "I killed Malus Thorm, a twisted surgeon, and took it from his corpse."
msgstr "비뚤어진 외과의, 메일러스 쏨을 죽이고 그 시체에서 가져왔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = a2e09177-2e95-a600-9509-2490ae043bd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a2e09177-2e95-a600-9509-2490ae043bd7
msgctxt "h806e2588g3cc2g40bbgac48g409931934446"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = a305fc49-bb5d-a9e1-5e3b-b943ada8f517
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HALSINCAMP = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a305fc49-bb5d-a9e1-5e3b-b943ada8f517
msgctxt "h0b6ed543gd757g4abaga303g4f4e75612cff"
msgid ""
"*Halsin has spent years studying the shadow curse. Perhaps he will know "
"something that can help.*"
msgstr "*할신은 그림자 저주를 수년 동안 연구해 왔습니다. 그라면 도움이 될 정보를 가지고 있을지도 모릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Gale
#. NodeID = a38766bb-e82a-4291-9b68-7e3b2fa592dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_GALE(4) = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a38766bb-e82a-4291-9b68-7e3b2fa592dd
msgctxt "haa170e74g2717g4d82g8565g4e9dfd28857b"
msgid "Thaniel? That's the very lad - or spiriti - that Halsin needs to find."
msgstr "테니엘? 할신이 찾던 그 친구잖아. 아니, 영혼이라고 해야 하나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = a420f6af-3dc0-885c-378c-b7d50cc253a4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_State_KnowsLuteImportant = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a420f6af-3dc0-885c-378c-b7d50cc253a4
msgctxt "h2ca9d3c7gb248g43c6ga1fdg85d01e2a79ea"
msgid ""
"*His fingertips sport calluses and toughened skin, as if from manual labour, "
"or a playing a stringed instrument perhaps.*"
msgstr "*그의 손끝에 박힌 굳은살이 눈에 들어옵니다. 막노동해서 생겼거나 현악기를 다루면서 생긴 걸지도 모릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = a493601e-054a-f206-8b9a-e5d369e458af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a493601e-054a-f206-8b9a-e5d369e458af
msgctxt "h6fabf612gae41g4098gadadgd76b2ee6cdd0"
msgid ""
"I trust you and Halsin to help him. He's a sweet soul, Thaniel. I can't wait "
"for you to meet him."
msgstr "당신이라면 분명 할신과 함께 테니엘을 도와주겠죠. 꼭 그 아이와 만나보셨으면 하네요, 정말 착한 녀석이니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = a510490e-6c71-482f-a078-f8678c636f59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a510490e-6c71-482f-a078-f8678c636f59
msgctxt "h9047d45bg0a52g4192g8f63g75cb45d78f81"
msgid "Yes, now promise to stop talking about him."
msgstr "그래, 무사하니까 이제 테니엘 이야기는 그만 좀 하도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = a5f0fbab-1b61-fc00-ad57-7a34b1684bc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a5f0fbab-1b61-fc00-ad57-7a34b1684bc8
msgctxt "hf41f2feage376g49a7g96b9gab2882eac954"
msgid ""
"I will, but I need to know where Thaniel is. If I venture into the "
"Shadowfell blind, I will never find him."
msgstr ""
"그럴 거라네. 하지만 먼저 테니엘이 어디 있는지 먼저 알아야 한다네. 아무것도 모르고 섀도펠에 들어가서는 절대 찾을 수 없을 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = a69b612b-0318-d4d8-4d1c-e3b2e805f1c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a69b612b-0318-d4d8-4d1c-e3b2e805f1c3
msgctxt "hf94dc0d2geca8g49a2gb25dg99bcae1d41a5"
msgid ""
"<i>Please</i>. That isn't helpful. Art still has plenty of life in him. He's "
"just been... hurt."
msgstr "<i>부디</i> 그런 말은 삼가 해주세요. 아트에게는 아직 살날이 많이 남았단 말이에요. 그냥.. 아픈 것뿐이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = a6d0594b-7dd7-07c4-d645-fc520251aef0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a6d0594b-7dd7-07c4-d645-fc520251aef0
msgctxt "hffab26dfgd643g4c81g82cagf7ca51e7647a"
msgid ""
"That's more hope than I've had in, well, a century. I'll take it - thank "
"you. Thank you so much."
msgstr "그런 희망적인 소식을 들어본 게 얼마 만인지. 백 년은 더 된 것 같네요. 고마워요. 정말 고맙습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = a76bca01-9c85-997b-a9eb-b19e590fc68f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_SongIsOriginal = True
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_BardBranchChosen = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a76bca01-9c85-997b-a9eb-b19e590fc68f
msgctxt "hfc7deb83g1436g463bgadbdg3e9a11caeb4b"
msgid "You're a musician, aren't you, Art."
msgstr "아트, 당신은 악사야, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = a7a2267c-2ed5-6eea-c7f7-e94a002f4f36
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a7a2267c-2ed5-6eea-c7f7-e94a002f4f36
msgctxt "h5dbfbf85gd229g4565ga783ga65334a2056f"
msgid "<i>Try to commune with the man's soul. </i>"
msgstr "<i>이 자의 영혼과 소통을 시도 해본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = a8358af7-bac8-6329-40b8-1cdfe9deef8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a8358af7-bac8-6329-40b8-1cdfe9deef8a
msgctxt "he91e5818g1c5cg4bc6gafc0g4b6264a83d02"
msgid ""
"An assault on Moonrise is brewing - time is not on our side, I fear. We find "
"Thaniel soon."
msgstr "문라이즈 타워를 향한 공격이 머지않았네. 시간이 우리 편이 아니라 걱정이군. 어서 테니엘을 찾아야 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = a9069223-967f-d674-60a5-47722a0a04b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a9069223-967f-d674-60a5-47722a0a04b1
msgctxt "hc026f593gfd86g4171g8ed8gb9c749452965"
msgid ""
"Thaniel is more than a boy, you see. He's the spirit of the land. Without "
"the druid, without Halsin, Thaniel is trapped - and the curse cannot be "
"lifted."
msgstr ""
"있잖아, 테니엘은 그냥 소년이 아니야. 대지의 정령이지. 드루이드 없인, 할신 없이는 테니엘은 갇혀있게 되고, 그러면 저주는 풀릴 수 "
"없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = a9a24472-9ee8-edd0-0c54-0d376ce14a29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:a9a24472-9ee8-edd0-0c54-0d376ce14a29
msgctxt "h43cbda2ag08fbg4b1bg96d2g70b7ee2f47c0"
msgid "*Are you dreaming of your past... or your future?*"
msgstr "*당신은 과거를 꿈꾸고 있을까요... 아니면 미래를 꿈꾸고 있나요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = ad6b5c76-5b13-cb7d-14f9-f51394cb5f51
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Knows_WasInCurse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:ad6b5c76-5b13-cb7d-14f9-f51394cb5f51
msgctxt "h1980b6e5g649fg439dga100g97bcba0e8319"
msgid ""
"*He's spent a long time in the Shadowfell - a Sharran realm without colour "
"or light. It's had a terrible effect on him.*"
msgstr "*그는 오랜 시간을 섀도펠에 머물렀습니다. 샤의 왕국에는 빛도, 색도 없습니다. 그것은 그에게 끔찍한 영향을 끼쳤습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = ade7f4d8-5d66-d11a-f2fe-3a509abc1954
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:ade7f4d8-5d66-d11a-f2fe-3a509abc1954
msgctxt "haf07ff2cg44f3g424bg9bbagba43ab90f849"
msgid ""
"I'm afraid so, yes. Check his person - there might be something on him to "
"help get us started."
msgstr "유감스럽지만, 그렇네. 먼저 그를 살펴보게 - 추적의 실마리를 줄 무언가를 지니고 있을지도 모르니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = af0d1f67-d1c8-1765-2d00-576141cd589b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:af0d1f67-d1c8-1765-2d00-576141cd589b
msgctxt "h32fff337g7ea3g413dg91bcg4bc41a8e85af"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = b37efa91-d8c1-e9a3-8f88-459b02fa0558
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_AncientFist_HasMet(1) = True
#.   Global:
#.      - SCL_AncientFist_State_KnowsLuteImportant = True
#.   Object:
#.      - SCL_AncientFist_ItemCollected(1) = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_State_HasWokenUpFist = True
#.     - SCL_AncientFist_ItemReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:b37efa91-d8c1-e9a3-8f88-459b02fa0558
msgctxt "h2e093a12g477ag42d1ga4e5gc4273f4b6026"
msgid "<i>Pull out Art's lute and play.</i>"
msgstr "<i>아트의 류트를 꺼내 연주한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Shadowheart
#. NodeID = b435c836-220f-4e99-a5a4-4020e95c041e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_MedicineCheckAttempted = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Knows_WasInCurse = True
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_GotSHIncl = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:b435c836-220f-4e99-a5a4-4020e95c041e
msgctxt "hca049098gbe80g42f8g8573gdba473eed866"
msgid ""
"He's been in the Shadowfell. All memories will have been stripped away. We "
"need to remind him who he is - some personal effects, maybe."
msgstr ""
"저 사람은 섀도펠에 갇혀 있었어. 모든 기억이 지워졌을 거야. 자신이 누군지 다시 떠올리게 해야해. 개인적 물건 같은 게 도움 될 수도 "
"있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = b4988303-9c06-a1e1-e901-b6aa24b4178d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_AttendingFistDialogSwitch = True
#.   Object:
#.     - SCL_AncientFist_FluteHandover(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:b4988303-9c06-a1e1-e901-b6aa24b4178d
msgctxt "h7bec5ea5g5350g4aeegaee7gd4af255e3d61"
msgid "Thaniel! He's still trapped there - he needs help!"
msgstr "테니엘! 아직도 거기에 갇혀 있어요, 도와줘야 해요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = b4ebbda9-b099-3b6e-d2f0-3ca18bb38287
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_MindReadFailed = False
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:b4ebbda9-b099-3b6e-d2f0-3ca18bb38287
msgctxt "he27f7a91g8848g4222gab1cgdb6eed014d59"
msgid "<i>Probe his mind.</i>"
msgstr "<i>그의 정신을 탐색한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = b5469c99-721a-bb36-c544-a3d450fbc693
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_LiftingTheCurse_State_HalsinGoToLake = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:b5469c99-721a-bb36-c544-a3d450fbc693
msgctxt "hb148cb58g8b5dg4e68g8d7dged9319e64946"
msgid ""
"I still need your help. Meet me by the lakeshore, and be prepared. What "
"comes next could prove... perilous."
msgstr "아직 당신 도움이 필요하네. 호숫가에서 만나세. 그리고 준비하게. 이 앞으로는... 위험할 수도 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = b669cda6-bee9-3833-b1c4-3c85f814d3b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinAvailableForFist = False
#.      - HAV_CursedFist_State_CursedFistNotAlone = True
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#.   Object:
#.      - HAV_CursedFist_LeftOnFirstQuestionBank(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:b669cda6-bee9-3833-b1c4-3c85f814d3b9
msgctxt "h1c9875c4g7c7ag494fgbd6bg0fef1cb7c4e6"
msgid "Please sir... wake up."
msgstr "제발... 일어나세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = ba6cfecc-9155-8eeb-141b-b11d3a7e88a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_CursedFist_State_PlayerToldArtThanielOk(1) = False
#.   Global:
#.      - SCL_LiftingTheCurse_State_OliverAgreedToReturnToThaniel = True
#. SetFlags:
#.   Dialog:
#.     - HAV_CursedFist_State_PlayerToldArtThanielOk(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:ba6cfecc-9155-8eeb-141b-b11d3a7e88a9
msgctxt "hdc8319eeg0154g48ebgbd52g270f37ce5eb5"
msgid "We've found what was ailing Thaniel. He's going to be all right."
msgstr "테니엘이 아픈 원인을 찾아냈어, 괜찮아질 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = bc392b36-4ccb-bd3b-9357-354256842711
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:bc392b36-4ccb-bd3b-9357-354256842711
msgctxt "hfe6b5578g5edag4814ga5c0ge5151295d26a"
msgid "He's at my camp right now - he's going to be fine."
msgstr "테니엘은 내 야영지에 있어, 괜찮을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = bcac7760-0e94-a52a-6e04-fc637f8edf9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_Got Letter = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:bcac7760-0e94-a52a-6e04-fc637f8edf9f
msgctxt "h485f68fcgc368g4cf0ga6f2g0baead7128fa"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = bcdca12b-3735-62cd-b08f-23266265f44c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_GotSHIncl = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:bcdca12b-3735-62cd-b08f-23266265f44c
msgctxt "hc03fffaegb1fcg4f78gacf5gcf9c8b923f19"
msgid ""
"*Without a reminder of who he is, of what he held dear, his mind will remain "
"lost to the darkness.*"
msgstr "*스스로가 누구인지, 무엇을 소중히 여겼는지 알려줄 수 없다면, 이 자의 정신은 계속 어둠 속을 방황할 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = bce3fcc9-14b6-7d5a-26f2-c38614a69a33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:bce3fcc9-14b6-7d5a-26f2-c38614a69a33
msgctxt "h089a88aeg6b38g4365g9a9fgb9b650d8c017"
msgid ""
"Please - hurry! Thaniel is more than just a boy - he's the spirit of the "
"land. And he's all alone."
msgstr "제발 서둘러! 테니엘은 평범한 소년이 아닌, 대지의 정령이야. 그리고 그는 완전히 혼자야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = bd05a534-b5c0-8acf-498b-52ef8ea16c33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:bd05a534-b5c0-8acf-498b-52ef8ea16c33
msgctxt "ha8d1227dgcf71g4956g9a81g9b0e0b35dabc"
msgid "I'm going to help you, all right?"
msgstr "내가 도와줄게, 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = c253a03d-3aa2-bcee-2cbe-85854935a2f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:c253a03d-3aa2-bcee-2cbe-85854935a2f6
msgctxt "h752b3bb3gfd4fg4e0cgb292g2ab839e361f9"
msgid "*Nothing catches your eye.*"
msgstr "*눈에 띄는 것이 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = c3961bb1-c67f-87d8-1cd3-c1590003844e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:c3961bb1-c67f-87d8-1cd3-c1590003844e
msgctxt "h604986d3gdbe5g452fg966cg24255b2cbd42"
msgid "Let me have a look at him."
msgstr "내가 한번 살펴보지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = c462cfb4-a136-7d5e-de96-a8df6ad9cf84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:c462cfb4-a136-7d5e-de96-a8df6ad9cf84
msgctxt "h7ffa7f15g12b2g4059gab9ag53ab116904e1"
msgid ""
"He's been wandering the Shadowfell for too long. His mind will be there "
"still."
msgstr "섀도펠을 너무 오랫동안 떠돌았어, 이 자의 정신은 아직도 거기 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = c5056609-c004-0ea0-a1a8-cc5b3847e996
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:c5056609-c004-0ea0-a1a8-cc5b3847e996
msgctxt "h8da6ac23gecb1g49f3g9928g2ae755b76771"
msgid "WAKE UP."
msgstr "일어나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = c5f46314-d171-9141-dbb2-2cc17b64f840
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HalsinQuest_Halsin_Event_SearchFistInventoryAdvice(1) = False
#.      - HAV_HalsinQuest_Halsin_Event_AskedForFistAdvice(1) = True
#.   Object:
#.      - SCL_AncientFist_HasWrit(1) = False
#.      - SCL_AncientFist_ItemCollected(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_HalsinQuest_Halsin_Event_SearchFistInventoryAdvice(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:c5f46314-d171-9141-dbb2-2cc17b64f840
msgctxt "h6e319c32ge02ag4658g89cag4629e3b5e06d"
msgid "Sounds like we could be looking for almost anything to wake him."
msgstr "그를 깨울 수 있을 만한 걸 닥치는 대로 다 찾아보라는 소리로 들리는데요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = c7957813-6b8e-b004-dcb8-5fbc2eb014a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:c7957813-6b8e-b004-dcb8-5fbc2eb014a6
msgctxt "h16086d19g0fdcg45b5ga864g4dabf6d5bcca"
msgid "He is? Oh, thank you. Thank you so much."
msgstr "무사하다고요? 감사합니다, 정말로 감사합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = c94276c6-e7dc-6c03-e37b-d99553162eb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:c94276c6-e7dc-6c03-e37b-d99553162eb8
msgctxt "h912bc075gb502g48efg882fg98454a1c74a7"
msgid "Don't tell me I brought you back for nothing."
msgstr "아무 의미도 없이 당신을 살려낸 게 아니면 좋겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = ca2614a1-ee6e-2dae-c90e-63d6c6fc66f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:ca2614a1-ee6e-2dae-c90e-63d6c6fc66f6
msgctxt "hb4310722gbc8dg4967gb5b2g310e1be1f594"
msgid ""
"I was freed to find you. It's fate. You and I we were meant to meet - to "
"save Thaniel."
msgstr "이건 운명이에요. 제가 풀려난 건 당신을 만나기 위해서였죠, 우리 둘은 테니엘을 구하기 위해 만날 운명이었던 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = cab0a453-b780-2382-87f4-cc139bd58c16
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_ArcanaCheckAttempted = False
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#.   Tag:
#.      - SORCERER(1) = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_ArcanaCheckAttempted = True
#. TagRule: SORCERER
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:cab0a453-b780-2382-87f4-cc139bd58c16
msgctxt "h5ae30dcbg8b06g45fcg9617g04725acb7666"
msgid "<i>Look for any signs of magic afflicting this man. </i>"
msgstr "<i>그에게 해로운 영향을 주고 있는 마법이 있나 살펴봅니다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = cab0a453-b780-2382-87f4-cc139bd58c16
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_ArcanaCheckAttempted = False
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#.   Tag:
#.      - SORCERER(1) = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_ArcanaCheckAttempted = True
#. TagRule: SORCERER
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:cab0a453-b780-2382-87f4-cc139bd58c16
msgctxt "h5cd9c88cgecbeg40a9gb928g7e4331c0097f"
msgid "<i>Recall your studies... What could be causing this?</i>"
msgstr "<i>배웠던 것들을 떠올려 본다... 어떤 게 이런 증상을 일으킬 수 있을까?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = cb9beaf2-a390-362b-87ad-3f5bc531cf21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:cb9beaf2-a390-362b-87ad-3f5bc531cf21
msgctxt "h434a701ega706g4963g8a1cgfdf94cf10739"
msgid "If he does, he isn't saying."
msgstr "안다고 해도, 말씀하지 못하고 계세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = cf474e9f-1a6b-af90-53bc-388d96b6d9b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:cf474e9f-1a6b-af90-53bc-388d96b6d9b9
msgctxt "h7b368a47g3ab5g4ed2ga6dag62ae2deb3234"
msgid ""
"I haven't been able to sleep, knowing he was trapped in that wretched place."
msgstr "그런 끔찍한 곳에 테니엘이 갇혀 있다는 생각에 잠을 이루지 못했어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = cf961239-906f-a980-f1f1-8e6bbc0d6ca5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_MindHasBeenRead = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:cf961239-906f-a980-f1f1-8e6bbc0d6ca5
msgctxt "hd173fbfeg81fdg4d24g95dcg2dc68e22f1c5"
msgid "<i>Repeat what you heard in his mind: 'Thaniel'.</i>"
msgstr "<i>'테니엘', 그의 정신 속에서 들은 말을 다시 되뇌어 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = cfbbc214-306a-d5a6-2783-0a73f2db0c9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:cfbbc214-306a-d5a6-2783-0a73f2db0c9e
msgctxt "ha882a519g7e55g4641gb71eg731fb54a9557"
msgid "Patience. He's the key to this - I know it."
msgstr "기다려주게, 틀림없이 이 자가 단서를 쥐고 있을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = d060a522-199d-f5e4-93d8-a32b2a788bbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d060a522-199d-f5e4-93d8-a32b2a788bbc
msgctxt "haca1f28dg8490g4265gbb35g327b0e800b63"
msgid "I can finally rest now. It's been too long."
msgstr "너무 오래간만이지만, 드디어 쉴 수 있겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = d187c5aa-f02d-355b-ce60-0e09038a2c09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_SongIsOriginal = True
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Local:
#.     - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_BardBranchChosen = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d187c5aa-f02d-355b-ce60-0e09038a2c09
msgctxt "h1432e988ge241g442fg8d93gfae415e1ac62"
msgid "<i>Examine his body for clues as to a preferred instrument. </i>"
msgstr "<i>선호하는 악기가 무엇인지 단서를 찾기 위해 몸을 살펴본다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = d356d88c-70fd-6256-1dd1-64dbef4a0952
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Knows_WasInCurse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d356d88c-70fd-6256-1dd1-64dbef4a0952
msgctxt "hb07b6c7eg2e3ag432egbcb9g654c0b668a3f"
msgid ""
"<i>Mm, mm, Thaniel and me... \n"
"Do just what we please, together...</i>"
msgstr ""
"<i>음, 음, 테니엘하고 나랑...\n"
"함께 하고 싶은 걸 해...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = d35b970f-2052-611f-5f33-0d81025a4f71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d35b970f-2052-611f-5f33-0d81025a4f71
msgctxt "h03efd9a8ga4d9g404agbc0fgeb6d54961c3d"
msgid "My lute. You got it back. How?"
msgstr "내 류트. 당신이 찾아주셨군요. 하지만 어떻게...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = d50770da-9962-0f3c-e889-98dce68922c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d50770da-9962-0f3c-e889-98dce68922c5
msgctxt "h4444c3d1g2432g4794g8c80g3a9f193a9a87"
msgid "Lavender. Whenever I saw Thaniel, I always smelled lavender."
msgstr "라벤더요, 그 아이를 볼 때마다 라벤더 향을 맡을 수 있었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = d52baba2-ea2c-d8c5-44b9-60bbbb462a5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d52baba2-ea2c-d8c5-44b9-60bbbb462a5b
msgctxt "h3d1fb013gab0eg4830gb726g3914e14dcb77"
msgid ""
"*This is no physical ailment, it is a spiritual malaise. The man's mind has "
"been gripped by the Shadowfell... yet it has not broken.*"
msgstr "*이건 육체적 질병이 아닌, 정신적 고통의 증상입니다. 남자의 정신은 섀도펠에 잠식당했지만... 완전히 무너지진 않았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = d57ce8a7-f5a7-8ebb-f52d-38276b0e1782
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d57ce8a7-f5a7-8ebb-f52d-38276b0e1782
msgctxt "h80b6dd6bga532g4f56g8274g33cbf43c415e"
msgid ""
"Bring Halsin as soon as you can. The Shadowfell is no place for a child. "
"Especially a child like Thaniel."
msgstr "최대한 빨리 할신을 데려 와주세요. 섀도펠은 아이가 있을 만한 곳이 아니에요, 테니엘 같은 아이라면 더더욱이요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = d649ee65-2107-4c24-93ac-4582146a222f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_MindReadFailed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d649ee65-2107-4c24-93ac-4582146a222f
msgctxt "hf9b0b325gd262g4104gbf1dgf876657553db"
msgid ""
"*His mind is a grey haze; you can't make sense of anything through the mist.*"
msgstr "*그의 머릿속은 잿빛 안개로 뒤덮여 있습니다. 당신은 짙은 안개사이로 아무것도 볼 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = d695c11b-499e-8c26-d11d-8dd174df17b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d695c11b-499e-8c26-d11d-8dd174df17b0
msgctxt "hbf1d6b72g9ba8g4856ga6e2g7afc0baa55cf"
msgid "Can he hear you?"
msgstr "네 말을 들을 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = d6e4d398-265b-656f-83d7-2f70de83ea25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d6e4d398-265b-656f-83d7-2f70de83ea25
msgctxt "hd7f887f0ga92fg4769gaebaga138d1a6cd32"
msgid "I think so."
msgstr "그럴거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = d7137e8b-2464-5201-e361-babdb26951e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d7137e8b-2464-5201-e361-babdb26951e4
msgctxt "hf710fee2gc62bg4971g93e8g3cb722b3c82c"
msgid ""
"But you're not alone, sir. We're here with you. And I'm sure you've got "
"relations, maybe some long-lived friends, even, who'll want to be seeing you."
msgstr ""
"아트, 당신은 혼자가 아니에요, 우리가 곁에 있어요. 당신도 아직 세상과 연이 남아 있을 거예요, 오랜 친구가 있을 수도 있고 당신을 "
"보고 싶어하는 사람이 있을 수도 있잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = d7b8b78b-0ab1-146f-533b-8f7b9ff8c9b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d7b8b78b-0ab1-146f-533b-8f7b9ff8c9b2
msgctxt "h01557b62g3ff6g4e84gb601gd2ce6e355d85"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = d853ae86-3633-2506-b1d4-57d0386771c9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - HAV_CursedFist_State_TriedHistoryCheck(1) = False
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_SongIsOriginal = False
#.   Tag:
#.      - BARD(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_CursedFist_State_TriedHistoryCheck(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d853ae86-3633-2506-b1d4-57d0386771c9
msgctxt "hc6cf7192g2343g4e67gad60g5e5b68612031"
msgid "<i>Try to identify the song.</i>"
msgstr "<i>무슨 노래인지 알아내려 노력한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = d86fc041-46a4-4b4d-9b41-aabc5091ad6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_ShadowCurse_Knows_HeartOfTheLandPurpose = True
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_metartagain = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d86fc041-46a4-4b4d-9b41-aabc5091ad6d
msgctxt "h295ce373g654fg47e9gb620ga425d1c6bd17"
msgid "<i>He said a name earlier... Thaniel? Halsin is looking for him.</i>"
msgstr "<i>좀 전에 이름을 말했는데... 테니엘이라고 했지? 할신이 찾던 사람이야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = d8adf630-57ad-10fb-ea4d-e93b00b483f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d8adf630-57ad-10fb-ea4d-e93b00b483f5
msgctxt "h4f02ac59g279dg4c7dg8d7cg3ef67d68dd17"
msgid ""
"But the Shadowfell is a place of loss. Pain. It's no place for a child. No "
"place for a child like him."
msgstr "하지만 섀도펠은 상실의 공간이야. 고통의 공간이지. 아이에게 어울리는 장소는 아니야. 테니엘이 있을 곳은 더더욱 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Gale
#. NodeID = d9afc0c5-02f7-472b-a6f0-e1c23f24db91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_GotSHIncl = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d9afc0c5-02f7-472b-a6f0-e1c23f24db91
msgctxt "he88e3bb2g10b6g432ag8787g311eacb2bc63"
msgid ""
"Lost in the shadows all this time... he must have left some part of himself "
"behind. Something we can use."
msgstr "줄곧 그림자 속을 방황하고 있었다니... 거기에 자신의 일부를 두고 왔겠지. 우리가 그걸 활용 할 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = d9b913d9-c584-5a34-078d-cce2c5fbef42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:d9b913d9-c584-5a34-078d-cce2c5fbef42
msgctxt "h7f358a85gbbe4g4befg8257gc8197cf7fa8d"
msgid "Thank you - for saving him when I couldn't. I can rest now... finally."
msgstr "고마워요, 저 대신 테니엘을 구해줘서요. 드디어... 쉴 수 있을 것 같네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Astarion
#. NodeID = dbba7d37-fbae-4e57-811e-ebee23f7478a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_ASTARION(8) = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:dbba7d37-fbae-4e57-811e-ebee23f7478a
msgctxt "h93167af6g646eg4d1fg89ffg667ce42c5234"
msgid ""
"Thaniel? Didn't Halsin mention him? Something something spirit of the land?"
msgstr "테니엘? 전에 할신이 말하지 않았었나? 뭐라더라 무슨 대지의 정령이라던데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = de1dbaad-e917-b06b-be8e-6c667b095c95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:de1dbaad-e917-b06b-be8e-6c667b095c95
msgctxt "h600d49b7gd370g4b24g88aega02064f7c05d"
msgid ""
"*You can only dream of a world where you're a peaceful, harmless, babbling "
"buffoon.*"
msgstr "*당신은 평화롭고, 무해하고, 우스꽝스러워 보이는 세계를 꿈꿀 뿐입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = deceaf9e-4033-9f83-7f37-64f64e051c22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:deceaf9e-4033-9f83-7f37-64f64e051c22
msgctxt "haa0babf5gbd9fg4b27g969dgbe5282bb1e76"
msgid ""
"<i>We are living, they are dead... \n"
"Two of us safe 'til the end...</i>"
msgstr ""
"<i>우리는 살아있고, 저들은 죽었네...\n"
"마지막까지도 우리 둘은 무사할 거야...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = e090db2e-f1ea-c0e9-df5e-36dbbf517289
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:e090db2e-f1ea-c0e9-df5e-36dbbf517289
msgctxt "hbbe7a369g1775g47ddgb22cg0ba346dd56a0"
msgid ""
"I'm not sure I can put it into words - the landscape there shifts and "
"changes."
msgstr "어떻게 설명해야 할지 모르겠어요... 그곳의 지형은 시시각각 변하거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = e16fba14-5d28-f733-5e65-ccb4059aa06d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_HalsinQuest_Halsin_Event_AcknowledgedNightsongFreed(1) = False
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_HalsinQuest_Halsin_Event_AcknowledgedNightsongFreed(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:e16fba14-5d28-f733-5e65-ccb4059aa06d
msgctxt "hafbaacf1g4ec4g4bb4ga96cgf753c71bbb1c"
msgid ""
"We have what we need to proceed, and not a moment too soon - a winged "
"aasimar flew overhead, and now an assault is brewing against Moonrise."
msgstr ""
"필요한 건 모두 얻었네, 하지만 시간이 촉박해. 날개 달린 아시마르가 저 너머로 날아갔고 문라이즈에서는 싸움이 일어나려 하고 있다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = e2c6d74c-48df-0dcc-841d-32847d0e2473
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_CursedFistNotAlone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:e2c6d74c-48df-0dcc-841d-32847d0e2473
msgctxt "he6a6d8afg36a7g4711g884eg54927ed74c3e"
msgid "A musician. That's wonderful."
msgstr "악사였다니, 멋져요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = e4ff2a96-d93a-67b4-0122-c6f13153e5d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_CursedFist_ThanielBeingSaved_HasMet(1) = True
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinLiftingCurse = True
#.      - SCL_AncientFist_State_HasWokenUpFist = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:e4ff2a96-d93a-67b4-0122-c6f13153e5d5
msgctxt "hd0ad00efgf971g4ddcg93afgf15cecf6b7de"
msgid "Any word?"
msgstr "소식 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = e6d73119-f695-5fab-a49e-b911c63c363e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:e6d73119-f695-5fab-a49e-b911c63c363e
msgctxt "hf2968ea2g57bbg490cg91f2gb298f355e96d"
msgid "I don't deserve you, my friend."
msgstr "자네 같은 친구가 있어 영광이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = e72e8e81-84aa-084c-52f0-3382bab30c25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_LiftingTheCurse_State_HalsinIsInAct2 = False
#. SetFlags:
#.   Global:
#.     - GOB_WolfPens_Event_SidedWithPrisoner = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:e72e8e81-84aa-084c-52f0-3382bab30c25
msgctxt "h526be97dge24cg41eegb315g84754340a88d"
msgid "Who is this Halsin?"
msgstr "할신이 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = e844f518-fd4c-37f0-7021-729558257d1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SCL_AncientFist_HasMet(1) = False
#.   Global:
#.      - HAV_CursedFist_State_CursedFistNotAlone = False
#. SetFlags:
#.   Dialog:
#.     - SCL_AncientFist_HasMet(1) = True
#.   Global:
#.     - SCL_AncientFist_Knows_WasInCurse = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:e844f518-fd4c-37f0-7021-729558257d1e
msgctxt "h2d2c52c5g70f7g40b1gb9e2g678114d5e6fb"
msgid ""
"<i>Mm, mm, Thaniel and me are... \n"
"Climb, climb, climbing up a tree...</i>"
msgstr ""
"<i>음, 음, 테니엘하고 나랑... \n"
"올라, 올라, 나무를 올라가...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = e90890f9-8fc9-168d-c87b-bc851c1eaffa
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_ArcanaCheckAttempted = False
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#.   Tag:
#.      - SORCERER(1) = False
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_ArcanaCheckAttempted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:e90890f9-8fc9-168d-c87b-bc851c1eaffa
msgctxt "h8cb32489gebe4g416aga556g38ff386b85c6"
msgid "It may be some kind of magical affliction..."
msgstr "일종의 마법적인 질환일지도 모르겠는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = eb6fe4ae-dea6-ab09-2619-59887097803b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_CursedFistNotAlone = True
#.      - SCL_AncientFist_ItemReturned = False
#.      - SCL_AncientFist_AttendingFistDialogSwitch = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:eb6fe4ae-dea6-ab09-2619-59887097803b
msgctxt "hf7e92868ge042g4fc6ga5c1g1fb137010171"
msgid ""
"<i>Monsters snuffling and stalking... \n"
"In the shade where we are walking...</i>"
msgstr ""
"<i>괴물이 킁킁거리며 추적해...\n"
"우리가 거니는 어둠 속에서...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Fist J'ehlar
#. NodeID = ee69c309-b7d3-10dd-3367-1cd9d4547c2e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAV_CursedFist_LeftOnSecondQuestionBank(1) = True
#.     - HAV_CursedFist_LeftOnFirstQuestionBank(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:ee69c309-b7d3-10dd-3367-1cd9d4547c2e
msgctxt "haa99d7d8g0149g402cga3cdgbbd689e0c22f"
msgid "If you know how to get through to him, don't hesitate."
msgstr "고칠 방법을 아신다면 부디 서둘러 주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = ee8d983c-8d5c-1311-1161-8c1dc70b4637
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_State_KnowsLuteImportant = True
#.   Object:
#.      - SCL_AncientFist_ItemCollected(1) = True
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_State_HasWokenUpFist = True
#.     - SCL_AncientFist_ItemReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:ee8d983c-8d5c-1311-1161-8c1dc70b4637
msgctxt "h3491eaeeg21ffg4ec1gb145g4a4dfcc921f9"
msgid "<i>Pull out the lute you found and play a little.</i>"
msgstr "<i>찾아낸 류트를 꺼내 조금 연주해 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = ef07775a-16a3-e968-4a0b-960bfdbb6278
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_CursedFist_State_CursedFistNotAlone = True
#.   Object:
#.      - SCL_AncientFist_WritHandOver(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:ef07775a-16a3-e968-4a0b-960bfdbb6278
msgctxt "hf2dd3431gc415g473egaf9dg300b17dd5611"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = f01d7231-83fa-c267-179d-9c7f9eb63e35
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_CursedFist_Event_HalsinReactsToThanielMention(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:f01d7231-83fa-c267-179d-9c7f9eb63e35
msgctxt "hd8eec98age7abg4bd9g9abfgf7779e431370"
msgid ""
"It's true then; he's met Thaniel - there's no other way he'd know that name. "
"This is just what we needed - well done."
msgstr "테니엘을 만난 게 분명하군. 그렇지 않고서야 이름을 알 수 없으니까. 우리에게 딱 필요했던 걸세, 잘했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = f0b63eee-5888-c0ca-18b3-a924acb0d027
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinAvailableForFist = True
#.      - SCL_AncientFist_ItemReturned = True
#.   Script:
#.      - GEN_IsSpeakerPresent_6 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:f0b63eee-5888-c0ca-18b3-a924acb0d027
msgctxt "h62497231g596eg4f83gbb59g99ff2f4fd3b7"
msgid ""
"You... you're Halsin. Thaniel said to find you. You must help him - "
"<i>please.</i>"
msgstr "당신... 당신이 할신이군요. 테니엘이 당신을 찾으라고 했어요, 그 아이를 구해주세요 <i>제발요.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = f1ae007d-ee9f-e78f-dfaf-a607af8926cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_CursedFist_NightsongFreedHasMet(1) = False
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.      - SCL_AncientFist_ItemReturned = True
#. SetFlags:
#.   Dialog:
#.     - HAV_CursedFist_NightsongFreedHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:f1ae007d-ee9f-e78f-dfaf-a607af8926cb
msgctxt "hd94e1203gd469g46dcga522gc62581807c52"
msgid ""
"I heard tell of an angel overhead. An angel who could clear the shadows. "
"Imagine."
msgstr "하늘 위 천사에 대한 이야기를 들었어. 그림자를 몰아낼 수 있는 천사 말이야. 상상해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = f233fd3d-c330-bf05-98a2-f1cbd725c3d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:f233fd3d-c330-bf05-98a2-f1cbd725c3d1
msgctxt "h94227bc6gda65g4a39ga81ag7ec13dcb66d4"
msgid "He's a hopeless case. I wouldn't expect much from him."
msgstr "가망이 없군, 나라면 큰 기대를 하지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = f5a608ca-6e28-85f2-1b34-53e9f2196eb9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_ArcanaCheckAttempted = False
#.      - SCL_AncientFist_AttendingFistDialogSwitch = False
#.   Tag:
#.      - SORCERER(1) = False
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_ArcanaCheckAttempted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:f5a608ca-6e28-85f2-1b34-53e9f2196eb9
msgctxt "h1e88eed5g31cfg4c87g9af5g29ee6bea6c0a"
msgid "<i>Search for signs of magical influence.</i>"
msgstr "<i>마법적 영향이 있는지 징후를 찾아봅니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = f5e1de07-6c6d-3367-3def-d95fc6338e4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_AncientFist_State_HasWokenUpFist = False
#.   Object:
#.      - SCL_AncientFist_HasWrit(1) = True
#.      - SCL_AncientFist_ItemCollected(1) = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:f5e1de07-6c6d-3367-3def-d95fc6338e4b
msgctxt "h40e1b26bg4055g4998gbcafg751ae7c04b21"
msgid "He had a writ - it mentions the House of Healing."
msgstr "그가 지니고 있던 문서가 있는데 치유의 집을 언급하고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = f894c3a5-c0f1-4a59-9a31-b617b9542fa3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LiftingTheCurse_State_HalsinLiftingCurse = False
#.      - SCL_AncientFist_ItemReturned = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:f894c3a5-c0f1-4a59-9a31-b617b9542fa3
msgctxt "hf121c1f8gcc2dg4093g8797g7aac220f8b58"
msgid "Have you found Halsin?"
msgstr "할신을 찾았나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = fa543101-9f0d-50c2-a415-925a3ed0ac6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:fa543101-9f0d-50c2-a415-925a3ed0ac6f
msgctxt "h10242662g9ed9g42e6g9392gcebef1c22c7e"
msgid ""
"Was there anything that could offer guidance? Something that didn't change?"
msgstr "이정표가 될 만한 것은 없나? 뭔가 여전한 게 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Art Cullagh
#. NodeID = fbad78fa-3160-da91-2cb9-033eefd9c639
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:fbad78fa-3160-da91-2cb9-033eefd9c639
msgctxt "hfcb1907ag1be8g47b6gb014ga664902b48ed"
msgid ""
"Aye. You've brought me back to myself. I wasn't sure it was still possible."
msgstr "그래. 당신이 날 제자리로 돌려줬어. 아직 가능한 일인지 확실하지 않았는데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Player
#. NodeID = fee244c4-a007-dcc9-6da6-a2726885b4a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_SongIsOriginal = True
#.      - 3a91c03d-6ebf-594e-8ef9-c9ba056b479b_BardBranchChosen = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:fee244c4-a007-dcc9-6da6-a2726885b4a3
msgctxt "h316f2acdg46f9g4f96gba83gb4933522cfd6"
msgid "You're a musician, aren't you?"
msgstr "당신은 악사야, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Narrator
#. NodeID = ff6b31d0-5365-8bc2-7427-4b4833964f4c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_AncientFist_State_KnowsLuteImportant = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:ff6b31d0-5365-8bc2-7427-4b4833964f4c
msgctxt "h59edee4fg39afg4fe0gbf57gb94aee641622"
msgid ""
"*You notice the distinctive calluses on the man's hands - the kind only "
"developed from decades of playing the lute.*"
msgstr ""
"*당신은 남자의 손에서 매우 특이한 굳은살을 발견합니다. 이런 굳은살은 수십 년간 류트를 연주한 사람의 손에서만 나타나는 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Shadowheart
#. NodeID = ffdf3c9c-056e-4ce3-b78b-c76951ea9f9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:ffdf3c9c-056e-4ce3-b78b-c76951ea9f9e
msgctxt "h630baae8gedf3g4ce0gbfb4g989ed89caf09"
msgid ""
"Poor fool. He resisted the Dark Lady's embrace, and suffered for it. He "
"should have just accepted her."
msgstr "가엾은 바보 같으니, 어둠의 여신이 내리신 축복을 거절하고 대신 고통을 받았구나. 차라리 그 분을 받아들였다면 좋았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist
#. Speaker = Halsin
#. NodeID = ffeefa30-3b6c-be4b-abfc-b9f8ab246f5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist:ffeefa30-3b6c-be4b-abfc-b9f8ab246f5f
msgctxt "h50e7261ag2fcbg468dg9480g5b4f6cb956bb"
msgid ""
"Without Thaniel, no. And I don't know how I can find him without speaking to "
"this man."
msgstr "테니엘이 없다면 불가능해. 그리고 이 남자와 얘기하지 않고 테니엘을 찾을 방법을 난 모르겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging
#. Speaker = Art Cullagh
#. NodeID = 1ccf6080-9f08-42f9-99da-164fb4a581a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d6df8edb-ac4b-e1d2-794b-6bfd00757cbf_A = True
#. SetFlags:
#.   Local:
#.     - d6df8edb-ac4b-e1d2-794b-6bfd00757cbf_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging:1ccf6080-9f08-42f9-99da-164fb4a581a5
msgctxt "h4e737814ga532g4b85g9c60g823f3dd8964c"
msgid ""
"<i>Mm, mm, Thaniel and me\n"
"Do just what we please, together,\n"
"Waiting for the sun, forever.</i>"
msgstr ""
"<i>음 음 테니엘하고 나랑\n"
"함께 마음대로 해\n"
"뜨지 않는 태양을 기다리며</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging
#. Speaker = Art Cullagh
#. NodeID = 44217ecf-b76b-286c-de87-9fbbd07d1e78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging:44217ecf-b76b-286c-de87-9fbbd07d1e78
msgctxt "had33e104g9a9fg48cfg9b78gaa5a988d98af"
msgid ""
"<i>Monsters snuffling and stalking,\n"
"In the shade where we are walking.</i>"
msgstr ""
"<i>괴물이 킁킁거리며 추적해\n"
"우리가 거니는 어둠 속에서</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging
#. Speaker = Art Cullagh
#. NodeID = 44cf4f88-b8f4-26f3-94a2-b95424ecc5e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging:44cf4f88-b8f4-26f3-94a2-b95424ecc5e1
msgctxt "h2967dc0cgeeb6g4ca7g9a7dg9434c258dbd4"
msgid "<i>Two of us safe 'til the end.</i>"
msgstr "<i>우리 둘 다 끝까지 안전해.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging
#. Speaker = Art Cullagh
#. NodeID = 641ecbfb-f0be-4143-7430-48695c696e22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging:641ecbfb-f0be-4143-7430-48695c696e22
msgctxt "h6f11f887gaab1g4c31gba0bg8fd677405494"
msgid ""
"<i>We, we see what we see and\n"
"Do just what we please, together,\n"
"Waiting for the sun, forever.</i>"
msgstr ""
"<i>우린, 우린 보는 걸 봐\n"
"함께 마음대로 해\n"
"뜨지 않는 태양을 기다리며</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging
#. Speaker = Art Cullagh
#. NodeID = 67c00cfd-244c-442f-814f-077e47d2668e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d6df8edb-ac4b-e1d2-794b-6bfd00757cbf_B = True
#. SetFlags:
#.   Local:
#.     - d6df8edb-ac4b-e1d2-794b-6bfd00757cbf_B = False
#.     - d6df8edb-ac4b-e1d2-794b-6bfd00757cbf_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging:67c00cfd-244c-442f-814f-077e47d2668e
msgctxt "h968d36f6g7434g4e47g8878g2dde89ee09d7"
msgid ""
"<i>We are fearsome, black and red,\n"
"We are living, they are dead.</i>"
msgstr ""
"<i>검정과 빨강, 우린 용감해\n"
"우린 숨 쉬어 저들은 죽어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging
#. Speaker = Art Cullagh
#. NodeID = 8f092362-fc48-4c0c-9c7b-a1890ba90219
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d6df8edb-ac4b-e1d2-794b-6bfd00757cbf_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging:8f092362-fc48-4c0c-9c7b-a1890ba90219
msgctxt "h894b225cg8469g4b31g9467ge2b31d51bbc6"
msgid ""
"<i>Mm, mm, Thaniel and me are\n"
"Climb, climb, climbing up a tree and</i>"
msgstr ""
"<i>음, 음, 테니엘하고 나랑... \n"
"올라, 올라, 나무를 올라가</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging
#. Speaker = Art Cullagh
#. NodeID = f346d73d-f207-874b-e157-7d51fef70ac9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_AD_CursedFistSinging:f346d73d-f207-874b-e157-7d51fef70ac9
msgctxt "h8a9b463dg8a34g4d75gb3bcg05541734c092"
msgid ""
"<i>We see shadows, they get darker,\n"
"But our hiding place is brighter.</i>"
msgstr ""
"<i>그림자는 점점 더 어두워지네,\n"
"하지만 우리 은신처는 더 밝네.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_CursedFist_Dead_CursedFist
#. Speaker = Player
#. NodeID = 02368c24-d8a0-4b17-8394-80ca968d4e29
#. HandlePath = TaggedText[0].TagText[0]
