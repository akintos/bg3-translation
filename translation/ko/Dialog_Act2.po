msgctxt "ha1f3b640g6386g447cg88d1gb3cfbacc2b59"
msgid ""
"I would like to dismiss "
"[HirelingName_3_0b5f9e73-cec6-e308-15f4-8e142147908d]."
msgstr "[HirelingName_3_0b5f9e73-cec6-e308-15f4-8e142147908d]을(를) 해고하고 싶습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 65bc338b-7af4-d431-1345-c9d3475d2c06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:65bc338b-7af4-d431-1345-c9d3475d2c06
msgctxt "h9823d80eg5251g45d3gaf61gb250ebf8d4d9"
msgid "Choose."
msgstr "선택하라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 6abf3ea8-eeaa-2995-8097-d659689d7bca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - Hirelings_State_InCamp_1 = False
#.      - Hirelings_State_InCamp_3 = False
