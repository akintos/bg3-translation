msgctxt "hfddf03edg7b28g4947g8bfeg0220d18cb712"
msgid "What business do <i>you</i> have in <i>my </i>master's den?"
msgstr "<i>네놈</i>들은 <i>내</i> 주인님의 둥지에서 뭐 하고 있는 거냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
