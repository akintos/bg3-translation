msgctxt "h21eedae8g3ebfg4125g8986gfe8ca4531aa0"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_AD_Patrol
#. Speaker = Squire
#. NodeID = dc69c8e0-a081-4a3d-b773-51c3be278db7
