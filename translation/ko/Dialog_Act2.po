#.     - SHA_LastJusticiar_RatsCalm_Event_CompanionSuggestsLeave(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:a3aab041-0217-4a97-a173-295e8715add5
msgctxt "h83db11f7g7173g4a4fg8fd9g7fe361a4bc5e"
msgid "Unwelcoming vermin aside, we need to explore this place."
msgstr "우릴 불청객 취급하는 쥐쯤이야 어찌 됐건, 여길 살펴봐야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Gale
#. NodeID = a3e384cf-30b6-43e3-85b0-ec1732e77839
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_LastJusticiar_RatsCalm_Event_CompanionSuggestsLeave(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:a3e384cf-30b6-43e3-85b0-ec1732e77839
msgctxt "h18651fb2g444eg48bfg9c60g9dc681cb2ea7"
msgid ""
"Extraordinary behaviour. There's more to these rats than meets their beady "
"little eyes."
msgstr "매우 특이한 행태인데. 이 쥐들이 이렇게 눈을 부라리는 데는 이유가 있을 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Player
#. NodeID = a4fd7576-cbf0-d9d4-2c0a-f85d8bdcb94c
#. HandlePath = TaggedText[0].TagText[0]
