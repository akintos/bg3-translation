msgctxt "hbf7fe2ddg87f3g493cg87edg8ddaf1d19110"
msgid "Stone guide me - I'll be home soon."
msgstr "이 돌이 나를 안내해 줘, 곧 집에 갈 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Gnome02
#. Speaker = Nickels
#. NodeID = 3168b340-96db-4082-bce1-3c3610bdfec5
