msgctxt "h6b446892gc1feg4664ga929gf3f9e98ba731"
msgid "Why were you alone here?"
msgstr "왜 여기 혼자 있었니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_ZombieArabella_Dead
