msgctxt "hebe8f95bg7b87g4458ga1f5g6229599eb457"
msgid "*The mind needs no further input or connections - it is complete.*"
msgstr "*장치의 정신이 더는 입력이나 연결을 필요로 하지 않습니다. 완료되었습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Vault_Puzzle
#. Speaker = Narrator
#. NodeID = a9fdb2f5-d8d6-ddd2-8767-f930c576dd9f
#. HandlePath = TaggedText[0].TagText[0]
