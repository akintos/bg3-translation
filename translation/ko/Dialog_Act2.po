msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
#. Speaker = Ox
#. NodeID = 71c70785-2d15-c393-ed6a-29fbf145902b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000:71c70785-2d15-c393-ed6a-29fbf145902b
msgctxt "h12e81bcegc8f7g425egba2eg489c7d4cb328"
msgid "On the double, one hoof quickly following the other!"
msgstr "아주 빠르게, 발굽을 쉬지 않고 놀려서 빠져나왔지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
#. Speaker = Player
#. NodeID = 897f7888-2066-c385-7e7f-bcf88455180a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_DEN_General_Mule1_AskedAboutTwoLegs = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000:897f7888-2066-c385-7e7f-bcf88455180a
msgctxt "h1120d756g5a82g4b82gb264gbca8f978b6b4"
msgid "You're the fellow who wanted to become a two-legs, aren't you?"
msgstr "너, 그 두 다리가 되고 싶어하던 친구 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
#. Speaker = Ox
#. NodeID = a6ecb578-28c1-060e-dcaf-073d33400163
