msgctxt "hfd0e399cgaf67g499dgad46gd7ce5b50b894"
msgid "Listen to her."
msgstr "그분께 귀 기울여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_AD_VanishingJusticiarChanting
#. Speaker = GROUP_SHA_NightsongPrison_VanishingJusticiars
#. NodeID = ac9387bb-8298-443e-a5ec-ce8b55d37536
