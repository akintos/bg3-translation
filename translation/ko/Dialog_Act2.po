#.      - RANGER(1) = False
#.      - DRUID(1) = False
#. SetFlags:
#.   Object:
#.     - SHA_Displacer_Event_NatureAttempted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:8008f145-dcb9-1356-07b3-1ed27f1870df
msgctxt "h2143f391gf529g4995g8694gd8bc8a1bab09"
msgid "<i>Something doesn't seem quite right - take a closer look.</i>"
msgstr "<i>뭔가 좀 이상합니다... 자세히 살펴봅니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 831156a0-9343-e777-b4e2-5a5939b675f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:831156a0-9343-e777-b4e2-5a5939b675f5
msgctxt "h07956098g3a4ag46fag9863g2a015d2f743b"
msgid "I was belly-hollow - close to death."
msgstr "나는 거의 죽기 직전까지... 배가 텅 비어있었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 8395160c-147a-1438-cf91-4a7d3042e54d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:8395160c-147a-1438-cf91-4a7d3042e54d
msgctxt "h0603670dg3b4eg4a81g951fg2a74d46c1075"
msgid "I'll be on my way."
msgstr "바로 나갈게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 85f1ee87-c2ba-72ea-4f10-6ad362656702
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:85f1ee87-c2ba-72ea-4f10-6ad362656702
msgctxt "h3ce0c29fg4decg4f65gbd49g42cc01422d35"
msgid "Would he die for you, as you would for him?"
msgstr "네가 주인을 위해 죽을 수 있는 것처럼 주인도 널 위해 그래줄거라 생각해?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 86142242-e33d-79e6-b430-e47ed4b5e6ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:86142242-e33d-79e6-b430-e47ed4b5e6ad
msgctxt "h694a8b74g6ed8g4647g9f7bg31f29ae3a705"
msgid "*The beast eyes you with interest.*"
msgstr "*짐승이 흥미로워하는 눈빛으로 당신을 훑어봅니다*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 87f935b9-e40d-51fe-c30f-d7f7eb9636e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:87f935b9-e40d-51fe-c30f-d7f7eb9636e4
msgctxt "h8b338293gb816g45cega2bagdb7812425147"
msgid "You mock our heart-bond?"
msgstr "우리의 진심 어린 유대를 조롱하는 거냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 88c3f781-4b50-0efb-0fa1-6fe716164895
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:88c3f781-4b50-0efb-0fa1-6fe716164895
msgctxt "hec2af617gd5e5g4be5g8694g88f477a1ced7"
msgid "A poor word-kiss."
msgstr "입만 살았구나, 하찮은 것."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 8c65f9b4-f8fc-45b1-8f89-a6d307d8272f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 16
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_Event_AnimalHandlingSuccess(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:8c65f9b4-f8fc-45b1-8f89-a6d307d8272f
msgctxt "hc11aff8cgd410g4df0gb7e3g340fb236b4cc"
msgid "<i>Make eye contact with the beast.</i>"
msgstr "<i>짐승과 눈을 마주칩니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 8e9f4729-9d16-5d4b-7f65-511813b361f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:8e9f4729-9d16-5d4b-7f65-511813b361f9
msgctxt "h0fd0a3c2g1431g4336g8a3dg272e08130e7f"
msgid "I am his <i>love</i>."
msgstr "나는 그의 <i>사랑</i>이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 90affd6f-29b1-75f7-bff3-a63458e3f447
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:90affd6f-29b1-75f7-bff3-a63458e3f447
msgctxt "h655e9fedgb867g4849g92e1g317d9bfb7354"
msgid "*You manage to contain yourself.*"
msgstr "*당신은 웃음을 억누릅니다*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 90b0637c-9f52-465d-a14b-e4a0c8bde2eb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SHA_Displacer_Event_AnimalHandlingSuccess(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:90b0637c-9f52-465d-a14b-e4a0c8bde2eb
msgctxt "hff364a51gd344g422ega246gd0d2d8588669"
msgid ""
"*Though its posture is defensive, its eyes are soft - the beast is in "
"<i>love</i>.*"
msgstr "*자세는 방어적이지만, 눈빛은 부드럽습니다... 이 짐승은 <i>사랑</i>에 빠졌습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 91d4fa20-b265-d777-021a-2a322a14aa5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:91d4fa20-b265-d777-021a-2a322a14aa5d
msgctxt "h0925f2dbg5fbeg494fga776gcd34296edf34"
msgid "Reconsider, challenger."
msgstr "다시 생각해라, 도전자여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 9262a761-67ae-0bf8-0c61-97951339a539
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:9262a761-67ae-0bf8-0c61-97951339a539
msgctxt "h6b5f349cgf37bg4315ga3a1g5ec00b0c80c9"
msgid "*...which quickly becomes a sneer.*"
msgstr "*...그리고 금방 조롱하는 눈빛으로 변합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 931996dd-d289-984f-d4dd-1487794204ba
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 16
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_Event_PerceptionAttempted(1) = False
#.      - SHA_Displacer_Event_AnimalHandlingSuccess(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Displacer_Event_PerceptionAttempted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:931996dd-d289-984f-d4dd-1487794204ba
msgctxt "h3c69a9ddgf098g44a6g803cg7ff2c6a4c57c"
msgid "<i>Look around to see who it might be in love with.</i>"
msgstr "<i>누구에게 사랑에 빠졌을지 주위를 둘러봅니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 952086e6-fadb-3294-90e4-3868cbe87a7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:952086e6-fadb-3294-90e4-3868cbe87a7c
msgctxt "h759faae2g5ebdg4605gb158g8f634ee2f93f"
msgid "<i>Reach out to stroke one of its tentacles.</i>"
msgstr "<i>손을 뻗어 촉수 중 하나를 쓰다듬습니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 9700be86-4dc9-1113-9979-6b77d7e42ad7
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 16
#. CheckFlags:
