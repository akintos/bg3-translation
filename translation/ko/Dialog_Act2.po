#.      - DEN_Thieflings_HasMet_Mol = True
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch:85a59177-1632-4b8d-8b0d-b49c2e0cf3da
msgctxt "h036c6ec6ge7b7g4693g8a67g6c05955e1d3f"
msgid "...This belonged to the lost girl. Mol."
msgstr "...이건 실종된 여자 아이, 몰의 물건인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch
#. Speaker = Player
#. NodeID = 85a59177-1632-4b8d-8b0d-b49c2e0cf3da
