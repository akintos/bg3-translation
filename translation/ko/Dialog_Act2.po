msgctxt "hce0f10e0g5397g4873gb413gc7feeeea111a"
msgid "Did he just...?"
msgstr "이게 지금...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_Patroller001Witness
#. Speaker = Adept Bel
#. NodeID = 2c6ffc7e-5358-6804-bff8-c547fdab745e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_Patroller001Witness:2c6ffc7e-5358-6804-bff8-c547fdab745e
msgctxt "h4451710cg0b7dg4546gbc3bg50f5dfe5c5db"
msgid "What in the hells?"
msgstr "대체 무슨?"

