msgctxt "h2f260bcag8a63g45c8ga3c3g3541fcf67d1b"
msgid "I was younger, then. My ambitions were more self-defeating."
msgstr "그 때는 어렸어, 좀 더 자기패배적인 야망을 가지고 있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
#. Speaker = Player
#. NodeID = 37159d30-518d-29dc-0233-24daafa430f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000:37159d30-518d-29dc-0233-24daafa430f3
msgctxt "h9d848d40g35b8g4418g8016gcaf45249c20f"
msgid "How'd you make it through the shadows?"
msgstr "어떻게 그림자를 헤쳐왔어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_LastLightOx000
#. Speaker = Ox
#. NodeID = 39088605-e5fc-0144-ca92-cb390a9c0a8a
#. HandlePath = TaggedText[0].TagText[0]
