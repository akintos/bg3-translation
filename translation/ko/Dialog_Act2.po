#.     - GLO_Pixie_State_KilledByDarkUrge = True
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:0af0af9c-e870-3bdb-ffff-c6a5a60e6d0b
msgctxt "h70cfdc7dg861cg4c5ag8779g68d6dc553177"
msgid ""
"*As you catch the tiny thing between only a finger and thumb, the hope she "
"had all flickers away.*"
msgstr "*엄지와 검지로 그 가녀린 것을 잡는 순간, 그녀의 희망은 모두 사라져버립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Narrator
#. NodeID = 0c898703-8ff8-e0ce-25b1-4c74397b1a13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Pixie_InsideLantern_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GLO_Pixie_InsideLantern_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:0c898703-8ff8-e0ce-25b1-4c74397b1a13
msgctxt "h6f157460g6524g4d99gb7a7g510c97d24112"
msgid ""
"*The lantern gives off a chilly glow, protecting all in its vicinity from "
"the surrounding shadows.*"
msgstr "*등불은 차가운 빛을 발하며 주위의 모든 사람을 그림자로부터 보호해 줍니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Harper Skywin
#. NodeID = 0e349fba-f17a-a113-682a-4c8ee66beae8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_6 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:0e349fba-f17a-a113-682a-4c8ee66beae8
msgctxt "hc947197dg574dg442bg8dc9g757a66ce89f4"
msgid ""
"Farewell until we next meet, friend. And for as long as Last Light stands, "
"you're forever welcome."
msgstr "안녕히 가세요, 친구. 최후의 빛이 존재하는 한 여러분은 언제나 환영입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 17feb5f8-3ce7-3bd2-68d2-1ac889c9aaa1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:17feb5f8-3ce7-3bd2-68d2-1ac889c9aaa1
msgctxt "h5f88ca31g6e58g487fg82aagd1f37e846148"
msgid ""
"I oughta sink my teeth in your softs for messing around, but all this fresh "
"air has me in a good mood. What do I owe you?"
msgstr "사소한 장난에 대한 벌로 이빨이라도 박아주고 싶지만, 신선한 공기를 마시니 기분이 좋아지네. 뭘 해줄까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Lae'zel
#. NodeID = 19742f63-f822-4b11-bfce-eb680c4bb945
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_LAEZEL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:19742f63-f822-4b11-bfce-eb680c4bb945
msgctxt "hcc6a0b92gadf8g4e28g904fgd92607104641"
msgid ""
"Bah. She cannot be more pained than my own ears from that insufferable "
"rhyming."
msgstr "으아. 저 참을 수 없는 운율 때문에 귀가 고통스럽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 1bbf217c-6f9a-f191-60e5-a5088b49a85f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:1bbf217c-6f9a-f191-60e5-a5088b49a85f
msgctxt "h936233c7ga4b0g45cfg8cc0g3a40486699f5"
msgid "AHH!"
msgstr "끄아아아아아악!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 209c4e9c-1194-2b3b-98e5-06804e88c5d4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Pixie_Knows_HowLanternWorks = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:209c4e9c-1194-2b3b-98e5-06804e88c5d4
msgctxt "hb429ebdfgb821g4741gb7e7g11ac7081a708"
msgid ""
"FINALLY! Been trapped in that coffin with no one but a mad drider and my own "
"farts for company."
msgstr "<i>드디어!</i> 이 관짝에 갇혀서 그동안 친구라곤 저 미친 드라이더 새끼랑 내가 뀐 방귀밖에 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 2a092bca-53b7-6c22-a81d-6f52f96b009f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:2a092bca-53b7-6c22-a81d-6f52f96b009f
msgctxt "h7e37d243gc55cg4ee2gaf6bgfae40ea044a6"
msgid "Unfortunately for you, I need this lamp fully functioning."
msgstr "너한테는 불행하게도, 나는 완전히 작동하는 등불이 필요하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 2b532bbf-40e8-9001-117e-2e68915ad5b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:2b532bbf-40e8-9001-117e-2e68915ad5b7
msgctxt "hc020d1e7g6f52g43d8ga60dg6768c1420a69"
msgid ""
"I'LL GUT YOU LIKE A TEN-DAY-OLD IF YOU DON'T RELEASE ME RIGHT! THIS! MOMENT!"
msgstr "<i>지금! 당장! 날 풀어주지 않으면! 널 태어난 지 일주일 된 애새끼처럼 찢어버릴 거야!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 2c1db4c9-b2c2-0730-e58c-3174b482fd1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:2c1db4c9-b2c2-0730-e58c-3174b482fd1a
msgctxt "hd9541302g6e61g49f9g88b3g8d696f171b0a"
msgid "Honey, I'll shake your world, that's for sure."
msgstr "얘, 내가 이 세상을 제대로 뒤흔들 수도 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 2e9f5e3f-a0ea-019f-0f1c-11c523b19be2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:2e9f5e3f-a0ea-019f-0f1c-11c523b19be2
msgctxt "heb3a857fg6ab8g4a52ga0ceg404a4f232043"
msgid "If you release me from this cell I'll bless you with a faerie spell!"
msgstr "요컨대 주의해서 철창에서 풀어주면 요정의 주문으로 철저하게 빌어줄게!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Narrator
#. NodeID = 30e28d21-5b9b-4724-bb18-ad5842afee98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:30e28d21-5b9b-4724-bb18-ad5842afee98
msgctxt "h83a6fe6dg8105g444fgaf9bg3af493e7bf71"
msgid ""
"*These fey creatures were well known among druidic circles - for both their "
"playful hijinks and malicious trickery.*"
msgstr "*이 페이 생물체는 드루이드 사회에서 익살스러운 장난과 악의적인 속임수로 유명합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 381d03f0-a650-9b16-c8b2-77a5875766a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:381d03f0-a650-9b16-c8b2-77a5875766a1
msgctxt "h166968b4gc734g4569gaf61g6944106f1af2"
msgid "You're welcome!"
msgstr "별말씀을!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 3c7506b5-e682-5640-f650-0d02eebbb407
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Pixie_Event_GivesImmunity = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:3c7506b5-e682-5640-f650-0d02eebbb407
msgctxt "h284f070cg050cg425egb38dgbec404250f08"
msgid "Protection from the shadow curse - what more could a dingus want?"
msgstr "그림자 저주로부터의 보호라. 이 멍청이가 뭘 더 바랄 수 있겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Narrator
#. NodeID = 3e026180-6430-401b-6151-2ccc8d355240
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:3e026180-6430-401b-6151-2ccc8d355240
msgctxt "hd14cac37gf4b9g46b9gabe7gb432d03b5ab8"
msgid ""
"*These fey creatures are infamous for their trickery - sometimes playful, "
"sometimes malicious.*"
msgstr "*이 페이 생명체는 장난스러운, 또 가끔은 악의적인 속임수로 악명이 높습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 3e357530-354e-6d45-11bf-ac2d78e1f786
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Pixie_Knows_LanternMechanism = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:3e357530-354e-6d45-11bf-ac2d78e1f786
msgctxt "haf8769c8g2533g46c3g8e9ag8127d9e70a74"
msgid "Son of a - NO! STOP! PLEASE!"
msgstr "이 개새ㄲ... 안돼! 멈춰! 제발!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 3e98a902-381b-f436-9e18-820231989e60
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Pixie_Knows_HowLanternWorks = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:3e98a902-381b-f436-9e18-820231989e60
msgctxt "h635024d2gb3c4g47a6gb974g4aebfdb4c9d6"
msgid "This lantern only lights the way when I am hurting night and day!"
msgstr "하얗게 타오르는 이 등불은 하루 내 날 아프게 한다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 41d3e729-9770-1d1e-f5d3-c4a7eb7eee2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:41d3e729-9770-1d1e-f5d3-c4a7eb7eee2b
msgctxt "hb9ba97deg9c7cg4968g9379ge060c34389a0"
msgid "YOU RAT! Now I've got glass stuck in my loaf!"
msgstr "이 쥐새끼가! 내 대가리에 유리가 박혔잖아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 428356f8-e369-719d-3be3-70aedb857b32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:428356f8-e369-719d-3be3-70aedb857b32
msgctxt "hd6b0a082g3007g4426gb388gdc5f179ad412"
msgid ""
"I dare not name it, newfound friend. The faintest touch could spell my end."
msgstr "함부로 말해줄 순 없어, 새 친구야. 조금만 건드려도 날 끝장낼 수 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 42e26028-3199-1a4f-3bfa-9eeb341a624c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Pixie_State_InsideLantern = False
#.     - GLO_Pixie_Event_Released = True
#.     - SCL_Pixie_State_Furious = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:42e26028-3199-1a4f-3bfa-9eeb341a624c
msgctxt "ha6882fd3ge551g482bg9bcfgfaf1bbd27514"
msgid "<i>Smash the lantern on the ground.</i>"
msgstr "<i>등불을 땅에 패대기친다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Harper Manus
#. NodeID = 42fedbfb-b31f-84cd-8786-3d63370e9d74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:42fedbfb-b31f-84cd-8786-3d63370e9d74
msgctxt "h1fddd651g3030g4a43g8542g5d999a68ed37"
msgid "I'll be damned - I can feel the light clear down to my bones."
msgstr "맙소사 - 빛이 뼛속까지 스며드는 게 느껴집니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 45e3f1a2-9bab-2b91-fde0-93c17c3c931e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:45e3f1a2-9bab-2b91-fde0-93c17c3c931e
msgctxt "hbc2e53a3gfe86g47a4g95d3gdbf7d1756194"
msgid "<i>Turn the mechanism at the base of the lantern.</i>"
msgstr "<i>등불 바닥에 있는 장치를 작동시킨다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 46ab1773-9598-f746-1d54-0dd86460dca1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:46ab1773-9598-f746-1d54-0dd86460dca1
msgctxt "h8012423bgc5c5g4075gb2cfge118e938189f"
msgid "What'll you give me for letting you go?"
msgstr "널 풀어주는 대가로 뭘 줄 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 4744863d-e294-1a3d-2fec-dbc30a100065
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:4744863d-e294-1a3d-2fec-dbc30a100065
msgctxt "h0fa9bc23g7fb3g4456ga7acg353c6e9374a9"
msgid "<i>Turn the mechanism.</i>"
msgstr "<i>장치를 작동시킨다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Narrator
#. NodeID = 4a529143-4c62-e911-b648-c57e9cee8888
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Pixie_InsideLantern_HasMet(1) = True
#.   Global:
#.      - GLO_Pixie_State_InsideLantern = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:4a529143-4c62-e911-b648-c57e9cee8888
msgctxt "h844952e1ge738g477bgb29dgc80bf07e3113"
msgid ""
"*You peer inside the lantern to find the pixie has vanished without a trace.*"
msgstr "*등불 안을 들여다보니 픽시가 흔적도 없이 사라진 것을 발견합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Wyll
#. NodeID = 50b11c3d-a7e8-49e9-937f-83d67f7875b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(10) = True
#.   Tag:
#.      - REALLY_WYLL(10) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:50b11c3d-a7e8-49e9-937f-83d67f7875b1
msgctxt "h0da40076g6991g408aga6bcg37e0c7af2211"
msgid "Poor thing - a life of torture! We should let her go. Shouldn't we?"
msgstr "불쌍한 것. 고통의 삶이라니! 풀어줘야 해. 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 531ee282-da5b-a565-e201-26c94356208d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:531ee282-da5b-a565-e201-26c94356208d
msgctxt "hed53b8fcg00f0g44a5g8919g0ef2ca9ab709"
msgid "Me neither. So let me out, or get ready for the Third Sundering."
msgstr "나도 그렇거든. 그러니 어서 날 풀어주지 않으면 세 번째 대분단을 맛보게 해주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 58180f38-482c-ea41-09fb-384130743fff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:58180f38-482c-ea41-09fb-384130743fff
msgctxt "hf7475bdegb79eg4a8dgba9fgc25dd5fbacef"
msgid "Never give 'em enough rope to hang you."
msgstr "괜히 제멋대로 놔뒀다가 헛짓거리하게 만들면 안 되지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 5aa718af-cc27-4d51-566b-6cd6278456e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:5aa718af-cc27-4d51-566b-6cd6278456e3
msgctxt "hd6150a9fgf68fg4a0fg9454gf09f851b0c87"
msgid "My name? My name is Dolly thrice; now won't you free me from this vice?"
msgstr "나? 내 이름은 돌리 셋이야. 그럼 이제 나를 이 악행으로부터 해방시켜주지 않겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 5e750a74-92c7-c4b1-47bd-d4aae424e571
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Pixie_State_InsideLantern = False
#.     - GLO_Pixie_Event_Released = True
#. TagRule: ROGUE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:5e750a74-92c7-c4b1-47bd-d4aae424e571
msgctxt "h0632f8c9g6457g4b60g9b2cg5f50cafe1c65"
msgid "<i>Quickly unlock the lantern and release the pixie. </i>"
msgstr "<i>재빨리 등불의 잠금 장치를 풀고 픽시를 풀어준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 5e750a74-92c7-c4b1-47bd-d4aae424e571
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Pixie_State_InsideLantern = False
#.     - GLO_Pixie_Event_Released = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:5e750a74-92c7-c4b1-47bd-d4aae424e571
msgctxt "h57006e6dg7e05g4ef3g87dag543c1070a0d5"
msgid "<i>Release the pixie.</i>"
msgstr "<i>픽시를 풀어준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 6325d280-a9f8-3756-4176-dcc082580280
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:6325d280-a9f8-3756-4176-dcc082580280
msgctxt "h5db244d7gcae4g4c82g963fgf88752837bb5"
msgid "Sure I can. But will I?"
msgstr "할 수야 있지만, 내가 그래야만 하나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Narrator
#. NodeID = 688cc803-aa69-035f-0de0-85a486dfe323
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Pixie_State_SeenPixie = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:688cc803-aa69-035f-0de0-85a486dfe323
msgctxt "h946350beg0af7g4f51g960bg12e0ffd8d35e"
msgid "*You notice a tiny pixie trapped within.*"
msgstr "*당신은 작은 픽시가 갇혀 있는 것을 발견합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Harper Lassandra
#. NodeID = 6960114f-512a-ace3-569f-2e3f2f35d452
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_7 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:6960114f-512a-ace3-569f-2e3f2f35d452
msgctxt "h30c70651g0eb0g4a92g8791g440b3884f284"
msgid ""
"A wonder, isn't it? A light so bright, it can pierce even cursed shadows."
msgstr "놀라워요. 그렇지 않습니까? 저주받은 그림자를 꿰뚫을 정도로 밝은 빛이군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 6c9cb2fc-2481-4f41-c81b-0d0903829cd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:6c9cb2fc-2481-4f41-c81b-0d0903829cd4
msgctxt "hc45a9aceg3c44g4029ga707g6915b70a7c30"
msgid "What's on offer?"
msgstr "뭘 해줄 수 있는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 6dba0b70-73dd-a2a2-274d-2a30721cdb3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Pixie_InsideLantern_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:6dba0b70-73dd-a2a2-274d-2a30721cdb3c
msgctxt "hef2bf70dga5bbg4c17ga50fg425200537882"
msgid ""
"<i>I</i> know that <i>you </i>know you're about to let me out of this thing."
msgstr "<i>나도 알고</i>, <i>너도 알아.</i> 네가 곧 이 장치에서 날 풀어줄 거라는 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 6dba0b70-73dd-a2a2-274d-2a30721cdb3c
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Pixie_InsideLantern_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:6dba0b70-73dd-a2a2-274d-2a30721cdb3c
msgctxt "hfac2fb38gcd7ag4365gb5b5g60ed7fd0abea"
msgid "Come on, now. Time to let me out."
msgstr "이리와, 어서. 날 꺼내줄 시간이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 6dba0b70-73dd-a2a2-274d-2a30721cdb3c
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Pixie_InsideLantern_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:6dba0b70-73dd-a2a2-274d-2a30721cdb3c
msgctxt "h7a1cafb6g92a0g4841ga2f4g6b2c8c40c7cd"
msgid "Yoo-hoo! I'm ready to come out now!"
msgstr "유-후! 난 나갈 준비 됐어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 6e3bffbd-cf4e-621f-2756-4b02fc13772a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:6e3bffbd-cf4e-621f-2756-4b02fc13772a
msgctxt "h67a90037gd1f3g47abg9079g6d958b76d28a"
msgid "Freeing you was the right thing to do - you owe me no debt."
msgstr "너를 풀어주는 것은 그 자체로 옳은 일이었어. 내게 빚진 것은 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 6e3bffbd-cf4e-621f-2756-4b02fc13772a
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:6e3bffbd-cf4e-621f-2756-4b02fc13772a
msgctxt "h72ada7e9gf3d6g494fg8522gbfcb117da2ca"
msgid "I know the Feyfolk are used to debts - but you owe me nothing. Be free."
msgstr "페이 친구들은 빚에 익숙하다고 알고 있지만, 내게 진 빚은 없다. 자유로워지거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 6e3bffbd-cf4e-621f-2756-4b02fc13772a
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:6e3bffbd-cf4e-621f-2756-4b02fc13772a
msgctxt "hf9c914e9gd016g4c6bgbf1cge505a7d24b3a"
msgid ""
"Nothing - I know I'd want a shot a revenge if I was trapped. Only fair to "
"free you."
msgstr "그럴 필요 없다. 내가 갇혔다면 복수하고 싶었겠지. 너를 풀어주는 게 공평하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 6e3bffbd-cf4e-621f-2756-4b02fc13772a
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:6e3bffbd-cf4e-621f-2756-4b02fc13772a
msgctxt "hd15253dag731bg480bgb751g7e6b7171470a"
msgid "Everyone deserves their freedom - you owe me nothing."
msgstr "모든 이는 자유로울 권리가 있다. 내게 진 빚은 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 733d5990-7e7b-5327-5fc0-efebf7e3d14f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:733d5990-7e7b-5327-5fc0-efebf7e3d14f
msgctxt "hc3b0adc0gc605g4937gbaa1g8d61950fd0e3"
msgid ""
"Butter wouldn't melt. Well look, I won't have you tracking me down in the "
"Fey looking for tuppence. Let's finish this - fair and square."
msgstr "순진한 척 하시기는. 이봐, 네가 나중에 푼돈이라도 달라고 날 쫓아오는 건 싫거든? 지금 끝을 내자. 공정하고 깔끔하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 76a2d946-a6fe-bf53-b3eb-df218d7bff6f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Pixie_State_SwearingAndScreaming = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:76a2d946-a6fe-bf53-b3eb-df218d7bff6f
msgctxt "h27f6041fg849eg4908g8eecg16e5bbd30072"
msgid "<i>Ignore the pixie; keep the lantern.</i>"
msgstr "<i>픽시를 무시한다. 등불을 집어넣는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Narrator
#. NodeID = 7c6060f9-41b9-a01f-eae7-d874c16c2363
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Dead = True
#. SetFlags:
#.   Global:
#.     - SCL_Drider_Event_HarpersDisappearTowardsInn = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:7c6060f9-41b9-a01f-eae7-d874c16c2363
msgctxt "h121acff7g234fg435eg89a6g943ad5f3025e"
msgid ""
"*You peer inside the lantern and see a tangle of blood, bones, and two "
"broken wings.*"
msgstr "*등불 안을 들여다보니 피와 뼈, 부러진 두 날개가 뒤엉켜 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 7f944b17-c29c-003e-8a5a-42ce51194539
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:7f944b17-c29c-003e-8a5a-42ce51194539
msgctxt "h0820ac1bg2a31g463egbe0bgaa7d474111f4"
msgid "<i>Ignore the pixie; you'll be needing this lamp.</i>"
msgstr "<i>픽시는 무시한다. 앞으로 등불이 필요할 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 811be99d-d624-9d07-20e7-040d0a53c0c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:811be99d-d624-9d07-20e7-040d0a53c0c3
msgctxt "h1714cf77g5368g42a8gb898ge3ce18d762d2"
msgid "Who are you?"
msgstr "넌 누구야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 8bb843b6-0224-ff3f-9359-76577dcfab1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_BhaalResisted = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:8bb843b6-0224-ff3f-9359-76577dcfab1c
msgctxt "h8ea4b4f4g1f44g4e1fg85d5g41e801270095"
msgid "<i>Refuse to crush her. Ask her for help against the shadow curse.</i>"
msgstr "<i>픽시를 뭉개버리길 거부한다. 그림자 저주에 대항할 수 있는 도움을 요청한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Shadowheart
#. NodeID = 94f2831f-0f76-4686-ad1d-b2bc7370bd4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(8) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:94f2831f-0f76-4686-ad1d-b2bc7370bd4b
msgctxt "h08970c5eg647bg4dacg9b61g9d91e491fdf4"
msgid "Hmm, quite clever - and cruel, of course... but creatively so."
msgstr "흠, 꽤나 똑똑하네. 그리고 잔혹하고. 하지만 동시에 창의적이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 9591985b-bcda-91c6-dbfb-d73df618742c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:9591985b-bcda-91c6-dbfb-d73df618742c
msgctxt "hef59bd6bg36ccg470fga989g918d25dc28ce"
msgid "Nothing - my help doesn't come with strings attached."
msgstr "보답은 필요없어. 보상을 바라고 도와준 것은 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = 9822529a-a64a-702e-e693-061e408c2a32
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Pixie_Event_GivesImmunity = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:9822529a-a64a-702e-e693-061e408c2a32
msgctxt "hefabd086g6c73g4dd4gb555g2c3cdcfd9614"
msgid ""
"'Least I'm out of that box. I'd pin that pus-shitting drider's tongue to his "
"nose if I didn't want to get out of here <i>yesterday.</i>"
msgstr ""
"적어도 저 통 속에서는 빠져나왔으니까. 당장이라도 이곳에서 빠져나가고 싶지만 않았어도, 저 고름 싸개 드라이더 새끼 혓바닥이랑 코를 "
"꿰매버렸을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Harper Branthos
#. NodeID = 996a9957-acd6-4b9e-2e2a-c2e9d6b8ea89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:996a9957-acd6-4b9e-2e2a-c2e9d6b8ea89
msgctxt "h48ec1698g86acg433cgb89bga31a4c4f7a9e"
msgid "Be safe. And be brave. We expect no less."
msgstr "조심하세요. 그리고 용감히 맞서세요. 저희에게 보여주신대로요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 9990f990-d99c-23a9-69a0-0a30074e33b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:9990f990-d99c-23a9-69a0-0a30074e33b7
msgctxt "hdb81f0adg9e27g4fb1ga884g855a8de3c10d"
msgid "I don't respond well to threats."
msgstr "날 위협해봤자 별 효과 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 9a7dd096-7ee5-a6a9-d0ed-64ec675e5ed4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:9a7dd096-7ee5-a6a9-d0ed-64ec675e5ed4
msgctxt "h09a7977bg432dg4bdeg91d9g6a5bb2d11ac0"
msgid ""
"<i>A beautiful thing it would be, to end a life in this first moment of "
"freedom.</i>"
msgstr "<i>해방의 순간에 삶을 끝내버리는 건 정말 아름다울 거야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = 9d209dbe-8238-e8c9-844c-85ff860089d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:9d209dbe-8238-e8c9-844c-85ff860089d7
msgctxt "h9d37e3d1gfb31g471cgbf73gf060919b1fbc"
msgid ""
"This is abhorrent, twisted magic. I'm sorry you've been put through this."
msgstr "끔찍하고 뒤틀린 마법이군. 이런 일을 겪다니 유감이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = a178cdbc-06db-9a8f-48a3-9622fe08886f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:a178cdbc-06db-9a8f-48a3-9622fe08886f
msgctxt "hb7f8318cgbc48g42c8gaf16gd6f02d32aeb5"
msgid ""
"Dolly thanks you for your sympathy; now, druid kind, please set me free!"
msgstr "돌리는 당신의 동정에 감사드린답니다. 그럼 이제, 드루이드 친구여, 날 풀어줘!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = a33c0375-c8ac-223c-7282-c9b696fb6152
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:a33c0375-c8ac-223c-7282-c9b696fb6152
msgctxt "hd2f7271cgd4a5g4fdcgbe06gea0ecc52dadf"
msgid "Enjoy, crack-cheese!"
msgstr "즐거운 시간 보내, 치즈 쪼가리!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Harper Manus
#. NodeID = a6275cab-38b8-7265-b4c2-31073528a578
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:a6275cab-38b8-7265-b4c2-31073528a578
msgctxt "h2320f2dfg5da9g495cgb694g27f818fa6a32"
msgid "Farewell, then. And may the path to the Towers rise to meet you."
msgstr "그럼 안녕히 가세요. 타워로 향하는 길이 여러분을 비추길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = a88f7119-46d3-f22c-1845-8c996ab35fb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:a88f7119-46d3-f22c-1845-8c996ab35fb5
msgctxt "h680dc4fegdb5dg4818gb693ga0b258c92a95"
msgid "If you prefer the kinder type, I'll sweetly slurp your guts like tripe!"
msgstr "좀 더 친절한 응대를 원한다면, 네 창자를 국수처럼 마셔주겠어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = adddc4c8-d6ad-5ca5-15cf-cbe6df8e84a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:adddc4c8-d6ad-5ca5-15cf-cbe6df8e84a8
msgctxt "h59826dbbga168g4da3ga76fg198ecb6f8b75"
msgid "Yeah, sure. Why not."
msgstr "뭐, 그래. 안 될 건 뭐람."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = b2773820-61ad-6ee7-e6c9-8c882e7cee5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. SetFlags:
#.   Object:
#.     - SCL_Pixie_Event_ApplyCurse(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:b2773820-61ad-6ee7-e6c9-8c882e7cee5b
msgctxt "h50ab0797gb30dg4053gac87gb99e1f211176"
msgid ""
"And one more thing: you really oughta learn not to mess with the fey. We'll "
"mess you right back."
msgstr "그리고 한 가지 더. 앞으로 페이와 장난치지 않는 것이 좋을 거야. 우리는 바로 되갚아주거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = b2a301e6-820f-073c-0476-421e450dee33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_EVIL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:b2a301e6-820f-073c-0476-421e450dee33
msgctxt "ha460c8e0g54edg4809ga0bcgee6c0d6579b5"
msgid "Sounds fun."
msgstr "재미있을 거 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Narrator
#. NodeID = b2a955b6-664f-8ba3-c671-8e8084ae74c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:b2a955b6-664f-8ba3-c671-8e8084ae74c6
msgctxt "h60980348ga4d1g40a8gadfdg1e29776a7682"
msgid ""
"*The mechanism at the lantern's base would usually govern brightness, but "
"seems designed here to crush the pixie painfully.*"
msgstr ""
"*일반적으로 등불 바닥에 있는 장치는 밝기를 조절하는 용도이지만, 이 등불의 경우에는 픽시를 고통스럽게 짓이기기 위해 설계된 것 "
"같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = b2af38c3-2da1-7219-5054-a8c419e7a820
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:b2af38c3-2da1-7219-5054-a8c419e7a820
msgctxt "h26d03b75g44deg4e47g9b96g446cba0bc17e"
msgid "NO! NO! NO!"
msgstr "<b>안돼! 안돼! 안돼!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = b579e709-e099-4a9b-997d-02a93179715a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:b579e709-e099-4a9b-997d-02a93179715a
msgctxt "haf9cca88gc0dfg4fd8g8008g093d2ca04bf5"
msgid "My pixie dust is bright as day; my injuries can light the way."
msgstr "대낮처럼 빛나는 내 픽시 가루, 대쪽같은 고통이 길을 밝히네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = b81a3aaa-d140-8848-ef2d-31d789bf3178
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:b81a3aaa-d140-8848-ef2d-31d789bf3178
msgctxt "ha72642c4g3d39g4b91g90eag44f18eb9f2ff"
msgid ""
"I need protection from this curse. If I release you, will you help me travel "
"through the shadows?"
msgstr "이 저주로부터 보호가 필요해. 널 풀어주면 그림자 속을 탐험하는 것을 도와주겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = b9bf303b-e40d-228e-23d4-96a5ace74667
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:b9bf303b-e40d-228e-23d4-96a5ace74667
msgctxt "h0a31fc3fgee0dg44dfgbcc8g77f5037660fa"
msgid "What's this mechanism at the base of the lantern?"
msgstr "이 등불은 어떤 원리로 작동하는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Gale
#. NodeID = bb2c057f-bd52-4d9a-ad18-f557d12fc010
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(11) = True
#. SetFlags:
#.   Object:
#.     - ORI_Inclusion_PickedAtRandom(11) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:bb2c057f-bd52-4d9a-ad18-f557d12fc010
msgctxt "h98169e02g70dbg4ed8g9903g620678b431f4"
msgid ""
"Cruelty and cleverness are all too common bedfellows. Let's side with "
"cleverness alone, shall we? See what we can do to save this verse-loving "
"pixie."
msgstr ""
"잔혹함과 영리함은 너무도 흔한 동반자이지. 이번엔 영리함의 손을 들어줄까? 이 시를 사랑하는 픽시를 구하기 위해 할 수 있는 일을 "
"찾아보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Narrator
#. NodeID = bdc82925-9a0d-25e0-a6ff-65ea78dc529e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Pixie_InsideLantern_HasMet(1) = False
#.   Global:
#.      - GLO_Pixie_State_InsideLantern = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:bdc82925-9a0d-25e0-a6ff-65ea78dc529e
msgctxt "h32db6a1fg79b5g4ea1g9fceg627c5d3a0dbe"
msgid ""
"*You peer inside the Moonlantern; it's dull inside, like whatever made it "
"glow has vanished.*"
msgstr "*당신은 달등불 안을 들여다봅니다. 등불을 빛나게 했던 무언가가 사라진 것처럼 침침합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = c26ffa59-e050-de23-4f1c-682bdbda1566
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:c26ffa59-e050-de23-4f1c-682bdbda1566
msgctxt "hc3d6fefeg29a0g4cedgb9b8g44a57a39b512"
msgid "Oh please, oh golly, me-oh-my, you must release me or I'll die!"
msgstr "오 제발, 오 맙소사, 세상에, 날 풀어주지 않으면 죽어버릴 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = cb21ca28-75ba-6ffa-422e-dd44f13eff3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_Pixie_State_InsideLantern = False
#.     - GLO_Pixie_Event_Released = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:cb21ca28-75ba-6ffa-422e-dd44f13eff3d
msgctxt "h18ba486cg258cg4efdg91d0g824f9f2840f1"
msgid "Used for the magic within you... Disgusting."
msgstr "너에게 사용된 마법... 역겹군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = cb250980-4a52-24eb-3211-08901f92d41b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:cb250980-4a52-24eb-3211-08901f92d41b
msgctxt "hd7fc333bgd56ag4e50gb603gb205801ab102"
msgid "Whatever... you... wish..."
msgstr "네가... 바라는...무엇이든..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Harper Branthos
#. NodeID = cbad10cf-a525-62b9-e321-7bab232eff74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:cbad10cf-a525-62b9-e321-7bab232eff74
msgctxt "h0981012fgc891g42ccg9585gdf3f7fa81c0a"
msgid ""
"Incredible magic. I can feel the light lifting the shadows - even those "
"within me."
msgstr "놀라운 마법입니다. 빛이 그림자를 걷어내는 것이 느껴집니다. 심지어 제 안의 그림자마저."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = ce9ba432-03d1-711f-b281-80b795f3d253
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_GOOD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:ce9ba432-03d1-711f-b281-80b795f3d253
msgctxt "h1c8c10aage48fg425ag9a93g49cfe97b2749"
msgid "You poor thing, why would someone hurt you so?"
msgstr "불쌍한 것, 누가 어째서 널 해친거니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Harper Lassandra
#. NodeID = cfa9ac59-0d60-013b-55b5-66de5678718e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_7 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:cfa9ac59-0d60-013b-55b5-66de5678718e
msgctxt "h8f224363g2804g46b8g81d9g45137732ef05"
msgid ""
"Farewell - and thank you, for giving us hope. It's almost as rare as the "
"lantern you're holding."
msgstr "잘 가세요, 그리고 우리에게 희망을 주셔서 감사합니다. 저희에게는 지금 들고 계신 등불만큼이나 희귀한 것입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = d041209f-9b71-21a9-5efe-3c7ef4cfb5b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_Knows_LanternMechanism = True
#. SetFlags:
#.   Global:
#.     - SCL_Pixie_State_Dead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:d041209f-9b71-21a9-5efe-3c7ef4cfb5b1
msgctxt "h764e1e39gdb6dg4873gb51ag686610294c4b"
msgid "Ahh... ehh... nnnggghh..."
msgstr "아아아아악..! 으에... 으으..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = d18c9962-8a25-eb59-9d74-49a2c7f40e96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:d18c9962-8a25-eb59-9d74-49a2c7f40e96
msgctxt "h935a3704gf374g43deg9557g7f397539f3cd"
msgid "I know you Fey deal in favours. What do I get for freeing you?"
msgstr "페이가 호의를 베풀 수 있는 건 알아. 널 풀어주면 뭘 얻을 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Narrator
#. NodeID = d81d78a0-8bd9-d02f-16d8-18ebbfa6959d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:d81d78a0-8bd9-d02f-16d8-18ebbfa6959d
msgctxt "ha7517616g353cg40c1gae30g90fdda5fca10"
msgid "*Would you be happy if you were freed from yourself?*"
msgstr "*당신도 당신 자신으로부터 해방된다면 행복해질까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = d8210217-2e8d-c81a-0321-6b6b734e2f4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_EVIL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:d8210217-2e8d-c81a-0321-6b6b734e2f4f
msgctxt "hbd13cd0ag9835g4253ga72cgbbb13be64d40"
msgid "You're in pain? Delightful. How does it work?"
msgstr "고통스럽다고? 거 아주 듣기 좋은 소린데. 어떤 식으로 작동하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Harper Skywin
#. NodeID = de06d9c5-4099-7a83-5837-0580436c6e2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_6 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:de06d9c5-4099-7a83-5837-0580436c6e2a
msgctxt "h27c29395gddd5g41f6ga994g03004f982e4a"
msgid "Beautiful. As if the light of the moon has been captured within."
msgstr "아름답습니다. 마치 달빛을 그대로 담고 있는 듯합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = df2adf28-10f1-f978-d7e8-010d799035f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:df2adf28-10f1-f978-d7e8-010d799035f6
msgctxt "h2b1922a7gf181g4878gb5f4ge7400ed58b13"
msgid "Don't. You. Dare."
msgstr "감히. 날. 무시하다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Harper Elindale
#. NodeID = df521405-dcff-8dbf-fe03-0c149cb38126
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:df521405-dcff-8dbf-fe03-0c149cb38126
msgctxt "ha14b72ddg0c6ag4954gb0e1g4efdf46aac6b"
msgid ""
"Good bye, and good fortunes. And do return to Last Light, should you need "
"space to breathe."
msgstr "잘 가십시오. 그리고 행운을 빕니다. 숨 돌릴 곳이 필요하시면 최후의 빛 여관으로 돌아오세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = e02f6ed0-4cb1-9977-7af7-0813a42cb1c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:e02f6ed0-4cb1-9977-7af7-0813a42cb1c1
msgctxt "h25a82fdfgf934g4cd2g8903g6e03d73f2599"
msgid "<i>Ignore the pixie. You'll be needing this lamp.</i>"
msgstr "<i>픽시를 무시한다. 이 등불이 필요할 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = e2020015-4e3e-121d-be17-006e33395016
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:e2020015-4e3e-121d-be17-006e33395016
msgctxt "h7ce3661egb8a5g48e6gbe37gf61f5d475a66"
msgid "What kind of torture device is this?"
msgstr "이 고문 장치가 뭘 하는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Astarion
#. NodeID = e7d4d6cf-70af-424d-8de6-19e586b52c7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(12) = True
#.   Tag:
#.      - REALLY_ASTARION(12) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:e7d4d6cf-70af-424d-8de6-19e586b52c7d
msgctxt "ha032485bgeebbg480agac9dg825105669c69"
msgid "Seems like a fitting punishment for a poet."
msgstr "시인에게 잘 어울리는 형벌인 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = ea50564a-15f5-dc22-5269-5b4bfe340e7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:ea50564a-15f5-dc22-5269-5b4bfe340e7c
msgctxt "h6d60966eg7b6fg46f4g90a5gd94e97aeb7c9"
msgid "It would be my pleasure - truly! Once I'm freed I'll help you duly."
msgstr "당연하지, 정말로! 나를 풀어주면 적절한 때에 널 도울게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = ebe4a5a2-d112-cee3-fb57-4e0502d0e959
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - SCL_Pixie_Event_GiveBell(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:ebe4a5a2-d112-cee3-fb57-4e0502d0e959
msgctxt "h25677135g18b0g464ag827bg1883f91b6a41"
msgid ""
"Here. Give this bell a shake, speak the magic words, and you'll get what "
"you've earned."
msgstr "여기. 이 종을 흔들고, 마법의 주문을 외워봐. 그러면 원하는 걸 얻을 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = edb14191-ecba-0b6b-26b5-2ef41e6b9ced
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:edb14191-ecba-0b6b-26b5-2ef41e6b9ced
msgctxt "hc86541b5g859cg4139g960bgebd5b288298c"
msgid "Dolly thanks you for your sympathy; now, sorcerer kindly set me free!"
msgstr "돌리는 당신의 동정에 감사드린답니다. 그럼 이제, 친절한 소서러여, 날 풀어줘!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Dolly Dolly Dolly
#. NodeID = eddad227-59d2-20c4-9ba1-d4518de57a70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:eddad227-59d2-20c4-9ba1-d4518de57a70
msgctxt "h4d956c2fg3536g4760g9b45ge2b275ca31f0"
msgid "Did me a good turn there, didn't you. What do I owe you?"
msgstr "내게 친절을 베풀었구나. 어떻게 보답해줘야 할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = f59871a2-62bd-c53d-a97c-14b0287a67c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_BhaalResisted = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:f59871a2-62bd-c53d-a97c-14b0287a67c2
msgctxt "h03b52c80gbed6g4d79gbef5gfe61c62de65f"
msgid "I need to get through this shadow curse. Can you help?"
msgstr "그림자 저주를 뚫고 나가야 해. 도와줄 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = f6349497-21fe-cc13-2ba9-f8bb37ef6cc8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:f6349497-21fe-cc13-2ba9-f8bb37ef6cc8
msgctxt "h44f996b5gfb85g45bfga712gc891ada64a84"
msgid "<i>Study the mechanism keeping the pixie trapped. </i>"
msgstr "<i>픽시를 가두고 있는 장치의 작동 원리를 조사해본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = fa518c2b-7590-a36c-e140-41302b71514b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:fa518c2b-7590-a36c-e140-41302b71514b
msgctxt "h6cb51bd9gdfc5g4aceg82cdgde29197c44d9"
msgid ""
"Legends tell of the Fey trapping people - not the other way around. Why are "
"you in here?"
msgstr "페이가 사람을 가둬놓는다는 전설은 들어봤는데, 그 반대가 아니라. 왜 갇혀 있는 거니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = fb37c5ed-2e9c-e619-e933-d88c4e5482e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:fb37c5ed-2e9c-e619-e933-d88c4e5482e6
msgctxt "hebf02cfcga94fg41c2gafb6g97ecfecef222"
msgid "Gutted many ten-day-olds in your day?"
msgstr "너는 얼마나 많이 찢겼길래 그렇게 쪼그마한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Player
#. NodeID = fded5cf4-0b9f-f1ab-f9f4-b5056777dc06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:fded5cf4-0b9f-f1ab-f9f4-b5056777dc06
msgctxt "h332dceacgade7g4ea0g9cf7gc1a5d9b88a4e"
msgid "My, you've changed your tune."
msgstr "이런, 목소리가 바뀌셨네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern
#. Speaker = Narrator
#. NodeID = ff6bbbcd-7140-8f01-d16a-50389ff621e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_InsideLantern:ff6bbbcd-7140-8f01-d16a-50389ff621e4
msgctxt "h889af704gad1cg4ae1ga787gf5ed54c7b75a"
msgid ""
"*However, the lock trapping this creature seems simple - crude, even. The "
"fuel inside must be changed relatively often.*"
msgstr "*이 생물을 가두고 있는 잠금 장치는 단순하지만, 잔인합니다. 등불의 연료는 자주 교체되고 말 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 467b6366-3b2d-3bf2-d0b4-7c06ec87af02
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:467b6366-3b2d-3bf2-d0b4-7c06ec87af02
msgctxt "h87692717ga3fdg40b6g9f52g60f66214745a"
msgid "And she has such a way with words."
msgstr "게다가 그녀는 말도 잘하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 467b6366-3b2d-3bf2-d0b4-7c06ec87af02
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:467b6366-3b2d-3bf2-d0b4-7c06ec87af02
msgctxt "h7e34d866g541ag4242g8ff4g8736600088aa"
msgid "She'd put a sailor to shame with that mouth."
msgstr "저 정도 입담이면 선원 일을 해도 잘하겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 467b6366-3b2d-3bf2-d0b4-7c06ec87af02
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:467b6366-3b2d-3bf2-d0b4-7c06ec87af02
msgctxt "h3d518517g9360g4abag8b1fgb26f882f9218"
msgid "Little wings, big mean mouth."
msgstr "날개는 부드러운데 입은 거친 녀석이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 467b6366-3b2d-3bf2-d0b4-7c06ec87af02
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:467b6366-3b2d-3bf2-d0b4-7c06ec87af02
msgctxt "h9e85df7fg0a97g4effgabd2g3c9c07f2c04b"
msgid "Are they all so... eccentric, I wonder?"
msgstr "다들 그렇게... 특이한가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 467b6366-3b2d-3bf2-d0b4-7c06ec87af02
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:467b6366-3b2d-3bf2-d0b4-7c06ec87af02
msgctxt "hcccb2b32ga1cdg4e94gbcbbg9e54a4de7e67"
msgid ""
"We do get to see some interesting things. Almost makes the mortal peril "
"worth it. <i>Almost</i>."
msgstr "흥미로운 것들을 보게 되는군. 어느 정도는 필멸의 위험을 감수할 만한 가치가 있어. <i>어느 정도는</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 467b6366-3b2d-3bf2-d0b4-7c06ec87af02
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:467b6366-3b2d-3bf2-d0b4-7c06ec87af02
msgctxt "h1d3eca0fg4918g4f87g9da3g281a3461dcb2"
msgid "She's cute as a bug - and not much bigger."
msgstr "마치 벌레처럼 귀엽군, 크기도 비슷하고 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 467b6366-3b2d-3bf2-d0b4-7c06ec87af02
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:467b6366-3b2d-3bf2-d0b4-7c06ec87af02
msgctxt "hfe73e84dgf5b9g4e37ga63ag0fc7db8ef503"
msgid "Not what I expected to run into in a place like this."
msgstr "이런 곳에서 마주칠 줄은 몰랐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 683ac585-a316-4412-904b-89873566692f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:683ac585-a316-4412-904b-89873566692f
msgctxt "he735d335g9940g4311g99aega7eb61e07ae4"
msgid "A pixie! An honest-to-goodness pixie..."
msgstr "저건... 픽시잖아! 정말, 진짜 픽시라니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 683ac585-a316-4412-904b-89873566692f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:683ac585-a316-4412-904b-89873566692f
msgctxt "hcb54768cg8d37g4542g9ae0geae274797217"
msgid "My, a pixie."
msgstr "이것 봐라, 픽시잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 683ac585-a316-4412-904b-89873566692f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:683ac585-a316-4412-904b-89873566692f
msgctxt "hf876dc4fgc396g4f7agb90cg4acf6739b14e"
msgid "A pixie! Ooh, neat!"
msgstr "픽시다! 요 아기자기한 것 좀 봐!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 683ac585-a316-4412-904b-89873566692f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:683ac585-a316-4412-904b-89873566692f
msgctxt "h39fa1f3eg12adg454agb8d2g05190781ea3c"
msgid "That pixie's a feisty little thing."
msgstr "저 픽시는 조그만 게 야무지군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 683ac585-a316-4412-904b-89873566692f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:683ac585-a316-4412-904b-89873566692f
msgctxt "h62f3172cg2bb4g4205gb23fgd30fe4c48542"
msgid "Hmm, a pixie. A rather quaint little find."
msgstr "흐음, 픽시네. 꽤 신기한 걸 찾았잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 683ac585-a316-4412-904b-89873566692f
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:683ac585-a316-4412-904b-89873566692f
msgctxt "hcd1eb7ceg847ag45ebgab80g33e5f18891f8"
msgid "Hm - that pixie's a peculiar little thing."
msgstr "흠, 이 조그만 픽시는 신기하게도 생겼네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 683ac585-a316-4412-904b-89873566692f
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:683ac585-a316-4412-904b-89873566692f
msgctxt "he0815a96g6452g47d2g8604g3a4d0c17f35e"
msgid "Hmm, a pixie. Curious little thing."
msgstr "흠, 픽시네. 조그만 게 신기하기도 해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 70438072-dfc8-21dd-b267-aa9813cc411a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:70438072-dfc8-21dd-b267-aa9813cc411a
msgctxt "h4413d843g2c6bg4c15g90e8gf6c264700bed"
msgid "That was an actual pixie! An adorable, furious pixie."
msgstr "진짜 픽시잖아! 사랑스럽고, 열받은 픽시야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 70438072-dfc8-21dd-b267-aa9813cc411a
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:70438072-dfc8-21dd-b267-aa9813cc411a
msgctxt "h1474f6c6gdefeg4841g86e3gb693894bf569"
msgid "My, what an angry little pixie. She's practically turning the air blue."
msgstr "이런, 화가 잔뜩 난 픽시일세. 욕을 무지하게 하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 70438072-dfc8-21dd-b267-aa9813cc411a
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:70438072-dfc8-21dd-b267-aa9813cc411a
msgctxt "h40149668g0926g4673ga697gfcb97e4e23a4"
msgid "Fierce thing. Bet she could turn me inside out if she wanted."
msgstr "사나운 녀석이네. 마음만 먹으면 날 뒤집어 놓을 수도 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 70438072-dfc8-21dd-b267-aa9813cc411a
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:70438072-dfc8-21dd-b267-aa9813cc411a
msgctxt "h98e0fecdg0399g4d81g8d50g6323be9ae231"
msgid "Feisty little thing, that pixie. I respect the moxie."
msgstr "야무진 꼬마 픽시군. 그 당돌함이 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 70438072-dfc8-21dd-b267-aa9813cc411a
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:70438072-dfc8-21dd-b267-aa9813cc411a
msgctxt "h77c41d55g8d11g4621ga4f2gbd481e900187"
msgid "What an angry little pixie. Sort of adorable, really."
msgstr "화난 꼬마 픽시라. 뭔가 귀엽네, 정말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 70438072-dfc8-21dd-b267-aa9813cc411a
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:70438072-dfc8-21dd-b267-aa9813cc411a
msgctxt "hddc5e04bgb705g406agb195g1f0cdfa49917"
msgid "One small pixie. One big mouth."
msgstr "몸집은 작으면서 엄청난 수다쟁이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = 70438072-dfc8-21dd-b267-aa9813cc411a
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:70438072-dfc8-21dd-b267-aa9813cc411a
msgctxt "h046116f0g8001g4800g8e4cg59504ffc4705"
msgid "What an angry little creature that pixie is."
msgstr "화난 꼬마 생명체가 픽시라니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
msgctxt "h54b79acbgc946g4fe3gb92bg60ed5b05272c"
msgid "Well, she was a <i>delight</i>."
msgstr "정말이지, 이 픽시는 <i>유쾌</i>하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
msgctxt "hfd9c1e5cgbd9fg4ef0ga9c8gd8bdeffdd2eb"
msgid "A pixe. What a darling little ruffian."
msgstr "픽시구나. 정말 사랑스러운 꼬마 악당이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
msgctxt "he1c4acacg6137g49a6g83d4gebf961208e71"
msgid "A pixie! Neat. Never met one before."
msgstr "픽시야! 멋지네. 한 번도 본 적 없는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
msgctxt "h1a474e6dgc403g402ag8f67gfafa37b734bf"
msgid "A pixie. Are they all so... eccentric, I wonder?"
msgstr "픽시라. 다들 그렇게... 특이한 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
msgctxt "h0e728eceg7783g4ef8g8bbeg1d22946f0c3a"
msgid "Hmm, a pixie. A rather quaint little find, for a place like this."
msgstr "흠, 픽시군. 이런 곳에서 발견되다니 좀 신기하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
msgctxt "h2d611a0cg18dbg43dfg9e14g7200545e2081"
msgid "A pixie. Adorable little thing, isn't she?"
msgstr "픽시야. 조그만한 게 사랑스럽지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:b70d84bf-2b03-4297-f9c1-1fd3f63dfebb
msgctxt "h242dd90eg06a2g4559g8e7eg2cb8ce7dce8c"
msgid "Hmm, a pixie. Not what I expected to run into in these parts."
msgstr "흠, 픽시구나. 이런 곳에서 만날 줄은 몰랐는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = c0f9e6de-ba23-4492-a0a3-adb319750802
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:c0f9e6de-ba23-4492-a0a3-adb319750802
msgctxt "h3ccb5bc4g5545g46a0gadc2g016e7b63aa35"
msgid "A pixie's stature, but an ogre's temper. Incredible."
msgstr "픽시의 키에 오우거의 성질머리라니. 놀랍기도 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = c0f9e6de-ba23-4492-a0a3-adb319750802
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:c0f9e6de-ba23-4492-a0a3-adb319750802
msgctxt "h33a56567ge656g48eegad32geb4796336c6d"
msgid "Feisty little darling, isn't she?"
msgstr "아주 거침없는 작은 귀염둥이네, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = c0f9e6de-ba23-4492-a0a3-adb319750802
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:c0f9e6de-ba23-4492-a0a3-adb319750802
msgctxt "hf31ed902g5c55g49a3g888eg3af1848ebdcb"
msgid "Lots of bark. Bet she's got a good bite too."
msgstr "성깔 있는데. 그만큼 실력도 좋을 것 같은걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = c0f9e6de-ba23-4492-a0a3-adb319750802
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:c0f9e6de-ba23-4492-a0a3-adb319750802
msgctxt "hc59deaddg0463g4a26g8448gb7529d018bc7"
msgid "A feisty morsel, isn't she? I respect the moxie."
msgstr "조그만 게 야무진 것 같지 않아? 그 당돌함이 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = c0f9e6de-ba23-4492-a0a3-adb319750802
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:c0f9e6de-ba23-4492-a0a3-adb319750802
msgctxt "h9631a4bagedd9g4166g85e0gb6b99462b729"
msgid "She's an angry little thing. Sort of adorable, really."
msgstr "조그만 게 화내는 것 좀 봐. 뭐, 좀 귀여운 것 같기도 하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = c0f9e6de-ba23-4492-a0a3-adb319750802
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:c0f9e6de-ba23-4492-a0a3-adb319750802
msgctxt "ha2c0d827gdc3ag402fgad94g8409523fb73b"
msgid "For such a small thing, she's got one big mouth."
msgstr "저렇게 작은 녀석이, 입 하나는 되게 험하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie
#. Speaker = Player
#. NodeID = c0f9e6de-ba23-4492-a0a3-adb319750802
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Pixie_State_Furious = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Pixie_PAD_ReactionToPixie:c0f9e6de-ba23-4492-a0a3-adb319750802
msgctxt "h4ad4eb3bg33f6g403eg98e9g660d184405d3"
msgid "Angry little creature, isn't she?"
msgstr "귀여운 게 화는 잔뜩 나 있구만?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = 160d0940-ebc3-436b-bcc2-362956a85059
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:160d0940-ebc3-436b-bcc2-362956a85059
msgctxt "h4aeabdedg4c25g4df9ga02dg6b45fb0c9b2c"
msgid "Bad enough to die, but to die in a place like this?"
msgstr "그냥 죽는 것도 나쁜 일인데, 이렇게 비참히 죽다니. 윽."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = 160d0940-ebc3-436b-bcc2-362956a85059
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:160d0940-ebc3-436b-bcc2-362956a85059
msgctxt "hc4e3b2d6g510bg44abg86fcgc9a8abb363d5"
msgid "The darkness is brutal. I'm not surprised they perished."
msgstr "어둠이 정말이지 포악하군. 이런 죽음이 놀랍지는 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = 160d0940-ebc3-436b-bcc2-362956a85059
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:160d0940-ebc3-436b-bcc2-362956a85059
msgctxt "h40e227edg492ag479fgb802gea8b0f93d122"
msgid "Poor souls. They can rest now."
msgstr "가엾은 영혼들. 이젠 편히 쉴 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = 160d0940-ebc3-436b-bcc2-362956a85059
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:160d0940-ebc3-436b-bcc2-362956a85059
msgctxt "h1abb06b2g4372g46deg8c4agfef5971be188"
msgid "Poor wretches. A sorry end."
msgstr "가엾은 것들. 안타까운 죽음이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = 160d0940-ebc3-436b-bcc2-362956a85059
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:160d0940-ebc3-436b-bcc2-362956a85059
msgctxt "he636e7efg5776g438fg8cb0gb51abceb9bdd"
msgid "Gods. How many lives have these shadows taken?"
msgstr "맙소사. 그림자들이 얼마나 많은 목숨을 앗아간 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = 160d0940-ebc3-436b-bcc2-362956a85059
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:160d0940-ebc3-436b-bcc2-362956a85059
msgctxt "h958846fdgdfa6g446aga43bg5a0df953d68f"
msgid "Rest in peace, my friends. I hope a better life awaits you."
msgstr "편히 잠들길, 나의 친구들이여. 더 나은 삶이 기다리고 있길 바래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = 160d0940-ebc3-436b-bcc2-362956a85059
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:160d0940-ebc3-436b-bcc2-362956a85059
msgctxt "h5bab109ag97fdg416bg8241gb62aa6a8fa6d"
msgid "Petty brigands still prey on the weak, even here."
msgstr "여전히 약자들이 사냥당하고 있군, 이곳마저도 말일세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = 160d0940-ebc3-436b-bcc2-362956a85059
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:160d0940-ebc3-436b-bcc2-362956a85059
msgctxt "hf11bb84dg22aeg4d80g8beeg863d67ea46a7"
msgid "Poor souls. They met a cruel end."
msgstr "불쌍한 영혼들. 잔인한 최후를 맞았군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = 160d0940-ebc3-436b-bcc2-362956a85059
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:160d0940-ebc3-436b-bcc2-362956a85059
msgctxt "h2d503ad7g35f7g49e7g9416g2f30424abae6"
msgid "A bad way to go."
msgstr "참 열악한 죽음이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = f9720ad4-3d26-47e4-7543-558b0cc26721
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_PlunderedCaravan_State_PassedKidnapInvestigation = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:f9720ad4-3d26-47e4-7543-558b0cc26721
msgctxt "h98781a0eg2a7eg4241g8985g106a690ff052"
msgid "Signs of a struggle. For all the good it did them."
msgstr "몸부림친 흔적이군. 별 소득은 없었겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = f9720ad4-3d26-47e4-7543-558b0cc26721
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_PlunderedCaravan_State_PassedKidnapInvestigation = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:f9720ad4-3d26-47e4-7543-558b0cc26721
msgctxt "hed295613g9443g45cdg97c8ga721bf0cc8d3"
msgid "Signs of struggle. They did not meet a pleasant end."
msgstr "몸부림친 흔적이다. 그다지 좋은 최후를 맞진 못한 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = f9720ad4-3d26-47e4-7543-558b0cc26721
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_PlunderedCaravan_State_PassedKidnapInvestigation = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:f9720ad4-3d26-47e4-7543-558b0cc26721
msgctxt "he9195dc1gc79eg4a96gb2a6gb553e3010b0d"
msgid "Seems like they put up a struggle - in vain."
msgstr "이들은 필사적으로 몸부림쳤던 것 같지만, 다 허사였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = f9720ad4-3d26-47e4-7543-558b0cc26721
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_PlunderedCaravan_State_PassedKidnapInvestigation = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:f9720ad4-3d26-47e4-7543-558b0cc26721
msgctxt "h35b1673fg7ad3g4e8fg9c55g6448c3c650b5"
msgid "Looks like they lost a fight."
msgstr "이 사람들, 전투에서 패했나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = f9720ad4-3d26-47e4-7543-558b0cc26721
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_PlunderedCaravan_State_PassedKidnapInvestigation = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:f9720ad4-3d26-47e4-7543-558b0cc26721
msgctxt "hb098b3f2g18dag4752gbc50gb6a2e8e36fc4"
msgid "Whatever killed them, look like they put up a fight."
msgstr "누구 손에 죽임당했든, 이들은 끝까지 싸움을 벌였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = f9720ad4-3d26-47e4-7543-558b0cc26721
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_PlunderedCaravan_State_PassedKidnapInvestigation = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:f9720ad4-3d26-47e4-7543-558b0cc26721
msgctxt "hf58cc373g5f86g4887gb46dg5c1caad2c360"
msgid ""
"There was a struggle here. These people didn't want to go - wherever they "
"were taken."
msgstr "맞서 싸운 흔적이 있어. 어디로 끌려갔든, 이 사람들은 떠나고 싶지 않았을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = f9720ad4-3d26-47e4-7543-558b0cc26721
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_PlunderedCaravan_State_PassedKidnapInvestigation = True
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:f9720ad4-3d26-47e4-7543-558b0cc26721
msgctxt "hd25e7f26g7a0dg43a5g935dga6cc8ea560f7"
msgid "They put up a fight - and died for it."
msgstr "이들은 맞서 싸웠고, 죽임당했군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = f9720ad4-3d26-47e4-7543-558b0cc26721
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_PlunderedCaravan_State_PassedKidnapInvestigation = True
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:f9720ad4-3d26-47e4-7543-558b0cc26721
msgctxt "hf515797bg7cd7g427fg9454g289f71c63dcb"
msgid "They met a cruel end - but it looks as though they put up a fight."
msgstr "끔찍한 최후를 맞긴 했지만, 이들은 끝까지 싸우려 했던 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping
#. Speaker = Player
#. NodeID = f9720ad4-3d26-47e4-7543-558b0cc26721
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_PlunderedCaravan_State_PassedKidnapInvestigation = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedKidnapping:f9720ad4-3d26-47e4-7543-558b0cc26721
msgctxt "hc9e4f750gd9b3g4cbbg9bb7gbfa4e392e52f"
msgid "Looks like there was a struggle here."
msgstr "여기 맞서 싸운 흔적이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedOx
#. Speaker = Player
#. NodeID = 8c6b213c-f3a7-4e02-8026-ed2aa14276d5
#. HandlePath = TaggedText[0].TagText[0]
