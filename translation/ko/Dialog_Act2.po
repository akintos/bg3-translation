msgctxt "hc499c40eg53c0g47fbg9019g146ff7a34e36"
msgid "She didn't speak a lie: The aasimar is immortal."
msgstr "거짓말을 하진 않았군. 아시마르는 불멸의 존재야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
