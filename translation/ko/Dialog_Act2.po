msgctxt "h026dd8b6gb49fg4a61g9b40ga4dafdc4b382"
msgid "Welcome back, True Soul."
msgstr "돌아온 걸 환영하네, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider
#. Speaker = Player
#. NodeID = 297eb1d4-b617-5623-f08d-72cd1aedf1f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider:297eb1d4-b617-5623-f08d-72cd1aedf1f3
msgctxt "h345155c2g4478g4e6fg9e96g81fdc6532aba"
msgid "Absolute's blessings."
msgstr "절대자님의 축복을."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider
#. Speaker = Adept Merim
#. NodeID = 3ee3fea3-ad69-9789-f954-b0386d96d4fa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_Drider_Event_MoveUpToChapel = True
#.     - MOO_EntranceCheckpoint_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider:3ee3fea3-ad69-9789-f954-b0386d96d4fa
msgctxt "h7b8941dbgdde8g4bc7g8644g08115634db6d"
msgid "Disciple Z'rell's in the great hall. She'll be wanting to see you."
msgstr "신봉자 즈렐 님은 본당에 계시다. 널 보고 싶어하실 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider
#. Speaker = Narrator
#. NodeID = 41898512-14d0-6ea6-e91d-048df83d7d12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider:41898512-14d0-6ea6-e91d-048df83d7d12
msgctxt "hf28b89a3g822cg4343ga7abg6e33504fba8b"
msgid ""
"*His thoughts seek yours, searching, grasping. Your parasite squirms in "
"recognition.*"
msgstr "*그의 정신이 탐색하고, 조사하고, 파악합니다. 당신의 기생충은 그걸 느꼈는지 꿈틀거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint_Drider
