msgctxt "hf13f140ag7c8bg47c9gbc1egb6baaf142b10"
msgid "Three hearts, one will. The <i>Elder's </i>will."
msgstr "세개의 심장, 하나의 의지. <i>엘더</i>의 의지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_GEN_AD_IntellectDevourer
#. Speaker = Intellect Devourer
#. NodeID = c6ed59a2-19c6-4d99-a689-bac9baa745ce
#. HandlePath = TaggedText[0].TagText[0]
