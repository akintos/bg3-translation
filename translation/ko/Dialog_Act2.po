msgctxt "haf887d1fg8da4g4f0ag9c5cga5be53cf3e48"
msgid "Damn. That's Arabella's father."
msgstr "젠장, 아라벨라의 아빠잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_ArabellasPowers_PAD_FoundParents
