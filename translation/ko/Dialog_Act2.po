msgctxt "habf54162g2b58g45cbga32egf538b136a265"
msgid "These wounds aren't from a weapon - they're from a horn."
msgstr "이 상처는 무기로 인해 생긴 게 아니군 - 뿔에 찔린 상처야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PlunderedCaravan_PAD_InvestigatedTiefling
