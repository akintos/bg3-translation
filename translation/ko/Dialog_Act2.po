msgctxt "h5c86f60fgae95g486fga327gc1517a628605"
msgid "I can't linger in this darkness - I'm weakening by the moment."
msgstr "이 어둠 속에서 머뭇거릴 수 없어. 매 순간 약해지고 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 60a97c95-9f01-4aea-b7c1-2fbca8b731b7
