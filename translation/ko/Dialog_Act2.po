msgctxt "h0334d675gfdebg47b9gad60g12e49ab05a86"
msgid ""
"<i>Commune with your parasite, plant a thought: 'This one </i>is <i>a "
"disciple.'</i>"
msgstr "<i>당신의 기생충을 이용해, '이 자는 </i>신봉자다<i>' 라는 생각을 심으십시오.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_UpperFloor_TrespassWarning
#. Speaker = Zealot Klen
#. NodeID = 43392a87-4f2c-4dda-879f-1e7e646f96ff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_UpperFloor_TrespassWarning:43392a87-4f2c-4dda-879f-1e7e646f96ff
msgctxt "h11a8e4b2gcf0bg41d7gbcb4g02d123effc08"
msgid "What madness is this? <i>A traitor to the Absolute.</i>"
msgstr "이게 대체 무슨 짓이야? <i>절대자님께 반하는 배신자다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_UpperFloor_TrespassWarning
#. Speaker = Player
#. NodeID = 4ad03a77-f8d1-4b43-8f42-c649926a3f64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#.      - GLO_Tadpoled_UsedToday2(1) = False
