msgctxt "h0fd27a9fgd37fg4b30g89bdg0ff2f502f509"
msgid "[DRUID][RANGER]"
msgstr "[드루이드][레인저]"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 9700be86-4dc9-1113-9979-6b77d7e42ad7
