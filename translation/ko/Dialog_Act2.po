#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:989c49e5-4b77-441c-9044-ef59aa81a89b
msgctxt "h1eac5164g9367g439ag8df6gfe1dca8c495f"
msgid "As rats go, this one seems to be somewhat of an eccentric."
msgstr "보통 쥐들을 생각하면, 이 친구는 꽤나 별난 축인 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Wyll
#. NodeID = 9a6e68f1-bfda-4ad1-9735-59bcc44d12b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
