msgctxt "hb6889fecg4186g44a5gbbe5gd6aed0d7a033"
msgid "<i>Something doesn't seem quite right - take a closer look.</i>"
msgstr "<i>뭔가 좀 이상합니다... 자세히 살펴봅니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 156bb9f7-161d-a0f2-cc55-d280fe46037d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_State_KillOrthonPersuasionAttempted(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Displacer_State_KillOrthonPersuasionAttempted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:156bb9f7-161d-a0f2-cc55-d280fe46037d
msgctxt "h9bba0fa5g52c4g4df6g994fg8236219673aa"
msgid "The only liar here is your 'master'. Let's end him together."
msgstr "여기서 거짓말쟁이는 너의 '주인님'뿐이야. 같이 끝장내러 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 16274211-fa5c-4c56-4785-5070dbca2a1a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:16274211-fa5c-4c56-4785-5070dbca2a1a
msgctxt "h9f35cf1fg9e5ag44ffga98fg1c9d21bbe866"
msgid "Bold words, <i>prey. </i>But I kill who I please."
msgstr "대담한 말이구나, <i>먹잇감아.</i> 하지만 나는 내 마음대로 죽인다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 18a45ebb-f663-228a-fdb1-1f907c542757
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:18a45ebb-f663-228a-fdb1-1f907c542757
msgctxt "h82317c36g4971g410fg909ag924a4ffb0de5"
msgid ""
"Master is most generous with his meat-gifts. The rot is only skin-shallow. "
"The kicks he gives, most earned."
msgstr "주인님은 고기 선물에 대해 가장 관대하시다. 썩은 부분은 겉 피부뿐이야. 발로 차서 주실 때, 가장 많이 받지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 1fb767e4-49eb-320e-e2cf-a8c6a5fbf8bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:1fb767e4-49eb-320e-e2cf-a8c6a5fbf8bd
msgctxt "h053e7b37g25a9g4797g9a81g953ce68ca37d"
msgid "*The beast purrs as it enjoys your touch...*"
msgstr "*이 짐승이 당신의 손길을 즐기며 골골댑니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 1fd1a4b9-d1e1-b82c-ceb8-944fecfcaaf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:1fd1a4b9-d1e1-b82c-ceb8-944fecfcaaf9
msgctxt "he5ebc0e6ga00cg43d7g82cfg692e0ac333e0"
msgid "*The creature eyes you with vague interest...*"
msgstr "*짐승이 모호한 눈으로 당신을 훑어봅니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 220424bd-06ab-4863-bd70-dde0328a0161
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_SwA_HasMet(1) = False
#.   Global:
#.      - SHA_Displacer_State_AlliesPlayers = False
#.      - SHA_Orthon_State_Defeated = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Displacer_SwA_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:220424bd-06ab-4863-bd70-dde0328a0161
msgctxt "h9fcfa766gada8g4ce5gb38cg449a94d1af22"
msgid "Go away!"
msgstr "꺼져!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 254282c1-3cba-0f1e-f76e-a162c0040bf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:254282c1-3cba-0f1e-f76e-a162c0040bf3
msgctxt "h648fa4d1g35c6g448bg87ecgbe48ee428859"
msgid ""
"I need no sign. My belly is full, my spirit fed. Your words are not wanted "
"here."
msgstr "어떠한 표시도 필요 없다. 내 배는 부르고, 정신은 충만하다. 여기서 너의 말은 필요 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 27894afb-296b-49cf-bc1c-18ddff03d74e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:27894afb-296b-49cf-bc1c-18ddff03d74e
msgctxt "h54caf8e8gc47cg41e3ga3c2g356895667f74"
msgid "*...But only for a moment - it's not <i>your</i> affection it craves.*"
msgstr "*...하지만 잠시뿐입니다... 이 짐승이 갈망하는 것은 <i>당신의</i> 애정이 아닙니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 283c68e7-1ab3-4a89-bf98-4f44a08bb9d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - SHA_Displacer_Event_AnimalHandlingSuccess(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:283c68e7-1ab3-4a89-bf98-4f44a08bb9d8
msgctxt "h2f289658ge000g40efg9186gf101367d981a"
msgid "*Try as you might, you can't seem to meet the beast's eyes.*"
msgstr "*아무리 노력해도 당신은 이 짐승의 눈을 마주칠 수 없을 듯 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 28b549e0-f8f7-42ff-08c4-22979509f0bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:28b549e0-f8f7-42ff-08c4-22979509f0bb
msgctxt "h0673900ega811g4cebgb374gb6f8aebfcc68"
msgid ""
"*A few merregons and an orthon - could the beast really be infatuated with "
"one of <i>these</i> creatures?*"
msgstr "*몇 명의 메레곤들과 오르쏜... 이 짐승이 정말로 <i>저</i> 생명체들 중 하나에 홀딱 반할 수 있을까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 28eb8e61-fe20-1fb5-31cb-a917e6e60939
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_State_KillOrthonPersuasionAttempted(1) = False
#.   Global:
#.      - SHA_Displacer_State_AlliesPlayers = False
#.   Object:
#.      - HAG_Hag_Event_HagEyed(1) = True
#. TagRule: HAGEYED
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:28eb8e61-fe20-1fb5-31cb-a917e6e60939
msgctxt "hb6f8c734g2816g4aebg9d99g3fd89cdaa80d"
msgid "*The back of your eye tingles - there's magic in the beast's gut.*"
msgstr "*당신의 눈 뒤쪽이 따끔거립니다... 짐승의 위장 속에 마법이 깃들어 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 29984301-8f15-1723-b717-a7bb08882288
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_SwA_HasMet(1) = True
#.   Global:
#.      - SHA_Displacer_State_AlliesPlayers = False
#.      - SHA_Orthon_State_Defeated = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:29984301-8f15-1723-b717-a7bb08882288
msgctxt "h558ab31ag5802g4e4cg9423g9bbc74a3c892"
msgid "GO AWAY."
msgstr "꺼져라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 2bef630a-e40d-883b-59b5-c44e7c3b1356
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:2bef630a-e40d-883b-59b5-c44e7c3b1356
msgctxt "h16621470gf34dg42ebg93cfgad0249c7b041"
msgid "You lie. Your breath stinks of double-speak."
msgstr "거짓말이야. 네 숨결에서 사기꾼의 냄새가 나는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = 2fff3c12-f746-9dd1-752b-e7df053237a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:2fff3c12-f746-9dd1-752b-e7df053237a1
msgctxt "hc63da46dg1eb2g44e8gb0eegc3775c2b9c67"
msgid "*It's a displacer beast - alone, and <i>tame</i>.*"
msgstr "*디스플레이서 비스트입니다... 혼자이고, <i>길들여졌습니다</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 331a05c8-6d9f-d024-4767-8e46816c79dc
