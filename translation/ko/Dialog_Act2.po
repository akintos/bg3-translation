msgctxt "h1ec761ddgd562g44bfg81a1g173ed5095841"
msgid "<i>Tsk'va</i> - I barely have the strength to move forward."
msgstr "<i>츠그바</i>. 앞으로 나아갈 힘이 남아나질 않아. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 60a97c95-9f01-4aea-b7c1-2fbca8b731b7
