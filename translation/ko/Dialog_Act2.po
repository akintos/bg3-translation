msgid "Lia, answer me. Where is Cal?"
msgstr "리아, 대답해. 칼은 어디 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SisterWaitingAlone
#. Speaker = Lia
