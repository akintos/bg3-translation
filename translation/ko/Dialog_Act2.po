#.   Tag:
#.      - REALLY_SHADOWHEART(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo:40afc622-dde1-4d54-9d6f-e491cb5ce3d2
msgctxt "h190a21a9gdaf4g4406g93f7g3a084db4cff5"
msgid "Well, she wasn't lying - she's immortal."
msgstr "이것 참, 거짓말이 아니었네. 진짜 불멸자잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
