msgctxt "h22419ed0g952ag4e86ga979ga49787160d81"
msgid "I wish we had a bloody army."
msgstr "난 우리한테 군대가 있었으면 좋겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven Outcasts/HAV_HavenOutcasts_AD_BarricadeRunners
