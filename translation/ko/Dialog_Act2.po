#.     - SHA_Displacer_Event_NatureAttempted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:9700be86-4dc9-1113-9979-6b77d7e42ad7
msgctxt "ha0d654a7ga00ag479agaaf9g8b2dd603d276"
msgid "<i>Something doesn't seem quite right - take a closer look.</i>"
msgstr "<i>뭔가 좀 이상합니다... 자세히 살펴봅니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 9b327d93-695d-59a7-c2a0-a13c826ae287
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:9b327d93-695d-59a7-c2a0-a13c826ae287
msgctxt "h8b932154g446ag463fg9672g7b804d98ba44"
msgid "I know my tastes. And I'm not known for sharing."
msgstr "나는 내 취향을 잘 알고 공유하고 싶지도 않다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 9b4fecaa-cebb-8aac-2657-874aa28e2161
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:9b4fecaa-cebb-8aac-2657-874aa28e2161
msgctxt "hd2cb788ag63f6g4b96ga292gff6fe547f96c"
msgid "I remember... quick flesh, hot blood."
msgstr "기억이 나... 살아있는 살점, 뜨거운 피."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 9bd34aa7-e31a-b9cd-6d67-296dc64778b1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_Event_IntimidationAttempted(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Displacer_Event_IntimidationAttempted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:9bd34aa7-e31a-b9cd-6d67-296dc64778b1
msgctxt "h29729830gd37ag457fgab6dgcd0c2fa969f5"
msgid "Stop your mewling before I shred <i>you</i>."
msgstr "내가 <i>널</i> 갈기갈기 찢기 전에 그만 좀 징징대라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = 9c101125-5531-dda3-1b71-24f7a8f32073
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:9c101125-5531-dda3-1b71-24f7a8f32073
msgctxt "h9c0f7c17gd6fbg43dag8fbbga5ace324f02e"
msgid "His what now?"
msgstr "지금 그의 뭐라고 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 9df03f31-1297-e7b5-6592-de3ed8a8af57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:9df03f31-1297-e7b5-6592-de3ed8a8af57
msgctxt "h719dba8age9f4g4644g9081ga61999bae57d"
msgid "That's between me and master. Go sniff elsewhere, <i>prey</i>."
msgstr "그건 나와 주인님 사이의 일이지. 이제 다른 곳이나 어슬렁거리시지, <i>먹잇감</i>아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = 9fe270d0-97a3-349a-0618-d134e87bf73d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:9fe270d0-97a3-349a-0618-d134e87bf73d
msgctxt "h70037404gb5b5g4e34g9952g1b668bfac91a"
msgid "Disease? No. Love is a birthright. I pity the beast who is deprived."
msgstr "질병? 아니다. 사랑은 타고난 권리다. 빼앗긴 짐승이 불쌍하구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = aeab72a3-84f9-40ea-ed7d-4cff2691421a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:aeab72a3-84f9-40ea-ed7d-4cff2691421a
msgctxt "hb4bb1d7cg7573g421egb1cegad200321e6ea"
msgid "You're kidding, right?"
msgstr "농담하는 거 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = b45551e4-c47c-c10c-cff5-6d9c505dc715
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SHA_Displacer_Knows_CharmedFromMeat = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:b45551e4-c47c-c10c-cff5-6d9c505dc715
msgctxt "hdffe4664g7251g46e0ga526g7e0fa594ea0a"
msgid "*This creature has been eating charmed spider meat.*"
msgstr "*이 생명체는 매혹된 거미 고기를 먹어왔습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = b511bfe5-c6d0-6b23-e082-4b3272f4b02c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:b511bfe5-c6d0-6b23-e082-4b3272f4b02c
msgctxt "h9bf79fd8g4d73g42c8ga243gf999f687465f"
msgid "I have a servant who calls me Master, and his love disgusts me."
msgstr "나를 주인님이라 부르는 종복이 하나 있는데, 그의 사랑은 날 역겹게 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = b5324a78-61c6-ace3-1ca9-e507547d55e5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Constitution
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_Event_ConstitutionAttempted(1) = False
#. SetFlags:
#.   Dialog:
#.     - SHA_Displacer_Event_ConstitutionAttempted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:b5324a78-61c6-ace3-1ca9-e507547d55e5
msgctxt "hba8db1e4gaec0g4885g83f9g96ed09a56a1e"
msgid "<i>Stifle a laugh.</i>"
msgstr "<i>웃음을 참는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = b7792203-836f-c05b-ef07-f76a78936f20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:b7792203-836f-c05b-ef07-f76a78936f20
msgctxt "h2d847787ga59fg453agbd72geb9583f97302"
msgid "What master gives is my rightful due. Master is most kind."
msgstr "주인님이 주신 것은 내가 마땅히 받아야 할 것이다. 주인님은 가장 친절하시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = b870990f-7b99-e6a6-9bfc-67c437c9abf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:b870990f-7b99-e6a6-9bfc-67c437c9abf6
msgctxt "hfc6b16dcg972ag4b1fgb854g84544530da83"
msgid "I could ask you the same question."
msgstr "나도 같은 질문을 하려던 참인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Narrator
#. NodeID = b8c3200d-36df-4789-cfca-b718da0ff1d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:b8c3200d-36df-4789-cfca-b718da0ff1d9
msgctxt "hc2cf6291g2ec5g44d1g98cdge45974cd5628"
msgid "*There's something off about this creature, but you can't tell what.*"
msgstr "*이 생명체는 뭔가 이상한 점이 있지만, 당신은 그것이 무엇인지 알 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = b9f0aeec-65fd-e85b-8578-70cc4cb0d719
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - SHA_Displacer_SwA_HasMet(1) = False
#.   Global:
#.      - SHA_Displacer_State_AlliesPlayers = True
#.      - SHA_Orthon_State_Defeated = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - SHA_Displacer_SwA_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:b9f0aeec-65fd-e85b-8578-70cc4cb0d719
msgctxt "he65fb919g2e19g43aag9853g0a80d683e008"
msgid "I hope they chew him up in the Hells."
msgstr "지옥에서 그를 씹어먹었으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = bbeb22ea-9014-40cb-a883-03af6f1d7101
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:bbeb22ea-9014-40cb-a883-03af6f1d7101
msgctxt "h4f2c2584gf2a4g4ea7g8a61gf30c804a7a96"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
#. NodeID = bcb8f108-272f-6570-7161-eab8fe1fc6cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer:bcb8f108-272f-6570-7161-eab8fe1fc6cd
msgctxt "hab7315b1gc078g41b3g917cg6a8ff8502f96"
msgid "<i>You</i>? But master loves me... master <i>lied</i>?"
msgstr "<i>네</i>가? 하지만 주인님은 날 사랑하는데... 주인님이 <i>거짓말</i>했다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = bd0f0948-9cad-0e20-9967-ad6a971fbc6d
#. HandlePath = TaggedText[0].TagText[0]
