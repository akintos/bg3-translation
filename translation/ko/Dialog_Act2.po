msgid "Don't you snurl at me, you nasty cow!"
msgstr "나한테 그르렁 거리지 마, 이 발정 난 소 같으니!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_PixieBell
#. Speaker = Player
#. NodeID = 441ba464-38c7-636d-e61e-5cc550da7749
#. HandlePath = TaggedText[0].TagText[0]
