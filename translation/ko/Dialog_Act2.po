#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_003:4728d8a0-b4b1-87b4-973d-054bb6b3af48
msgctxt "h587beb7bg7efcg47d1g82bcg743547d70986"
msgid "Make those bastards pay."
msgstr "그 개자식들에게 앙갚음해줘요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_HarperScouts_Harper_003
#. Speaker = Harper Karrow
#. NodeID = 58f56f6d-596b-469d-a57f-fce822f371f5
