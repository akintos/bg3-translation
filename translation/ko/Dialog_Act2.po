msgctxt "h05d24a58gd3acg4d9cgb1bfg4427ceed3359"
msgid "Please tell me you're not <i>another</i> minstrel. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Player
#. NodeID = e2285c9e-fdb0-0644-fb68-f598f3b5d0ad
