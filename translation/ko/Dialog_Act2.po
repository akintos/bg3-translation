#.     - fd9ed69f-475f-def2-bae0-25065ccc4143_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_BugbearThrow:5f721b1c-1bcc-47ab-88f4-7703b0bd730e
msgctxt "h690c6e52g7054g4b0ag8763g399db3ffb6d1"
msgid "I could hit a pixie from a hundred paces."
msgstr "난 백보 떨어진 거리에 있는 픽시도 맞출 수 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_BugbearThrow
#. Speaker = Lann Tarv
#. NodeID = 7ead100d-1a35-4496-99fe-674648c8524e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fd9ed69f-475f-def2-bae0-25065ccc4143_B = True
#. SetFlags:
#.   Local:
#.     - fd9ed69f-475f-def2-bae0-25065ccc4143_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_BugbearThrow:7ead100d-1a35-4496-99fe-674648c8524e
msgctxt "h5f698753g8756g47dcg968bg47a57fb8d28f"
msgid "Perfectly executed."
msgstr "완벽해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_BugbearThrow
#. Speaker = Lann Tarv
#. NodeID = 94f913ef-e282-4851-a476-d44af4aa5b0e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - fd9ed69f-475f-def2-bae0-25065ccc4143_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_BugbearThrow:94f913ef-e282-4851-a476-d44af4aa5b0e
msgctxt "h61c87e12g4396g4ed5gac1dg61e8dfcd7591"
msgid "My talents are wasted here."
msgstr "내 재능을 낭비하고 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_BugbearThrow
#. Speaker = Lann Tarv
#. NodeID = a4216512-212f-4133-a7ce-095f50700edc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fd9ed69f-475f-def2-bae0-25065ccc4143_C = True
#. SetFlags:
#.   Local:
#.     - fd9ed69f-475f-def2-bae0-25065ccc4143_A = False
#.     - fd9ed69f-475f-def2-bae0-25065ccc4143_C = False
#.     - fd9ed69f-475f-def2-bae0-25065ccc4143_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_BugbearThrow:a4216512-212f-4133-a7ce-095f50700edc
msgctxt "hda6f3845g6248g4620gbc19gfe4d47195c3d"
msgid "I should be on the frontline, cleaving skulls."
msgstr "전장에 나가서 머리통을 쪼개고 있어야 하는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution
#. Speaker = Brawler Orik
#. NodeID = 167f28df-117f-4b69-8644-2277eb5c9270
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution:167f28df-117f-4b69-8644-2277eb5c9270
msgctxt "h5186806eg27b6g40a2gb1f6gdeac2b993897"
msgid "Aye. Aye, I suppose."
msgstr "그래 그래, 그렇겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution
#. Speaker = Brawler Orik
#. NodeID = 3d13494e-8d24-4d00-b517-b49590a6d734
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution:3d13494e-8d24-4d00-b517-b49590a6d734
msgctxt "h8a5a6b6fg9e28g4c92g88c4gd35721e4c19d"
msgid "Don't bloody feel like it, all of a sudden."
msgstr "그닥 와닿지는 않는데. 너무 갑작스럽잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution
#. Speaker = Brawler Orik
#. NodeID = 821e2cdc-935c-4d17-833f-c406e36a3722
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a2fa1f0f-b9b5-f8bf-bf27-b11194b8502f_A = True
#. SetFlags:
#.   Local:
#.     - a2fa1f0f-b9b5-f8bf-bf27-b11194b8502f_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution:821e2cdc-935c-4d17-833f-c406e36a3722
msgctxt "h02681097g44ffg46d5gbc90g37747a63659d"
msgid "This ain't what we was promised. The Absolute's <i>our</i> god."
msgstr "약속과는 다르잖아. 절대자님은 <i>우리만의</i> 신이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution
#. Speaker = Brawler Weneg
#. NodeID = 8f94da9e-d37d-482e-8c36-fb0f33fbbcfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution:8f94da9e-d37d-482e-8c36-fb0f33fbbcfb
msgctxt "h19309388g0a34g420ag8c82g8f58e96f9948"
msgid "And when we win, there'll be loot enough to make us lords."
msgstr "우리가 이기면, 군주가 되고도 남을 정도로 많은 전리품을 얻을 수 있을 거야. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution
#. Speaker = Brawler Wim
#. NodeID = b9364c20-254b-4129-b469-9f250f6a0748
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution:b9364c20-254b-4129-b469-9f250f6a0748
msgctxt "h766c78e9g4f5bg4e75g81f0g63af47d1e96c"
msgid "She belongs to everyone, git. That's the point."
msgstr "그분은 모두를 위해 존재하신다. 이 멍청한 놈아. 그게 핵심이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution
#. Speaker = Brawler Orik
#. NodeID = c67b845e-7b93-4422-976b-323036dded1b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - a2fa1f0f-b9b5-f8bf-bf27-b11194b8502f_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution:c67b845e-7b93-4422-976b-323036dded1b
msgctxt "h27fbff4eg87cbg45e3ga0a3g2c7db7d9b851"
msgid "They bloody killed 'em. What now? Are we next?"
msgstr "고블린들을 죽여버렸어. 다음은 뭐지? 우리 차례인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution
#. Speaker = Brawler Wim
#. NodeID = d39cd8c3-5f3e-47cf-a00c-d656ec220951
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a2fa1f0f-b9b5-f8bf-bf27-b11194b8502f_B = True
#. SetFlags:
#.   Local:
#.     - a2fa1f0f-b9b5-f8bf-bf27-b11194b8502f_B = False
#.     - a2fa1f0f-b9b5-f8bf-bf27-b11194b8502f_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution:d39cd8c3-5f3e-47cf-a00c-d656ec220951
msgctxt "h98d5c0c2g7a62g484agaa5ag4c9bd7f2eafe"
msgid ""
"Just focus on the glory to come, yeah? Absolute's picking a fight with the "
"whole damn Coast."
msgstr "다가올 영광에만 집중하라고, 알았어? 절대자님은 지금 빌어먹을 소드코스트 전체와 싸우고 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution
#. Speaker = Brawler Weneg
#. NodeID = f08620b6-2f43-498b-880d-9dc98b1f9fb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution:f08620b6-2f43-498b-880d-9dc98b1f9fb2
msgctxt "h49209c68g3bf9g4462gba66ge30a77b1a7d9"
msgid "Quiet, both of yas! Ye're drawin' <i>attention.</i>"
msgstr "둘 다 조용히 해! 다 <i>쳐다보잖아.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution
#. Speaker = Brawler Weneg
#. NodeID = f0ab3141-d1fe-49f1-8211-6d10b51f2e76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution:f0ab3141-d1fe-49f1-8211-6d10b51f2e76
msgctxt "hfed50e07g6fd2g4be6ga82cg90f701a2a1a2"
msgid "We're all friends, right? All one under the Absolute."
msgstr "그럼 우린 다 친구인 거네, 그치? 절대자님 아래에선 전부 하나잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution
#. Speaker = Brawler Wim
#. NodeID = f17da6c3-e26c-4027-b8f4-9d3a5a26c124
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsAfterExecution:f17da6c3-e26c-4027-b8f4-9d3a5a26c124
msgctxt "h02f68a4bg30adg445eg8f8fgd63e85142316"
msgid "Not if you keep them lips clapped together."
msgstr "네가 입방정만 안 떨면 그럴 일은 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening
#. Speaker = Brawler Weneg
#. NodeID = 18e8062d-a8af-42fa-b226-8365afc644f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c69edf86-a729-aaf0-24b7-3606b44b35a3_B = True
#. SetFlags:
#.   Local:
#.     - c69edf86-a729-aaf0-24b7-3606b44b35a3_A = False
#.     - c69edf86-a729-aaf0-24b7-3606b44b35a3_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening:18e8062d-a8af-42fa-b226-8365afc644f6
msgctxt "hdb12bb68geddfg4204gb653g79659eea9ff3"
msgid "Enough! Just leave the bloody True Souls to their business."
msgstr "그만! 참된 영혼들 성가시게 하지 말고 자기 할 일 하게 내버려 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening
#. Speaker = Brawler Wim
#. NodeID = 39d1ea73-de0d-4c5d-8c06-489a66c33dd3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c69edf86-a729-aaf0-24b7-3606b44b35a3_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening:39d1ea73-de0d-4c5d-8c06-489a66c33dd3
msgctxt "hcfc802b5g74e0g4558g8fe7gab04ec787ac1"
msgid "Can't hear a damned thing in there."
msgstr "뭐라는 건지 아무것도 안 들리네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening
#. Speaker = Brawler Orik
#. NodeID = 47372d3d-852e-4e14-861e-bd707d6474d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening:47372d3d-852e-4e14-861e-bd707d6474d3
msgctxt "h4c536cefg6078g4d9fg9b0ag5ccb16271fa7"
msgid ""
"If it's bad, you'll know. Disciple Z'rell ain't shy about handing out pain."
msgstr "나쁜 일이라면 곧 알게 되겠지. 신봉자 즈렐이 고통을 선사하는 걸 주저한 적은 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening
#. Speaker = Brawler Weneg
#. NodeID = 4f8d768c-0e01-45ad-a8fe-6e751db9634c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening:4f8d768c-0e01-45ad-a8fe-6e751db9634c
msgctxt "hcc05ba5ag69a2g401dgb4e5gd90515851c0f"
msgid "Aye, cos you ain't meant to. It's True Soul business - not for us."
msgstr "그야, 들어서는 안 되니까. 참된 영혼이 신경 쓸 일이지, 우리랑은 상관 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening
#. Speaker = Brawler Orik
#. NodeID = 511f7a12-1a1a-40da-a6ae-d99b49228bb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening:511f7a12-1a1a-40da-a6ae-d99b49228bb2
msgctxt "h9e59e315ge203g4254gb442g0c49243efaba"
msgid "And what about them who hang around his door like a bad smell?"
msgstr "장군 문 앞에 끈덕지게 붙어있는 놈들은 또 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening
#. Speaker = Brawler Wim
#. NodeID = 84d7b15c-b22f-4751-9d35-6c224b093402
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c69edf86-a729-aaf0-24b7-3606b44b35a3_A = True
#. SetFlags:
#.   Local:
#.     - c69edf86-a729-aaf0-24b7-3606b44b35a3_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening:84d7b15c-b22f-4751-9d35-6c224b093402
msgctxt "h51f0c72egc7f3g4d87g8143g82ef2bc1fae5"
msgid "I'm checking again."
msgstr "다시 확인해 봐야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening
#. Speaker = Brawler Wim
#. NodeID = a0b4b741-183f-4cfa-a090-659b3037a326
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening:a0b4b741-183f-4cfa-a090-659b3037a326
msgctxt "h04dbe19cgcbf3g41a5g8d5cgcf36082d9ea2"
msgid ""
"And what's to say that couldn't be us? They say the General rewards them as "
"serve him well."
msgstr "우리라고 안될건 또 뭐야? 듣자하니 일만 제대로 해내면 장군이 그만큼 보상을 해 준다던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening
#. Speaker = Brawler Weneg
#. NodeID = c291ba3b-4b33-4218-b45f-749e9bc896b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GoblinsListening:c291ba3b-4b33-4218-b45f-749e9bc896b2
msgctxt "h0085ccceg9f50g4de6g8a19g2bc50c9f2c06"
msgid "You want to land us on the hook in there with them?"
msgstr "놈들이랑 같이 갈고리에 걸리고 싶기라도 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GuardRejectPilgrims
#. Speaker = Pilgrim Iong
#. NodeID = 26aedd06-8c86-7a88-b044-d3f65150d699
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GuardRejectPilgrims:26aedd06-8c86-7a88-b044-d3f65150d699
msgctxt "h14ea8167g2f97g4477gb4d0g8e43ec12b7c4"
msgid "Of course. Of <i>course.</i>"
msgstr "물론. <i>그렇겠죠.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GuardRejectPilgrims
#. Speaker = Acolyte Belub
#. NodeID = 6217bba0-8c05-6fa1-682e-78a74bbe61ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GuardRejectPilgrims:6217bba0-8c05-6fa1-682e-78a74bbe61ef
msgctxt "h6f53d5b6g013cg4f2cg8c19gba19ac38dfdf"
msgid ""
"The shadows won't harm you, so long as you know your place in the Absolute's "
"design."
msgstr "그림자는 해를 끼치지 않을 것이다. 절대자님의 의도와 계획을 스스로 이해하고 있다면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GuardRejectPilgrims
#. Speaker = Acolyte Belub
#. NodeID = e957f1d1-3ba9-4cf1-6a28-a0d067048f2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GuardRejectPilgrims:e957f1d1-3ba9-4cf1-6a28-a0d067048f2f
msgctxt "h0223d2e9g8376g4dc2g9b47g3551cbbb5fc0"
msgid ""
"Right, pilgrims. You'll be scouting the perimeter of the war camp, looking "
"for enemies."
msgstr "순례자들은 듣도록. 너희는 군영 경계를 따라 순찰에 나서게 될 것이다. 적을 찾아내는 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GuardRejectPilgrims
#. Speaker = Pilgrim Iong
#. NodeID = f99a53ce-224c-0aad-65fc-53fb946e5814
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_GuardRejectPilgrims:f99a53ce-224c-0aad-65fc-53fb946e5814
msgctxt "h94d88d13gfb88g4f64gbde9g7f42d70fb178"
msgid "But... the shadows. It's death out there without a guide."
msgstr "허나... 그림자가 있잖습니까. 인도 없이 밖에 나갔다간 죽게 될 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Minthara_BazaarEntry
#. Speaker = Nightwarden Minthara
#. NodeID = 71e58bef-6fbf-6f76-ccba-7a204e9b2d09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Minthara_BazaarEntry:71e58bef-6fbf-6f76-ccba-7a204e9b2d09
msgctxt "h4d39acf9gdb28g46a7ga961g0fae960c1a79"
msgid ""
"Converts, pilgrims, mercenaries. They all seek power, but will find only "
"death."
msgstr "개종자, 순례자, 용병 할 것 없이 모두 힘을 원하지, 하지만 그 끝엔 죽음만이 있을 뿐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims
#. Speaker = Pilgrim Nalira
#. NodeID = 042a0728-5259-e79a-d97e-28973db45721
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 33c98c01-5504-c0af-918c-eda21c412634_MOO_Bazaar_PilgrimEntranceAD_B = True
#. SetFlags:
#.   Local:
#.     - 33c98c01-5504-c0af-918c-eda21c412634_MOO_Bazaar_PilgrimEntranceAD_A = False
#.     - 33c98c01-5504-c0af-918c-eda21c412634_MOO_Bazaar_PilgrimEntranceAD_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims:042a0728-5259-e79a-d97e-28973db45721
msgctxt "hdc6ac449g934bg4c81g8f31g9ea1cde109de"
msgid "Brothers. Sister. Pray with me while we wait."
msgstr "형제 자매들이여. 기다리는 동안 함께 기도합시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims
#. Speaker = Pilgrim Iong
#. NodeID = 1582f6ab-0223-08d5-fa1a-aee9398fe95c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims:1582f6ab-0223-08d5-fa1a-aee9398fe95c
msgctxt "h38315ba3g5919g4cc3g9b0fg1963169ac19e"
msgid "My brothers had the dreams too, same as me. But they wouldn't admit it."
msgstr "내 형제들도 나와 같은 꿈을 꿨지. 본인들은 인정하지 않았지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims
#. Speaker = Pilgrim Farimorn
#. NodeID = 34942d8d-438c-87f4-e993-f282d75d31c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims:34942d8d-438c-87f4-e993-f282d75d31c7
msgctxt "h7e608802g463bg4558gac93gb4f0cdb3ff17"
msgid "I was a farrier in Dessarin Valley. Then the dreams came."
msgstr "데사린 밸리에서 편자 만드는 일을 했소. 그러다 꿈을 꿨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims
#. Speaker = Pilgrim Taima
#. NodeID = 44af33a8-85ee-f767-3d6c-11b5f8e4f3b3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 33c98c01-5504-c0af-918c-eda21c412634_MOO_Bazaar_PilgrimEntranceAD_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims:44af33a8-85ee-f767-3d6c-11b5f8e4f3b3
msgctxt "he3299753g52ceg4a7dg8bdagbf1c0f5199ec"
msgid "To stand this close to Her power... I never thought I'd make it."
msgstr "그분의 권능에 이토록 가까이 다가서게 되다니... 결코 해내지 못할 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims
#. Speaker = Pilgrim Nalira
#. NodeID = 577658ee-b401-2fe2-5596-3eb5b7e9cc72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 33c98c01-5504-c0af-918c-eda21c412634_MOO_Bazaar_PilgrimEntranceAD_A = True
#. SetFlags:
#.   Local:
#.     - 33c98c01-5504-c0af-918c-eda21c412634_MOO_Bazaar_PilgrimEntranceAD_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims:577658ee-b401-2fe2-5596-3eb5b7e9cc72
msgctxt "h20e9f9fcg3099g45a4g8b97g5f44239ff781"
msgid "Where do you hail from, brother?"
msgstr "어디서 왔나, 형제여?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims
#. Speaker = Pilgrim Nalira
#. NodeID = 6c8f3242-b8b9-1ecf-2b00-6ecc2be38d73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims:6c8f3242-b8b9-1ecf-2b00-6ecc2be38d73
msgctxt "hc539a12cg0dd9g43e3ga2f2ge8f672a84577"
msgid "Yes, you did. She gives them to you fully formed. Can you hear Her?"
msgstr "당신은 이미 알고 있소. 그분께선 언제나 기도문 전체를 전하시거든. 그분의 말씀이 들리나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims
#. Speaker = Pilgrim Iong
#. NodeID = 75248959-c6e0-ee7b-0f60-4c9ee89ba846
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims:75248959-c6e0-ee7b-0f60-4c9ee89ba846
msgctxt "h1ea6364ag45a1g4919gb91fgb3e2f75709c4"
msgid ""
"I wouldn't have, if not for the lantern-bearer. To think the Absolute graces "
"such a creature as that..."
msgstr "등불을 지닌 자가 아니었다면 난 절대 못 왔을 거야. 절대자께서는 그런 괴물에게조차 은혜를 베푸시는군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims
#. Speaker = Pilgrim Nalira
#. NodeID = 7deeed0b-32c1-092d-4084-683b0aee11af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims:7deeed0b-32c1-092d-4084-683b0aee11af
msgctxt "h1fca9057g3788g4206g8e31ga5baa057202d"
msgid ""
"The Absolute calls us all to Her design. Your family will answer - "
"eventually."
msgstr "그분의 계획은 사람을 가리지 않는다. 결국에는 네 형제들도 부름에 응답하게 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims
#. Speaker = Pilgrim Farimorn
#. NodeID = 85182cf3-0840-3c84-83b1-fc187a8f1023
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims:85182cf3-0840-3c84-83b1-fc187a8f1023
msgctxt "h0f4f9a8fg1b37g40d4g94fag2a387bd1f2be"
msgid ""
"We are each of us threads in Her design. Even those we once called monsters."
msgstr "우리는 그분의 거대한 자수 속 한 가닥 실오라기에 불과하오. 우리가 괴물이라 배척했던 이들 조차도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims
#. Speaker = Pilgrim Farimorn
#. NodeID = 954bfc95-4618-0129-7823-1256066d5f07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims:954bfc95-4618-0129-7823-1256066d5f07
msgctxt "haee85fe6g3380g49f1gbdbage2e7a3be6d90"
msgid "I'm not worthy. I... I never learned the words."
msgstr "난 자격이 없소. 기... 기도문을 배운적이 없단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims
#. Speaker = Pilgrim Farimorn
#. NodeID = d4554f7a-6554-2d44-d1df-2702b11ed800
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_Pilgrims:d4554f7a-6554-2d44-d1df-2702b11ed800
msgctxt "h96211406g5d0cg4902gb1e7g4edbe1a618a5"
msgid "<i>Of many hearts, one soul. Of many thoughts, one mind...</i>"
msgstr "<i>수많은 마음, 하나의 영혼. 수많은 생각, 하나의 정신...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew
#. Speaker = Roah Moonglow
#. NodeID = 127e99b0-92b8-4449-9783-a2fa8e8a26a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew:127e99b0-92b8-4449-9783-a2fa8e8a26a5
msgctxt "h693f17b8g6790g4975g8dc1g826d7d4abf16"
msgid ""
"These are our allies, Erna. I'll handle the diplomacy, you just keep looking "
"pretty."
msgstr "우린 다 같은 편이야, 에르나. 대화는 내가 할 테니까, 넌 그냥 얌전히나 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew
#. Speaker = Erna
#. NodeID = 1a15e842-3fc9-7f1e-485e-243778d2f608
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew:1a15e842-3fc9-7f1e-485e-243778d2f608
msgctxt "hd244fc99gda03g46bcgbf15gdb57c6b83706"
msgid "'Minding our business <i>is</i> our business'."
msgstr "'맡은 일이나 열심히 하는 게 <i>바로</i> 우리 일이다'."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew
#. Speaker = Yerle
#. NodeID = 1d09f91b-8923-400a-94ff-ef723ba8df4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew:1d09f91b-8923-400a-94ff-ef723ba8df4c
msgctxt "h48cc5629g3761g42b1gb044gbf6c9512b728"
msgid "...I'll stick with the monster I know, thanks."
msgstr "...같은 괴물이면 차라리 잘 아는 괴물한테 붙을래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew
#. Speaker = Roah Moonglow
#. NodeID = 2f05bd89-5a8c-41c1-a1bf-321d563ec859
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew:2f05bd89-5a8c-41c1-a1bf-321d563ec859
msgctxt "he9647641g2db4g4715g87fag7fb50ed3450b"
msgid "Erna, remind your sister why I pay you both so much."
msgstr "에르나, 너희가 돈을 왜 그렇게 많이 받는지 대신 설명 좀 해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew
#. Speaker = Yerle
#. NodeID = 6134d1d7-c28c-4b9b-ad84-00006e443a7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cb7a0736-07d5-cc1e-8bab-2e1f7c2a32ca_A = True
#. SetFlags:
#.   Local:
#.     - cb7a0736-07d5-cc1e-8bab-2e1f7c2a32ca_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew:6134d1d7-c28c-4b9b-ad84-00006e443a7a
msgctxt "h7ca8b25fg19e9g44fcg925ag912d0978e789"
msgid ""
"You sure<i> </i>you don't want me to check those crates? Be nice to know "
"what we're shipping."
msgstr "정말<i> </i>저 상자에 뭐가 들었는지 확인 안 해봐도 되겠어? 우리가 운반하는 게 뭔지 알아서 나쁠 건 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew
#. Speaker = Erna
#. NodeID = 7d83d36b-44ef-477b-9deb-4d0d950277f8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - cb7a0736-07d5-cc1e-8bab-2e1f7c2a32ca_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew:7d83d36b-44ef-477b-9deb-4d0d950277f8
msgctxt "h33daa6e6ge634g44e6ga4fagdf5b2173f659"
msgid "That bugbear keeps looking over, I'll feed him his own loincloth."
msgstr "저 버그베어가 자꾸 이쪽을 쳐다보는데. 놈이 두르고 있는 샅바를 입에 쑤셔줄까 보다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew
#. Speaker = Yerle
#. NodeID = 85f7806f-6925-4069-8264-ce64c22178e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew:85f7806f-6925-4069-8264-ce64c22178e0
msgctxt "hf8a70847g721bg435dgbe74g5fe978c6a50d"
msgid ""
"Too damn friendly, you ask me. Gods-fearing folk ought to be more... "
"<i>fearful.</i>"
msgstr "너무 과하게 친한 척을 하잖아. 신 타령하는 놈들이면 이것보단... <i>무시무시해야지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew
#. Speaker = Roah Moonglow
#. NodeID = b4454243-6622-47b4-a997-f86f51650a73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew:b4454243-6622-47b4-a997-f86f51650a73
msgctxt "h57cbda1agf9f9g4568gb7e2g3abea5864ee7"
msgid "Why not join this Absolute, see what all the fuss is about?"
msgstr "아예 절대자 교단에 합류해서 왜들 그렇게 호들갑인지 직접 알아보지 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew
#. Speaker = Roah Moonglow
#. NodeID = eb2b8141-259d-48f0-aca9-3e92c51476c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cb7a0736-07d5-cc1e-8bab-2e1f7c2a32ca_B = True
#. SetFlags:
#.   Local:
#.     - cb7a0736-07d5-cc1e-8bab-2e1f7c2a32ca_A = False
#.     - cb7a0736-07d5-cc1e-8bab-2e1f7c2a32ca_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_AD_ZhentarimCrew:eb2b8141-259d-48f0-aca9-3e92c51476c5
msgctxt "h2e6eadc9g8c39g4778gae93g53bf7dfd363d"
msgid "Smile, Yerle. We're among friends."
msgstr "웃어, 예를. 다들 우리 친구잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 07c67deb-c816-a115-5ca5-b1c6ea53edfa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Bazaar_State_TalkedAboutPilgrims = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:07c67deb-c816-a115-5ca5-b1c6ea53edfa
msgctxt "h1d7beccdgdb40g43b2ga78fg14e6b53ce152"
msgid "Each pack of 'recruits' they bring in is worse than the last."
msgstr "한 무리의 '지원자들'이 올때마다 항상 그 전보다 못한 녀석들이 와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 0e50ce5c-4353-44a8-8b8b-239623a83235
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazEntranceGuard_NecromancerReturned_HasMet(1) = True
#.   Global:
#.      - MOO_MutuallyExclusive_State_BalthazarReturn = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:0e50ce5c-4353-44a8-8b8b-239623a83235
msgctxt "h88201233gf248g4af1g91bdgc7d9adc8bdae"
msgid ""
"Prisoners will come 'round eventually. Advisor Balthazar is damned "
"persuasive."
msgstr "죄수들도 결국엔 마음을 돌릴 걸. 고문관 발타자르는 엄청나게 설득을 잘 하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 135d9cbc-f0d7-bccc-b43a-ed8f680838cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:135d9cbc-f0d7-bccc-b43a-ed8f680838cc
msgctxt "he811667eg5a73g4136gbccdg6ef19aa1eda7"
msgid "We'd be better off without 'em, take my word."
msgstr "그놈들은 없는 게 더 나을 거야. 내 말 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Player
#. NodeID = 14062157-3198-1f26-640a-7adf723fada1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Bazaar_State_TalkedAboutPilgrims = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:14062157-3198-1f26-640a-7adf723fada1
msgctxt "h0ce3be65g1fe0g4d87gafcbg84500639663d"
msgid "Its not our place to question the Absolute's will."
msgstr "절대자님의 뜻에 의문을 제기할 수는 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 19ae5e72-a496-4f1a-88af-4f9b7201e259
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazEntranceGuard_AudienceReady_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:19ae5e72-a496-4f1a-88af-4f9b7201e259
msgctxt "h8e800546gf6c3g4673ga23cgfb8ac2b2f6fa"
msgid ""
"We just sent runners to the war camp, True Soul. This is bloody <i>it</i>."
msgstr "방금 군영 쪽으로 전령을 보냈소, 참된 영혼. 마침내 <i>시작되는 거야</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 2d90f92f-30ef-6345-c250-2cd2d7748362
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:2d90f92f-30ef-6345-c250-2cd2d7748362
msgctxt "h6c4528afg3276g4d50gb205g832118caae50"
msgid ""
"I'll see they get all the help they need, True Soul. And they'll need quite "
"a bit..."
msgstr "가능한 지원을 전부 제공해 보겠소, 참된 영혼. 도움이 꽤나 필요할 것으로 보이니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 36ad01c0-e03e-fff4-6e8a-b8953ce8446e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Bazaar_State_PilgrimsDead = True
#. SetFlags:
#.   Global:
#.     - MOO_Bazaar_State_TalkedAboutPilgrims = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:36ad01c0-e03e-fff4-6e8a-b8953ce8446e
msgctxt "ha10a5ba0ga96eg4900ga44cgf0b7fc2a22c8"
msgid ""
"The latest troupe didn't even make it past the door. Strong as gnome piss, "
"the lot of 'em."
msgstr "최근에 온 패거리들은 문도 통과 못했어. 대부분이 딱 노움 오줌만큼만 강했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 3dbb14a2-ad84-6b17-3a46-191d6e78ea06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:3dbb14a2-ad84-6b17-3a46-191d6e78ea06
msgctxt "h3b0b1b9eg3600g46b4g98d7g8daadcdc097b"
msgid "Can't trust them to sweep the stables, let alone swing a sword."
msgstr "검을 휘두르기는커녕, 마구간 청소도 안심하고 못 맡길 것들이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 3de9cdcb-c551-4a2d-b6b2-6f6fb13c2457
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_BazEntranceGuard(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:3de9cdcb-c551-4a2d-b6b2-6f6fb13c2457
msgctxt "h08e421b3gad39g48e2g9558g7b221a55fafd"
msgid ""
"I've got the novices in hand, True Soul. War camps, docks... plenty of work "
"for those who serve Her."
msgstr "신입들은 내가 관리하고 있어, 참된 영혼. 주둔지, 부두... 그 분을 섬기기 위해 할 일이 많거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 4d2b31dc-192b-4ffd-2b07-b725a606014e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:4d2b31dc-192b-4ffd-2b07-b725a606014e
msgctxt "h0cfcd0fegc33cg4c68gb7f1g47f2dc75ba68"
msgid "I-  yeah. Yeah, they're dead weight. Not real believers like us."
msgstr "난... 그래. 맞아, 이들은 짐만 될 거야. 우리처럼 진짜 신도도 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 4f739ec8-7275-4bc5-84c6-a87df7a3667c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazEntranceGuard_IsobelKidnapped_HasMet(1) = True
#.   Global:
#.      - MOO_MutuallyExclusive_State_IsobelKidnapped = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:4f739ec8-7275-4bc5-84c6-a87df7a3667c
msgctxt "h93c8e5cag8d9dg4025gabb2gaef963a38687"
msgid ""
"Even in the Underdark, some fools pray to Selûne's light. General will snuff "
"it out soon enough."
msgstr "심지어 언더가크에서도, 셀루네의 빛에 기도하는 멍청이들이 있지. 장군님께서 조만간 쓸어버릴 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Player
#. NodeID = 556cda3c-a71b-5f20-12d5-ee953f8ef823
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:556cda3c-a71b-5f20-12d5-ee953f8ef823
msgctxt "hb54b8fedgb4a6g4c8bga5e6geb34a0a967fa"
msgid "They have potential. Great warriors have grown from less."
msgstr "걔들에겐 잠재력이 있어. 훌륭한 전사도 작은 것에서 부터 시작하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 560c6c03-48ed-0506-e69d-9bbba1457c3b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Bazaar_State_TalkedAboutPilgrims = True
#.     - MOO_Bazaar_State_PilgrimsToColony = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:560c6c03-48ed-0506-e69d-9bbba1457c3b
msgctxt "hb9a5b273g894cg4975g9e33g45ac39d73db8"
msgid ""
"No doubt - ain't for me to question them above me. I'm sure you know your "
"business."
msgstr "맞는 말이오. 내가 높으신 분들의 뜻에 의구심을 품을 순 없지. 당신 일은 당신이 제일 잘 알테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 76afdfa3-673e-4212-b0cf-10e7b00df428
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazEntranceGuard_IsobelKidnapped_HasMet(1) = False
#.   Global:
#.      - MOO_MutuallyExclusive_State_IsobelKidnapped = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazEntranceGuard_IsobelKidnapped_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:76afdfa3-673e-4212-b0cf-10e7b00df428
msgctxt "ha7ad009agf9cbg4235g8b02g896468b94419"
msgid ""
"Feel that warm glow? A priest of Selûne graces the tower. Sickening, isn't "
"it?"
msgstr "저 따뜻한 빛이 보여? 셀루네의 사제가 탑을 빛내고 있지. 구역질나지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 78bae4cf-7ed9-552f-f4d4-eeea9a5a63f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:78bae4cf-7ed9-552f-f4d4-eeea9a5a63f1
msgctxt "h879b85d2g8037g4e37g80d2g234f31519a18"
msgid ""
"Aye, and better fighters than them've been fertiliser on the fields too."
msgstr "그래, 그 놈들보다 잘난 전사들도 전장에선 거름이 되었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = 94c59379-7a0b-4e08-afc8-ba14b874953b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazEntranceGuard_AudienceReady_HasMet(1) = True
#.   Global:
#.      - MOO_Audience_State_Ready = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:94c59379-7a0b-4e08-afc8-ba14b874953b
msgctxt "h00bcf40ag9146g4ab9gb3beg606a04ddb560"
msgid ""
"I'll stick near you when the city walls come down, boss. I want to see how "
"much damage you can do."
msgstr "도시의 벽이 무너질때 네 옆에 붙어 있을 거야, 대장. 얼마나 피해를 줄 수 있는지 보고 싶거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = a2546b48-1ce7-4a11-a99c-b4283d32a3e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazEntranceGuard_NecromancerReturned_HasMet(1) = False
#.   Global:
#.      - MOO_MutuallyExclusive_State_BalthazarReturn = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazEntranceGuard_NecromancerReturned_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:a2546b48-1ce7-4a11-a99c-b4283d32a3e6
msgctxt "h215418d8gdceeg447eg8738gdf2ae39c81d4"
msgid ""
"I hear the General's advisor is back. Which means we'll be hearing the "
"screams of the prisoners again."
msgstr "장군님의 고문이 돌아왔다던데. 그렇담 죄수들의 비명소리가 다시 들릴 거란 말이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = a607a3ba-55bf-075a-9f3d-a494618ab3f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:a607a3ba-55bf-075a-9f3d-a494618ab3f1
msgctxt "h91f90604g9843g430fgb698g549f48eefd46"
msgid "Thank you, True Soul. In Her name!"
msgstr "고맙군, 참된 영혼. 그 분의 이름으로!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Player
#. NodeID = d28704be-d144-5544-e9ce-a2c68fed1f19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:d28704be-d144-5544-e9ce-a2c68fed1f19
msgctxt "hddfb95d3g7355g4565g90a7g37dee9d5c59c"
msgid "I thought the Absolute welcomed all believers?"
msgstr "절대자께선 신자라면 누구든 환영하시는 줄 알았는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Player
#. NodeID = d39bc5cc-1c26-8e54-df0a-4ee30f8aa436
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Bazaar_State_TalkedAboutPilgrims = True
#.     - MOO_Bazaar_State_PilgrimsToTown = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:d39bc5cc-1c26-8e54-df0a-4ee30f8aa436
msgctxt "h6af19de5g46afg4d35g818cga9fa1ae4dc3e"
msgid "Then get rid of them. The undeserving should be purged."
msgstr "그럼 없애버려. 자격이 없으면 사라져야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = df79a91f-9238-4eca-a8df-f96b79a80c01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_BazEntranceGuard(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:df79a91f-9238-4eca-a8df-f96b79a80c01
msgctxt "ha28cd270gb7b5g4affg830cg9b59fd56a0c1"
msgid ""
"We've all got our part in Her design. Just for some, that's mucking out "
"latrines in the war camp."
msgstr "우리 모두 그분의 계획에서 맡은 바가 있지. 그냥 누군가에겐, 그게 주둔지 변소 똥치우는 일일 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = e1a3123c-6ccd-ac9e-f529-92b065ec1fb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:e1a3123c-6ccd-ac9e-f529-92b065ec1fb2
msgctxt "hc41ebdbegf23eg4611g9dceg2a226740cd4d"
msgid "Not for me to say. All I know is they're bloody useless 'round here."
msgstr "그건 내가 말할 일은 아니고. 내가 말할 수 있는 건 그 녀석들은 여기 하등 쓸모 없다는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = e77a651d-da0f-cea7-460a-54d22bf94c31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:e77a651d-da0f-cea7-460a-54d22bf94c31
msgctxt "h384d76b6g6178g4989g9957gaf23a51371bf"
msgid ""
"Eh, beggin' your pardon, o' course. I'm sure you're mighty as they come."
msgstr "어, 당신한테 한 말은 아니오. 분명 아주 강하겠지, 당연한 말이지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = fc8f2794-ace3-4b50-e457-40c089536d24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:fc8f2794-ace3-4b50-e457-40c089536d24
msgctxt "hf46224d3gf583g4b21g9885g143861d38fd5"
msgid "And only She knows what part twits like them have to play in it."
msgstr "그분께선 저런 멍청이들이 맡을 역할도 다 생각해 두셨겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard
#. Speaker = Acolyte Belub
#. NodeID = fdb90e60-3e09-c26c-8818-e6f8096864c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazEntranceGuard:fdb90e60-3e09-c26c-8818-e6f8096864c0
msgctxt "h9e507885g6e34g4b3fg92dcgfa788682414a"
msgid "O' course - wouldn't dare! I'm sure She's got a plan."
msgstr "물론, 어찌 감히 그럴까! 다 그 분의 계획이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005
#. Speaker = Pilgrim Farimorn
#. NodeID = 4acaa901-65b6-4f31-b9ff-693824f3e6fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazaarStander_005_AudienceReay_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005:4acaa901-65b6-4f31-b9ff-693824f3e6fd
msgctxt "hfb438864g7907g46bfg95ebg629506f25c56"
msgid "Blessings, True Soul. We're to march soon - thanks to you."
msgstr "축복을, 참된 영혼. 곧 진군하게 될 거야, 네 덕분이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005
#. Speaker = Pilgrim Farimorn
#. NodeID = 72eab0fc-47a2-47c1-8677-383b951e1def
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_BazaarStander_005(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005:72eab0fc-47a2-47c1-8677-383b951e1def
msgctxt "h9fc7cbadgbf0eg4aa9g8132ge4b193b22c15"
msgid ""
"Marching under the same banner as goblins. Her new world is a strange one "
"indeed, is it not?"
msgstr "고블린과 같은 깃발 아래에서 행군하다니. 그 분이 만드는 새로운 세상은 낯설어, 안그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005
#. Speaker = Pilgrim Farimorn
#. NodeID = 75d74665-fb6e-4686-af4a-f92bf4f5629d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStande_005_IsobelKidnapped_HasMet(1) = True
#.   Global:
#.      - MOO_MutuallyExclusive_State_IsobelKidnapped = True
#.      - MOO_Isobel_State_AtMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005:75d74665-fb6e-4686-af4a-f92bf4f5629d
msgctxt "h45abcc88g8ce5g4092ga650g1acf2b1237cd"
msgid "In Her name."
msgstr "그분의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005
#. Speaker = Pilgrim Farimorn
#. NodeID = 8799b129-3010-4564-97e5-00c55787b470
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MutuallyExclusive_State_IsobelKidnapped = True
#.      - MOO_Isobel_State_AtMoonrise = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazaarStande_005_IsobelKidnapped_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005:8799b129-3010-4564-97e5-00c55787b470
msgctxt "hc297f70fg6810g4331g9c7fge4de3c486020"
msgid ""
"I hear it was you who threw down the Selûnite. Her god has no power here - "
"not anymore."
msgstr "그 셀루네의 신도를 네가 쓰러뜨렸다고 하던데. 이제 그 신은 여기서 아무런 힘도 가지지 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005
#. Speaker = Pilgrim Farimorn
#. NodeID = 9fa41715-ede4-4cda-978d-1db3b308e238
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_005_AudienceReay_HasMet(1) = True
#.   Global:
#.      - MOO_Audience_State_Ready = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005:9fa41715-ede4-4cda-978d-1db3b308e238
msgctxt "he0152d44gf09dg45c0g9d6agd79984ef4bc4"
msgid "I can only imagine what reward awaits you. In Her name!"
msgstr "네게 준비된 보상이 뭘지 난 상상할 수 밖에 없어. 그 분의 이름으로!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005
#. Speaker = Pilgrim Farimorn
#. NodeID = d63e1fd3-3416-4e0d-9ee0-7481d40df6c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_005_Execution_Hasmet(1) = True
#.   Global:
#.      - MOO_GroundFloor_State_ExecutionOver = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005:d63e1fd3-3416-4e0d-9ee0-7481d40df6c0
msgctxt "h8c9e29eeg1036g4632gbe35gedf3dc44e375"
msgid ""
"A single tower standing against this darkness. What is that, if not proof of "
"Her power?"
msgstr "탑 하나가 어둠을 뚫고 우뚝 서있다. 이게 그 분의 권능의 증거가 아니면 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005
#. Speaker = Pilgrim Farimorn
#. NodeID = f5b5057f-1c08-4f2a-bf25-169381a9da97
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_GroundFloor_State_ExecutionOver = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazaarStander_005_Execution_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005:f5b5057f-1c08-4f2a-bf25-169381a9da97
msgctxt "h930488cbg8996g4bd7g80ceg751c37595e6d"
msgid ""
"Not all of us survived the shadows to stand here. My wife, my sons... they "
"were unworthy."
msgstr "전부 다 그림자를 뚫고 여기 서있는 건 아니야. 내 아내, 아들... 그들은 자격이 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005
#. Speaker = Pilgrim Farimorn
#. NodeID = fbabea49-a358-4295-8618-50179e011fc8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_BazaarStander_005(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_BazaarStander_005(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_005:fbabea49-a358-4295-8618-50179e011fc8
msgctxt "hc55fa592g4999g4cf2g8e65g015071eb3c7d"
msgid ""
"I'm bound for the war camp. I'm no fighter, but... perhaps She sees "
"something I do not."
msgstr "난 주둔지로 가는 중이야. 내가 전사는 아니지만... 어쩌면 그 분께선 내가 보지 못한 무언가를 보신 걸지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006
#. Speaker = Pilgrim Nalira
#. NodeID = 29393223-afe9-4eed-8e54-7636af82fe56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_006_JailbreakSuccess_HasMet(1) = False
#.   Global:
#.      - MOO_MutuallyExclusive_State_JailbreakSuccess = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazaarStander_006_JailbreakSuccess_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006:29393223-afe9-4eed-8e54-7636af82fe56
msgctxt "h519a518bgfc29g45e7gab79gb0853a504acd"
msgid ""
"The prisoners below are <i>gone</i>, True Soul. I cannot understand why they "
"would flee Her mercy."
msgstr "아래에 갇혀있던 죄수들이 <i>탈옥했다</i>, 참된 영혼. 왜 그 분의 자비에서 벗어나려 하는지 이해할 수가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006
#. Speaker = Pilgrim Nalira
#. NodeID = 584c988f-1606-4d83-9446-f5765ee96345
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_006_JailbreakSuccess_HasMet(1) = True
#.   Global:
#.      - MOO_MutuallyExclusive_State_JailbreakSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006:584c988f-1606-4d83-9446-f5765ee96345
msgctxt "h6c37a2f6ge670g45e8g864bg067112a6b261"
msgid "The people of Baldur's Gate will embrace Her gift. They <i>must.</i>"
msgstr "발더스 게이트의 사람들은 그 분의 선물을 받아들일 것이다. <i>그래야만 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006
#. Speaker = Pilgrim Nalira
#. NodeID = 5a4fd61e-d916-417c-9bba-9b6df0dec337
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_006_NecromancerReturned_HasMet(1) = True
#.   Global:
#.      - MOO_MutuallyExclusive_State_BalthazarReturn = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006:5a4fd61e-d916-417c-9bba-9b6df0dec337
msgctxt "h7c369d98gdd17g433eg85dcg2ce4c607aa66"
msgid "In Her name, Her design."
msgstr "그분의 이름으로, 그분의 계획대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006
#. Speaker = Pilgrim Nalira
#. NodeID = 70e50519-d9a2-4f2e-ab9c-b2bd97190621
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_006_IsobelKidnapped_HasMet(1) = True
#.   Global:
#.      - MOO_MutuallyExclusive_State_IsobelKidnapped = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006:70e50519-d9a2-4f2e-ab9c-b2bd97190621
msgctxt "h8bf86ff8g6fe8g4390ga929gab499e6570ca"
msgid "No gods can stop us. Soon, we bring Her glory to Baldur's Gate."
msgstr "어떤 신도 우릴 막을 순 없다. 조만간, 우리가 발더스 게이트에 그 분의 영광을 전할 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006
#. Speaker = Pilgrim Nalira
#. NodeID = 951f5f2a-6e77-41ba-8dca-5bf8eb3f37bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_006_IsobelKidnapped_HasMet(1) = False
#.   Global:
#.      - MOO_MutuallyExclusive_State_IsobelKidnapped = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazaarStander_006_IsobelKidnapped_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006:951f5f2a-6e77-41ba-8dca-5bf8eb3f37bd
msgctxt "h8bf05be6g8876g44cbgbeffg42819c9eb171"
msgid ""
"The cleric from the inn is with us, thanks to you. Even <i>Selûne </i>cannot "
"resist our Absolute."
msgstr "여관에서 온 클레릭이 우리와 함께 한다, 네 덕분이다. <i>셀루네</i>조차도 절대자께 맞서지 못한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006
#. Speaker = Pilgrim Nalira
#. NodeID = b724860b-a248-3208-81f8-b559c563c2e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_006_Execution_HasMet(1) = True
#.   Global:
#.      - MOO_GroundFloor_State_ExecutionOver = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006:b724860b-a248-3208-81f8-b559c563c2e6
msgctxt "h6874f3a1g23e0g4cd2ga0efgadb9d8fc126d"
msgid ""
"Disciple Z'rell wants to see us. You, me, all of us. I <i>know </i>she does."
msgstr "신봉자 즈렐이 우릴 보고 싶어한다. 너, 나, 우리. 그녀가 원한다는 걸 난 <i>알아</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006
#. Speaker = Pilgrim Nalira
#. NodeID = bba08baa-b505-4379-a512-de89726b2b9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_006_NecromancerReturned_HasMet(1) = False
#.   Global:
#.      - MOO_MutuallyExclusive_State_BalthazarReturn = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazaarStander_006_NecromancerReturned_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006:bba08baa-b505-4379-a512-de89726b2b9c
msgctxt "h1429a81bg9634g4c3cgb321g569e9b0d7c84"
msgid "They say you braved the dark to save the General's advisor. Bless you."
msgstr "네가 장군님의 고문을 구하려고 어둠에 맞섰다고 하던데. 신의 축복이 있길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006
#. Speaker = Pilgrim Nalira
#. NodeID = e53aff81-e855-3bcf-890b-322430d4ae33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_BazaarStander_006(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_BazaarStander_006(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006:e53aff81-e855-3bcf-890b-322430d4ae33
msgctxt "hf919228ag8249g4530g8950g53cbdec63120"
msgid ""
"<i>Of many hearts, one soul. Of many thoughts, one mind. Of many parts, one "
"whole.\n"
"In Her name, Her design.</i>"
msgstr ""
"<i>수많은 마음, 하나의 영혼. 수많은 생각, 하나의 정신. 수많은 부분, 하나의 전체.\n"
"그분의 이름으로, 그분의 계획대로.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006
#. Speaker = Pilgrim Nalira
#. NodeID = eda0aea4-06f3-4a76-b9d6-170ea59d1639
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_BazaarStander_006(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006:eda0aea4-06f3-4a76-b9d6-170ea59d1639
msgctxt "hd5e52699ge716g464bga8c0g359dcb28a8d0"
msgid "She walks with you. I can <i>feel</i> Her."
msgstr "그 분께서 너와 함께 하신다. 난 <i>느낄 </i>수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006
#. Speaker = Pilgrim Nalira
#. NodeID = fcc20903-cf64-6e21-6bd4-87e4a3118b4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_006_Execution_HasMet(1) = False
#.   Global:
#.      - MOO_GroundFloor_State_ExecutionOver = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazaarStander_006_Execution_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_006:fcc20903-cf64-6e21-6bd4-87e4a3118b4d
msgctxt "hbe5f2f6eg7e3fg434bga1cfga33a0fab57fb"
msgid ""
"The Absolute Herself called us here. They cannot stop us from seeing Z'rell "
"now!"
msgstr "절대자님께서 직접 우리를 부르셨다. 즈렐을 만나는 걸 막을 순 없어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007
#. Speaker = Pilgrim Taima
#. NodeID = 1ef79f90-d509-48da-b4ef-f1a681d393bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Audience_State_Ready = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazaarStander_007_AudienceReady_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007:1ef79f90-d509-48da-b4ef-f1a681d393bd
msgctxt "h38c2e28agc101g4fc7g890cgc59e8a830f5e"
msgid ""
"I hear you've been summoned for an audience with Her. You will return "
"changed, I'm sure of it."
msgstr "듣자하니 그 분을 알현하기 위해 왔다고 하던데. 돌아올때 넌 변해있을 거야, 확신해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007
#. Speaker = Pilgrim Taima
#. NodeID = 2b4a4b6e-8e6b-0bf6-d570-bcc5000b99a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007:2b4a4b6e-8e6b-0bf6-d570-bcc5000b99a4
msgctxt "hc94f92e3g981eg4107g87ebge5f2d3ad2c40"
msgid ""
"I <i>will</i> join your ranks one day, True Soul. That is the Absolute's "
"promise."
msgstr "언젠가는 너와 같은 자리에 <i>오를거야</i>, 참된 영혼. 절대자께서 약속하셨다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007
#. Speaker = Pilgrim Taima
#. NodeID = 71d673b3-a204-46a5-a6d7-36f94213aa22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_007_AudienceReady_HasMet(1) = True
#.   Global:
#.      - MOO_Audience_State_Ready = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007:71d673b3-a204-46a5-a6d7-36f94213aa22
msgctxt "h34207c65g6d3ag4b69gbe21g206052348434"
msgid "I will pray for you, True Soul."
msgstr "널 위해 기도할게, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007
#. Speaker = Pilgrim Taima
#. NodeID = c336d8c5-1146-eca8-af65-358942706a73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_BazaarStander_007(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_BazaarStander_007(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007:c336d8c5-1146-eca8-af65-358942706a73
msgctxt "h114a314egf607g416agb2b9g4c756401faf4"
msgid ""
"They say the General cannot die. Perhaps... perhaps that will be the "
"Absolute's gift to us all."
msgstr "장군님은 죽을 수 없다고 하던데. 어쩌면... 혹시 절대자께서 우리 모두에게 주시는 선물이 아닐까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007
#. Speaker = Pilgrim Taima
#. NodeID = cb94421e-346c-4056-bc46-80c49443799e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_BazaarStander_007_Execution_HasMet(1) = True
#.   Global:
#.      - MOO_GroundFloor_State_ExecutionOver = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007:cb94421e-346c-4056-bc46-80c49443799e
msgctxt "hb2a420ccg194dg42cegad42g7d9494fcfb40"
msgid ""
"Perhaps I will be blessed as you are. But if not, I will serve in whatever "
"way the General sees fit."
msgstr "어쩌면 너처럼 나도 축복받을 수 있을지도 모르지. 아니더라도, 장군님께서 원하시는 대로 섬기겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007
#. Speaker = Pilgrim Taima
#. NodeID = d369b398-ff32-4ec4-a9f0-1ec29f6f120f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_GroundFloor_State_ExecutionOver = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_BazaarStander_007_Execution_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_BazaarStander_007:d369b398-ff32-4ec4-a9f0-1ec29f6f120f
msgctxt "h20900a69ga47cg4259g9364g398f72b29743"
msgid ""
"You're one of Her blessed, aren't you? To hear Her voice... I cannot imagine."
msgstr "그 분의 축복을 받은 사람 맞지? 그 분의 목소리를 듣는 건... 상상할 수도 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00
#. Speaker = Brawler Orik
#. NodeID = 3b3029bf-1951-ca63-7195-4cf3c8664133
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Bystander00_GoblinsReleased_Hasmet(1) = True
#.   Global:
#.      - MOO_Execution_Event_ReleasedGoblins = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00:3b3029bf-1951-ca63-7195-4cf3c8664133
msgctxt "h4ef69ed3g541bg49dfg9ab4g9b463123135b"
msgid "You're the best True Soul I ever met."
msgstr "내가 만난 참된 영혼 중에 최고야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00
#. Speaker = Brawler Orik
#. NodeID = 53a6c789-8772-44b4-b951-3004c3690f4a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Bystander00(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00:53a6c789-8772-44b4-b951-3004c3690f4a
msgctxt "hc5aa97cag89bcg42afga067g1fb2d5aa3725"
msgid ""
"Bunch of the others were rounded up in the main hall a while ago. They ain't "
"come back..."
msgstr "얼마전에 다른 무리들도 본관에 소집됐었거든. 돌아오진 않았지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00
#. Speaker = Brawler Orik
#. NodeID = 54875a13-57de-4b5b-bdf4-555a3b1c1622
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander00(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00:54875a13-57de-4b5b-bdf4-555a3b1c1622
msgctxt "hece00127g5409g4493gbb8ag3f7d076531ab"
msgid "Still not sure why they brought us all here. Kinda worryin' me."
msgstr "왜 우리 모두를 여기 데려왔는지 아직도 모르겠어. 걱정되는 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00
#. Speaker = Brawler Orik
#. NodeID = 786bc42d-40a9-4773-50de-033310af946b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_GroundFloor_State_ExecutionOver = True
#.      - MOO_Execution_Event_ReleasedGoblins = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Bystander00_GoblinsDead(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00:786bc42d-40a9-4773-50de-033310af946b
msgctxt "hb5012740gbf97g4bb7g9decg7c290bb4010f"
msgid ""
"I won't fail the Absolute like the others. Honest I won't - I was always the "
"smartest."
msgstr "난 그 사람들과는 다르게 절대자님을 실망시키지 않을 거야. 진짜야, 난 언제나 가장 똑똑했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00
#. Speaker = Brawler Orik
#. NodeID = 80e8a9ac-ecc9-ccef-4585-d1e9f41a57ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_ReleasedGoblins = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_Bystander00_GoblinsReleased_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00:80e8a9ac-ecc9-ccef-4585-d1e9f41a57ab
msgctxt "h1eb54a2egf343g4406gad2cgeb7321594699"
msgid "Heard you put in a good word for our mates - cheers."
msgstr "우리 동료들을 위해 좋은 말 해줬다면서, 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00
#. Speaker = Brawler Orik
#. NodeID = a69d506e-fe11-96a7-50e3-9fa4aa05d9c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander00_GoblinsDead(1) = True
#.   Global:
#.      - MOO_GroundFloor_State_ExecutionOver = True
#.      - MOO_Execution_Event_ReleasedGoblins = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander00:a69d506e-fe11-96a7-50e3-9fa4aa05d9c9
msgctxt "hcb798f01g6b56g4dd8gb7e9gd684863d22fe"
msgid "I'm on my best behaviour, I swear."
msgstr "난 최선을 다하고 있어, 진짜야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01
#. Speaker = Brawler Weneg
#. NodeID = 255df0b8-abd4-b79c-1023-16c1506f1c58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander01(1) = False
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Bystander01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01:255df0b8-abd4-b79c-1023-16c1506f1c58
msgctxt "h63f849e0g73fcg45f4gaccdgbf9a85a998e9"
msgid ""
"Heard a rumour some do-gooder stopped a horde of Absolutists from getting "
"their hands on a load of druids in some grove."
msgstr "소문에는 어떤 '선량'한 사람이 숲에 사는 드루이드들을 지키려고 절대자님의 군대를 막았다고 하던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01
#. Speaker = Brawler Weneg
#. NodeID = 441170c0-2c3f-3479-2e0b-286ca8bbb35b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01:441170c0-2c3f-3479-2e0b-286ca8bbb35b
msgctxt "h9185cfd6g625bg41b1g866ag6ff2bb3c204b"
msgid ""
"Whoever it was better pray the General doesn't smoke 'em out. Be a "
"bloodbath, so it would."
msgstr "그게 누군지는 몰라도 장군님께서 누가 그랬는지 알아내시지 않길 기도해야 할 거야. 알아내시면, 피바다가 될 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01
#. Speaker = Brawler Weneg
#. NodeID = 75cf66c9-073f-478b-95ba-2a9d8818a60f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01:75cf66c9-073f-478b-95ba-2a9d8818a60f
msgctxt "h2178d182ga9d5g4dbcg95d6g53eef00ed79a"
msgid "Times are changing fast. Glad I'm here to see it."
msgstr "세상이 빠르게 변하고 있어. 그걸 볼 수 있다니 좋군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01
#. Speaker = Brawler Weneg
#. NodeID = 8444fc66-34f6-f3c8-0f1e-7340b13fb39c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01:8444fc66-34f6-f3c8-0f1e-7340b13fb39c
msgctxt "h74655210g44ecg4d96g80e2gef5e3383b374"
msgid ""
"Ah well. Least you can get an eyeful of the General, while he's holding "
"court."
msgstr "뭐. 그래도 장군님은 실컷 볼 수 있겠군, 지금 재판을 열고 계셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01
#. Speaker = Brawler Weneg
#. NodeID = 8dfe3d5f-2b9f-20b1-3109-dd4268bf16f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander01(1) = False
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = False
#.      - DEN_AttackOnDen_State_RaiderVictory = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Bystander01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01:8dfe3d5f-2b9f-20b1-3109-dd4268bf16f6
msgctxt "hd4f79542g9369g4babg9254g7267669b0f30"
msgid ""
"Eya, you missed all the fun. We caught a bunch of tieflings on the road and "
"slaughtered 'em."
msgstr "어이, 너 재밌는 거 다 놓쳤네. 길에서 티플링 한 무더기를 잡아다가 죽였는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01
#. Speaker = Brawler Weneg
#. NodeID = be430638-6e8f-4b93-99ea-aacbb1387361
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander01(1) = False
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Bystander01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01:be430638-6e8f-4b93-99ea-aacbb1387361
msgctxt "h49adf08cga037g4277g9e76g07ef6e578244"
msgid "Heard that rat's nest of druids was burned to ash. Praise the Absolute!"
msgstr "듣자하니 드루이드 그 쥐새끼 소굴이 잿더미가 되었다는군. 절대자님을 찬양하라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01
#. Speaker = Brawler Weneg
#. NodeID = f3822d62-aa8c-4857-feb5-b28f01d888fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander01:f3822d62-aa8c-4857-feb5-b28f01d888fd
msgctxt "he72c84deg717eg4562gbe5cg217e281d7418"
msgid ""
"Hasn't improved General Ketheric's mood much, though. Court's in session in "
"the inner hall - reckon the hammer'll fall hard."
msgstr "그렇지만 케서릭 장군님의 기분이 나이지진 않았어. 안쪽 홀에서 재판이 있다는군, 아마 심한 판결이 내려질 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander02
#. Speaker = Brawler Wim
#. NodeID = 245cdfa6-cf2e-92cf-61f7-4552f35d1ee5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Bystander02_PostKetheric_HasMet(1) = True
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander02:245cdfa6-cf2e-92cf-61f7-4552f35d1ee5
msgctxt "hd4661a63gcefdg45d0g990cgc80f048408cc"
msgid "We ought to head out now - burn everything between here and the city."
msgstr "이제 출발해야 한다, 도시까지 가는 길에 있는 건 전부 불태워 버리자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander02
#. Speaker = Brawler Wim
#. NodeID = 32331c74-55d5-d647-6b6b-d1dfd8f0042c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Bystander02_PostKetheric_HasMet(1) = False
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_Bystander02_PostKetheric_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander02:32331c74-55d5-d647-6b6b-d1dfd8f0042c
#, fuzzy
msgctxt "h6e307dbfg0799g48f1g9a5egc2bfc6346574"
msgid ""
"I caught a glimpse of Ketheric and Z'rell. Wouldn't have the gumption to "
"stick my nose in, like you did, mind."
msgstr "케서릭이랑 즈렐을 얼핏 봤는데. 내겐 너처럼 그렇게 참견할 재간은 없었을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander02
#. Speaker = Brawler Wim
#. NodeID = 41e8296e-cb22-4489-983c-9dc02402a69a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander02(1) = True
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander02:41e8296e-cb22-4489-983c-9dc02402a69a
msgctxt "hfe68eff0g44b1g442fga8dfgddab66d66140"
msgid "Shh - I'm tryna hear what's going on in there."
msgstr "쉿, 저기서 무슨 일이 있는지 들어보려는 중이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander02
#. Speaker = Brawler Wim
#. NodeID = 8cd213e2-b352-492e-93e5-d5d82f843117
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander02(1) = False
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Bystander02(1) = True
#. TagRule: DROWELF or DROWHALFELF
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander02:8cd213e2-b352-492e-93e5-d5d82f843117
msgctxt "h5987164fge156g4660g8600ga159899899d0"
msgid ""
"Must've come in with the drider, did you? Well, you're in good time. General "
"Ketheric's in the main hall. Don't say I didn't warn you."
msgstr "드라이더랑 같이 왔겠지, 안그래? 음, 좋을 때 왔군. 케서릭 장군님은 본관에 계신다. 난 경고했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander02
#. Speaker = Brawler Wim
#. NodeID = 8cd213e2-b352-492e-93e5-d5d82f843117
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander02(1) = False
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Bystander02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander02:8cd213e2-b352-492e-93e5-d5d82f843117
msgctxt "ha2ccd8e1gf455g45f4gbb54ge6c98a19a480"
msgid ""
"Wouldn't head into the main hall, if I were you. Z'rell and Ketheric are "
"working on some poor worm."
msgstr "나라면, 본관 쪽으로 가지 않을 거다. 즈렐과 케서릭 님께서 불쌍한 벌레를 처리하는 중이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander03
#. Speaker = Pilgrim Sul
#. NodeID = 6150c58a-b9eb-4233-a4fb-f97513fd8d19
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander03(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Bystander03(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander03:6150c58a-b9eb-4233-a4fb-f97513fd8d19
msgctxt "hfea9518bg7ff4g4121g93a1ge74dadf04194"
msgid ""
"She sees everything we are, do you understand? There is no hiding from Her!"
msgstr "절대자께선 우리의 일거수일투족을 다 보고 계십니다, 아시나요? 누구도 벗어날 수 없다고요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander03
#. Speaker = Pilgrim Sul
#. NodeID = 7def66f7-f6d9-4954-97bd-0fb6dbd2312d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Bystander03_IsobelKidnapped_HasMet(1) = True
#.   Global:
#.      - MOO_Isobel_State_AtMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander03:7def66f7-f6d9-4954-97bd-0fb6dbd2312d
msgctxt "he9bb437bg3bceg4b1agb4e5g206ffc55aad2"
msgid ""
"The Absolute will eat this cleric's light. But it won't be enough - not "
"<i>nearly </i>enough."
msgstr "절대자께서 클레릭의 빛을 삼켜버릴 겁니다. 하지만 충분하진 않겠죠. <i>조금도</i> 충분치 않을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander03
#. Speaker = Pilgrim Sul
#. NodeID = 817be521-6436-442d-aa98-74f252962392
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Isobel_State_AtMoonrise = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_Bystander03_IsobelKidnapped_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander03:817be521-6436-442d-aa98-74f252962392
msgctxt "h84af0b37ge2acg44d6gb65bg99cc3013f65c"
msgid ""
"You... you brought Her the moon-witch. She is pleased - do you see it in Her "
"eyes?"
msgstr "다... 당신이 달의 마녀를 데려왔군요. 절대자님이 기뻐하십니다. 그분의 기뻐하는 소리가 들리시나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander03
#. Speaker = Pilgrim Sul
#. NodeID = 84054da4-89e5-43f2-860c-e448e5331593
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander03(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander03:84054da4-89e5-43f2-860c-e448e5331593
msgctxt "h204eb025g0ac2g4ab3gae87g9d99a91d5162"
msgid ""
"There's eyes In the dark... in the walls. Please stop looking at me. Please."
msgstr "어둠속에... 벽속에도 눈이 있어요. 부탁인데 절 그만 좀 쳐다봐 주세요. 제발."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander04
#. Speaker = Pilgrim Iong
#. NodeID = 50336aaa-49dd-4e80-801a-e32a099dfa65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Bystander04_PostKetheric_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_Bystander04_PostKetheric_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander04:50336aaa-49dd-4e80-801a-e32a099dfa65
msgctxt "ha5a1ffc4g909cg4264g97b6g53a40607c5c4"
msgid "The Disciple has returned upstairs but... perhaps she'll still see me."
msgstr "신봉자는 위층으로 돌아갔어, 하지만... 어쩌면 아직도 날 보고 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander04
#. Speaker = Pilgrim Iong
#. NodeID = 5d3ac864-e3f6-4d9d-0684-5b892c69222f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Bystander04_PostKetheric_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander04:5d3ac864-e3f6-4d9d-0684-5b892c69222f
msgctxt "h5be8b173g4e79g48d4g9206g65511c47a5a0"
msgid "An audience with the Absolute. That is my destiny. My <i>right.</i>"
msgstr "절대자님을 알현하는 것. 그건 내 운명이야. 내 <i>권리라고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander04
#. Speaker = Pilgrim Iong
#. NodeID = 64d77c62-3400-9df8-b024-3427f2e0711e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Bystander04(1) = True
#.   Global:
#.      - MOO_Execution_Event_ExecutionerLeavesAfterInterrupt = False
#.      - MOO_Execution_Event_KethericLeaves = False
#.      - MOO_Execution_Event_ExecutionerLeaves = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander04:64d77c62-3400-9df8-b024-3427f2e0711e
msgctxt "ha93fbcfdgdacag4820g8571gd70666270ca4"
msgid ""
"Every caravan brings more faithful for the Absolute. But I will stand among "
"the <i>first.</i>"
msgstr "상단이 올때마다 절대자님의 신도를 데려오는군. 하지만 내가 그 중에 <i>첫번째</i>로 설 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander04
#. Speaker = Pilgrim Iong
#. NodeID = 8641165e-fa6b-47cd-94f8-3282401e2753
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_ExecutionerLeavesAfterInterrupt = False
#.      - MOO_Execution_Event_ExecutionerLeaves = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Bystander04(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Bystander04:8641165e-fa6b-47cd-94f8-3282401e2753
msgctxt "hc86a8b36gef53g4d71g8dd7g848852535fb4"
msgid "Back of the line. I'll be the first of us to swear to the General."
msgstr "뒤로 줄서. 내가 장군님께 맹세를 올리는 첫번째 사람이 될 거니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00
#. Speaker = Adept Dorikel
#. NodeID = 0c881d19-b5ea-6647-f831-7d48e8fc9a8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00:0c881d19-b5ea-6647-f831-7d48e8fc9a8f
msgctxt "h798e6c1fg2578g4636gb752ga90ed3f1dcd6"
msgid "<i>We march to Baldur's Gate!</i>"
msgstr "<i>발더스 게이트로 진군하는 거지!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00
#. Speaker = Adept Dorikel
#. NodeID = 139a32dd-e598-f5a8-a21e-3858da75f140
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00:139a32dd-e598-f5a8-a21e-3858da75f140
msgctxt "h6969fc60gf78bg4114ga6c3g2cfd8d7a109e"
msgid ""
"Us. We are so many. And we are marching to Baldur's Gate, as soon as the "
"Absolute gives word."
msgstr "우리지. 우린 엄청 많아. 절대자님께서 명령만 하시면, 발더스 게이트로 진군할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00
#. Speaker = Player
#. NodeID = 4a02dcbf-f9cd-a2b4-4e54-3644d8ad8234
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00:4a02dcbf-f9cd-a2b4-4e54-3644d8ad8234
msgctxt "h655fb289gf89bg4cd8g892bg2aefcba0c71f"
msgid "What role will you take?"
msgstr "거기서 넌 무슨 역할인데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00
#. Speaker = Adept Dorikel
#. NodeID = 549ad854-0caa-10aa-c27d-57daf643b76f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00:549ad854-0caa-10aa-c27d-57daf643b76f
msgctxt "hc0ddec0egfc3cg460ag9829g59c877256f90"
msgid ""
"I'm trained as an assassin. House Hekar. Perhaps I can serve as a scout - or "
"special operations."
msgstr "난 암살자 훈련을 받았어. 헤카르 가문이지. 어쩌면 정찰병이 되거나, 특별 작전을 맡을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00
#. Speaker = Adept Dorikel
#. NodeID = 7f750197-28d0-7a8d-2223-1ac7afc711d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00:7f750197-28d0-7a8d-2223-1ac7afc711d6
msgctxt "hf4f7c05egaed4g495bgb145gdfb08773d6b9"
msgid ""
"I've never been to battle. I've never been to war. But I feel so... calm. "
"<i>Ready.</i>"
msgstr "전투에 참가해 본 적은 없어. 전쟁도 처음이지. 하지만 뭔가... 평온해. <i>준비됐어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00
#. Speaker = Adept Dorikel
#. NodeID = a9471060-3ac4-8ef8-36b4-7525bc9d6377
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Guard00(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Guard00(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00:a9471060-3ac4-8ef8-36b4-7525bc9d6377
msgctxt "hdc33f315g37c4g48b6ga43bge6524ae4da63"
msgid "I saw it, True Soul. The army. They're nearly ready. It's nearly time."
msgstr "내가 봤어, 참된 영혼. 군대말이야. 거의 다 준비됐던데. 때가 다가오고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00
#. Speaker = Adept Dorikel
#. NodeID = bc87081a-c171-29ee-98a3-a6524c70712c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00:bc87081a-c171-29ee-98a3-a6524c70712c
msgctxt "h5dfb3e6bg84eeg4254g804dg272845aa6fa7"
msgid "When the call comes, I'll be ready."
msgstr "그 때가 온다면, 난 준비되어 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00
#. Speaker = Adept Dorikel
#. NodeID = d71cc6e0-b1d5-a904-042c-6474147bcb2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Guard00(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00:d71cc6e0-b1d5-a904-042c-6474147bcb2f
msgctxt "hdf347708gbbb4g4267ga484g8ddab58ea7e4"
msgid ""
"The General is inside. I've never seen him so near. It's all happening..."
msgstr "장군님께선 안에 계셔. 이렇게 가까이서 보는 건 처음인데. 이루어지고 있어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00
#. Speaker = Player
#. NodeID = db3066c6-f52d-5c93-f7b0-daded2a8122d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00:db3066c6-f52d-5c93-f7b0-daded2a8122d
msgctxt "h745982ebg44cbg48f0g88f3g5b1ba9c31d08"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00
#. Speaker = Player
#. NodeID = e2616152-3661-b835-448a-d76b14964b40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00:e2616152-3661-b835-448a-d76b14964b40
msgctxt "hc8233fc1g19c2g4cb4g8fb1gb464fdf3906d"
msgid "Which army do you mean?"
msgstr "어떤 군대 말하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00
#. Speaker = Player
#. NodeID = fefb4f07-81e6-1fa6-43a5-a57ec55fc2e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard00:fefb4f07-81e6-1fa6-43a5-a57ec55fc2e8
msgctxt "h2bb21a36g6dc8g4adegb133gb717e9a86fa7"
msgid "And when the hour draws near...?"
msgstr "그리고 때가 오면...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard01
#. Speaker = Adept Furek
#. NodeID = 1e544a9c-3e6c-e5bc-49b8-c7c6f17af352
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Guard01_BeforeExecution(1) = True
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard01:1e544a9c-3e6c-e5bc-49b8-c7c6f17af352
msgctxt "h01634c11geaedg4f3cgb9deg9a6fee03a855"
msgid ""
"You should go through the main hall. Witnessing the General's justice is an "
"honour."
msgstr "본관으로 들어가라. 장군님께서 정의를 집행하시는 모습을 목도하는 건 영광스러운 일이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard01
#. Speaker = Adept Furek
#. NodeID = 26eb7946-1730-baa0-3126-45d9e6cc618f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Guard01_BeforeExecution(1) = False
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Guard01_BeforeExecution(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard01:26eb7946-1730-baa0-3126-45d9e6cc618f
msgctxt "h86b3512cgb4a0g4514g83c2geb81c4b8b9ed"
msgid ""
"Welcome back, True Soul. Z'rell is holding an audience with the General - "
"deciding the fate of those who have failed the Absolute."
msgstr "돌아온 걸 환영한다, 참된 영혼. 즈렐이 장군님을 알현하고 있다. 절대자님의 뜻을 져버린 이들의 운명을 결정하는 중이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard01
#. Speaker = Adept Furek
#. NodeID = ccba9db3-bfd7-4b36-9837-e199aeceecc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Guard01(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Guard01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard01:ccba9db3-bfd7-4b36-9837-e199aeceecc6
msgctxt "h14087320gacfdg42fagbf10g9e314f6fe11c"
msgid "Did the goblins suffer? Rabble like that don't deserve mercy."
msgstr "그 고블린에게 고통을 줬나? 그런 하찮은 놈에게는 자비가 필요없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard01
#. Speaker = Adept Furek
#. NodeID = e0819960-d402-41ce-9747-41b31c21705c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Guard01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Guard01:e0819960-d402-41ce-9747-41b31c21705c
msgctxt "h0e3bbb49gb38bg431bga7eagf07cfabe8b32"
msgid "Praise the Absolute. Serve the General."
msgstr "절대자를 찬양하라. 장군님께 복종하라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_PAD_SharranObservation
#. Speaker = Shadowheart
#. NodeID = 5bd7777a-a2ca-4609-afba-83d8bc99d13b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_PAD_SharranObservation:5bd7777a-a2ca-4609-afba-83d8bc99d13b
msgctxt "ha12e2416g6d0eg4d96gaf57g8c610a4f266e"
msgid "There is nothing Sharran about this man. He has betrayed the Dark Lady."
msgstr "이 자는 결코 샤 신도가 아니야. 놈은 어둠의 여신을 배신했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 0186026c-71b6-b72e-6f7f-bb4b345d2534
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:0186026c-71b6-b72e-6f7f-bb4b345d2534
msgctxt "h570239b8g9555g4ba3gbce3gaac06c05a6e1"
msgid ""
"You're a fool if you think this lot have any loyalty. They'll turn on you in "
"a second."
msgstr "놈들에게 신의를 바라는 건 바보나 할 생각이다. 찰나의 틈만 보여도 배신하겠지. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 03adb2b2-48dd-4a1b-8860-342af9582d64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:03adb2b2-48dd-4a1b-8860-342af9582d64
msgctxt "hebb44c11g1eaeg4a48g8855g742c1983f175"
msgid "Ever at your service."
msgstr "언제든지 말해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 03cb3a4e-38f2-d351-948d-8849574a9c34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:03cb3a4e-38f2-d351-948d-8849574a9c34
msgctxt "h934e719bgd485g4a43g9546gdcbb03805521"
msgid "I actually had a pretty good view of the slaughter."
msgstr "학살이 일어나는 걸 내 두 눈으로 똑똑히 봤는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 0850fd1e-016f-a00b-7270-0840f87440ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:0850fd1e-016f-a00b-7270-0840f87440ea
msgctxt "hde9a94begc23fg4231g9b52g0d2f1ee8be2a"
msgid ""
"Blessed by association, let's say. I come to pay proper respect to a new "
"power."
msgstr "그런 말 있잖아, 좋은 게 좋은 거라고. 신흥강자에게 예의를 갖춰 인사하러 왔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 0d296801-3b6f-e46c-6a99-6420d1b5813c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:0d296801-3b6f-e46c-6a99-6420d1b5813c
msgctxt "hbe391d25gc313g4359g91b0g3bd73a73841e"
msgid ""
"Spend enough time in this place, and you might just start to believe them."
msgstr "여기 오래 머무르다 보면, 믿음이 생길지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 1101dedc-dede-25a8-9014-21186088642c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_QuartermasterFlimsy_HasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:1101dedc-dede-25a8-9014-21186088642c
msgctxt "he0406a5dg495eg4e53g8773g2c675cf0f3f0"
msgid "Are you a follower of the Absolute?"
msgstr "너 절대자 추종자였어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 159ccaae-4380-a636-2da0-2b3cfc4ece97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:159ccaae-4380-a636-2da0-2b3cfc4ece97
msgctxt "h3690a494g6789g4099gb7b3gefb36091516a"
msgid "Such a pity there were no survivors to tell what truly happened there."
msgstr "실제로 거기서 무슨 일이 일어났는지 말해줄 사람이 한명도 살아남지 못했다니 안타까운 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 1672803f-eaf0-0a61-f26d-7afca7451016
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_QuartermasterFlimsy_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:1672803f-eaf0-0a61-f26d-7afca7451016
msgctxt "hc7ad1e62g4c45g4718g983ag7069185ac2e6"
msgid "'New face'? We've met before - at the goblin camp."
msgstr "'신입?' 우리 전에 만난 적 있잖아, 고블린 야영지에서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 1dcdcbd5-bcf3-4ee2-d975-0a52fa2693fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:1dcdcbd5-bcf3-4ee2-d975-0a52fa2693fa
msgctxt "h82bfaee8g060dg4848g8617g8834921d4354"
msgid ""
"But look at me preaching, and when I'm only here to serve. Anything to "
"trade, True Soul?"
msgstr "그저 섬기려고 왔을 뿐인데, 말이 너무 많았군. 뭐 사고 싶은 거 있나, 참된 영혼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 21c6f06a-7ba2-47b8-cfea-03f63e8a6afb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:21c6f06a-7ba2-47b8-cfea-03f63e8a6afb
msgctxt "h7440ec0bg435cg4d92gad90g31a5fb6fcab5"
msgid "A pity neither of us saw what happened."
msgstr "안타깝게도 우리 둘 다 아무것도 보지 못했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 301c3727-c58e-c853-9d10-f3f93cea82e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Zhentarim_Knows_Zhentarim = True
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:301c3727-c58e-c853-9d10-f3f93cea82e6
msgctxt "hc3dd99b3gc601g40cag98c0g98492b41bcf3"
msgid "<i>Lock eyes with the Zhent and gesture in Thieves' Cant: Discount?</i>"
msgstr "<i>젠타림에게 눈을 맞추고 도둑의 은어로 사인을 보낸다: 할인은?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 307a6e0d-2364-4d50-8820-26b6d1d11c2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Zhent00(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Zhent00(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:307a6e0d-2364-4d50-8820-26b6d1d11c2e
msgctxt "h1364f315g11b3g4909g97e2g30703e8178f9"
msgid ""
"Ah, a new face come to bask in the light of the Absolute. How can I be of "
"service, True Soul?"
msgstr "아, 절대자의 은혜를 받고 싶은 신입이로군. 무엇을 도와 드릴까, 참된 영혼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 33460458-f983-2e47-52a2-15b7686c8758
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Zhentarim_Knows_Zhentarim = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:33460458-f983-2e47-52a2-15b7686c8758
msgctxt "h5dfe0783g1e8cg400dga344g431745b78485"
msgid "'The Zhentarim'?"
msgstr "'젠타림'?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 344f532b-ea9b-5980-ea37-11718e1611f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:344f532b-ea9b-5980-ea37-11718e1611f0
msgctxt "h49fe1951gb1ceg4c73g9605ge3946d060cfa"
msgid "Drop the act. What are you actually doing here?"
msgstr "연기 그만해. 진짜로 여기서 뭐하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 49773346-3bdb-1779-2666-96a9bb2c485e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:49773346-3bdb-1779-2666-96a9bb2c485e
msgctxt "hc4f8c8c5g74e0g4abag8d05g8e9fbf88eeaa"
msgid "Careful. That sounds like an accusation."
msgstr "이봐. 말에 뼈가 있는 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 4bbf8053-4842-b6ad-3580-7cbd9fcc22ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:4bbf8053-4842-b6ad-3580-7cbd9fcc22ce
msgctxt "hdb345c79g6a0ag4ea6gacf7gec03a269e987"
msgid ""
"The guilty ear hears blame in every breath. But you're among friends here, "
"True Soul."
msgstr "도둑에 제발 저리는 법이지. 아무튼 여기선 다들 친구라고, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 4bca4efe-93df-401d-2827-b01410837816
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:4bca4efe-93df-401d-2827-b01410837816
msgctxt "hd5e1ded9ga8e1g43f8g8a13g7247ed50b2c8"
msgid "You know, you sound less and less like a true believer with every word."
msgstr "이봐, 넌 말할 때마다 진짜 믿음을 가진 사람이 아닌 거 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 4c6511e0-0454-8ad9-4b62-0774283484d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:4c6511e0-0454-8ad9-4b62-0774283484d0
msgctxt "heb8970a1ga651g4e80g8968ge03116d24d05"
msgid ""
"I'm not the one putting on an act, True Soul.  Though I'd mind how well you "
"mouth your prayers."
msgstr "연기를 누가 하고 있다고 생각하나, 참된 영혼. 나라면 기도문 외울 걱정부터 하겠는데 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 522a0dbd-8944-ae51-6315-51dea4b303d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:522a0dbd-8944-ae51-6315-51dea4b303d8
msgctxt "hea497012gca6dg48a4gb285g2c2ccf73719b"
msgid "For now, I'll settle for getting you what you need. Anything to trade?"
msgstr "일단은, 당장 네가 필요로 하는 걸 준비해 주겠어. 거래하겠나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 56660d83-d069-7503-6246-810c35397c62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:56660d83-d069-7503-6246-810c35397c62
msgctxt "h2ce82670g6702g4aa7g8ed5g89515df147dd"
msgid ""
"Oh, True Soul, I couldn't burden your spirit with such material concerns. "
"But I'm always happy to trade."
msgstr "오, 참된 영혼, 이런 물질적인 걸로 네 영혼에 부담을 주긴 싫어. 그래도 거래라면 환영하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Narrator
#. NodeID = 57eb1b1a-4315-fe72-28a7-ed8f9fb80790
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Zhentarim_Knows_Zhentarim = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:57eb1b1a-4315-fe72-28a7-ed8f9fb80790
msgctxt "h4062120ege041g4e5bgb892gfa056c0b22b0"
msgid ""
"*The Zhentarim - a network of merchants and mercenaries known for deep "
"coffers and shallow scruples.*"
msgstr "*젠타림입니다. 깊숙한 금고와 그에 반비례하는 얄팍한 양심으로 유명한 상인들과 용병들의 조직이죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 59756ad6-43ed-57f3-1a29-a59968b74437
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:59756ad6-43ed-57f3-1a29-a59968b74437
msgctxt "h9d40706cg4c19g4d68g8713g3f8c9975e7f9"
msgid ""
"All who pass through here find their way to the Absolute, one way or another."
msgstr "여길 지나는 모든 사람들은 절대자에게로 가게 되더라고, 어떤식으로든 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 5a061b30-4086-befc-053f-3df6b639b9f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:5a061b30-4086-befc-053f-3df6b639b9f5
msgctxt "h124d9ffegb976g43b5g8e2fgee90d9db8975"
msgid ""
"Can't say I've ever drawn steel on children. Suppose I'm not True Soul "
"material."
msgstr "난 그래도 아이들에게 날붙이를 겨눈 적은 없거든. 아무래도 나한테 참된 영혼이 될 자질은 없나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 600c597f-4495-236b-a354-f8c9f0b62286
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:600c597f-4495-236b-a354-f8c9f0b62286
msgctxt "hc1ef12beg81d9g4067g9149gc6e70bed9e11"
msgid "Really? You saw nothing at all?"
msgstr "진짜? 아무 것도 못봤다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 7149c975-c4d3-1e5c-8a37-a8f98ff5f51b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:7149c975-c4d3-1e5c-8a37-a8f98ff5f51b
msgctxt "h13459fc3g5e8fg408bg9b03g507dd4e427ff"
msgid ""
"But what would I know of faith? I cater to more earthly needs. Better we "
"focus on that, hm?"
msgstr "하지만 내가 믿음에 대해 뭘 알겠어? 세속적인 욕망이나 더 채워야지. 거기 집중하는 게 낫지 않겠어, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 757a9ece-4905-c209-07d2-a0862010d2dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:757a9ece-4905-c209-07d2-a0862010d2dd
msgctxt "hc22f3c8ag23d6g436fgb2b2g6fe33e908303"
msgid "Do you have anything to trade?"
msgstr "거래할 만한 거 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 7ea9fb22-d6c1-d054-9dd2-a055af0e8869
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:7ea9fb22-d6c1-d054-9dd2-a055af0e8869
msgctxt "h99ddeccdg5f9ag43ebg95fag2e2b9daef441"
msgid "Stick to trading, then. Show me your wares."
msgstr "그럼 거래나 하지 그래. 뭘 갖고 있는 지 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 83502586-bcbe-acfc-4a2b-0d86e211bb07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:83502586-bcbe-acfc-4a2b-0d86e211bb07
msgctxt "h02942978gf4b3g441cgb822g71cc54b706e2"
msgid ""
"For another in the business? Don't see why not. We can certainly afford it - "
"business is booming."
msgstr "또 다른 사업에 관심이 있나? 안 될 거 없지. 자금은 충분하거든. 사업이 워낙 잘돼서 말이야. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 87a99ff2-a5f5-bc95-fe66-631bea67423e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_State_LeadersAreDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:87a99ff2-a5f5-bc95-fe66-631bea67423e
msgctxt "h3e2b8246gba39g4f31gac79g66dd595925fe"
msgid ""
"...of course! Just before some godless lunatic purged the place of every "
"innocent soul."
msgstr "... 그렇지! 어떤 미친 무신론자가 거기있는 무고한 영혼들을 정화시켜버리기 바로 전에 만났었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 88fd96b8-a5f7-87bf-812f-39324643b28e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:88fd96b8-a5f7-87bf-812f-39324643b28e
msgctxt "h1f376587g4031g4438g9806g332d4f4682b8"
msgid "An honour, True Soul."
msgstr "영광이야, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 8e7d0e78-d752-79d7-ebe7-89489292e7fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:8e7d0e78-d752-79d7-ebe7-89489292e7fa
msgctxt "hceaa5a89g3eacg4ae6gadabg102a6e1e8452"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 916e8379-53e6-f131-8f90-0c9b7f6d4cdf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenLost = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:916e8379-53e6-f131-8f90-0c9b7f6d4cdf
msgctxt "h0e6edc02ge991g4bc5g9b3dg504471a189c5"
msgid "Ah, yes. The one who saved us from the infidels in the grove."
msgstr "아, 그래. 숲의 이교도들 한테서 우릴 구해준 사람이구만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = 965abf28-b170-3bfe-30fd-c5dea14ef1b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:965abf28-b170-3bfe-30fd-c5dea14ef1b2
msgctxt "h105310e7g12bbg4fb6g8185g4129e5f8360c"
msgid ""
"I'd bow, but the Zhentarim prefer to look their business partners in the eye."
msgstr "고개숙여 인사하고 싶었지만, 젠타림은 원래 동업자끼리 눈을 똑바로 쳐다보고 거래를 하는 편이라서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 9849df6d-4f8a-28e5-c473-66a43835b506
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:9849df6d-4f8a-28e5-c473-66a43835b506
msgctxt "h9b219193g7735g4c7dg852bg1438545dec99"
msgid "I would hardly call the goblins there 'innocents'."
msgstr "그 고블린들 '무고하다고' 할 수 없을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 98ec0571-4ad2-05b7-fe94-048b2fffa2b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:98ec0571-4ad2-05b7-fe94-048b2fffa2b0
msgctxt "hc705f128g62c7g4617g8451g05c1c3be2301"
msgid "Indeed. Can I see your wares?"
msgstr "그래. 파는 것 좀 볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 9ecc3934-85c3-1112-f7e1-4ab0d50f8e73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:9ecc3934-85c3-1112-f7e1-4ab0d50f8e73
msgctxt "head8a3c7g1decg4aafgb17fg3381fb844bd9"
msgid "<i>Trade.</i>"
msgstr "<i>거래한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = 9fb2de92-2c01-d6f2-5c4b-c49a455923b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:9fb2de92-2c01-d6f2-5c4b-c49a455923b4
msgctxt "h21d789d6g552cg4475gb1b1g0177a67d4326"
msgid "If they failed, it was because their faith was weak."
msgstr "실패했다면, 그건 믿음이 부족해서 그랬을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = a28bdd23-b87a-f0d5-8b2a-559749e40676
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:a28bdd23-b87a-f0d5-8b2a-559749e40676
msgctxt "h40f94e38gf35cg4602g9b24gce7843b2af5c"
msgid ""
"Ah yes - around the time of Minthara's ill-fated expedition to the grove."
msgstr "아 맞아, 민타라의 불행한 숲 원정 그때쯤이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = a3ef9f63-c061-34e3-d547-4963abadca75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:a3ef9f63-c061-34e3-d547-4963abadca75
msgctxt "hb8dcef02g0740g4d45g9079gc0a8971e9b6f"
msgid "Let's see your wares."
msgstr "파는 것 좀 보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = a66f3c93-0985-7b28-6bf1-cf2a2a7d9b65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:a66f3c93-0985-7b28-6bf1-cf2a2a7d9b65
msgctxt "hda45ef69gc1cfg42bcga2cbgec1b896942c5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = a8a553d2-46ac-2035-629a-cee339fdfbdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:a8a553d2-46ac-2035-629a-cee339fdfbdc
msgctxt "h2043da99gf626g4edagaccegb1f4f826d33d"
msgid "Let's see what you have."
msgstr "뭘 갖고 있는지 볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = b2fe868f-9aed-061c-7951-b0a74dd8610b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Zhent00_ConfrontedAboutCargo(1) = False
#.   Global:
#.      - MOO_Docks_Vat_Knows_Zhentarim = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:b2fe868f-9aed-061c-7951-b0a74dd8610b
msgctxt "h695dcc4fg4af8g4427gbf53g0c46bdd95025"
msgid ""
"I've seen your sigil on cargo at the docks. The Zhentarim have joined the "
"Absolute?"
msgstr "부두에 있는 화물에서 네 인장을 봤는데. 젠타림이 절대자한테 붙은 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = b303df18-5df0-287f-c98f-365fadd8969a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_Zhent00_ConfrontedAboutCargo(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:b303df18-5df0-287f-c98f-365fadd8969a
msgctxt "he5fbc293ga2f8g4f1dg9afbg48c0a494cbba"
msgid ""
"Waukeen's clipped coins, <i>no</i>. Faith is an over-flooded market. "
"<i>Transport</i>, however -"
msgstr "와우킨이 동전 깎는 소리하네, <i>아냐</i>. 신앙은 수지맞는 장사가 못돼. 하지만 <i>운송</i>은 얘기가 다르지 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = b3544ca9-e1b8-646a-8ee1-68aa7d8db60e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:b3544ca9-e1b8-646a-8ee1-68aa7d8db60e
msgctxt "ha8087abcgf34eg4d67gb892gbf54f6bae5eb"
msgid "Speak for yourself. I had a pretty good view of the slaughter."
msgstr "그건 네 생각이고. 난 학살이 일어나는 걸 똑똑히 봤다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = b49fce48-3fe7-f3f5-4b24-5df9c135d7ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:b49fce48-3fe7-f3f5-4b24-5df9c135d7ed
msgctxt "ha3a91556g8903g4744gb8a1g4b19bf5a735b"
msgid "You almost sound concerned for my safety."
msgstr "날 걱정해주는 것처럼 들릴 정도인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = b75e1fe1-19ff-2ee0-84bb-e02527f591e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:b75e1fe1-19ff-2ee0-84bb-e02527f591e9
msgctxt "haff0d0ccg6705g42a7gaa5bg829e39305a2e"
msgid ""
"Quite a god to bring them all together. And quite a fool who'd draw their "
"ire, hm?"
msgstr "쟤네들을 다 모으다니 대단한 신인가봐. 근데 쟤네들 전부 화나게 만든 바보도 있었지, 아마?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = bae8b334-ce57-eda3-ebbe-a60b1122d8e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Zhent00_ConfrontedAboutCargo(1) = False
#.   Global:
#.      - GLO_Zhentarim_Knows_Zhentarim = True
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:bae8b334-ce57-eda3-ebbe-a60b1122d8e7
msgctxt "h9436b6b2gcdf7g4757g8305ge09b0e80970d"
msgid "What business do mercenaries have with a cult?"
msgstr "용병이 교단이랑 무슨 사업을 한다는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = bd15e4fc-d146-310f-3668-19353fefc80d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Zhent00_ConfrontedAboutCargo(1) = False
#.   Global:
#.      - MOO_Docks_Vat_Knows_Zhentarim = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:bd15e4fc-d146-310f-3668-19353fefc80d
msgctxt "h13fb0f30gb24bg47fbg83c8gb3e0be3f1423"
msgid "I've seen the docks. The Zhentarim have joined the Absolute?"
msgstr "부두에 있는 걸 봤어. 젠타림이 이젠 절대자 무리에 합류한 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = bdfbc2fe-996d-6be2-b3f9-e693c0c1a5f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:bdfbc2fe-996d-6be2-b3f9-e693c0c1a5f2
msgctxt "h01a1e28fgfdeeg458egbf9aga83fdb36ce91"
msgid ""
"Oh come now - we're far more than just soldiers for hire. Have a <i>bit</i> "
"more imagination."
msgstr "너무하잖아. 우린 단순한 용병 집단이 아니라고. 상상력을 <i>조금만</i> 더 발휘해 봐. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = c214f306-ab70-0f90-6f1c-911630ad0ae7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:c214f306-ab70-0f90-6f1c-911630ad0ae7
msgctxt "hc87bc531g39a8g4443ga296g5bcfa3054cf2"
msgid "More concerned that your business might be bad for <i>my</i> business."
msgstr "네가 하는 짓이 <i>내</i>가 하는 짓에 방해될까봐 걱정하는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = c41cf28c-c63f-decf-48aa-8d653c882078
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:c41cf28c-c63f-decf-48aa-8d653c882078
msgctxt "h2643cbb0ge9acg442cg9baag2b35eb716db0"
msgid ""
"So we did. And it seems we both have a nose for where the <i>real</i> power "
"lies - I've come to pay proper respect."
msgstr ""
"그래, 만났지. 그리고 우리 둘 다 <i>진짜</i> 힘을 찾아내는 능력이 있는 것 같네. 난 그 힘에게 예를 갖춰 인사하러 왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = c48efaf3-92b1-1aef-7d8c-05979faee3a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:c48efaf3-92b1-1aef-7d8c-05979faee3a3
msgctxt "hb01c034cg4716g4465gb726gb4108b6dbc6a"
msgid "So don't go kicking the hive while there's still some honey to be had."
msgstr "그러니 아직 꿀이 남아있는 벌집을 걷어차는 짓은 하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = c719f1ff-0bf7-74ad-58f3-8d3d8f83509a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:c719f1ff-0bf7-74ad-58f3-8d3d8f83509a
msgctxt "h65bf6ad0gd358g4921ga50bgd6e7d8d149b5"
msgid ""
"These faithful folk need some goods moved into the city. Our ships are "
"obliging - <i>quietly.</i>"
msgstr "이 신실한 친구들이 도시로 물건을 옮기고 싶어해. 우리 배가 도울 수 있을 것 같아. <i>아주 조용하게.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = cdac1944-316f-8a6d-c48c-3356a05c7eb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:cdac1944-316f-8a6d-c48c-3356a05c7eb0
msgctxt "hee19fb4fge3d0g4c90gbc7bg983f638959c9"
msgid "Smuggling? I want in."
msgstr "밀수인가? 나도 끼겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = cf91f2a6-684c-4e55-0c6d-f99dd61346ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Zhent00_ConfrontedAboutCargo(1) = False
#.   Global:
#.      - GLO_Zhentarim_Knows_Zhentarim = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:cf91f2a6-684c-4e55-0c6d-f99dd61346ee
msgctxt "hd06350d9g41aeg406aga3cdg8215e92e0d68"
msgid "So the Zhentarim have allied themselves with the Absolute?"
msgstr "이젠 젠타림이 절대자와 동맹이라도 맺은 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = d0ee2953-2f01-f186-f74a-373110482458
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Zhent00_ConfrontedAboutCargo(1) = False
#.   Global:
#.      - MOO_Docks_Vat_Knows_Zhentarim = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:d0ee2953-2f01-f186-f74a-373110482458
msgctxt "h61427cffg4d18g40fdga435g2747796ed155"
msgid "Spare me. I saw the docks - the Zhentarim have joined the cult."
msgstr "헛소리. 부두에 있는 걸 봤어. 젠타림이 교단에 합류한 거 맞잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = d3819356-38a5-b545-fcd1-aa32c3792b4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:d3819356-38a5-b545-fcd1-aa32c3792b4e
msgctxt "h3ce75a85g781eg463fg9feagab7ebb08d092"
msgid "You didn't strike me as the bleeding heart type."
msgstr "딱히 동정심이 넘치는 타입은 아닌 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = d9249c85-7212-2662-a136-c1728767ff36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:d9249c85-7212-2662-a136-c1728767ff36
msgctxt "h6d786a89g1ce1g414ag96dcgcfac972462dd"
msgid "You were rather quick to find your faith."
msgstr "믿음 한번 빨리 찾았네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = e0da885a-8adf-9336-1b9e-e538320361c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:e0da885a-8adf-9336-1b9e-e538320361c8
msgctxt "h5f8fae8bg569ag4cd3g87aag3509845e269c"
msgid ""
"Merchants like any other. Though we tend to see opportunity where others "
"don't."
msgstr "다른 상인들과 똑같아. 하지만 우린 다른 상인들이 보지 못하는 기회를 잘 보는 편이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = e79de160-0f52-d2c9-1965-aadfec37507d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:e79de160-0f52-d2c9-1965-aadfec37507d
msgctxt "h7cd8dfd8gc2f2g4922gbef6ga23e9f3e2af6"
msgid ""
"Look around. All manner of beasties united against the enemies of the "
"Absolute."
msgstr "주변을 보라고. 온갖 짐승들이 절대자의 적을 물리치기 위해 모였잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = e7ae521b-a41b-fbee-893b-d5a76b6afcff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:e7ae521b-a41b-fbee-893b-d5a76b6afcff
msgctxt "h15210acag059fg4428g9703gb75d31804753"
msgid ""
"These faithful folk don't ask for much - just some cargo moved to the city. "
"But my <i>goodness</i> do they pay generously."
msgstr ""
"이 신실한 친구들의 요구사항이 별건 아니야. 화물 하나를 도시까지 옮기기만 하면 돼. 하지만 그런 것 치고는 <i>꽤나</i> 후하게 "
"값을 쳐준단 말이지. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = e8ef36bd-3874-10d5-72d6-e15d5b8266ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:e8ef36bd-3874-10d5-72d6-e15d5b8266ca
msgctxt "h4974aa20gd12dg4295g9b4cgf5408a38155f"
msgid ""
"Better to keep that quiet, unless you want another look from the receiving "
"end."
msgstr "입다물고 있는 게 좋을걸. 반대로 네가 당하는 입장이 되고 싶은 게 아니라면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = ea8b159d-1c12-69a9-6e6b-55db1e2b3a40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:ea8b159d-1c12-69a9-6e6b-55db1e2b3a40
msgctxt "h0946e1c4g7c70g4ad9g8843g31e5e5a8e84b"
msgid ""
"Oh, I'm sure they deserved it. I'm all for people getting what they deserve."
msgstr "물론 합당한 대가를 치른 거겠지. 사람들과 대가를 주고받는 게 내 일이라서 잘 안다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = f00e1fca-2b6e-4a1c-945c-42e0a72dd93e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:f00e1fca-2b6e-4a1c-945c-42e0a72dd93e
msgctxt "hefcf21bdg3ccbg46b0gb350g3a3199b8a7c0"
msgid "How painful the path is - well, that's up to them."
msgstr "그 길이 얼마나 고통스러울지는, 뭐, 그건 걔네들한테 달렸지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = f0855ea1-8bb1-187c-7225-4b761f4a1ddd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:f0855ea1-8bb1-187c-7225-4b761f4a1ddd
msgctxt "hc5415c04ge4beg4edbga90fg6a96b6f2ff33"
msgid ""
"Nothing worth repeating. Corpses don't much go in for commerce. Here, though?"
msgstr "떠벌리고 다닐만한 일은 없었다고 해 두지. 시체하고는 거래가 안 되거든. 근데 여긴 말이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Roah Moonglow
#. NodeID = f39ff712-7108-a1bf-f5a6-a4c7e70fdec9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:f39ff712-7108-a1bf-f5a6-a4c7e70fdec9
msgctxt "h23aebd17g851eg4d56gaaf0g7a5f471b2cb8"
msgid ""
"They were a little more frothing-at-the-mouth than faithful, true enough. "
"Here, though?"
msgstr "신도라기보다는 그냥 입에 거품을 문 놈들에 더 가깝긴 했지. 맞는 말이야. 근데 여긴 말이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00
#. Speaker = Player
#. NodeID = f5c7dcb5-d30a-d9bb-58ce-37bd714db918
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent00:f5c7dcb5-d30a-d9bb-58ce-37bd714db918
msgctxt "h797c34d0g5a45g478fgbf47gf66ab90b0c0f"
msgid "You're helping the cult expand for a payout. You're disgusting."
msgstr "돈 받고 교단 확장을 도와준다는 거잖아. 역겨워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent01
#. Speaker = Erna
#. NodeID = 9f6f7f87-981d-4eda-b764-6fd46c8b241c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Zhent01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent01:9f6f7f87-981d-4eda-b764-6fd46c8b241c
msgctxt "h8a21779agb0adg4d27g943eg442fcf579ef5"
msgid "You trying to get me in trouble?"
msgstr "날 곤경에 빠뜨리려는 거냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent01
#. Speaker = Erna
#. NodeID = cb423f41-3175-47b7-a1e1-fd6d7a94814d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Zhent01(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Zhent01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent01:cb423f41-3175-47b7-a1e1-fd6d7a94814d
msgctxt "hef9822deg2a60g410agbf15gc91721b3c562"
msgid "It's Roah you want. We only talk when you've misbehaved."
msgstr "로아한테나 가봐. 우린 네가 버릇없이 행동할 때만 말한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent02
#. Speaker = Yerle
#. NodeID = 4de35fb1-4749-408a-98d8-0c7150bbb4f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Zhent02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent02:4de35fb1-4749-408a-98d8-0c7150bbb4f0
msgctxt "h6fd4ed8bg9c2dg4949g9cc2g71f0ab6df267"
msgid "Ain't looking to convert, True Soul. Gods mind their mess, I mind mine."
msgstr "개종하려는 건 아니야, 참된 영혼. 신들은 자기네들 일 처리하면 되고, 난 내꺼하면 되는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent02
#. Speaker = Yerle
#. NodeID = d1cad866-0f80-400e-ad95-a6943e61ee6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_HasMet_Zhent02(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Bazaar_HasMet_Zhent02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Bazaar_Zhent02:d1cad866-0f80-400e-ad95-a6943e61ee6b
msgctxt "h63198c0fga0b5g4dbfga087g86afa0910c06"
msgid ""
"This was funny when it was just goblins branding arses. But you lot mean "
"business, eh?"
msgstr "그냥 고블린 엉덩이에 분류 도장 찍을 때가 재밌었는데. 당신은 이 사업에 진심인 거지, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 02093ea6-d12e-1b3f-ccd4-eab38de04b2c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#. CheckFlags:
#.   Tag:
#.      - HAGEYED(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:02093ea6-d12e-1b3f-ccd4-eab38de04b2c
msgctxt "h76113a82g0f3fg4cc5g967ag71a3472a5692"
msgid "Bet the hag who ripped my eye out is howling from the grave."
msgstr "내 눈을 파낸 해그는 지금 무덤에서 울부짖고 있을 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 02411b4a-c1f1-e5a3-1646-e68c385fab1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:02411b4a-c1f1-e5a3-1646-e68c385fab1d
msgctxt "ha7e97cceg7a76g4c69gb8efg18007e748a81"
msgid "Glorious. And they gave you some handsome scars."
msgstr "영광스럽구만. 게다가 너한테 멋진 흉터도 남겨 줬는 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 0ce0feed-1842-7731-90cc-70532af6e317
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:0ce0feed-1842-7731-90cc-70532af6e317
msgctxt "h918a9320gf934g4455gb938gdc0ed972b96d"
msgid "Prove it. Who's singing your name?"
msgstr "증명해봐. 누가 네 이름을 노래하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 12662d36-b960-6744-4be3-9e96b455c5c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:12662d36-b960-6744-4be3-9e96b455c5c0
msgctxt "h4e2cdbe4g2521g4673g81a7gf21aad2cedd6"
msgid "Always special when it's just for your ears alone, ain't it?"
msgstr "오로지 혼자만을 위한 노래는 언제나 특별하지, 안 그런가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 19532816-29ab-6395-5d41-f8943f7b4de0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:19532816-29ab-6395-5d41-f8943f7b4de0
msgctxt "h10147555ga8bcg4c62gaaa2gc94d7c285cf5"
msgid ""
"I took someone's eye out for spilling my drink in the war camps last night. "
"Don't prove nothing."
msgstr "어젯밤 주둔지에서 내 술을 엎은 놈 눈을 뽑았었지. 아무것도 아니군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 1a1eacd0-ffa0-1c0d-1f49-4eec00a0ad13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:1a1eacd0-ffa0-1c0d-1f49-4eec00a0ad13
msgctxt "h6ed52867g8c4cg45a1g907fgac13e3102e45"
msgid "That was you? I heard Ragzlin was tough as dragon meat."
msgstr "그게 너였냐? 라그즐린은 용고기처럼 질기다던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 1a4f7ac8-a25b-7666-1ee7-510efed89082
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:1a4f7ac8-a25b-7666-1ee7-510efed89082
msgctxt "h9ad1bce9gcd95g4bc2g8274g6efd0ab28e90"
msgid "The sinners who've fallen in the face of righteous justice."
msgstr "마땅한 정의의 철퇴 아래 쓰러져 간 죄인들이 부른다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 1a4f7ac8-a25b-7666-1ee7-510efed89082
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:1a4f7ac8-a25b-7666-1ee7-510efed89082
msgctxt "h3274a96dg67bcg4639g9a71g239efe7d4286"
msgid "Forgotten glades and eternal streams whisper their protector's name."
msgstr "잊혀진 숲과 영원한 개울이 그 수호자의 이름을 연호한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 1a4f7ac8-a25b-7666-1ee7-510efed89082
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:1a4f7ac8-a25b-7666-1ee7-510efed89082
msgctxt "h9823ea23g6162g41efgb5f4g5b655a2641cc"
msgid "Those I am sworn to protect."
msgstr "내가 보호하기로 맹세한 이들이 부른다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 1a4f7ac8-a25b-7666-1ee7-510efed89082
#. HandlePath = TaggedText[3].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:1a4f7ac8-a25b-7666-1ee7-510efed89082
msgctxt "h63197884ge3c6g4175ga6e3g5e26e9b720e3"
msgid "Those who'd bind another to their will whisper my name in nightmares."
msgstr "자신의 의지를 타인에게 속박당한 이들이 악몽에 시달릴 때 내 이름을 속삭인다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 1f5e6212-8108-43ce-9cab-f7bdc1a1e613
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:1f5e6212-8108-43ce-9cab-f7bdc1a1e613
msgctxt "h7ae51800g22ceg405cgb643g3b64f4f8f3be"
msgid "I do not <i>peddle</i>. I put weapons in worthy hands."
msgstr "난 <i>팔러다니는</i> 게 아니다. 무기를 적절한 손에 쥐어주는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 2b056931-9d62-56fa-8fff-5486bc2a6e99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:2b056931-9d62-56fa-8fff-5486bc2a6e99
msgctxt "hf03dceb1g7e22g4388g9986gc4350e7eff70"
msgid "Either buy something, or leave."
msgstr "뭘 사든지, 가든지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 2f61144e-f0e4-641f-b05f-ebfc602c4149
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:2f61144e-f0e4-641f-b05f-ebfc602c4149
msgctxt "he735f2d9gcb3cg408fgac80g0eb876392d5c"
msgid "Hah! Bark, bark. Like a worg pup, you are."
msgstr "하! 왈, 왈. 워그 새끼처럼 짖어대긴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 2fdaa6dc-7567-dc4f-a253-921d13f34533
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:2fdaa6dc-7567-dc4f-a253-921d13f34533
msgctxt "h63f7081dgfd4dg4af9g994agcb29e2187066"
msgid "Thought I smelt something... outlandish about you. Very well."
msgstr "뭔가 냄새가 난다 했어... 기이한 느낌이 있군. 뭐 좋다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 40800999-0363-3810-b01f-bdcab6d45575
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:40800999-0363-3810-b01f-bdcab6d45575
msgctxt "h1858ef43g13c6g4027g83edg563a8c364137"
msgid "Mercy, mercy, please - I might just wet myself."
msgstr "어이구, 무서워라 - 하마터면 오줌 지릴 뻔 했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 437f8041-b62c-db63-7b94-b55871a48488
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BugBearVendor_State_FoundMotive = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:437f8041-b62c-db63-7b94-b55871a48488
msgctxt "h21c4c787g8339g4cc2gbc85g6573710137a1"
msgid "Your tone is asking for a beating, bugbear."
msgstr "한대 맞고 싶다는 말투로군, 버그베어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 47372b20-fd41-3a03-6545-e16285e7b64f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:47372b20-fd41-3a03-6545-e16285e7b64f
msgctxt "hab5681c2g18fag46e6ga1cdg4b251be25dd0"
msgid "Thought so. Lucky you're with the Absolute or I'd sell you nothin'."
msgstr "그럴 줄 알았다. 절대자가 함께 하니 운 좋은줄 알아라, 그게 아니었다면 아무것도 팔지 않았을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 4de944eb-f873-7ac6-40f6-8b48188744ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:4de944eb-f873-7ac6-40f6-8b48188744ce
msgctxt "heb060443gb00ag41a4g9a11g449b2c230d2d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 55f20695-f839-c63c-b865-312b85832f29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:55f20695-f839-c63c-b865-312b85832f29
msgctxt "h86629da8gc784g454eg89c1g56d43c604414"
msgid ""
"I'll give you that. Songs lie, flesh can't - and you look plenty battle-worn."
msgstr "인정하지. 노래는 몰라도 몸은 거짓말하지 않아. 넌 꽤 싸움판에서 굴러먹은 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 666c3022-9c74-bcc7-37ce-b0249e6e582f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:666c3022-9c74-bcc7-37ce-b0249e6e582f
msgctxt "h8662a67cge539g43f3g91dcg50598599d686"
msgid "Hah! So there's a little spice to go with all that strange."
msgstr "하! 아주 화끈한 구석이 있잖아. 뭔가 이상하다 했다만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 6792e98f-099d-36e0-8205-e3e67941b1fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:6792e98f-099d-36e0-8205-e3e67941b1fc
msgctxt "hdf295532g1879g4ddcga474g4488b02d7186"
msgid "Magic with a bite, eh? That's worth a chorus of blood and bone."
msgstr "마법에도 성깔이 있다, 이건가? 피와 뼈의 노래에 꽤나 어울리겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 69220fcc-bf89-b164-e16d-442cf9200c7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_BugBearVendor_HasMet_BazBugBear(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_BugBearVendor_HasMet_BazBugBear(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:69220fcc-bf89-b164-e16d-442cf9200c7d
msgctxt "hd9b4ee5bg3a39g48c4g83c1gef36cedbedb3"
msgid "If you have coin, then show it."
msgstr "동전 가진 거 있으면, 보여줘봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 711db104-e611-a5f2-bd92-403139e079e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:711db104-e611-a5f2-bd92-403139e079e4
msgctxt "hf972c97fg31d5g4db5g9782g61db4d9a581a"
msgid "A hag? Now that's an ugly and glorious song."
msgstr "해그? 추악하면서 영광스러운 노래로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 742194ca-8e47-8d73-910a-c9fcaa106ef1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BugBearVendor_State_FoundMotive = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:742194ca-8e47-8d73-910a-c9fcaa106ef1
msgctxt "h970c807dg2dedg4e33g982egfe577041a585"
msgid "To mock me is to beg for death."
msgstr "날 놀리는 건 죽고 싶다는 뜻인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 75d44073-a635-7e2e-9753-a24b764df338
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:75d44073-a635-7e2e-9753-a24b764df338
msgctxt "h7b2e2817ga7f4g4069g8bc6g7e313cb83b75"
msgid "You're certain they weren't just falling asleep?"
msgstr "곯아떨어지기 직전에 잠꼬대를 들은 건 아니고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 75ef7117-6411-77d8-3c47-764db18313ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:75ef7117-6411-77d8-3c47-764db18313ba
msgctxt "h74de2117gdfcdg4856gaf48gc95c386b9649"
msgid "What do you have on offer?"
msgstr "뭘 팔고 있는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 7907b0f7-58e4-44aa-8fde-d933d766919c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_BugBearVendor_State_PrivateStash = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:7907b0f7-58e4-44aa-8fde-d933d766919c
msgctxt "h225a1218g7c47g4b23ga6d0g0a9aebe4e0b6"
msgid ""
"Took a liking to you, did she? Watch yourself - she breaks her toys once "
"she's done with them."
msgstr "네가 마음에 들었나본데? 조심해. 즈렐은 장난감에 쓸모가 없어지면 가차 없이 박살을 내버리니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 79d40eb4-b856-9031-7a88-f980e5a4260b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:79d40eb4-b856-9031-7a88-f980e5a4260b
msgctxt "h4eb4e339g1572g46b1g8662g8216f4182089"
msgid ""
"I have cut from corpses a thousand tongues, and those thousand tongues sing "
"of <i>murder</i>."
msgstr "내가 시체에서 자른 혀만 수천 개가 되고, 그 수천 개의 혀들이 <i>살인</i>의 노래를 부른다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 7e5883e2-107c-418f-9170-3dd67a9e993c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:7e5883e2-107c-418f-9170-3dd67a9e993c
msgctxt "h41034b83g6292g4c25ga6a6gcc6d8bf8805e"
msgid ""
"Check the calluses on my hands. Those come only from a steadfast grip on a "
"weapon."
msgstr "내 손에 박힌 굳은살을 좀 보라고. 이건 무기를 단단히 쥘 때만 생기는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 81a0f251-c58f-d473-087b-e278e7ac09b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:81a0f251-c58f-d473-087b-e278e7ac09b4
msgctxt "h89952397gb66dg40f0g98e2gbf42308167e7"
msgid "That was you? Hells, I'll sing your name myself for that."
msgstr "그게 너였냐? 이런, 노래는 내가 해야 겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 8d5e0367-7e77-d1af-8f1c-92757101456a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:8d5e0367-7e77-d1af-8f1c-92757101456a
msgctxt "ha469265age7efg4fbfga3f6g2f0203ce2820"
msgid "That so? Heard that was a traitor, myself."
msgstr "그래서? 반역자라고 하던데, 내가 알기론."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 8e41e1a8-d230-d6fe-8cbc-5f3927f4b68a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:8e41e1a8-d230-d6fe-8cbc-5f3927f4b68a
msgctxt "h460fd68cg96fcg4c68ga666g2ec345465e82"
msgid "Nobody sings my name - I don't leave any witnesses."
msgstr "아무도 내 이름을 노래하지 않아, 난 목격자를 남겨두지 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 8ede6d80-e6da-4f78-6a07-de4607f49e61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:8ede6d80-e6da-4f78-6a07-de4607f49e61
msgctxt "h71a0ca43gf30eg48dcg912agf6959d081f8c"
msgid "The only god who holds power here is the Absolute - remember that."
msgstr "이곳에서 힘을 가진 신은 절대자뿐이시다, 그걸 기억해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 8f057d12-686d-bd4b-8f64-d6669e0352f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:8f057d12-686d-bd4b-8f64-d6669e0352f9
msgctxt "h7c3672b6ge96dg424bg8dc8g05056323c8f9"
msgid "The bridge to glory is built on the bones of the dead."
msgstr "영광으로 향하는 다리는 죽은 자들의 뼈 위에 세워지는 법이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 9074cc22-be9d-f41e-2552-2f3bdf6a4f88
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_BugBearVendor_State_FoundMotive = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:9074cc22-be9d-f41e-2552-2f3bdf6a4f88
msgctxt "heabf838fgf223g446fgad7agd31c34cdffd8"
msgid ""
"The Absolute needs warriors for Her crusade. But I see only <i>weaklings</i> "
"in this place."
msgstr "절대자가 성전에 쓸 전사를 모으고 있지. 하지만 여긴 <i>약골</i>들 밖에 안보이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 9097b10d-938e-3384-096f-0b61f9b09b6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_BugBearVendor_HasMet_BazBugBear(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:9097b10d-938e-3384-096f-0b61f9b09b6f
msgctxt "h5a471b99g6bbeg432dgb596g005dfe6dbbb6"
msgid "You seek arms? I seek a warrior worthy to bear them."
msgstr "무기를 찾나? 난 그 무기에 어울리는 전사를 찾고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 91ba3453-fb4f-87dc-a98b-d34b826b112e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:91ba3453-fb4f-87dc-a98b-d34b826b112e
msgctxt "hdda0102dg7b15g4562gb2f8g7ac7bce1f931"
msgid "The Absolute is. I burned that druids' grove to the ground."
msgstr "절대자께서 노래하시지. 내가 드루이드 숲을 불태웠거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 9416b82f-4dfb-83b5-f889-4d0065f07124
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:9416b82f-4dfb-83b5-f889-4d0065f07124
msgctxt "h4161ad6dgc23ag4150gb412ga5b8c23be5bb"
msgid ""
"Normally talk like that's empty - but there's something behind those words "
"of yours. I can <i>feel</i> it."
msgstr "보통 그런 말은 공허할 뿐이지만, 네 말에는 뭔가 숨은 뜻이 있는 것 같군. <i>느낌</i>이 와. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 957e56bd-75ad-2bd1-d478-bea5e134792c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:957e56bd-75ad-2bd1-d478-bea5e134792c
msgctxt "h808e69b4ga076g41fdg8db7gc1578734f242"
msgid ""
"Well, now - looks like there's something swinging beneath those robes after "
"all."
msgstr "그러고 보니, 그 로브 아래로 뭔가 거대한 물건이 숨어 있는 것 같긴 하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = 9b9552ae-b81c-ac9b-d1d4-b90b4d588827
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:9b9552ae-b81c-ac9b-d1d4-b90b4d588827
msgctxt "hef85886fg69d6g48f0g8f29g3530438cb7be"
msgid ""
"<i>Screaming</i> my name, more like. I know how to inflict pain. Show "
"respect, or I'll give you a demonstration."
msgstr "노래보다는 <i>비명</i>에 가깝지. 난 고통을 주는 법을 잘 알거든. 경의를 표하지 않으면 너한테 시범을 보여줄 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 9cce75ac-4279-0ace-67d7-86521e64a909
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:9cce75ac-4279-0ace-67d7-86521e64a909
msgctxt "h5247d909g3cc4g46a8ga70agd6ffa6ab039d"
msgid "People must scare easy where you're from. I don't."
msgstr "네가 살던 곳에선 쉽게 겁을 먹었겠지. 난 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = 9f3a7dea-ccab-ca7f-ffa3-5b60891f2ac3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:9f3a7dea-ccab-ca7f-ffa3-5b60891f2ac3
msgctxt "h6ef06627gf3f2g4323ga385gc43ad1df1144"
msgid "Doubt you've done anything worth witnessing."
msgstr "목격할 만한 가치가 있는 일을 하긴 한 건지 의심스럽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = a11003fe-f3f3-1188-45f1-c142f9e8f266
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:a11003fe-f3f3-1188-45f1-c142f9e8f266
msgctxt "hd0038c17geec0g4965g9e3egd939e32f0d6e"
msgid "Shame I'm not selling aloe, then - keep your ugly hands to yourself."
msgstr "내가 알로에를 안 팔아서 유감이시겠구먼. 그 못생긴 손 치워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = a228ce5f-0a7c-7a4d-3cf1-b3a826632b36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:a228ce5f-0a7c-7a4d-3cf1-b3a826632b36
msgctxt "h81da8e4fg6788g41d7gbd36g9d9cfc0125c0"
msgid ""
"You know - I think I recognise you. And I <i>still</i> can't remember your "
"name."
msgstr "있잖아. 가만 보니 널 알아보겠어. 근데 <i>여전히</i> 이름은 생각이 안 나는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = a26c1cd0-6663-00a4-01cd-0528aa4c9034
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - KARLACH(1) = True
#. TagRule: KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:a26c1cd0-6663-00a4-01cd-0528aa4c9034
msgctxt "h871c5a7ag614eg41ceg934eg761bef967a2e"
msgid "The demons of the abyss sing my name and tremble."
msgstr "심연의 데몬들이 내 이름을 노래하면서 벌벌 떨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = a2f8fe5b-717e-1847-1ee5-a3832a26eba2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:a2f8fe5b-717e-1847-1ee5-a3832a26eba2
msgctxt "h0b927665g5fbeg49fcg94a5ge85206377979"
msgid ""
"Open shop, or it will be <i>you</i> howling my name and begging my mercies."
msgstr "상점을 열어라, 그렇지 않으면 내 이름을 소리치며 내 자비를 구걸하는 건 <i>네놈</i>이 될 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = a55c582c-8524-775f-f1df-9e20644cea45
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_OperationFailed = True
#.   Tag:
#.      - WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:a55c582c-8524-775f-f1df-9e20644cea45
msgctxt "h4046c82dgb5e5g4c46g919agbe839bb2b160"
msgid "If your stomach's strong enough, I'll tell you how I lost this eye."
msgstr "네가 담력이 충분하기만 하다면, 내가 어떻게 눈을 잃었는지 이야기 해 줄 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = a7d0fad4-99a3-ebcf-999b-4d37dd1bcc80
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:a7d0fad4-99a3-ebcf-999b-4d37dd1bcc80
msgctxt "hf86dbdf6g43cag4844g8129g50f97d79d264"
msgid ""
"The Weave itself - for I traverse its depths with the ease of breathing."
msgstr "위브 그 자체가 날 부른다. 난 숨 쉬듯 쉽게 그 깊은 곳을 가로지르거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = aa735e9d-7f2e-44e6-5ed6-e069f55a8452
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:aa735e9d-7f2e-44e6-5ed6-e069f55a8452
msgctxt "hf463485ag2cb5g4fc7ga989g2aca3d658a9f"
msgid "Just show me what you have."
msgstr "그냥 뭘 가지고 있는지 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = aed575ec-02ac-9dcb-926a-f5089f08998c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:aed575ec-02ac-9dcb-926a-f5089f08998c
msgctxt "h965753d6gdcecg4c66g9e89g1b7ae4a17f19"
msgid "No songs. Just screams."
msgstr "노래는 없지. 비명은 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = b70d7041-df89-f01e-7744-5d3e3bceb96e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = False
#.      - FIGHTER(1) = False
#.      - DRUID(1) = False
#.      - WIZARD(1) = False
#.      - BARD(1) = False
#.      - ROGUE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:b70d7041-df89-f01e-7744-5d3e3bceb96e
msgctxt "h65bb8431g9973g4c26g812egf147d09f9fa1"
msgid "Nobody sings my name - I don't leave any witnesses."
msgstr "아무도 내 이름을 노래하지 않아, 난 목격자를 남겨두지 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = bd565f5b-e6ca-7e59-aecc-e8239778225d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - ASTARION(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:bd565f5b-e6ca-7e59-aecc-e8239778225d
msgctxt "h285eba3cg40d0g4071gbb51ga5a3dd94025d"
msgid ""
"Oh, no one sings it. But hundreds have died sobbing with my name on their "
"lips."
msgstr "오, 아무도 노래하지 않아. 대신 수백 명이 흐느끼듯 내 이름을 읊조리며 죽어 나갔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = c1a00efd-9d09-4c05-95d2-10687e84b355
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:c1a00efd-9d09-4c05-95d2-10687e84b355
msgctxt "hdcf2db79gcc05g4bdbg9e42gf8c86d38e95b"
msgid ""
"Say no more. An eye's a hard thing to lose - worth a chorus of blood and "
"bone."
msgstr "그만 말해도 된다. 눈은 잃기 힘든 부위지, 피와 뼈의 합창곡이 될 만하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = c584fb04-7786-1f1d-f481-d273720b4414
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:c584fb04-7786-1f1d-f481-d273720b4414
msgctxt "h87ef9311g3813g48f6g88a8g5a960eef5801"
msgid "Big talk from a little girl. And I believe every word."
msgstr "조그만 계집이 엄청난 말을 하는군. 그 말에서 진심이 느껴져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = c59660cc-b5dd-67b8-ac8c-eead2797047c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:c59660cc-b5dd-67b8-ac8c-eead2797047c
msgctxt "h43099b7fg9d58g4902g85f4g759245756251"
msgid "Hrrr. Looks like there's bite in you yet."
msgstr "흠. 거친 측면이 아직 있나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = c72d24b9-d1dd-66b3-eab1-8adb3ef05dd6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_EarnedRespect(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:c72d24b9-d1dd-66b3-eab1-8adb3ef05dd6
msgctxt "hbb0d2c29g3a22g4bb3ga736g60b21f63a1d9"
msgid "Want anything from my stash, you pay less than the rest."
msgstr "내 창고에서 원하는 게 있으면, 남들보다는 싸게 팔아주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = cc05a76c-c346-cc10-5eac-2ac85900bbb2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - RANGER_GLOOM_STALKER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:cc05a76c-c346-cc10-5eac-2ac85900bbb2
msgctxt "h76cabd9ag3c97g4f63g8698g101e440456eb"
msgid "Footprints in untrodden places sing my travels and trials."
msgstr "전인미답의 장소에 남겨진 내 발자국이 나의 여정과 고난을 노래한다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = cd24b004-7833-d2ca-6c5c-dfc1b4645113
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - GALE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:cd24b004-7833-d2ca-6c5c-dfc1b4645113
msgctxt "hd15493dcgbbafg41f1gb2d6gbb5fee331ccb"
msgid ""
"Perhaps 'warrior' isn't the right word. But I could turn this tower to dust "
"without twitching my finger."
msgstr "아무래도 '전사'라고는 못하겠지만, 난 손 하나 까딱하지 않고도 이 탑을 가루로 만들어 버릴 수 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = ce997bf4-56e5-f407-4242-9982faa2af16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BugBearVendor_State_FoundMotive = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:ce997bf4-56e5-f407-4242-9982faa2af16
msgctxt "hf42585adgbebeg471dg9b80g3457fec562ef"
msgid "You'll never peddle your wares with that attitude."
msgstr "그런 태도로는 물건 절대 못 팔 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = cf60c981-5901-8736-a8cf-2745b787bb9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:cf60c981-5901-8736-a8cf-2745b787bb9d
msgctxt "h34ad9cbag9b36g4741gb64ag8efda6ef7d19"
msgid "No one."
msgstr "없는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = d18c6bb3-b139-3399-0e02-ec0c291dbe9d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:d18c6bb3-b139-3399-0e02-ec0c291dbe9d
msgctxt "hcfef71dfg383dg4d70g9eebge6d62fbf2030"
msgid "Whole lot of talk, and still you've managed to say nothing."
msgstr "뭐라고 한참 떠든 것 같긴 한데, 정작 그게 무슨 말인지는 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = d3d782ae-a2b5-138b-b3fa-e8729b1ec5a5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:d3d782ae-a2b5-138b-b3fa-e8729b1ec5a5
msgctxt "hecf7280bgfcb9g49c4ga362ge2592bc78201"
msgid ""
"That might have been a pretty slaughter, but I heard Minthara led the attack."
msgstr "멋진 학살이었을지도 모르지만, 내가 알기론 민타라가 주도한 일 이라던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = d7f4d6a7-deb3-182d-66e3-b98032f09a50
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#. TagRule: CLERIC_EVIL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:d7f4d6a7-deb3-182d-66e3-b98032f09a50
msgctxt "hdcd8e774gbe62g4e24g8c22g730e6b6938f6"
msgid ""
"The gods - when I slit my enemies' throats and offer their lives up as "
"tribute."
msgstr "신들께서 부르신다. 적의 목을 베고 그의 목숨을 공물로 바치는 바로 그 순간에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = d7f4d6a7-deb3-182d-66e3-b98032f09a50
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#. TagRule: CLERIC_GOOD
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:d7f4d6a7-deb3-182d-66e3-b98032f09a50
msgctxt "h613a8df9g3340g4445g947fg3e1f67e3dad9"
msgid "Those who bathe in the warmth and light of the one I serve."
msgstr "내가 섬기는 분의 빛과 온기로 몸을 감싼 이들이 날 부른다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = d7f4d6a7-deb3-182d-66e3-b98032f09a50
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:d7f4d6a7-deb3-182d-66e3-b98032f09a50
msgctxt "h1203ddbbg15e4g4c96g9128g3ee41f771d6a"
msgid ""
"Friends and enemies alike - for I wield the power of the divine with the "
"ease of breathing."
msgstr "아군과 적 모두가 부른다. 마치 숨을 쉬듯 쉽게 신성한 힘을 휘두르기 때문이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = d976f4a6-f7d2-9a44-ed91-5f9a436bba5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BugBearVendor_State_FoundMotive = True
#.   Object:
#.      - MOO_BugBearVendor_State_TriedToPersuade(1) = False
#.      - MOO_BugBearVendor_State_EarnedRespect(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:d976f4a6-f7d2-9a44-ed91-5f9a436bba5a
msgctxt "h104e2058g7ea6g47b4g837eg392a0cf53108"
msgid "You want a warrior? Here I am."
msgstr "전사가 필요해? 여기 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = d9e47099-64a4-d9df-d2a8-31ec384ddebf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - PALADIN(1) = False
#. TagRule:
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:d9e47099-64a4-d9df-d2a8-31ec384ddebf
msgctxt "h385ad182ge112g4c68g9207g0f074ec496fa"
msgid "You'll be shrieking my name if you keep asking inane questions."
msgstr "자꾸 쓸데없는 질문하면 네가 비명으로 내 이름을 지르게 될 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = da3ed81a-bd55-bed7-0760-f884cb9c59b3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:da3ed81a-bd55-bed7-0760-f884cb9c59b3
msgctxt "h4b4b25afgbed3g483ag9566gf627da25ec49"
msgid ""
"Looks like a demon chewed you up and spat you out. You couldn't make a "
"goblin tremble."
msgstr "데몬이 한 번 씹고 뱉어낸 것 처럼 생겼는데. 고블린 하나 떨게 만들기 힘들겠구만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = da50d60c-7a89-7a0b-67ed-4b1fbf497c4f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:da50d60c-7a89-7a0b-67ed-4b1fbf497c4f
msgctxt "h70535977g59e9g49dbg8434g42ea750bbc97"
msgid ""
"And they're singing, are they? Strange, all I hear is self-righteous "
"horsecack."
msgstr "정말 노래를 부른다고? 이상하네. 내 귀엔 자기 말만 옳다고 우기는 개소리밖에 안 들리는데. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = e6002810-eae6-5c49-a099-4c839967dc54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BugBearVendor_State_FoundMotive = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:e6002810-eae6-5c49-a099-4c839967dc54
msgctxt "h0b7fe95egec00g4881gaa7cgcff93b899584"
msgid "Don't provoke me - I have a short temper."
msgstr "날 자극하지 마, 참을성이 부족하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = e6557960-f40d-f46c-c433-f1493573ba2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:e6557960-f40d-f46c-c433-f1493573ba2d
msgctxt "h4d1b3c35g818cg4424gb432g057c9a82609f"
msgid "Get moving, will you?"
msgstr "얼른 가, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = e7662e4d-4553-9b1b-bed1-54e1db48c2f8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - GOB_State_LeadersAreDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:e7662e4d-4553-9b1b-bed1-54e1db48c2f8
msgctxt "h2bb12e9dg1b13g4ea0gb6fdg2a047a2cc272"
msgid "Dror Ragzlin isn't. I ripped him and his camp apart."
msgstr "드롤 라그즐린은 노래 못 부른대. 내가 그놈이랑 야영지 전체를 박살냈거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = e92e51b4-c0bc-4096-ce9b-5ac65e0c8c02
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:e92e51b4-c0bc-4096-ce9b-5ac65e0c8c02
msgctxt "h718451b6g1865g4669ga846gfc5120cdf157"
msgid ""
"Well, I mainly do the singing. Usually while beating my foes to a pulp - "
"it's quite the sight."
msgstr "그래, 내가 주로 하는 게 노래를 부르는 거지. 주로 내 적들을 눈 깜짝할 새 해치우면서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = eb672ec6-b008-bcb9-1631-3fc9fe732a28
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:eb672ec6-b008-bcb9-1631-3fc9fe732a28
msgctxt "h363f2974gf9a0g4338g8fccg9c325de99d1f"
msgid ""
"The bastards who took my eye aren't singing. They're screaming in the Hells."
msgstr "내 눈을 뽑아간 개자식은 노래하지 않아. 지옥에서 비명을 지르고 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = ec99125f-1ecc-8d56-23f4-8d95bb265e08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_BugBearVendor_HasMet_BazBugBear(1) = True
#.   Object:
#.      - MOO_BugBearVendor_State_EarnedRespect(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:ec99125f-1ecc-8d56-23f4-8d95bb265e08
msgctxt "he884bf5bg8662g4423ga214ge5e154d55a75"
msgid "The Absolute's war drums beat loud in your chest. How may I serve?"
msgstr "절대자님의 전쟁 북소리가 네 가슴 속에서 크게 울려 퍼지는구나. 무엇을 도와줄까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = ee4f5982-58bb-859e-9460-12d45c497e28
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#. TagRule: SORCERER_WILDMAGIC
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:ee4f5982-58bb-859e-9460-12d45c497e28
msgctxt "h8c3bd817g341fg435dg9830g9fb3fd685221"
msgid ""
"Depends on what my magic summons - could be anything from a cow to a mephit. "
"But they're all very musical, I assure you."
msgstr "내 마법이 뭘 소환하느냐에 따라 달라. 소부터 메피트까지, 뭐든 가능하거든. 뭐든 간에, 다 노래는 잘 불러. 내가 장담하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = ee4f5982-58bb-859e-9460-12d45c497e28
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#. TagRule: SORCERER_DRACONIC
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:ee4f5982-58bb-859e-9460-12d45c497e28
msgctxt "h19a75776ge508g4121g9761g5238972c1ea8"
msgid "My dragonblood sings every time I burn an enemy alive."
msgstr "적을 산 채로 불태울 때마다 내 몸에 흐르는 용의 피가 노래하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = ee4f5982-58bb-859e-9460-12d45c497e28
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:ee4f5982-58bb-859e-9460-12d45c497e28
msgctxt "hfb263328gc5a7g4123g99a6g51159a3cd616"
msgid ""
"The skies themselves - when they bow to my magic and unleash a tidal wave of "
"power."
msgstr "저 하늘이 날 부른다. 내 마법에 굴복해 걷잡을 수 없는 힘의 파도를 뿜어내는 저 하늘이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = efcd48e4-6ddc-2956-2fdc-79c15067c970
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_BugBearVendor_State_EarnedRespect(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:efcd48e4-6ddc-2956-2fdc-79c15067c970
msgctxt "hc56eadf4g8085g4bb7gb8efg7783205272a8"
msgid "Slaughter well, True Soul."
msgstr "잘 썰고 다니시게, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = f2d24eb7-51cb-b030-b194-935fd363131d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:f2d24eb7-51cb-b030-b194-935fd363131d
msgctxt "h4ab3397cga066g4255ga3c6gf9270fd037e3"
msgid "Nature's beasts - with fangs of fury and unsheathed claw."
msgstr "대자연의 야수들이 날 부른다. 맹렬한 송곳니와 날카로운 발톱을 지녔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = f61c194f-9f75-b247-8e88-9eab1eb04ab8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:f61c194f-9f75-b247-8e88-9eab1eb04ab8
msgctxt "h79b9f4c4g3018g46c5g894bg30e26bec947a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = f7e4bb5a-7324-cb59-fbd3-f4a81db62293
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:f7e4bb5a-7324-cb59-fbd3-f4a81db62293
msgctxt "hdc340393g6b58g4c7bgb641gfd03b615c48e"
msgid "Check my knuckles - I've felled plenty of foes with my fists alone."
msgstr "내 손마디를 봐. 내 맨주먹에 쓰러진 적들만 수도 없이 많다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = f9f971f3-102e-4f83-916c-f1d27a5ed50e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:f9f971f3-102e-4f83-916c-f1d27a5ed50e
msgctxt "h9c05b8acg897cg4226g8b9cg5fa6ae0e7a8e"
msgid "Bookish nobodies are of no interest to me."
msgstr "책밖에 모르는 샌님한테는 아무 관심 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Lann Tarv
#. NodeID = ff95e246-3f83-0444-9b02-d5fae080acb3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_BugBearVendor_State_TriedToPersuade(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:ff95e246-3f83-0444-9b02-d5fae080acb3
msgctxt "h58710266g0249g474ag85adgaf0a546bfb0a"
msgid ""
"Respect is earned, elf. Not offered up to them as stamp their foot for it."
msgstr "경의는 쟁취하는 거다, 엘프여. 큰소리친다고 저절로 얻어지는 게 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor
#. Speaker = Player
#. NodeID = ffb0a550-2b2e-c7ce-f7b2-2038c8ae0889
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BugBearVendor_State_PrivateStash = False
#.      - MOO_Executioner_State_SpecialStashAccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor:ffb0a550-2b2e-c7ce-f7b2-2038c8ae0889
msgctxt "h4c3372bagab99g4a34g9701gbde5f258e8ca"
msgid "Z'rell said you're to share her private stash with me."
msgstr "즈렐이 자기가 개인적으로 챙겨놓은 물자가 있다고, 너한테서 받아 가라던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor_AD_Combat
#. Speaker = Lann Tarv
#. NodeID = 2e5c3f18-e140-4d2d-804c-fffd3ecdb49c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor_AD_Combat:2e5c3f18-e140-4d2d-804c-fffd3ecdb49c
msgctxt "hfa5d1e49g0fe7g4e95ga4cdgca47806e462b"
msgid "A little fun at last."
msgstr "드디어 재미 좀 보는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor_AD_Combat
#. Speaker = Lann Tarv
#. NodeID = ae82773e-87d1-0c85-c4b4-67fb750fdf1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BugBearVendor_State_CombatADImpressed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor_AD_Combat:ae82773e-87d1-0c85-c4b4-67fb750fdf1e
msgctxt "h7a5eea2ag89eag4820gb528g2a1e01d3fa63"
msgid "Time to put your tales to the test, warrior!"
msgstr "너에 대한 소문을 확인해 볼 시간이다, 전사!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor_AD_Combat
#. Speaker = Lann Tarv
#. NodeID = e8c68e3d-3150-4aa0-b296-fd77a01a4b59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_BugBearVendor_State_CombatADUnimpressed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BugBearVendor_AD_Combat:e8c68e3d-3150-4aa0-b296-fd77a01a4b59
msgctxt "h00664caeg3520g4763g84c2g817a3bd384eb"
msgid "I hope you do battle better than you boast, pup."
msgstr "허풍만큼 싸움실력도 좋길 바란다, 아가야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 0274884a-20c8-eacc-967d-343011ecd5ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:0274884a-20c8-eacc-967d-343011ecd5ad
msgctxt "h69018fedgbaf4g468fg91dag754ff2eb9c21"
msgid "Fortunately for you, I have grander game than you to stalk."
msgstr "운이 좋군, 지금 내가 너보다 더 큰 사냥감을 쫓고 있으니 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 06b9971e-6161-4203-c9f9-e053c2d5caa1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:06b9971e-6161-4203-c9f9-e053c2d5caa1
msgctxt "he2b4e52bg932fg443fg835eg0c92769a9ac5"
msgid "I wager the rats here are <i>really scary</i>."
msgstr "여기 쥐들은 <i>정말 무섭다고</i> 장담하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 0c5a145f-da00-5f25-6d34-b4d9962d7982
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:0c5a145f-da00-5f25-6d34-b4d9962d7982
msgctxt "hd42d15ccge667g45bcg9c22g64df58dc31e7"
msgid "Focus. Dedication. <i>Utmost vigilance.</i>"
msgstr "집중. 전념. <i>극도의 경계태세.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 17691280-a468-183d-14e9-dc25e810bda1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:17691280-a468-183d-14e9-dc25e810bda1
msgctxt "h50fa498cgdb4cg4694ga758g0007f7d0b9fe"
msgid ""
"You may run with your tail between your legs, but I fear no man nor beast - "
"particularly cowards who hide behind magic. <i>Bah.</i>"
msgstr ""
"꼬리를 말고 도망치도록 해라, 나는 그 어떤 인간이나 야수도 - 특히 마법 뒤에 숨는 겁쟁이들은 전혀 두렵지 않으니까. <i>하.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 198cb75c-af29-2d75-ef2e-877897efd00e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:198cb75c-af29-2d75-ef2e-877897efd00e
msgctxt "h8fe32e7eg151fg40c7g9134g2787065e0eb1"
msgid "What is wrong with me?! Gods help me."
msgstr "대체 왜 이러지?! 신이시여, 도와주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 1be99687-7cb2-546c-d3c1-7a8e68590eef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:1be99687-7cb2-546c-d3c1-7a8e68590eef
msgctxt "h3cdfe982gac7eg474fgb408g5541249d8aa8"
msgid ""
"I braved lapping waters and leaking ships to find this prey. I butchered "
"many, and will butcher many more."
msgstr "난 이 사냥감을 찾기 위해 용감히 거친 물살과 물 새는 배를 무릅썼어. 이미 많은 놈들을 도살했고, 더 많이 도륙할 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 1ce2787f-6d9c-4213-a6ca-93fa374d9df8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_CatBusiness_Event_Flee = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:1ce2787f-6d9c-4213-a6ca-93fa374d9df8
msgctxt "h43361797g92e5g48d2gb906gcc33d427ac15"
msgid "*Hiss.*"
msgstr "*쉬익.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 1eea4841-5a6a-3bd6-1a88-062ca70447ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:1eea4841-5a6a-3bd6-1a88-062ca70447ba
msgctxt "h44a5a731g81ddg47b4ga6d1g1d6149485ef8"
msgid ""
"'Tadpole' the furless ones call them. But the name matters not, merely their "
"demise."
msgstr "털 없는 놈들은 '올챙이' 라 부르더군. 하지만 이름은 중요치 않아. 단지 죽음만이 중요하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 232c8c07-7369-d06b-5330-1a9a36807642
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:232c8c07-7369-d06b-5330-1a9a36807642
msgctxt "h7cdb729cge70bg4654g8614g19c1780e99c0"
msgid ""
"<i>Don't risk delving into the past's horrors. Ask about the tadpole.</i>"
msgstr "<i>굳이 과거의 공포를 파헤치지 말자. 올챙이에 대해 질문한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = 24b53fb3-8e08-4bb9-1cef-bce73305f6e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:24b53fb3-8e08-4bb9-1cef-bce73305f6e7
msgctxt "h835656a5g3337g4bbdg9ae9g97c779975ea7"
msgid ""
"*A memory won at the cost of a piece of mind: you were in this tower before. "
"That much is sure.*"
msgstr "*마음의 한 조각을 희생해 얻은 기억입니다: 당신은 전에 이 탑에 있었습니다. 그 정도는 확실합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 2542000c-5028-f951-e4c8-c90e50e54949
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:2542000c-5028-f951-e4c8-c90e50e54949
msgctxt "hdef1794eg6dc1g4881ga061g459a17f02af6"
msgid "You clearly have delusions of grandeur."
msgstr "확실히 과대망상을 하는 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 272b50a2-c1b0-96bc-783b-c4144692c1ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:272b50a2-c1b0-96bc-783b-c4144692c1ea
msgctxt "h7c9b28ffg2098g4d2ag9c80gaf17e9ed58c3"
msgid "Murder every single one you find."
msgstr "발견하는 족족 죽여버려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 2d2b471f-291a-c083-5ea8-810c8f89bc34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:2d2b471f-291a-c083-5ea8-810c8f89bc34
msgctxt "hdc3ff6a5g507ag46b2gbfebg5cbcee35d1b1"
msgid "Ah ha ha HA!"
msgstr "아하하하!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = 2df6e7d7-3232-5fac-4d28-098bb5e43844
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:2df6e7d7-3232-5fac-4d28-098bb5e43844
msgctxt "h5b60ad6dg870cg413dga183g14f88d10ef9a"
msgid ""
"*The pleasure of the memory dribbles out of your leaking skull, into the "
"very air...*"
msgstr "*기억이 주는 기쁨이 구멍난 두개골에서 질질 흘러나와 허공으로 흩어집니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 2e1bc731-b421-9b5f-6056-1f537bb63324
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:2e1bc731-b421-9b5f-6056-1f537bb63324
msgctxt "hdd2f5f7dg9c1ag402fgb16eg89d6fa24c356"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 2e9f63bd-1c3a-5ff3-f770-c0ca9e1fc585
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:2e9f63bd-1c3a-5ff3-f770-c0ca9e1fc585
msgctxt "h2650405cg57c0g4294ga022g6715db5c86b7"
msgid "Good luck with the hunt, Steelclaw."
msgstr "사냥에 행운이 함께하길, 스틸클로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 3399f198-da4a-6ac4-3afb-f3613835f1c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:3399f198-da4a-6ac4-3afb-f3613835f1c0
msgctxt "h0ef64418g127ag45f8g9bbfgbd417c49e343"
msgid "Meow!"
msgstr "야옹!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 3c219d30-47b2-f953-7138-cd979cdf9bc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_InProgress = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:3c219d30-47b2-f953-7138-cd979cdf9bc1
msgctxt "haf597054g30b6g44c8gab0eg7b4cd10c49cb"
msgid "The tower isn't a safe place right now, maybe you should leave."
msgstr "이제 탑은 안전한 곳이 아니야, 떠나는 게 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 3e88b6b7-1351-298b-b039-6fb17842def4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:3e88b6b7-1351-298b-b039-6fb17842def4
msgctxt "hbde5a51dg738bg4c30gb8cbgb2a733dba44f"
msgid "I am no kitten. I seek something <i>far </i>more challenging."
msgstr "난 새끼고양이가 아니야. 난 <i>훨씬 더</i> 도전적인 사냥감을 찾지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 3f94d10b-1d05-5fd8-c024-ed7f93c6fc38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:3f94d10b-1d05-5fd8-c024-ed7f93c6fc38
msgctxt "hd4a98a74ga675g49e6ga993g0465e9573321"
msgid "You skulked like you owned the place, trespassing on <i>my </i>domain."
msgstr "넌 여기가 제 집인 양 돌아다녔지만, <i>내</i> 영역을 침범했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 45754a9d-f1ce-b1e6-825c-3b637a5164f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_CatBusiness_HasMet_SwA(1) = True
#.   Global:
#.     - MOO_Background_Outlander_CatBusiness = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:45754a9d-f1ce-b1e6-825c-3b637a5164f2
msgctxt "h6247c4ecgbfdeg4619g8cabg6c666d3058e7"
msgid "Yours is a face I shred in my dreams."
msgstr "내가 꿈 속에서 찢어버린 게 네 얼굴이었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 49087b1e-b821-ebf6-3e1c-3557190a41ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:49087b1e-b821-ebf6-3e1c-3557190a41ec
msgctxt "hc9a17771ge21bg48feg8aa5g355bf6ceec4e"
msgid "What do you mean I kicked you? We've never met."
msgstr "널 발로 찼다니 무슨 소리야? 우린 만난 적도 없었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 4a572d62-99fe-5221-b86e-144de908a1da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:4a572d62-99fe-5221-b86e-144de908a1da
msgctxt "ha60985b2g448bg4697gbb33g81eecbe5dd35"
msgid "You're a little bit intense."
msgstr "너 좀 살벌한데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 5013bfe1-85e1-be4d-2fcd-4d482ddeaff6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:5013bfe1-85e1-be4d-2fcd-4d482ddeaff6
msgctxt "h98f96fbbg88bcg4ab0g8df2ga80f833a3a59"
msgid ""
"Lies, it merely pretends. But I am a patient hunter - I will wait for it to "
"stir, and then I will <i>strike.</i>"
msgstr "거짓말, 죽은 척한 것뿐이다. 하지만 난 인내하는 사냥꾼이지 - 놈이 움직일 때까지 기다리다가, <i>칠 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = 52c751d6-9980-4b00-b758-bcb16432af9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d2e14243-3f8c-9ed6-5f47-a0dc3ab6cbbd_AnimalHandlingSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:52c751d6-9980-4b00-b758-bcb16432af9a
msgctxt "h9a012d55g8ad1g4cd0ga451g6c043def4c86"
msgid "*The cat pays you little attention, so focused is it on the hunt.*"
msgstr "*고양이는 사냥에 너무 집중한 나머지, 당신에게 관심을 두지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 5378241f-047b-b65b-f4e4-c87ce71277b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:5378241f-047b-b65b-f4e4-c87ce71277b9
msgctxt "hecbf4ad5ga451g467ag911bg384d3b75e317"
msgid "How boring, surely you can be a bit more creative?"
msgstr "지루하네, 좀 더 창의적일 수는 없는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 54d82b14-8890-d6bb-ad4e-e536492a24f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:54d82b14-8890-d6bb-ad4e-e536492a24f2
msgctxt "h5c5873d3gb80fg4c49ga47dgd806fa70c901"
msgid "Those parasites are dangerous - they've harmed me sorely."
msgstr "그 기생충들은 위험해 - 내게 큰 해를 끼쳤다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 5cdebe29-a1bc-6297-defd-2bdd509a700b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:5cdebe29-a1bc-6297-defd-2bdd509a700b
msgctxt "h2ec2e55dg06bcg44a6gb9ffgbcb93a58e557"
msgid "Sorry, your name is 'Steelclaw'?"
msgstr "잠깐, 네 이름이 '스틸클로' 라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 607b3bd5-01e4-5b79-17f5-fbedfcb20130
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:607b3bd5-01e4-5b79-17f5-fbedfcb20130
msgctxt "h1784f238g1e60g4742g8b0dga4c88e1bfa13"
msgid "I intend to."
msgstr "그럴 생각이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 6384d9ca-177d-98ed-af53-1eb0326e6123
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:6384d9ca-177d-98ed-af53-1eb0326e6123
msgctxt "h4704b8b3g5ff3g4463g9550ga58f1c843e0e"
msgid "The parasites are dangerous, don't go near them."
msgstr "기생충들은 위험해, 가까이 가지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = 674f8fba-b054-aff9-a4ff-e26775e20d0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:674f8fba-b054-aff9-a4ff-e26775e20d0b
msgctxt "haa79196cg387dg4191ga265gca2e92fa4ff1"
msgid ""
"*The message is clear - stay, if you wish, but she will flee at a moment's "
"notice.*"
msgstr "*메시지는 분명합니다 - 원하면 머물러도 좋지만, 자긴 곧바로 도망쳐 버릴 거라는 거죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 68c377d9-fa5d-1347-1234-213716dd8495
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:68c377d9-fa5d-1347-1234-213716dd8495
msgctxt "h44652afbgb9d8g438eg9587g73f00e648e49"
msgid ""
"Another will come soon, I have no doubt. So be silent - and do <i>not "
"</i>interfere."
msgstr "한 놈이 더 올 거야. 그러니 조용히 하고 - <i>방해하지</i> 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 6c252792-d58d-b221-3529-cc78f3fd074d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:6c252792-d58d-b221-3529-cc78f3fd074d
msgctxt "h6ded3bc1g91feg46d1ga5c4g09e4330880e1"
msgid "<i>Cower in self-disgust.</i>"
msgstr "<i>자기 혐오감에 움츠러듭니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 6f0d260d-07d0-ce9c-4e1e-602096144140
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_CatBusiness_Event_Flee = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:6f0d260d-07d0-ce9c-4e1e-602096144140
msgctxt "h651986deg3e57g45a2gb8eegbfe4b2860127"
msgid ""
"You clearly yearn for death - a wish I am happy to oblige. Sleep with one "
"eye open, furless one."
msgstr "죽고 싶은가 보군 - 기꺼이 받아주지. 잘 때 한쪽 눈은 뜨고 자도록 해라, 털 없는 놈."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 70e502e8-0df4-e106-27fc-4a7473b3f484
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = True
#.   Tag:
#.      - RANGER(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:70e502e8-0df4-e106-27fc-4a7473b3f484
msgctxt "h578e7174g0477g4404ga8f8g13d7d2e42f0d"
msgid "What type of prey are you waiting for?"
msgstr "어떤 사냥감을 기다리고 있는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 733fb57d-367d-4880-be7b-650200d81a85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:733fb57d-367d-4880-be7b-650200d81a85
msgctxt "h49624967g252fg49d1gb63cg5471d178ffdd"
msgid "Get out of here, stupid cat."
msgstr "저리 꺼져, 멍청한 고양이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 78acd9d3-b96f-2cfd-da1b-05f96e0efc5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_PlayerTookTadpole = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Global:
#.     - MOO_CatBusiness_Event_Flee = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:78acd9d3-b96f-2cfd-da1b-05f96e0efc5b
msgctxt "hb5be8f38g2ea0g4099gb581g26f67a0476ee"
msgid ""
"That parasite was <i>mine</i>. Spend your days in fear, furless one, for I "
"will return to dig my claws into your eyes and rip out your brains!"
msgstr ""
"그 기생충은 <i>내 거였어</i>. 남은 생을 공포에 떨어라, 털 없는 놈, 내가 네 눈알과 뇌에 내 발톱을 쑤셔 넣으러 돌아올 테니!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 830bac66-78ee-42b6-8ec2-84d827e97584
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:830bac66-78ee-42b6-8ec2-84d827e97584
msgctxt "hf4a2a0fegc021g4773g986eg35a9f5192376"
msgid "You're quite the hunter, aren't you?"
msgstr "실력 좋은 사냥꾼 같은데 - 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = 8bb3af8c-28e0-483e-e1fd-a57083bcad2e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_IndulgedUrge(1) = True
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:8bb3af8c-28e0-483e-e1fd-a57083bcad2e
msgctxt "hd317e094gdeceg4ffcg8b81gdf81aba5dbd5"
msgid ""
"*How the kitty-cat mewled when your boot stamped upon its tail! You are the "
"black cat crossing the path of the living.*"
msgstr "*당신의 부츠에 꼬리가 밟혔을 때 이 야옹이가 얼마나 가냘프게 울던지! 당신은 산 자의 길을 가로지르는 검은 고양이입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 935ebd5d-4e29-aea6-6dee-08ac27648478
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:935ebd5d-4e29-aea6-6dee-08ac27648478
msgctxt "h97c662e0gc44fg4b2eg9953ga19d0d3da6a2"
msgid "'Slithering vermin'? They're called tadpoles."
msgstr "'미끈거리는 벌레'? 저건 올챙이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = 97e665bb-fada-10ac-83b5-d58158dde2e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:97e665bb-fada-10ac-83b5-d58158dde2e5
msgctxt "hd4b9d695gd16bg44a7g9350g7e98992510f4"
msgid "*The cat huffs - unimpressed. She will do as she pleases.*"
msgstr "*고양이가 킁킁거립니다 - 감흥이 없네요. 그녀는 자기가 원하는 대로 할 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 9975a763-30a5-e87f-3d24-704e8708bc8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DRAGONBORN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:9975a763-30a5-e87f-3d24-704e8708bc8a
msgctxt "heb6ad4abg37e3g416bg9783gb2b0b7363d74"
msgid ""
"Ghost dragon, harbinger of death, child of the end. The tower feared you so, "
"but one day I shall pry you apart scale by scale."
msgstr "유령 드래곤, 죽음의 전령, 종말의 아이. 탑은 널 두려워했지만, 나는 언젠가 널 비늘 단위로 찢어버릴 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 9c014f82-bca0-b03f-e213-4bfa3c63fac5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:9c014f82-bca0-b03f-e213-4bfa3c63fac5
msgctxt "hd741622aga913g4321g957ag996b8f0b70f2"
msgid "My past evils are lost to me. Now, I admire your hunt."
msgstr "과거의 악은 내게서 사라졌어. 이제는 네 사냥에 경의를 표할 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = 9c40623b-1054-4d0b-8c5f-51f838955be4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Local:
#.      - d2e14243-3f8c-9ed6-5f47-a0dc3ab6cbbd_AnimalHandlingSuccess = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:9c40623b-1054-4d0b-8c5f-51f838955be4
msgctxt "h1b7657f0gfc56g45e2g9c5cgfa9a61b1e1b4"
msgid "<i>Hold out your hand, letting the cat sniff it.</i>"
msgstr "<i>손을 뻗어, 고양이가 냄새를 맡게끔 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = 9d374418-66a0-fb92-0f5d-98b5abebb91d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:9d374418-66a0-fb92-0f5d-98b5abebb91d
msgctxt "had24e557g9987g4ef9gb470g14e55271bdc3"
msgid ""
"Luck is not needed - merely patience and a thirst for blood. Hunt fast and "
"hunt well."
msgstr "행운은 필요없어 - 인내심과 피에 대한 갈증만이 필요할 뿐. 신속하고 만족스러운 사냥을 해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = a14020fd-76f7-4463-9377-ee0772042439
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d2e14243-3f8c-9ed6-5f47-a0dc3ab6cbbd_AnimalHandlingSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:a14020fd-76f7-4463-9377-ee0772042439
msgctxt "h951acae0g773dg44a3ga40dga39cf7e7976a"
msgid ""
"*The cat ignores you, but her eyes stray to a small tunnel hidden in the "
"wall.*"
msgstr "*고양이는 당신을 무시하지만, 두 눈은 벽 뒤의 작은 터널로 향합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = a2e8495d-85c6-7cdf-f33d-f0b020325de6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:a2e8495d-85c6-7cdf-f33d-f0b020325de6
msgctxt "h1afda152g70ddg4d54ga5b7geb02b03c2ae4"
msgid ""
"Do not mock me, braggart. Not every murderer has opposable thumbs. We cannot "
"all create, I can only destroy."
msgstr "날 비웃지 마라, 허풍쟁이. 모든 살인자가 맞서는 엄지를 가진 건 아니야. 모두가 창조를 할 수 없고, 난 파괴만 할 수 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = a382df7a-20e7-0d3a-7aed-6a11bd56ad61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:a382df7a-20e7-0d3a-7aed-6a11bd56ad61
msgctxt "hb7e7dbabg4e35g44a8g824cg0e536377d924"
msgid ""
"But this one - this one I toy with. I slice, I tear, and when the time is "
"right, I will <i>bite its head off and bathe in its innards.</i>"
msgstr ""
"하지만 이놈 - 이건 내가 가지고 노는 거야. 자르고, 찢고, 때가 되면 <i>머리를 물어뜯고 놈의 내장으로 몸을 씻겠어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = a8ee4c0e-a83c-0218-2751-4f05a538fd08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:a8ee4c0e-a83c-0218-2751-4f05a538fd08
msgctxt "h452f64c5ga57fg444aga793g8afee94d1fff"
msgid ""
"You simply do not understand the hunt. True joy is the feel of screaming "
"flesh beneath your fangs."
msgstr "사냥을 이해하지 못하는군. 진정한 기쁨은 송곳니 아래에서 비명을 지르는 살의 감각이거늘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = aa038abb-a235-711e-f254-a050d3164a4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:aa038abb-a235-711e-f254-a050d3164a4a
msgctxt "h0e0d1f41gd2ceg4bd5g8172gee4725e0022e"
msgid "A fellow hunter is a welcome sight. Any tips on hunting tadpoles?"
msgstr "동료 사냥군을 만나다니 반갑군. 올챙이 사냥에 대한 조언 없어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = ac229fa8-5c13-5ce1-3a2c-f0bca970bb73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:ac229fa8-5c13-5ce1-3a2c-f0bca970bb73
msgctxt "hce3cbab9g3b58g4a7ag8026g541ddb4f504c"
msgid "You know that tadpole is dead, right?"
msgstr "그 올챙이가 이미 죽었다는 건 알고 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = ad1524a6-fd11-2a7f-a75b-913a773d7f61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:ad1524a6-fd11-2a7f-a75b-913a773d7f61
msgctxt "h53638e79g68dag466ag9004gabc3c76ad98b"
msgid "Your mocking tone is a mistake, your first and last."
msgstr "그 조롱하는 어투가 네 처음이자 마지막 실수가 될 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = b4a951a3-d525-bc46-97ef-2f4e263e33f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:b4a951a3-d525-bc46-97ef-2f4e263e33f3
msgctxt "h5a2b59cfg0cedg49bcgacd8g20bb6520ad4d"
msgid ""
"*You excavate the empty caverns of your useless mind. Shovelling, dozing, "
"blasting through the smoothbrain.*"
msgstr "*당신은 쓸모없는 마음의 텅 빈 동굴을 파헤칩니다. 삽질하고, 졸고, 부드러운 뇌를 뚫고 들어갑니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = b653b79a-e832-26cc-c52c-0fb6a0e94588
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:b653b79a-e832-26cc-c52c-0fb6a0e94588
msgctxt "hd49b3ce7g1a9eg4a0bga4ecg1381303bcac6"
msgid "Do not push your own cowardice upon me."
msgstr "내게 네 나약함을 강요하지 말도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = b8b25763-4c77-c4e6-11fd-6462da9d458f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:b8b25763-4c77-c4e6-11fd-6462da9d458f
msgctxt "h50d5fe13gd89eg4ca0g93e9g95a1c7970128"
msgid "I remove the vitals, turn the skin inside out, then stuff them."
msgstr "난 네 생명을 꺼내 네 살을 뒤집어 까서, 다시 채워넣을 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = bb1e08dd-8188-d746-1f56-82e6d28b6cc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:bb1e08dd-8188-d746-1f56-82e6d28b6cc9
msgctxt "h40ef1c07g437cg4a78g8f5agf54c9cc953f4"
msgid "*... murder, <i>glorious</i> murder.*"
msgstr "*...살육, <i>영광스러운</i> 살육.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = bcd1f750-d3d2-ed14-0b1b-dd2f52598268
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:bcd1f750-d3d2-ed14-0b1b-dd2f52598268
msgctxt "hfc8a8908g438cg4fd1ga572g69d8f5db3ff5"
msgid ""
"It is a name I earned through bloodshed and death. Unfortunately, the more "
"ignorant here refuse to use it."
msgstr "내가 피의 학살과 죽음을 통해 얻은 이름이다. 안타깝게도 이곳의 무지한 것들은 이 이름을 거부하더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = c28ad7e9-307d-7e87-505c-08e2054d2e30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Assault_State_InProgress = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:c28ad7e9-307d-7e87-505c-08e2054d2e30
msgctxt "h33fbcee2ge029g4769gba9aga6d86881b6c5"
msgid "This place is dangerous, you should probably leave."
msgstr "여긴 위험해. 떠나는 게 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = c3cb65f3-0956-21d1-6695-eb12cb86ffeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:c3cb65f3-0956-21d1-6695-eb12cb86ffeb
msgctxt "he84b179dg77a9g4b5fgabbag8ba2e0326b05"
msgid ""
"One who kicked the Steelclaw, as if I were some stray. I am a champion "
"hunter. When I lick my pelt: <i>I taste blood.</i>"
msgstr ""
"길고양이인 줄 알고 이 스틸클로를 발로 찬 놈. 나는 챔피언 사냥꾼이다. 털가죽을 핥을 때마다 <i>사냥감의 피 맛을 느끼지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = c84b7c7d-f527-015f-5c9b-10cbed1ec53a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_Event_KillMooCat = True
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:c84b7c7d-f527-015f-5c9b-10cbed1ec53a
msgctxt "h8efbf431g587cg4863gb33bgc368fcd72c0b"
msgid "<i>Try to remember what was forgotten</i>."
msgstr "<i>무엇을 잊었는지 기억하려 노력한다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = c8eb368b-4700-76a1-3529-96fa75f4cea4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:c8eb368b-4700-76a1-3529-96fa75f4cea4
msgctxt "h19972452gb8ceg4851g9449g93b4ff402c1d"
msgid ""
"The death-walker passed through here before. I know your scent. All were "
"silent afore you, but I dared to snarl."
msgstr "일전에 저승사자가 여길 지나갔었다. 난 네 냄새를 알아. 네 앞에서 모든 것이 숨을 죽였지만, 나만이 으르렁거렸지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = c9490b39-2d8b-993a-675c-fe039ba8f66a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = True
#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:c9490b39-2d8b-993a-675c-fe039ba8f66a
msgctxt "hc7ac99b7gceffg4190g80e2g1645bf2e20fe"
msgid "A fellow hunter is a welcome sight. What is your quarry?"
msgstr "동료 사냥꾼은 환영이야. 네 사냥감은 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = ccc0e56b-308d-415c-ad8f-e8a161f07865
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_CatBusiness_HasMet_SwA(1) = True
#.   Global:
#.     - MOO_Background_Outlander_CatBusiness = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:ccc0e56b-308d-415c-ad8f-e8a161f07865
msgctxt "h2345081cga119g416bg998bgf0a69a525382"
msgid ""
"These are the stalking grounds of Steelclaw, furless one - tread lightly."
msgstr "여긴 스틸클로의 사냥터다, 털 없는 놈 - 조심히 다니도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = ce5c6bd4-c427-76d4-ada2-a0b7d839600c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:ce5c6bd4-c427-76d4-ada2-a0b7d839600c
msgctxt "hce617ce0gd788g4baeg93d4g5e3add8178a4"
msgid "I await the arrival of my next kill."
msgstr "다음 사냥감이 올 때까지 기다려야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = d59b3972-5402-70eb-a089-e4d6a702c55b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:d59b3972-5402-70eb-a089-e4d6a702c55b
msgctxt "hacc20951g82dcg4921ga19eg849136f0970c"
msgid "I will split and burst their every skin."
msgstr "놈들의 살을 찢고 터트려 버릴 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = d67b2bde-1d67-0805-5c27-f419a72d3b4c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_CatBusiness_HasMet_Cat(1) = False
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:d67b2bde-1d67-0805-5c27-f419a72d3b4c
msgctxt "h5a3dd1d3ga9b6g4c83g887fged85af01d13b"
msgid "*The cat gazes at you with clear disinterest.*"
msgstr "*고양이는 흥미라곤 전혀 없는 눈으로 당신을 봅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = e18df856-bc20-4f9b-bc3e-14cab20a65f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_CatBusiness_HasMet_SwA(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:e18df856-bc20-4f9b-bc3e-14cab20a65f8
msgctxt "he3be295dge263g4c97ga934g594a2cc0cba9"
msgid "Quiet, lest I miss its cries for mercy."
msgstr "조용히, 자비를 구하는 놈의 비명을 놓칠라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = e442bb18-4135-54b1-18ac-654e60c52e76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_PlayerTookTadpole = True
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Global:
#.     - MOO_CatBusiness_Event_Flee = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:e442bb18-4135-54b1-18ac-654e60c52e76
msgctxt "h0f2eecdeg7f2dg4523gb587g2e54f54c774f"
msgid ""
"*The cat glares at you with utter hatred - you took the tadpole, its prey, "
"and it will remember this slight.*"
msgstr "*고양이는 증오스럽게 당신을 노려봅니다 - 녀석은 당신이 사냥감인 올챙이를 빼앗은 걸 잊지 않을 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Narrator
#. NodeID = eb614f58-af99-44bd-bbe0-97f4d74ecc24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_CatBusiness_HasMet_Cat(1) = False
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_CatBusiness_HasMet_Cat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:eb614f58-af99-44bd-bbe0-97f4d74ecc24
msgctxt "h6c9b7eeag2ed5g4022g955cg563460cc1e2f"
msgid "*The feline eyes the parasite with a glint in her eye, intent clear...*"
msgstr "*고양이는 눈을 반짝이며 기생충을 바라봅니다, 의도는 명확하죠...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Player
#. NodeID = edff6e12-e8e8-e381-a251-67acf0858b09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:edff6e12-e8e8-e381-a251-67acf0858b09
msgctxt "h59fff8aagb95eg42c0g9e83g520de3aa55c0"
msgid "I bet the rats here give you plenty of trouble."
msgstr "여기 쥐들이 널 많이 괴롭힐 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = ee6f965c-8e6f-4ea2-70db-e9b028093c42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:ee6f965c-8e6f-4ea2-70db-e9b028093c42
msgctxt "hd01d6ae7g2eccg4c5bg89cage4c1d276d01f"
msgid "'Fluffers' they call me. Idiots."
msgstr "날 '복실이' 라 부르더군. 멍청이들."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = f1fafb33-2d59-1505-4f2e-6d4997350c0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_CatBusiness_State_TadpoleMissing = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:f1fafb33-2d59-1505-4f2e-6d4997350c0e
msgctxt "h2c440e33gf56fg40f4g9d80g1a43f653ca4e"
msgid ""
"Fortunately for you, the slithering vermin I hunt has my attention - for now."
msgstr "운이 좋군, 지금은 미끈거리는 벌레가 내 관심을 끌고 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = f215b9ce-2992-4dea-95ef-4a87304a4078
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:f215b9ce-2992-4dea-95ef-4a87304a4078
msgctxt "hac593ed2g76bdg4e5fg9a50gcc678cc6aa48"
msgid "*Purr.*"
msgstr "*가르릉.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = f2622949-2208-e28b-7337-53856c18cd8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:f2622949-2208-e28b-7337-53856c18cd8b
msgctxt "h83f0ffffgc5d0g4835gacf0g3261071dc9aa"
msgid ""
"Now, I must return to my prey. It  has been too long since it felt the bite "
"of fear."
msgstr "이제, 내 사냥감에게 돌아가야겠군. 놈이 공포의 입질을 느낀 지 너무 오래되었거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness
#. Speaker = Steelclaw
#. NodeID = ff7e94af-fe8a-8650-24b3-a2e4f9da3d2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness:ff7e94af-fe8a-8650-24b3-a2e4f9da3d2e
msgctxt "h12cebc36gaa5cg40afgb747g54f8ce2607e5"
msgid "Their name matters not, merely their demise."
msgstr "이름은 중요치 않아, 단지 죽음만이 중요하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness_AD_CrimeReaction
#. Speaker = Steelclaw
#. NodeID = d6230c68-29de-4da0-c317-1a5647b2742f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_CatBusiness_AD_CrimeReaction:d6230c68-29de-4da0-c317-1a5647b2742f
msgctxt "h3f848263g0f75g4a2bg81c3ga0d7c12cbe19"
msgid "*Hiss.*"
msgstr "*쉬익.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach
#. Speaker = Narrator
#. NodeID = 08134a72-20ba-460b-e53f-80a30ea9e44b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALSIN(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach:08134a72-20ba-460b-e53f-80a30ea9e44b
msgctxt "he8ae86dbg0db5g46eag9997g947cec19b7a9"
msgid ""
"*You are entering the seat of the Absolute, home to those who targeted your "
"Grove. They may still hunt you.*"
msgstr ""
"*당신은 에메랄드 숲을 위험에 빠뜨렸던 자들의 본거지이자 절대자의 안방으로 들어가고 있습니다. 놈들은 여전히 당신을 노리고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach
#. Speaker = Player
#. NodeID = 09d09840-f330-e01d-cdf4-79da24316677
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach:09d09840-f330-e01d-cdf4-79da24316677
msgctxt "hb215de39ga9deg4853g929ag0411e9666fc2"
msgid "<i>Best to return later.</i>"
msgstr "<i>나중에 다시 방문하는 것이 좋겠다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach
#. Speaker = Narrator
#. NodeID = 0be5b5d9-a36b-f41b-0257-991ab76791d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach:0be5b5d9-a36b-f41b-0257-991ab76791d1
msgctxt "hd5845f6egf97dg4191gbeafgfaa4e2388119"
msgid "*Steel yourself, and venture forth.*"
msgstr "*마음을 다잡고, 앞으로 나아가 봅시다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach
#. Speaker = Narrator
#. NodeID = 2448fffe-9354-05c9-38ab-34ea343ef1e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Crimes_State_UnwelcomeVisitorAccompanied = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach:2448fffe-9354-05c9-38ab-34ea343ef1e1
msgctxt "h3d0cbe02g4d04g4d9agbf2cg133a0dab7d7b"
msgid ""
"*It's risky to enter Moonrise with an unwelcome companion. You can pass as a "
"True Soul, but they cannot.*"
msgstr ""
"*환영받지 못하는 동료와 함께 문라이즈에 들어가는 건 위험합니다. 참된 영혼인 당신은 통과할 수 있겠지만, 그렇지 않은 이들도 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach
#. Speaker = Narrator
#. NodeID = 34792968-0ef8-12cc-1c7f-16081e902116
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach:34792968-0ef8-12cc-1c7f-16081e902116
msgctxt "he99b0a26gfd3bg43a8g8ffeg4e538f94c346"
msgid ""
"*The cult know you live, but believe you to be a thrall, with your mind "
"erased. Best not be seen here without one of your tadpoled companions.*"
msgstr ""
"*교단은 당신이 살아 있다는 걸 알고 있지만, 정신이 지워진 노예라고 믿습니다. 올챙이를 보유한 동료 없이는 이곳에 발 들이지 않는 게 "
"좋을 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach
#. Speaker = Narrator
#. NodeID = 5b9eff3e-788a-8afa-5a8a-b20d6f4336ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach:5b9eff3e-788a-8afa-5a8a-b20d6f4336ab
msgctxt "h72d9d12dg85e0g4b37g8bfcg2e72d8ff2090"
msgid ""
"*Without an infected companion at your side, you cannot pass among the cult "
"undetected.*"
msgstr "*감염된 동료의 도움 없이는 숭배자들의 눈에 띄지 않고 무사히 통과할 수 없을 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach
#. Speaker = Narrator
#. NodeID = 609cf691-cf00-c7db-a3d7-e11cee82b441
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach:609cf691-cf00-c7db-a3d7-e11cee82b441
msgctxt "he75676ffgbb47g4c13gb429g24be4b6332d3"
msgid ""
"*Be sure to keep them close, so you can speak on their behalf if the "
"cultists ask too many questions.*"
msgstr "*동료들을 가까이 두십시오. 숭배자들이 이것저것 캐묻는 경우, 당신이 대신 나서야 할 수도 있으니까요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach
#. Speaker = Player
#. NodeID = 88139adc-6feb-0ce4-876c-836ec4360058
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach:88139adc-6feb-0ce4-876c-836ec4360058
msgctxt "h3676330fg4003g4515ga42fg73c8638db276"
msgid "<i>Prepare to push onwards into Moonrise, whatever the risk.</i>"
msgstr "<i>모든 위험을 감수하고 문라이즈로 나아갈 준비를 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach
#. Speaker = Player
#. NodeID = 90a1e03d-edb9-74c3-dac1-b7db6545d5b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach:90a1e03d-edb9-74c3-dac1-b7db6545d5b1
msgctxt "hbf56d76eg8046g4f5dgbc81gef2f725688b0"
msgid ""
"<i>Caution and vigilance should allow you to explore the tower unscathed.</i>"
msgstr "<i>주의를 기울이고 경계를 늦추지 않는다면 무사히 탑을 조사할 수 있을 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach
#. Speaker = Narrator
#. NodeID = d7bae2d5-1660-0e97-a1d7-cff796f70973
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Crime_LoneUnwelcomeTowerVisitorApproach:d7bae2d5-1660-0e97-a1d7-cff796f70973
msgctxt "h2549a0c2g2dddg4350g8ecdge1a6f56d64d3"
msgid ""
"*Approaching Moonrise without a tadpoled companion is a dangerous "
"proposition. Are you willing to risk being detected by the cult?*"
msgstr ""
"*감염된 동료의 도움 없이 문라이즈에 접근하는 것은 위험천만한 생각입니다. 숭배자들의 눈에 띌지도 모르는 위험을 감수하겠다는 건가요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_JumperGreeting
#. Speaker = Acolyte Marls
#. NodeID = 2c83242a-ee5a-4d54-bfec-353e29dd746d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_JumperGreeting:2c83242a-ee5a-4d54-bfec-353e29dd746d
msgctxt "h8ec9b28dg363ag49c1g9d4eg34238f7ec403"
msgid ""
"Enjoy the view. Feels like it'd stretch all the way to the Sea of Swords on "
"a clear day. If this place ever <i>gets</i> a clear day."
msgstr "풍경을 만끽하게. 화창한 날에는 검의 바다 전체가 다 보일 것만 같지 않나. 이 곳이 화창해지긴 <i>할 지</i> 모르겠다만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_Minthara_AtDocks
#. Speaker = Nightwarden Minthara
#. NodeID = a72d7589-29da-1047-72d1-2750ed13d986
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_Minthara_AtDocks:a72d7589-29da-1047-72d1-2750ed13d986
msgctxt "h622ae54eg95a8g43abg8df1g10df85628759"
msgid ""
"Shipments of parasites, bound for Baldur's Gate. Half the city may be "
"infected already."
msgstr "기생충으로 가득 찬 화물이야. 목적지는 발더스 게이트로군. 이미 도시의 절반은 감염됐겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverFishing
#. Speaker = Zealot Arden
#. NodeID = 04fc471b-010b-4144-9924-d709fbf80230
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 73cbf53d-6017-fdd5-a96a-9cae574a1bd9_A = True
#. SetFlags:
#.   Local:
#.     - 73cbf53d-6017-fdd5-a96a-9cae574a1bd9_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverFishing:04fc471b-010b-4144-9924-d709fbf80230
msgctxt "ha58c496bg26e4g449cgb823gf2f109200c29"
msgid "Must've found some booze among the supplies. Idiot."
msgstr "보급품 가운데서 술이라도 찾아나 보군. 멍청한 놈."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverFishing
#. Speaker = Zealot Arden
#. NodeID = c1e19eb1-ad0f-424c-9cef-a304f22d6043
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 73cbf53d-6017-fdd5-a96a-9cae574a1bd9_B = True
#. SetFlags:
#.   Local:
#.     - 73cbf53d-6017-fdd5-a96a-9cae574a1bd9_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverFishing:c1e19eb1-ad0f-424c-9cef-a304f22d6043
msgctxt "hce82b1c9gb56cg4f5fga9f8g2a38dee96f67"
msgid "Least you could've done was strip off your gear first, fool."
msgstr "최소한 장비라도 먼저 벗어버렸어야지, 바보 같은 놈."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverFishing
#. Speaker = Zealot Arden
#. NodeID = d1d8d1d8-f49e-4503-a679-56dc9d4e96f3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 73cbf53d-6017-fdd5-a96a-9cae574a1bd9_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverFishing:d1d8d1d8-f49e-4503-a679-56dc9d4e96f3
msgctxt "hc06f51a1g9e20g4f38ga2afg672b9c6ed3c7"
msgid "Don't think for a bloody second I'm going in there after you."
msgstr "내가 미치지 않고서야 구하겠답시고 따라 들어갈 리가 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverFishing
#. Speaker = Zealot Arden
#. NodeID = decf4c94-f484-4380-afc6-0144a9943ff8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 73cbf53d-6017-fdd5-a96a-9cae574a1bd9_C = True
#. SetFlags:
#.   Local:
#.     - 73cbf53d-6017-fdd5-a96a-9cae574a1bd9_A = False
#.     - 73cbf53d-6017-fdd5-a96a-9cae574a1bd9_B = False
#.     - 73cbf53d-6017-fdd5-a96a-9cae574a1bd9_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverFishing:decf4c94-f484-4380-afc6-0144a9943ff8
msgctxt "ha8ea5e4fg3ef4g47d3gb7a4gfa75862b5e3f"
msgid ""
"I'd say a prayer for you, lad, but I honestly do not remember your name."
msgstr "기도라도 해주고 싶다만, 솔직히 말해서, 이름조차 기억이 안 난단 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverInspect
#. Speaker = Zealot Arden
#. NodeID = d89aeff4-7918-4dc7-b926-c63d5d2a012c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverInspect:d89aeff4-7918-4dc7-b926-c63d5d2a012c
msgctxt "h45e02740g9cbcg48aeg9dd8gc4606890c96b"
msgid "Oh, Ilmater's arsing <i>ashes</i>."
msgstr "오, 이런 <i>세상에</i> 빌어먹을 일메이터시여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverWitness
#. Speaker = Zealot Arden
#. NodeID = fd0761b4-b2cd-4999-947c-6b32b33c59df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_ObserverWitness:fd0761b4-b2cd-4999-947c-6b32b33c59df
msgctxt "hde2e2d2egf730g4493gb416gb993ffe25d1d"
msgid "Just... move on, Arden. You didn't see anything."
msgstr "그냥... 지나가자, 아르덴. 넌 아무것도 못 본 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_AD_Patroller000Witness
#. Speaker = Zealot Renan
#. NodeID = 6033c5c8-541e-44b7-8590-31f0abc5ac79
#. HandlePath = TaggedText[0].TagText[0]
