msgctxt "hf9f10e0dg3aefg4495g8c55g5e9d8c099ee3"
msgid "D-do mess our pardon. Our master d-distiller spill's quite the caused."
msgstr "죄-죄송합니다. 우리 주인님은 술을 너무 많이 마셔서요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Gale
#. NodeID = 82f0af42-5263-478b-bcca-0c666e75074e
