#.   Global:
#.      - SCL_SkepticalRobber_State_TombstoneVariation = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_AD_ReadTombstone:3bbcb1d9-507c-170c-b054-f58b2b99dacc
msgctxt "hf9c63cb3gdc75g42ecg935cg07f987c79671"
msgid "*Ellie May: my light, my hope, my joy.*"
msgstr "*엘리 메이: 나의 빛, 나의 희망, 나의 기쁨.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow
#. Speaker = Player
#. NodeID = f21dada4-6898-4ea0-9819-081e12831187
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow:f21dada4-6898-4ea0-9819-081e12831187
msgctxt "h692fb779gae77g4466gbffag5b6ab1b028c9"
msgid "Hello. What's that hiding in the dirt?"
msgstr "이것 봐. 흙 속에 뭔가 있는 것 같은데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow
#. Speaker = Player
#. NodeID = f21dada4-6898-4ea0-9819-081e12831187
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow:f21dada4-6898-4ea0-9819-081e12831187
msgctxt "h13b3e40bge986g4261g8a51g775d5760075d"
msgid "My. If I'm not mistaken, someone seems to have misplaced their femur."
msgstr "이런. 내가 잘못 본 게 아니라면, 누군가 대퇴골을 흘리고 간 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow
#. Speaker = Player
#. NodeID = f21dada4-6898-4ea0-9819-081e12831187
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow:f21dada4-6898-4ea0-9819-081e12831187
msgctxt "hf7efc89bge3dfg44ccg8adeg0b7efe394058"
msgid "Aha. Found the nest."
msgstr "아하. 둥지를 찾았다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow
#. Speaker = Player
#. NodeID = f21dada4-6898-4ea0-9819-081e12831187
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow:f21dada4-6898-4ea0-9819-081e12831187
msgctxt "h89d05988ge162g4e3cgb39ag95d3c4a3c1a5"
msgid "The dirt's been burrowed there. A rodent's nest, perhaps."
msgstr "저기 흙이 패여 있다. 설치류의 소굴일지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow
#. Speaker = Player
#. NodeID = f21dada4-6898-4ea0-9819-081e12831187
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow:f21dada4-6898-4ea0-9819-081e12831187
msgctxt "hc80e3a96g93bbg4c41g9f8age2582f17b02b"
msgid "A half-buried femur. Some beast wanted to save it for later, perhaps?"
msgstr "반쯤 묻힌 대퇴골이라. 웬 짐승이 나중에 먹으려고 아껴놓기라도 한 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow
#. Speaker = Player
#. NodeID = f21dada4-6898-4ea0-9819-081e12831187
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow:f21dada4-6898-4ea0-9819-081e12831187
msgctxt "hf0c5ca08ga139g48dfgadadge34a3ece721e"
msgid "A bit of bone poking out, there. Do I even want to know?"
msgstr "저기 뼈가 살짝 튀어나와 있어. 정체가 뭔지 알아야만 할까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow
#. Speaker = Player
#. NodeID = f21dada4-6898-4ea0-9819-081e12831187
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverBurrow:f21dada4-6898-4ea0-9819-081e12831187
msgctxt "h00071b82ga747g4f61g9ca1g5766c470bab3"
msgid "Something's buried in the dirt. Is that a <i>femur?</i>"
msgstr "흙 속에 뭔가 묻혀있어. 저거 혹시 <i>대퇴골인가?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave
#. Speaker = Player
#. NodeID = 08f66e7b-d334-4e78-bbf0-655e19cb64f5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_SkepticalRobber_Knows_GraveRobbed = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave:08f66e7b-d334-4e78-bbf0-655e19cb64f5
msgctxt "hbd187295gce9bg449bga418g4414b8c144ef"
msgid "What a mess - it's half grave, half animal burrow."
msgstr "난장판이 따로 없네. 무덤 반 짐승 굴 반이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave
#. Speaker = Player
#. NodeID = 08f66e7b-d334-4e78-bbf0-655e19cb64f5
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_SkepticalRobber_Knows_GraveRobbed = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave:08f66e7b-d334-4e78-bbf0-655e19cb64f5
msgctxt "hbdbe1e52ga3fcg43deg9b69g83f5d77ed4df"
msgid ""
"This grave has been disturbed. Must have been an animal, or whatever else "
"lurks in this darkness."
msgstr "이 무덤은 파헤쳐졌군. 짐승의 짓이거나, 아니면 어둠 속에 도사리는 무언가의 짓이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave
#. Speaker = Player
#. NodeID = 08f66e7b-d334-4e78-bbf0-655e19cb64f5
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_SkepticalRobber_Knows_GraveRobbed = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave:08f66e7b-d334-4e78-bbf0-655e19cb64f5
msgctxt "h852a4e02g200ag466bg8c6ag9aa6591b8057"
msgid "Grave's a mess. Rogue animals, maybe."
msgstr "무덤이 엉망이네. 아마도 들짐승들 짓이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave
#. Speaker = Player
#. NodeID = 08f66e7b-d334-4e78-bbf0-655e19cb64f5
#. HandlePath = TaggedText[3].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_SkepticalRobber_Knows_GraveRobbed = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave:08f66e7b-d334-4e78-bbf0-655e19cb64f5
msgctxt "ha9e98a81gf915g49c5gb0aeg25cef4a75cd9"
msgid "The grave's in shambles. To be expected, in these wastes."
msgstr "무덤이 엉망이군. 이런 황무지에서는 예상할 수 있는 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave
#. Speaker = Player
#. NodeID = 08f66e7b-d334-4e78-bbf0-655e19cb64f5
#. HandlePath = TaggedText[4].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_SkepticalRobber_Knows_GraveRobbed = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave:08f66e7b-d334-4e78-bbf0-655e19cb64f5
msgctxt "h8ec37cddg66b1g4e0dgbb5bg37aa56980de4"
msgid "Looks like an animal dug this up - so much for a final resting place."
msgstr "웬 짐승이 파낸 것 같네. 마지막 안식처라는 이름이 무색하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave
#. Speaker = Player
#. NodeID = 08f66e7b-d334-4e78-bbf0-655e19cb64f5
#. HandlePath = TaggedText[5].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_SkepticalRobber_Knows_GraveRobbed = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave:08f66e7b-d334-4e78-bbf0-655e19cb64f5
msgctxt "h2b570b7fgf781g4661ga93egf46e6e92d688"
msgid "Looks like the mutts got here before I did."
msgstr "들개들이 먼저 왔다 간 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave
#. Speaker = Player
#. NodeID = 08f66e7b-d334-4e78-bbf0-655e19cb64f5
#. HandlePath = TaggedText[6].TagText[0]
#. SetFlags:
#.   Global:
#.     - SCL_SkepticalRobber_Knows_GraveRobbed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_DiscoverGrave:08f66e7b-d334-4e78-bbf0-655e19cb64f5
msgctxt "hc482a992ge2b4g4273ga800gdb1d10268a6a"
msgid "This grave is a mess - probably an animal's doing."
msgstr "무덤이 엉망이네, 아마 짐승들 짓이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints
#. Speaker = Player
#. NodeID = 65030024-39f5-0217-072a-70fd61209045
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints:65030024-39f5-0217-072a-70fd61209045
msgctxt "hc379349cg10f6g4944gbefcg47e1e7463361"
msgid "Something scuttled through here. Where was it off to?"
msgstr "이곳에서 뭔가가 성급하게 달아났군. 어디로 간 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints
#. Speaker = Player
#. NodeID = 65030024-39f5-0217-072a-70fd61209045
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints:65030024-39f5-0217-072a-70fd61209045
msgctxt "h3f49a880g77ddg426eg8be6ge038aab6d61b"
msgid "Tracks of some sort. Looks like they lead downwards..."
msgstr "무언가의 흔적으로 보이는데. 아래쪽으로 이어지는 것 같아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints
#. Speaker = Player
#. NodeID = 65030024-39f5-0217-072a-70fd61209045
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints:65030024-39f5-0217-072a-70fd61209045
msgctxt "hdd892dc2ga87cg47adg99b0g837848f2dec2"
msgid "Animal tracks. Looks like they jumped down."
msgstr "동물의 흔적이군. 아래쪽으로 뛰어 내려간 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints
#. Speaker = Player
#. NodeID = 65030024-39f5-0217-072a-70fd61209045
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints:65030024-39f5-0217-072a-70fd61209045
msgctxt "h07dfbbf3g19abg4dd2gb550gca7073b3dedf"
msgid "Paw prints, but leading where - trap, treasure, or distraction?"
msgstr "동물 발자국이군. 어디로 이어질런지. 함정, 보물, 아니면 그저 미끼인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints
#. Speaker = Player
#. NodeID = 65030024-39f5-0217-072a-70fd61209045
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints:65030024-39f5-0217-072a-70fd61209045
msgctxt "hf7e1f340g26aeg4b59g9166g0b6c302e1c71"
msgid "Animal tracks. Something went over the edge here."
msgstr "동물의 흔적이야. 무언가 여기서 발버둥을 쳤군.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints
#. Speaker = Player
#. NodeID = 65030024-39f5-0217-072a-70fd61209045
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints:65030024-39f5-0217-072a-70fd61209045
msgctxt "hf5d24e61g510cg4abegaf45gd4a1809c9d39"
msgid "Paw prints? Something's skittered through here. Pretty recently, too."
msgstr "동물 발자국? 뭔가 이곳을 빠르게 지나갔군. 얼마 지나지 않은 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints
#. Speaker = Player
#. NodeID = 65030024-39f5-0217-072a-70fd61209045
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: DRUID or RANGER
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints:65030024-39f5-0217-072a-70fd61209045
msgctxt "hcb2b9aefg1930g4920ga0f3ga129345e1e67"
msgid ""
"Those tracks say fox, but the stride is odd. Hm. It must have jumped down "
"there."
msgstr "여우 발자국처럼 보이는데, 발걸음이 이상하군. 흠. 아래로 뛰어 내려간 게 틀림없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints
#. Speaker = Player
#. NodeID = 65030024-39f5-0217-072a-70fd61209045
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_FoundFootprints:65030024-39f5-0217-072a-70fd61209045
msgctxt "h67893dc1gc16ag41c9gb8feg34a39b78d5e5"
msgid "Paw prints? Where do they lead?"
msgstr "동물 발자국? 어디로 이어지는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = bc404d44-0d39-4610-bfd6-7230aeb7342b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:bc404d44-0d39-4610-bfd6-7230aeb7342b
msgctxt "h14a16444g7050g4421gbfc8g28be8f8a93c5"
msgid "Seems he never got her ring. Lucky for me."
msgstr "결국 반지를 찾진 못했나 보군. 나만 덕 봤네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = bc404d44-0d39-4610-bfd6-7230aeb7342b
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:bc404d44-0d39-4610-bfd6-7230aeb7342b
msgctxt "h8592d9aag8dfag498dg86a9gf8089d49c0f3"
msgid ""
"The ring must be Ellie May's. Better in my hands than those of some "
"graverobber, I say."
msgstr "분명 그게 엘리 메이의 반지일 거야. 웬 도굴꾼 손에 들어가느니 내가 갖고 있는 게 낫겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = bc404d44-0d39-4610-bfd6-7230aeb7342b
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:bc404d44-0d39-4610-bfd6-7230aeb7342b
msgctxt "h83974324g133cg47dfgbac1g0ad69f4ad588"
msgid "Ellie May's ring. Thanks, lady."
msgstr "엘리 메이의 반지로군. 고마워요, 부인."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
#. Speaker = Player
#. NodeID = bc404d44-0d39-4610-bfd6-7230aeb7342b
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_SkepticalRobber_Knows_WifesRing = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote:bc404d44-0d39-4610-bfd6-7230aeb7342b
msgctxt "hac1c86bcge3abg4f37gb88eg499db715f091"
msgid "Pitiful thief - he never did unearth Ellie May's ring."
msgstr "딱한 도둑이로군. 결국 엘리 메이의 반지를 찾지는 못했어. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_SkepticalRobber_PAD_ReadRobbersNote
