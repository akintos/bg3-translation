#.     - CAMP_Jergal_AskedAboutServices(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:497251b7-822a-971c-da8e-7f26cc038dd4
msgctxt "h4d175c68g0c04g4619gb90bg7fa3dfa6dedc"
msgid "What services do you provide?"
msgstr "어떤 서비를 제공하시죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 4dcb9ce1-cb7d-4fda-c848-73be60ff4cd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 932401b1-7763-7fd7-bee1-8731fe62084f_DeadThree = False
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:4dcb9ce1-cb7d-4fda-c848-73be60ff4cd7
msgctxt "h07284151g0625g4e63ga943g906b2ce25f66"
msgid "You seem to know a lot about the Dead Three."
msgstr "삼악신에 대해 잘 알고 있으신가 봐요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 5134b63b-3e40-d2b0-ca77-17036560df32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Jergal_State_MoreThanOnePCDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:5134b63b-3e40-d2b0-ca77-17036560df32
msgctxt "h67a65dc8g919ag47afgabdeg6b9ea0c7556e"
msgid ""
"I want to resurrect all of my fallen companions. "
"([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-aba3-875cf81c38ca])"
msgstr ""
"쓰러진 내 동료 모두를 부활시키고 싶어요. ([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-"
"aba3-875cf81c38ca])"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = 5367cac4-a458-ca08-8715-6cbab957f29b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:5367cac4-a458-ca08-8715-6cbab957f29b
msgctxt "hd05f7ac9gaa0cg4a00g9fbdg23156042904f"
msgid "No."
msgstr "아니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = 53fc0e5d-407d-6238-20c7-70b5d5257de0
