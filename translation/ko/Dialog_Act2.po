msgctxt "h225b2e22gdd4ag4f12g8c1cgac56f1a249f7"
msgid "*...Before it retreats out of reach.*"
msgstr "*...곧 손이 닿지 않는 곳으로 물러납니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = f9e9e027-f73e-e555-373e-a9b78943fa11
