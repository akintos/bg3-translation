#.     - 8e2e5008-edbf-4f7c-d70c-111abbfbb1fb_HAV_TakingIsobel_FlamingSpy_Dead_MentionedChosen = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:f15d4bdc-ba8a-4b4a-9ffa-91ef70b6daa5
msgctxt "h63e18e19g5d4cg41aegb1e7g55883907ef6f"
msgid "The... General... Absolute's... Chosen..."
msgstr "절대자의... 선택받은자... 장군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Narrator
#. NodeID = f43b1900-859c-427d-abee-cffdfd5aab45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:f43b1900-859c-427d-abee-cffdfd5aab45
msgctxt "h9513570dgf711g41d5g8b77ge292ce8d871c"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Fist Marcus
#. NodeID = f6c20b89-a708-4238-be45-71b9b2ec25cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:f6c20b89-a708-4238-be45-71b9b2ec25cb
msgctxt "h468c21ccg8589g473dgaf57g76c64bb7648d"
msgid "Cross... cursed lands... carry... the light..."
msgstr "빛... 가지고... 저주받은 땅... 건너라..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Player
#. NodeID = fa1dcbde-37e0-97df-91b9-5945c74b906b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:fa1dcbde-37e0-97df-91b9-5945c74b906b
msgctxt "hc1c664f0g043eg43f1gae7cg135b96128721"
msgid "Did you leave anything valuable behind?"
msgstr "소중한 걸 두고 오진 않았나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead
#. Speaker = Fist Marcus
#. NodeID = fc326eea-957d-4c13-8520-6333c9c23670
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FlamingSpy_Dead:fc326eea-957d-4c13-8520-6333c9c23670
msgctxt "hb9681150gd0b2g4b01g8cafgb7883867d610"
msgid "Ketheric... Thorm..."
msgstr "케서릭... 쏨..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 01074778-7152-2cf4-1ae1-7eb154268f1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:01074778-7152-2cf4-1ae1-7eb154268f1a
msgctxt "hdf42df01g95c6g4bacga74dgb06461bc388f"
msgid ""
"He healed right in front of me, and chased us into the shadows. We took "
"shelter here, and were considering a full retreat - until you came along."
msgstr ""
"그가 치유되는 걸 눈 앞에서 봤어, 그러곤 그림자 속으로 우릴 추적해 오더군. 여기 피난처를 세웠지만, 완전히 퇴각할까 생각도 했지, "
"네가 오기 전까진 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 03f257c1-ed68-2b81-35c8-032bb82900ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:03f257c1-ed68-2b81-35c8-032bb82900ee
msgctxt "h8a042600g53f7g4a01g9e6bg4d55026a40ff"
msgid ""
"Whatever he's done to protect himself is a magic so dark I can hardly fathom "
"it."
msgstr "그 녀석을 지키고 있는 건 마법..끝을 알기도 어려울 정도로 어두운 마법이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 0556fb70-df7f-b9b0-3b82-2e98f4c4e3bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:0556fb70-df7f-b9b0-3b82-2e98f4c4e3bf
msgctxt "h44374ce7g493ag465dg8575ge0f17c348f0b"
msgid "Thank you - now I must make my way to the Towers."
msgstr "고마워, 이제 타워로 가야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Narrator
#. NodeID = 0c06e0e3-f2ca-d143-aca4-33cf956559cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:0c06e0e3-f2ca-d143-aca4-33cf956559cf
msgctxt "h0d2022efgb52fg4ce6g9036gabd644649775"
msgid ""
"*There's an acute sadness in her voice. It seems she's even more invested in "
"this story than she'd like to admit.*"
msgstr "*그녀의 목소리에서 극심한 슬픔이 묻어납니다. 겉으로 드러나는 것 이상으로 이 이야기에 깊이 몰입한 듯 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 0c9921fa-9d4a-69a1-9c8b-3a9ac402ac28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:0c9921fa-9d4a-69a1-9c8b-3a9ac402ac28
msgctxt "h1a57310eg2587g440bgbe2fg8cb44b6d92f5"
msgid ""
"You can walk among the cult unnoticed. You can get close to Ketheric. Sounds "
"to me like you're the answer to our biggest problem."
msgstr ""
"네가 교단을 들쑤시고 다녀도 걔네는 알아채지 못할 거야. 케서릭에게 접근할 수 있겠지. 네가 바로 우리의 가장 큰 문제를 해결해 줄 "
"사람인 거 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 0e1b155c-7154-bc28-cb77-cabe4b728804
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:0e1b155c-7154-bc28-cb77-cabe4b728804
msgctxt "h3ab706e2gf302g40c7gade4gdd8e4be90a13"
msgid ""
"Why you? It's like the gods custom-designed you to sabotage this cult - to "
"put an end to Ketheric Thorm."
msgstr "왜 너냐니? 넌 이 교단 놈들을 방해하고 케서릭 쏨을 무너뜨리라고 신들께서 보내 주신 선물 같은 존재야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 0f3664fa-7afc-350e-84d4-dc9d2c0c4367
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:0f3664fa-7afc-350e-84d4-dc9d2c0c4367
msgctxt "h28730487g30fag4b9dg931cge3063a9355b6"
msgid ""
"I can understand why he'd want me dead. Without me keeping the curse at bay, "
"everyone in this inn - everyone intent on killing him - is dead too."
msgstr ""
"내가 죽어야만 하는 이유가 있다면 분명해. 내가 죽으면 이 여관 사람들, 그러니까 놈의 죽음을 벼르고 있는 모든 이들이 저주에 삼켜질 "
"테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 12655542-64da-e1f3-574b-50d0eb724560
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:12655542-64da-e1f3-574b-50d0eb724560
msgctxt "h407f8b92g6255g4391g8e9fg3448065e6b36"
msgid "Once I take Ketheric's head, you'll be safe again."
msgstr "내가 케서릭을 처치하면, 넌 다시 안전해질 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 19da5598-6537-1526-e3bb-702f7c3e83d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:19da5598-6537-1526-e3bb-702f7c3e83d0
msgctxt "h5b33c546g69f2g4448g9d27g3d5edcc888c7"
msgid ""
"Brave fellow. They say there's no fanaticism like that of a convert, and "
"Ketheric is a convert many times over."
msgstr "용감한 친구네. 개종만큼 광신적인 것 도 없다고 들 하지, 케서릭은 개종을 밥 먹 듯 하는 녀석이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 19dddf37-f993-5907-934c-b8d9c2df9a9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:19dddf37-f993-5907-934c-b8d9c2df9a9e
msgctxt "h57d16691g3bfcg4733g892bg9225160d6211"
msgid "I am. We all are."
msgstr "맞아. 우리 모두 그렇지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 1cbd3954-a995-1023-40ae-9977f59a9faa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:1cbd3954-a995-1023-40ae-9977f59a9faa
msgctxt "h07cf5151g0ec4g4a9bgbf2cg3072dd47d9d9"
msgid ""
"To turn away from Selûne for <i>this</i>. This <i>curse</i>. This disgusting "
"power to corrupt and kill..."
msgstr ""
"겨우 <i>이런</i>것 때문에 셀루네님 한테 등을 돌리다니. 이따위<i>저주</i>, 오로지 타락시키고 죽이기 위해 있는 역겨운 힘 "
"때문에..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 1f6ff3c1-c299-66d2-170b-2c9ce54de3ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:1f6ff3c1-c299-66d2-170b-2c9ce54de3ac
msgctxt "h8e82b385g6ccag49d6g9bdeg69a43465e5e5"
msgid "Why target you?"
msgstr "왜 널 노린 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 1ff225fb-d200-c1a3-e221-41516dbf01fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:1ff225fb-d200-c1a3-e221-41516dbf01fa
msgctxt "hfe51acf8gdbd7g4d6agbbf9g118f215d4fe7"
msgid "I'm getting tired of hearing that."
msgstr "그런 말 듣는 것도 지겹군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 29c121a3-4cf7-7de7-0c1a-e11cb9d48d84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:29c121a3-4cf7-7de7-0c1a-e11cb9d48d84
msgctxt "h0a2cca7bgf89ag4768gaf65g4cfedd4d751c"
msgid "I still don't see why it has to be me."
msgstr "아직도 왜 하필 나인지 모르겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 2b65001f-5cf2-b650-0e0c-b626ab97bb7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:2b65001f-5cf2-b650-0e0c-b626ab97bb7e
msgctxt "h07d8c87bg635bg47c9ga82agdac68aa26745"
msgid ""
"But now... he's returned. And he's <i>invincible</i>. Neither arrow nor "
"sword can harm him."
msgstr "그런데 이젠... 그가 돌아왔대. 게다가 <i>무적</i>이라니. 화살을 쓰든 검을 쓰든 상처를 입힐 수 없다는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 2c5d35f6-ebb4-e840-4d7a-bdbf2de6f5a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelGaveMoonlantern = True
#.      - GLO_Pixie_State_SeenPixie = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:2c5d35f6-ebb4-e840-4d7a-bdbf2de6f5a9
msgctxt "h9b3db902ga2e8g4d77gb674g9940234da430"
msgid "A Moonlantern? Those are powered by trapped pixies, you know."
msgstr "달등불? 그거 픽시들 가둬놓고 동력으로 삼는 거, 너도 알텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 2dfc3667-3fa7-a6b6-b0f4-4a3a0cb94fb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:2dfc3667-3fa7-a6b6-b0f4-4a3a0cb94fb1
msgctxt "hd65c2daegc482g4339g9812gd4b6d7fab77e"
msgid ""
"Ketheric is a frightening man. But you have something he doesn't: allies "
"worth having."
msgstr "케서릭은 무시무시한 사람이야. 하지만 넌 케서릭한테는 없는 걸 갖고 있어, 가치있는 동료들 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 2e9be841-281f-c28a-4246-2b785d0fc405
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:2e9be841-281f-c28a-4246-2b785d0fc405
msgctxt "h70ac222cg5c7dg449cg901bgdc934c7ae155"
msgid "Why me?"
msgstr "왜 나야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 2fd2ea93-c302-68a2-018b-10aa5bfd523b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:2fd2ea93-c302-68a2-018b-10aa5bfd523b
msgctxt "h089057d2gc122g4c65gac8egee4f68eb37f7"
msgid "I'm not sure if I can trust a Selûnite."
msgstr "내가 셀루네 신도를 믿어도 되는 건지 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 30b70fd2-db65-65e9-e3d8-ad2861dbc27c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:30b70fd2-db65-65e9-e3d8-ad2861dbc27c
msgctxt "h6faa81a4g3e19g4e94g8eb8gba29d50cb109"
msgid ""
"As for why he'd want to take me <i>alive</i>... I don't know. And I don't "
"want to find out."
msgstr "하지만 날 <i>산 채로</i> 잡아오라고 했다니... 모르겠어. 알고 싶지도 않고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 338494e7-4f04-abdc-34fc-f2ab9f4952b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:338494e7-4f04-abdc-34fc-f2ab9f4952b3
msgctxt "h6761ddf3g9112g43cbgab11g430c2d7c1d93"
msgid ""
"Now more than ever, you're our best hope of making it out of here alive."
msgstr "이젠 정말 자명해졌군. 여기서 살아 나갈 수 있는 희망이 있다면 그건 자네일거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 345415af-0c1e-5f05-1c99-33d066143ac9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:345415af-0c1e-5f05-1c99-33d066143ac9
msgctxt "h4c823112g2aceg44c1g9104ge5d24ac0b106"
msgid ""
"This man - a Selûnite, not unlike myself - had family. Friends. And he "
"abandoned them all to become a monster."
msgstr ""
"나와 마찬가지로, 셀루네를 섬겼던 이 남자에겐 가족이 있었지. 친구들도 있었고. 그런데도 그는 괴물이 되겠답시고 그들 모두를 저버렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 35205b35-3793-b151-0633-9adeed5c94d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:35205b35-3793-b151-0633-9adeed5c94d1
msgctxt "h8702779fgbe7bg46e4gbaabgaf60e94d79f1"
msgid "I'm getting tired of hearing that."
msgstr "그런 말 듣는 것도 지겹군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 3838c407-b1e0-745c-ee13-2536041004b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:3838c407-b1e0-745c-ee13-2536041004b4
msgctxt "hec1b1704gb3e8g488fg8c40g01b7fefcd103"
msgid "You seem afraid."
msgstr "두려워 하는 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 38801d7e-a601-2660-08d1-55c4fe8e7e85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:38801d7e-a601-2660-08d1-55c4fe8e7e85
msgctxt "h84ea6b0dg31bag4a01gbabegf90f8a948303"
msgid "I've seen him in a kind of vision."
msgstr "환영 같은 것에선 만나본 적 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 3894ab32-3bc5-e2a8-f160-afaab2f3af40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:3894ab32-3bc5-e2a8-f160-afaab2f3af40
msgctxt "hb2898cb1g82e7g435fga8f4g817cda977e08"
msgid ""
"Marcus has been with us since the start - they've been tracking us this "
"whole time."
msgstr "마커스는 시작할 때부터 우리와 함께 했어. 처음부터 우리 동선을 파악하고 있었다는 얘기지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 39c6a2ae-cdbf-0222-e384-760560029810
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_Isobel_Knows_DiscussedPlayerPurpose(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:39c6a2ae-cdbf-0222-e384-760560029810
msgctxt "h9c79ae35g17fbg4fd4gb147g3019850d156f"
msgid "I'm Isobel. And you're... meant to save us all, I believe?"
msgstr "난 이소벨이야. 그리고 넌... 우릴 구하러 온 거, 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 39c9174b-f1d6-1134-2ccc-9804ba4c795e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:39c9174b-f1d6-1134-2ccc-9804ba4c795e
msgctxt "h4da3c0d4g973fg487aga2fcgfffb93e51e14"
msgid "You're the key to all of this."
msgstr "네가 이 모든 계획의 열쇠야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 3f253c33-97e9-1e39-665e-2f01fa9a8248
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_IsobelGaveOintment = True
#.      - HAV_Jaheira_State_MissionGiven = False
#. SetFlags:
#.   Global:
#.     - HAV_Isobel_State_ReceivedMoonriseQuest = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:3f253c33-97e9-1e39-665e-2f01fa9a8248
msgctxt "h341efbf5gc461g46f4g8eb6g63bc35e80c32"
msgid ""
"We need you to infiltrate Moonrise Towers - no one will suspect a 'True "
"Soul'. Ketheric's been made immortal."
msgstr "네가 문라이즈 타워에 잠입해줬으면 좋겠어, 누구도 '참된 영혼'을 의심하진 않을 테니. 케서릭은 이미 불멸자야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 401a9500-d18e-eb15-bcdf-986aa0bd8711
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:401a9500-d18e-eb15-bcdf-986aa0bd8711
msgctxt "h3a47deb7g6264g4762g9b81g39c4521cf2d5"
msgid ""
"<i>Him </i>presiding over a court of law. What a joke. I'm glad you got out "
"of there alive - that's more than many can say."
msgstr ""
"<i>그자</i>가 재판을 주재하고 있었다라. 웃기지도 않네. 거기서 멀쩡히 걸어 나왔다니 천만다행이야. 말로 표현할 수 없을 정도로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 41c00b11-ed94-84fa-6f0a-87464bf6aaf1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:41c00b11-ed94-84fa-6f0a-87464bf6aaf1
msgctxt "h3a4a08dcg622cg45c9g8d13g11021177ef8d"
msgid "Am I?"
msgstr "내가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 42d26be1-6140-cdaf-13db-adee213b4d31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:42d26be1-6140-cdaf-13db-adee213b4d31
msgctxt "h58d6465bge848g4bf6ga554g9e13a07aa26b"
msgid "Marcus told me Ketheric wanted you captured - not killed. Why?"
msgstr "케서릭은 마커스에게 널 죽이지 말고 사로잡아서 데려오라 했어, 왜지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 4325745b-ca31-ea3f-fcb9-f313d7735b85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_DiscussMarcus = True
#.   Object:
#.      - HAV_Jaheira_Knows_WasWarned(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:4325745b-ca31-ea3f-fcb9-f313d7735b85
msgctxt "h48cb8ff4g2221g4362g8276g28621e1e120f"
msgid "It was exactly as you reported. I can't believe I didn't see it sooner."
msgstr "네가 보고한 그대로야. 내가 진작 알아보지 못했다니 믿을 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 458541dd-8aba-aaab-ad0c-1b498c2b289f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:458541dd-8aba-aaab-ad0c-1b498c2b289f
msgctxt "h341cb7c3g46c5g4c04g9972g9ff1c1665eb8"
msgid "I'm fine."
msgstr "난 괜찮아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 46177d29-6d1d-97d5-3920-43dca0547229
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:46177d29-6d1d-97d5-3920-43dca0547229
msgctxt "hc5ceaa73gea5dg4bebga829g889508d02558"
msgid ""
"He began worshipping Shar and raised an army of Dark Justiciars right "
"underneath the locals' noses. A coalition of Harpers and druids put him down "
"- killed him and buried him in the Thorm family mausoleum."
msgstr ""
"그는 샤를 숭배하고 다크 저스티시어의 군대를 양성하기 시작했어. 현지인들 바로 앞에서 말이야. 하퍼와 드루이드 연합에서 그를 처단했고, "
"쏨 가문 묘지에 묻었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 48809778-39bb-1797-d3d4-7e65d2b08ae4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:48809778-39bb-1797-d3d4-7e65d2b08ae4
msgctxt "h7a2e69fdg46aag4fe6gbc67gab26ac03c713"
msgid "Deeply corrupted."
msgstr "엄청 타락했더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 49daef09-46c3-0851-0e09-46a42b22fd5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:49daef09-46c3-0851-0e09-46a42b22fd5a
msgctxt "hde1b4a32g383bg4b7ag9c41g6af2bbe47d9c"
msgid "But now that we have you, perhaps we have a chance."
msgstr "하지만 이제 우리 쪽에 네가 있으니, 어쩌면 기회가 있을지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 4c50fde3-faae-b3c7-d052-e9abe29d1b27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:4c50fde3-faae-b3c7-d052-e9abe29d1b27
msgctxt "h97d56f59g4dbfg457dg9f0ag1bc0678f0bf1"
msgid ""
"We're in more danger than I knew. If something happens to me, everyone in "
"this inn is dead. Like that."
msgstr "우린 생각보다 더 큰 위험에 처해 있어. 내게 무슨 일이 생긴다면, 여관에 있는 모두가 죽을 거야. 아까처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 4ec1fa75-9ee9-3edb-eb8c-b613425178cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:4ec1fa75-9ee9-3edb-eb8c-b613425178cf
msgctxt "h0a85bc08g596dg4d94gb20bg7a7b8c5564cb"
msgid "He is fickle. Changeable. His devotion is shallow but violent."
msgstr "케서릭은 변덕스러워. 변화무쌍하고. 그 녀석의 신앙심은 얕지만 동시에 폭력적이지. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 51a21e31-8a0f-f60c-2e76-960a0568f282
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:51a21e31-8a0f-f60c-2e76-960a0568f282
msgctxt "hdee08b2fg92f0g4f2dga17egcd8dfd9dde7b"
msgid ""
"Selûne gave me the power to protect this place, but I can't keep it up "
"forever. Such magic, it's... <i>draining</i>. Soon I'll be dry."
msgstr ""
"셀루네께서 이 성소를 지킬 수 있는 힘을 주셨지만, 언제까지나 유지할 순 없어. 그런 마법을 사용하면... 서서히 <i>시들게</i> "
"되거든. 결국 시간문제지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 52288a58-9276-c888-af13-192de608f4f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:52288a58-9276-c888-af13-192de608f4f9
msgctxt "hb9ad3a3ag25aag4c5fga27ag6b61abcf0f99"
msgid "She's right."
msgstr "그말이 맞아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 54b6cffe-fd13-bc80-3aa0-93bfb2aa5dfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:54b6cffe-fd13-bc80-3aa0-93bfb2aa5dfe
msgctxt "hb2a32aebge874g406agb267g8a33ffd93e16"
msgid ""
"Everything Ketheric has touched for a hundred years has died - quickly, by "
"violence, or slowly, by decay."
msgstr "지난 수백년간 케서릭이 손 대 왔던건 전부 다 죽어버렸어.. 그의 손에 빠르게, 아니면 부패에 천천히 고통스럽게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 56313e4b-4c03-300c-1795-e670c2a68563
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:56313e4b-4c03-300c-1795-e670c2a68563
msgctxt "hf3918b94g45dcg4814g900eg85918c5a4c14"
msgid "I never get tired of hearing that."
msgstr "그런 말은 언제 들어도 질리지 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 566fe01e-3d35-5518-547d-cc01b676f3d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:566fe01e-3d35-5518-547d-cc01b676f3d9
msgctxt "h65716e0eg4d35g462ag8728ga5f1cd8c430e"
msgid ""
"He can be <i>un</i>made, but we need you to find out the source of his "
"invulnerability."
msgstr "그래도<i>되돌릴</i> 수는 있지, 대신 불멸의 근원을 먼저 찾아내야해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 57bbff47-b406-1d1c-9bc7-f0bde3f15155
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:57bbff47-b406-1d1c-9bc7-f0bde3f15155
msgctxt "h71ca5131ga991g41a4gbc64ge329e39ccf66"
msgid "I won't let that happen."
msgstr "그런 일이 발생하도록 두지는 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 5842a0d3-6521-125b-d1b4-290e4f5d18ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:5842a0d3-6521-125b-d1b4-290e4f5d18ba
msgctxt "h33f3e352g50fcg4f65g8e4cga726ad9b9557"
msgid "Anything else I should know before heading off?"
msgstr "그럼 떠나기 전에 내가 더 알아야 할 게 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 587ad929-9fcd-abc6-57b4-f3aa48011735
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:587ad929-9fcd-abc6-57b4-f3aa48011735
msgctxt "hdaa47d72g33fbg4be0g9ae6g19ad22551798"
msgid "Make him mortal, so we can make him bleed."
msgstr "그를 필멸자로 만들어줘, 그럼 우리가 피를 흘리게 할테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 5e05b1e4-8358-fac9-0dfb-bb2f53bcea1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:5e05b1e4-8358-fac9-0dfb-bb2f53bcea1d
msgctxt "h75408345g848bg4456g8754g2c80f740a238"
msgid ""
"I know Jaheira narrowly escaped his grasp. Have you encountered him yet?"
msgstr "자헤이라가 가까스로 거기서 벗어났다고 해. 케서릭을 만난 적은 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 609aced2-ecc1-b67b-4564-95b7fa1c26d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:609aced2-ecc1-b67b-4564-95b7fa1c26d3
msgctxt "hbd90f7a0ge9afg4084g979ag2b6938a4ea0f"
msgid ""
"He used to preside over this village - a good man, a respected man - who "
"turned to darkness quite suddenly, I've been told."
msgstr ""
"들리는 소문엔, 그가 마을을 이끌었던 적도 있었대, 좋은 사람이었고, 존경받는 사람이었다더라고, 그런데 갑자기 어둠으로 돌아섰다고 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 626802bd-8181-5be2-795c-40b0b2e6592a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:626802bd-8181-5be2-795c-40b0b2e6592a
msgctxt "h0d570e27gf8a3g4e0cgbba0gd19d8a91b2e0"
msgid ""
"Our fates are entwined - more than you may realise. Ketheric's cult put that "
"parasite in your head. There's no obscenity too vile for him."
msgstr ""
"네가 생각하는 것 이상으로 우리 운명은 얽혀있어. 케서릭의 교단이 네 머리에 기생충을 심었지. 놈은 추악한 짓을 하는데 거리낌이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 629a44dd-bede-3656-3478-131c37cffd04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:629a44dd-bede-3656-3478-131c37cffd04
msgctxt "ha9351de0g09d1g4b06g94e2g4926080045e4"
msgid ""
"An unfortunate coincidence. I hope never to meet the wicked man who "
"haemorrhaged shadows over this peaceful village. But you - you're different."
msgstr ""
"이름이 같다니 유감스러운걸. 이 평화로운 마을을 그림자로 난도질한 사악한 사람과는 절대 만나지 않고 싶어. 하지만 너- 넌 달라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Shadowheart
#. NodeID = 6443b259-0b82-1313-9c2e-916ba996afa3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(3) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:6443b259-0b82-1313-9c2e-916ba996afa3
msgctxt "h5cc5f393g7ae7g4264gb32dg69ea74bd6270"
msgid "Selûnite magic. Dark Lady forgive me."
msgstr "셀루네의 마법이라니. 어둠의 여신이시여 절 용서하소서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 65cb3117-a28a-49ca-8ef5-953cd049806f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_DiscussMarcus = False
#.   Object:
#.      - HAV_Jaheira_Knows_WasWarned(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:65cb3117-a28a-49ca-8ef5-953cd049806f
msgctxt "h5facb619g03d3g4006gb020gb15b80a4f909"
msgid ""
"You were right. You tried to warn me, but I was too stubborn to listen. It "
"won't happen again."
msgstr "네 말이 맞았어. 나에게 경고하려 했지만, 내 고집으로 듣지 않았지. 다신 이런 일 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 68ad8e22-9f13-2bc6-34e5-a00786de7df1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:68ad8e22-9f13-2bc6-34e5-a00786de7df1
msgctxt "hfd8ab2efge465g481bg81a5g2bd8f076ee38"
msgid ""
"I'd say the same about you, if I hadn't just seen you fight against Marcus. "
"I'm willing to put my doubts aside - perhaps you can, too."
msgstr ""
"나도 내가 직접 네가 마커스와 싸우는 걸 보지 못했다면 같은 말을 했을 거야. 난 의심을 내려놓을 준비가 되었어, 너도 그랬으면 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 6ad239e3-cf9b-c669-d27d-0fa25a933633
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:6ad239e3-cf9b-c669-d27d-0fa25a933633
msgctxt "h561e1d43gfc51g43ecgb881gc42a099bc12d"
msgid "Then I'd better be going."
msgstr "그렇다면 가보는 게 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 6b889345-1575-b10c-98cc-17ce08c58ec3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelGaveMoonlantern = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:6b889345-1575-b10c-98cc-17ce08c58ec3
msgctxt "h1b1a11bagbceeg4574gbf1ag098c96a552fc"
msgid ""
"Well! If I'd have realised, I'd have spared the theatrics. In that case, you "
"should be able to navigate a path straight to your target. That's good - "
"very good."
msgstr ""
"이런! 미리 알았다면 이런 의식은 생략할 수 있었을 텐데. 뭐 그렇다면, 그대로 길을 돌파할 수 있겠구나. 좋아. 아주 좋은 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 6c0ed51f-c10f-2445-c7a0-dedf3584c480
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:6c0ed51f-c10f-2445-c7a0-dedf3584c480
msgctxt "h5e0ac429gfed0g4819g9c7dgfd7663ec48ef"
msgid ""
"General Ketheric Thorm. Remember that name. He's the leader of the "
"Absolutists."
msgstr "케서릭 쏨 장군. 이 이름을 기억해둬. 절대자 신도들의 지도자니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 72463282-72c9-92e4-dd92-d74473531fb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SCL_Drider_State_HarpersReturnWithLantern = True
#.   Object:
#.      - SCL_Drider_State_HasDriderMoonlantern(0) = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_IsobelGaveMoonlantern = True
#.   Object:
#.     - SCL_Drider_Event_GiveMoonlantern(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:72463282-72c9-92e4-dd92-d74473531fb4
msgctxt "h0ef3e974g846cg4d38gbb1agbfd0a4361aa3"
msgid ""
"It won't be enough to protect you against areas of utter darkness, though - "
"where the curse is strongest. This lantern should, though."
msgstr "완전히 어둠에 잠식된, 저주가 가장 강력한 곳에선 효과가 없을지도 모르지만. 그땐 등불이 도움이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 739f118c-61c7-6ceb-b5ff-9cf3a0646f72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:739f118c-61c7-6ceb-b5ff-9cf3a0646f72
msgctxt "h08785e3cg0193g4520ga22fg5ad4bf95bf7b"
msgid ""
"Small inn. And it's not every day someone like you comes waltzing out of the "
"dark."
msgstr "작은 여관에서 들었어. 너 같은 사람이 어둠을 당당하게 뚫고 오는 건 흔히 볼 수 있는 게 아니라서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 7432f9ff-677a-f92e-e2c4-28acb2dd04d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:7432f9ff-677a-f92e-e2c4-28acb2dd04d6
msgctxt "hd977b74agf02cg4531gad51g4a7db7f6bd14"
msgid "Let's hope your cunning is as strong as your optimism."
msgstr "네가 낙관적인 만큼 네 계획도 효과적이길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 74b9b1e3-c4fb-4f48-566c-910c81fcaa48
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_HAV_IsobelGaveMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:74b9b1e3-c4fb-4f48-566c-910c81fcaa48
msgctxt "hc12b6ff5gb6adg445fg8c91gb22e0141b72f"
msgid ""
"We need a champion to find the source of his invincibility and put it to an "
"end. And it seems, my not-quite-True-Soul, that champion is you."
msgstr ""
"그가 함부로 끌어다 쓰고 있는 불멸의 근원을 찾아 없애버릴 용사가 필요해. 그러니까 나의 제법 참되지 않은 영혼이여, 정황상 네가 그 "
"적임자인 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 74d225fa-ca28-35e5-ab09-3928ea830005
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:74d225fa-ca28-35e5-ab09-3928ea830005
msgctxt "h337fa6f1g33f2g4a9cgbe0bgc53780fc3753"
msgid "Wait - before you head off into the shadows, there's... something else."
msgstr "잠깐, 그림자로 들어가기 전에, 그... 하나 더."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 74e9fbce-0935-2218-8ada-adc0900ae777
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_Jaheira_Knows_WasWarned(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:74e9fbce-0935-2218-8ada-adc0900ae777
msgctxt "h53d03678g3505g4d43g853ag3923602d6e40"
msgid ""
"And that was no random attack - you were the target, Isobel. They know how "
"important you are."
msgstr "그리고 그냥 공격한 게 아니었어, 네가 목표물이었지, 이소벨. 네가 얼마나 중요한 존재인지 알고 있었던 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 74eb9f8f-d316-4806-ae91-f8b14ae1e056
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:74eb9f8f-d316-4806-ae91-f8b14ae1e056
msgctxt "h00a89342g7552g4f55ga6f8g85cc728922e4"
msgid "I never get tired of hearing that."
msgstr "그런 말은 언제 들어도 질리지 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 763eed77-004d-15db-4fe9-52407dfd64e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:763eed77-004d-15db-4fe9-52407dfd64e5
msgctxt "ha3dceee1gd6a0g45fag8a7fga8765d3ee265"
msgid "Then you'd better find a way to stop a second attack."
msgstr "그럼 또다시 공격하기 전에 막아야 겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 7648c14e-86c8-1462-410c-33f372c1c1b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:7648c14e-86c8-1462-410c-33f372c1c1b8
msgctxt "h73e236fbgaa45g4afbgb5abg8894ef1807a5"
msgid ""
"Without me, Harpers, Flaming Fist, everyone intent on stopping Ketheric is "
"<i>dead</i>."
msgstr "나, 하퍼들, 그리고 플레이밍 피스트를 제외하면 케서릭에 맞설 만한 사람들은 모두 <i>죽었어</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Narrator
#. NodeID = 7868c289-3d5a-b0e7-adb7-da0b65d29a94
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#.      - SHADOWHEART_ENEMYOFSHARPATH(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:7868c289-3d5a-b0e7-adb7-da0b65d29a94
msgctxt "he36a6a9fg8059g454agb0b8g0da5d39ac374"
msgid ""
"*Ketheric Thorm worshipped Lady Shar...? That would make him your natural "
"ally, surely. Though perhaps it would be unwise to voice such a thought to "
"present company...*"
msgstr ""
"*케서릭 쏨이 샤를 숭배한다...? 그렇담 분명히 당신의 동료가 될 수도 있겠군요. 하지만 이런 생각을 여기 사람들에게 말하는 건 "
"현명하지 못한 일 일 겁니다...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 79860993-1645-3d25-fd35-e15c1ecb7811
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:79860993-1645-3d25-fd35-e15c1ecb7811
msgctxt "h9a411a81g7a4cg4904gb11dg881e73bc5da5"
msgid ""
"You are that chance. Protected by your artefact, you can infiltrate Moonrise "
"Towers, posing as a True Soul."
msgstr "네가 그 기회야. 아티팩트의 보호를 받으며, 참된 영혼인척 문라이즈 타워로 잠입할 수도 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 7e1bb66e-ec14-64b7-ad73-8009203a56c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:7e1bb66e-ec14-64b7-ad73-8009203a56c2
msgctxt "he1edc701ge290g4756gbd72ga6e1643f6d93"
msgid "Intriguing. <i>Powerful. </i>"
msgstr "흥미로웠어. <i>강력했지. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 7ea4fadd-2911-013f-b44b-ed8838468c79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:7ea4fadd-2911-013f-b44b-ed8838468c79
msgctxt "h8f022720g6aaeg42dag9eb5gd929163ac8e3"
msgid ""
"Why does a man like him do anything? Power - spite - some kind of twisted, "
"personal morality."
msgstr "그런 놈에게 이유 따위를 물어서 뭐하겠어? 권력, 앙심, 어쩌면 자기 나름의 뒤틀린 원칙 때문인지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 80fea079-2107-5710-5e8d-9df10ac8b619
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = True
#.   Object:
#.      - HAV_Isobel_Event_MentionedKetheric(2) = False
#. SetFlags:
#.   Object:
#.     - HAV_Isobel_Event_MentionedKetheric(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:80fea079-2107-5710-5e8d-9df10ac8b619
msgctxt "h6036e0efgc1b1g4c1fg9688ga48ed022ad42"
msgid ""
"I've seen him - he was presiding over a trial. Survived what should've been "
"a lethal blow, too."
msgstr "봤어. 재판을 주재하고 있던데. 게다가 죽을 정도의 공격을 받고도 살아남더라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 825d25f9-fd05-2e06-7150-dd1e7cd2a788
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:825d25f9-fd05-2e06-7150-dd1e7cd2a788
msgctxt "hce85e7aeg8572g4f42gae42g3a4b503c2a71"
msgid "How did you hear that?"
msgstr "어떻게 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 8467b4fb-4894-2f35-d8e0-7d21d8a15b6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:8467b4fb-4894-2f35-d8e0-7d21d8a15b6d
msgctxt "h12601bf5gf930g40bcgb933g7651340e5fca"
msgid ""
"For as long as I'm able. Even Selûne's light can't hold back the dark "
"forever."
msgstr "할 수 있는데 까진 하려고. 셀루네의 빛이라해도 이 어둠을 완전히 밀어낼 순 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 8578d0b8-bc89-ec4f-f63c-aaf89f51333a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:8578d0b8-bc89-ec4f-f63c-aaf89f51333a
msgctxt "hb3439333g66e1g4108gb1a5gfd40766fd31b"
msgid "Long dead - whoever she was."
msgstr "누군진 몰라도, 죽은 지 오래됐겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 865727ac-2a10-e431-fdc8-a619997dcf34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:865727ac-2a10-e431-fdc8-a619997dcf34
msgctxt "h554ec0a4g7eeag4ecaga34cg737a808c1367"
msgid "I'll look after them, Jaheira. You should check on the others."
msgstr "이 사람들은 내가 맡을게, 자헤이라. 넌 다른 사람들을 봐줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 89594edf-72f8-a42c-9516-ea703912b379
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:89594edf-72f8-a42c-9516-ea703912b379
msgctxt "h06a858bcga160g451cga6d5g0b8114ee15af"
msgid "Marcus told me Ketheric wanted you captured - not killed. Why?"
msgstr "케서릭은 마커스에게 널 죽이지 말고 사로잡아서 데려오라 했어, 왜지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 8b05ffbc-0ebb-438d-b9d0-e96396b64bf4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:8b05ffbc-0ebb-438d-b9d0-e96396b64bf4
msgctxt "h71b336b6g5bb7g4738ga52bg7d533ca5311e"
msgid "Only a fool would doubt the Moonmaiden."
msgstr "달처녀님을 의심하는 건 바보같은 짓이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 8d64e660-100a-f44e-f579-f2e8e2ce93fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:8d64e660-100a-f44e-f579-f2e8e2ce93fc
msgctxt "h4b46ab65g29c9g40d6g8723g93b6f0b94c5d"
msgid ""
"He was a Sharran, once - took to building an army of Dark Justiciars beneath "
"this very village. Alongside the local druids, we made it our business to "
"see him deposed - dead and buried."
msgstr ""
"놈은 한때 샤 신도였어, 이 마을 바로 아래서 다크 저스티시어의 군대를 일으켰지. 이 땅의 드루이드들과 힘을 합쳐 그를 몰아낸 뒤, "
"죽이고 묻었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 8e38fd74-b5bc-5e77-89be-7ebae865d097
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:8e38fd74-b5bc-5e77-89be-7ebae865d097
msgctxt "hfc3568c4g10b0g4651g9629g5f0abc30af3c"
msgid "Who's the woman in the picture?"
msgstr "그림 속 여자는 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 8fefe120-cd1b-040d-923a-92c9257b1bfc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = False
#. SetFlags:
#.   Global:
#.     - HAV_Isobel_State_ReceivedMoonriseQuest = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:8fefe120-cd1b-040d-923a-92c9257b1bfc
msgctxt "hdc8c3fa7g4309g4da0ga882ga097a7c00e03"
msgid ""
"If you are who I think you are, you have a long road ahead of you. Good "
"luck. And thank you."
msgstr "네가 우리가 생각하는 그런 사람이라면, 긴 여정이 기다리고 있을 거야. 행운을 빈다. 그리고 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = 97ab2663-9a11-bb91-ed89-da7b3ff442f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:97ab2663-9a11-bb91-ed89-da7b3ff442f9
msgctxt "h74ad360fgdc50g4d4cgb6bcgc6f54992251b"
msgid "But they don't know about <i>you</i>."
msgstr "하지만 <i>너</i>의 존재는 몰랐던 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = 9a32ea7c-39ad-fa8d-1aad-b487c2f467cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:9a32ea7c-39ad-fa8d-1aad-b487c2f467cc
msgctxt "h60a18bc1g3964g4635ga146g9bb1fe51575e"
msgid "You'll be here to protect these people, won't you?"
msgstr "넌 여기서 사람들을 지킬 거지, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 9abde205-7b67-43cc-765f-d0d234ed4d24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ACT2_SHADOW_CURSE_IMMUNE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:9abde205-7b67-43cc-765f-d0d234ed4d24
msgctxt "ha67d1543g0ddeg4ba5gb089g645a8308a434"
msgid "Consider it a backup in case you lose that lantern."
msgstr "등불을 잃어버렸을 때를 대비하는 거라고 생각하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 9c9e4224-dd4b-d9da-9289-25b8164e3214
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:9c9e4224-dd4b-d9da-9289-25b8164e3214
msgctxt "h66dd6831g3f4fg4c62ga39dg94dd2e12dea3"
msgid "I don't fear much. Not even death. But I do fear him."
msgstr "난 겁이 많은 편이 아니야. 심지어 죽음도 두렵진 않지. 하지만 그는 무서워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Narrator
#. NodeID = 9cf5deaf-65e2-7436-7b8e-cdaf8a2f2971
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:9cf5deaf-65e2-7436-7b8e-cdaf8a2f2971
msgctxt "hcfcca4a2g5f9bg49cfga1adgc9c5fe3c0298"
msgid ""
"*Her breath catches; you notice a barely-perceptible shudder run through her "
"body.*"
msgstr "*그녀의 숨소리가 멈칫합니다. 당신은 그녀의 몸이 겨우 알아볼 정도로 떨리는 것을 알아챕니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = 9f31b194-a64a-d793-8d44-706c228a375f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:9f31b194-a64a-d793-8d44-706c228a375f
msgctxt "hffb9ecf4gdec2g41edg9093g74f4d4610745"
msgid "Pull the right brick, and the whole tower goes tumbling down."
msgstr "알맞은 벽돌 하나만 잡아 빼면, 공든 탑도 쉽사리 무너지는 법이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = a0ccb804-1091-085e-a252-f0888ec822de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:a0ccb804-1091-085e-a252-f0888ec822de
msgctxt "h0c7871abg5ab1g42f7gb7f4g3d410ad919af"
msgid "I haven't agreed to do anything."
msgstr "난 뭐 하겠다고 한 적 없는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = a0ff0473-b8f9-2f43-a4a4-fdda8b027461
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:a0ff0473-b8f9-2f43-a4a4-fdda8b027461
msgctxt "h7564517dgc6acg4e5ag8cd4g8e001d80312e"
msgid "Somehow fate keeps leading me to the same conclusion."
msgstr "왠지 운명이 하나의 결론으로 날 이끄는 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = a5fe98b4-fa00-b399-2d34-7a414a1e4d8d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:a5fe98b4-fa00-b399-2d34-7a414a1e4d8d
msgctxt "h5e8554efg98edg4cc4g9ed5g4e326203f3db"
msgid ""
"Discover the source of his invulnerability. Make him mortal, so we can make "
"him bleed. Good luck."
msgstr "불사의 근원을 찾아봐 줘. 그를 필멸자로 만들면, 우리가 피를 흘리게 할테니. 행운을 빈다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = a6f7cc63-f9ad-d069-aea8-f6984517667c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_Isobel_AskedHerAboutKethericDaughter(2) = False
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#. SetFlags:
#.   Dialog:
#.     - GLO_Isobel_AskedHerAboutKethericDaughter(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:a6f7cc63-f9ad-d069-aea8-f6984517667c
msgctxt "h147f56b9g9c78g4219g8ca5g0210e5a966ab"
msgid "Isobel. Isobel Thorm?"
msgstr "이소벨. 이소벨 쏨?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Shadowheart
#. NodeID = a9eef1f1-f58b-172d-5988-b9bb2402808f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:a9eef1f1-f58b-172d-5988-b9bb2402808f
msgctxt "h5edd423bg6800g401dg816dgbdaacb0935b8"
msgid "A gaudy display. Let's just hope it actually protects us."
msgstr "화려하구만. 저게 우릴 지켜주길 바라자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = af7c2637-1a24-899f-90ff-94a22caf9905
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:af7c2637-1a24-899f-90ff-94a22caf9905
msgctxt "h27ead694g1e0ag4ee9ga2edge747c7a99aa6"
msgid ""
"I don't know why he's waiting, why he's not marching his army west as we "
"speak, but as long as he remains, there's still a chance."
msgstr ""
"그가 왜 기다리고 있는지, 왜 우리 예상대로 서쪽으로 진군하지 않는 건지 알 수는 없지만, 그가 머뭇거리는 이상 우리에겐 기회가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = b09bb84a-e6ba-6bf2-7eb8-d5d098bca6b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:b09bb84a-e6ba-6bf2-7eb8-d5d098bca6b5
msgctxt "ha391ce94g9ad5g4315g8a20g49a1cebea203"
msgid ""
"You'll have time for irrelevance when you're dead. For now, we need you."
msgstr "죽고 나면 그런 건 죄다 무의미해질 거야. 지금 당장은 네 도움이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = b0f8a73a-021f-43e5-b145-635563cbff12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_HAV_TakingIsobel_HasMet_BriefInRoom(2) = False
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:b0f8a73a-021f-43e5-b145-635563cbff12
msgctxt "h60bfc028gb85bg45adgba53g9125c01470c0"
msgid ""
"The True Soul who saved my life - and a Sharran, if my senses don't deceive "
"me."
msgstr "내 목숨을 구해준 참된 영혼, 그리고 내 감이 틀리지 않았다면, 샤 신도로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = b0f8a73a-021f-43e5-b145-635563cbff12
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_HAV_TakingIsobel_HasMet_BriefInRoom(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:b0f8a73a-021f-43e5-b145-635563cbff12
msgctxt "hc2b7fc4fgfb5cg406agbb2bgf2568e7f802a"
msgid "The True Soul who saved my life."
msgstr "내 생명을 구해준 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = b3bc5dc2-021d-7cc6-bf27-f758785c1716
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:b3bc5dc2-021d-7cc6-bf27-f758785c1716
msgctxt "h123db22dg71ccg4787g9e8fg13731c4adc65"
msgid "So powerful he may be past our ability to fix this."
msgstr "너무나 강력해서 이젠 우리의 능력으로 어찌 할 수 없을지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = b5a2c0d4-94b7-81d2-246e-49c69f38b133
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:b5a2c0d4-94b7-81d2-246e-49c69f38b133
msgctxt "h037b8922g4b0ag4cedgaec4g8ea93a6043a7"
msgid ""
"It suits you. And better than that, it'll make you immune to the lesser "
"effects of the shadow curse, which will get you closer to the Towers."
msgstr "잘 어울리네. 무엇보다, 이제 약한 그림자 저주에는 영향을 받지 않을 거야, 타워에 다가갈 수 있게 해주겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = ba68b0d9-e9e1-dd63-f0b9-2fd291d9df6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:ba68b0d9-e9e1-dd63-f0b9-2fd291d9df6f
msgctxt "hf1c06aacg8341g4f09g9a0agffadb53e9c18"
msgid ""
"A man does not return from the dead and becomes impervious to arrows out of "
"nowhere. There is magic at work - strong, arcane, and most likely "
"necromantic."
msgstr ""
"죽음에서 돌아왔다고 해서 화살이 통하지 않는다거나 하는 일은 없어. 강하고, 비밀스러운, 아마 강령술의 일종인 마법이 작용하고 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = bd659a4c-7e81-a5dd-b2de-d8059e2de900
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_IsobelGaveOintment = True
#.      - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:bd659a4c-7e81-a5dd-b2de-d8059e2de900
msgctxt "hd1dbae94g60f5g4d34g9f42g0a36ab74b6ff"
msgid "Ketheric will strike again. We need <i>you </i>to strike first."
msgstr "케서릭은 다시 공격해 올 거야. 우리가 먼저 공격하려면 <i>네 </i>도움이 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = c25a9ec4-ea4c-2471-c1e0-e538b059b5b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:c25a9ec4-ea4c-2471-c1e0-e538b059b5b0
msgctxt "h2215f75eg5d0bg47dfg8f40g1ef7fc0e195e"
msgid "I haven't met him yet - but I intend to."
msgstr "아직이긴 한데, 만나보고 싶군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Narrator
#. NodeID = c2bf4fe0-8eb8-90e3-adec-59a9648cd886
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Isobel_KnowsKethericFather = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:c2bf4fe0-8eb8-90e3-adec-59a9648cd886
msgctxt "hfa0f8b8fg539dg4d43gb149gc7feb1f26fc1"
msgid ""
"*Isobel. The same name as Ketheric Thorm's daughter - the one whose "
"sarcophagus you found empty in the family mausoleum.*"
msgstr "*이소벨. 당신이 가족묘지에서 발견한 비어있던 석관의 주인, 케서릭 쏨의 딸 이름과 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = c303090c-07c5-09ea-7bed-24fb0bbdaf0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelGaveMoonlantern = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:c303090c-07c5-09ea-7bed-24fb0bbdaf0b
msgctxt "h24b4e715gf17eg414eg8809gb6fbbb2749fc"
msgid "Well! Now you have two. Just in case."
msgstr "좋아! 그럼 이제 두 개야. 혹시 모르니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = c40c644f-9f3c-6c03-554b-b28f5aa0fb08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:c40c644f-9f3c-6c03-554b-b28f5aa0fb08
msgctxt "hae6c2fb2ge012g489eg97c0g57c408951abc"
msgid "Perhaps there's something to it, then."
msgstr "그렇담 거기 뭔가 있는 거겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = c4aa439f-cc3e-88ab-1805-94c567b0a824
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:c4aa439f-cc3e-88ab-1805-94c567b0a824
msgctxt "h7308c15cgeb4eg4bcag94f6g29c9815c30af"
msgid "You did? How did he... how did he seem?"
msgstr "봤다고? 그는... 어땠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = c57ee454-d444-b789-1be2-c51dcbf075ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:c57ee454-d444-b789-1be2-c51dcbf075ab
msgctxt "h39d933f2ged71g4db3ga47cg29791ad639cf"
msgid "There is, actually."
msgstr "사실, 있긴 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = c6d0fe78-0df5-b636-c370-7fcdb2185419
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:c6d0fe78-0df5-b636-c370-7fcdb2185419
msgctxt "h5b7662abg15c2g4a18gb642gc34e63a42043"
msgid ""
"Not yet. Jaheira says he's invincible - that I need to find a way to make "
"him vulnerable."
msgstr "아직. 자헤이라는 그가 무적이랬어, 그래서 내가 그의 약점을 찾아야 하는 거고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = c72a9218-bbe9-65ae-8082-1ab129466177
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:c72a9218-bbe9-65ae-8082-1ab129466177
msgctxt "heaf9e8d8g55e7g4ff5gab2fga5c876db7708"
msgid "I have. <i>You.</i>"
msgstr "그럴거야. 그리고 <i>너.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = cc8a41c4-c297-4eb6-8c86-39fe832b7b86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:cc8a41c4-c297-4eb6-8c86-39fe832b7b86
msgctxt "h1bdfb865gdc14g4c71g9360ga11cae30a414"
msgid ""
"I found this on the wall when I arrived. It must be a hundred years old. "
"Ketheric, before he turned."
msgstr "이건 내가 도착했을 때 벽에 걸려 있던건데. 백 년은 됐을 거야. 변하기 전의, 케서릭."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = cc9538c3-900d-495e-e8e8-b60a66df7f7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:cc9538c3-900d-495e-e8e8-b60a66df7f7c
msgctxt "h1373ad00g65b9g44f1ga0d4gbad188859b19"
msgid "Good. Because your work here is only beginning."
msgstr "좋아. 네 일은 이제 시작일 뿐이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = cd6c53b9-024a-7aff-db54-9b9cbaeafa65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:cd6c53b9-024a-7aff-db54-9b9cbaeafa65
msgctxt "he7432533gc770g4321g8250g0cbed6500f17"
msgid ""
"You can walk among the cult unnoticed - which means you can get close to "
"their leader, Ketheric Thorm, in Moonrise Towers."
msgstr ""
"네가 교단을 들쑤시고 다녀도 걔네는 알아채지 못할 거야, 그 말은 걔네 지도자한테 접근 할 수 있을 거란 말이지, 문라이즈 타워의, "
"케서릭 쏨 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = cebf44f8-f779-bc08-a5e6-c5f0169847a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCL_Drider_State_HasMoonlantern(2) = True
#.   Tag:
#.      - ACT2_SHADOW_CURSE_IMMUNE(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:cebf44f8-f779-bc08-a5e6-c5f0169847a1
msgctxt "h9dddd175g7be1g4474g8d74g9812b3352dac"
msgid "I already have a Moonlantern. I can safely travel the shadows."
msgstr "난 이미 달등불을 가지고 있어. 그림자를 안전하게 지나갈 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = d2922456-7fd6-7d3f-9742-e4be2cf9dc69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_IsobelGaveOintment = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:d2922456-7fd6-7d3f-9742-e4be2cf9dc69
msgctxt "hd84fe189g4e48g4355ga257g1946d609d010"
msgid "Isobel - this is -"
msgstr "이소벨, 이건,"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Shadowheart
#. NodeID = d2c6e6bd-cef8-4eb5-ba13-059fc805c544
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.   Tag:
#.      - SHADOWHEART_ENEMYOFSHARPATH(3) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:d2c6e6bd-cef8-4eb5-ba13-059fc805c544
msgctxt "h619e0bc6gf562g4e20gac22g0169de11b6da"
msgid "A Sharran? Perhaps someone I should seek out..."
msgstr "샤 신도? 한 번 찾아보는 것도 좋겠는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = d4cd42dd-27c9-c80d-d7f5-1b4cdd5ca36f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:d4cd42dd-27c9-c80d-d7f5-1b4cdd5ca36f
msgctxt "hd57e0cf1g8815g47cfg9ddfg842851f1696b"
msgid ""
"The darkness he's subscribed to is unlike any I've heard of. I fear there's "
"something deeper behind it all - something neither you, nor I, nor even "
"Selûne can fix."
msgstr ""
"그가 따르는 어둠은 내가 아는 그 어떤 것과도 달라. 그 어둠 뒤에 너, 나, 그리고 셀루네 조차도 고칠 수 없는, 더 깊은 무언가가 "
"숨겨져 있을까 두려워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = ddc2b39d-f9af-caf9-eac7-c94fd8464972
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_HAV_TakingIsobel_HasMet_BriefInRoom(2) = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:ddc2b39d-f9af-caf9-eac7-c94fd8464972
msgctxt "h81f45a74gf27eg4fe3g9499g6446e6fa3c1d"
msgid "We've met. She warned me about Marcus - just before the attack."
msgstr "이자는 만난 적이 있어요. 마커스에 대해 경고해 주었죠. 공격 직전에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = ddc2b39d-f9af-caf9-eac7-c94fd8464972
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_HAV_TakingIsobel_HasMet_BriefInRoom(2) = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:ddc2b39d-f9af-caf9-eac7-c94fd8464972
msgctxt "h4a9a6548g2e03g4f13g8328g8485a93bc8b6"
msgid "We've met. He warned me about Marcus - just before the attack."
msgstr "이자는 만난 적이 있어요. 마커스에 대해 경고해 주었죠. 공격 직전에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = ddc2b39d-f9af-caf9-eac7-c94fd8464972
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GLO_HAV_TakingIsobel_HasMet_BriefInRoom(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:ddc2b39d-f9af-caf9-eac7-c94fd8464972
msgctxt "h8302b0a5gfe8fg4d4bg80f8g66cabb8b3e36"
msgid "We've met. They warned me about Marcus - just before the attack."
msgstr "이자는 만난 적이 있어요. 마커스에 대해 경고해 주었죠. 공격 직전에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = dddde601-0d95-3350-7580-80a3465b5e61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:dddde601-0d95-3350-7580-80a3465b5e61
msgctxt "h2c2e4c8cg8df4g428dg900fg229e6a53c102"
msgid "I might take that badly if you hadn't just saved my neck, Sharran."
msgstr "니가 방금 내 목숨을 구해주지 않았다면 안좋은 쪽으로 받아들였을 거야, 샤 신도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = e093beb5-5b08-88d4-6111-77786cdb0fd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:e093beb5-5b08-88d4-6111-77786cdb0fd0
msgctxt "h84b9eea1gc294g45ddga127g328a9d2a59d1"
msgid "Isobel! Are you all right?"
msgstr "이소벨! 괜찮나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = e51da886-1634-a4a6-e17a-2e7c8550fb9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:e51da886-1634-a4a6-e17a-2e7c8550fb9c
msgctxt "h0ed4806fg30c4g4f59gaa73g77b894387738"
msgid ""
"I have something for you - something that'll help you make it to the Towers."
msgstr "줄 게 있어, 이게 타워로 가는데 도움을 줄 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = ed198ec5-4a59-ccdd-b59a-d9180bbb5c58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:ed198ec5-4a59-ccdd-b59a-d9180bbb5c58
msgctxt "h6ce42be3ga846g4709g97b3g0b821a03b22f"
msgid ""
"You can walk among the cultists undetected; you can find the source of "
"Ketheric's power."
msgstr "넌 교단을 들쑤시고 다녀도 들키지 않을 거야, 네가 케서릭의 힘의 근원을 찾을 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = eecef0ed-e827-0499-c62b-6a0c00db71eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:eecef0ed-e827-0499-c62b-6a0c00db71eb
msgctxt "h6602acb7g0fd3g446cg9bf8g602cf34cfc2b"
msgid ""
"We met him on the road here - commanding the army of the Absolute. I put an "
"arrow through his eye myself, only to watch him pluck it out like a splinter."
msgstr ""
"그가 절대자의 군대를 지휘하며 길을 지나갈때 마주친 적이 있지. 내가 직접 눈알에 화살을 박아줬는데, 그냥 가시 박힌 걸 빼듯 행동했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = f0b1c5e2-a662-fe59-8aaf-5765a887f48c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:f0b1c5e2-a662-fe59-8aaf-5765a887f48c
msgctxt "h78129af3g4a21g4babg9e9dg4ca8f16481fe"
msgid "We'll be sure to free them - <i>after </i>Ketheric is dead."
msgstr "당연히 풀어줄 거야, 케서릭이 죽고난 <i>다음에 </i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = f17a3e30-bae8-3ea6-446d-5370bbb97d2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:f17a3e30-bae8-3ea6-446d-5370bbb97d2c
msgctxt "h26d59359g9946g4036g8d39g3a724896dda9"
msgid ""
"I don't like to go on in front of the others, but... it's about Ketheric "
"Thorm."
msgstr "다른 사람 앞에서 이야기하고 싶지는 않은데, 이건... 케서릭 쏨에 대한 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = f1f51c27-2d66-2106-27a7-1eb7b35a7061
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:f1f51c27-2d66-2106-27a7-1eb7b35a7061
msgctxt "hb60fe7b7g5c05g40e1gae35gee5ef242e503"
msgid "Who is Ketheric?"
msgstr "케서릭이 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = f54e1391-5245-3463-77ed-bd3ac473d4d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:f54e1391-5245-3463-77ed-bd3ac473d4d3
msgctxt "hff904533g43f8g4eacg8e65g558750b80974"
msgid "Now that we have you, I hope I won't have to."
msgstr "이제 우리 쪽에 네가 있으니, 그럴 필요도 없겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = f6957aef-7047-f58f-ad75-9a569d00be6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = True
#. SetFlags:
#.   Global:
#.     - HAV_Isobel_State_ReceivedMoonriseQuest = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:f6957aef-7047-f58f-ad75-9a569d00be6d
msgctxt "ha9c085d6g78c2g41feg9312gfb10126ed18c"
msgid ""
"Remember what we discussed. Ketheric will strike again. We need <i>you </"
"i>to strike first."
msgstr "우리가 이야기했던거 잊지마. 케서릭은 다시 공격해 올 거야. 우리가 먼저 공격하려면 <i>네 </i>가 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Player
#. NodeID = f7c72096-ae20-c644-5119-c8583288790b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Jaheira_State_MissionGiven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:f7c72096-ae20-c644-5119-c8583288790b
msgctxt "h46d0143cgaa52g4b9egaddfg67481af09399"
msgid "I've been over this with Jaheira. I'll head to the Towers shortly."
msgstr "이미 자헤이라와 이야기 끝냈어. 곧 타워로 갈거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Jaheira
#. NodeID = f88f9347-466c-9857-0870-2ec2084799fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_SCL_Ketheric_State_PlayerKnowsKethericHistory = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:f88f9347-466c-9857-0870-2ec2084799fc
msgctxt "h1e700a3bg7907g4257ga8b2gbe82ae070130"
msgid ""
"But he's returned. Not only does General Ketheric Thorm live again, it seems "
"he is no longer mortal. He has become, in fact, invincible."
msgstr "하지만 그가 돌아왔지. 케서릭 쏨 장군으로 살아돌아온 것뿐만 아니라, 더 이상 필멸자도 아닌 것 같아. 사실상 무적이 된 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = fd013da6-1e33-688c-b58a-0d116860d578
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:fd013da6-1e33-688c-b58a-0d116860d578
msgctxt "h580b36a4ga79bg49bcgb5fege19532dcc5e1"
msgid ""
"Your future is our future. Stop Ketheric, and you may find the cure to that "
"parasite in your head."
msgstr "네 미래가 우리 미래니까. 케서릭을 막으면, 네 머릿속 기생충을 치료하는 법을 알아낼 수 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved
#. Speaker = Isobel
#. NodeID = ff5e67df-177d-36f4-f376-2a7bdc42c44d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_FollowUpSaved:ff5e67df-177d-36f4-f376-2a7bdc42c44d
msgctxt "haeb1428fg84c0g4489gbdc7g8cb96095bfa2"
msgid "No mercy. For Ketheric will have none on you. End this."
msgstr "자비를 보이지 마. 케서릭은 어느 것 하나 내주지 않을 테니까. 끝을 봐야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_IsobelSaved
#. Speaker = Isobel
#. NodeID = 4e56e05d-7a9c-48c2-aa51-0798ff7cb146
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_IsobelSaved:4e56e05d-7a9c-48c2-aa51-0798ff7cb146
msgctxt "hdb04cd56gf363g4c8cgb4e9g748a58463e7d"
msgid "Help the others - hurry!"
msgstr "다른 사람들을 도와, 어서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_JaheiraCallToArm
#. Speaker = Jaheira
#. NodeID = 71406670-43a9-45e6-9e7a-12f5f3f8a86f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_JaheiraCallToArm:71406670-43a9-45e6-9e7a-12f5f3f8a86f
msgctxt "h4c4f70b1g040cg4ed3g82e9g322b4d741b4b"
msgid "To arms! Protect Isobel at all cost!"
msgstr "집결! 무슨 일이 있어도 이소벨을 지켜라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_JaheiraCallToArm
#. Speaker = Jaheira
#. NodeID = ddd81bff-884c-4325-8ff2-af2ef72acd45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_CallToArmAtLake = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_JaheiraCallToArm:ddd81bff-884c-4325-8ff2-af2ef72acd45
msgctxt "h8d1635e1gefd5g4a8cg9489gfbcf4f329b9b"
msgid "Over here! Isobel's being attacked!"
msgstr "이쪽이다! 이소벨이 공격받고 있다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_Jaheira_AD_ToIsobel
#. Speaker = Jaheira
#. NodeID = 6cc6fe32-734a-2f8f-2e17-6cde83121cef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_Jaheira_AD_ToIsobel:6cc6fe32-734a-2f8f-2e17-6cde83121cef
msgctxt "hf89053a3gbe0fg42ffg8b9agd9ab6a8b4cf5"
msgid "Isobel - she <i>cannot </i>fall!"
msgstr "이소벨! 그 아이가 쓰러져선 <i>안 돼</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = 0e67e8c0-9ce5-d722-fd06-d37173b5c66d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:0e67e8c0-9ce5-d722-fd06-d37173b5c66d
msgctxt "h9efc938bgfb84g4fc8ga191g142599734de4"
msgid ""
"Flaming Fist armour. And someone - something - burst out of it like a moth "
"from a cocoon."
msgstr "플레이밍 피스트 갑옷이라. 아무래도 여기서 누가, 아니, 뭔가가 갑옷을 뚫고 부화한 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = 0e67e8c0-9ce5-d722-fd06-d37173b5c66d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:0e67e8c0-9ce5-d722-fd06-d37173b5c66d
msgctxt "ha140f515g0ac3g4461g910ag537ad4326268"
msgid ""
"Something ripped off Flaming First armour like you might peel an orange..."
msgstr "뭔가가 플레이밍 피스트 갑옷을 오렌지 껍질 벗기듯이 찢어 버렸군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = 0e67e8c0-9ce5-d722-fd06-d37173b5c66d
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:0e67e8c0-9ce5-d722-fd06-d37173b5c66d
msgctxt "hc452e9cfgb793g472dg8124gf2b26469833d"
msgid "Someone shed Flaming Fist armour - and blood."
msgstr "누가 플레이밍 피스트 갑옷을 흘리고 갔네. ...피랑 같이 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = 0e67e8c0-9ce5-d722-fd06-d37173b5c66d
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:0e67e8c0-9ce5-d722-fd06-d37173b5c66d
msgctxt "h4153fc04g2598g48d5g8173g5c00cb7b8316"
msgid "Pieces of armour flecked with blood - it was burst open from within."
msgstr "갑옷 조각이 피로 얼룩져 있군. 내부로부터 일어난 폭발에 의해 조각난 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = 0e67e8c0-9ce5-d722-fd06-d37173b5c66d
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:0e67e8c0-9ce5-d722-fd06-d37173b5c66d
msgctxt "hf74f0802g734eg41c8ga540g5c60404bd65a"
msgid ""
"Flaming Fist armour, ripped open like parchment... looks like the damage "
"came from <i>within</i>."
msgstr "플레이밍 피스트 갑옷이 양피지마냥 찢어져 있어... 손상이 <i>안쪽에서부터</i> 일어난 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = 0e67e8c0-9ce5-d722-fd06-d37173b5c66d
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:0e67e8c0-9ce5-d722-fd06-d37173b5c66d
msgctxt "hfe7612f7g5fcag4e1egad72g7a2ecdd078af"
msgid ""
"That's Flaming Fist armour. And someone - some<i>thing</i> - burst right out "
"of it."
msgstr "저건 플레이밍 피스트 갑옷이잖아. 저 안에서 누군가, 아니, <i>뭔가가</i> 터져나왔군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = 0e67e8c0-9ce5-d722-fd06-d37173b5c66d
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:0e67e8c0-9ce5-d722-fd06-d37173b5c66d
msgctxt "h1fce68ecg2d21g42e4g8238gcd3be1fb63a9"
msgid ""
"Someone - some<i>thing</i> - shed Flaming Fist armour like a second skin."
msgstr "누군가, 아니. <i>무언가가</i>... 허물을 벗듯이 플레이밍 피스트 갑옷을 벗어 놓고 갔군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = f0152a22-70ac-c8c7-5228-4c64a8b8f206
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:f0152a22-70ac-c8c7-5228-4c64a8b8f206
msgctxt "h6c78611dg4e96g4a39gaaa3gb84f5a06532e"
msgid "Armour and blood. Hardly a good sign."
msgstr "갑옷과 피라. 좋은 징조라고 말하기는 어렵겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = f0152a22-70ac-c8c7-5228-4c64a8b8f206
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:f0152a22-70ac-c8c7-5228-4c64a8b8f206
msgctxt "h981d72e3g3b9eg4821g980bg98ff25a5f9fb"
msgid "What do we have here...?"
msgstr "무슨 일이 일어난 거지...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = f0152a22-70ac-c8c7-5228-4c64a8b8f206
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:f0152a22-70ac-c8c7-5228-4c64a8b8f206
msgctxt "h5951aaf0g983cg4c75g9e7cga03ad4469b89"
msgid "Hm. Odd."
msgstr "흠, 이상한걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = f0152a22-70ac-c8c7-5228-4c64a8b8f206
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:f0152a22-70ac-c8c7-5228-4c64a8b8f206
msgctxt "h29acc388g32adg4cc1gba18gae43c3b93963"
msgid "Blood and armour were both shed here. Odd."
msgstr "피와 갑옷이 동시에 흩뿌려져 있군. 이상해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = f0152a22-70ac-c8c7-5228-4c64a8b8f206
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:f0152a22-70ac-c8c7-5228-4c64a8b8f206
msgctxt "h1afb8ed3g0139g42a0gad7bge7ef4523c064"
msgid "Bloodied armour - wonder why."
msgstr "피에 젖은 갑옷이라. 왜 이렇게 된 건지 궁금하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = f0152a22-70ac-c8c7-5228-4c64a8b8f206
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:f0152a22-70ac-c8c7-5228-4c64a8b8f206
msgctxt "h0fe232a8gccaag4f10gb82dg088f122d05a2"
msgid "Flaming Fist armour - and fresh blood. That's... concerning."
msgstr "플레이밍 피스트 갑옷과 신선한 피. 이건... 걱정되는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue
#. Speaker = Player
#. NodeID = f0152a22-70ac-c8c7-5228-4c64a8b8f206
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_PAD_SpyTransformationClue:f0152a22-70ac-c8c7-5228-4c64a8b8f206
msgctxt "h83c1de62gd43eg429cgb208g8a8c06f919a8"
msgid "Blood and bits of armour. Worrying."
msgstr "핏자국과 갑옷 조각인가. 걱정되는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 06dc31d3-997b-b627-8443-c5b65a3d9bf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:06dc31d3-997b-b627-8443-c5b65a3d9bf8
msgctxt "h8274da11g27c6g4c99ga7c5g526123cc82f6"
msgid "What the hells is going on?"
msgstr "뭐가 어떻게 돼 가는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 074256e7-e9e6-9baa-9512-346212703ad8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithSpy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:074256e7-e9e6-9baa-9512-346212703ad8
msgctxt "h1023a58bgb08fg4fdfgad85gf97ca7d9d2a9"
msgid "<i>Sounds like fun - I'm with you.</i>"
msgstr "<i>재밌어 보이네요, 거들겠습니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = GROUP_ACT2_HAV_FlamingSpyTransformHarpers
#. NodeID = 0825966f-59b2-f95a-6e8c-f11ed0b9f67f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ACT2_HAV_HARPER1(3) = True
#. SetFlags:
#.   Object:
#.     - HAV_TakingIsobel_Event_IncludeAbductees(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:0825966f-59b2-f95a-6e8c-f11ed0b9f67f
msgctxt "hd6bca7a3g27f8g4448g8a54g222db3910620"
msgid "To arms!"
msgstr "무기를 들어라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 083d97be-21e3-c61b-24b2-39fa22edbdc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:083d97be-21e3-c61b-24b2-39fa22edbdc9
msgctxt "h8b30905bgd538g4ffbg8d59g7c453fb7cb51"
msgid "Come with you? <i>Where?</i>"
msgstr "가야한다니? <i>어디로?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 08c0205b-ced3-0c3b-304d-78adc3963ee5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:08c0205b-ced3-0c3b-304d-78adc3963ee5
msgctxt "hb8b090bdgfcc3g419dg94e7g91f8854bc7cb"
msgid "What <i>are </i>you?"
msgstr "당신 <i>누구</i>야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 08c79f14-ea0a-fe0a-264a-9a3f2f1094ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:08c79f14-ea0a-fe0a-264a-9a3f2f1094ab
msgctxt "h54248f5dgf562g4250gb9c4ge34e3c0fc762"
msgid "I know what this is. You're... you're one of <i>them</i>. Both of you."
msgstr "무슨 수작인지 알겠어. 너.. 너도 <i>그들</i>과 한패구나. 너희 둘 다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 0a3fb5f3-2482-df4d-126b-cf7546f0bcc4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:0a3fb5f3-2482-df4d-126b-cf7546f0bcc4
msgctxt "hee4af76bg83e1g426bg8c25g203e560e405f"
msgid "<i>Your pretender god holds no sway here, True Soul.</i>"
msgstr "<i>너의 신 흉내꾼은 여기에 어떤 영향력도 없다, 참된 영혼</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 0da6d04c-88aa-3582-1df7-c54791e5483e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:0da6d04c-88aa-3582-1df7-c54791e5483e
msgctxt "h8b53a908gd159g4a93g8c2dg4d3a05baae38"
msgid "And I thank you for your hospitality."
msgstr "반겨줘서 고맙군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 11c34137-56ed-d28e-1806-59556d6ee7ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_EnteringHaven_TadpoleCheckpoint_RevealedMarcus = True
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:11c34137-56ed-d28e-1806-59556d6ee7ab
msgctxt "h49d0ab66gdefcg43d4gbd1agf42b019b90f9"
msgid "He already has."
msgstr "이미 주셨는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 151562af-75c2-9098-85e2-39aafb5e54b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:151562af-75c2-9098-85e2-39aafb5e54b4
msgctxt "h9174c178g5ea4g454ega3dcgdcef2839c71a"
msgid "Those who walk a tranquil path want for nothing. Keep your 'blessings'."
msgstr "평온한 길을 걷는 자는 아무것도 원하지 않습니다. 축복은 사양하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 18ff7611-f615-62e3-bec8-7ce9b2708e37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_TakingIsobel_PlayerWarnedIsobel = False
#.      - HAV_EnteringHaven_Knows_FlamingFistIsSpy = True
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithSpy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:18ff7611-f615-62e3-bec8-7ce9b2708e37
msgctxt "hfbaa77e3g72d1g4d0fga858ge9b490716f2d"
msgid "Come with us or I rip your arms off, Isobel."
msgstr "따라오지 않으면 팔을 뽑아버리겠어, 이소벨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 1d0fea6a-e6af-e53e-75ae-d2c75c95d4fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:1d0fea6a-e6af-e53e-75ae-d2c75c95d4fd
msgctxt "h40cd0b50g41adg4d12gaefcgf89b29b8e40d"
msgid "You - you're one of <i>them</i>, aren't you?"
msgstr "너, 너도 <i>저들</i>과 한통속이로군, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 25e25c22-af20-4173-ed3e-6f791a35c071
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:25e25c22-af20-4173-ed3e-6f791a35c071
msgctxt "hcb36edb2g57eeg46b3g90ceg0c6708ff606e"
msgid "He is not 'blessed' - he is corrupted. Unnatural."
msgstr "그는 축복받은 게 아니에요. 타락한 겁니다. 괴이하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 26df8232-d093-606c-da75-60ec608e35be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithSpy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:26df8232-d093-606c-da75-60ec608e35be
msgctxt "h51bb2999g34cag4926gb91bg239a39e78ac9"
msgid ""
"Marcus is going to help me finish what I came here to do - bring you to "
"Ketheric at Moonrise Towers."
msgstr "마커스는 이곳에서의 내 임무를 거들어 줄 거다. 널 문라이즈 타워의 케서릭 앞으로 데려가는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 2b6b9430-a82f-6a8c-0f7a-a9973b9b3cf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:2b6b9430-a82f-6a8c-0f7a-a9973b9b3cf4
msgctxt "h3b1d9e21ge142g468eg8704g8db1afc17696"
msgid ""
"I've been blessed. You can be too. Come with me and you can hear it all from "
"Ketheric himself."
msgstr "저는 축복받았습니다. 당신도 저처럼 될 수 있단 말입니다. 같이 가시죠. 케서릭 님이 모든 것을 말씀해주실 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 34241942-619f-437a-16f1-950d1f14beb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:34241942-619f-437a-16f1-950d1f14beb0
msgctxt "h4accca23g4b65g4f6egb5f2gea18d3724262"
msgid "I say we follow the winged freak."
msgstr "날개 달린 괴물을 따라갑시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 3678900b-8374-94c8-986d-753a0a563bc7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = False
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Knows_SpyOrderedByKetheric = True
#.     - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:3678900b-8374-94c8-986d-753a0a563bc7
msgctxt "ha63584c2g711ag45e6ga423g73e15d13bff5"
msgid ""
"<i>True Soul. My instructions are clear: take the girl to Ketheric.</i> "
"Alive."
msgstr "<i>참된 영혼. 나의 지시는 명료합니다. 그 여자를 케서릭 님에게 데려가세요.</i> 살려서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 379e519b-9304-49e3-297d-91c21ebf5b14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:379e519b-9304-49e3-297d-91c21ebf5b14
msgctxt "hca3b3849gd717g4427g8014g0465f5b6a201"
msgid ""
"You can't believe them, Marcus. Ketheric will never give you whatever it is "
"you've been promised."
msgstr "놈들을 믿어선 안 돼, 마커스. 당신에게 약속한 게 무엇이든 케서릭은 절대 내주지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 39aacacd-f399-f95b-030e-5822e37753e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_FastTransform = False
#.      - HAV_EnteringHaven_State_FlamingSpyRevealed = False
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:39aacacd-f399-f95b-030e-5822e37753e8
msgctxt "ha0aba4ebg538cg4e08g9361g00dc8cb13d31"
msgid "Isobel, do you know this man?"
msgstr "이소벨, 이 남자를 아세요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 39c52afd-a926-ce79-2816-ace036e42eff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_FlamingSpy_HasMet_Checkpoint(1) = True
#.   Global:
#.      - HAV_TakingIsobel_Event_FastTransform = False
#.      - HAV_EnteringHaven_State_FlamingSpyRevealed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:39c52afd-a926-ce79-2816-ace036e42eff
msgctxt "h84db00aage21fg4903g9a2eg22fda647338e"
msgid "Ah. True Soul. How glad I am to see you again."
msgstr "아, 참된 영혼. 다시 보니 반갑군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 3a802d26-62c1-b00c-d37b-316bae920729
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithSpy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:3a802d26-62c1-b00c-d37b-316bae920729
msgctxt "ha224af56gac5fg4899gbdf6g1cdbf1d0a4ad"
msgid "Just go quietly, Isobel. He doesn't want to hurt you."
msgstr "조용히 가자, 이소벨. 널 해치려는 게 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 3ae970fd-0a85-d75f-ddc7-ac6ed1674333
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_EnteringHaven_TadpoleCheckpoint_RevealedMarcus = False
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:3ae970fd-0a85-d75f-ddc7-ac6ed1674333
msgctxt "h9f9aaa02g1c24g4263g8e85g00730e8a76a7"
msgid "He already has."
msgstr "이미 주셨는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 3f1294e5-cf56-4e1e-1be6-83e57f4fb444
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:3f1294e5-cf56-4e1e-1be6-83e57f4fb444
msgctxt "hc8d89587ge7deg4e0ega562g8890ca4064a7"
msgid ""
"<i>I'm not like you - I don't take orders from the Absolute's cronies.</i>"
msgstr "<i>나는 당신들과 달라요, 절대자 일당의 명령 따위 듣지 않습니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 3f919e10-3d82-e1af-c94b-5b23f47036e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:3f919e10-3d82-e1af-c94b-5b23f47036e3
msgctxt "hc3b29c9bg0943g4620gbcdcgd82e287d712a"
msgid "Time to go, Isobel."
msgstr "갈 시간이다, 이소벨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 41890564-b9c8-619a-8315-abb9f0c1a955
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:41890564-b9c8-619a-8315-abb9f0c1a955
msgctxt "h56e7a111gda36g48aegabf8g84ddad36dba7"
msgid ""
"Pathetic. The Absolute sees all - your treachery <i>will</i> be punished!"
msgstr "한심하군! 절대자님은 모든 것을 보고 계십니다. 당신의 변절은 심판에 처해질 것입니다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Narrator
#. NodeID = 42d2f1fd-0361-d584-13cf-3b560bf4d105
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:42d2f1fd-0361-d584-13cf-3b560bf4d105
msgctxt "h91e92404ge60cg4d66g8138g1b5a87d1aa1f"
msgid ""
"*This is a dear moment to play the reaper you play so well. Why let him take "
"her alive, when you could flood them both with a bloodbath?*"
msgstr "*둘째 가라면 서러운 죽음의 사신 연기를 선보일 기회입니다. 둘 다 핏빛으로 물들일 수 있는데, 왜 그의 말에 따라야 할까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 464fbc80-463d-d6ca-2316-68da39c65a54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SidedWithSpy = False
#.   Tag:
#.      - FEMALE(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:464fbc80-463d-d6ca-2316-68da39c65a54
msgctxt "h5b7e7989gff95g4184g9d80gb33fe5559a01"
msgid "What in the world is going on?!"
msgstr "대체 무슨 일이 벌어지고 있는 거야?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 4676c0b1-ebdd-f917-b826-2d8d35fbf721
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - HAV_TakingIsobel_UserShortcut_FlamingSpy(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:4676c0b1-ebdd-f917-b826-2d8d35fbf721
msgctxt "h2a554274g3600g4507g9871gda6eed32ec5a"
msgid "<i>Remember: Ketheric wants her </i>alive<i>.</i>"
msgstr "<i>잊지 말아라: 케서릭 님 께서 </i>산 채로<i> 대려오라 하셨다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 478ac198-e69e-59b5-3a82-a48e53bb4d17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_FastTransform = False
#.      - HAV_EnteringHaven_State_FlamingSpyRevealed = False
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:478ac198-e69e-59b5-3a82-a48e53bb4d17
msgctxt "hf85c2ed9g366ag4fa0gbf4egfc66a97dd16e"
msgid "Hello, Isobel."
msgstr "안녕하십니까, 이소벨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 47c0fc14-369e-7ad2-8dd5-79bf002fb336
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:47c0fc14-369e-7ad2-8dd5-79bf002fb336
msgctxt "hcf10ee33gf943g4f63gb769g2de6f95ec33e"
msgid "What's going on? If you have something to say, say it."
msgstr "무슨 일이죠? 말할 게 있다면, 말해요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 49dde985-c64e-36d9-3fe9-d970e67075ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_TakingIsobel_PlayerWarnedIsobel = False
#.      - HAV_EnteringHaven_Knows_FlamingFistIsSpy = True
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_HAV_TakingIsobel_PlayerWarnedIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:49dde985-c64e-36d9-3fe9-d970e67075ab
msgctxt "h36d15d1cg37afg4814gb255ga8959dd34980"
msgid "Deception. Bah. Cut the act and let's <i>fight</i>, True Soul."
msgstr "속임수라니, 흥. 연극은 그만두고 <i>싸우자고</i>, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 55266fcd-36b1-1996-214b-d681f800b646
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:55266fcd-36b1-1996-214b-d681f800b646
msgctxt "h9a7ce2a4g79f5g493fg8c91g52ea49818e1b"
msgid ""
"Marcus is trying to kidnap you, Isobel. We're going to need to fight our way "
"out of this one."
msgstr "마커스가 당신을 납치하려 합니다, 이소벨. 이 상황을 타파하려면 싸워야 해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 5571410c-795c-d3af-2452-ed750c96d9c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:5571410c-795c-d3af-2452-ed750c96d9c6
msgctxt "h5f9f7f80ge9a0g4d27g8743g5d875c3994ef"
msgid ""
"What fools you both are. Ketheric will never give you whatever it is he's "
"promised you."
msgstr "너희 둘 다 어리석기 짝이 없군. 뭘 약속했든 케서릭은 절대 내주지 않을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = GROUP_ACT2_HAV_FlamingSpyTransformHarpers
#. NodeID = 564474a9-9595-6b2c-5a23-9d5c5790c373
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ACT2_HAV_HARPER2(3) = True
#. SetFlags:
#.   Object:
#.     - HAV_TakingIsobel_Event_IncludeAbductees(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:564474a9-9595-6b2c-5a23-9d5c5790c373
msgctxt "h41eb39d2g4301g46d1g9578g9ef0836d6e26"
msgid "Harpers! To arms!"
msgstr "하퍼들이여! 무기를 들어라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 5ccb70a2-543b-3701-782a-98ed1c52c662
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:5ccb70a2-543b-3701-782a-98ed1c52c662
msgctxt "h6826efb8g319fg4122gbe16ga610536a1910"
msgid ""
"<i>I don't know what your game is, but you can still redeem yourself if you "
"follow my lead.</i>"
msgstr "<i>무슨 꿍꿍이 인지는 모르겠지만, 내 명령을 따른다면 아직 돌이킬 수 있다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 640ca33e-e5fc-2951-dd12-c86d043784b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:640ca33e-e5fc-2951-dd12-c86d043784b9
msgctxt "hdf640bbfgbc3bg489fg85a7gdb67557744b9"
msgid "He means you no harm, Isobel."
msgstr "그분은 절대 널 해할 생각이 없어, 이소벨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 661c56ee-8efc-d35b-a874-18a2372202e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Event_MarcusToBalcony = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:661c56ee-8efc-d35b-a874-18a2372202e7
msgctxt "he89d1ab2ge61cg475dg932ag7b35ab3cf686"
msgid "<i>Let's do this. Remember: Ketheric wants her </i>alive<i>.</i>"
msgstr "<i>시작합시다. 명심하시오. 케서릭 님은 그녀가 </i>살아있기를<i> 바랍니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 6dbbf283-daf2-534c-44d4-dcc2a661ef5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:6dbbf283-daf2-534c-44d4-dcc2a661ef5a
msgctxt "h85b73185g0f13g4208gaccegcc1a026fef4e"
msgid ""
"I'm not working for you, Marcus. My patron's deals are <i>much</i> more "
"lucrative."
msgstr "난 네 뜻대로 움직이지 않아, 마커스. 내 후원자가 제안하는 계약이 <i>훨씬</i> 더 나한테 유익하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 6fe54b47-3c7d-d928-c03e-dd14bcb45110
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:6fe54b47-3c7d-d928-c03e-dd14bcb45110
msgctxt "h1ccc70bcgc974g47b0g96fdgfa0994719b14"
msgid "Enough, Marcus. We aren't going anywhere."
msgstr "그만. 마커스. 우린 아무 데도 가지 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 7398dd62-f519-bc8f-77ce-34d210ea253b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_FastTransform = False
#.      - GLO_HAV_TakingIsobel_PlayerWarnedIsobel = False
#.      - HAV_EnteringHaven_State_FlamingSpyRevealed = False
#.      - HAV_TakingIsobel_State_FlamingSpyOnBalcony = False
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:7398dd62-f519-bc8f-77ce-34d210ea253b
msgctxt "h07c19527gb3d8g48f3g874cg3ab9771584ad"
msgid ""
"Isobel - I've just gotten word. I need you to come with me. Jaheira's orders."
msgstr "이소벨. 나도 방금 전달받았어. 나랑 같이 가야 해. 자헤이라의 명령이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 7790aaf7-64c2-1652-b4b6-6852930c3b13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_HavenOutcasts_State_FlamingFistsInHaven = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:7790aaf7-64c2-1652-b4b6-6852930c3b13
msgctxt "hd7ba0496g31f1g4df1g92ceg52f7925aeb4d"
msgid ""
"He's a Flaming Fist - or was. Came with the others when we created this "
"haven."
msgstr "플레이밍 피스트에요. 지금은 아닌 것 같지만. 우리가 이 피난처를 만들 때 다른 이들과 같이 왔죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 7894bb8b-6c94-52ea-9b4b-14bcde27f09d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:7894bb8b-6c94-52ea-9b4b-14bcde27f09d
msgctxt "hf60376fagc5ebg4364gbe66g4fd1abc35966"
msgid ""
"<i>We are all alike in Her service. Do as I say. The rewards will be "
"great.</i>"
msgstr "<i>우리는 모두 <b>그분</b>의 자애 앞에 평등합니다. 제 말대로 하세요. 막대한 보상이 주어질 것입니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 7bfc83d5-b703-3103-f590-d8a21e3801d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:7bfc83d5-b703-3103-f590-d8a21e3801d7
msgctxt "h5e5490d9g4270g49aega2a5gf4d5e81dfbed"
msgid ""
"PLEASE RECORD (roar, not words):  Great roar that summons a load of ghouls "
"into the camp."
msgstr "<i><b>우어어어어어어!!!</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = GROUP_ACT2_HAV_FlamingSpyTransformHarpers
#. NodeID = 8035fa7c-2eda-f66d-d678-132eda29091a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ACT2_HAV_HARPER1(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:8035fa7c-2eda-f66d-d678-132eda29091a
msgctxt "h420ebabeg7bacg42cfg827dge93684f7fba7"
msgid "Protect Isobel! Without her, we're all dead."
msgstr "이소벨을 보호해라! 그녀 없이는 우린 다 죽은 목숨이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 81865cdf-66dc-0662-1402-0f39735536ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = False
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithSpy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:81865cdf-66dc-0662-1402-0f39735536ed
msgctxt "h82815f5agf1e5g43edg8109g8f1585d23f3a"
msgid "You're going to meet Ketheric - face-to-face."
msgstr "넌 케서릭 님을 알현하게 될 거야. 얼굴을 마주하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 825e011b-5c3e-ff12-d443-3ec6bce4c681
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_IsobelKnowsAboutSpy = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:825e011b-5c3e-ff12-d443-3ec6bce4c681
msgctxt "hd5807a2eg7a51g4391g97d9g979a30d00ab6"
msgid "Too late for that, Marcus. I already warned Isobel."
msgstr "그러기엔 이미 늦었어, 마커스. 이미 이소벨에게 말해줬거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 84c93e08-b6c6-1e65-bd07-1ffcbaaf7e15
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:84c93e08-b6c6-1e65-bd07-1ffcbaaf7e15
msgctxt "hd0d9383cga3c9g42b8gaa9dg0f3be794d472"
msgid "We're going to have to fight our way out of this one, Isobel."
msgstr "이 상황에서 벗어나려면 놈을 물리쳐야 해, 이소벨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 8c9f34a3-bbc0-e2dc-809a-bd848465842a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:8c9f34a3-bbc0-e2dc-809a-bd848465842a
msgctxt "hd08c2960gecd6g47a1g9233g861a23d4e904"
msgid ""
"No, True Soul. Do not harm her. My instructions were clear: we must take the "
"girl to Ketheric <i>alive</i>."
msgstr "안돼, 참된 영혼. 그녀를 해하지 마라. 지시 사항은 명료하다. 그녀를 <i>살려서</i> 케서릭 님께 데려가야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 8d4ea0eb-6b3a-3556-951a-fe762ebd06d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:8d4ea0eb-6b3a-3556-951a-fe762ebd06d9
msgctxt "he29ce6fegb671g4857g9b1eg11e19710ab3b"
msgid "You two... You're... you're like <i>them</i>, aren't you? Absolutists."
msgstr "당신 둘... 당신들... <i>그들</i>과 같군요, 그렇지 않나요? 절대자의 광신도들."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 9049d2c0-9703-c4f3-cb47-ba0a9a2013b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_FastTransform = False
#.      - GLO_HAV_TakingIsobel_PlayerWarnedIsobel = True
#.      - HAV_EnteringHaven_State_FlamingSpyRevealed = False
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:9049d2c0-9703-c4f3-cb47-ba0a9a2013b8
msgctxt "hf18490dcgfb6dg4fd1gb99egcf9a137d2e91"
msgid "Thanks for the introduction."
msgstr "소개해 줘서 고맙군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 908b4afe-e418-6c32-9c2a-2adc65bbd0ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:908b4afe-e418-6c32-9c2a-2adc65bbd0ac
msgctxt "h39b3f2edg48cag47b9gb167g5d92910f67ec"
msgid "I'd rather die."
msgstr "차라리 죽겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = 91982b6e-a139-325d-deaf-fe0dbcdb566b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:91982b6e-a139-325d-deaf-fe0dbcdb566b
msgctxt "hd13be726g1d90g4e00gb363g178fa408efd9"
msgid "Marcus - is that you? What's happened to you?"
msgstr "마커스, 당신이에요? 무슨 일이 있었던 거죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 933d6fad-f618-6a20-a8eb-ac59274c5ed4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - HAV_TakingIsobel_UserShortcut_FlamingSpy(1) = False
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Knows_SpyOrderedByKetheric = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:933d6fad-f618-6a20-a8eb-ac59274c5ed4
msgctxt "h3a3f3880gd3f3g43bag8831g6533eea72c67"
msgid "<i>My instructions are clear: take the girl to Ketheric.</i> Alive."
msgstr "<i>지시 사항은 명확해. 이소벨을 케서릭에게 대령할 것.</i> 산 채로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = 96bee244-4252-a111-a282-906ce6efd47d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAV_TakingIsobel_Event_IncludeAbductees(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:96bee244-4252-a111-a282-906ce6efd47d
msgctxt "hd8f0c42fg8ff7g4d76gb9bcg1512269a4fe2"
msgid "<i>Remember: Ketheric wants her </i>alive<i>. No matter what.</i>"
msgstr "<i>기억해라, 케서릭께선 그녀를 </i>생포해 오길<i> 원하신다. 무슨 일이 있더라도.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 973da376-ceff-bba6-751c-783907779fe0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithSpy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:973da376-ceff-bba6-751c-783907779fe0
msgctxt "h34a2d405g218cg4509g9d74gf56c2e2c5abd"
msgid "No time to waste - we should follow Marcus."
msgstr "시간이 없어. 마커스를 따라가야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 98b82a21-9a15-7057-241a-2b07c588005e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:98b82a21-9a15-7057-241a-2b07c588005e
msgctxt "h3619906eg0defg404agb7d9g4500acee9c0a"
msgid ""
"This man has been corrupted by the sickness infecting this land. Do not "
"trust him, Isobel."
msgstr "이 자는 이 땅에 퍼진 병에 오염됐어. 믿으면 안 돼, 이소벨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = 9a3d8c62-df85-afe8-8b95-e08799174fbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Event_SummonZevlor = True
#.     - HAV_TakingIsobel_State_SidedWithSpy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:9a3d8c62-df85-afe8-8b95-e08799174fbe
msgctxt "h0584aeaega700g4b04g80c8gd6f711ebc6cd"
msgid "<i>I know. Let's do this.</i>"
msgstr "<i>알겠습니다. 한번 해보죠.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Narrator
#. NodeID = 9cb52fb2-6fc9-e327-c95e-ee649f7cd0c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:9cb52fb2-6fc9-e327-c95e-ee649f7cd0c8
msgctxt "h359cf7a5ga0d0g4ecfg8bb9g9b01003a3a4d"
msgid ""
"*With Isobel dead, the whole sanctuary will be flooded with blood... A "
"<i>far </i>finer future than her taken alive.*"
msgstr "*이소벨이 죽으면, 이 성역 전체가 피로 물들 겁니다... 그녀를 생포해 가는 것보다 <i>훨씬</i> 근사한 미래입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Narrator
#. NodeID = a324c884-4f39-24a0-c67c-1a2683da4886
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:a324c884-4f39-24a0-c67c-1a2683da4886
msgctxt "h82fbdf89gf64fg4c44ga0f3g9df4894adebe"
msgid ""
"*The man's mind burns with empty ecstasy, utterly enslaved by the Absolute. "
"You can sense nothing else.*"
msgstr "*남자의 마음은 텅 빈 황홀감에 불타고 있으며, 절대자에게 완전히 사로잡혔습니다. 다른 어떤 것도 느껴지지 않습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = a49cc49b-eaa5-2792-685d-dffb44864fd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:a49cc49b-eaa5-2792-685d-dffb44864fd5
msgctxt "hd1092e48gef29g4620g9eb7g3ebbbaab719e"
msgid "<i>The Absolute. </i>Of course."
msgstr "<i>절대자.</i> 물론 그러시겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = a5beb9a4-58ee-3e20-264b-707515d7d012
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:a5beb9a4-58ee-3e20-264b-707515d7d012
msgctxt "h416f2eadgb1e7g415egbe17gfae4caa91939"
msgid "<i>What does he want with her?</i>"
msgstr "<i>그가 그녀에게 뭘 원하는 거죠?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Mol
#. NodeID = ab96df78-c70d-419d-bf22-83569c4deb1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMANOID(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:ab96df78-c70d-419d-bf22-83569c4deb1f
msgctxt "he38b3640g633eg412aga1f0g9aa79453f4dd"
msgid "Let go of me!"
msgstr "이거 놔!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = abc1da80-0ba7-26e4-5507-42bb10d45979
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_HavenOutcasts_State_FlamingFistsInHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:abc1da80-0ba7-26e4-5507-42bb10d45979
msgctxt "h64455fcbg2b99g44b8g9782g5f399745d02a"
msgid ""
"He's a Flaming Fist - or was. Came with the others when we created this "
"haven."
msgstr "그는 플레이밍 피스트에요. 혹은, 그랬던 사람. 우리가 이 피난처를 만들 때 다른 이들과 같이 왔죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = bd998e94-958b-9069-750d-a38d1391d0ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithSpy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:bd998e94-958b-9069-750d-a38d1391d0ec
msgctxt "h727c836fge377g479dgbf9bg19b231467a52"
msgid "You're going to meet Ketheric - face-to-face."
msgstr "넌 케서릭 님을 알현하게 될 거야. 얼굴을 마주하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = c5b999d5-993d-c2f0-2bbc-c4dbc879d630
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_State_SidedWithSpy = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:c5b999d5-993d-c2f0-2bbc-c4dbc879d630
msgctxt "h32792224g8d98g470dg8e79g3af799fdee68"
msgid "Moonmaiden, guide my hand!"
msgstr "달처녀시여, 제 손을 잡아 이끄소서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = cc00bbdc-7dad-afa6-7606-70ff8b0c780d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:cc00bbdc-7dad-afa6-7606-70ff8b0c780d
msgctxt "he4dc0286g823bg4f37gab88gc515a994c16a"
msgid ""
"You have not known tranquillity until you have felt the Absolute's embrace. "
"That I can promise you."
msgstr "절대자의 품에 안기기 전까진 진정한 평온이 무엇인지 알 수 없어요. 제가 보증하죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = cf78a4cb-2726-2bc2-a105-2eee8a068acf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:cf78a4cb-2726-2bc2-a105-2eee8a068acf
msgctxt "h2c7c1b31g6130g4634gadc5g33a0ce40bd5f"
msgid "It would be your doom. And mine."
msgstr "그건 당신에게 파멸이 될 거예요. 나에게도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = e116d22f-5fa6-ba8a-7ad4-9f4682919237
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:e116d22f-5fa6-ba8a-7ad4-9f4682919237
msgctxt "h4c0e8666g2d8fg4049g83dcgd32d88986d3a"
msgid ""
"The feeling isn't mutual. Ketheric is a liar, Marcus. He'll never give you "
"whatever it is he's promised you."
msgstr ""
"놈은 그럴 지 몰라도 난 아냐. 케서릭은 거짓말쟁이야, 마커스. 당신한테 약속한 게 뭔지는 모르겠지만, 그건 절대 받을 수 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = e6dc6d72-04b9-645a-849a-dc1d61f78612
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Knows_SpyExplainedHisMission = False
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Knows_SpyOrderedByKetheric = True
#.     - HAV_TakingIsobel_Event_MarcusToBalcony = False
#.     - HAV_TakingIsobel_Knows_SpyExplainedHisMission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:e6dc6d72-04b9-645a-849a-dc1d61f78612
msgctxt "h005e4660g44c8g48c5ga54ag4a24e4825d76"
msgid ""
"<i>True Soul. My instructions are clear: take the girl to Ketheric.</i> "
"Alive."
msgstr "<i>참된 영혼. 지시 사항은 명료합니다. 여자를 케서릭 님에게 데려가야 하오.</i> 산 채로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = effe62c6-4e77-8b98-eb93-958c409b2501
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_FlamingSpy_HasMet_Checkpoint(1) = False
#.   Global:
#.      - HAV_TakingIsobel_Event_FastTransform = False
#.      - HAV_EnteringHaven_State_FlamingSpyRevealed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:effe62c6-4e77-8b98-eb93-958c409b2501
msgctxt "h07bfeffag98e5g4517g85cdgecda04708e76"
msgid "Ah, another True Soul. How glad I am to see you."
msgstr "아, 또 다른 참된 영혼. 만나게 돼서 정말 반갑군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = f0e6ea5d-ff7a-3c42-e8ad-b671fe00c068
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_HAV_TakingIsobel_PlayerWarnedIsobel = False
#.      - HAV_EnteringHaven_Knows_FlamingFistIsSpy = True
#. SetFlags:
#.   Global:
#.     - GLO_HAV_TakingIsobel_PlayerWarnedIsobel = True
#.     - HAV_TakingIsobel_State_SidedWithIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:f0e6ea5d-ff7a-3c42-e8ad-b671fe00c068
msgctxt "hb6f17aa1g844bg4f91gb42dg8733c8644a87"
msgid "Marcus is a True Soul, Isobel. He's here to kidnap you."
msgstr "마커스는 참된 영혼이야, 이소벨. 널 납치하려고 여기까지 왔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Narrator
#. NodeID = f1dccee8-4de2-4538-5ccd-e11a83e7ea75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:f1dccee8-4de2-4538-5ccd-e11a83e7ea75
msgctxt "he481b5f1g59b2g42b4g9c4bg89f2cf36bcf8"
msgid ""
"*A haunting face swims into your mind's eye, its instructions vivid in your "
"mind: nothing is more important than bringing the girl - alive.*"
msgstr "*섬뜩한 얼굴이 마음의 눈 앞에 넘실거리며, 뚜렷한 지시가 떠오릅니다: 여자를 살려서 데려가는 것보다 중요한 것은 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = f441f176-d4ce-9075-1a1a-127882177806
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:f441f176-d4ce-9075-1a1a-127882177806
msgctxt "hb50719e7gce51g42f7g9342g802383885726"
msgid "Pathetic. The Absolute sees all, you fool."
msgstr "한심하군. 절대자께선 모든 걸 보신다, 이 멍청한 것."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Isobel
#. NodeID = f45fd1fd-11b2-fb41-2c7c-3f803b0eae48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:f45fd1fd-11b2-fb41-2c7c-3f803b0eae48
msgctxt "h9f4d2744g179cg4f29ga7ccg95f392718614"
msgid "Not a step closer, Marcus. I'm warning you."
msgstr "가까이 오지마, 마커스. 경고야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = f51b65ec-1156-0a12-8414-c919027435cd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:f51b65ec-1156-0a12-8414-c919027435cd
msgctxt "hb39ba4b0g2b5dg43f0ga44eg98a39b2a4f1c"
msgid "<i>Probe his thoughts for more information.</i>"
msgstr "<i>더 많은 정보를 위해 그의 생각을 들여다본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = f8aed9c2-a3ba-0c69-33b0-0c447f896930
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithSpy = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:f8aed9c2-a3ba-0c69-33b0-0c447f896930
msgctxt "hcb050d05g5d66g4986gaf24g613aa7dbe368"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = f99ec87c-0aba-4f07-41c6-99ef344b1ffb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:f99ec87c-0aba-4f07-41c6-99ef344b1ffb
msgctxt "h4eab0f9fg2c0cg473ag8f73gccd7a2ab9ffd"
msgid "<i>Touch her and I'll kill you.</i>"
msgstr "<i>그녀를 건드리면 죽여버리겠어.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Fist Marcus
#. NodeID = fd7a3ea8-8700-2171-c58d-b1f90e011a38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TakingIsobel_Event_FastTransform = False
#.      - GLO_HAV_TakingIsobel_PlayerWarnedIsobel = False
#.      - HAV_EnteringHaven_State_FlamingSpyRevealed = False
#.      - HAV_TakingIsobel_State_FlamingSpyOnBalcony = True
#.      - HAV_EnteringHaven_State_FlamingSpyVouch = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_Event_MarcusToBalcony = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:fd7a3ea8-8700-2171-c58d-b1f90e011a38
msgctxt "h03c0ea80gb6d2g46bbg98efg20c034e07b10"
msgid ""
"Isobel - I've just gotten word. I need you to come with me. Jaheira's orders."
msgstr "이소벨. 나도 방금 전달받았어. 나랑 같이 가야 해. 자헤이라의 명령이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = fdf433c8-3393-d8f0-642d-f6e92e8457c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_TakingIsobel_State_SidedWithIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:fdf433c8-3393-d8f0-642d-f6e92e8457c2
msgctxt "h6d0a284bge6c6g4336gba5bge4de5adf71dd"
msgid ""
"It's an ambush - and not a particularly clever one. Time to fight, I think."
msgstr "기습이다. 별로 교묘하지는 못하지만. 아마도 싸울 시간인 것 같다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture
#. Speaker = Player
#. NodeID = fe3bdfa9-0ed6-44e5-d901-399eb8cbfb35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Event_AskedToKidnapIsobel = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TakingIsobel_SpyCapture:fe3bdfa9-0ed6-44e5-d901-399eb8cbfb35
msgctxt "h34c25fcdg5d26g42c2ga744g7b57324e4738"
msgid ""
"Looks like this guy is trying to take my job - bringing you to Ketheric at "
"Moonrise Towers."
msgstr "보아하니 이 남자가 내 일을 대신하러 왔군요. 당신을 케서릭에게 데려가는 일."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingDismissesHalsin
#. Speaker = Narrator
#. NodeID = 5d2dffb7-edf1-4b33-8ec9-d92c4bb6f6ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingDismissesHalsin:5d2dffb7-edf1-4b33-8ec9-d92c4bb6f6ef
msgctxt "h6d3e2e3dg8e5fg4ddfg9e5bgf34104a3465e"
msgid ""
"*Still rattled by what happened at the Emerald Grove, they'll need time to "
"recover before they'll be ready to talk.*"
msgstr "*아직도 에메랄드 숲에서 일어난 일 때문에 덜덜 떨고 있습니다. 대화가 가능한 상태가 될 때까지 추스를 시간이 필요합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_AD_Mattis
#. Speaker = Mattis
#. NodeID = b00c79b9-7c9e-b0a3-4b8f-24ebb1e1dffa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_A = False
#.      - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_B = False
#. SetFlags:
#.   Local:
#.     - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_A = True
#.     - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_AD_Mattis:b00c79b9-7c9e-b0a3-4b8f-24ebb1e1dffa
msgctxt "h9ccc1740g0975g4244g9eaag4ae8c1f8fce0"
msgid "Premium trinkets and doodahs!"
msgstr "고급 장신구랑 이것저것 있어요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_AD_Mattis
#. Speaker = Mattis
#. NodeID = e12cc665-f7d3-c595-619a-72b623ec8d3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_A = True
#.      - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_B = False
#. SetFlags:
#.   Local:
#.     - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_A = True
#.     - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_AD_Mattis:e12cc665-f7d3-c595-619a-72b623ec8d3c
msgctxt "h9c47bbdbgb191g4317gabd9gd5b1b00ab2bb"
msgid "Last Light's best bargains, right here."
msgstr "최후의 빛의 최고 특가 상품을 바로 여기서 만나보세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_AD_Mattis
#. Speaker = Mattis
#. NodeID = e276087c-9da4-75d7-52b2-7e3d5fae3029
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_A = True
#.      - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_B = True
#. SetFlags:
#.   Local:
#.     - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_A = False
#.     - 0d4d7cd3-5055-29a4-6bbd-e15fdf434e7a_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_AD_Mattis:e276087c-9da4-75d7-52b2-7e3d5fae3029
msgctxt "h7cc236efgd807g4ecdgab01g5dbf8c29ac90"
msgid "Don't be shy, have a gander at the finest stock!"
msgstr "부끄러워하지 마시고 최고급 상품을 둘러보세요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_AD_PlayerFoundTreasure_MirkonsComment
#. Speaker = Mirkon
#. NodeID = 9c40c98f-d405-92e8-254c-4a62510fb5b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_AD_PlayerFoundTreasure_MirkonsComment:9c40c98f-d405-92e8-254c-4a62510fb5b4
msgctxt "ha00adad8g7ef3g465cga7b1g069c71a49f8a"
msgid "I missed that! <i>Awesome.</i>"
msgstr "그건 못봤는데! <i>짱이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_AD_PlayerFoundTreasure_UmisComment
#. Speaker = Umi
#. NodeID = 48a0725c-c674-4a30-b5db-51f97bc7dba6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_AD_PlayerFoundTreasure_UmisComment:48a0725c-c674-4a30-b5db-51f97bc7dba6
msgctxt "h53bae690g557bg4292gbf60ga4ee299554c1"
msgid "Aw, I should've checked there!"
msgstr "아, 거기도 한 번 찾아볼 걸 그랬네!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Mattis
#. NodeID = 28c36544-02aa-ce70-4c5f-fccccce7aade
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:28c36544-02aa-ce70-4c5f-fccccce7aade
msgctxt "he7e377b5g2829g410bgab12g17e0b64d5cbe"
msgid ""
"Look at her - she's a proper adventurer. And if we got hurt Mol would be "
"<i>really </i>mad at us."
msgstr "저 사람 좀 봐, 딱 적절한 모험가잖아. 그리고 우리가 다치기라도 하면 몰이 <i>진짜</i> 화를 낼 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Mattis
#. NodeID = 28c36544-02aa-ce70-4c5f-fccccce7aade
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:28c36544-02aa-ce70-4c5f-fccccce7aade
msgctxt "h9121c44cgc215g4a8dg8781gc9c2188b575d"
msgid ""
"Look at him - he's a proper adventurer. And if we got hurt Mol would be "
"<i>really </i>mad at us."
msgstr "저 사람 좀 봐, 딱 적절한 모험가잖아. 그리고 우리가 다치기라도 하면 몰이 <i>진짜</i> 화를 낼 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Mattis
#. NodeID = 28c36544-02aa-ce70-4c5f-fccccce7aade
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:28c36544-02aa-ce70-4c5f-fccccce7aade
msgctxt "h323e75e5gec0bg4566g9cccg93580c4d2f5b"
msgid ""
"Look at them - they're a proper adventurer. And if we got hurt Mol would be "
"<i>really </i>mad at us."
msgstr "저 사람 좀 봐, 딱 적절한 모험가잖아. 그리고 우리가 다치기라도 하면 몰이 <i>진짜</i> 화를 낼 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Mirkon
#. NodeID = 2b9dd34d-26aa-3153-6ecc-152029b504d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:2b9dd34d-26aa-3153-6ecc-152029b504d6
msgctxt "h9f0c02bbg42d6g45abga4f2g9b6c75359b4c"
msgid ""
"We could! I beat up those harpies and they're way scarier than <i>shadows. "
"</i>"
msgstr "싸울 수 있어! 난 저번에 <i>그림자</i>보다 훨씬 더 무서운 하피들을 때려 눕혔다구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Mattis
#. NodeID = 3807171f-6ef1-91aa-1529-ae503e8a5115
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TieflingSurvivors_State_DidNotPromiseToSaveMol = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:3807171f-6ef1-91aa-1529-ae503e8a5115
msgctxt "hb96d6c10gee06g46bbga8a6g1fc4f1e64766"
msgid "You don't know what you're talking about - Mol's a survivor."
msgstr "누구 얘길 하는지 모르시나 보는데요, 몰은 생존자라고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Mattis
#. NodeID = 75747d8f-5ce7-3809-c5ba-75c7fc29d5f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:75747d8f-5ce7-3809-c5ba-75c7fc29d5f5
msgctxt "hca4f5ea7g469bg4f41g82bag8e4cb517c51c"
msgid "You've seen what's out there. We wouldn't stand a chance."
msgstr "저 밖에 뭐가 있는지 봤잖아. 우리에겐 승산이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Player
#. NodeID = 84a7514b-8364-0102-d20a-1dd6f31d444f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:84a7514b-8364-0102-d20a-1dd6f31d444f
msgctxt "h14b47f5dg9eb9g4762g8063g9fa7f727fb50"
msgid "She's probably dead already."
msgstr "몰은 아마도 이미 죽었을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Ide
#. NodeID = 8c5524e0-74d1-25c8-5cea-dccb51c48c4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:8c5524e0-74d1-25c8-5cea-dccb51c48c4a
msgctxt "hd9f5b9b4gef7eg4e8eg97a7g58a4b1d644e6"
msgid "She's the best kind of family - one we got to pick ourselves."
msgstr "몰은 최고의 가족이에요. 우리가 직접 골랐거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Player
#. NodeID = 8ed1f671-a5a6-fc61-30cf-ee2748aaa974
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:8ed1f671-a5a6-fc61-30cf-ee2748aaa974
msgctxt "h53b5b750gfa96g45baga14fgfb48a5c997e9"
msgid "You stay put - I'll bring Mol home."
msgstr "너흰 가만히 있어. 내가 몰을 집으로 데려올게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Ide
#. NodeID = 91310a51-e2ec-4933-4ce5-57f28e32fa6b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TieflingSurvivors_State_PromisedToSaveMol = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:91310a51-e2ec-4933-4ce5-57f28e32fa6b
msgctxt "h0e28995egaf52g4385g9c40g93413b4722cd"
msgid "But it's <i>our</i> job to bring Mol back."
msgstr "하지만 몰을 데려와야 하는 건 <i>우리</i>라고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Ide
#. NodeID = a844b027-4b42-9a3a-5c50-8ec5c6bad4cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:a844b027-4b42-9a3a-5c50-8ec5c6bad4cc
msgctxt "h4047c68fg68fbg4b63gab73g87743c113963"
msgid "We'll see her again. She's twice the hero you'll ever be."
msgstr "우린 몰을 다시 볼 거예요. 몰은 당신보다 두 배는 더 영웅답다고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Mattis
#. NodeID = a8cb93fa-042a-607f-b89a-754d5dc3dce5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:a8cb93fa-042a-607f-b89a-754d5dc3dce5
msgctxt "h493db135gd596g4345gb284g134da7bd4ab9"
msgid ""
"You know what Mol would hate more than anything? Bad things happening to us."
msgstr "몰이 무엇보다 더 싫어할 게 뭔지 알아? 우리한테 나쁜 일이 생기는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Player
#. NodeID = c6fcb343-654a-443f-d4bf-d1cad965a855
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_PLANAR(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:c6fcb343-654a-443f-d4bf-d1cad965a855
msgctxt "h8a69da3cg0c74g419fg81a2gf11d3ecd30e6"
msgid "You seem very close to this Mol. What is the nature of your bond?"
msgstr "몰과 엄청 친한 것 같구나. 뭐가 너희들을 이렇게 끈끈하게 만든 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Player
#. NodeID = c8f1f5cd-eeb4-266c-d7fa-7abef4fcf1f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:c8f1f5cd-eeb4-266c-d7fa-7abef4fcf1f0
msgctxt "h90ef5352g2fc5g4bceg9cd5g44cbd43bc379"
msgid "Mol's resourceful - she'll find her way back."
msgstr "몰은 영리하니까 알아서 돌아올 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Mattis
#. NodeID = e301d757-9f24-459f-4945-02836c884715
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_TieflingSurvivors_State_DidNotPromiseToSaveMol = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:e301d757-9f24-459f-4945-02836c884715
msgctxt "h0bdb31ffge9bcg4e9cg9871gde962577e42a"
msgid ""
"I know she will. But look out for her, would you? Just in case she needs "
"help."
msgstr "저도 그럴 거라 생각해요. 그래도 몰을 찾아주시겠어요, 네? 그 애한테 도움이 필요할지도 모르니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Ide
#. NodeID = e911cbc2-f6aa-fae8-bdfb-01427a31e8d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:e911cbc2-f6aa-fae8-bdfb-01427a31e8d7
msgctxt "h7164a244g2d73g4919gaf4dga142e5a3e40b"
msgid ""
"Fine. But you gotta understand, Mol is <i>family. </i>Bring her back - "
"please."
msgstr "좋아요. 그치만 꼭 알아주세요, 몰은 저희 <i>가족</i>이에요. 제발 그 애를 데려와 주세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Ide
#. NodeID = ece4ccd3-8706-02d4-9d29-83fa90a852a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:ece4ccd3-8706-02d4-9d29-83fa90a852a1
msgctxt "he792497eg48aag4cdbg86cbg25a5943e022c"
msgid "Mol would do the same for any of us. You <i>know</i> it."
msgstr "몰이라면 우리 누구를 위해서라도 똑같이 했을 거야. 너희들도 <i>알잖아</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack
#. Speaker = Umi
#. NodeID = fbcbd3de-5675-a35d-6584-81898a422b1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack:fbcbd3de-5675-a35d-6584-81898a422b1d
msgctxt "h1a5a29f4gc490g4fe9ga2f9gd745db346c18"
msgid "But how do we get into Moonrise? We can't fight those shadow things."
msgstr "그치만 어떻게 문라이즈로 들어갈 건데? 그림자 애들하고 싸울 순 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD
#. Speaker = Ide
#. NodeID = 0e1d6d32-b519-45db-8c21-a3599a52029f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD:0e1d6d32-b519-45db-8c21-a3599a52029f
msgctxt "hc382be13g2dbcg425dg8f1dged9cc382d50a"
msgid "Even if she did, it doesn't matter. Mol needs us."
msgstr "눈치채도 상관없어. 몰이 우리를 필요로 하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD
#. Speaker = Umi
#. NodeID = 359cfe69-d921-8c9f-a8d5-87cd5cc79681
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ae361473-ec6f-a907-7d2b-9d3c0a5cfe54_GreetingB = True
#.      - ae361473-ec6f-a907-7d2b-9d3c0a5cfe54_GreetingA = True
#. SetFlags:
#.   Local:
#.     - ae361473-ec6f-a907-7d2b-9d3c0a5cfe54_GreetingB = False
#.     - ae361473-ec6f-a907-7d2b-9d3c0a5cfe54_GreetingA = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD:359cfe69-d921-8c9f-a8d5-87cd5cc79681
msgctxt "h2990a4a2g7b81g4d5cga38ag9ea4036acae5"
msgid "Why don't we ask Jaheira?"
msgstr "자헤이라한테 물어보는 게 어때? "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD
#. Speaker = Umi
#. NodeID = 4aa95f27-4b2e-4f06-89e6-7aeb9be6884f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD:4aa95f27-4b2e-4f06-89e6-7aeb9be6884f
msgctxt "h3d7dedd0gdf3ag4f38g8dbbgb54f4de6fc2a"
msgid "But we don't even know the way to Moonrise."
msgstr "하지만 우린 문라이즈로 가는 길도 모르잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD
#. Speaker = Mattis
#. NodeID = 4bd9f8aa-b238-43e1-a3ce-f61fa47aeed9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD:4bd9f8aa-b238-43e1-a3ce-f61fa47aeed9
msgctxt "h0e18e01dg57d5g47ecgb18fg1a65f2d010ca"
msgid "It's fine! Jaheira won't even notice we're gone."
msgstr "괜찮다니까! 자헤이라는 우리가 사라진 걸 눈치채지도 못할걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD
#. Speaker = Umi
#. NodeID = 611d6975-a0f6-4ca5-9308-562b07fa87eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ae361473-ec6f-a907-7d2b-9d3c0a5cfe54_GreetingA = True
#. SetFlags:
#.   Local:
#.     - ae361473-ec6f-a907-7d2b-9d3c0a5cfe54_GreetingB = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD:611d6975-a0f6-4ca5-9308-562b07fa87eb
msgctxt "h728d8dc5ge8fbg44b0gaf5eg993f56caa461"
msgid "I don't know, guys."
msgstr "난 잘 모르겠어, 얘들아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD
#. Speaker = Ide
#. NodeID = 7c64ac64-6edd-4c4d-ba92-91ebc37a8c8f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ae361473-ec6f-a907-7d2b-9d3c0a5cfe54_GreetingA = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD:7c64ac64-6edd-4c4d-ba92-91ebc37a8c8f
msgctxt "h55cc81f2gf1bag4226gaf0ag8ab838aea8da"
msgid "Let's just <i>go </i>already."
msgstr "그냥 빨리 <i>가자고</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD
#. Speaker = Umi
#. NodeID = 80e95fec-5ba9-40ec-a084-5ca530600b5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD:80e95fec-5ba9-40ec-a084-5ca530600b5e
msgctxt "h0c24cc3cg4f3eg4c90gad93gbed83659fb3f"
msgid "I know, I know. But we need a <i>plan.</i>"
msgstr "알아, 안다고. 하지만 <i>계획</i>을 세워야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD
#. Speaker = Ide
#. NodeID = 859afc6f-202c-31e4-bfe8-00f546abfa75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD:859afc6f-202c-31e4-bfe8-00f546abfa75
msgctxt "h571798f0gd117g4990gbc36ge2ac552ee2cd"
msgid "Who? No one cares - no one but <i>us.</i>"
msgstr "누구한테? 아무도 신경 쓰지 않는다고. <i>우리</i> 빼곤 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD
#. Speaker = Ide
#. NodeID = db2e78d4-6726-4277-09a5-f52cc0ab02cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD:db2e78d4-6726-4277-09a5-f52cc0ab02cc
msgctxt "ha3f4c23dg0504g4865g91a1gbed359da7137"
msgid "Yeah, 'cause she did a <i>great</i> job protecting Mol."
msgstr "그거 좋네, 몰을 <i>퍽이나</i> 잘 지켜내신 분이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD
#. Speaker = Ide
#. NodeID = ef2d9edb-a0ac-4e35-8e2f-bd63e3754469
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD:ef2d9edb-a0ac-4e35-8e2f-bd63e3754469
msgctxt "hc63b534eg73aag46a8g8639g66f601e9784d"
msgid "That's why we should leave <i>now!</i>"
msgstr "그러니까 <i>지금</i> 떠나야지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD
#. Speaker = Mattis
#. NodeID = f8c35c27-e31e-dde7-1266-fe228b3da126
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_KidsAfterGhoulAttack_AD:f8c35c27-e31e-dde7-1266-fe228b3da126
msgctxt "hd5770307g4b66g4bdeg9263g2bd4070c2a0e"
msgid "Maybe we should ask someone else?"
msgstr "아니면 다른 사람한테 물어볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 02bab817-8e37-427c-11f0-bc0056fbbe40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_MattisPostRescue(1) = True
#.   Global:
#.      - MOO_NecroLab_State_KidsRescued_DEPRECATED = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:02bab817-8e37-427c-11f0-bc0056fbbe40
msgctxt "h52a55278g70f6g476dg9270g0a048b45013c"
msgid ""
"I can't wait to get outta this dump and never come back. Grab what you can "
"before we scarper, yeah?"
msgstr "이 쓰레기장을 떠나서 다시는 안 돌아올 거예요. 우리가 내빼기 전에 살 물건 있으면 사세요, 알겠죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 0bf424fc-85c4-67c4-4b95-17ede9e1c679
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:0bf424fc-85c4-67c4-4b95-17ede9e1c679
msgctxt "h80bafcdcgcd21g4f3fgbd4fg58dc3836618b"
msgid "Nuh-uh!"
msgstr "아니아니!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 0ceeecc0-b9af-08c7-7258-cc0e6c9e6d12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:0ceeecc0-b9af-08c7-7258-cc0e6c9e6d12
msgctxt "h22b0239dg5358g47b0gab07g2ddf528c168d"
msgid "I'd like to buy it from you."
msgstr "네게서 그걸 사고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 11927ef8-6325-a262-d172-433c0e5594b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:11927ef8-6325-a262-d172-433c0e5594b2
msgctxt "h4d668106ge98bg464fgb187g23205d377568"
msgid ""
"She always says the stuff I like is junk. I'm gonna make a killing on this! "
"You'll see."
msgstr "몰은 항상 내가 좋아하는 물건은 죄다 쓰레기 취급해요. 이걸로 떼돈을 벌거라고요! 두고 봐요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 16d9db76-8947-520c-591d-ffb4648bef65
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:16d9db76-8947-520c-591d-ffb4648bef65
msgctxt "h2fc841edgab92g4fcfgadf3gcb0ac3314506"
msgid "Yes she did."
msgstr "맞거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 16f6d27d-21af-e039-c7f8-d381caeed608
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_TieflingSurvivors_State_HasSilverKey(0) = True
#. SetFlags:
#.   Global:
#.     - HAV_TieflingSurvivors_State_DealMade = True
#.   Object:
#.     - HAV_TieflingSurvivors_Event_GiveSilverKey(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:16f6d27d-21af-e039-c7f8-d381caeed608
msgctxt "h3149f9b3gc05fg4d61ga187gc232762fb13f"
msgid "Really? But she said... all right. Here. I guess."
msgstr "정말요? 하지만 몰이... 알았어요. 여기. 흥."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 190d4314-1764-d7cc-c8c4-2b528e17d361
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:190d4314-1764-d7cc-c8c4-2b528e17d361
msgctxt "h9987d5f9gb42cg4aa9gbf17g4fca3f3aa051"
msgid ""
"Hmm. I'm not supposed to mention it to anyone, but I do have something "
"pretty special in stock. A <i>key.</i>"
msgstr "흐음. 원래는 아무한테도 말해서는 안되는 건데, 꽤 특별한 물건이 있긴 해요. <i>열쇠</i>요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 1fb20da6-1c20-52b4-196c-f1309c155d53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:1fb20da6-1c20-52b4-196c-f1309c155d53
msgctxt "h0695de2ag402cg4056gbf1bgbb4c8d0cb307"
msgid "As Mol would say - suit yourself."
msgstr "몰이 말하던 대로, 알아서 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 213eb8a4-7c92-6ae0-e8cb-c99633f75dde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:213eb8a4-7c92-6ae0-e8cb-c99633f75dde
msgctxt "h3931518cg8265g410egac7cg22ce4748a7c6"
msgid "No she didn't."
msgstr "에이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 21bb5393-d0c5-6963-40d3-4eec42320c53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:21bb5393-d0c5-6963-40d3-4eec42320c53
msgctxt "h589551feg6445g47d0ga821g9b4662a51ae8"
msgid "I'll be back with the money."
msgstr "돈을 갖고 돌아올게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 24220143-df83-c071-646a-fc17b82dac4d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:24220143-df83-c071-646a-fc17b82dac4d
msgctxt "h61d498a2g8cd6g4d47gbcecg6e82ad599505"
msgid "Hand it over. <i>Now.</i>"
msgstr "그거 넘겨. <i>당장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 260ecb1e-1507-e528-fcd3-986d52593af3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_TieflingSurvivors_State_HasSilverKey(0) = True
#. SetFlags:
#.   Global:
#.     - HAV_TieflingSurvivors_State_DealMade = True
#.   Object:
#.     - HAV_TieflingSurvivors_Event_GiveSilverKey(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:260ecb1e-1507-e528-fcd3-986d52593af3
msgctxt "h7dd8d8a4g7f3dg4db2g8a35g21fc0ee553b2"
msgid ""
"But she put me in charge of the shop! I thought... never mind. Here. You can "
"have it, then."
msgstr "몰이 저보고 상점 맡으라고 했단 말예요! 전 그러면 제가... 됐어요. 여기. 가져가시든가요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 2b0e0f39-ea1a-dc8a-ef7d-0d1227ec4f6b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - HAV_TieflingSurvivors_State_TriedToGetSilverKey(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_TieflingSurvivors_State_TriedToGetSilverKey(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:2b0e0f39-ea1a-dc8a-ef7d-0d1227ec4f6b
msgctxt "h44628f30g234dg4ba2gbbe7gca8030cb5852"
msgid "Mol said I could have it."
msgstr "몰이 내게 그걸 가져도 된댔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 2b6e531f-b817-4a04-aee4-9c90ac28a981
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Mattis_NightsongFreed_HasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:2b6e531f-b817-4a04-aee4-9c90ac28a981
msgctxt "h7163cbceg387cg42bagb387gf227767565ff"
msgid ""
"My stores are always open to you - just make sure you give Ketheric a few "
"knocks from me, yeah?"
msgstr "제 가게에선 언제나 당신을 환영할 거에요. 케서릭한테 제 몫까지 몇 방 먹여줘요, 알겠죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 312d911b-edeb-371c-f965-78b192f76492
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_TieflingSurvivors_State_HasSilverKey(0) = False
#. SetFlags:
#.   Global:
#.     - HAV_TieflingSurvivors_State_DealMade = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:312d911b-edeb-371c-f965-78b192f76492
msgctxt "hb5b734cag00fdg495ag96e4gf67c7b9b8629"
msgid "Huh... No, no! Don't tell me I dropped it? I'm an <i>idiot.</i>"
msgstr "엥...안돼, 안돼! 잃어버렸다고? 난 <i>i멍청이야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 366d6a5b-943d-920c-8302-b8bfff5263b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_TieflingSurvivors_State_SilverKeyIntroHappened(1) = True
#.      - HAV_TieflingSurvivors_Mattis_BuyingKey(1) = True
#.   Global:
#.      - HAV_TieflingSurvivors_State_DealMade = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:366d6a5b-943d-920c-8302-b8bfff5263b1
msgctxt "hfee717afga4cdg40b8ga03bg5d4a7f05103d"
msgid "I'm back about that key."
msgstr "열쇠 때문에 왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 36be0c9c-10b2-56eb-16b4-3ecfc90bb9e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_TieflingSurvivors_HasMet_Mattis(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:36be0c9c-10b2-56eb-16b4-3ecfc90bb9e9
msgctxt "h89c2fc88g82a1g45a8gbec8gd9748479ce29"
msgid "Welcome back. Are you, ahem, looking for something in particular?"
msgstr "다시 잘 왔어요. 혹시, 크흠, 찾는 물건이라도 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 36be0c9c-10b2-56eb-16b4-3ecfc90bb9e9
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Dialog:
#.      - HAV_TieflingSurvivors_HasMet_Mattis(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:36be0c9c-10b2-56eb-16b4-3ecfc90bb9e9
msgctxt "heef78f43gf102g42a5g922fge948e447981c"
msgid "What're you looking for?"
msgstr "뭘 찾으세요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 36be0c9c-10b2-56eb-16b4-3ecfc90bb9e9
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Dialog:
#.      - HAV_TieflingSurvivors_HasMet_Mattis(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:36be0c9c-10b2-56eb-16b4-3ecfc90bb9e9
msgctxt "h80c2b4e9g5d5dg4f4fg9007g121c8218d02d"
msgid "What can I get you?"
msgstr "뭘 드릴까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 36be0c9c-10b2-56eb-16b4-3ecfc90bb9e9
#. HandlePath = TaggedText[0].TagText[3]
#. CheckFlags:
#.   Dialog:
#.      - HAV_TieflingSurvivors_HasMet_Mattis(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:36be0c9c-10b2-56eb-16b4-3ecfc90bb9e9
msgctxt "h3aa64710g4bedg4f49gb99bg649d862034ee"
msgid "In the market for something special?"
msgstr "뭔가 특별한 걸 찾고 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 3d12764d-ac70-18ff-e67d-3ebcbf129755
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - HAV_TieflingSurvivors_State_TriedToGetSilverKey(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_TieflingSurvivors_State_TriedToGetSilverKey(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:3d12764d-ac70-18ff-e67d-3ebcbf129755
msgctxt "h375093a9g0052g4b8fga194gb30ca7de40c3"
msgid "If it was worth any coin, do you think Mol would have given it to you?"
msgstr "그게 가치가 조금이라도 있었다면 몰이 네게 줬을 거 같아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 43673e5c-cbbe-d9da-b455-0a9816402be3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:43673e5c-cbbe-d9da-b455-0a9816402be3
msgctxt "hc40e2e23g189ag40b0g9079g81226f25a0cc"
msgid "Mol knows it'll be safer with me - and so do you."
msgstr "몰은 내가 가지고 있어야 더 안전하단 걸 알아. 너도 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 4799a625-3c6e-b5df-ccd9-d8e6492506fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_TieflingSurvivors_State_HasSilverKey(0) = False
#. SetFlags:
#.   Global:
#.     - HAV_TieflingSurvivors_State_DealMade = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:4799a625-3c6e-b5df-ccd9-d8e6492506fa
msgctxt "h1863131bg5012g4e61gb0ffg65496ac1e591"
msgid ""
"Oh no! I'm so sorry, I - I think I dropped it. This is so unprofessional, "
"Mol is gonna kill me!"
msgstr "안 돼! 정말 죄송해요, 아-아마 떨어뜨린 것 같아요. 전문가답지 못했어, 몰이 날 죽일 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 4abe81f1-dc8c-63fa-9943-38b23b2e9d4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_TieflingSurvivors_State_HasSilverKey(0) = True
#. SetFlags:
#.   Global:
#.     - HAV_TieflingSurvivors_State_DealMade = True
#.   Object:
#.     - HAV_TieflingSurvivors_Event_GiveSilverKey(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:4abe81f1-dc8c-63fa-9943-38b23b2e9d4f
msgctxt "h16cae90fg9f06g47f7gbda6g9b8240816f23"
msgid "Ugh. <i>Fine.</i>"
msgstr "에휴. <i>알았어요.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 4e67d591-49ba-be59-312c-fc932d5061b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:4e67d591-49ba-be59-312c-fc932d5061b0
msgctxt "h0872f68bg27f8g4927g960fg9d4ec05e71b1"
msgid "Take good care of that key."
msgstr "그 열쇠 잘 간수하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 559aaa36-e6f6-08fb-c300-325c644d913a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:559aaa36-e6f6-08fb-c300-325c644d913a
msgctxt "h0e128501g33eag488dga9baga6c02766439a"
msgid ""
"You drive a hard bargain, but it's a deal. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr ""
"흥정하는 게 아주 국물도 없구만. 그치만 알겠어. 거래하자. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 57bff4ec-d9b0-47f2-2fae-f688eaf3e8e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:57bff4ec-d9b0-47f2-2fae-f688eaf3e8e7
msgctxt "ha460e69cgc749g406bgb1dbgb53077df4410"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 5b71a2c3-0fe2-f377-e7ca-d39f35bb430b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4ce847be-7503-4dc2-9d2e-a810295ca209_once = False
#. SetFlags:
#.   Local:
#.     - 4ce847be-7503-4dc2-9d2e-a810295ca209_once = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:5b71a2c3-0fe2-f377-e7ca-d39f35bb430b
msgctxt "hd80668e2g2da7g4629ga7cbg0c35e1867017"
msgid "Yours is the first happy face I've seen in a good while."
msgstr "너처럼 행복한 얼굴은 내가 정말 오랜만에 보네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 6040575e-11cc-3be9-aecf-8c593fb98006
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:6040575e-11cc-3be9-aecf-8c593fb98006
msgctxt "h2d5ed932gef79g4ff6gb30bg19746ace91dd"
msgid "Let me see what you have."
msgstr "뭘 판매하는지 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 61067d83-f91e-cde2-83af-d19fb5fded80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:61067d83-f91e-cde2-83af-d19fb5fded80
msgctxt "hd2b2c219g698bg4c3dg83f2gf2f833468e6e"
msgid ""
"No way! This is my shop - that means I'm in charge of all the stuff in the "
"shop. And that's that."
msgstr "어림없어요! 이건 제 상점이에요. 모든 물건은 제가 책임진다고요. 그게 다에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 6c6ab6c0-85a9-2fde-8f0e-2a10c531defc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_MattisPostRescue(1) = False
#.   Global:
#.      - MOO_NecroLab_State_KidsRescued_DEPRECATED = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_MattisPostRescue(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:6c6ab6c0-85a9-2fde-8f0e-2a10c531defc
msgctxt "h93154097gd095g4f99gbb14g658d72d780a5"
msgid ""
"Thanks for bringing the crew back. If I open a shop in Baldur's Gate you're "
"gonna get a discount! Not, like, a big one, but still."
msgstr "우리 패거리를 다시 모아줘서 고마워요. 발더스 게이트에서 가게를 열면 깎아 드릴게요! 많이는 아니지만, 할인은 할인이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 7d0b047b-048f-41b3-a571-b1e774e42132
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_Mattis_NightsongFreed_HasMet(1) = False
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_Mattis_NightsongFreed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:7d0b047b-048f-41b3-a571-b1e774e42132
msgctxt "h62db80eagb75ag4ca6gae39ge6891e58105c"
msgid ""
"You had something to do with the light, right? I <i>knew</i> it - this is "
"the end for Ketheric. Stock up while you can!"
msgstr "그 빛이랑 뭔가 연관이 있죠? 전 알고 있었어요. 이제 케서릭은 끝장이에요. 틈날 때 보급해둬요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 81eebc61-fd27-8e98-9e83-78b898e26962
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:81eebc61-fd27-8e98-9e83-78b898e26962
msgctxt "hfcccfaccg49ffg436fg9688gef284e9ce658"
msgid "Cause it's <i>mine. </i>Got it?"
msgstr "왜냐면 <i>제 거</i>니까요. 알아 들어요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 8e9b8e43-a536-5bf2-4438-ac676cb1e3bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_TieflingSurvivors_Mattis_BuyingKey(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_TieflingSurvivors_Mattis_BuyingKey(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:8e9b8e43-a536-5bf2-4438-ac676cb1e3bb
msgctxt "he274f3bbg8802g44e7gaab0gacb91dab43e2"
msgid "Better hurry, I've got <i>loads</i> of interested parties."
msgstr "서두르는 게 좋을 거예요. 관심 있는 분들이 <i>한가득</i>이거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 8ec7baef-6438-a99e-b74a-30ae202d22d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_TieflingSurvivors_State_SilverKeyIntroHappened(1) = False
#.   Global:
#.      - HAV_TieflingSurvivors_Knows_SilverKey = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:8ec7baef-6438-a99e-b74a-30ae202d22d4
msgctxt "hfcd79eabgb368g4ef0g8302gc5380c574ac3"
msgid "You got any stock for an extra special customer like me?"
msgstr "나같이 특별한 손님을 위해 쟁여 놓은 거 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 90768470-9e02-06f9-f6d5-c51ef6992186
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:90768470-9e02-06f9-f6d5-c51ef6992186
msgctxt "hb52bb18bg1a6fg4b63gb734g156cb914e691"
msgid "Go ahead! It's <i>mine</i>. Got it?!"
msgstr "그러시든가요! 이건 <i>제 거</i>거든요. 알았어요?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 91474f18-c594-aab8-2e27-4900be405b46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_TieflingSurvivors_State_SilverKeyIntroHappened(1) = False
#.   Global:
#.      - HAV_TieflingSurvivors_Knows_SilverKey = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:91474f18-c594-aab8-2e27-4900be405b46
msgctxt "h5dad812dg9878g407ega944gb99e7cb7f807"
msgid "Mol mentioned some 'silver junk' she'd found?"
msgstr "몰이 '쓸모없는 은색 물건'을 찾았다고 하던데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = 9672bf51-e35c-e396-816b-70d345ce051b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment_2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:9672bf51-e35c-e396-816b-70d345ce051b
msgctxt "hf182742fgbd58g4994gb7e7gd67d72a5d32e"
msgid ""
"That's way too little. Here. Keep the change. "
"([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-aba3-875cf81c38ca])"
msgstr ""
"정말 싼 데. 자. 잔돈은 가지렴. ([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-"
"aba3-875cf81c38ca])"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 98dcc3c7-9aee-1877-7655-74e28642d2fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:98dcc3c7-9aee-1877-7655-74e28642d2fc
msgctxt "hd5fac336g9d85g41eeg9550g2d8a07c5ed3a"
msgid "I'm alive, ain't I? What's not to like."
msgstr "전 살아있잖아요? 좋아하지 않을 이유가 뭐가 있나요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = 9b36bfef-e479-d421-619c-f26e93b4e058
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_TieflingSurvivors_State_SilverKeyIntroHappened(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:9b36bfef-e479-d421-619c-f26e93b4e058
msgctxt "h5c05b8fag039fg421fg9badgaebf48fea772"
msgid ""
"What does it look like? What does it open? What treasures await behind its "
"lock? That's for one lucky buyer to find out."
msgstr "어떻게 생겼을까? 뭘 여는 걸까? 자물쇠 뒤엔 어떤 보물이? 한 행운의 구매자가 알아내게 되겠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = a125c6b1-7aaa-0a8e-a815-627b5126c68b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:a125c6b1-7aaa-0a8e-a815-627b5126c68b
msgctxt "h9cf5e5afgd882g4393ga0d8g8da287c61161"
msgid "Sure..."
msgstr "그러세요..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = a2f1a558-f71f-813f-0e2d-a077c9f8c337
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_TieflingSurvivors_HasMet_Mattis(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:a2f1a558-f71f-813f-0e2d-a077c9f8c337
msgctxt "hdb24bc29gc151g46e3ga37dgb8fa03173920"
msgid ""
"Mol said never abandon your post, so I'm gonna keep the shop going. What do "
"you need?"
msgstr "몰이 무슨 일이 있어도 자리를 지키라고 했어요. 그러니 상점도 계속 운영해야겠죠. 필요한 게 있으신가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = a2f1a558-f71f-813f-0e2d-a077c9f8c337
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_TieflingSurvivors_HasMet_Mattis(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:a2f1a558-f71f-813f-0e2d-a077c9f8c337
msgctxt "haabc62f4g5197g4175gbbcegc21b98c8c251"
msgid "Shop's still open - what do you need?"
msgstr "아직 영업 중입니다. 뭐가 필요하세요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = a2f1a558-f71f-813f-0e2d-a077c9f8c337
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_TieflingSurvivors_HasMet_Mattis(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:a2f1a558-f71f-813f-0e2d-a077c9f8c337
msgctxt "h77f36bf2g8e04g4d1dg826eg4c740a25de6f"
msgid "Seems like you need some extra supplies. What'll it be?"
msgstr "추가 보급이 필요한 것 같네요. 뭐 필요하세요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = a3fe0fcd-0b79-8f01-8cf3-3eee750b2377
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:a3fe0fcd-0b79-8f01-8cf3-3eee750b2377
msgctxt "ha7f2c2eege536g453fg9152gfff3da8c6258"
msgid "Yuh-huh."
msgstr "응응."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = a4971d2a-fc5c-76b5-6aaf-6265da0f07bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_TieflingSurvivors_State_PromisedToSaveMol = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:a4971d2a-fc5c-76b5-6aaf-6265da0f07bf
msgctxt "h43c4fa4bgc398g4c67g896bg893ed4e446db"
msgid ""
"Mol can be cranky, and mean, but she looks after us. So, stock up, all "
"right? 'Cause you need all the help you can get to bring her home."
msgstr "몰은 괴팍하고 얄밉지만 우릴 돌봐줘요. 그러니 단단히 보급해두세요, 알겠죠? 몰을 데려오려면 만반의 준비가 필요할 테니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = a5af1237-d9a4-bb41-8626-ab9253939fd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:a5af1237-d9a4-bb41-8626-ab9253939fd8
msgctxt "h1b4cb607g8807g4db1ga4eage5d772656295"
msgid "What about it?"
msgstr "그게 어때서요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = a7ba8cca-fcd1-70b7-a870-e8dbc8102d85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:a7ba8cca-fcd1-70b7-a870-e8dbc8102d85
msgctxt "h5f1eed59g131bg47edg9c4dg2e4d3bba9bae"
msgid "I mean... <i>maybe.</i>"
msgstr "그러니까... <i>아마도요.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = a9dda070-4a1c-23ae-8639-b3532614d9b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:a9dda070-4a1c-23ae-8639-b3532614d9b8
msgctxt "hc65a3b86gf873g49e6g8380gfb8c1ab6896c"
msgid ""
"This is a, ahem, <i>valuable</i> piece, so it's gonna cost a lot. And that "
"is non-negot... non... the price isn't changing! "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr ""
"에헴, 이게 사실 말이죠, <i>워낙</i> 값진 물건이라 좀 비싸요. 흥전... 흥정을 사절... 아무튼 가격은 못 깎아줘요! "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = ab33e777-7b5f-37f9-043c-a5206d172ebe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_TieflingSurvivors_HasMet_Mattis(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_TieflingSurvivors_HasMet_Mattis(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:ab33e777-7b5f-37f9-043c-a5206d172ebe
msgctxt "h2c6334bbgf6bbg4c8fgafeeg2c3184441a25"
msgid ""
"Check it out - we've gone <i>legitimate, </i>and Mol put <i>me </i>in "
"charge. Whaddya need?"
msgstr "어때요? 우린 이제 <i>합법적인</i> 일을 하게 됐고 몰은 저를 책임자로 임명했어요. 뭐가 필요하세요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = b0e74a2b-786d-abd8-1454-c8c03ff89dcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:b0e74a2b-786d-abd8-1454-c8c03ff89dcc
msgctxt "hdbf9c656gba7eg4f06g9825g31e6fbc5af69"
msgid ""
"You got the coin this time? ([GEN_CheckMagicPocketGold_6057ad05-9492-4630"
"-9f0a-be548b134c54])"
msgstr ""
"이번엔 돈 가져왔어요? ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-"
"be548b134c54])"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Mattis
#. NodeID = bf3db159-51e9-09d0-9672-2971af02f9c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAV_TieflingSurvivors_State_HasSilverKey(0) = True
#. SetFlags:
#.   Global:
#.     - HAV_TieflingSurvivors_State_DealMade = True
#.   Object:
#.     - HAV_TieflingSurvivors_Event_GiveSilverKey(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis:bf3db159-51e9-09d0-9672-2971af02f9c7
msgctxt "h41fb45d0gbf13g4aefgadb9gde9d2c372851"
msgid "Hm. I guess it is kind of old. Here. Birds of a feather."
msgstr "음. 좀 낡긴 한 것이 당신과 어울리네요. 여기요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_TieflingSurvivors_Mattis
#. Speaker = Player
#. NodeID = c525e539-d70f-8ea2-161e-315e28b42712
