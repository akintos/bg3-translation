msgctxt "h6291940bgd4e6g47cfg9eb4g663ba7a74127"
msgid "Easy! They're with me."
msgstr "진정해! 내 일행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint
#. Speaker = Harper Elifer
#. NodeID = 49edeaf4-5f5a-7199-0d56-b638c8bb4ae5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint:49edeaf4-5f5a-7199-0d56-b638c8bb4ae5
msgctxt "hc80ff88fgd994g47a4gbf9cge0bb8202cebe"
msgid "Duly noted."
msgstr "알아들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_EnteringHaven_TadpoleCheckpoint
#. Speaker = Player
#. NodeID = 4b615fe2-2f23-6bd5-0501-e81bb5818318
