msgctxt "h0c2a084dg2622g4a3dga9bcg52db99f27cb8"
msgid "No. We are enough as we are."
msgstr "아니. 우린 이대로도 충분해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/GLO_GatherYourAllies_DaisyJournalBegin
