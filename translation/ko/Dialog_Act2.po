msgctxt "h0fdd76fdgeb46g4bb4gae68g3f5cb625776f"
msgid "This flesh <i>must</i> be flayed. The next instrument, sister."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon_Bonesaw_Combat
#. Speaker = Malus Thorm
#. NodeID = 7e417723-0c51-4d48-93e3-dcba06b2b3ff
