msgctxt "hb7176493g5651g4765g8bd1gcd7c9baaa800"
msgid ""
"<i>Living flowers</i>... this must be the sign that Halsin told us to watch "
"for."
msgstr "<i>살아있는 꽃</i>... 할신이 찾아보라고 했던 흔적임이 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_OliverShadow_PAD_FlowersAtHouse
#. Speaker = Player
#. NodeID = 1b676049-88ca-445e-a497-556ef20aefa2
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
