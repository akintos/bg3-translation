msgctxt "h3982db87g21d7g47b2g8450g475e11ad8223"
msgid "Don't fancy following that leggy nutter again."
msgstr "다리 긴 미친놈을 또 따라가고 싶진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint
#. Speaker = Brawler Vez
#. NodeID = 5e4c2edb-b498-9d91-4878-87450331e829
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint:5e4c2edb-b498-9d91-4878-87450331e829
msgctxt "h21b67cffgaa91g4295g88f7g9f411fe516c1"
msgid "I liked it just fine."
msgstr "난 좋기만 한데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint
#. Speaker = Brawler Vez
#. NodeID = 70a0f594-15d2-b22c-42c2-433a29281dd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint:70a0f594-15d2-b22c-42c2-433a29281dd7
msgctxt "h512b69f2g97d4g42fag948fg002c33e75ab3"
msgid "Nope. 'Cause I ain't a little coward."
msgstr "아니. 왜냐하면 난 쬐끄만 겁쟁이가 아니걸랑."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint
#. Speaker = Sharp-Eye Lora
#. NodeID = 75f3f76e-6141-1865-9f0e-25c7fbd95937
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint:75f3f76e-6141-1865-9f0e-25c7fbd95937
msgctxt "h06cbaa41g890bg4b17g91afg30f565b172d9"
msgid "Yeah... no, me neither."
msgstr "하지...아니, 나도 걱정 안 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint
#. Speaker = Sharp-Eye Lora
#. NodeID = b41a8525-efc1-4076-8de2-08f2bf937a12
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 2fb08ca0-df67-8450-3f01-c1e1c2a78b59_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint:b41a8525-efc1-4076-8de2-08f2bf937a12
msgctxt "hf7120892gfbc5g45f7ga48bg112ec0e886f4"
msgid "Ain't you worried about the shadows?"
msgstr "그림자가 걱정되지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_Drider_Caravan_AD_MeleeAndRangerGoblinsAtCheckpoint
#. Speaker = Sharp-Eye Lora
#. NodeID = c456bd19-1017-4ab7-9132-c9c170fcdec2
