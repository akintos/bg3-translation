msgctxt "hd8f6dc79g7d72g41e8g9231gf81bdb09bf8c"
msgid "Well, she's definitely immortal."
msgstr "확실히 불멸자가 맞긴 하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
