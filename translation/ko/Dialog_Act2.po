#.      - ORI_Gale_BalthazarLab_State_IngredientsGone = True
#. SetFlags:
#.   Object:
#.     - SCL_BalthazarLab_Circle_Event_Use(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle:61587f7d-6c7f-5239-b34a-46bb13ddb3a1
msgctxt "hd01d336egb4e9g4aa7g99cbg9f5ebf347667"
msgid "<i>Craft the Shadow Lantern.</i>"
msgstr "<i>그림자등불을 만든다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_BalthazarLab_Circle
#. Speaker = Player
#. NodeID = 62861835-bf58-613b-31d6-e9dfcecefead
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
