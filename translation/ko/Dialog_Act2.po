msgctxt "he1c41303g002bg4c7bgbaa4gc2f5967d974b"
msgid "*The mind passively awaits your input.*"
msgstr "*장치의 정신이 입력을 기다립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Vault_Puzzle
#. Speaker = Narrator
