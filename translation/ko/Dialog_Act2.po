#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Cat:f336a064-6d6a-5f80-9086-ab45a2d76414
msgctxt "hd66346c8g8f59g4699ga0a2gcee5841df2c6"
msgid "*Rrreow...*"
msgstr "*야아웅...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_Cat
#. Speaker = His Majesty
#. NodeID = fbad62d1-b41a-80e2-bb48-2e0c5ca6b036
