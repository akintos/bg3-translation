#.   Global:
#.      - COL_MizorasRescue_State_SavedMizora = False
#.      - COL_MizorasRescue_State_KilledMizora = False
#.      - MOO_MizorasRescue_Event_WalkedAway = True
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor:85536110-9d72-fd22-71ec-af5c0c92874d
msgctxt "h9abcab9cgd5cag42f5g95dag6d223d1f8dd4"
msgid ""
"*Mizora's voice rings in your mind. If you continue without freeing her, you "
"will perish, and the Hells will claim your soul as their prize.*"
msgstr ""
"*미조라의 목소리가 당신의 정신 속에 울려 퍼집니다. 그녀를 풀어주지 않고 계속 진행한다면, 당신은 죽게 될 것이고, 지옥이 당신의 "
"영혼을 그들의 포상으로 차지하게 될 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor
#. Speaker = Wyll
#. NodeID = 8e4199b9-c719-c2a9-4899-ac4ef3ff7e77
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c01ce0af-738e-94ab-6b8e-c527205f42ad_WyllInclusion = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor:8e4199b9-c719-c2a9-4899-ac4ef3ff7e77
msgctxt "hb891deebgd21ag49dfg906eg54afa777e5c2"
msgid ""
"Mizora's still in that pod. If we open this door, the Hells will swallow me "
"on the spot."
msgstr "미조라는 여전히 그 포드 안에 있어. 이 문을 열면, 난 즉시 지옥에 끌려가게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor
#. Speaker = Wyll
#. NodeID = 99c0c590-3eff-e955-b27b-cc240140ba28
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c01ce0af-738e-94ab-6b8e-c527205f42ad_WyllInclusion = False
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor:99c0c590-3eff-e955-b27b-cc240140ba28
msgctxt "ha0e1f8ceg90b4g47bfg9f2dg7dd6f2d11370"
msgid "Please, we should search. My soul hangs in the balance."
msgstr "부탁이야, 찾아봐야 해. 내 영혼이 위태로운 상황이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor
#. Speaker = Narrator
#. NodeID = a0073439-62a6-fb6e-4e3b-a7316f166db3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor:a0073439-62a6-fb6e-4e3b-a7316f166db3
msgctxt "h8582743cg0d03g4b1fg870fg628bf18c8a82"
msgid ""
"*No longer a background murmur, the presence in your mind builds to a roar.*"
msgstr "*이제는 더 이상 가물가물한 소리가 아니라, 당신의 정신 속에서 그 존재가 거세게 울려 퍼지고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor
#. Speaker = Narrator
#. NodeID = b9ac05a4-5e53-b833-a1df-f023cc7ec137
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - COL_EntranceDoor_State_Inside(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor:b9ac05a4-5e53-b833-a1df-f023cc7ec137
msgctxt "h4ac27c35gd68fg4a45gba40g20cc377c2e4d"
msgid "*The door pulses in recognition.*"
msgstr "*문이 인식하는 듯이 떨립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor
#. Speaker = Narrator
#. NodeID = bbff0c72-5842-bc78-ca3e-889fe7a4d9a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor:bbff0c72-5842-bc78-ca3e-889fe7a4d9a9
msgctxt "h2a5b6526g509eg45e5gb27egfab93b77bde1"
msgid ""
"*You take a worried pause. Mizora is still trapped in her pod. If you walk "
"through the door, Wyll will die - and his soul will be hers eternally.*"
msgstr ""
"*당신은 걱정스러운 표정으로 잠시 멈춥니다. 미조라가 여전히 그녀의 포드에 갇혀 있습니다. 이 문을 통과하면, 윌은 죽을 것입니다. "
"그리고 그 영혼은 영원히 미조라의 것이 될 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor
#. Speaker = Wyll
#. NodeID = d7685471-8c11-488c-be77-09bacfa28cf8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c01ce0af-738e-94ab-6b8e-c527205f42ad_WyllInclusion = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor:d7685471-8c11-488c-be77-09bacfa28cf8
msgctxt "h819eff8bgff06g43eag909cgae2ae42c9df0"
msgid ""
"We haven't freed Zariel's infernal asset - the one Mizora sent us to find. "
"If we enter now, I'm good as dead."
msgstr ""
"우리는 자리엘의 중요한 인물들을 아직 풀어주지 않았어. 미조라가 우리를 보내 찾으라고 한 것 말이야. 지금 들어가면, 나는 죽은 목숨이나 "
"다름없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor
#. Speaker = Narrator
#. NodeID = d8aa1221-11d7-41a6-b7da-05303bad16d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor:d8aa1221-11d7-41a6-b7da-05303bad16d2
msgctxt "h40f0c434g94b4g4446g8cc1g341e8e8be445"
msgid ""
"*You take a worried pause. You didn't free the devil Mizora sent Wyll for. "
"If you walk through the door, he will die - and his soul will be Mizora's "
"eternally.*"
msgstr ""
"*당신은 걱정스러운 표정으로 잠시 멈춥니다. 당신은 미조라가 윌을 보내 찾으라 한 데빌을 풀어주지 않았습니다. 이 문을 통과하면, 윌은 "
"죽을 것입니다. 그리고 그 영혼은 영원히 미조라의 것이 될 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor
#. Speaker = Narrator
#. NodeID = e862a23f-578d-4ea4-1f2a-d47cb9b9ffac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor:e862a23f-578d-4ea4-1f2a-d47cb9b9ffac
msgctxt "h6044866ag09fbg46dfg9b46gd1eea5a84388"
msgid "*But in denial, too. It will not open, even for you.*"
msgstr "*하지만 거부하는 듯하기도 합니다. 당신이라 해도 열리지 않을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor
#. Speaker = Narrator
#. NodeID = efc12cc8-ea1e-e7fc-c94b-521f7cba96c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - COL_MizorasRescue_State_SavedMizora = False
#.      - COL_MizorasRescue_State_KilledMizora = False
#.      - MOO_MizorasRescue_Event_WalkedAway = False
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_EntranceDoor:efc12cc8-ea1e-e7fc-c94b-521f7cba96c0
msgctxt "h25cd7ae3g42c1g4741g89cfgc76c04885155"
msgid ""
"*You take a worried pause. You didn't free the devil Mizora sent you for. If "
"you walk through the door, you will die - and your soul will be hers "
"eternally.*"
msgstr ""
"*당신은 걱정스러운 표정으로 잠시 멈춥니다. 당신은 미조라가 찾으라 한 데빌을 풀어주지 않았습니다. 이 문을 통과하면, 당신은 죽을 "
"것입니다. 그리고 그 영혼은 영원히 미조라의 것이 될 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_AudienceTentacle
#. Speaker = Narrator
#. NodeID = 6f3e0882-a2f6-4b39-a2f1-34e856155433
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_AudienceTentacle:6f3e0882-a2f6-4b39-a2f1-34e856155433
msgctxt "hf2d8b75agdf9cg4ab4g9f80g3aff983d6c4c"
msgid ""
"*A giant stalk of flesh rests before you, fibrous tendrils snaking up and "
"away into darkness. It pulses like a living, breathing thing.*"
msgstr ""
"*당신 앞에 거대한 살덩이의 줄기가 놓여 있습니다. 섬유질의 덩굴손은 뱀처럼 꿈틀거리며 어둠 속으로 멀어집니다. 마치 살아서 숨쉬는 생물 "
"마냥 맥이 뜁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_AudienceTentacle
#. Speaker = Narrator
#. NodeID = b05e1f60-e43a-14f6-92fd-7d95ed47ff03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_AudienceTentacle:b05e1f60-e43a-14f6-92fd-7d95ed47ff03
msgctxt "hb9e0cb61g0a9fg4b1cgb787g9bf3748ba839"
msgid ""
"*This being - the colony itself - burns to rage, to tear these impostors "
"from its core. And instead it rests, like a docile pet.*"
msgstr ""
"*군집인 이 존재는 이 사기꾼들을 뼛속까지 갈라 버리기 위한 분노로 불타고 있습니다. 하지만 마치 온순한 애완동물처럼 휴식하고 있죠.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_AudienceTentacle
#. Speaker = Narrator
#. NodeID = f683d773-9d4d-4100-85e0-0498a1bf6f59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_AudienceTentacle:f683d773-9d4d-4100-85e0-0498a1bf6f59
msgctxt "h5f0a7c67g4d26g4d11g8daag0b6544c07fc0"
msgid ""
"*It <i>is </i>alive. Your tadpole echoes awareness - and the deep, savage "
"fury of a wild thing caged.*"
msgstr "*그것은 <i>살아</i>있습니다. 당신의 올챙이가 그 의식에, 갇힌 야생의 존재가 가진 깊고 원시적인 분노에 공명합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 070cf9a3-87db-e458-0de5-b87d818ac6b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#.      - REALLY_WYLL(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:070cf9a3-87db-e458-0de5-b87d818ac6b9
msgctxt "hf0768f79g6907g4943ga480gb3a5754b3a58"
msgid "I wager that devil I'm meant to rescue's somewhere near."
msgstr "내가 구하려 한 데빌이 근처에 있다고 확신해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 687f2ed1-1dba-4841-8daa-6dfbebcd67e9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:687f2ed1-1dba-4841-8daa-6dfbebcd67e9
msgctxt "hf51193dag1a3cg4362gb697gd3d1e621b66e"
msgid ""
"This foul place is where they butchered my mind. Let us deal with the cult "
"in kind - leave none standing."
msgstr "이 역겨운 곳이 그들이 내 마음을 도륙낸 곳이야. 광신도들도 똑같이 취급하도록 하지. 그 누구도 살려두지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 687f2ed1-1dba-4841-8daa-6dfbebcd67e9
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:687f2ed1-1dba-4841-8daa-6dfbebcd67e9
msgctxt "h087aa26fg7515g4a90g96bagde614c84c1fc"
msgid "Ah, here we are. The infection at the heart of Moonrise."
msgstr "아, 도착했군. 문라이즈 중심에 있는 감염이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 687f2ed1-1dba-4841-8daa-6dfbebcd67e9
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:687f2ed1-1dba-4841-8daa-6dfbebcd67e9
msgctxt "h8e4be3fcgd952g4c37gb2bdgaf07c032e9fe"
msgid ""
"So much hidden away beneath Moonrise Towers. How deep does this warren go?"
msgstr "문라이즈 타워 아래에 숨겨진 것이 너무나 많군. 이 빽빽한 통로는 어디까지 이어지는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 687f2ed1-1dba-4841-8daa-6dfbebcd67e9
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:687f2ed1-1dba-4841-8daa-6dfbebcd67e9
msgctxt "h70163ee5gf566g4586ga050gaae0c9868687"
msgid "The illithids' foul roots run deep. Is there no end to this place?"
msgstr "일리시드의 더러운 뿌리가 깊게도 뻗어 있군. 이곳의 끝은 대체 어디지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 687f2ed1-1dba-4841-8daa-6dfbebcd67e9
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:687f2ed1-1dba-4841-8daa-6dfbebcd67e9
msgctxt "h096b1745g4b8fg4cf0gaf2eg239d496b0eb8"
msgid ""
"Look at this. How long has it been sitting under the tower? And how deep "
"does it go?"
msgstr "이것 좀 봐. 대체 얼마나 오랫동안 탑 아래에 웅크리고 있었던 거지? 어느 깊이까지 이어지는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 687f2ed1-1dba-4841-8daa-6dfbebcd67e9
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:687f2ed1-1dba-4841-8daa-6dfbebcd67e9
msgctxt "h0a26ddbfg3df7g4c33ga0b2gf69111392268"
msgid ""
"<i>Tla tavki. </i>The tower's <i>ghaik </i>infection runs deeper than I "
"thought."
msgstr "<i>Tla tavki. </i> 탑의 <i>게이크</i> 감염이 생각보다 깊게 뻗어 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 687f2ed1-1dba-4841-8daa-6dfbebcd67e9
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:687f2ed1-1dba-4841-8daa-6dfbebcd67e9
msgctxt "hedf762c0g9394g4dfag9f6ag90b6da934d85"
msgid ""
"Just how big is this place...? This lot aren't wanting for ambition, that's "
"certain."
msgstr "이곳은 대체 얼마나 큰 거지...? 욕심이 많은 곳이란 건 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 687f2ed1-1dba-4841-8daa-6dfbebcd67e9
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:687f2ed1-1dba-4841-8daa-6dfbebcd67e9
msgctxt "h1d07a3d8gd448g4166g827aga2fda58a41d8"
msgid ""
"This place look all too familiar for my tastes. Just how deep does it go?"
msgstr "이곳은 내 취향이라기엔 너무 익숙하군. 다만 어디까지 깊게 뻗어 있는 걸까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 687f2ed1-1dba-4841-8daa-6dfbebcd67e9
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:687f2ed1-1dba-4841-8daa-6dfbebcd67e9
msgctxt "h935061c8ge241g4967g89b2g82dcdd82698a"
msgid ""
"A living colony. I wonder if the settlers above knew just what slept beneath "
"their feet."
msgstr "살아 있는 군집이야. 지상 위의 정착민은 자신들의 발 아래에 무엇이 잠자고 있는지 알고 있었나 궁금하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 687f2ed1-1dba-4841-8daa-6dfbebcd67e9
#. HandlePath = TaggedText[9].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:687f2ed1-1dba-4841-8daa-6dfbebcd67e9
msgctxt "h45f8971dg4f2ag47efga9f7g7ba452f6fb6b"
msgid ""
"The tower sits on top of a <i>ghaik</i> infestation. How deep does it run?"
msgstr "탑이 <i>게이크</i> 감염 위에 서 있었군. 감염이 어느 깊이까지 뻗어 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = 687f2ed1-1dba-4841-8daa-6dfbebcd67e9
#. HandlePath = TaggedText[10].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:687f2ed1-1dba-4841-8daa-6dfbebcd67e9
msgctxt "h86ba3f10g4495g4bc9ga342g3e5c2cc91df7"
msgid ""
"All of this, sitting beneath Moonrise. For how long? And how deep does it go?"
msgstr "이 모든 것이 문라이즈 타워 아래에 있었군. 대체 언제부터지? 얼마나 깊게?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = a2873718-c6c1-ba6b-068a-e4284555d5ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Florrick_Event_WyllPresent = True
#.   Tag:
#.      - REALLY_WYLL(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD:a2873718-c6c1-ba6b-068a-e4284555d5ea
msgctxt "h4f5a4e89gab36g43d4g939bg8a97c563c1f7"
msgid "I'll spot my father too, with any luck."
msgstr "운이 좋다면 아버지도 찾을 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Entrance_PAD
#. Speaker = Player
#. NodeID = f6188594-8a4b-1f1c-9366-81d122eea215
