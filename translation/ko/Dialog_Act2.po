#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:0d1ddfd7-0fe2-425b-be9d-8cb00114b5a5
msgctxt "ha52dfe5cge437g4e2cgab96g37d79dd69494"
msgid "I don't want to leave."
msgstr "떠나고 싶지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = 10874448-5c00-153d-b999-2cc3329a12cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44186665-ec97-674d-c483-096c9f7acd28_C = True
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_C = False
#.     - 44186665-ec97-674d-c483-096c9f7acd28_B = False
#.     - 44186665-ec97-674d-c483-096c9f7acd28_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:10874448-5c00-153d-b999-2cc3329a12cd
msgctxt "he424a6eegd21fg499fgb0ccg6ebe579f6314"
msgid "There must be another way to the city."
msgstr "분명히 다른 길이 있을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 15ca0b0b-3500-69aa-276d-e218220a0741
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44186665-ec97-674d-c483-096c9f7acd28_B = True
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:15ca0b0b-3500-69aa-276d-e218220a0741
msgctxt "hb46375ceg8739g4b98g9c03g6297f4696042"
msgid "Fine. We'll rest here for a while."
msgstr "좋아. 한동안 여기서 쉬도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 2059b385-d5ae-7778-7a45-64006cf974c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:2059b385-d5ae-7778-7a45-64006cf974c0
msgctxt "h90d75eacg2554g4e71ga4a5gdcb8d627b4ee"
msgid "Securing passage to the city comes first."
msgstr "발더스 게이트로의 경로를 확보하는 게 먼저야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 26bafde6-5f43-a85c-512c-634ce648dfcd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:26bafde6-5f43-a85c-512c-634ce648dfcd
msgctxt "he45ace53gdc36g47degb0c1gc47203929ebc"
msgid "I know."
msgstr "알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 2b039f57-e27c-c099-a4aa-6457574ae2ce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:2b039f57-e27c-c099-a4aa-6457574ae2ce
msgctxt "he9f85069ge548g480eg8f4bg2aac6895c7ad"
msgid "Damn it all - I thought we'd be closer to the city."
msgstr "제기랄, 도시에 좀 더 가까이 왔을 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = 2b2ea366-3de6-1d4a-43e7-10a8ca7129d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:2b2ea366-3de6-1d4a-43e7-10a8ca7129d2
msgctxt "h4d9eedccg54d0g46begae59ge613faead39f"
msgid "We should place a grave marker for Nickels - somewhere warm and cosy."
msgstr "니클스의 묘비를 세워야 합니다, 양지바른 곳에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = 337071fb-0358-427a-a18c-a1f032fb81ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:337071fb-0358-427a-a18c-a1f032fb81ce
msgctxt "hd1d9c207g5f20g452fg812ag1947cad5b2c0"
msgid "It's all right - just breathe."
msgstr "괜찮아, 일단 심호흡해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nickels
#. NodeID = 39d3bcb5-0876-d0e3-9a4d-869c81cbd12e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44186665-ec97-674d-c483-096c9f7acd28_B = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:39d3bcb5-0876-d0e3-9a4d-869c81cbd12e
msgctxt "h7c384107gfff1g428cga613ge728be759348"
msgid "The city is far. The air is heavy - dangerous. Too much."
msgstr "도시는 아직 멀었어요. 공기 자체가 몹시 위험합니다. 견디기 힘들어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = 3b076e16-6092-0816-2856-b6dea359811f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:3b076e16-6092-0816-2856-b6dea359811f
msgctxt "hc1f91cf4gec31g4cfdgb4c8gc574b5c1e0ab"
msgid "I agree, sir. This gives us time to regroup."
msgstr "동의합니다. 재정비 할 시간을 벌어줄 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nickels
#. NodeID = 3dc93cb5-f2a3-abe8-5ee9-3b82d1770ab1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:3dc93cb5-f2a3-abe8-5ee9-3b82d1770ab1
msgctxt "h122fcff9gdde3g45a6g9c14g897f65b1f183"
msgid "No sleep makes mistakes. Mistakes means death."
msgstr "수면 부족은 실수를 불러옵니다. 실수는 죽음을 의미하고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 3eddd32b-ec59-0a25-b23e-b0f1c32afdf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:3eddd32b-ec59-0a25-b23e-b0f1c32afdf9
msgctxt "h69b7c4bdg8245g4bf8g82f8gd4b77dacfdf6"
msgid "I need you to focus, all right? The plan cannot fail."
msgstr "집중해야 해, 알겠어? 계획이 실패하면 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = 3f40313c-5761-5d90-bada-bacdeca74e36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:3f40313c-5761-5d90-bada-bacdeca74e36
msgctxt "h60cc4227gd9e6g4f9bg920ag4da21a7bf7e2"
msgid "Of course, sir."
msgstr "물론입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 410f12d9-1dab-5d54-53aa-39255b4b95fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:410f12d9-1dab-5d54-53aa-39255b4b95fc
msgctxt "h647aa5e3ga66bg4036g97dbgc98039f254e9"
msgid "Otherwise, we're on our own."
msgstr "그게 아니라면, 우리 스스로 해내야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 47cba72f-ed47-903a-dfca-42f0f1a00cfb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44186665-ec97-674d-c483-096c9f7acd28_C = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_C = False
#.     - 44186665-ec97-674d-c483-096c9f7acd28_B = False
#.     - 44186665-ec97-674d-c483-096c9f7acd28_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:47cba72f-ed47-903a-dfca-42f0f1a00cfb
msgctxt "h296699aegfda0g417bg9d4bg93efed2c9bfd"
msgid "Curses - why did we land so far from Baldur's Gate?"
msgstr "빌어먹을. 어째서 발더스 게이트 근처도 못 가 상륙하게 된 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = 4ece378d-52c8-2349-fe5f-0576ba76857a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44186665-ec97-674d-c483-096c9f7acd28_C = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_C = False
#.     - 44186665-ec97-674d-c483-096c9f7acd28_B = False
#.     - 44186665-ec97-674d-c483-096c9f7acd28_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:4ece378d-52c8-2349-fe5f-0576ba76857a
msgctxt "h50124011g2614g47fdg9d30g2e804d5352bd"
msgid "What of the others? In the Underdark?"
msgstr "언더다크에 있는 다른 이들은요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nickels
#. NodeID = 53c67858-1323-e527-3a43-66685a4d8225
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:53c67858-1323-e527-3a43-66685a4d8225
msgctxt "hf44a8b05gcfaag47d7ga370gea14579f1a3c"
msgid "Not by foot. The air is heavy - deadly. Too much. Too dangerous."
msgstr "도보로는 안 됩니다. 공기 자체가 몹시 치명적이에요. 견디기 힘들어요. 너무 위험합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = 55c7db1f-71f8-3a0b-3a0c-04b6d1d61237
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:55c7db1f-71f8-3a0b-3a0c-04b6d1d61237
msgctxt "he86f2be5g77a3g4e8dgbc2dg4bdeb66fdf63"
msgid "The plan will go ahead, sir. We'll make sure of it."
msgstr "계획은 진행될 겁니다. 저희가 확실히 하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 580fa1b9-2df2-2630-f7fe-c2dcb68fae5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:580fa1b9-2df2-2630-f7fe-c2dcb68fae5c
msgctxt "had7e869dg1f56g4183ga24bg7596202e9f43"
msgid "We make it to the city or we die - it's that simple."
msgstr "도시에 가든지 죽든지 둘 중 하나라고. 그게 전부야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nickels
#. NodeID = 5e5258c2-2b1f-55f3-92bc-decad8a642f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:5e5258c2-2b1f-55f3-92bc-decad8a642f8
msgctxt "hcd521d20g7cfag46c4ga96cge91c1a83e092"
msgid "I miss Nimble."
msgstr "님블이 보고싶어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = 5eb9379f-27e4-4548-8aa8-8fc9d59d4e1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:5eb9379f-27e4-4548-8aa8-8fc9d59d4e1d
msgctxt "h4cbf3f95g1756g43f9ga0e3g32857602264c"
msgid "We don't have a choice."
msgstr "어쩔 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 6c5addc7-9d9f-2b25-33b9-cc2cb6819b52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:6c5addc7-9d9f-2b25-33b9-cc2cb6819b52
msgctxt "he1226a2fgb502g4d1cga6f6gd92d9ee80d90"
msgid "The Ironhand Gnomes cannot fail."
msgstr "아이언핸드 노움은 실패할 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nickels
#. NodeID = 77ed2f71-1aee-8922-ea9d-2da52e7791aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:77ed2f71-1aee-8922-ea9d-2da52e7791aa
msgctxt "hfb5b4e76g28aeg43e4g8436g04737facbec8"
msgid "Reinforced walls, secured entrance. Here is good - safe."
msgstr "강화된 목책에, 물샐틈없는 경비. 여기도 지내기엔 꽤 안전합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 7eefae6d-dc73-bd26-cec2-62842b954966
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:7eefae6d-dc73-bd26-cec2-62842b954966
msgctxt "h7f07503cga8cfg4c52g87d4gfe353785b66b"
msgid "Then we leave for Baldur's Gate."
msgstr "그러고 나서 발더스 게이트로 떠난다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nickels
#. NodeID = 80a94249-c76a-4ab4-8859-9c88597eb2d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:80a94249-c76a-4ab4-8859-9c88597eb2d1
msgctxt "h417c8c56g6e58g402cg97c3g2cf85fe155c2"
msgid "Outside the air is heavy - dangerous. We can't."
msgstr "바깥 공기는 몹시 위험해. 선택권이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 83f4a1ad-4892-254e-84b2-646522ad7775
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44186665-ec97-674d-c483-096c9f7acd28_A = True
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:83f4a1ad-4892-254e-84b2-646522ad7775
msgctxt "h15f6380egbf8bg42e4gb670ge739bad6126a"
msgid ""
"Have you forgotten what's at stake? You're Ironhand Gnomes - act like it."
msgstr "뭐가 중요한지 잊었나? 넌 아이언핸드 노움이야. 그것답게 행동해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = 8660b5d3-a439-3413-530d-9ecc88a7e7bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44186665-ec97-674d-c483-096c9f7acd28_A = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:8660b5d3-a439-3413-530d-9ecc88a7e7bd
msgctxt "hc561529cg38b1g49fegab68g8a394e886219"
msgid "Crying does not help us."
msgstr "우는 건 도움이 안 된다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = 930aa767-040b-64c2-9098-7a16ce433093
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44186665-ec97-674d-c483-096c9f7acd28_A = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:930aa767-040b-64c2-9098-7a16ce433093
msgctxt "hea3c6a89g61f8g4d96gb59cg5ede00ca3bec"
msgid "Did Nickels have any family in the city?"
msgstr "발더스 게이트에 니클스의 가족이 있나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nickels
#. NodeID = 9538feea-0ab4-4955-9a53-b2f290ef4717
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:9538feea-0ab4-4955-9a53-b2f290ef4717
msgctxt "h7efe76d6ge1c8g4fb0gb2e8g110bad2c7ffb"
msgid "Not without Wulbren."
msgstr "울브렌 없인 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nickels
#. NodeID = 98f71192-58fb-449b-b171-e25e04bf40dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_1 = False
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:98f71192-58fb-449b-b171-e25e04bf40dd
msgctxt "h7dcfa903g8193g46a4g8d97g1daaa95f09a6"
msgid "What do we do?!"
msgstr "이제 어떡해?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = 9d8ea4a4-9399-43e7-aa60-21df2342c47e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44186665-ec97-674d-c483-096c9f7acd28_C = True
#.   Script:
#.      - GEN_IsSpeakerPresent_1 = False
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_C = False
#.     - 44186665-ec97-674d-c483-096c9f7acd28_B = False
#.     - 44186665-ec97-674d-c483-096c9f7acd28_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:9d8ea4a4-9399-43e7-aa60-21df2342c47e
msgctxt "h6212d60bgc382g42feg9521gd36a2ea37f13"
msgid "Let's take a break - catch up on some sleep."
msgstr "쉬자. 잠도 좀 보충하고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = a185ca5d-023d-6646-66e8-92d03fc9d1b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:a185ca5d-023d-6646-66e8-92d03fc9d1b0
msgctxt "h6d9d3f98g700ag442dg8095g42f1dac2eff1"
msgid "Get to the city. The plan proceeds from there."
msgstr "발더스 게이트에 도착하는 것. 계획은 거기서부터 진행될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nickels
#. NodeID = ad97b2fa-98de-80e6-4272-4f6a5ef8d47c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:ad97b2fa-98de-80e6-4272-4f6a5ef8d47c
msgctxt "h28bf9928g23dcg4097g85a4gbe6191fd04d4"
msgid "*Sniffle.*"
msgstr "*훌쩍.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = b5f9ad7b-5b0b-4e51-9c84-3f7de55ef9c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:b5f9ad7b-5b0b-4e51-9c84-3f7de55ef9c4
msgctxt "h2efebf7cgc4a6g45d9g834eg1eec78054bdd"
msgid "Wulbren can't come with us - it's just you and me now."
msgstr "울브렌은 함께 갈 수 없어. 이젠 너와 나뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nickels
#. NodeID = ba164f39-16b7-861c-b91d-d41d252880c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:ba164f39-16b7-861c-b91d-d41d252880c6
msgctxt "h4aa19cf7gb192g49e0g96ccg69157e2e9a84"
msgid "But Wulbren isn't here! What do we do?"
msgstr "하지만 울브렌이 없잖아! 어쩌지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = bb149be8-2b67-23ba-4bd9-f19546d9bf34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:bb149be8-2b67-23ba-4bd9-f19546d9bf34
msgctxt "h6673fabdg3021g4237gb420g121da7bbfcab"
msgid ""
"Nimble was an excellent Ironhand Gnome - she'll be difficult to replace."
msgstr "님블은 훌륭한 아이언핸드 노움이었어. 빈자리를 채우기 힘들 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = c740ee85-136d-b3a7-dae3-567223a96147
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44186665-ec97-674d-c483-096c9f7acd28_B = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#. SetFlags:
#.   Local:
#.     - 44186665-ec97-674d-c483-096c9f7acd28_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:c740ee85-136d-b3a7-dae3-567223a96147
msgctxt "hceea8e6egca7fg486dga053ge0f7574f61d8"
msgid "What's our next move?"
msgstr "저희 다음 행동은 뭐죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = ca5eba06-f602-4b5f-aacf-6db6938303b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:ca5eba06-f602-4b5f-aacf-6db6938303b1
msgctxt "h8f2b1524g4d73g44aaga166g60eede592a8e"
msgid "We'll figure this out - one step at a time."
msgstr "한 번에 하나씩 차근차근 알아 가면 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nimble
#. NodeID = cbac0d74-b414-3295-21f9-0b59e8cbeec9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:cbac0d74-b414-3295-21f9-0b59e8cbeec9
msgctxt "h6c7a3099gc822g46c2g9f24gb154ce79c229"
msgid "We're with you to the end, sir, but we're exhausted."
msgstr "저흰 당신과 끝까지 함께할 겁니다. 하지만 저흰 지쳤습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = cd72dcd3-ef15-f319-dd64-769b7aef33d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:cd72dcd3-ef15-f319-dd64-769b7aef33d8
msgctxt "hb6b3e4cfg1862g437cgaf60gb021c9d13e59"
msgid "I appreciate you and Nickels were close, but I need you to focus."
msgstr "네가 니클스와 친했다는 것은 잘 알지만, 집중해야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = d7f71808-3e51-fea9-ebca-7cd7b5ccedfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:d7f71808-3e51-fea9-ebca-7cd7b5ccedfa
msgctxt "hdd287b6fg88a4g4cf4gaa12g8310ae5ec794"
msgid "If they're alive, they'll meet us in the city."
msgstr "살아있다면, 발더스 게이트에서 만나게 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Wulbren Bongle
#. NodeID = e66a976e-b903-b05b-6bb9-f69c7294976d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:e66a976e-b903-b05b-6bb9-f69c7294976d
msgctxt "h6b5d6b6ag76fdg4a4egba6fg0dba2d91aaf9"
msgid "We've been gone too long as it is. Now is not the time to dilly-dally."
msgstr "우린 너무 오랫동안 떠나 있었다. 꾸물거릴 시간이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners
#. Speaker = Nickels
#. NodeID = edb18c84-99ba-9594-f25c-73580af1478b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_ReturnedPrisoners:edb18c84-99ba-9594-f25c-73580af1478b
msgctxt "hefa828dbg9ab0g43a1gba6cgb8658407b560"
msgid "Sorry."
msgstr "죄송해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = 18816111-cabc-44f4-ab1b-07bd77a4b8eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 504e1197-1252-506f-3201-768a785c0873_A = True
#. SetFlags:
#.   Local:
#.     - 504e1197-1252-506f-3201-768a785c0873_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion:18816111-cabc-44f4-ab1b-07bd77a4b8eb
msgctxt "h8ef48bf8gf52fg4404g9fe6gde97231a6397"
msgid "There must be another way to the city."
msgstr "도시로 향하는 다른 길이 분명 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 24b7a449-b5b6-4564-a6a2-865a3b4abb18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 504e1197-1252-506f-3201-768a785c0873_B = True
#. SetFlags:
#.   Local:
#.     - 504e1197-1252-506f-3201-768a785c0873_B = False
#.     - 504e1197-1252-506f-3201-768a785c0873_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion:24b7a449-b5b6-4564-a6a2-865a3b4abb18
msgctxt "h2de2fddcgd9deg4d56ga1f6gd2c09277c3bd"
msgid "I'm no eavesdropper! Wulbren, please."
msgstr "엿듣고 그런 게 아니야! 울브렌, 제발."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 2954a85c-9b07-8951-514b-0d58e6a0e9ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion:2954a85c-9b07-8951-514b-0d58e6a0e9ff
msgctxt "h619d1a0cg3d03g48aag9657g0e7755f9131f"
msgid "Wulbren, it's me."
msgstr "울브렌, 나야 나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = 2fa53306-539a-4c53-d4e7-0ed4b1651e9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion:2fa53306-539a-4c53-d4e7-0ed4b1651e9e
msgctxt "h91bcb2a7g92e3g4d2ega2d0g4c1944d91eec"
msgid "Yet I don't recall asking for a stranger's opinion. Be on your way."
msgstr "누군지도 모르는 사람한테 의견을 물어본 적은 없는 것 같은데. 갈 길 가쇼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 60d9c8c4-4388-fe8c-4ddd-04c0b5f3a65e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion:60d9c8c4-4388-fe8c-4ddd-04c0b5f3a65e
msgctxt "hc745abcdg2746g4732ga5fbg5af9e74646eb"
msgid "Perhaps I could be of assistance?"
msgstr "내가 도움이 될 수 있을 것 같은데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 67db947a-e8f2-f925-f59c-19f12eea55b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion:67db947a-e8f2-f925-f59c-19f12eea55b7
msgctxt "ha1c35a90g94e5g42f3g9045g23340108322e"
msgid "I'm no stranger!"
msgstr "모르는 사람이 아냐!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = 74275601-53f3-49c7-8cce-d7f72cb17409
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 504e1197-1252-506f-3201-768a785c0873_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion:74275601-53f3-49c7-8cce-d7f72cb17409
msgctxt "h149002ffgaa9dg4a19ga9b8gc4ed5f22b923"
msgid "A moment."
msgstr "잠시만. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = c364c883-d8f5-87ad-b7a4-b53a2bfe5b35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion:c364c883-d8f5-87ad-b7a4-b53a2bfe5b35
msgctxt "h7671dfbcg2431g4438g9c90g795feba07346"
msgid "I said, a <i>moment. </i>"
msgstr "<i>잠시만 </i>이라고 했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = c57747b7-84b3-41e4-b582-449e7e504483
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_Reunion:c57747b7-84b3-41e4-b582-449e7e504483
msgctxt "h8e340265g508eg4320g89dbg0171c41047fd"
msgid "I have little time for eavesdroppers."
msgstr "몰래 엿듣는 놈한테 쓸 시간 따윈 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_SeekingWulbren
#. Speaker = Barcus Wroot
#. NodeID = aedf88f4-5950-53bd-e7aa-55c9f29f20cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 96c86265-27c6-ccc7-daa5-f4984c18c5ba_StartSearch = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_SeekingWulbren:aedf88f4-5950-53bd-e7aa-55c9f29f20cd
msgctxt "h32f68c54g01f3g477ag86fag36243e8320d2"
msgid "Ah!"
msgstr "아!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_SeekingWulbren
#. Speaker = Barcus Wroot
#. NodeID = d7382a34-0a9f-b0a9-8850-72152b659698
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 96c86265-27c6-ccc7-daa5-f4984c18c5ba_StartSearch = False
#. SetFlags:
#.   Local:
#.     - 96c86265-27c6-ccc7-daa5-f4984c18c5ba_StartSearch = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_AD_SeekingWulbren:d7382a34-0a9f-b0a9-8850-72152b659698
msgctxt "h2d0b9dfbg8f28g4706g9271gb72a49ccbde1"
msgid "Wulbren! Where is he?"
msgstr "울브렌! 대체 어딨는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001
#. Speaker = Nimble
#. NodeID = 1dfcf927-41fa-4c0f-ffa5-82842ca16111
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Gnome001_HasMetAlert(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001:1dfcf927-41fa-4c0f-ffa5-82842ca16111
msgctxt "h515049dcgbe93g4b25g9902g95b9b10bf8da"
msgid "Aren't you going to take down Ketheric? We'll support you from here."
msgstr "케서릭을 쓰러뜨리러 갈 거지? 우린 여기서 당신을 돕겠어. \n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001
#. Speaker = Nimble
#. NodeID = 373150f4-c3d6-49b0-a780-489cee636c2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Gnome001_HasMetProtected(1) = True
#.   Global:
#.      - HAV_Mood_State_Protected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001:373150f4-c3d6-49b0-a780-489cee636c2d
msgctxt "ha3bab54cgb30ag49e9g867bga3c24ebdb9d8"
msgid "Oh! That'll be all, but thank you!"
msgstr "오! 그게 다야. 아무튼 고마워!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001
#. Speaker = Nimble
#. NodeID = b317145f-847e-261b-928c-4931cf23fdd4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.      - HAV_WrootRequest_Gnome001_NightsongFreed_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001:b317145f-847e-261b-928c-4931cf23fdd4
msgctxt "hfc8363bfg617cg4925ga225gdd426bc9e3b4"
msgid "I suppose you'll be trotting off soon too. Don't let me stop you."
msgstr "당신도 곧 이곳을 떠나지 싶은데. 나 때문에 지체하진 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001
#. Speaker = Nimble
#. NodeID = b6fdfcb8-629d-4a59-81ee-ab7f4deb92ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Gnome001_HasMetProtected(1) = False
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Gnome001_HasMetProtected(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001:b6fdfcb8-629d-4a59-81ee-ab7f4deb92ca
msgctxt "h52319373ga253g4f7fg9dd0g0feef2a00775"
msgid ""
"I suppose this place will do for now. Better than a cell in the Towers, at "
"the very least."
msgstr "이 정도면 충분히 괜찮은 곳이로군. 아무리 못해도 문라이즈 타워 감옥 보다야 훨씬 낫지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001
#. Speaker = Nimble
#. NodeID = d020494e-41a3-b27d-523f-6c3cb314abd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001:d020494e-41a3-b27d-523f-6c3cb314abd2
msgctxt "h3bc69bb8g2477g4551g9787gb9dd4277c129"
msgid ""
"I'd thank you for your help, but I doubt you need to hear such trivialities. "
"So I'll just say fare-thee-well."
msgstr "도와줘서 고맙다고 하고 싶지만, 당신한테 그런 인사치레는 그닥 쓸모가 없을테니, 대신 행운을 빌어주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001
#. Speaker = Nimble
#. NodeID = d7188f19-15ed-0822-3850-0d57e0f11d6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#.      - HAV_WrootRequest_Gnome001_NightsongFreed_HasMet = False
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Gnome001_NightsongFreed_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001:d7188f19-15ed-0822-3850-0d57e0f11d6b
msgctxt "h521e097egaccbg4b54gb165g1f696854d3d0"
msgid ""
"I say, every last soldier in this place has abandoned us. So much for duty."
msgstr "여기 군인들은 하나도 빠짐없이 우리를 져버렸어. 의무 좋아하시네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001
#. Speaker = Nimble
#. NodeID = f20d99a7-2c3b-41ea-f5c2-31b25b62c50a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Gnome001_HasMetAlert(1) = False
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Gnome001_HasMetAlert(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome001:f20d99a7-2c3b-41ea-f5c2-31b25b62c50a
msgctxt "hfdf59299g4895g4355g8c7cgd937ff5b3f0c"
msgid ""
"Ketheric's forces are infiltrating this place - you've got to take the fight "
"to <i>them!</i>"
msgstr "케서릭의 군세가 이 곳으로 밀려들고 있어. 그러니 <i>놈들의 본거지</i>로 쳐들어가야 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002
#. Speaker = Nickels
#. NodeID = 1d69f412-c022-ff7a-fb8d-439d818d3dab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Gnome002_NightsongFreed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002:1d69f412-c022-ff7a-fb8d-439d818d3dab
msgctxt "h0a8b3302gbff3g42c8ga00fgddbf7c830a59"
msgid ""
"I don't like the sky, it's too big - too empty. Whatever made that light "
"isn't our friend. No chance."
msgstr "난 하늘이 싫어. 너무 큰데다, 텅 비어있거든. 저 빛을 만든 게 뭔지는 몰라도, 우호적일리 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002
#. Speaker = Nickels
#. NodeID = 275f1df0-0c8c-45e0-a38b-8aabdb57f08c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Gnome002_ProtectedHasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_Protected = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002:275f1df0-0c8c-45e0-a38b-8aabdb57f08c
msgctxt "h561507feg342eg410cga23fg7cf46e83cab6"
msgid ""
"Good foundations. Hear that? Place was built with love. Symmetry. Glad to be "
"here. Thank you."
msgstr "훌륭한 근거지로군. 들었어? 사랑으로 만들진 곳이야. 조화가 느껴져. 이 곳에 올 수 있어 다행이야. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002
#. Speaker = Nickels
#. NodeID = 56063022-de39-44e6-aff9-9c66b44d368c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Gnome002_AlertHasMet(1) = False
#.   Global:
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Gnome002_AlertHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002:56063022-de39-44e6-aff9-9c66b44d368c
msgctxt "h5791ec30g4ea9g465cg944cg3ec8cbe41e05"
msgid ""
"The Towers were here. Soot - sulphur - limestone. Dusted all over. Signature."
msgstr "놈들이 여기 왔었군. 검댕, 유황, 석회암에다, 전부 먼지를 뒤집어썼잖아. 척 보면 알지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002
#. Speaker = Nickels
#. NodeID = 86443bac-32e3-7d9c-2a12-3d928c1e6c29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Gnome002_NightsongFreed_HasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002:86443bac-32e3-7d9c-2a12-3d928c1e6c29
msgctxt "h8cf6d2d5gb0adg4a79g87b2gd29cfe242ce8"
msgid "I just want to stay here - away from the Towers. Away from the light."
msgstr "그냥 여기 그대로 있고 싶어. 타워와 그 빛으로부터 멀리 떨어진 채로 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002
#. Speaker = Nickels
#. NodeID = c31ff972-bddd-41f9-9ce1-3da3eca2deb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Gnome002_ProtectedHasMet(1) = False
#.   Global:
#.      - HAV_Mood_State_Protected = True
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Gnome002_ProtectedHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002:c31ff972-bddd-41f9-9ce1-3da3eca2deb0
msgctxt "hcb6428ccge00eg464agab96g96eda65f3c6a"
msgid "We made it safe. Firm ground - thanks to you. Won't forget it."
msgstr "안전하게 빠져나왔어. 당연한 말이지만 당신 덕분이지. 잊지 않을게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002
#. Speaker = Nickels
#. NodeID = cbcddf12-1e46-411c-bb93-ef649b7d1c18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Gnome002_AlertHasMet(1) = True
#.   Global:
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Gnome002:cbcddf12-1e46-411c-bb93-ef649b7d1c18
msgctxt "h9afa6644g1fcdg4d29gb69fg11db9456e481"
msgid "I hope you get 'em. Ketheric and the like. I know you can."
msgstr "놈들을 쓰러뜨리길 바라. 케서릭과 그 무리들 말이야. 당연히 그렇게 하겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 001afb06-7682-88af-1ba1-b906824ec536
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_FriendTalkOver = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:001afb06-7682-88af-1ba1-b906824ec536
msgctxt "h40f33b7fgab7ag48d6g8e93gf5cfa99bb30b"
msgid ""
"You risked your life for Wulbren several times over - don't you think he "
"should be a bit more grateful?"
msgstr "너는 울브렌을 위해 몇 번이고 목숨을 걸었어. 그가 좀 더 감사해야 한다고 생각하지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 02f68292-184a-2477-1c7b-81fdc6c72da0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:02f68292-184a-2477-1c7b-81fdc6c72da0
msgctxt "haad8c361g6120g49a7g8503g83d7192cede7"
msgid "I'm not stuck. I came to find <i>you, </i>of course."
msgstr "여기서 발목 잡힌 게 아냐. <i>널</i> 찾으러 온 거지, 당연히."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 07fe37a7-8978-611b-7cd7-0ab15a9b2d0b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Reunion_CalledWulbrenPrick = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:07fe37a7-8978-611b-7cd7-0ab15a9b2d0b
msgctxt "h8550e0d4g31efg4467g9841g535a9e9c4d29"
msgid "Prick."
msgstr "좆같은 새끼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 1787a050-3b23-b3ac-a08a-8d1f7d6d1097
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:1787a050-3b23-b3ac-a08a-8d1f7d6d1097
msgctxt "h6e48e73bg0e05g4509g9c08g8b35949bd765"
msgid "Not really. You're a bit of a wet blanket."
msgstr "전혀. 찬물 한 번 제대로 끼얹는구만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 1f827909-f994-8a3c-4515-5bfdcf6e21cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_BarcusCameFromCamp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:1f827909-f994-8a3c-4515-5bfdcf6e21cb
msgctxt "h0cea79ecgf6ccg483eg937eg00bcfae00506"
msgid "With a little luck, I'll still see you at camp later."
msgstr "운이 따라준다면, 나중에 야영지에서 볼 수 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 21eeeef2-c47e-d35a-45b0-7487747e8b84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:21eeeef2-c47e-d35a-45b0-7487747e8b84
msgctxt "hb13d8d43gd1dcg4c13g8a3fg856f030e3c2a"
msgid ""
"Don't judge him too harshly. He's been through a lot. When he's had some "
"rest, he'll be back to his usual self."
msgstr "너무 안좋게만 판단하진 마. 그는 많은 일을 겪었어. 좀 쉬고 나면, 원래 자신으로 돌아올 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = 24dd8708-e085-4b92-2d08-5bf03d0f3b76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:24dd8708-e085-4b92-2d08-5bf03d0f3b76
msgctxt "hba83eea3g60bdg46bbgb1f4g12528405f576"
msgid "<i>I said go home!</i>"
msgstr "<i>집으로 가라고 했지!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 258a9c88-d5ee-d3dd-2541-2d2a47d53ae6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:258a9c88-d5ee-d3dd-2541-2d2a47d53ae6
msgctxt "h5e136d02ge224g4ef8g8a4fg09adc7d74384"
msgid "Good idea."
msgstr "좋은 생각이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 2c69e686-6187-ba01-5c54-46c8c0c03cdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:2c69e686-6187-ba01-5c54-46c8c0c03cdc
msgctxt "h03adacbcgc30cg4ddagbc82geb8eb7d3506a"
msgid ""
"The very same to you. Though with your record, I very much doubt you'll need "
"it."
msgstr "너도 마찬가지야. 그렇지만 네가 해낸 일을 보면, 그다지 행운이 필요할 것 같진 않군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 2cf21d80-f269-6d5e-a22e-54cf4d53cccd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:2cf21d80-f269-6d5e-a22e-54cf4d53cccd
msgctxt "h510dffd6g32b8g421eg9226g660fee2a0838"
msgid ""
"There's no need for gratitude between Wulbren and myself. His interests are "
"my interests, and vice versa."
msgstr "울브렌과 나 사이에 감사 인사는 필요 없어. 그 친구 생각이 곧 내 생각이야. 반대도 마찬가지고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 2e5a71ab-9fe0-68a7-338d-580f12d54080
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_TalkedToWulbrenInHaven = True
#.     - HAV_WrootRequest_State_ReunionDone = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:2e5a71ab-9fe0-68a7-338d-580f12d54080
msgctxt "h1643ccb4g6ac8g4535g9240g787da1380364"
msgid "<i>Wulbren!</i>"
msgstr "<i>울브렌!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 3571f20b-cf74-e275-9ab4-7e39effdb416
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:3571f20b-cf74-e275-9ab4-7e39effdb416
msgctxt "h3de91cbdg4ac6g4f0eg8d87g1c86561ba56d"
msgid "Please - that isn't necessary."
msgstr "제발 - 이럴 필요 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 3c49a5c2-e127-d580-048f-49142ac2505a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_BarcusCameFromCamp = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:3c49a5c2-e127-d580-048f-49142ac2505a
msgctxt "h8508ccd6gd8fdg4f21gb4b6gaf575220d4ca"
msgid "Why don't you join my camp once we're ready to leave these lands?"
msgstr "이 땅을 떠날 준비가 되면 내 야영지에 합류하는 게 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 3c56935a-9f14-3d0c-73d2-dcf8cf208712
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:3c56935a-9f14-3d0c-73d2-dcf8cf208712
msgctxt "h058cb361gefeag4a9dg943dg8f7846e676cc"
msgid "Now! I believe our business is well and truly concluded."
msgstr "그래서! 우리 사이의 일은 진정으로 깔끔하게 마무리된 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 3cdc8a2c-74d6-d8e9-3c68-d98de4a005ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:3cdc8a2c-74d6-d8e9-3c68-d98de4a005ba
msgctxt "he6fbc338gd7c6g4f1dgaf38g54f470dac3e0"
msgid ""
"I'm glad you agree. Well! I'll just - erm - stand over there. In case "
"Wulbren needs anything."
msgstr "동의해줘서 기쁘군. 좋아! 난 그냥...음... 저기 서 있을까 봐. 여차할 때 울브렌을 도울 수 있게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 3d74f169-6844-92e1-e226-f5f9f42e57cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_FriendTalkOver = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:3d74f169-6844-92e1-e226-f5f9f42e57cd
msgctxt "h03c82a2cg8d06g49cfg8ae5gb6bece6b8bfc"
msgid "<i>You </i>don't owe me, Barcus. If anything, Wulbren does."
msgstr "넌 나에게 빚진 게 없어, 바커스. 빚진 게 있다면 울브렌이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 3f589669-207d-c65b-50f9-7a2b95bda19e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:3f589669-207d-c65b-50f9-7a2b95bda19e
msgctxt "h08b34a71gfa36g4e72gb882gb37d1c2e9523"
msgid "You really care about him, don't you."
msgstr "그를 정말 아끼는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 465522f3-4a98-585a-e09b-238cbff8c918
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:465522f3-4a98-585a-e09b-238cbff8c918
msgctxt "hbb862bdcgc377g4ed6gb024ge7faf8661841"
msgid ""
"Well! Perhaps Wulbren is right. Perhaps I ought to return to Baldur's Gate."
msgstr "글쎄! 울브렌이 옳은 것 같아. 발더스 게이트로 돌아가야 할지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 46d500de-0669-6723-9a53-442853448b6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:46d500de-0669-6723-9a53-442853448b6f
msgctxt "hefcc6f6ag1af3g4654g879fg7b05ac9bcd39"
msgid ""
"But - Wulbren - <i>the runepowder</i>. We need to discuss what you're going "
"to -"
msgstr "그.. 근데 울브렌.. 그 <i>룬파우더</i>말이야. 우린 네가 하려는 짓을 의논해 봐야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 482390aa-be06-5997-8953-fe7e0d2431a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:482390aa-be06-5997-8953-fe7e0d2431a3
msgctxt "hc5ca4bcag7a78g45e3g8b82g2d68b3450168"
msgid ""
"There we have it! Wulbren is safe and well, thanks to you. And as you so "
"correctly pointed out, I owe you."
msgstr "이제 됐군! 울브렌은 안전하고 건강해, 네 덕분에. 그리고 네가 정확하게 지적했듯이, 난 네게 빚을 졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 4bb86423-abb6-e2d7-5fdd-5ab710a1c8e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:4bb86423-abb6-e2d7-5fdd-5ab710a1c8e6
msgctxt "h7d0afaeegab50g4942g970cgccdefc760b82"
msgid ""
"Nonsense! When you've known each other as long as we have, there aren't "
"<i>sides. </i>"
msgstr "허튼소리! 우리처럼 오랜 세월 서로 알고 지내면, <i>일방</i> 같은 건 없다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 4f24c113-ed0a-4695-23c5-157d938e4b40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:4f24c113-ed0a-4695-23c5-157d938e4b40
msgctxt "hc22b5ee3g452fg4065gafaeg19b744234b39"
msgid ""
"Let's not be uncivilised. Wulbren, perhaps we can talk more later, when "
"you've had a moment to settle in."
msgstr "우리 야만적으로 굴지 말자. 울브렌, 적응할 시간을 좀 갖고, 나중에 더 얘기해 보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = 5346b88e-bb18-0771-4e03-3a408d31bb58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:5346b88e-bb18-0771-4e03-3a408d31bb58
msgctxt "hc9de3467g1798g4c51g973eg411b64733dc8"
msgid "Say that again."
msgstr "한번만 더 말해보시지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 59ec6e71-28a9-fc13-66f7-a0b86ec22315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:59ec6e71-28a9-fc13-66f7-a0b86ec22315
msgctxt "hd92f6ec3g454eg44afgb0f9ge0f5ce857896"
msgid ""
"Unfortunately for me, you're my friend. Rescuing you from mortal peril is my "
"<i>right.</i>"
msgstr "나에겐 불행하게도, 넌 내 친구잖아. 널 죽을 위기에서 구해내는 건 바로 내 <i>권리</i>라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = 5b78e59d-6993-c550-bf69-cd6f50591384
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:5b78e59d-6993-c550-bf69-cd6f50591384
msgctxt "hdf17038ageb87g4dc0g837bg405ba0a36dfc"
msgid ""
"You don't belong here, Barcus. Soon as the Harpers give word that Moonrise "
"has been handled, you ought to get out of here."
msgstr "여긴 네가 있을 곳이 아니야, 바커스. 문라이즈 타워를 처리했다는 소식을 하퍼즈로부터 듣는 즉시, 넌 여길 떠나야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 5f4b41d7-7f98-d9a0-15d0-ce9db674b590
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_BarcusCameFromCamp = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:5f4b41d7-7f98-d9a0-15d0-ce9db674b590
msgctxt "hb280bbf7g29c0g4d34g879cg4c9d39224c01"
msgid ""
"I'll tell you what: If I make it out alive, why don't you meet me at my camp "
"afterward?"
msgstr "이렇게 하자. 내가 살아남으면, 나중에 내 야영지에서 만나는 게 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 61c5d27c-31db-0d91-5655-7444855a4f10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:61c5d27c-31db-0d91-5655-7444855a4f10
msgctxt "hdd3e7a85g81b3g4c04gbcecg3dd9abb69929"
msgid "I doubt Wulbren agrees."
msgstr "울브렌이 동의할 것 같진 않군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = 629a9c91-c00e-1b97-3cb7-05611362769a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:629a9c91-c00e-1b97-3cb7-05611362769a
msgctxt "hb110128bg02adg496dg94c8g7440b82a613e"
msgid ""
"But you didn't rescue me, did you? I rescued <i>myself</i>, with the aid of "
"this - helper."
msgstr "하지만 네가 날 구한 건 아니잖아? 난 <i>스스로</i> 나왔다고, 이.. 도우미의 도움을 받아서 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = 633658be-e74f-0ad6-8d4c-4c3802fb32f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:633658be-e74f-0ad6-8d4c-4c3802fb32f2
msgctxt "h667479cbg6604g49cag84f7gad48110d0a34"
msgid "Then it's settled. Good day to you both."
msgstr "결론이 났군. 둘 다 좋은 하루 되길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 65e7b1a8-16c9-6646-01ec-a74ab5af0f0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:65e7b1a8-16c9-6646-01ec-a74ab5af0f0a
msgctxt "h865cbb34g014fg4ddbga6f8g15b583283033"
msgid ""
"That's all right. I'm a patient fellow. I'm sure you'll clear a path for "
"everyone soon enough."
msgstr "괜찮아. 난 인내심이 많거든. 네가 곧 길을 뚫어줄 거라 믿고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 6823775b-2e04-8347-4ddc-20190242a55a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:6823775b-2e04-8347-4ddc-20190242a55a
msgctxt "ha3f57381gfbfag448agbfddg36dfcefe0ce1"
msgid "Thank you."
msgstr "고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 6b4469de-7c53-5ed9-b42a-1939945436d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:6b4469de-7c53-5ed9-b42a-1939945436d0
msgctxt "h77ca6f18g8401g4245g98beg3b3638b4e2f5"
msgid "It is. Farewell, Barcus. And good luck."
msgstr "맞아. 작별이야, 바커스. 그리고 행운을 빌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = 6cae3866-1afc-b1cb-e37a-8209d15d6fb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:6cae3866-1afc-b1cb-e37a-8209d15d6fb0
msgctxt "h5d2b8c1dg0a23g46aagaf33g8534308e7fcb"
msgid "If you'll excuse me, I have a great deal to do."
msgstr "실례하지, 중요한 일이 있어서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 6e0ed577-a14e-e8f9-7351-1f24477663de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:6e0ed577-a14e-e8f9-7351-1f24477663de
msgctxt "h82c6aa19g0e47g44dbg9b9eg37a072302fea"
msgid "Oh. That's a little sad, isn't it?"
msgstr "오. 좀 슬픈데, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = 7478800e-3682-f812-fa5f-cfd724859819
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_IronhandGnomes = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:7478800e-3682-f812-fa5f-cfd724859819
msgctxt "h256cfe2dgbcc4g4c50gabbag2b5c05018049"
msgid ""
"Indeed. Neither of you has any clue what's a stake - and why should you? "
"It's Ironhand Gnome business."
msgstr "너희들은 뭐가 중요한지 아무것도 몰라. 알 필요도 없지. 아이언핸드 노움 일이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 77f1861f-1b83-fa92-c062-1291cbb64cd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:77f1861f-1b83-fa92-c062-1291cbb64cd7
msgctxt "h4d8ca306g8670g4560ga541g3d7fd0740727"
msgid "Indeed. He does."
msgstr "맞아. 사실이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 79a56b5b-3b60-8651-25c7-72712025f0bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:79a56b5b-3b60-8651-25c7-72712025f0bb
msgctxt "hcf18ae71gbb92g4e52g9dccg259e16f6ca84"
msgid "I give you: <i>The Brilliant Retort!</i>"
msgstr "네게 <i>화려한 응수</i>를 주겠어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 851b87a9-8735-2f9e-c50c-1b4a1e4f6a8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:851b87a9-8735-2f9e-c50c-1b4a1e4f6a8a
msgctxt "hcfdef140g025bg498eg8c67g3ab8227931c1"
msgid "Hm. Perhaps I will. Yes - yes that's a nice idea."
msgstr "흠. 그럴까. 좋아. 좋은 생각이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 899ed021-b89e-ff24-579b-308488d4fd11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:899ed021-b89e-ff24-579b-308488d4fd11
msgctxt "hd358d0b6g498eg4697g937ag7b4e5dc73bab"
msgid "That'll have to wait - it's lethal out there."
msgstr "그건 좀 기다려야겠는데. 밖은 위험하다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 938e8104-3004-378c-bee1-d0cad611accc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:938e8104-3004-378c-bee1-d0cad611accc
msgctxt "h135fe306gc415g4ae1gb6aag0fb4f45fd8a6"
msgid "Well! Once you're used to someone, you're... used to them."
msgstr "글쎄! 일단 그 사람에게 익숙해지면... 행동도 익숙해지기 마련이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 9928c1ac-9a66-a3b7-8362-e5fac62b22f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:9928c1ac-9a66-a3b7-8362-e5fac62b22f0
msgctxt "hbef35d99g65b8g4da5gab34g6dbb5c212415"
msgid ""
"Of course - but a moment, if you please. Wulbren, I believe we really must "
"discuss -"
msgstr "물론이지, 하지만 잠깐 기다려줘. 울브렌, 우리 정말 의논해야 할 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 9a952818-c3b9-cee6-e8d3-0270d10f630e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:9a952818-c3b9-cee6-e8d3-0270d10f630e
msgctxt "h2c3e8698g9e19g4a5dgb5b5ge26be6f0d49c"
msgid ""
"I certainly hope so, or Withers will be most despondent. Look after yourself."
msgstr "나도 그러길 바라. 안그랬다간 위더스가 낙담할지도 모르잖아. 몸조심 하라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 9b64ae19-382e-7431-2fdc-2a724998fb68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_Knows_BrilliantRetort = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:9b64ae19-382e-7431-2fdc-2a724998fb68
msgctxt "hf1ce2c1egf705g4e5eg8daegab39ad39328f"
msgid "It's a new type of smokepowder. Powerful stuff. Made it myself."
msgstr "새로운 유형의 화약이야. 강력한 거지. 직접 만들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = 9d2faeb4-da3e-9c0c-37a2-29b8b0418611
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:9d2faeb4-da3e-9c0c-37a2-29b8b0418611
msgctxt "h650094a8gad8ag46c1g82bbg1f3cf0981d15"
msgid ""
"Wulbren can be a little sharp, but so can I - you should know that better "
"than anyone."
msgstr "울브렌이 종종 날카로운 모습을 보이긴 하는데, 그건 나도 마찬가지야. 너라면 그 누구보다 잘 알겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = 9ea669f8-97c7-43c4-7c4b-d7857f2cb818
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:9ea669f8-97c7-43c4-7c4b-d7857f2cb818
msgctxt "h2da3bbe0g3d69g4a59g8435ge8dec55091c1"
msgid "You don't know what Barcus has gone through to find you."
msgstr "넌 바커스가 널 찾기 위해 어떤 일을 겪었는지 모를 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = a1d8ae48-a763-f7ac-7e45-685eb5a3351b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:a1d8ae48-a763-f7ac-7e45-685eb5a3351b
msgctxt "h97a586a5g3a52g4f30g9b3bg8a38995f3adc"
msgid ""
"Handy to have in the event of a fire, though. I'd say 'all the best' but we "
"don't know each other that well, do we? All the <i>most middling</i>. Ta."
msgstr ""
"불이라도 났을 땐 아주 유용하겠지. '행운이 가득하길'이라고 하고 싶지만, 우리가 그만큼 친한 사이는 아니잖아? <i>그럭저럭</i> "
"행운이 깃들길. 그럼 이만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = a35c4bf7-9bec-4190-0bae-ee6fe04750b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:a35c4bf7-9bec-4190-0bae-ee6fe04750b6
msgctxt "hc2a7c98cg6cb6g4345g9d56g534c54cf4299"
msgid "One and the same."
msgstr "나도 그렇게 생각해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = a6ae0a51-028b-5ad1-511f-53b3c81f87be
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_FriendTalkOver = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:a6ae0a51-028b-5ad1-511f-53b3c81f87be
msgctxt "hfd3ea054g334ag4949gaf86g4bb592833d43"
msgid "Thank you."
msgstr "고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = ad3dfd03-ca6a-95d4-6db7-b06988abc5de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:ad3dfd03-ca6a-95d4-6db7-b06988abc5de
msgctxt "h9e32de7ag863ag4f86gace7g7876ade546c9"
msgid "Why would you do a foolish thing like that? Really, Barcus."
msgstr "왜 그런 바보 같은 짓을 한 거야? 정말이지, 바커스."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = b14ed8ad-7b61-8b7a-c891-af94f990e46d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:b14ed8ad-7b61-8b7a-c891-af94f990e46d
msgctxt "h518940c2gd3fbg477fg979bg5520277460ee"
msgid "He's got a point, Barcus."
msgstr "그의 말이 맞아, 바커스."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = b239d372-3dd4-6029-c92a-62267e7345c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:b239d372-3dd4-6029-c92a-62267e7345c2
msgctxt "h0fdd67d8g131bg4a6dgb458g535968ef8cca"
msgid "Your relationship seems rather one-sided."
msgstr "너희 관계는 일방통행인 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = be9955d3-bdca-3d97-7245-8b5e8da930ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_GaveGift = False
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_GaveGift = True
#.     - HAV_WrootRequest_Event_FriendTalkOver = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:be9955d3-bdca-3d97-7245-8b5e8da930ab
msgctxt "h41573d44g3874g4ebbgb070g094557192781"
msgid "<i>The Brilliant Retort</i>, for starters. Here you are, as promised."
msgstr "<i>화려한 응수</i>야. 여기 있어, 약속한 대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = bed51936-0c38-6c5a-7a16-311b19956400
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:bed51936-0c38-6c5a-7a16-311b19956400
msgctxt "hd500ecbfgef85g4296gbb0eg3bf1efc7b46a"
msgid "Sure. Now: I've business to attend to. Good day to you both."
msgstr "그래. 자, 난 이제 볼 일이 있어서. 둘 다 좋은 하루 되길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = c9402171-07f1-2acb-ddd0-1500c706490a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:c9402171-07f1-2acb-ddd0-1500c706490a
msgctxt "hde6237bdgc2f8g45deg92adg85f126736735"
msgid ""
"Ah. I'd heard you might be about. How the devil did you get stuck here, "
"Barcus?"
msgstr "아. 네가 여기 있을 거라고 하더군. 어쩌다 이런 데서 발목 잡힌 거지, 바커스?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = cb1c7c5c-55d5-d168-4cc0-78b61dc20ed4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:cb1c7c5c-55d5-d168-4cc0-78b61dc20ed4
msgctxt "h888abc0dg39b2g4be3ga738gd3f906aaa327"
msgid "You don't know him, though. This is just his way."
msgstr "넌 울브렌이 어떤 사람인지 몰라. 이게 울브렌의 방식이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = cec2fb00-6606-eb21-c945-85e1e9234dab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_State_NightsongFateDecided = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:cec2fb00-6606-eb21-c945-85e1e9234dab
msgctxt "hbb7132b1gaba7g41d8g87a3gfd82986cdfe7"
msgid ""
"I'm heading to the Towers to face Ketheric Thorm. We may not meet again."
msgstr "나는 케서릭 쏨을 대면하러 타워로 갈 거야. 너와는 이게 마지막일 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = cf136b3d-7ac7-4b2d-5c31-d33fd4b31fe6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:cf136b3d-7ac7-4b2d-5c31-d33fd4b31fe6
msgctxt "h2ff843eegdc25g49dfg8d42ge2b81649b211"
msgid "What will you do now, Barcus?"
msgstr "이제 어떻게 할 거지, 바커스?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = cfe688d3-76bf-32fa-e9c1-391af1bae75b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_Knows_BrilliantRetort = True
#.      - HAV_WrootRequest_Event_GaveGift = False
#.   Object:
#.      - HAV_WrootRequest_State_HasGift(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:cfe688d3-76bf-32fa-e9c1-391af1bae75b
msgctxt "h45b4ad5cgcfefg40cbga9b7g95547dc03f63"
msgid ""
"You can fight this out on your own time. Barcus, I believe you have "
"something for me."
msgstr "다른 시간에 싸워주길 바라. 바커스, 내게 줄게 있는 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = d1801129-25e5-ce26-fb47-9b4b5e507ff0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_UnfortunateGnome_HasMet(2) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:d1801129-25e5-ce26-fb47-9b4b5e507ff0
msgctxt "h33b5e839g6c37g409ag95c7g88f5541fb819"
msgid ""
"Ah - it's you! I should've guessed. Thank you very much for your help "
"finding Wulbren!"
msgstr "아, 너구나! 그럴 줄 알았어. 울브렌을 찾는 데 도움을 줘서 정말 고마워!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = d9a4ff78-32a2-85bd-5ee8-0ca0ef6e1adb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:d9a4ff78-32a2-85bd-5ee8-0ca0ef6e1adb
msgctxt "haa6c0fa8gbcf3g4d26g9356gc52ced46f04e"
msgid "Wulbren seems like a real arsehole."
msgstr "울브렌이란 놈은 정말 개자식인 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = db5f7240-1a56-428f-c52c-72e2139f3083
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:db5f7240-1a56-428f-c52c-72e2139f3083
msgctxt "h080bb39age1c9g4889g8d75ge68182108170"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = dd893f18-090d-23bc-c6c8-17ae48557c02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:dd893f18-090d-23bc-c6c8-17ae48557c02
msgctxt "h77b8bc07g7472g4e42ga6b6g4a2549ef1f43"
msgid ""
"Well! There we have it. Wulbren is safe and sound, thanks to you. I owe you "
"a great deal."
msgstr "뭐. 이제 된 것 같네. 울브렌은 안전하고 건강하군, 네 덕분에. 너한테 큰 빚을 졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = de44747b-3f5d-9ef8-84ca-ea084e29161c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Mood_State_NightsongFreed = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:de44747b-3f5d-9ef8-84ca-ea084e29161c
msgctxt "h4fc3080dg14f9g4b7dga630g1f83910b5395"
msgid ""
"You don't belong here, Barcus. Soon as the way is clear, pack up and head to "
"Baldur's Gate."
msgstr "여긴 네가 있을 곳이 아니야, 바커스. 길이 뚫리는 대로, 짐 챙겨서 발더스 게이트로 떠나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Wulbren Bongle
#. NodeID = e9bdaa91-5b3f-0c27-f411-d096347ec549
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:e9bdaa91-5b3f-0c27-f411-d096347ec549
msgctxt "h4f7e4d48g553cg440fgb101gd326ba3e58ea"
msgid ""
"Enough, Barcus. Pay your friend whatever it is you owe him and leave me out "
"of it."
msgstr "됐어, 바커스. 네 친구에게 진 빚은 알아서 갚고 난 내버려 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Barcus Wroot
#. NodeID = f8b6e154-5cd7-024f-4fc5-fcbdf821a5fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_Knows_BrilliantRetort = False
#.      - HAV_WrootRequest_Event_GaveGift = False
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_GaveGift = True
#.     - HAV_WrootRequest_Event_FriendTalkOver = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:f8b6e154-5cd7-024f-4fc5-fcbdf821a5fe
msgctxt "h5b30d3d2g2a1ag4af2g850cg254c853c1582"
msgid ""
"<i>The Brilliant Retort</i>, for starters. Here you are. I hope you'll like "
"it."
msgstr "<i>화려한 응수</i>야. 여기 있어. 마음에 들었으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion
#. Speaker = Player
#. NodeID = fc3aa671-d3c2-577c-ed57-c8942e06c506
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Reunion:fc3aa671-d3c2-577c-ed57-c8942e06c506
msgctxt "he230fdadg726fg41e8g838cg4ed9de63d42f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 00834c90-8bf7-636b-a3ce-4d72b99949ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:00834c90-8bf7-636b-a3ce-4d72b99949ad
msgctxt "had67aa05g45cfg4dfeg8b55g3e73043e6a70"
msgid ""
"Very well! I wish you a safe journey. Perhaps I'll see you on the road to "
"the Towers."
msgstr "알겠어. 안전한 여정이 되길. 타워로 가는 길에 또 만날 수도 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 00cecae2-a95a-55b4-f71e-d0515d7c3715
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:00cecae2-a95a-55b4-f71e-d0515d7c3715
msgctxt "ha8637d56gcd96g4345g8c7dg730d333473a8"
msgid ""
"Wulbren needs a hero. Someone like you. And you need a way to protect "
"yourself against the forces of evil, hm?"
msgstr "울브렌에겐 영웅이 필요해. 너같은 영웅말야. 그리고 넌 저 악의 무리로부터 널 보호할 수단이 필요하지 않겠어, 응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 0173990c-a401-299b-8ee4-8951e9f50a23
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_UnfortunateGnome_AllPrisonersDeadHasMet(1) = True
#.   Global:
#.      - MOO_Jailbreak_State_AllPrisonersDied = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:0173990c-a401-299b-8ee4-8951e9f50a23
msgctxt "h586d7c1cg958cg4e2bg9f24gbce35c3de7f1"
msgid "There's something in the air. I don't like it."
msgstr "뭔가가 느껴져. 맘에 들지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 01d40446-a6ab-b1cd-eb92-3a2ca6fe51e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:01d40446-a6ab-b1cd-eb92-3a2ca6fe51e9
msgctxt "hb7260dfbgf3ecg4873g9c7egbcf95ed093d5"
msgid ""
"Fortunately for me, you do. There was a rather compromising incident at a "
"windmill, and another with some duergar."
msgstr "나에겐 다행히도, 넌 날 알아. 풍차에서의 다소 불미스러운 사고가 있었지, 듀에르가도 그렇고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 01e0a82c-28e7-cbc2-7396-481740e61587
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:01e0a82c-28e7-cbc2-7396-481740e61587
msgctxt "hd8703c78g5c88g4aabg8ba5gfb375f6180dc"
msgid "Welcome to the club!"
msgstr "똑같은 처지에 있네!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 029bc811-3323-8f73-9f24-b3bfd9115610
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_BarcusFaints = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:029bc811-3323-8f73-9f24-b3bfd9115610
msgctxt "h51f3fb5cg9cc4g4726ga645g18ce99d49f0d"
msgid "But... <i>Wulbren? Dead?</i>"
msgstr "하지만... <i>울브렌? 죽었다고?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 05daa605-08fc-dd8f-1630-48c2c702b57d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:05daa605-08fc-dd8f-1630-48c2c702b57d
msgctxt "h54e39c62gc38ag46e7gb2dbg49cce4f3d219"
msgid ""
"There's a recipe I'm trying to replicate. Something that might help you."
msgstr "직접 재현해보고 싶은 제조법이 있거든. 너에게 도움이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 0733e39c-787d-4b19-4c70-05c68be14cf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:0733e39c-787d-4b19-4c70-05c68be14cf9
msgctxt "h65c4cd95g08a7g49b7gab81g05e92069efaa"
msgid "Do as you wish, but I won't rescue you a third time."
msgstr "원하는 대로 해, 다만 세 번이나 다시 구해주진 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 09b3f4ca-4c25-4b6e-3a7c-d4de40048967
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_BarcusFaints = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:09b3f4ca-4c25-4b6e-3a7c-d4de40048967
msgctxt "ha4b175afg363bg4935g9b82g0248dfd68161"
msgid "...<i>dead?</i>"
msgstr "...<i>죽었어?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 09cafe38-dea8-1c55-7b6c-c7e353d589c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:09cafe38-dea8-1c55-7b6c-c7e353d589c2
msgctxt "hf250b4ecg9e52g44cag9981g80536cf47439"
msgid ""
"Nasty place, isn't it. My torch only just held out long enough for me to "
"find my way here."
msgstr "끔찍한 곳이야, 그렇지? 오는 길에 하마터면 횃불이 꺼질 뻔했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 0af1aaf7-d66b-b505-3bc9-2264e93b4140
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:0af1aaf7-d66b-b505-3bc9-2264e93b4140
msgctxt "h57f66860gd7d0g4b17g8e9egbdd1548935dc"
msgid "What will you do now?"
msgstr "이제 어떻게 할 생각이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 0c14b50b-b778-8daa-ddc3-04938abb6d5c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_SavingPrisoners_Knows_BrilliantRetort = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:0c14b50b-b778-8daa-ddc3-04938abb6d5c
msgctxt "h04c8ed93gb507g4d4fg95dbg9effc8efa6e9"
msgid ""
"A new type of smokepowder. All the bang and boom of the original, but with "
"an extra surprise. I call it the <i>Brilliant Retort</i>."
msgstr "바로 새로운 종류의 화약이야. 기존의 폭발력은 유지하면서, 약간의 놀라움을 더했지. <i>화려한 응수</i>라고 이름 붙였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 0c21db1f-b2c2-7427-0311-f1e3342008ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:0c21db1f-b2c2-7427-0311-f1e3342008ad
msgctxt "h5691e906g554dg4ec5gbd77g046639fcdd6a"
msgid "That is - if you're still going to help Wulbren and the others."
msgstr "물론, 네가 아직 울브렌과 다른 노움들을 구할 의향이 있다면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 0dd27be7-0865-c9e3-d184-a3cb7925d098
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:0dd27be7-0865-c9e3-d184-a3cb7925d098
msgctxt "h0698216agd2e9g44e8ga6c1ge3c675de7d7b"
msgid "Indeed. I found this place on my way to Moonrise Towers."
msgstr "그래. 문라이즈 타워로 가던 길에 이곳을 발견했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 0dda771c-08c7-5006-0414-6628ed40a708
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_FriendTalkOver = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:0dda771c-08c7-5006-0414-6628ed40a708
msgctxt "h670bd6a2g53bag4b63gac70g169067e3e140"
msgid "Yes?"
msgstr "응?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 0f932739-79b9-eb84-7019-5fa776513734
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_Knows_BrilliantRetort = True
#.      - HAV_WrootRequest_Event_GaveGift = False
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_GaveGift = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:0f932739-79b9-eb84-7019-5fa776513734
msgctxt "h4094c7fbgdf0bg47b7gb1degc8d5219e4898"
msgid "The <i>Brilliant Retort </i>is ready. It's yours."
msgstr "<i>화려한 응수</i>가 준비됐어. 이젠 네 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 10627aa0-ce72-6875-bc03-98e17048faa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:10627aa0-ce72-6875-bc03-98e17048faa8
msgctxt "h1948a3bfgf09ag4fbag8d0ag514dce81fba9"
msgid "You'll need it if you're going to save Wulbren."
msgstr "울브렌을 구하는 데 필요할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 1122f9ee-08d4-4949-0bc7-203f3315f31c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:1122f9ee-08d4-4949-0bc7-203f3315f31c
msgctxt "h6e60a25ag0972g4bf7gbfaegd6300917a28f"
msgid "But - that's for me to worry about."
msgstr "그거에 대한 걱정은 내 몫이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 115dbb8a-312d-02b7-cb7b-9e60c84a752a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Wulbren_PreReunionHasMet(1) = True
#.   Global:
#.      - HAV_WrootRequest_Event_FriendTalkOver = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:115dbb8a-312d-02b7-cb7b-9e60c84a752a
msgctxt "h6fde82d2gf6c5g438dg8a3eg35b7cfacad2f"
msgid "Are you joking? Barcus, Wulbren is right in the other room."
msgstr "농담하는 거지? 울브렌이 바로 옆 방에 있잖아, 바커스."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 11e01d0e-5fb4-1cce-c499-ac97c43755f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:11e01d0e-5fb4-1cce-c499-ac97c43755f1
msgctxt "h301248deg21cag4657gb518gc5b0fd926116"
msgid "I don't think so."
msgstr "내 생각은 다른데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 14cc6641-5ad3-cc0a-ceaa-3460024e4f3c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_SavingPrisoners_Knows_BrilliantRetort = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:14cc6641-5ad3-cc0a-ceaa-3460024e4f3c
msgctxt "h85bd1931gf720g4ca5gb8a6g7a1b6424a9a8"
msgid ""
"I'll get to work on <i>the Brilliant Retort</i>. You get to work at the "
"Towers. Deal?"
msgstr "난 <i>화려한 응수</i> 만드는 '내 일'을 계속 할 테니까, 넌 타워에서 '네 일'을 계속 하는 거야. 거래 완료?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 151e6b4b-b3e1-6741-3014-79a7a18f66fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:151e6b4b-b3e1-6741-3014-79a7a18f66fd
msgctxt "h2098a354gf46eg4d59gb6eag265bae66b53f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 1571ca4e-9c75-30d0-aa8c-45b4c0db8ff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:1571ca4e-9c75-30d0-aa8c-45b4c0db8ff4
msgctxt "h76c4ea72g8aebg4248gb8feg6db50f24e132"
msgid "It's up to you. You're the only one capable of it. <i>Crush </i>them."
msgstr "이제 네게 달렸어. 너만이 할 수 있는 일이야. 가서 <i>뭉개버려</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 15f4fab3-53e0-99a7-ea6a-2900c3b3c325
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_UnfortunateGnome(1) = True
#.      - HAV_SavingPrisoners_UnfortunateGnome_NightsongFreedHasMet(1) = False
#.   Global:
#.      - IMPOSSIBLE = True
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_UnfortunateGnome(1) = True
#.     - HAV_SavingPrisoners_UnfortunateGnome_NightsongFreedHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:15f4fab3-53e0-99a7-ea6a-2900c3b3c325
msgctxt "h0e872a06gee07g46f6g8cfdgd11900497556"
msgid ""
"Where in the world did everyone go? Quite the fuss, but I'm not sure why. "
"You'll - you'll follow up, keep things in hand, won't you? Of course you "
"will."
msgstr ""
"다들 대체 어디로 간거야? 야단법석이 났는데 뭐때문인지를 모르겠군. 너 - 네가 다 알아보고 알아서 정리해 줄거지? 당연히 그래야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 15ff83a2-d7b6-1815-de40-72203bbcb515
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:15ff83a2-d7b6-1815-de40-72203bbcb515
msgctxt "h88aa7a93g1fadg4f21g94e7g2b95a15225a6"
msgid "I don't know what you mean."
msgstr "무슨 말인지 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 1620d7e0-365b-f929-1b58-77b8ed7701c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:1620d7e0-365b-f929-1b58-77b8ed7701c9
msgctxt "h29b0d2a2g5eb9g465dg8ab2g078305055b73"
msgid "Huh? It... seems to have disappeared."
msgstr "어라? 분명... 챙겨놨었었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 16a4f71d-af30-a09c-0b68-369b6319ef4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:16a4f71d-af30-a09c-0b68-369b6319ef4e
msgctxt "h0bfcb403g0419g4b69ga17bgaaede22cd14b"
msgid ""
"Then again... if you're going to the Towers... it stands to reason you might "
"encounter Wulbren while you're there."
msgstr "하지만 그래도... 네가 탑에 들르게 된다면... 거기 있는 동안 네가 울브렌을 만나게 될 수도 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 1914da9c-b6a9-c62d-b03d-d64805c40a62
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:1914da9c-b6a9-c62d-b03d-d64805c40a62
msgctxt "hef5fc188gefbag438ag89deg75093d52d2cb"
msgid ""
"I was about to ask you the same. I'm going to Moonrise Towers in search of "
"my friend Wulbren."
msgstr "내가 할 소리인데. 나는 내 친구 울브렌을 찾으러 문라이즈 타워로 갈거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 1aa275b7-a9c7-b609-73ed-6b3eefb5ee33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_UnfortunateGnome_NightsongFreedHasMet(1) = True
#.   Global:
#.      - IMPOSSIBLE = True
#.      - HAV_Mood_State_NightsongFreed = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:1aa275b7-a9c7-b609-73ed-6b3eefb5ee33
msgctxt "h9852b7b1g9b88g474ag8022gb7058da816db"
msgid ""
"Go on, then. No one but hang-abouts and n'er-do-muches here. And myself, of "
"course."
msgstr "그럼 가봐. 여긴 말만 많고 행동은 안하는 바보들밖에 없구만. 나도 그렇지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 1fc2f853-5381-abc8-d131-4ed7ef49bfae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:1fc2f853-5381-abc8-d131-4ed7ef49bfae
msgctxt "hd88cc126g6eeag4664g9c7cg115b5d04ac65"
msgid ""
"But! I won't stand idle. I've spotted an alchemist's scales and had already "
"been cooking up a little something that might help against those cultists."
msgstr ""
"하지만! 나도 가만히 있지만은 않겠어. 나도 어느 연금술사의 장비들을 찾아서 이미 저 혐오스러운 광신도들을 쫓아낼 무언가를 만들고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 21f76ffd-752e-b6a2-8187-770eec4dd6e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cebe520f-cc62-3297-f9f1-1700a2b84c8a_AskedWulbren = False
#. SetFlags:
#.   Local:
#.     - cebe520f-cc62-3297-f9f1-1700a2b84c8a_AskedWulbren = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:21f76ffd-752e-b6a2-8187-770eec4dd6e0
msgctxt "h7c845faagd48cg46cbgb209g9cb51fad66ef"
msgid "Who's Wulbren?"
msgstr "울브렌이 누구라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 231d1e06-6c8a-f75d-b4fa-39145f124324
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_UnfortunateGnome(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:231d1e06-6c8a-f75d-b4fa-39145f124324
msgctxt "h475700d7g13edg4252g92b9g486a2353b5e6"
msgid "What now?"
msgstr "무슨 일인데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 237eab69-30a3-ff68-aab8-0ad91c9ce61f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:237eab69-30a3-ff68-aab8-0ad91c9ce61f
msgctxt "h654bbadcgcd8cg40bag8df7gc7ebc40be58e"
msgid ""
"Nor have I. Everything in its due course, hmm? First, the <i>Brilliant "
"Retort</i>. Then, Wulbren. Then, your reward."
msgstr ""
"나도 잊지 않았어. 모른 일엔 순서가 있는 법이니까, 그치? <i>화려한 응수</i> 먼저. 그다음은 울브렌. 그 뒤에 너의 보상이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 246061d7-2837-0869-04b3-3dbf7f163427
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:246061d7-2837-0869-04b3-3dbf7f163427
msgctxt "h5b90e1e4gda10g4778gbf73g9425fa5240fe"
msgid "Very good, very good. Very good indeed!"
msgstr "좋아, 아주 좋아. 정말로 좋구만!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 2787e7c9-a95b-ec33-19e7-e1a79399262f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:2787e7c9-a95b-ec33-19e7-e1a79399262f
msgctxt "h3514b532g6b3bg4728gb23eg70b3f77491ec"
msgid "Oh, joy. More cultists."
msgstr "아, 기뻐라. 더 많은 광신도 놈들이라니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 28459120-bfc4-b654-2edb-de5fd34eb507
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:28459120-bfc4-b654-2edb-de5fd34eb507
msgctxt "hf22f6befg5d3cg4077ga11agfab4f6f8e072"
msgid "Ah, of course. How are things, Barcus?"
msgstr "아, 맞아. 잘 지냈어, 바커스?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 2a85f500-28c7-c681-735a-25b6acc723dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:2a85f500-28c7-c681-735a-25b6acc723dc
msgctxt "h9a3a2613ga5ecg4e6cg9b36g01e2b48ec820"
msgid "I'll... well. I'll... I'm not sure."
msgstr "나는... 글쎄... 잘 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 2c670d29-2595-9b9f-db73-53535f0e5db5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:2c670d29-2595-9b9f-db73-53535f0e5db5
msgctxt "h706c9987gb78eg4dbeg9ae1gd100b6862bb1"
msgid ""
"Or worse - to try your best and end up hurting the one you love the most."
msgstr "최선을 다하다가 친구를 해쳐버린게 더 끔찍할 수도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 2d524d21-ba0a-10fc-1b3e-ac373b1d691f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:2d524d21-ba0a-10fc-1b3e-ac373b1d691f
msgctxt "h597df719gb9e7g4c27gb199g26357f01c271"
msgid "Wulbren?"
msgstr "울브렌?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 2dd5bffa-b6f2-bb01-4c96-84f916243c63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:2dd5bffa-b6f2-bb01-4c96-84f916243c63
msgctxt "h1be0506fg33c9g47d8g9a72gaa6c5d149970"
msgid ""
"Perhaps we ought to allocate our resources intelligently. According to our "
"talents, as it were."
msgstr "우리 인력을 적절하고 현명하게 배치하는 게 어떨까. 각자 잘하는 게 있잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 3200428e-1d6a-afb9-ff8d-03f438a94532
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:3200428e-1d6a-afb9-ff8d-03f438a94532
msgctxt "h116940e2g3bc2g45e5g93bag6732bebbe921"
msgid ""
"I haven't forgotten. And as it happens, I was making something to help you "
"on your way."
msgstr "나도 기억하고 있어. 때마침, 너에게 도움 될 무언가를 만들고 있었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 3399df2f-f29c-498f-8006-ddcceb44a189
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:3399df2f-f29c-498f-8006-ddcceb44a189
msgctxt "h8ff90fb3ga172g4338gb67fgcf12e260eb2f"
msgid "If anyone can, I'm sure it's you."
msgstr "네가 못하면, 누가 할 수 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 33ab475d-b7b8-e3fb-913d-a664328e9c4a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - cebe520f-cc62-3297-f9f1-1700a2b84c8a_ToldBrilliantRetort = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:33ab475d-b7b8-e3fb-913d-a664328e9c4a
msgctxt "he6c74b37g5e12g49c4ga8b5g2246eeec2a6f"
msgid ""
"A new type of smokepowder. All the bang and boom of the original, but with "
"an extra surprise. Guaranteed to end any and all arguments or protestations."
msgstr ""
"새로운 종류의 화약이야. 펑펑 터지는 건 기존과 같지만 거기다 뭔가 깜짝선물을 준비해뒀지. 어떤 말싸움도 바로 침묵시켜버릴 정도로 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 33ae629e-9b2a-c86c-0294-78c823f7f888
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:33ae629e-9b2a-c86c-0294-78c823f7f888
msgctxt "hac943739g0242g43feg84afg64434017543e"
msgid "What's 'the Brilliant Retort'?"
msgstr "<i>'화려한 응수'</i>가 대체 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 3491f210-99ed-84bd-60b7-b6ede8597910
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_Knows_BrilliantRetort = False
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_BarcusGoesToWulbren = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:3491f210-99ed-84bd-60b7-b6ede8597910
msgctxt "h46833458gff80g4f5fga4acgcd30695bf0d2"
msgid ""
"A new type of smokepowder. I call it the <i>Brilliant Retort.</i> It's "
"yours! Now - I need to go find Wulbren!<i></i>"
msgstr "새로운 종류의 화약이야. 난 이걸 <i>화려한 응수</i>라고 이름 지었지. 네 거야! 자, 난 이제 울브렌을 보러 가야겠어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 37694e0f-f685-41a4-8713-577817c8689f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:37694e0f-f685-41a4-8713-577817c8689f
msgctxt "h6bed52f1gda96g4e26g8a34g492ed76a9152"
msgid "When I'm finished making it."
msgstr "내가 완성 시킬 때."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 380b8e15-7c7c-334a-d420-dc37ec345484
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:380b8e15-7c7c-334a-d420-dc37ec345484
msgctxt "h442da9fbg38b3g4974gabf3g67a6c05d77be"
msgid ""
"An old friend. The kind one doesn't simply leave to his own reckless fate - "
"even when it leads to the heart of a murderous cult!"
msgstr ""
"내 오랜 친구야. 선한 마음을 가진 자는 무모한 운명이 기다리고 있어도 도망치지 않는 법이야. 그 운명이 살인마 광신도 집단의 심장부로 "
"이어질지라도!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 39be5338-ef15-1cd6-4ea1-a7c254a919f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_UnfortunateGnome_AllPrisonersDeadHasMet(1) = False
#.   Global:
#.      - MOO_Jailbreak_State_AllPrisonersDied = True
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_UnfortunateGnome_AllPrisonersDeadHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:39be5338-ef15-1cd6-4ea1-a7c254a919f1
msgctxt "he1f9389cgbbc1g4181g8e4dgd4ce9fe257f4"
msgid "I say, are you quite all right? You look a little peaky."
msgstr "너 괜찮은거 맞아? 좀 불편해 보이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 3d86fc2a-986f-a809-3a70-344f23af76ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:3d86fc2a-986f-a809-3a70-344f23af76ca
msgctxt "h9675a18agf139g4a50ga4b0g81dd9b519669"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 3da129bf-7082-4c2c-d30e-c511237c3cfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:3da129bf-7082-4c2c-d30e-c511237c3cfd
msgctxt "h6b53cc57g2ecdg4c14g9d99g924475ef0696"
msgid "I'm sure I'll come up with... something."
msgstr "분명 어떤 방법을... 찾을 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 4043acc2-bc28-5d90-c483-b5009b7ca11d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:4043acc2-bc28-5d90-c483-b5009b7ca11d
msgctxt "h41b71cf1ge34bg4ed3gb694geb769609447b"
msgid "If he's there, I plan to find him."
msgstr "울브렌이 그곳에 있다면, 꼭 구해내겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 40a0f8d0-f469-75ca-6455-e28daa2c01ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:40a0f8d0-f469-75ca-6455-e28daa2c01ab
msgctxt "h1be4eba2g7f14g4cddg81aag09284d25a33a"
msgid "What are you doing here, anyway?"
msgstr "그나저나, 여기서 뭐하고 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 41eb495a-6aea-940c-caf6-70eaed53a19a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:41eb495a-6aea-940c-caf6-70eaed53a19a
msgctxt "hc9bdc9dcg292fg4c03g98c7gef8dfecc7aa3"
msgid ""
"An old friend. The kind one doesn't simply leave to his own reckless fate - "
"even when it leads to the heart of a murderous cult."
msgstr ""
"내 오랜 친구. 친절한 자는 무모한 운명일지라도 그냥 내버려 두지는 않는 법이지. 살인마가 가득한 교단 심장부로 향하는 길일지라도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 4390cac7-84a4-471e-9290-68bf2613e16a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:4390cac7-84a4-471e-9290-68bf2613e16a
msgctxt "hf2f752c1g7afbg4e2ag9220g33d8c1d6c3a7"
msgid "Aren't you some kind of wandering hero? Isn't this what you <i>do?</i>"
msgstr "너희들 어떤 방랑 영웅같은 거 아니었어? 이게 너희 <i>본업</i> 아니야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 44e9c320-281c-ce7a-2574-622d564d1540
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:44e9c320-281c-ce7a-2574-622d564d1540
msgctxt "hdc7881e5g16acg4ed9g8359g1b11456ae020"
msgid ""
"That seems likely. Everyone loves providing refuge for a poor, defenceless "
"deep gnome."
msgstr "그랬던 것 같아. 누구나 불쌍하고 무방비 상태인 딥 노움에게는 피난처를 제공하고 싶어할테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 46584b99-9ff6-376e-d515-83f7c9e3618b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:46584b99-9ff6-376e-d515-83f7c9e3618b
msgctxt "hf72e5250gab3dg4be6gae58gbe9b95000154"
msgid ""
"You understand correctly. But it would be suicide for you to go near the "
"place."
msgstr "잘 알고 있네. 하지만 너한테는 자살행위나 마찬가지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 467ac19d-4770-93c0-06f0-bcc31ed15f14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:467ac19d-4770-93c0-06f0-bcc31ed15f14
msgctxt "h39fd08e6g2be3g4a16ga2f4gc8a176f80234"
msgid "Then it's settled. You stay here. I'll search the Towers."
msgstr "그럼 정해졌네. 넌 여기 있어. 내가 탑에서 찾아보겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 46afa4bf-d9f4-706f-6c60-93d4c97cdbc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:46afa4bf-d9f4-706f-6c60-93d4c97cdbc1
msgctxt "h61958713g945eg40eaga062gb67814def1bb"
msgid "I'm afraid he didn't make it."
msgstr "유감이지만 그는 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 47b6ae18-331e-28d0-79a5-cb5b7ebbf762
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:47b6ae18-331e-28d0-79a5-cb5b7ebbf762
msgctxt "he8be4af7g02c1g4484g8febg1d7c1cf21ea2"
msgid ""
"I call it the <i>Brilliant Retort</i>. Seems a bit glib now - but it "
"would've made Wulbren smile, I think."
msgstr "<i>화려한 응수</i>라고 이름 붙였지. 조금 경박한 이름같지만... 울브렌은 재밌다고 웃어 줬을 텐데, 아마도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 4a6960c9-d30b-e136-64fa-0f4498bb0e00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_GaveGift = False
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_GaveGift = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:4a6960c9-d30b-e136-64fa-0f4498bb0e00
msgctxt "h7a2e5455gfa4bg4d4cg86aage17c0b75e7af"
msgid ""
"While you were infiltrating the Towers, I was working on something I thought "
"might help in the fight against those cultists."
msgstr "네가 탑에 잠입해 있는 동안 내가 저 광신도들을 처리하는데 도움이 될 만한걸 만들어 놨어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 4a73b396-da12-f62e-09ba-9876da6be7c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:4a73b396-da12-f62e-09ba-9876da6be7c0
msgctxt "hca9aa1e8g36feg431cgbe53g2b3193378049"
msgid "Of course I am."
msgstr "물론 도와야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 4fb0d3cf-cf28-4c94-08d1-94d60fdbd875
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_BarcusFaints = True
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_WulbrenGoneReported = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:4fb0d3cf-cf28-4c94-08d1-94d60fdbd875
msgctxt "h5d1739c3gab83g4679g89c4gbdc0ef2e313f"
msgid "Oh. Yes. Hello."
msgstr "오. 그래. 안녕."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 5004af2f-6ce4-5a4d-f4a0-6b6701f84269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:5004af2f-6ce4-5a4d-f4a0-6b6701f84269
msgctxt "hb15178a5g0f7cg462fgaa88g77a35ae0d3bc"
msgid ""
"Even if you get past the shadow curse, you'll never make it past that many "
"cultists."
msgstr "네가 그림자 저주를 뚫고 간다 하더라도, 그 많은 광신도 무리를 두고 지나갈 순 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 5479806d-2b35-a637-55a2-ce69b8508b94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:5479806d-2b35-a637-55a2-ce69b8508b94
msgctxt "h5ab5569eg5ca1g4cbag949egc47103dc4fed"
msgid ""
"I thought I'd scout ahead. Check for any nasty surprises. Of which I found a "
"great deal."
msgstr "앞서와서 미리 살펴봐야겠다고 생각했어. 돌발상황이 있을지 모르니까. 그러다 놀라운 걸 발견했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 55afe7d2-967f-0c56-9f77-29898627ae0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:55afe7d2-967f-0c56-9f77-29898627ae0a
msgctxt "h1eb7316egbc2cg4d46g95ccgd24b41af6555"
msgid ""
"Don't threaten me with a good time. My search for Wulbren has been one "
"quagmire after another, as you know."
msgstr "자살행위라니, 그것참 재미있겠네. 울브렌을 찾기 위한 내 여정은 이미 수렁과 진창의 연속이었어, 너도 알겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 55b016af-3060-699a-06fc-0d0cdc3ea47b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UnfortunateGnome_State_PlayerOfferedHelp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:55b016af-3060-699a-06fc-0d0cdc3ea47b
msgctxt "h9feb448bge832g4a86g8720gc1c392421ba2"
msgid "I did what you asked. Ready for my reward."
msgstr "네가 부탁한 일을 들어줬어. 내 보상을 받을 준비가 됐지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 571eb87a-2ae0-8f22-5eec-ce6abc89c081
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:571eb87a-2ae0-8f22-5eec-ce6abc89c081
msgctxt "h5739872eg3030g49b7g8a48gceeb5f882820"
msgid "No. And pestering the craftsman won't speed things up!"
msgstr "아직이야. 그리고 그렇게 보챈다고 빨리 완성되는 것도 아니야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 599e4c1d-d178-c01b-9ec0-46986e5de580
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:599e4c1d-d178-c01b-9ec0-46986e5de580
msgctxt "hb5607c04g2c00g447bg861cgd7e431e663d5"
msgid "There's nothing I can do. It's over."
msgstr "이제 내가 할 수 있는 게 없어. 다 끝났어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 5baa35e1-2fac-ab55-4591-a5a1f882457e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_GaveGift = False
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_GaveGift = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:5baa35e1-2fac-ab55-4591-a5a1f882457e
msgctxt "h83467ffdg133ag495bga878g5fc3d0ce13e5"
msgid "Here - take this - quickly."
msgstr "여기. 받으라고. 빨리."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 5bcf9836-0a0f-8068-2feb-0672e3b1fe70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:5bcf9836-0a0f-8068-2feb-0672e3b1fe70
msgctxt "h50b74da6ga9c6g4b98g9a9agfdd61fc6057d"
msgid "I like the name. What's it do?"
msgstr "멋진 이름인데. 기능이 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 5f17e988-7a02-48a8-9786-460dfa921b9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:5f17e988-7a02-48a8-9786-460dfa921b9f
msgctxt "h7a5056d8g4808g40beg957bg3a0f3fdff056"
msgid "Haven't you heard? I freed the people being held in Moonrise Towers."
msgstr "아직 못 들었어? 문라이즈 타워에 잡혀있던 사람들을 내가 구했다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 61bdd559-51f7-7c2a-6ae0-41eaa7908a81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:61bdd559-51f7-7c2a-6ae0-41eaa7908a81
msgctxt "hcbd86ebag84f8g40eaga8ebg31793349e780"
msgid "I'd like to trade."
msgstr "거래를 하고 싶은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 62509bf4-16f3-a5d2-906e-df4d80de9a10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cebe520f-cc62-3297-f9f1-1700a2b84c8a_ToldBrilliantRetort = True
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:62509bf4-16f3-a5d2-906e-df4d80de9a10
msgctxt "h4c4967aagdcc0g47cdgbef5g18ded23067b0"
msgid ""
"Give me the schematics for the <i>Brilliant Retort </i>and we have a deal."
msgstr "<i>화려한 응수</i>의 설계도를 나한테 넘겨. 그럼 거래 완료야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 6253e4ea-8248-fe20-ac96-e8a57c634f88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:6253e4ea-8248-fe20-ac96-e8a57c634f88
msgctxt "hc5e31a36g769eg4a44g9fe8g090997e528ee"
msgid "Hello, Barcus. How are things?"
msgstr "안녕, 바커스. 잘 지냈어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 648d38fc-0016-d646-b6cb-1f9e00611cbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:648d38fc-0016-d646-b6cb-1f9e00611cbd
msgctxt "h243d479ag015ag4dfaga3a7g4c3edfcb70d9"
msgid "We'll see."
msgstr "글쎄."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 64962b0a-4226-e7f2-0e33-ed309c40cac4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:64962b0a-4226-e7f2-0e33-ed309c40cac4
msgctxt "hf334a71fg3938g4d3cg8df1g15b73d79bc7b"
msgid ""
"I'm sure I'll have no problem locating Wulbren and skipping out of there "
"hand in hand!"
msgstr "그거 참 정-말로 울브렌을 찾아서 같이 손에 손잡고 탑을 빠져나오는데 아-무런 문제도 없겠군!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 65dca0ce-a936-755b-116f-d4f29747fa63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:65dca0ce-a936-755b-116f-d4f29747fa63
msgctxt "h07f58da2g67f7g4d03g88f2gd7b037a56743"
msgid "Are you following me?"
msgstr "날 따라오고 있는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 6845462a-7131-9fdf-39dd-c16377d9502d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_BarcusCameFromCamp = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_UnfortunateGnome(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:6845462a-7131-9fdf-39dd-c16377d9502d
msgctxt "hd251b365gd059g4193ga1d3g639dc11612f1"
msgid "Ah - you found your way. Good."
msgstr "아. 잘 찾아 왔구나. 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 695eaf17-7d2d-397c-d925-c91163b077e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:695eaf17-7d2d-397c-d925-c91163b077e6
msgctxt "hd2f784fdgd130g4dafg8611g84ec47f18e1f"
msgid "I hope you got a warmer welcome than I."
msgstr "나보다는 좀 더 따뜻한 환대를 받았기를 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 6a923f11-9b35-442b-d06d-14386ed9f2d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:6a923f11-9b35-442b-d06d-14386ed9f2d5
msgctxt "h0b18e92eg13c6g43ffg9388gef3acf82a340"
msgid "Whatever you say."
msgstr "아님 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 6ad93b49-b1c9-d14c-635f-174230bf756d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:6ad93b49-b1c9-d14c-635f-174230bf756d
msgctxt "h49957abag849dg450dga963g58f9ada91cdb"
msgid "That's very decent of you. Very decent of you indeed."
msgstr "넌 정말 친절해. 아주 친절하다니깐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 6c491bd0-754c-6588-4b0a-da667c80ff03
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_State_Sad = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:6c491bd0-754c-6588-4b0a-da667c80ff03
msgctxt "h97270f99ge4dbg405bgbe39g327c07b50095"
msgid "Take it. And give the Absolute <i>hell.</i>"
msgstr "가져가. 그리고 그 절대자란 놈에게 <i>지옥을</i> 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 6dd81530-16a4-e53e-9589-18fd8b3443e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:6dd81530-16a4-e53e-9589-18fd8b3443e0
msgctxt "h00de5638g8676g4c98gb1cfgcfa2f3050a37"
msgid ""
"It helps to know when to close your eyes and <i>run. </i>I bumped into this "
"inn before any nasty shadows got their tendrils on me."
msgstr ""
"언제 눈을 질끈 감고 <i>줄행랑</i> 쳐야 할 지 아는 것은 유용하거든. 넝쿨 같은 그림자가 나를 건드리기 전에 이 여관으로 내달렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 6f440a5f-39c0-6ac3-26eb-0d9e610fe2dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:6f440a5f-39c0-6ac3-26eb-0d9e610fe2dc
msgctxt "h28a395e5g5e8eg4d09gb6bagf3351ef6e3f3"
msgid "Wulbren got himself into this mess. It isn't your fault."
msgstr "울브렌이 자초한 일이야. 네 잘못이 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 6f7226a2-b2bb-9745-a0b9-8ea4db58e91d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:6f7226a2-b2bb-9745-a0b9-8ea4db58e91d
msgctxt "hf694f1b5gf252g485ega7b1g4776e30be03c"
msgid ""
"I don't know. I can't help but feel that something's... <i>especially </"
"i>wrong. I mustn't let my imagination run away with me, though.<i></i>"
msgstr "모르겠어. 뭔가... <i>특히</i> 잘못되었다는 느낌을 지울 수가 없어. 하지만.. 내 상상이 너무 앞서가면 안 되지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 6f7c9ed8-4036-1a08-7799-0718a9231613
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_State_Angered = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:6f7c9ed8-4036-1a08-7799-0718a9231613
msgctxt "hcbe94580g6a30g4050gb136g2c2f588514b4"
msgid "Your work here isn't done. So perhaps you should get on with it."
msgstr "여기서 네 할 일은 끝나지 않았잖아. 그러니 어서 계속 해야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 70b01c17-5cbc-6d0e-1dcc-b159ed19c394
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_SavingPrisoners_State_ReturnCompleted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:70b01c17-5cbc-6d0e-1dcc-b159ed19c394
msgctxt "hf973ec53gd469g460fg94ccg794c50c62fc1"
msgid "I went to Moonrise Towers. All the captives there have perished."
msgstr "문라이즈 타워에 갔었어. 거기 모든 포로는 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 72d327b8-3d5d-244b-15a1-4490dd96b209
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:72d327b8-3d5d-244b-15a1-4490dd96b209
msgctxt "hd4f9268eg1b88g4e86gb658g5001a550a47f"
msgid "Do I know you?"
msgstr "누구세요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 72eb315d-5dbf-f3e4-93d7-50740bcc13bb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_UnfortunateGnome_State_PlayerOfferedHelp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:72eb315d-5dbf-f3e4-93d7-50740bcc13bb
msgctxt "h42f16588g91c9g4094g8cceg1d80630e7df8"
msgid "Deal."
msgstr "거래 완료야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 73201e7a-d742-f4a0-8d8d-6235acb6081e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:73201e7a-d742-f4a0-8d8d-6235acb6081e
msgctxt "h255dc9b6g7d99g41acga685gb06f98284a51"
msgid "I thought that was your mission."
msgstr "그건 네 임무인 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 742a8dcc-761c-400e-7afa-9b693806ece8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:742a8dcc-761c-400e-7afa-9b693806ece8
msgctxt "ha4d7ef69g1ce5g4512g9ab3g36e51dbe2e4b"
msgid ""
"They didn't get trapped, they were kidnapped! Taken against their will by "
"those <i>cultists.</i> If I ever get my hands on one of them... well. With "
"you on the job, perhaps I won't have to find out."
msgstr ""
"걔네들은 갇힌 게 아니라, 납치 당한 거야! 그 <i>광신도</i> 놈들한테 억지로 끌려간 거라고. 녀석 중 한 명이라도 구할 수 "
"있다면.... 뭐, 네가 맡아만 준다면, 내가 직접 구할 일은 없겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 75e56923-13ce-c1d7-5cce-f28fb95f5319
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:75e56923-13ce-c1d7-5cce-f28fb95f5319
msgctxt "h3114227cg899dg4f8bg8c2cg4f8e4427ef6b"
msgid "I'm sure you would!"
msgstr "그렇게 나오셔야지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 7a5c8fec-f7a8-b4f5-8296-fb215d772e01
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_UnfortunateGnome_State_PlayerOfferedHelp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:7a5c8fec-f7a8-b4f5-8296-fb215d772e01
msgctxt "hed751f10g0d21g4869ga408gbe138826ee0a"
msgid "I suppose I've earned the reputation. I'll help find your friends."
msgstr "내 명성이 자자한 것 같네. 친구들 찾는 것을 도와줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 7aa6eb24-c36f-c7e2-4a02-dfe26995cfe9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:7aa6eb24-c36f-c7e2-4a02-dfe26995cfe9
msgctxt "h0ee8ea54g8ae2g465eg9e95g8c7c5ceeaa7a"
msgid ""
"If anyone can, I'm certain it's you. But you won't do it alone. I'm working "
"on a recipe to help you on your way."
msgstr "네가 아니면, 아무도 못 할 거야. 그래도 너 혼자 하게 두진 않을 거야. 널 돕기 위한 어떤 제조법을 연구 중이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 80316b65-9191-4e62-b933-62c84d08bc43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:80316b65-9191-4e62-b933-62c84d08bc43
msgctxt "h6f7f986agf971g4122g94a1ge103e18e7214"
msgid "Seems you've found yourself in another scrape."
msgstr "보아하니 또 새로운 곤경에 처한 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 8117c19d-c5ab-94a9-b2c7-33818c89d0cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:8117c19d-c5ab-94a9-b2c7-33818c89d0cd
msgctxt "h939a162aga62dg4bc3g8f40g5a7aed5b6a38"
msgid "You're on your own."
msgstr "네 일은 네가 알아서해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 837c2bb9-3c78-141e-7478-6d84698b05cf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_BarcusGoesToWulbren = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:837c2bb9-3c78-141e-7478-6d84698b05cf
msgctxt "h59aa3da7g58f5g4e49g8ccegd70833290745"
msgid "You - you did? But that means... <i>Wulbren!</i>"
msgstr "너, 네가 정말? 그 말은... <i>울브렌!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 83e163d6-c610-46b6-3dfa-dd8d9d91e23b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:83e163d6-c610-46b6-3dfa-dd8d9d91e23b
msgctxt "haec264a5g4712g40c9ga84fg2885f219574b"
msgid "You, on the other hand, have proven resourceful in such infiltrations."
msgstr "반면에, 너는 이런 잠입에 매우 재능이 있다는 게 증명되었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 853c89ce-5245-d639-cdaf-33701c60c9a2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_State_Angered = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:853c89ce-5245-d639-cdaf-33701c60c9a2
msgctxt "h25afcd0age259g4f9dga8c6g547c38b9089a"
msgid "What a brutal horror this life can be."
msgstr "살아있다는 게 이렇게 지독하고 끔찍할 수 있을 수가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 860adce5-ae7c-b1c5-b78d-e4058c2a8a52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:860adce5-ae7c-b1c5-b78d-e4058c2a8a52
msgctxt "h7be8392bgc08bg4d23g91d3g3931e67fd08b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 869356e5-12c3-40cc-7266-1a2c62232346
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:869356e5-12c3-40cc-7266-1a2c62232346
msgctxt "h285c6576ga396g40c0g8dd5gd287a8157bd0"
msgid ""
"There are deep gnomes being held in Moonrise Towers. One of them is my "
"friend Wulbren."
msgstr "문라이즈 타워에 딥 노움들이 잡혀있어. 그 중에 내 친구 울브렌이 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 8717d235-7463-1e1a-a586-1105e7d9f84b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:8717d235-7463-1e1a-a586-1105e7d9f84b
msgctxt "ha601cdd8gf80ag4e34ga7f9gb1dca2cc2def"
msgid "I'll leave you to consider it."
msgstr "그럼 계속 잘 고민해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 87236fd7-3d04-68ea-50e2-96fee3bc5ce4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:87236fd7-3d04-68ea-50e2-96fee3bc5ce4
msgctxt "heafeb789g6968g44a0gba71g9b4d058c8565"
msgid "How are things? <i>How are things?</i>"
msgstr "잘 지냈냐고? <i>잘 지냈냐고?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 89b1ffb1-909a-39ba-2190-68e7a3c58b98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:89b1ffb1-909a-39ba-2190-68e7a3c58b98
msgctxt "h87e226c7g650cg4d04gb1a0ga962686ea4e8"
msgid "Let's not ruin the surprise, hmm?"
msgstr "깜짝쇼를 망치지는 말자고, 어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 8a04d519-64bc-7e20-85c5-0bb4c9323958
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_ReturnCompleted = True
#.      - HAV_SavingPrisoners_State_WulbrenReturned = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:8a04d519-64bc-7e20-85c5-0bb4c9323958
msgctxt "ha27ccaa8g4a7cg48e8g9d0agde751a6e7e57"
msgid "Is it true? About Wulbren?"
msgstr "그게 진짜야? 울브렌에 대한 얘기가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 8c0db065-5b52-108b-d296-26820418f2e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:8c0db065-5b52-108b-d296-26820418f2e3
msgctxt "h2ecbbf0eg797ag46ffg8429g90c5f3d39673"
msgid "What happened to the other gnomes you were with?"
msgstr "같이 있던 노움들은 어떻게 됐어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 8c36996b-094d-9f4d-3e99-e67d0f8626dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:8c36996b-094d-9f4d-3e99-e67d0f8626dc
msgctxt "h8b58f439g6790g4da5ga53dg3470060778ea"
msgid ""
"A terrible thing, isn't it? A terrible thing, to try your best and get "
"nowhere at all."
msgstr "끔찍한 일이지? 최선을 다 하고도 아무 결과도 내지 못한다는 건 참 끔찍해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 8e55ff5b-1ab5-b1fe-f1e3-10dc54e6e9f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:8e55ff5b-1ab5-b1fe-f1e3-10dc54e6e9f3
msgctxt "h92d92662ge5a4g43dega1dbg2e3ee821976f"
msgid "Go on."
msgstr "계속해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 8f051179-3d56-68a9-5be1-a621a4368a3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_State_Sad = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:8f051179-3d56-68a9-5be1-a621a4368a3d
msgctxt "hcef34adcgd0c9g4f34gb4b9g46c5a21962a8"
msgid "Hmm?"
msgstr "흠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 8f37856f-81a4-11b6-618c-9800ea4ab8d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:8f37856f-81a4-11b6-618c-9800ea4ab8d4
msgctxt "hc03ec955g08fcg4e41gaf58g44f409955d30"
msgid "Everyone seems to be quite a-flutter. Do you know why?"
msgstr "모두들 꽤나 들떠 있는 것 같은데. 왜 그런지 알아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 9158ff86-8c16-3bf7-6259-5893e0fc9c4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:9158ff86-8c16-3bf7-6259-5893e0fc9c4b
msgctxt "h9aebe049g81f6g49a7gaf00g9737f736e867"
msgid "That's what the others said. And yet... and yet... how could it be?"
msgstr "다른 사람들이 그리 말했어. 하지만... 하지만... 어떻게 이럴 수가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 949acd65-87d4-69af-bf73-16ac939b1379
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_BarcusFaints = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:949acd65-87d4-69af-bf73-16ac939b1379
msgctxt "h7d1a6aa9g3a3ag40fdg87f7gbb612b4e8158"
msgid "How could it...?"
msgstr "어떻게...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 96b6c1b0-d9b3-fc84-55f3-7ac0d193668e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:96b6c1b0-d9b3-fc84-55f3-7ac0d193668e
msgctxt "h0bf00608g5f0fg49a4g9215g9bbe43a792dd"
msgid "You - you do whatever it is you do."
msgstr "너, 너는 네가 할 일을 하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 9912e0ae-fd8b-b7a6-a31e-c3649605d103
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UnfortunateGnome_State_PlayerOfferedHelp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:9912e0ae-fd8b-b7a6-a31e-c3649605d103
msgctxt "h880efbd2gfd0ag401bgb4f9g05cb9ca52fa3"
msgid ""
"I told you I'd help rescue Wulbren and the others - this is my first stop."
msgstr "울브렌과 다른 사람들을 구해주겠다고 말했었지. 여기서부터 출발이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 9a4b1224-76f5-65ae-55df-6dfd68afe051
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_UnfortunateGnome(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:9a4b1224-76f5-65ae-55df-6dfd68afe051
msgctxt "h8a71a850ge380g4c8agb5ebg1396bf757cd3"
msgid "Ah. You."
msgstr "아. 너구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = 9c593bc5-f2bc-a636-35f7-c752cc7c107c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:9c593bc5-f2bc-a636-35f7-c752cc7c107c
msgctxt "hcfe4456ag6ad3g4cebga951g9741593f6d02"
msgid "Anything I can do to help?"
msgstr "내가 도울 일이 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 9c842bff-3927-8a12-ed8b-bf3762c4e9ff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_BarcusFaints = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:9c842bff-3927-8a12-ed8b-bf3762c4e9ff
msgctxt "hb7d8b5aegfab9g46adga2e5gdc258ca6f17d"
msgid "Perished... but that means... but <i>Wulbren</i>. How could it be...?"
msgstr "죽었다... 그 말은 즉... 하지만 울브렌. 어떻게 이런 일이...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 9ced9b05-4453-63dc-a3ff-d185e5a65254
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_BarcusGoesToWulbren = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:9ced9b05-4453-63dc-a3ff-d185e5a65254
msgctxt "he9ad10e0gd396g4b2fga420gede3f73e85d3"
msgid "He - wha - you're - <i>excuse me.</i>"
msgstr "걔가? 뭐? 너 지금, <i>잠깐만.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 9e3009b7-7dbb-b5de-bb8f-9ecad59014d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:9e3009b7-7dbb-b5de-bb8f-9ecad59014d8
msgctxt "h8c8bafd2g1a31g4355gb58ag6eb8678f177d"
msgid ""
"I'll soon be off to Moonrise Towers to look for my friend Wulbren. I "
"understand you might be headed in that direction as well."
msgstr "나는 곧 내 친구 울브렌을 찾으러 문라이즈 타워로 떠날거야. 너도 같은 방향으로 향하는 걸로 알고 있는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 9f29f1cd-90a4-57ad-56bd-eca7aa3458e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:9f29f1cd-90a4-57ad-56bd-eca7aa3458e3
msgctxt "habcd6f54g7244g4104g8b08gaf7d8d38b127"
msgid ""
"It's new type of smokepowder. Plenty of firepower in it, but with an extra "
"surprise. Sure to take those cultists down a short road, if you catch my "
"meaning."
msgstr "새로운 종류의 화약이야. 강력한데다가 조그만 깜짝선물까지 들어있지. 저 광신도들을 한순간에 보내버리는데는 충분할거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = a0ea3fcc-227d-f0cf-0df5-2a2c9cec70dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:a0ea3fcc-227d-f0cf-0df5-2a2c9cec70dd
msgctxt "h24446c61gc74ag4649gbeb7gbbf5e6439774"
msgid "But with a little luck, perhaps I won't."
msgstr "근데 운이 없으면, 못 만날 수도 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = a6829cdf-ab39-21b6-1189-2c0205f345f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:a6829cdf-ab39-21b6-1189-2c0205f345f6
msgctxt "hb3c95ca1gc843g4290g867dgd89c9e23eff1"
msgid "I have reason to believe the seat of the Absolute is in Moonrise."
msgstr "절대자가 문라이즈 타워에 있다고 믿을 만한 이유가 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = a6e4f9ec-3ba2-dd00-3601-6a259763c574
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:a6e4f9ec-3ba2-dd00-3601-6a259763c574
msgctxt "hff2f309cgb65dg4396ga8f8g5e7e398c09e9"
msgid "And what did you find?"
msgstr "그래서 뭘 발견했는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = a93619d1-76ac-18d3-4ac9-ddb135ee4ddf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_BarcusFaints = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:a93619d1-76ac-18d3-4ac9-ddb135ee4ddf
msgctxt "h03e8cabdg76d9g4e81gbf56g6fc3b0395149"
msgid "Oh... well..."
msgstr "오... 젠장..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = aaa1aa7b-836d-70e3-3ed1-64c6fa0d2449
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:aaa1aa7b-836d-70e3-3ed1-64c6fa0d2449
msgctxt "h4df070b4g4805g4b84gaef4g40c1cc70133b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = abd375e0-b498-4029-36f1-e13c3ac8a0fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_BarcusGoesToWulbren = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:abd375e0-b498-4029-36f1-e13c3ac8a0fc
msgctxt "hb73d9008gf88fg4e30g9225g672b5d325213"
msgid "Dear me. That's quite a loss. But! Oh well! Wulbren's back!"
msgstr "그럴 수도 있지. 아깝지만 어때! 울브렌이 돌아왔는데!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = abdb6444-1267-5c9c-84d4-8e0eaf8b83ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:abdb6444-1267-5c9c-84d4-8e0eaf8b83ea
msgctxt "h9fef8c2fg3a27g470eg9bacgb2c51732024f"
msgid "Wulbren's gone. Wulbren's... <i>dead</i>. But. You know that."
msgstr "울브렌은 가버렸어. 울브렌이... <i>죽어버렸어</i>. 하지만. 너도 이미 알고있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = ac9dd321-8517-0f13-9c78-3a3c922b04f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:ac9dd321-8517-0f13-9c78-3a3c922b04f7
msgctxt "h95816fb3g50c3g44e3g86f1g0d8de323052f"
msgid "How can it be? I failed him so utterly."
msgstr "어떻게 이럴 수가 있지? 이렇게나 지독하게 망해버리다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = acb89e20-6fff-7bc1-a22f-c62b66d7eb1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:acb89e20-6fff-7bc1-a22f-c62b66d7eb1e
msgctxt "hb3f28d00gb3e9g45d2gb142g7b67bdb61e32"
msgid "Some of us are counting on you."
msgstr "우리들 중 일부는 너만 믿고 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = acf03489-39ad-8175-5934-b94de5a1252c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:acf03489-39ad-8175-5934-b94de5a1252c
msgctxt "h4f51e96eg7d78g4d68ga4beg95633fd188f5"
msgid "Could be the evil curse surrounding us."
msgstr "그저 주변의 사악한 저주일 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = af49ff93-56a3-c15a-7c8f-5db790dea10b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:af49ff93-56a3-c15a-7c8f-5db790dea10b
msgctxt "h84080583g9475g4d22ga660g19ecdd1ec901"
msgid "What are you doing here?"
msgstr "여기서 뭐하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = af50dc94-ea93-14af-937a-a0423b3358f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:af50dc94-ea93-14af-937a-a0423b3358f2
msgctxt "hbb30a6b0gf219g4940ga859g320e04fa793e"
msgid "Talk to your friends about it. It's none of my business."
msgstr "네 친구들에게 말해보지그래. 내 알 바 아니니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = af762db7-1cbb-89d5-8c6a-e5bea2e1421e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:af762db7-1cbb-89d5-8c6a-e5bea2e1421e
msgctxt "hfce3b25fg9d72g450eg8e4bg55a47ddf836a"
msgid "Then again, my track record is... well. Discouraging."
msgstr "그렇다고 해도 내 성과도... 음. 실망스러웠으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = b25dd575-5c2c-d5ab-805a-03024fbcf059
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:b25dd575-5c2c-d5ab-805a-03024fbcf059
msgctxt "h3508bf23ge796g474dg9fa4g2169390755b6"
msgid ""
"In that case, you'll be very pleased to learn what I have in store for you."
msgstr "그렇다면야, 내가 널 위해 준비해 놓은 것을 보면 기뻐할 수밖에 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = b41ade10-99e6-a260-d782-8822d61f285a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:b41ade10-99e6-a260-d782-8822d61f285a
msgctxt "hedb46b6dgfea5g4bb9ga5f9g8135fcc1fbb9"
msgid ""
"I'll do my part according to my talents, and you, I hope, will do yours."
msgstr "나는 내 능력에 맞는 부분을 맡을게. 그러니 너는, 희망컨대, 네가 맡은 부분을 하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = b43296ee-ca4d-778b-db01-93f2192af000
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:b43296ee-ca4d-778b-db01-93f2192af000
msgctxt "h865ef398g8a84g42aeg8e00ga7190c2250c6"
msgid ""
"I seek not promises, my friend, but deeds worthy of your prodigious talents."
msgstr "난 확신을 바라는 것이 아니야, 친구. 다만 너의 굉장한 능력에 걸맞은 활약을 바랄 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = b907a478-9731-9f36-bb60-30c346ae5493
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:b907a478-9731-9f36-bb60-30c346ae5493
msgctxt "hc617ed19gaf51g4852ga58ag5cb13f8dfd7c"
msgid ""
"Still. A friend is a friend. And Wulbren won't last long in a place as "
"dreadful as the Towers."
msgstr "그래도, 친구는 친구니까. 울브렌은 저 탑처럼 끔찍한 곳에서 오래 버티지 못할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = b919ec18-0591-802a-23eb-931c241378d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UnfortunateGnome_State_PlayerOfferedHelp = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:b919ec18-0591-802a-23eb-931c241378d5
msgctxt "h17733109g78e4g4e49gab9eg4e031aaa1e50"
msgid "I'll keep an eye out for your friends, but no promises."
msgstr "네 친구들을 계속 찾아보겠지만, 확신은 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = ba396492-20c6-7d9c-2c62-7da7ead8599a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:ba396492-20c6-7d9c-2c62-7da7ead8599a
msgctxt "h43920a0eg6c5cg409aga8a6g9028bb17475a"
msgid ""
"I can't tell if you're my good luck charm, or an omen of my every "
"misfortunate."
msgstr "네가 행운의 부적인지, 이 모든 불행의 징조인지 모르겠지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = babebf33-e790-25d5-0fc8-a91fb302f227
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:babebf33-e790-25d5-0fc8-a91fb302f227
msgctxt "h5c15ef36gc728g4c65g8744g02cf4ea9ccc0"
msgid "That bloody cult has taken too much. They <i>need </i>to be stopped."
msgstr "그 망할 교단은 너무 많은 걸 앗아갔어. 놈들을 <i>무슨 일이 있어도</i> 막아야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = be14abc6-88a9-5c06-8658-a6f5abff9ddc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:be14abc6-88a9-5c06-8658-a6f5abff9ddc
msgctxt "h18e296e7g35efg4b41ga5c9g7af6f3ee14d1"
msgid "I have more important things to do."
msgstr "나한텐 더 중요한 일이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = bf3a0e20-4a70-e050-9f4d-14073aad2baa
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: PLANAR
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:bf3a0e20-4a70-e050-9f4d-14073aad2baa
msgctxt "h4cee4aa9ge45cg4f16g8da1g011f47c7ceed"
msgid ""
"Pah! Wulbren's a... parochial sort. The mere sight of you would knock him "
"out cold."
msgstr "하! 울브렌이 좀... 꽉 막힌 놈이라. 널 보자마자 아예 기절해버릴걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = bf3a0e20-4a70-e050-9f4d-14073aad2baa
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: HALFORC
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:bf3a0e20-4a70-e050-9f4d-14073aad2baa
msgctxt "h54583d3eg8f40g4060g9bdegc38e7243ceb4"
msgid ""
"I'm certain Wulbren's never met a half-orc. He'd probably think you're a "
"hallucination."
msgstr "울브렌은 하프오크를 만나본적도 없을걸. 아마 네가 환영이나 뭔가인 거라 생각하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = bf3a0e20-4a70-e050-9f4d-14073aad2baa
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: DUERGARDWARF
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:bf3a0e20-4a70-e050-9f4d-14073aad2baa
msgctxt "hd7d7e5fcg9a3ag4b9cg8d6dg4deb7cefeacd"
msgid "A duergar saviour? Pah! Wulbren wouldn't understand the concept."
msgstr "듀에르가 구원자라니, 하! 울브렌 녀석 생각해본 적도 없을걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = bf3a0e20-4a70-e050-9f4d-14073aad2baa
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: DRAGONBORN
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:bf3a0e20-4a70-e050-9f4d-14073aad2baa
msgctxt "ha886758fgfd92g42eag89dfg41e7cb25271e"
msgid "Pah! The mere sight of a dragonborn would scare him senseless."
msgstr "하! 드래곤본을 보기만 해도 그녀석 지려버릴걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = bf3a0e20-4a70-e050-9f4d-14073aad2baa
#. HandlePath = TaggedText[4].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:bf3a0e20-4a70-e050-9f4d-14073aad2baa
msgctxt "hd1875267ge3eeg415fgb6a3gc39d967bd35d"
msgid "You wouldn't even know what he looks like."
msgstr "그가 어떻게 생겼는지도 모르잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = c105e203-9a11-5af3-0efa-752957ae2e81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:c105e203-9a11-5af3-0efa-752957ae2e81
msgctxt "h5bf60cddgeb3fg4946g871dgf5d9c1b3b630"
msgid ""
"The deep gnomes at the Towers, of course! And Wulbren among them, if he's to "
"be found."
msgstr "당연히 타워에 잡혀있는 딥노움들을 말하는 거지! 그 중 특히 울브렌, 찾을 수만 있다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = c17107f1-3a49-8424-1f81-7e1ab8b842c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:c17107f1-3a49-8424-1f81-7e1ab8b842c6
msgctxt "hfd65f99cg08a8g4af6g9a22g2b2e79505d79"
msgid "So, so utterly."
msgstr "아주 아주 지독하게 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = c27bdda5-14e6-12a4-9cf3-ab6c9b7f0e6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:c27bdda5-14e6-12a4-9cf3-ab6c9b7f0e6c
msgctxt "hbd0961e5gd5ddg48b5gb4d3g0dd7639dd9c9"
msgid "Eh."
msgstr "흠..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = c3a7a7ff-2002-b77d-c03b-9cd8eb50d02e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:c3a7a7ff-2002-b77d-c03b-9cd8eb50d02e
msgctxt "hdc4c37b1g3a92g41b3g86b2g649fc1ac6424"
msgid "I did - though with a few hiccups along the way."
msgstr "잘 찾아왔지. 오는 길에 <i>사소한</i> 문제들이 있기는 했지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = c3d7cb5b-4017-3af3-80ca-e438b256e380
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:c3d7cb5b-4017-3af3-80ca-e438b256e380
msgctxt "hfdd49972g73cfg493cg975dg744a5598badb"
msgid "Depends. What did you say you were making?"
msgstr "상황에 따라 다르지. 뭘 만들고 있었다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = c3f45fdc-c766-b74c-7cd5-5b65441a455f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:c3f45fdc-c766-b74c-7cd5-5b65441a455f
msgctxt "h294e7620g485bg4003ga424g6625d0bbaa1d"
msgid ""
"It didn't seem right to let you do <i>all </i>the work. And as it happens, "
"I've cobbled together something of an alchemist's workbench here in this inn."
msgstr "너한테 <i>모든</i> 일을 맡기는 건 옳지 않은 것 같았어. 그래서 어쩌다보니, 연금술 작업대 같은 걸 여관에 만들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = c5df2f19-1b74-d43a-838a-065f6014c4a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:c5df2f19-1b74-d43a-838a-065f6014c4a4
msgctxt "h0d77ba77ge77ag49e4g989dg38ce5bbdb942"
msgid ""
"Sounds good. But I haven't forgotten you also promised me a reward once I've "
"saved your friend."
msgstr "괜찮아 보이네. 그런데 네 친구들을 구해주면 보상을 주겠다고 한 말도 기억하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = c69c8dec-a49a-b30c-fb9d-5b8c6a2025f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:c69c8dec-a49a-b30c-fb9d-5b8c6a2025f1
msgctxt "h5cb32707g955ag40dfgb51fg6f03eb8b42d6"
msgid "Well. I've been through worse."
msgstr "글쎄. 그동안 꽤 힘들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = c84dd378-d523-9e36-8aec-e3d77f06450f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:c84dd378-d523-9e36-8aec-e3d77f06450f
msgctxt "hb8321beag35a5g475fg9152g9506ca97a8af"
msgid "It's too late for Wulbren. For me. But not for others. Nor for you."
msgstr "이미 늦어버렸어, 울브렌도. 나도. 하지만 다른 자들은 아니지. 너도 늦지 않았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = c89c04c6-3f5d-c3a4-ea00-68468b08d4d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:c89c04c6-3f5d-c3a4-ea00-68468b08d4d3
msgctxt "h0d592f8cga6fag4673g822eg6f81cdd95a16"
msgid "Please. I'll make it <i>extra </i>explosive. Just for you."
msgstr "제발. 내가 <i>특별히</i> 폭발적으로 만들어 줄게. 널 위해서 말야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = c8d56a03-3d8b-0d2e-d70f-782a22928dd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:c8d56a03-3d8b-0d2e-d70f-782a22928dd7
msgctxt "h3f27e5fag9d94g4608g8477gc9a3552de43f"
msgid "Friends. And Wulbren. He... he..."
msgstr "친구들. 울브렌. 그가... 그가..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = cab0354b-8366-5bd6-9405-19eefa368640
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:cab0354b-8366-5bd6-9405-19eefa368640
msgctxt "h29525f5egda44g4df5gbe10g0f8be4cebced"
msgid "I'm going to Moonrise Towers, too. Why don't you let me look for him."
msgstr "나도 문라이즈 타워로 가는 길이야. 내가 울브렌을 찾아볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = cc355306-e888-2296-87f7-bf860488ea34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:cc355306-e888-2296-87f7-bf860488ea34
msgctxt "heb06c6c0g931cg4dd8gb333g344b93bb1db3"
msgid ""
"<i>Out </i>of one, really. It took a bit of nimble footwork to make it "
"through the darkness un-cursed."
msgstr "실은 곤경에서 막 <i>빠져 나온</i> 참이야. 저주받지 않고 저 어둠에서 빠져나오는데 다리가 좀 힘들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = cd61f00e-f769-5c04-2ee9-2b808942f079
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:cd61f00e-f769-5c04-2ee9-2b808942f079
msgctxt "head6f8c8gcba6g4a41gb27ag9ef639b4d54e"
msgid "Don't know. Don't care."
msgstr "몰라. 신경 쓰지도 않고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = cda9ffea-bdac-3784-3955-5de093a1ee44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:cda9ffea-bdac-3784-3955-5de093a1ee44
msgctxt "h5e67779egf913g403ag99c1g38a1ee423e9b"
msgid "Now, if you're done rifling through my things..."
msgstr "자 이제 가봐, 내 물건들 뒤지는 게 끝났으면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = ceff6dd6-32be-4cd4-cf31-d4d64b0db125
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:ceff6dd6-32be-4cd4-cf31-d4d64b0db125
msgctxt "h67a8bb16g7ed9g461cg9ff7ge24cfd2a4075"
msgid "You mean - but that means - <i>Wulbren.</i>"
msgstr "네 말은... 그럼 그 말은... <i>울브렌.</i>이..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = d14da3b6-c510-d0ff-aae6-f21e4168aa82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:d14da3b6-c510-d0ff-aae6-f21e4168aa82
msgctxt "h182f2ee1g7ffcg4bf8g99fag27f38b15a1d6"
msgid "When will it be ready?"
msgstr "언제쯤 완성될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = d1d78e28-0055-1567-6003-83a68721448d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:d1d78e28-0055-1567-6003-83a68721448d
msgctxt "h4f8eaa59g83a1g4baag9758gb01859fec21c"
msgid "I'll bear that in mind."
msgstr "마음에 새겨둘게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = d4ac557c-dc69-8305-9413-75daab1f4a71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:d4ac557c-dc69-8305-9413-75daab1f4a71
msgctxt "h0b2f2900g4271g442dg9e59g5c59011c97f6"
msgid "Luckily, I found this place. As have you."
msgstr "다행히도, 이 곳을 발견했지. 너처럼 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = d6be8cbd-37cd-0da1-743c-7274275a8180
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:d6be8cbd-37cd-0da1-743c-7274275a8180
msgctxt "heb1ee8a7g23c8g4d37g91b2g96f5735552c3"
msgid "<i>Especially </i>the Absolute."
msgstr "<i>특히</i> 절대자가 그렇지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = d7cfe1bb-ae31-cf66-dbdc-d4ab3c1125c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:d7cfe1bb-ae31-cf66-dbdc-d4ab3c1125c6
msgctxt "he72413f5gcb16g4843gbdb9ge1e09a96b78f"
msgid "What's that you're making?"
msgstr "뭘 만들고 있는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = d817e9ed-c0e1-215a-b560-e22061bc2a6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:d817e9ed-c0e1-215a-b560-e22061bc2a6e
msgctxt "h5177a16cgd4a1g47dfgaea5ga63a8002a0df"
msgid "And you're doing... general heroism, I believe it is?"
msgstr "그리고 너는... 영웅적 행보를 계속하고 있구나, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = d91798de-4930-31fb-3d72-e6689b188d42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cebe520f-cc62-3297-f9f1-1700a2b84c8a_AskedWulbren = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:d91798de-4930-31fb-3d72-e6689b188d42
msgctxt "h019bc589g9519g454eg91bdg419513a30663"
msgid "Wulbren who?"
msgstr "울브렌이 누구라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = db86e597-e259-c360-0c92-0caace355eac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:db86e597-e259-c360-0c92-0caace355eac
msgctxt "hdb07b459g36ceg4e12ga011g0108ebea1745"
msgid "What's next on your agenda?"
msgstr "다음 계획은 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = dc32ee1a-52ae-b8ed-b5e0-341671baa3eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:dc32ee1a-52ae-b8ed-b5e0-341671baa3eb
msgctxt "hd9a20337g9e8dg43d4g8ce6g56acad18e5f7"
msgid ""
"Shades. Death. Harpers. Flaming Fist. And <i>this</i>, of course. And the "
"makings of an alchemist's workbench. Ingredients, too."
msgstr ""
"그림자, 죽음, 하퍼즈, 플레이밍 피스트를 찾았지. 그리고 바로 <i>이것</i>도 말이야. 또 연금술 작업대를 만들 부품과 연금술 "
"재료도 찾았어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = dd69d026-3711-7044-bf61-0d1770537e44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:dd69d026-3711-7044-bf61-0d1770537e44
msgctxt "h9038b523g369fg499cg8afbg5d6a85f1b010"
msgid "Seems you can handle things yourself."
msgstr "너라면 할 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = dd91cc7a-ac17-9682-d085-e23d2193d18e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_BarcusGoesToWulbren = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:dd91cc7a-ac17-9682-d085-e23d2193d18e
msgctxt "h4df978bfgd2efg496bga3dcg3abb13459e87"
msgid ""
"I give you: <i>The Brilliant Retort! </i>Now - I need to go find Wulbren!"
msgstr "네게 <i>훌륭한 응수</i>를 주겠어! 자, 이제 울브렌을 보러 가야겠어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = ddb677e2-17ab-ce05-e406-2638c1d1b686
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:ddb677e2-17ab-ce05-e406-2638c1d1b686
msgctxt "h407020ebgae1eg49d7g95bfg69f81c560de8"
msgid "I decided to scout ahead and get the lay of the land."
msgstr "미리 정찰이라도 해서 상황 파악을 하려 했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = df14f5fa-183b-25c2-b614-41824c2eed14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UnfortunateGnome_State_PlayerOfferedHelp = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:df14f5fa-183b-25c2-b614-41824c2eed14
msgctxt "h2aea6e9bgad4ag46ffg8cb9gec7db57754a0"
msgid "I help a lot of people - remind me who you mean?"
msgstr "너무 많은 사람들을 구하고 다녀서 말이야. 그게 누구였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = e29b83d8-e638-2349-0915-d69377449094
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_State_ReturnCompleted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:e29b83d8-e638-2349-0915-d69377449094
msgctxt "hd2dbafb1gd592g481cgbb30g694efddfb799"
msgid "Ah. There you are."
msgstr "아. 거기 있었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = e2cd002f-f351-a012-fc3a-c010c6c69c6c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_SavingPrisoners_State_ReturnCompleted = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:e2cd002f-f351-a012-fc3a-c010c6c69c6c
msgctxt "h909e863dg7707g4b7fgbc6agbbd48a4b0093"
msgid "I'm sorry, Barcus - Wulbren is dead."
msgstr "미안 바커스. 울브렌은 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = e321cc7d-3c2a-b413-d6b9-948a6fddc676
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Event_BarcusGoesToWulbren = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:e321cc7d-3c2a-b413-d6b9-948a6fddc676
msgctxt "hefd0f3ecg34dfg406bgafa1g3bf0a410f32c"
msgid "Not now - Wulbren's back!"
msgstr "지금은 안돼, 울브렌이 돌아왔어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = e3a7f29f-a011-5a06-e7b0-ac17056237be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:e3a7f29f-a011-5a06-e7b0-ac17056237be
msgctxt "hf2d8466bgf89bg40bdgae94gf5255295e1df"
msgid ""
"He should <i>never </i>have joined those bloody Ironhand Gnomes. I told him, "
"and I told him, and I told him. And now? Now he's <i>dead.</i>"
msgstr ""
"<i>절대로</i> 그 망할 아이언핸드 노움에 합류하게 두는 게 아니였어. 그리 말하고 말하고 또 말했는데. 결국 어떻게 됐지? 결국 "
"<i>죽어버렸잖아.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = e544c427-5e5b-0d2e-9dc5-64ad8cf6f09f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:e544c427-5e5b-0d2e-9dc5-64ad8cf6f09f
msgctxt "h57f7e6d0g9bfeg4c15g8125g0410b6b16be5"
msgid ""
"You'll need it if you're going to get into Moonrise Towers and help the deep "
"gnomes taken prisoner there."
msgstr "네가 문라이즈 타워로 가서 포로로 잡힌 딥 노움들을 구해주는 데 필요할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = e54d7ca0-04cf-2339-ba08-dd0c6c259305
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:e54d7ca0-04cf-2339-ba08-dd0c6c259305
msgctxt "he41d4bdag6f7bg4666gafa1g475730fd1bdd"
msgid ""
"Wait! Wait. I may be proud, but I'm no fool. If Wulbren is to be found, you "
"stand the best chance of finding him."
msgstr "잠깐! 기다려. 내가 잘나긴 했지만 바보는 아니야. 울브렌을 찾아야 한다면 네가 제격이란 건 알고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = e64fd917-814c-95e8-6fad-d18186f59ee6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:e64fd917-814c-95e8-6fad-d18186f59ee6
msgctxt "h6a3a81e9g4d36g4aeaga2c6g1be5622ca01d"
msgid ""
"Let's call a thing a thing: a deep gnome won't get far into the Absolute's "
"orgy of evil. We already learned that in the Underdark with those sadistic "
"duergar, didn't we? It's <i>doubly</i> true in this place."
msgstr ""
"현실을 직시해보자. 나 같은 딥 노움이 절대자 놈들이 모여있는 악의 구렁텅이에서 오래 버틸 수 있을 리가 없어. 우리 둘 다 새디스트 "
"듀에르가들이 있는 언더다크의 사례에서 배웠잖아, 그치? 이번에는 두 배는 더 확실하다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = e7a0962a-164f-5dd8-6cf8-f1a97381a44f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = False
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:e7a0962a-164f-5dd8-6cf8-f1a97381a44f
msgctxt "h0d96e4d4gc01ag41e6ga991g062d5a81c946"
msgid ""
"I don't work for free. Throw in the plans for what you're working on and "
"I'll consider."
msgstr "난 공짜로 일하지 않아. 네가 작업하고 있는 것에 대한 계획들을 넘겨주면 고려해보지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = e7c75d51-b02c-29d9-7a46-8c876e17cda1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_SavingPrisoners_Knows_BrilliantRetort = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:e7c75d51-b02c-29d9-7a46-8c876e17cda1
msgctxt "hb3e8c0edg2967g47f7ga8ddg7219378f2cb1"
msgid "The <i>Brilliant Retort </i>will aid you. Thus, I will make it."
msgstr "바로 <i>화려한 응수</i>가 널 도울 거야. 그러니, 만들어 내겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = e86d5968-db0b-2ae1-5872-b5ddc9da24fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:e86d5968-db0b-2ae1-5872-b5ddc9da24fb
msgctxt "h5be8ce1fgc55ag46baga999g10e98e153c09"
msgid "How did you make your way through the shadows?"
msgstr "어떻게 그림자를 헤쳐나온 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = eadba254-87d4-0f96-f10a-a9deddc43eac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:eadba254-87d4-0f96-f10a-a9deddc43eac
msgctxt "h3c2d25c2g8f45g44a0g8652g216379a6f6ee"
msgid "What's that you're making?"
msgstr "저기 만들고 있는 건 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = ebcf1e90-c231-87da-c499-428b2c0e0120
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:ebcf1e90-c231-87da-c499-428b2c0e0120
msgctxt "hd76f6d89g8ffdg44a3gb3e8g23e5628ff491"
msgid "You'll need it if you're going to survive this cursed place."
msgstr "그림자 저주가 가득한 이 땅에서 살아남으려면 필요할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = ef32539b-c483-12f2-565f-459e37a825d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:ef32539b-c483-12f2-565f-459e37a825d2
msgctxt "h8d42da2cg6765g4da7gbd84gf4a23712f25f"
msgid "The cult has probably taken him for parts by now. Oh well."
msgstr "아마 광신도들이 지금쯤이면 조각내 버렸을걸. 저런."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = ef75b154-4466-5512-7c8a-92002b3fff35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:ef75b154-4466-5512-7c8a-92002b3fff35
msgctxt "hdf3192abg2829g4f87gaec4g3d815db3ba61"
msgid ""
"If you'll agree to look for him, I'll make myself useful here. I've spotted "
"an alchemist's scales and had already been dreaming up a little something to "
"help fight off those loathsome cultists."
msgstr ""
"네가 울브렌을 찾는데 협력해 준다면 나도 여기서 내 역할을 할게. 어느 연금술사의 장비들을 찾아서 이미 저 혐오스러운 광신도들을 쫓아낼 "
"무언가를 만들고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f0827ef4-e066-db3c-fc34-1e0a46d759c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:f0827ef4-e066-db3c-fc34-1e0a46d759c0
msgctxt "h1fdc2ccbg9f0bg446eg8a18ga83981f00022"
msgid ""
"A friend. I'd do anything to find him. Including trusting his fate to the "
"likes of you."
msgstr "내 친구. 울브렌을 구하기 위해서라면 뭐라도 할 거야. 너희 같은 사람한테 녀석의 운명을 맡기는 것도 포함해서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = f0cd2fde-b10a-c822-2233-22742fc89b53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:f0cd2fde-b10a-c822-2233-22742fc89b53
msgctxt "h261aefddg7881g4ed0g8939gcac51681def7"
msgid "Hadn't expected to find this place. I'm trying to get into the Towers."
msgstr "여기에 오길 기대한 건 아닌데. 나는 문라이즈 타워로 갈거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = f2bc05ec-f2a8-e54b-3fd8-2d6cdb0fb484
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_Knows_BrilliantRetort = True
#.      - HAV_WrootRequest_Event_GaveGift = False
#.      - GLO_UnfortunateGnome_State_PlayerOfferedHelp = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:f2bc05ec-f2a8-e54b-3fd8-2d6cdb0fb484
msgctxt "hbec5ad48g5d7eg409eg8409g4541cfcfe02e"
msgid "Is the <i>Brilliant Retort </i>ready?"
msgstr "<i>화려한 응수</i>는 다 만들었어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f2dcbb9b-a573-6141-9f88-7da910ed0b4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_SavingPrisoners_HasMet_UnfortunateGnome(1) = False
#.      - HAV_SavingPrisoners_UnfortunateGnome_NightsongFreedHasMet(1) = False
#.   Global:
#.      - IMPOSSIBLE = True
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_SavingPrisoners_HasMet_UnfortunateGnome(1) = True
#.     - HAV_SavingPrisoners_UnfortunateGnome_NightsongFreedHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:f2dcbb9b-a573-6141-9f88-7da910ed0b4f
msgctxt "hf0b489edgc250g48e1ga7f1g6ffab5786da7"
msgid ""
"A-ha. I was hoping you'd find this place. Thought you might've fallen in a "
"hole. I'm pleased to see you, but I think there's something happening at the "
"Towers. You like heroism, don't you? Might be of interest."
msgstr ""
"아-하. 네가 여길 찾아올 거라고 믿고 있었지. 어디 함정에라도 빠져버린 줄 알았잖아. 만나서 반갑지만 지금 탑에서 뭔가 일어나고 있는 "
"것 같아. 너 영웅이 되는 걸 좋아하는 거지? 가보는 게 좋을지 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f2f768e1-914d-d06d-9ea7-8a7729c2ef53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:f2f768e1-914d-d06d-9ea7-8a7729c2ef53
msgctxt "h0ffd95e7ga04bg4e3dg8b5dg038fb4747ed5"
msgid "Disappointment. The raisin cookie of the soul."
msgstr "실망스럽군. 건포도 쿠키 같으니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f725a634-6f7b-710c-3a49-a17eaf61e890
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:f725a634-6f7b-710c-3a49-a17eaf61e890
msgctxt "ha79e18cfg82d3g4dfbg8ca6g78955d2e24b2"
msgid "Now, I've only to find my way into the Towers..."
msgstr "이제, 탑으로 들어갈 길만 찾으면 돼..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f89c6e08-8361-606a-4bf8-e32256850a31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:f89c6e08-8361-606a-4bf8-e32256850a31
msgctxt "h4f979422g93bag4e8cg8474gf2de60e6fc26"
msgid ""
"Whatever it is, I'm sure the rescue of a few innocent citizens will round it "
"out nicely."
msgstr "그게 무슨 일이던간에 하는 김에 몇 죄없는 시민들을 구해주는 것 정도는 충분히 가능할거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Player
#. NodeID = f8a79d8b-f95a-5e76-9560-dd710dd38750
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:f8a79d8b-f95a-5e76-9560-dd710dd38750
msgctxt "hf33d13ceg4b6bg4231gaaf2g1fdebfd8296c"
msgid "How did deep gnomes get trapped in the Towers?"
msgstr "도대체 어떻게 딥 노움들은 그 타워에 갇히게 된 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = fd84782b-61b4-e6e7-f9c6-907c36e85d6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:fd84782b-61b4-e6e7-f9c6-907c36e85d6b
msgctxt "h1bfed662g9878g4adaga762g96b071307ef0"
msgid "Now! You - off to your... heroism, as it were."
msgstr "자! 넌... 언제나처럼... 너의...그... 영웅적 행보를 이어가렴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = fe01db77-73e5-85cb-8d1f-ed69c6fccc14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:fe01db77-73e5-85cb-8d1f-ed69c6fccc14
msgctxt "h0ced4ca8gc429g4589g85c3gbaeb52449792"
msgid ""
"Don't be ridiculous - if I give <i>you</i> the schematics, how in all of "
"Toril am I supposed to <i>make</i> the damn thing?"
msgstr "말도 안되는 소리. <i>너한테</i> 설계도를 줘 버리면, 내가 도대체 어떻게 그걸 <i>제작</i>할 수 있겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = ff4de185-77dc-866f-7d29-5372ec6b3f86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_UnfortunateGnome:ff4de185-77dc-866f-7d29-5372ec6b3f86
msgctxt "h931225bdgfb29g4e23g8adcg249d505d0b92"
msgid ""
"Unless you've got access to a 300-year-old Tempusian apothecarial almanac, "
"no."
msgstr "혹시 네가 300년 된 템푸스의 약재 연감을 읽을 방법이 가지고 있는 게 아니라면, 괜찮아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 036d2617-8b20-d667-9bfc-9872ad73ad6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:036d2617-8b20-d667-9bfc-9872ad73ad6a
msgctxt "h2ae51db1g5347g404eg9a3dgdcff75126219"
msgid ""
"The very one. It's the only mistake the Ironhand Gnomes ever made - and it "
"cost us everything."
msgstr "바로 그놈이야. 아이언핸드 노움의 유일한 오점이지 - 그리고 우린 모든 걸 잃었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 08450064-ec44-32a0-1a8d-9dd90d50e07b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:08450064-ec44-32a0-1a8d-9dd90d50e07b
msgctxt "h36164592g10d4g416bgac75g9b8ccf806271"
msgid "Now, was there something else?"
msgstr "이제, 다른 볼 일이 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 09c5251d-0cee-a1fa-5c84-ac9da3f14a34
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_IronhandGnomes = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:09c5251d-0cee-a1fa-5c84-ac9da3f14a34
msgctxt "h3fda082cg41e5g4266g9091g4cc1227a55ea"
msgid ""
"If you'd accomplished half of what the Ironhand Gnomes have, you would be "
"too."
msgstr "아이언핸드 노움 절반만큼만 이룬 게 있다면, 너도 마찬가지일걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 0b5c6149-c041-19d0-7ec1-bce24eba60cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:0b5c6149-c041-19d0-7ec1-bce24eba60cb
msgctxt "h589f7238g4212g4d80ga8a1gf67fc99ff91b"
msgid ""
"It was that or we all die. We clearly didn't - so it was the right choice."
msgstr "그러든지 아니면 다 같이 죽든지였어. 하지만 모두 살았지. 옳은 선택이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 0bc12c50-987a-cedd-9c33-c73543e32b90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:0bc12c50-987a-cedd-9c33-c73543e32b90
msgctxt "hec32762cg59a8g417fgb182g03d681e7fa4f"
msgid "Barcus tends to make more of it than it is."
msgstr "바커스에게는 우리 사이에 대해 과도한 의미를 부여하는 경향이 있긴 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 0c9af38f-c4ae-852d-d1ff-3a386b252941
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:0c9af38f-c4ae-852d-d1ff-3a386b252941
msgctxt "hcf9d5637g157eg4200g97a3g4427e4aedb52"
msgid ""
"Oh, we hail from the same village in the Underdark. Hung about in the same "
"passel of children."
msgstr "오, 우리는 언더다크의 같은 마을에서 자랐거든. 같이 어울려 놀았었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 172a851b-7ff9-b910-b02c-3d8c1aea4b34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:172a851b-7ff9-b910-b02c-3d8c1aea4b34
msgctxt "h9be5f8degba66g4e68g8461g1de1fcb09e6f"
msgid ""
"I'm sure, but that's his business. Now, is there something you want? I'm a "
"busy man."
msgstr "그렇겠지. 하지만 그건 그 녀석 사정이야. 자, 뭐 원하는 거라도 있어? 난 바쁜 몸이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 195f85d4-76d4-3527-4157-54927b89579d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:195f85d4-76d4-3527-4157-54927b89579d
msgctxt "hf5c7d8d1g95f8g4234gac27gffa2b4d3da89"
msgid ""
"We are inventors of the highest order, matched, perhaps, but never surpassed "
"by the Gondians at the High House of Wonders."
msgstr "우리는 최고의 발명가들이야. 경이의 집에 있는 곤드 신자는 우리와 대등할 순 있겠지만 절대 우릴 능가하진 못 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 20cb1490-8f98-2102-c6b9-848375aee52a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:20cb1490-8f98-2102-c6b9-848375aee52a
msgctxt "h56cbefb2g6433g45eegafc7g48488c154a2d"
msgid "Is that so? Well, you've piqued my curiosity."
msgstr "그래? 내 흥미를 돋우는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 2361e06a-cf55-b791-628e-2e9ef1bbc507
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UnfortunateGnome_State_InHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:2361e06a-cf55-b791-628e-2e9ef1bbc507
msgctxt "h426ba59eg6bbfg43f2g89e2gf7838516c593"
msgid "Your friend Barcus is just around the corner - have you said hello?"
msgstr "네 친구 바커스가 바로 근처에 있는데 - 인사는 했나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 30c9d085-ffbd-3838-cfed-1edd5eedb85e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_IronhandGnomes = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:30c9d085-ffbd-3838-cfed-1edd5eedb85e
msgctxt "hea858c90gd67ag4310g9c72gc01aa9017cec"
msgid "That's Ironhand Gnome business."
msgstr "그건 아이언핸드 노움 영역이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 32b2b76f-94cb-6947-ba2a-a6a47a501c2a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Wulbren_PostReunionHasMet(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:32b2b76f-94cb-6947-ba2a-a6a47a501c2a
msgctxt "h1eb41572g43bbg42d4gb91eg62111b11418c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 362e58f2-0986-1ead-f1a8-c42a6418c838
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:362e58f2-0986-1ead-f1a8-c42a6418c838
msgctxt "hdb27936dg920fg4ec1gb387ga771c104219c"
msgid "You agree with such machinations? Duly noted."
msgstr "그딴 음모에 정당함을 느낀다는 건가? 일단은 알아두지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 3c8e6f5d-af1c-cb0d-7ea4-e58bc1a1de15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#.      - HAV_WrootRequest_State_ReunionDone = False
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Wulbren_PreReunionHasMet(1) = True
#.   Global:
#.     - HAV_WrootRequest_Event_TalkedToWulbrenInHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:3c8e6f5d-af1c-cb0d-7ea4-e58bc1a1de15
msgctxt "h105cc918g3e77g45d6gbfaeg8027e369c5b5"
msgid "Hm? Oh - you made it. Well done."
msgstr "흠? 오, 살아남았군. 잘했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 3e2e4682-f344-3d60-8a0f-ff1cac650a45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:3e2e4682-f344-3d60-8a0f-ff1cac650a45
msgctxt "h51845a35g8579g41a8g82dagacfda9cffac3"
msgid "He's got more courage than you give him credit for."
msgstr "네가 생각하는 것보다 훨씬 용감한 친구던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 405fa489-ef3f-7aa6-252d-ab3863c2a3f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:405fa489-ef3f-7aa6-252d-ab3863c2a3f2
msgctxt "h5c18eb8fga62bg4da9gbbdag9ecebcaa3650"
msgid "I'm glad you're all right."
msgstr "무사한 걸 보니 기쁘군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 46d1b099-48a4-7c65-6231-71d446dc70d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:46d1b099-48a4-7c65-6231-71d446dc70d3
msgctxt "hc1b385e8g6866g4de8ga217g96af473a25eb"
msgid "I apologise for losing my temper, but you were being rather harsh."
msgstr "화낸 건 미안하게 됐어. 하지만 네가 좀 심했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 49a6c557-0033-0528-3bf2-a6168b41a16c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:49a6c557-0033-0528-3bf2-a6168b41a16c
msgctxt "h4c2792edg0b5bg40c6g9ec4g9d09db33626a"
msgid ""
"Steering a boat is hardly a challenge - and this place is near a beacon in "
"the darkness."
msgstr "배를 모는 게 그렇게 어려운 일은 아니지. 거기다 이 장소는 어둠 속에서 등대나 다름없거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 4d95e778-be14-2810-b07a-afd614905288
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:4d95e778-be14-2810-b07a-afd614905288
msgctxt "h9b21d83cg177eg4df1gb083g2d2db55ca4ca"
msgid ""
"To use it as all innovators do - for the good of the realm. Nothing to "
"concern yourself with."
msgstr "모든 혁명가들이 하는 일이지. 좋은 세상 만들기. 걱정할 것 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 5141337d-4c81-d142-98fd-cea89e182397
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:5141337d-4c81-d142-98fd-cea89e182397
msgctxt "h4284a212gf191g4501gabb7ge615c7d6b9c6"
msgid "Friend is a strong word, don't you think?"
msgstr "친구라는 말은 좀 더 조심히 사용하는 게 좋지 않겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 530e3d84-79f6-4a3b-6c1b-41fe875aafa0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Wulbren_State_GaveReward = False
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Wulbren_State_GaveReward = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:530e3d84-79f6-4a3b-6c1b-41fe875aafa0
msgctxt "h801cd425gf8dfg43bag9e1dgf74bba2c32cc"
msgid "You're not going to thank me for saving your life?"
msgstr "네 목숨을 구해준 것에 대해 감사는 하지 않을 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 5506da62-b93c-ebc0-2dc8-01c7c4837691
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Wulbren_AskedAboutRunepowder(1) = True
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = False
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Wulbren_AskedAboutRunepowder(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:5506da62-b93c-ebc0-2dc8-01c7c4837691
msgctxt "hed2c2708g009fg4f15gbaa7g69afec7128e9"
msgid ""
"Runepowder - I know you were looking for it in the Underdark. What are you "
"planning?"
msgstr "네가 언더다크에서 룬파우더를 찾던 건 알고 있어. 뭘 꾸미는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 55826162-dccd-9c36-86db-3a3fe5c2a637
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:55826162-dccd-9c36-86db-3a3fe5c2a637
msgctxt "he6139ceeg9313g4453ga367g140ac8004e85"
msgid ""
"Besides, in the end, we both survived. And that's all that matters. So let's "
"call this a fresh start, for us both."
msgstr "어쨌든, 결국에는 우리 모두 살아남았잖아. 그게 제일 중요한 거지. 그러니 우리 모두에게 있어 새로운 시작이라고 생각하자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 56bf0b99-8b65-b2b9-423d-c7cb8272f629
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:56bf0b99-8b65-b2b9-423d-c7cb8272f629
msgctxt "h69f710f7g5729g4a02g8928gef9373f9d501"
msgid "As if there was any doubt."
msgstr "당연한 소리지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 5f097abb-5a48-cbf8-5734-0df2d96578b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:5f097abb-5a48-cbf8-5734-0df2d96578b9
msgctxt "h15f757f2ge9d4g46f2g8e5ag7d12828d2866"
msgid "I should gut you where you stand, traitor!"
msgstr "그 자리에서 내장을 뽑아주마, 배신자!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 63d6d4af-ca7a-749c-ab72-3109b7e103e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:63d6d4af-ca7a-749c-ab72-3109b7e103e8
msgctxt "h4c88eb7bg31f3g4ab0g9c2egea199e77da97"
msgid "Yes, despite the fact that you left me <i>behind.</i>"
msgstr "그래, 네가 날 <i>버려두고</i> 갔음에도 불구하고 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 640fe689-0295-7450-e086-6ad4e3841d20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:640fe689-0295-7450-e086-6ad4e3841d20
msgctxt "h7bdd220agb250g4c3fgb0b7ga50106b0fcdd"
msgid "You're quite confident in yourself, aren't you?"
msgstr "스스로 꽤 자신감이 있나 보군?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 65063161-d26a-3bcc-353a-d6fb1dda55ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:65063161-d26a-3bcc-353a-d6fb1dda55ad
msgctxt "h1e9827e6g04f4g4d13ga128gabeffba9cb65"
msgid "Here - that should cover your services."
msgstr "받아 - 이 정도면 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 66021a01-dc17-b861-cebf-8bfc0a05a6e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Wulbren_State_GaveReward = False
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Wulbren_State_GaveReward = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:66021a01-dc17-b861-cebf-8bfc0a05a6e5
msgctxt "h1a9a06cegf015g464cg9cd8g18c43bc28261"
msgid "I deserve payment - if not for me, you'd be dead."
msgstr "내가 아니었다면, 너는 죽었겠지. 대가를 받을만하다고 보는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 66f47803-b03e-2b5b-d0d0-c5f36905117c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_State_ReunionDone = True
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Wulbren_PostReunionHasMet(1) = True
#.     - HAV_SavingPrisoners_UnfortunateGnome_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:66f47803-b03e-2b5b-d0d0-c5f36905117c
msgctxt "hbeda6fcfg24a0g4d24g9821g0353a57f5490"
msgid ""
"You're good to have humoured Barcus for so long. The poor fellow is like "
"creeping moss, if you know what I mean."
msgstr "바커스의 비위를 맞춰 주느라 고생했어. 그 한심한 녀석은 정말이지 기어다니는 이끼 같다니까. 무슨 말인지 알겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 687a263c-23d0-ba33-3f40-9af1c4d5029a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:687a263c-23d0-ba33-3f40-9af1c4d5029a
msgctxt "he16186d2g71f3g4a44gac78gf64810a9a7fa"
msgid "Once a prick, always a prick."
msgstr "한번 꼴통은 영원한 꼴통이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 6ad5ae55-87b6-3743-0d79-9ee037c40fc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:6ad5ae55-87b6-3743-0d79-9ee037c40fc6
msgctxt "h6e8aa6begcd8eg40bcgb6c6g757122e566f1"
msgid "I don't. Perhaps you could explain."
msgstr "모르겠는데. 설명해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 6f6b8c23-b9e7-117a-e3f2-3568ff2fa84b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:6f6b8c23-b9e7-117a-e3f2-3568ff2fa84b
msgctxt "h90f161f1gb0f0g40f2g9cf4gcb913d8fac4d"
msgid "Busy, are you?"
msgstr "바쁜가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Narrator
#. NodeID = 6f91fe98-60c5-52dc-adbb-ca04b13eb59e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 069abb40-ff7f-3eee-ece9-6480a8af79ec_historysuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:6f91fe98-60c5-52dc-adbb-ca04b13eb59e
msgctxt "h5053ab8bgb6c6g48b3g84a7g9aeca1f2b50f"
msgid ""
"*You recall stories of the Ironhand Gnomes - a talented group of inventors "
"who were banished from Baldur's Gate.*"
msgstr "*당신은 아이언핸드 노움에 관한 이야기를 떠올립니다. 발더스 게이트로부터 추방당한 뛰어난 발명가 집단입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 71626b73-2400-138c-2bcc-bed610eb1ab4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:71626b73-2400-138c-2bcc-bed610eb1ab4
msgctxt "h6dc1ce39gdc47g44cbgaa5cgabb180e092fa"
msgid ""
"But our forebears were foolish - complicit with Sarevok's madness over a "
"century past, and so we were banished. Still are to this day."
msgstr "하지만 우리 선조는 멍청했어 - 백 년도 더 전에 사레복의 미친 짓거리에 가담한 죄로 추방당했지. 지금까지도 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 745b0ab1-c29a-5e7a-e895-1fae76e7771f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:745b0ab1-c29a-5e7a-e895-1fae76e7771f
msgctxt "h853a57f7g3557g4dbdgbcffge3fbebe0a510"
msgid ""
"Perhaps. But why should I be punished for a mistake I took no part in? The "
"Gondians refuse us, time and time again."
msgstr "그럴지도. 하지만 왜 내가 하지도 않은 잘못 때문에 벌을 받아야 하지? 곤드 신자들은 우릴 끊임없이 거부한단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 81ff9266-2fd5-06c3-0163-39bc1d4c2ff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:81ff9266-2fd5-06c3-0163-39bc1d4c2ff4
msgctxt "hb7b7e8e9g5620g43b9g888bg02588a08e7aa"
msgid ""
"Perhaps, but sometimes cruelty is a kindness. Believe me, Barcus would do "
"well to keep his distance."
msgstr ""
"그럴지도 모르지. 하지만 때로는 냉혹함이 친절함일 수도 있는 법이야. 내 말을 믿으라고. 거리를 두는 데 익숙해지는 게 바커스에게도 좋을 "
"거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 82804014-48ce-da85-8293-36ee966f8abe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Wulbren_AskedAboutIronhandGnomes(1) = False
#.   Global:
#.      - GLO_IronhandGnomes_Knows_IronhandGnomes = True
#.   Local:
#.      - 069abb40-ff7f-3eee-ece9-6480a8af79ec_historysuccess = False
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Wulbren_AskedAboutIronhandGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:82804014-48ce-da85-8293-36ee966f8abe
msgctxt "hcad1250bgce1fg434ag9538g4d42411345ef"
msgid "What part do you play in the Ironhand Gnomes?"
msgstr "아이언핸드 노움 조합에서 네 역할이 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 8a72f91a-d0ce-3188-7f96-1e3fdc6cf9f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:8a72f91a-d0ce-3188-7f96-1e3fdc6cf9f4
msgctxt "h72ec35d9gad80g4b7bgade4g98fac772ddd6"
msgid "Depends on the question."
msgstr "질문에 따라서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 8fcff63a-b14a-2e01-5e14-6ac6ecc6625c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:8fcff63a-b14a-2e01-5e14-6ac6ecc6625c
msgctxt "he81815e3g0953g4010ga482g82fe65e0e814"
msgid "Pity he never succeeded."
msgstr "그가 성공하지 못한 게 아쉬울 따름이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 928de161-7ab2-2252-75da-3ee4d8cbe244
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Wulbren_HasMetAlert(1) = True
#.   Global:
#.      - IMPOSSIBLE = True
#.      - HAV_Mood_State_Alert = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:928de161-7ab2-2252-75da-3ee4d8cbe244
msgctxt "h0952a077gc88ag45b6gbc33g8c82c9038faf"
msgid ""
"Every moment Ketheric lives is another I am away from Baldur's Gate - I need "
"to return. And soon."
msgstr "케서릭이 살아있는 한 나는 발더스 게이트에 갈 수 없어. 나는 최대한 빨리 돌아가야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 95633fbe-6a6e-8d2a-928d-456e46cb6761
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Wulbren_AskedAboutBarcus(1) = False
#.   Global:
#.      - GLO_UnfortunateGnome_State_InHaven = True
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Wulbren_AskedAboutBarcus(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:95633fbe-6a6e-8d2a-928d-456e46cb6761
msgctxt "h18f62c77g6301g4684g9367g5736ded6fc1d"
msgid "How do you and Barcus know each other?"
msgstr "바커스와는 어떻게 서로 알게 된 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 960ddcf6-4ee1-daf8-32d6-8b12ef0fecc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:960ddcf6-4ee1-daf8-32d6-8b12ef0fecc5
msgctxt "hd5fd5ad9g96d4g498bg8d3ag2aa3aaef2e0d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 97618984-1157-ea72-17c9-26b67fa2e3ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:97618984-1157-ea72-17c9-26b67fa2e3ab
msgctxt "h7be1112bgde1cg4a85g99c1g3cbd9be106e7"
msgid ""
"Look, were our positions reversed, I'd be angry too. But if I die, every "
"Ironhand Gnome in the realm will suffer for it."
msgstr "이봐, 처지가 바뀌었다면 나 역시 화났을 거야. 하지만 내가 죽으면, 세상 모든 아이언핸드 노움들이 고통받게 된다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 986cc148-9a13-5418-d463-bc1f25cc12d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:986cc148-9a13-5418-d463-bc1f25cc12d1
msgctxt "h69378350ga2eag4bdega4e4g50174076f714"
msgid "We just have to get to the city first."
msgstr "도시에 도착하는 게 먼저가 아닐까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 9926f532-931f-5883-25e0-04e2c7b267b8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_WulbrenReward = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:9926f532-931f-5883-25e0-04e2c7b267b8
msgctxt "hb74e971ag69bfg4b3dgae23g5e244284eed6"
msgid "Did I not already? How remiss of me."
msgstr "이미 하지 않았던가? 이런 내 정신 좀 보게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = 995dc17c-eedf-a960-f412-86d43f17d13a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:995dc17c-eedf-a960-f412-86d43f17d13a
msgctxt "h36314283g0412g44f3g9bf2gb2747b156175"
msgid "Care to elaborate on these 'plans'?"
msgstr "'할 일'이 뭔지 설명해주지 않을래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = a2e7a375-253f-4e16-65ab-01a298d61d0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:a2e7a375-253f-4e16-65ab-01a298d61d0f
msgctxt "hc45ae5c1g9b5eg42ccga091ga570c470b4d2"
msgid "That's not a nice way to greet a friend."
msgstr "친구에게 인사하는 꼬라지 하고는."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = a6701c25-cf89-55b0-33cd-518f0c7dba34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Wulbren_PreReunionHasMet(1) = True
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_TalkedToWulbrenInHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:a6701c25-cf89-55b0-33cd-518f0c7dba34
msgctxt "h6890dcd3g1209g4271g8ee5gba33d94fd67a"
msgid "What is it, then?"
msgstr "그럼, 뭔데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = a7b7a8fe-388d-33f3-9b44-f8207ae75564
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:a7b7a8fe-388d-33f3-9b44-f8207ae75564
msgctxt "h5b5ccb15gfb52g4581gbc90g70845afae509"
msgid "...Never mind. Now, is there something you want? I'm a busy man."
msgstr "...관두지. 그래서, 볼 일이 뭐지? 나는 바쁜 몸이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = ada92be1-6074-f2fa-fdb4-3ad355fb5f79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:ada92be1-6074-f2fa-fdb4-3ad355fb5f79
msgctxt "hb8f9e643g3817g4934gbbe7g0ec1d01000b8"
msgid "Do not speak of a story you only know the half of."
msgstr "잘 모르는 이야기는 함부로 하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = b2a6c312-53ea-1747-aa51-15a7b58d4cde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#.      - HAV_Mood_State_NightsongFreed = True
#.      - HAV_HavenOutcasts_State_FlamingFistsInHaven = True
#. SetFlags:
#.   Dialog:
#.     - HAV_Wulbren_NightsongFreed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:b2a6c312-53ea-1747-aa51-15a7b58d4cde
msgctxt "h964a4fcfgf705g4b2eg8fffgb5337f84815d"
msgid ""
"Whatever that light is - the Harpers and Flaming Fist can deal with it. "
"We'll follow once it's safe."
msgstr "저 빛이 무엇이던 간에, 하퍼와 플레이밍 피스트가 대처할 수 있을 거야. 우리는 안전해진 다음에 따라가면 된다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = b3511d1f-5cf7-0922-9798-37b281ad97cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:b3511d1f-5cf7-0922-9798-37b281ad97cf
msgctxt "h400969eag054cg4f64ga70cgc7fae40864e7"
msgid "Was there something else?"
msgstr "다른 할 말이 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = b3e284ce-ffb4-a872-44fb-1ca59a36e23d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:b3e284ce-ffb4-a872-44fb-1ca59a36e23d
msgctxt "he41b9efagfafeg4a5agb5a2g9814f89b3e60"
msgid "Now, is there something you want? I'm a busy man."
msgstr "그래, 뭐 원하는 거라도 있어? 난 바쁜 몸이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = b89eb0c4-935a-bdd7-3fb0-0037183402e1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_WulbrenReward = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:b89eb0c4-935a-bdd7-3fb0-0037183402e1
msgctxt "h05798e46gfb06g41e0gb859g3be61ed9aa48"
msgid "You forget - it was I who planned every step of our escape."
msgstr "잊었나 본데 - 탈출 계획을 하나하나 설계한 건 나야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = bfcbf935-b966-b666-3502-336dc89b9f02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:bfcbf935-b966-b666-3502-336dc89b9f02
msgctxt "hbd85e2ccgda70g4f9agbdebg26603ca0d87c"
msgid "It would seem so."
msgstr "그럴 수도 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = bff1478f-2fb7-0b23-8f9f-734d5e778fd1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_IronhandGnomes = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:bff1478f-2fb7-0b23-8f9f-734d5e778fd1
msgctxt "h50a32e97gefc6g4edbgb1dag63dd6169086b"
msgid "We will. The Ironhand Gnomes have survived worse."
msgstr "도착할 거야. 아이언핸드 노움은 더한 상황에서도 살아남았지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = c6fc6af1-534a-8292-d205-62584be226cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:c6fc6af1-534a-8292-d205-62584be226cb
msgctxt "hd671e99fg4653g4ca4g8379gf267312e70aa"
msgid "Oh - Barcus. Perhaps later."
msgstr "오 - 바커스 말이지. 나중에 하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = c88dccff-2afc-fdb7-512e-71c63a4fffa6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:c88dccff-2afc-fdb7-512e-71c63a4fffa6
msgctxt "hff37859cg5d1ag4b7cg8d52ge302c3e30d48"
msgid "I'm not here to talk about Barcus - I'm here to talk about <i>you.</i>"
msgstr "난 바커스에 대한 이야기를 하려는 게 아냐 - <i>당신</i>에 대한 이야기를 하려는 거지"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = c89f5c22-5752-c0aa-0cae-e573a5169c55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Wulbren_AskedAboutPlan(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Wulbren_AskedAboutPlan(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:c89f5c22-5752-c0aa-0cae-e573a5169c55
msgctxt "hf52d9299g7735g40dfga195g2f9288c86a8f"
msgid "What will you do when you get out of here?"
msgstr "여기서 나가면 뭘 할 생각이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = ce1ee3e9-082c-c02d-42d5-78f7c30affc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:ce1ee3e9-082c-c02d-42d5-78f7c30affc1
msgctxt "h790f6f95gf693g42c8gb96fg4dbfbe644bfe"
msgid ""
"I am more than a 'part'. I am its oil and gears; I am its purpose - its "
"<i>leader.</i>"
msgstr "단순한 '역할' 그 이상이지. 나는 조직의 기름이자 톱니바퀴, 목적 그 자체야. <i>지도자라고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = cf680331-90b2-1d27-5868-8fb3442cf47a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:cf680331-90b2-1d27-5868-8fb3442cf47a
msgctxt "h0f848e62g5a88g49b0gb41dge48e360bffd1"
msgid "Sarevok? The Bhaalspawn?"
msgstr "사레복? 그 바알스폰을 말하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = d01a9e5c-e0af-3022-371a-a473a551e7ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:d01a9e5c-e0af-3022-371a-a473a551e7ce
msgctxt "hd9ee4e94g055dg42c7g90ccg36d9db05339d"
msgid ""
"Our return to Baldur's Gate will usher in a new era for the Ironhand Gnomes. "
"The realm deserves the benefit of our genius."
msgstr ""
"우리는 발더스 게이트에 돌아가서 아이언핸드 노움에 의한 새로운 시대를 열 거야. 우리의 천재성으로 발더스 게이트에 기여하는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = d20cfbd3-0b33-2377-6e9b-31c91472dd19
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#.      - HAV_Mood_State_NightsongFreed = True
#. SetFlags:
#.   Dialog:
#.     - HAV_Wulbren_NightsongFreed_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:d20cfbd3-0b33-2377-6e9b-31c91472dd19
msgctxt "h2b56be8dg91e7g4fc9gb7fcgb81fd3ee4b1b"
msgid ""
"Whatever that light is - the Harpers can deal with it. We'll follow once "
"it's safe."
msgstr "저 빛이 뭐든 간에 - 하퍼들이 대처할 수 있을 거야. 우린 안전해진 다음에 따라가면 된다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = d26feea0-b986-b8da-de13-4f005b667988
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:d26feea0-b986-b8da-de13-4f005b667988
msgctxt "hc4254b05g1781g46d9gbd18g46cce461e893"
msgid ""
"I have plans in Baldur's Gate - the work of many years labour that will "
"finally bear fruit."
msgstr "발더스 게이트에서 할 일이 있어. 수년간의 노력이 마침내 결실이 맺을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = d31bc292-cdbe-9021-bfc0-f26d57cc9a81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_WrootRequest_Reunion_CalledWulbrenPrick = True
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Wulbren_PostReunionHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:d31bc292-cdbe-9021-bfc0-f26d57cc9a81
msgctxt "hbbcf4444g75c7g4ea6gbfdfg2f40eda6ef2c"
msgid ""
"Excuse me. This <i>prick </i>is busy. Why don't you and Barcus go entertain "
"each other elsewhere."
msgstr "미안하군. 이 <i>꼴통 </i>은 바빠서 말이지. 가서 바커스나 데리고 놀지 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = d721951b-c955-422e-94d1-187f3ed0b540
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Wulbren_PreReunionHasMet(1) = True
#.   Global:
#.     - HAV_WrootRequest_Event_TalkedToWulbrenInHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:d721951b-c955-422e-94d1-187f3ed0b540
msgctxt "h736599dcg076dg4633g9be6g2c0d7f4254b7"
msgid "Hm? Oh - I don't need anything else. Thanks."
msgstr "음? 오, 난 더 이상 필요한 게 없어. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = d88f93f5-febd-2fcc-8dec-a8cf9597924b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:d88f93f5-febd-2fcc-8dec-a8cf9597924b
msgctxt "hb569e775gc6a2g4e18ga79agcd7b704757d2"
msgid "Mind if I ask you a question or two?"
msgstr "한두 가지 질문을 해도 될까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = da32523b-6c21-d1e3-6e36-7a46cf1cd514
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:da32523b-6c21-d1e3-6e36-7a46cf1cd514
msgctxt "h95733280g9025g4a20gb0bag99654f251424"
msgid "Appreciate it."
msgstr "고맙군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = daea5eef-f89b-2b70-15dd-31fb5ac9a6ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Wulbren_PostReunionHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:daea5eef-f89b-2b70-15dd-31fb5ac9a6ff
msgctxt "h8ea96f29gdccag4651g879fg0e2a02f786f9"
msgid "Don't let me delay you."
msgstr "나 때문에 지체하진 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = dcdc58e4-6444-3d00-c28b-9024a9676395
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:dcdc58e4-6444-3d00-c28b-9024a9676395
msgctxt "hca6a0f8egf7e9g4973g9f2dg46379071b4ba"
msgid ""
"I've fought tooth and nail to restore our reputation. Particularly against "
"Gondian detractors who live in glass houses."
msgstr "난 우리의 평판을 되찾기 위해 이 악물고 싸웠어. 특히 유리집에 살면서 우릴 깎아내리는 곤드 신자하고는 더욱이나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = dd4b9d6f-53b8-db2e-9139-30d794e98922
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:dd4b9d6f-53b8-db2e-9139-30d794e98922
msgctxt "h31c0e65cg93d9g49cegaf26g1f57533b273a"
msgid "I'll leave you to your own devices."
msgstr "너를 내버려두도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e3501208-3994-2847-b017-df3d727b7e30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:e3501208-3994-2847-b017-df3d727b7e30
msgctxt "h40d2daa5g054cg4031g97f8gb14f507eb1e6"
msgid "But even brawn deserves recompense. Here - this should suffice."
msgstr "하지만 뭐, 힘쓰는 역할도 보상을 받을 자격은 있겠지. 받아, 이 정도면 충분할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e3d4e834-5c54-a460-24d9-fad705c1eb28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:e3d4e834-5c54-a460-24d9-fad705c1eb28
msgctxt "h6505c808g8766g4f51ga9a0ge8ee70296e97"
msgid "Very."
msgstr "무척이나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = e6c5913c-2c4d-9866-f862-c0c4cf2777a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:e6c5913c-2c4d-9866-f862-c0c4cf2777a8
msgctxt "hd4702c52g571eg40edg9f05gc56a543bcd04"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e91e98b0-3afe-6dba-fb82-33cfcb7415d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#.      - HAV_Mood_State_Alert = True
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Wulbren_HasMetAlert(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:e91e98b0-3afe-6dba-fb82-33cfcb7415d3
msgctxt "h42ec69f2g2e8eg468cgabdcgc925e69d4b58"
msgid ""
"Ketheric's lackeys found me already - blast it all. You need to deal with "
"him."
msgstr "케서릭의 하수인들이 나를 찾아냈군, 망할. 네가 놈들을 처리해 줘야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = ef6ee36b-7843-bd88-0fa4-743c108472a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UnfortunateGnome_State_InHaven = True
#. SetFlags:
#.   Global:
#.     - HAV_WrootRequest_Event_GoToBarcus = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:ef6ee36b-7843-bd88-0fa4-743c108472a1
msgctxt "h6bcf50a1gad34g4338gaa97gbe96132fe100"
msgid "Surely Barcus will take care of that."
msgstr "그건 바커스가 처리해 줄 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = f048ae00-f9f7-927a-45fc-d88a6473772e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:f048ae00-f9f7-927a-45fc-d88a6473772e
msgctxt "hfdd46589gaeb2g46c6g9715gf521e877f34a"
msgid "Any problems sailing here?"
msgstr "여기까지 항해하는 데 문제는 없었나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = f1b75daf-f7dd-6099-44a8-f3f161b7179b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:f1b75daf-f7dd-6099-44a8-f3f161b7179b
msgctxt "hef375f7ag422eg4ce8g90aag9fee7843ac40"
msgid "Siding with a murderous lunatic is more than 'foolish'."
msgstr "미치광이 살인마 옆에서 거드는 건 멍청한 수준이 아닌데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = f21519de-9269-0b77-4600-e2017634517c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:f21519de-9269-0b77-4600-e2017634517c
msgctxt "hf44dfa42g1898g4f63gbdd4g382403389464"
msgid "I'm a busy man - state your business."
msgstr "난 바쁜 몸이야. 용건을 말해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = f3160c8a-5b41-2550-88e8-dc0c78ba6f7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:f3160c8a-5b41-2550-88e8-dc0c78ba6f7b
msgctxt "h3b3776c0g917dg46f8gbc6dgc28d7ddaf2d2"
msgid ""
"You should look for me once we're in city. The name 'Wulbren Bongle' will be "
"mentioned among many, I've little doubt."
msgstr "도시에 가면 날 찾아와. 의심의 여지 없이 '울브렌 봉글'이란 이름은 많은 사람들 사이에서 오르내릴 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
#. Speaker = Player
#. NodeID = f389b018-2ed5-4f63-17db-03de06352054
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAV_WrootRequest_Wulbren_AskedAboutIronhandGnomes(1) = False
#.   Local:
#.      - 069abb40-ff7f-3eee-ece9-6480a8af79ec_historysuccess = True
#. SetFlags:
#.   Dialog:
#.     - HAV_WrootRequest_Wulbren_AskedAboutIronhandGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren:f389b018-2ed5-4f63-17db-03de06352054
msgctxt "h7126edb1g7b86g4311g9f9bg8319f3a42975"
msgid "Weren't the Ironhand Gnomes exiled from Baldur's Gate?"
msgstr "아이언핸드 노움들은 발더스 게이트에서 추방당하지 않았던가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_WrootRequest_Wulbren
