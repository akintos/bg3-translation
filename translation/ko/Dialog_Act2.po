msgid ""
"A D Y - O \n"
"E S S - O F \n"
"G H T - F \n"
"S H A L"
msgstr ""
"- 상 실 \n"
"- 여 왕\n"
"- 내 려\n"
"다 시 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_CentralSquare_SharAltar
#. Speaker = Player
#. NodeID = 06f8f1e6-cb93-8198-4a88-9bea748cdf53
#. HandlePath = TaggedText[0].TagText[0]
