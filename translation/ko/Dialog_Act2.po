msgctxt "ha1adf133g4226g4a31g91b3g3c0361d90021"
msgid "<i>Study the rat's ki to see the source of its aggression. </i>"
msgstr "<i>쥐의 기에서 공격성의 원인을 찾아본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Player
#. NodeID = b0a16ad6-2b7f-0ac2-f17e-6c264f1de542
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:b0a16ad6-2b7f-0ac2-f17e-6c264f1de542
msgctxt "h519bc7c4g0574g4d5fg96b1g0d1167ced085"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Rat
#. NodeID = bb3ae416-2474-7468-da58-a4c9c1848284
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:bb3ae416-2474-7468-da58-a4c9c1848284
msgctxt "h21434650gbf50g4f78g9eacgb127d63f248b"
msgid "Leave! Away! My nest - my dark!"
msgstr "나가! 꺼져! 내 보금자리야. 내 어둠이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Narrator
#. NodeID = be5b953b-94a6-bb17-becd-0d51a9d1e189
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:be5b953b-94a6-bb17-becd-0d51a9d1e189
msgctxt "hfa9830b2g4794g4fb3g9694gd068195555a8"
msgid "*There's something strange about the rat. But what?*"
msgstr "*이 쥐는 뭔가 이상합니다. 하지만 그게 뭘까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Narrator
#. NodeID = c60c4c80-cdfa-680c-9857-b496008f6919
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:c60c4c80-cdfa-680c-9857-b496008f6919
msgctxt "ha5c37209g3d3ag4a18g9a08g2dd398261f9d"
msgid "*There's something amiss, but exactly what eludes you.*"
msgstr "*뭔가 잘못되어 있지만, 정확히 어떤 점이 그러한지는 알 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Shadowheart
#. NodeID = c7724d0b-dd18-48e6-ae79-0bfd496454c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm:c7724d0b-dd18-48e6-ae79-0bfd496454c0
msgctxt "hce966d6fgac61g423egabb9g039248855619"
msgid "Oddly brazen, for a rat. We should just move along."
msgstr "쥐치고는 굉장히 뻗대는군. 어서 움직이는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Player
#. NodeID = c83a3a4e-9c74-f765-7b2e-77cf1567910f
