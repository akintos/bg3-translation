#.      - MOO_Jailbreak_Event_ADPrepareBoat(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#.   Local:
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_C = False
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_D = False
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:c3ec3209-fbc7-c3d3-b958-0135a96b853c
msgctxt "h44a0b119g07d8g48e0gbb35g62d7baf055f9"
msgid "Finally!"
msgstr "됐어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = cb1cead6-923f-4961-a2d4-502598a25037
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADEscaping(0) = True
#. SetFlags:
#.   Local:
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_G = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADEscaping(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:cb1cead6-923f-4961-a2d4-502598a25037
msgctxt "h0cc8b2a3g0f0eg4950gab2dgd287b1629ebf"
msgid "Don't think - just run."
msgstr "생각하지 마, 그냥 달려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover
#. Speaker = Danis
#. NodeID = f5469bb7-2af0-4e0a-b7ab-33df0a4f3940
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADWaitingForBoat(0) = True
#. SetFlags:
#.   Local:
#.     - 4951b7ce-8495-b2c8-badc-beaff0e3d807_E = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADWaitingForBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingLover:f5469bb7-2af0-4e0a-b7ab-33df0a4f3940
msgctxt "h60aea1d8g1cfag4d76g8758g067a0571fd10"
msgid "I can't believe we made it."
msgstr "우리가 해냈다니 믿을 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingsFreed
#. Speaker = Wulbren Bongle
#. NodeID = 71eb86aa-5dd2-4495-b29e-2e886e8f599c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_TieflingsFreed:71eb86aa-5dd2-4495-b29e-2e886e8f599c
msgctxt "hee2fe1d5gfbbbg4808g9fdfg792e7437c680"
msgid "Follow or die, tieflings!"
msgstr "따라오든지 죽든지, 티플링!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ToolAccepted
#. Speaker = Wulbren Bongle
#. NodeID = 95445aed-6e06-4157-bad3-37acac6e1d50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ToolAccepted:95445aed-6e06-4157-bad3-37acac6e1d50
msgctxt "h0bfef747g2e0cg4ab0gabc8g6521d908ab2c"
msgid "This is it."
msgstr "이거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ToolRefused
#. Speaker = Wulbren Bongle
#. NodeID = 508d226e-321d-31b2-8ff7-e7bf36c234b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 100f38ef-e9bb-ae9b-0804-f82a335fb3c9_B = True
#. SetFlags:
#.   Local:
#.     - 100f38ef-e9bb-ae9b-0804-f82a335fb3c9_A = False
#.     - 100f38ef-e9bb-ae9b-0804-f82a335fb3c9_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ToolRefused:508d226e-321d-31b2-8ff7-e7bf36c234b0
msgctxt "h4a105931g2a49g4a3eg93bfg8a2f8c5d27b0"
msgid "Gaerdal help me - how about a club? A <i>hammer</i>? Hurry!"
msgstr "게어달이시여 세상에, 몽둥이 몰라? <i>망치 같은거</i>? 뭐든 서둘러!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ToolRefused
#. Speaker = Wulbren Bongle
#. NodeID = 5db9e79c-80d5-29d6-357a-fff786233cab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 100f38ef-e9bb-ae9b-0804-f82a335fb3c9_A = True
#. SetFlags:
#.   Local:
#.     - 100f38ef-e9bb-ae9b-0804-f82a335fb3c9_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ToolRefused:5db9e79c-80d5-29d6-357a-fff786233cab
msgctxt "hc19e09f7gaa01g474dga9f0gd50fac390f7f"
msgid "In what realm could <i>this</i> break rock? Stop messing about."
msgstr "꿈나라도 아니고 <i>이걸로</i> 어떻게 바위를 부수겠냐? 미적거리지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ToolRefused
#. Speaker = Wulbren Bongle
#. NodeID = 8f012526-f85a-4db3-836c-0998ad634f18
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 100f38ef-e9bb-ae9b-0804-f82a335fb3c9_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_ToolRefused:8f012526-f85a-4db3-836c-0998ad634f18
msgctxt "h77668adcg7681g4d31ga6e8gd281bba4f742"
msgid "This is no good - I need something that can crack stone."
msgstr "이건 좋지 않은데, 돌을 깰만한 무언가가 필요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WaitingForGnomes
#. Speaker = Lakrissa
#. NodeID = 51bdb9b0-f2d7-4b82-a213-cb678aacdcd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WaitingForGnomes:51bdb9b0-f2d7-4b82-a213-cb678aacdcd5
msgctxt "h925d110cg19d5g470fg9431g365b89160bfb"
msgid "Shh. Not a word - the gnomes are on their way."
msgstr "쉿. 말하지 마, 노움들이 오고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WaitingForGnomes
#. Speaker = Lia
#. NodeID = 9fd9c104-124c-4898-a82f-272d0657d4c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_1 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WaitingForGnomes:9fd9c104-124c-4898-a82f-272d0657d4c6
msgctxt "h79d67ea7g80f3g4d1ag9605g9e1790dfc3e4"
msgid "Here! WE'RE OVER HERE!"
msgstr "여기야! <b>우리 여기 있다고</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WaitingForGnomes
#. Speaker = Lia
#. NodeID = aa9379bf-3ec2-41cd-a318-e1d17d80fda2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_1 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WaitingForGnomes:aa9379bf-3ec2-41cd-a318-e1d17d80fda2
msgctxt "h20d341cag52cag4c22g9fd1g840d29a4398a"
msgid "The gnomes have scarpered - get ready to move."
msgstr "노움들은 도망갔어, 갈 준비하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WaitingForGnomes
#. Speaker = Lakrissa
#. NodeID = e89540b5-c9f0-4f09-a956-f5ce5a671bac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WaitingForGnomes:e89540b5-c9f0-4f09-a956-f5ce5a671bac
msgctxt "h5a3c5533gacadg4d0cg9154g114d798d00f4"
msgid "Help! PLEASE!"
msgstr "도와줘! <b>제발</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenChase
#. Speaker = The Warden
#. NodeID = 7371cd1e-8282-4d47-9639-8c6a7d467b7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenChase:7371cd1e-8282-4d47-9639-8c6a7d467b7b
msgctxt "h95eba53bgbcbag46dbgb3deg4edb8bf3ff0d"
msgid "The prisoners are escaping! All arms to me - NOW."
msgstr "죄수들이 도망쳤다! 모두 내게 집결, <b>당장</b>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInCombat
#. Speaker = The Warden
#. NodeID = af9beac0-d690-68e9-3570-4c59b33d7a95
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 99ca9649-cc14-e5c9-b0e5-f7e677bc5ca9_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInCombat:af9beac0-d690-68e9-3570-4c59b33d7a95
msgctxt "h6feba265g6932g4720g97b5g6639f22cca52"
msgid "Run. Beg. It matters not - this ends now."
msgstr "도망치든. 빌든. 이제 상관없다, 여기서 끝이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInCombat
#. Speaker = The Warden
#. NodeID = c6c40b7d-3450-b806-5849-556caa3cad5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 99ca9649-cc14-e5c9-b0e5-f7e677bc5ca9_A = True
#. SetFlags:
#.   Local:
#.     - 99ca9649-cc14-e5c9-b0e5-f7e677bc5ca9_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInCombat:c6c40b7d-3450-b806-5849-556caa3cad5c
msgctxt "hd938a412g4bb0g4e25gbcb1g4bf22ddf31b2"
msgid "Ungrateful parasites - I should have killed you long ago."
msgstr "배은망덕한 기생충같으니, 널 진작 죽였어야 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInCombat
#. Speaker = The Warden
#. NodeID = ef4013b7-ff37-4556-a4c8-655ee292f65e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 99ca9649-cc14-e5c9-b0e5-f7e677bc5ca9_B = True
#. SetFlags:
#.   Local:
#.     - 99ca9649-cc14-e5c9-b0e5-f7e677bc5ca9_B = False
#.     - 99ca9649-cc14-e5c9-b0e5-f7e677bc5ca9_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInCombat:ef4013b7-ff37-4556-a4c8-655ee292f65e
msgctxt "h81c3312egb8b2g4d41g8852g907b96777d6b"
msgid "The Absolute is on my side - you won't leave here alive."
msgstr "절대자께서 나와 함께 하신다, 넌 여기서 살아나가지 못할 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = 0e7338c2-98dc-0b73-de74-6708bb71afac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:0e7338c2-98dc-0b73-de74-6708bb71afac
msgctxt "hd15e23cagceb0g4c78g864bge9250a691818"
msgid ""
"Extremeties, even organs, can all be removed - piece by piece, yet still "
"you'll breathe."
msgstr "사지는 물론, 장기도 전부 들어낼 수 있다. 하나하나 들어내는 와중에도 숨은 붙어있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = 10aa35aa-a186-776b-17c9-0310ec3f857d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:10aa35aa-a186-776b-17c9-0310ec3f857d
msgctxt "h2adc7bddg6bacg4e6fgb3e8gdf0b71a65ff5"
msgid ""
"There it is. You act bold, but there is a weak, temperamental child beneath "
"the mask. I see it. I see <i>you</i>."
msgstr ""
"그거야. 대담하게 행동하지, 하지만 그 가면 아래엔 연약하고 신경질쟁이 꼬마가 있어. 나한테는 보여. <i>네</i>가 보인다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = 1534f62d-a4e2-5a22-35d4-b982b6082e28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_A = True
#. SetFlags:
#.   Local:
#.     - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:1534f62d-a4e2-5a22-35d4-b982b6082e28
msgctxt "hc5b80358g9d82g4c0agabbbg3364a51a368c"
msgid ""
"Look at you - filthy, stupid, <i>ignorant.</i> You are lucky we found you."
msgstr "널 봐, 더럽고, 멍청하며, <i>무지하기까지 해.</i> 우리가 널 찾아서 다행인 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = Wulbren Bongle
#. NodeID = 16b789f0-d854-4382-0993-86b6c68d8c2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:16b789f0-d854-4382-0993-86b6c68d8c2b
msgctxt "h1dd94250g2b9ag4dcfga3b8gd31db9f69136"
msgid "The <i>hells </i>you call me?"
msgstr "날 <i>그딴식으로</i> 불렀겠다?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = 35e78540-7b43-25ab-2c90-bcc990a64272
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_SpecialInspection(1) = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_State_SpecialInspection(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:35e78540-7b43-25ab-2c90-bcc990a64272
msgctxt "h4062ff03g8960g4d7agbc7bg6f089c7abc4e"
msgid "I know what you're doing, and there's little point."
msgstr "네가 뭘하고 있는지 알아, 별 의미도 없는 짓이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = Wulbren Bongle
#. NodeID = 41019568-e9d3-dc8f-16b2-c39b1b95fa97
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_B = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. SetFlags:
#.   Local:
#.     - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_B = False
#.     - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:41019568-e9d3-dc8f-16b2-c39b1b95fa97
msgctxt "haac8ff98g483cg4e10gaffcgdb86fba6ff33"
msgid "Anything I can do for you, Warden?"
msgstr "내가 도와줄 일이라도 있나, 간수장?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = 4b0fa1ec-2cdb-f9dd-3bb4-3c595b2658a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:4b0fa1ec-2cdb-f9dd-3bb4-3c595b2658a7
msgctxt "hd9cb1d6fgf529g43ccga8fdg1ae652f0c320"
msgid "So servile, Wulbren - I approve. I'm simply enjoying the view."
msgstr "굽실대는 모습이 보기 좋군, 울브렌. 난 그저 이 광경을 즐길 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = 4eec0b12-9530-1fb5-1b3b-2a1e4aa1506c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:4eec0b12-9530-1fb5-1b3b-2a1e4aa1506c
msgctxt "hd645c5aeg6628g43c3g9e6bg6afd65a987a0"
msgid "You're not dying, Wulbren - not for a <i>long</i>, long time."
msgstr "넌 죽지 않아 울브렌. 아주 <i>오래</i>, 오랜 시간 동안."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = Wulbren Bongle
#. NodeID = 4f803020-ab4d-d4a9-046b-0b6f0c934239
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:4f803020-ab4d-d4a9-046b-0b6f0c934239
msgctxt "h44eee6bcgaff5g413egb3c6g32471a6cae45"
msgid "Delightful accommodation. You spoil us, Warden."
msgstr "정말 마음에 드는 숙소야. 버릇나빠지겠어, 간수장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = 54ec09b1-430b-0a2e-7441-3f826078fcb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:54ec09b1-430b-0a2e-7441-3f826078fcb0
msgctxt "h691fab1cg809dg4b18g8e62g57b1cc823beb"
msgid "Playing coy? Very well. I'll enjoy breaking you when the time comes."
msgstr "순진한 척이라? 좋아. 널 망가뜨릴 때가 오면 기꺼이 즐겨주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = 725a06e4-9e54-4ac9-8942-def88a3720ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. SetFlags:
#.   Local:
#.     - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:725a06e4-9e54-4ac9-8942-def88a3720ca
msgctxt "hd69e9b5bg7c0bg401dg9177g5925ab71e1bd"
msgid "All comfortable, I hope?"
msgstr "편안하신가들?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = Wulbren Bongle
#. NodeID = 7520ebcc-5789-4288-89ff-5b048c2672b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:7520ebcc-5789-4288-89ff-5b048c2672b7
msgctxt "h1c179946g8165g4f67g8a06gbd9b9d066d87"
msgid "I'm afraid I don't know what you mean."
msgstr "무슨 소리인지 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = 844a5892-3eb1-6e42-554f-2d3fa5b6ddf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:844a5892-3eb1-6e42-554f-2d3fa5b6ddf6
msgctxt "hf01ddefbg8f21g46d5g8c46ge50cedad36a0"
msgid "Keep that wit - you'll need it, little Wulbren."
msgstr "재치있는 태도, 앞으로도 필요할 거야, 꼬마 울브렌."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = 973c785e-0c10-fdff-e9ca-c68b7380d51d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_B = True
#. SetFlags:
#.   Local:
#.     - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_B = False
#.     - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_A = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:973c785e-0c10-fdff-e9ca-c68b7380d51d
msgctxt "hff0f962ag1c7cg4412ga576g59b34dc59b7f"
msgid "You will submit to the Absolute or perish - it is that simple."
msgstr "절대자님을 받아들이지 않으면 죽을 것이다, 간단한 일이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = Wulbren Bongle
#. NodeID = c2eacf15-db10-501a-8070-2cbb9d1b23ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:c2eacf15-db10-501a-8070-2cbb9d1b23ce
msgctxt "h32a411a2gce55g4dfdg8965ga6c7294f69b2"
msgid "I... bet you use that line a lot."
msgstr "네..네가 그 말을 많이 하는 거 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = dec7dcc0-1d86-bda1-ebea-b85a56d508c7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:dec7dcc0-1d86-bda1-ebea-b85a56d508c7
msgctxt "h62a9ad95g8ccdg4729g81ddgfac9c619598c"
msgid "Eyes to the floor, or I'll remove them."
msgstr "눈 깔아라, 아님 뽑아버릴테다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = f03d4fa3-9d3e-9e10-e31b-5d57018c4442
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:f03d4fa3-9d3e-9e10-e31b-5d57018c4442
msgctxt "hb5c7b008g6affg40adg8996g5452e412f7b4"
msgid "Submit to the Absolute or perish - it's that simple."
msgstr "절대자님을 받아들이지 않으면 죽는 거다, 간단하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = The Warden
#. NodeID = f91e80c2-8952-85bb-ad39-8bd80deaa724
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:f91e80c2-8952-85bb-ad39-8bd80deaa724
msgctxt "hae3df9cdge412g4d1bga0ddg35949bdc506b"
msgid ""
"I do. And every, single time, the prisoner cries out for the Absolute - "
"right before they die. You will be no different, little Wulbren."
msgstr "맞아. 항상 죄수들이 바로 죽기 직전에 절대자님을 향해 울부짖을 때 이 말을 하지. 너도 다를 바 없다, 꼬마 울브렌."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection
#. Speaker = Wulbren Bongle
#. NodeID = fc26107d-869a-44fb-05d7-19ca8c4bd986
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_A = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. SetFlags:
#.   Local:
#.     - c9e1ff2a-01e2-abdb-b98e-2d4a35b3c7dc_B = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenInspection:fc26107d-869a-44fb-05d7-19ca8c4bd986
msgctxt "h8a13f229g9597g485bga5cbgdf11a736af92"
msgid "I'll die before I submit to you, or your pitiful god."
msgstr "네게 복종하느니 죽겠다, 네 불쌍한 신도 마찬가지야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenSpottedMissingPrisoners
#. Speaker = The Warden
#. NodeID = 6f76214e-bdcb-4dff-97e8-8b424ed11dde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenSpottedMissingPrisoners:6f76214e-bdcb-4dff-97e8-8b424ed11dde
msgctxt "h8de7adf5g4300g44bagbdccgc721e00250e8"
msgid "What? Where are the prisoners?"
msgstr "뭐? 죄수들은 어디갔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenSpottedMissingPrisoners
#. Speaker = The Warden
#. NodeID = 8030801c-a76c-414d-855b-0c7112341b9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_WardenSpottedMissingPrisoners:8030801c-a76c-414d-855b-0c7112341b9c
msgctxt "h64055decg0045g49f7ga40cg825c63d53cf7"
msgid "I'll be flayed alive for this."
msgstr "이번 일때문에 산 채로 가죽이 벗겨지겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 04733fb8-4d39-32b8-13cf-0a60cd5701f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:04733fb8-4d39-32b8-13cf-0a60cd5701f1
msgctxt "h72cfc5dfg808eg4870g8a48ge8a727efabdf"
msgid "Blasted <i>chains - </i>keep the bastards off me!"
msgstr "빌어먹을 <i>사슬</i>, 저 개자식들 좀 막아줘!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 0ac94a0e-915d-3d14-5c6e-72c578de1868
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_OneChainLeft = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:0ac94a0e-915d-3d14-5c6e-72c578de1868
msgctxt "h3bf2a525ga972g4d70gb952gfc20bf2fa5eb"
msgid "Damned chains! I've almost got it."
msgstr "망할 사슬! 거의 다 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 13484f58-41ce-d83b-0e06-d2b08de262b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_BoatReady = True
#.   Local:
#.      - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_A = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Local:
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_H = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:13484f58-41ce-d83b-0e06-d2b08de262b0
msgctxt "h79612029g7592g4cc7g8b34ge3ca938f9f1e"
msgid "Stop dawdling - get to the boat, or I'll leave you behind!"
msgstr "게으름은 그만 피우고 배로 가, 아니면 그냥 두고간다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 5560d08f-5701-46f5-1cb7-2bf02c711c0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_BoatReady = True
#.   Local:
#.      - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_H = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_ForceBoatLeave = True
#.   Local:
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_A = False
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_H = False
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:5560d08f-5701-46f5-1cb7-2bf02c711c0f
msgctxt "hd633b36ag7b16g482eg88eag349ec5ebda57"
msgid "It's too late - we have to leave."
msgstr "너무 늦어, 이제 가야한다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 5d9c09d9-deda-4c88-a91c-07490ba8d535
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_E = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADWaitingForBoat(0) = True
#. SetFlags:
#.   Local:
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_F = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADWaitingForBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:5d9c09d9-deda-4c88-a91c-07490ba8d535
msgctxt "h01c2c38egdeceg4396gb66fgf4922e2a703e"
msgid "I need to be in the city - not twiddling my thumbs here."
msgstr "도시로 가야만 해. 여기서 손가락이나 빨고 있을 순 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 682e60eb-d7c4-4406-afa6-9e5e1e328ddf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADLeaving(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADLeaving(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:682e60eb-d7c4-4406-afa6-9e5e1e328ddf
msgctxt "hd87bd1eag9258g4f5cgabc1geae2ed448d07"
msgid "Blessed Gaerdal, thank you."
msgstr "게어달이시여, 감사합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 6f6967d0-602a-42a8-ac2a-a9da3fbab164
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADAlarmReaction(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADAlarmReaction(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:6f6967d0-602a-42a8-ac2a-a9da3fbab164
msgctxt "h2ae84727g19ddg4553g8165g4208ebce205f"
msgid ""
"Argh, what god did I shit on to deserve this? Move it - they'll be on us "
"soon."
msgstr "으악, 대체 내가 어떤 신에게 잘못을 했길래 나한테 이러는 건데? 서둘러, 놈들이 곧 쫓아와."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 710fb48e-7528-4883-acdd-bd10985109e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADBoatMissed(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADBoatMissed(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:710fb48e-7528-4883-acdd-bd10985109e9
msgctxt "hb81225e4gc965g4729ga7cag938a13f2f53d"
msgid "Blast it all - a dead end. There must be another way out."
msgstr "막다른 골목이군, 날려버려. 다른 출구가 있어야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 725b6f54-32d7-4f22-9a9e-86debe6bb38c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_F = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADWaitingForBoat(0) = True
#. SetFlags:
#.   Local:
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_F = False
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_E = False
#.   Object:
#.     - MOO_Jailbreak_Event_ADWaitingForBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:725b6f54-32d7-4f22-9a9e-86debe6bb38c
msgctxt "h1f545d19g9e89g4c02g833ag062003650731"
msgid "Gaerdal help me, let's <i>go.</i>"
msgstr "게어달이시여 제발, 얼른 <i>가자고.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 73d51186-1bda-4256-a401-65faffcc41e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_G = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADEscaping(0) = True
#. SetFlags:
#.   Local:
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_G = False
#.   Object:
#.     - MOO_Jailbreak_Event_ADEscaping(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:73d51186-1bda-4256-a401-65faffcc41e3
msgctxt "h4e36a2b2gd780g40a1g89a5ge0eff8627095"
msgid "I won't die here, damn it. I refuse!"
msgstr "여기서 죽을 생각 없어, 젠장. 안죽어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 89c68ea9-eb26-7dcc-a06b-5e91c5546d78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_BoatReady = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_ForceBoatLeave = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:89c68ea9-eb26-7dcc-a06b-5e91c5546d78
msgctxt "h20980fb1g6191g46a2g9b42g534e3e1c4c05"
msgid "It's free. Go, go, go!"
msgstr "풀렸어. 가자, 얼른, 가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 98fe0b3e-4d74-4176-acae-1176170dbf6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADGoingToBoat(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADGoingToBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:98fe0b3e-4d74-4176-acae-1176170dbf6e
msgctxt "hbcd79df6g0942g4785g8137g969da05ed861"
msgid ""
"The pier over there is our way out. We'll escape right under the bastards' "
"noses."
msgstr "저기 보이는 부두로 나가면 돼. 그 개자식들 눈앞에서 도망쳐 주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = aa0e4ea3-ac0e-40bf-8875-67a1bb111925
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_D = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoat(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_State_BoatReady = True
#.   Local:
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_C = False
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_D = False
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:aa0e4ea3-ac0e-40bf-8875-67a1bb111925
msgctxt "heef92e0fg3ee7g4c1ega961gc4170114d2ee"
msgid "Hah! Got it!"
msgstr "하! 됐다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = ae9144c7-d8c6-42ef-a84a-e11511cd7d20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADGuardsReaction(0) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_ADGuardsReaction(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:ae9144c7-d8c6-42ef-a84a-e11511cd7d20
msgctxt "hf8148897g3950g4260gaebfg9cc5bb370de9"
msgid ""
"You think you can take on the Ironhand Gnomes?! Just try reach the boat!"
msgstr "아이언핸드 노움들을 데려갈 수 있을 거라 생각해?! 그냥 배로 가는 것만 생각해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = cb73c477-6440-4178-8c80-2af64156f236
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADEscaping(0) = True
#. SetFlags:
#.   Local:
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_G = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADEscaping(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:cb73c477-6440-4178-8c80-2af64156f236
msgctxt "hc954f31agc891g4adfg8a91g8684cd3e9de5"
msgid "I must make it to Baldur's Gate - I <i>must.</i>"
msgstr "반드시 발더스 게이트로 갈거야, <i>반드시.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e21ad517-32a7-adcb-0da7-b85c6fe9c6f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_BoatReady = True
#.      - MOO_Jailbreak_State_PlayersCanUseBoat = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = True
#. SetFlags:
#.   Local:
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_A = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoatCombat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:e21ad517-32a7-adcb-0da7-b85c6fe9c6f8
msgctxt "h4b6d8bd1gfc44g4f0fga951g6738ae4dd08a"
msgid "Boat's free - get over here!"
msgstr "배 풀었어, 얼른 타!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e3bc7555-7400-46be-82b0-9a52fb49bd19
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_C = True
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoat(0) = True
#. SetFlags:
#.   Local:
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_D = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:e3bc7555-7400-46be-82b0-9a52fb49bd19
msgctxt "hbea09e84g1745g406ag865fgabe96eed7b24"
msgid "Come on... come on..."
msgstr "제발... 제발..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = f3990b18-2654-4f4e-8eab-0721ee232525
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADPrepareBoat(0) = True
#. SetFlags:
#.   Local:
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_C = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADPrepareBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:f3990b18-2654-4f4e-8eab-0721ee232525
msgctxt "hd5158fceg451bg4372ga39fge61b9560eea2"
msgid "This thing is chained up tight - hold on."
msgstr "꽉 묶여 있어, 잠깐만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = fbab2cc2-d3d2-46b0-a8e5-5e35a7f1f5af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_Event_ADWaitingForBoat(0) = True
#. SetFlags:
#.   Local:
#.     - d19e8b02-0897-8b61-fbd3-92e5c7950eb2_E = True
#.   Object:
#.     - MOO_Jailbreak_Event_ADWaitingForBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_AD_Wulbren:fbab2cc2-d3d2-46b0-a8e5-5e35a7f1f5af
msgctxt "hc533ac72g0d33g4334gb8acgf02633a7362a"
msgid "Is the boat going or not?"
msgstr "이 배 가는 거야, 아니야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = 006c981e-1b10-ba9b-c692-5efbb632b6e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 30d43adb-dcaf-c0f3-d432-af96a1c2e1ea_spoketowulbren = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:006c981e-1b10-ba9b-c692-5efbb632b6e2
msgctxt "h79993bd0g22a5g49ccg9229g6f82c535197a"
msgid ""
"My plan, for now, is to hide out on the water. Unless you have a better idea?"
msgstr "내 계획은 일단 물 위에 숨어있을 생각이야. 더 좋은 생각 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 0c5dddc9-192d-62dd-1914-1920f4580790
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_State_BoatPlayer(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:0c5dddc9-192d-62dd-1914-1920f4580790
msgctxt "hb1825b15gcc84g46c1ga239g88350a0d73ad"
msgid "<i>Go to Last Light Inn.</i>"
msgstr "<i>최후의 빛 여관으로 출발한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lia
#. NodeID = 0e9df8b1-1cb0-9741-aa56-2abe63fcc0a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:0e9df8b1-1cb0-9741-aa56-2abe63fcc0a4
msgctxt "h9c5afd85ge976g4683g9812gf48849ab940b"
msgid ""
"This curse doesn't stretch much further than the shore. We'll hide out on "
"the water, plan our next move from there."
msgstr "저주가 해안선을 넘어서 더 뻗어있지는 않아. 물 위에서 숨어있다가, 도착해서 다음 계획을 세우자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = 0ed371ec-18b6-ade4-69b8-6e675c6d2693
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:0ed371ec-18b6-ade4-69b8-6e675c6d2693
msgctxt "h60dea9b4g39b0g4ce8g9e67g7557794130e9"
msgid ""
"You will kill many, I have no doubt. But should you fall... I hope it's "
"quick. Thank you."
msgstr "많은 적들을 죽여야 할 거야. 하지만 너가 쓰러진다면...빨리 끝나기를 바랄께. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Danis
#. NodeID = 0f3053ac-2d03-8527-82bb-a8a63240f473
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:0f3053ac-2d03-8527-82bb-a8a63240f473
msgctxt "h9822d075g4062g4eb1g830cgb21036c72824"
msgid ""
"But I can't leave without saying this - something big is going on in "
"Moonrise. I heard whispers of something - an army. Do what you have to here, "
"and then leave. Soon."
msgstr ""
"하지만 이 말은 꼭 하고 가야겠어. 뭔가 큰일이 문라이즈에서 일어나고 있어. 군대에 관해서 속닥이는 걸 들었어. 가능한 한 빨리, 여기서 "
"할 일을 하고 떠나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = 15198e16-6da6-bb9c-ef47-42ebc046a083
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:15198e16-6da6-bb9c-ef47-42ebc046a083
msgctxt "h55d71077g1c41g4b1cga9d5g7b8747038ac1"
msgid ""
"I must - the Ironhand Gnomes need me. I will tell them of your heroic "
"sacrifice."
msgstr "떠나야만 해. 아이언핸드 노움들이 나를 필요로 하니까. 너의 영웅적인 희생을 그들에게 전해주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Danis
#. NodeID = 1659684c-bfbc-96bc-d8a9-3cee97c64933
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:1659684c-bfbc-96bc-d8a9-3cee97c64933
msgctxt "h480ed6cag4a8ag444bga884ge808360d1e12"
msgid "Somewhere in this cursed land is safe? Lead the way - please!"
msgstr "이 저주받은 땅 어딘가에 안전한 장소가 있다고? 앞장 서 줘. 제발!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lia
#. NodeID = 18c4b310-1ad4-297a-eaa4-80a594db3e06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:18c4b310-1ad4-297a-eaa4-80a594db3e06
msgctxt "h1861e12agebbeg42e3g9757g5c449f5015cb"
msgid "Music to my ears, let's get out of this shit-heap."
msgstr "아주 좋은 소리야. 이 똥 더미에서 벗어나자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 19846e9e-ae94-3985-c4ad-45c5408b95ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:19846e9e-ae94-3985-c4ad-45c5408b95ac
msgctxt "h1453823bgb7bfg4550gb5c9gc513c3e61c25"
msgid "You ungrateful bastard, don't you <i>dare </i>leave."
msgstr "이 배은망덕한 자식, <i>감히</i> 어딜 떠나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = 1b08ac8c-d6e3-5683-d056-351a808e958b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:1b08ac8c-d6e3-5683-d056-351a808e958b
msgctxt "hd85aac79gc233g44c2g83f0g3930c563057b"
msgid ""
"One of my own to save the rest? Aye - if that's what it takes. Farewell."
msgstr "나머지 동족을 구하기 위해 그들 중 하나를 희생할 수 있냐고? 당연하지. 그렇게 해야만 한다면. 잘 있어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lia
#. NodeID = 219ebb5e-056a-7dc7-e9c6-6c3603103a14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(4) = True
#. SetFlags:
#.   Local:
#.     - 30d43adb-dcaf-c0f3-d432-af96a1c2e1ea_speakingtoatiefling = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:219ebb5e-056a-7dc7-e9c6-6c3603103a14
msgctxt "h6a5e0f1ag2f16g491agb8c3ga048cecda32b"
msgid "Right, boat's good to go - or as good as it can get, at least."
msgstr "다 됐어. 배 상태가 괜찮아. 아니면 최소한 어느정도는 버텨주겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lakrissa
#. NodeID = 22bbd214-b886-4a8c-b6c1-6697cd27e3ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:22bbd214-b886-4a8c-b6c1-6697cd27e3ee
msgctxt "h710982b2g3107g4b3bga7e2g5d9a4c294ae7"
msgid "The boat's good to go - at least, I think it is. I'm no sailor."
msgstr "적어도 내 생각에는 배는 출발해도 돼. 내가 항해사는 아니지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Danis
#. NodeID = 255d93d7-5012-11cc-dd0c-cfe9fa3bdbe7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:255d93d7-5012-11cc-dd0c-cfe9fa3bdbe7
msgctxt "h1f5509e4g9b82g4c5fgbedcg0037d2611027"
msgid "True - anywhere is better than here."
msgstr "그렇지. 어디든 간에 여기보단 나을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lia
#. NodeID = 28d00185-b3d9-402a-8c4c-ffda01439f55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:28d00185-b3d9-402a-8c4c-ffda01439f55
msgctxt "h283dd9adg442ag4ebfg9ba3g3e14befd8ad1"
msgid "Fair, you've done more than your share - I can take it from here."
msgstr "너는 네 몫 이상을 했으니까, 여기서부터는 내가 알아서 할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Danis
#. NodeID = 2f13ecb4-fc30-299d-972d-8f9aa4e070af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:2f13ecb4-fc30-299d-972d-8f9aa4e070af
msgctxt "h03e79001g3669g4496ga2f6gb2f992aedc3d"
msgid ""
"Not like we have somewhere to go, but the water seems safe from the curse - "
"for now, anyway."
msgstr "갈 곳은 없지만, 어쨌든 지금까지는 어쨌든 물에서는 저주로부터 안전한 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Danis
#. NodeID = 308fe5fc-9b6f-10a6-a3f4-6e70703626b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_EscapingInCombat(7) = True
#.      - MOO_Jailbreak_State_BoatLeader(7) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:308fe5fc-9b6f-10a6-a3f4-6e70703626b6
msgctxt "hc93451f8ge9d1g4cc5gae85g66a7e2d3ee93"
msgid "I - I can't wait any longer. I'm sorry, I'm so sorry."
msgstr "나..나는 더 기다릴 수 없어. 미안해. 정말 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = The Warden
#. NodeID = 31204439-da66-7e02-6bc2-257e3a12a8e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:31204439-da66-7e02-6bc2-257e3a12a8e2
msgctxt "hd40582c4g817eg4d9dgaaf2gd04032b975be"
msgid ""
"<i>You. </i>I'll cut your limbs off and feed them to the gnolls, you "
"disgusting little TRAITOR."
msgstr "<i>네 놈.</i> 네 사지를 찢어서 놀들에게 먹이로 던져주마. 이 역겨운 <b>배신자</b> 새끼야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = 3219356a-74c9-a817-de05-9ec315ca88fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:3219356a-74c9-a817-de05-9ec315ca88fb
msgctxt "h02bd5f62g6bbcg469agb6begd2c6dea46435"
msgid ""
"The fates are already against me, what does the divine matter? Good luck - I "
"hope in the end, you don't suffer."
msgstr "운명의 신이 이미 나를 반대하는데, 신의 진노가 무슨 소용이겠어? 행운을 빌어. 마지막 순간에는 고통이 없기를 바란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = 360cf48b-8432-53c4-0c10-9954ce4163bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:360cf48b-8432-53c4-0c10-9954ce4163bc
msgctxt "h72c7588dgcb9bg47afg8719g051b2af5463e"
msgid ""
"If I die, every Ironhand Gnome in the realm will suffer. I cannot risk it - "
"goodbye."
msgstr "내가 죽으면, 도시에 있는 모든 아이언핸드 노움들이 고통받을 거야. 그런 위험을 감당할 순 없어! 잘 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lakrissa
#. NodeID = 365d1150-0ec0-413e-d6fc-edf0c635b7cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:365d1150-0ec0-413e-d6fc-edf0c635b7cb
msgctxt "h6ff84cf0g3d6bg43dbg8580gb82a12d0bdc5"
msgid ""
"Or strategist, to be honest. My plan is to stick to the water, stay clear of "
"the curse - until I think of something better."
msgstr ""
"아니면 솔직히 말해서, 내가 전략가일 수도 있지. 내 계획은 더 나은 방법이 생각날 때까지 저주에서 벗어나, 물 위에서 지내는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nickels
#. NodeID = 3cdf8a26-2df2-da84-a1cc-08f9f31a8f05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:3cdf8a26-2df2-da84-a1cc-08f9f31a8f05
msgctxt "h5591b9a8g2785g4f05g8c53g2e6594ca3da8"
msgid ""
"The curse touches every part of this land. Only the water is safe - an "
"unhappy prospect."
msgstr "저주는 이 땅의 모든 곳에 영향을 미쳐. 불행하게도 안전한 건 오직 물 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 3cffc625-f8ac-5ee1-76c3-f6aa696ba38b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:3cffc625-f8ac-5ee1-76c3-f6aa696ba38b
msgctxt "h2372c97egfa9fg4446gbf3cgd2cacdab41df"
msgid "<i>Remain in Moonrise.</i>"
msgstr "<i>문라이즈 타워에 남습니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 3d0175da-a65d-8204-818a-a6afa9d9166a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DEEPGNOME(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:3d0175da-a65d-8204-818a-a6afa9d9166a
msgctxt "h436672b3ge06bg499cgaed0gd75ab6b333d9"
msgid "You'd abandon one of your own so easily?"
msgstr "네 동족을 그렇게 쉽게 버려도 되는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 3d0424f7-feaa-4c87-dd08-9fbd6498ed20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:3d0424f7-feaa-4c87-dd08-9fbd6498ed20
msgctxt "hcfbed0acg085ag40edgb3bag37b288b1b31e"
msgid "Stop talking and just go."
msgstr "그만 말하고 빨리 가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = 42599fff-6bfc-8c80-9a3d-ac8da9620ec9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:42599fff-6bfc-8c80-9a3d-ac8da9620ec9
msgctxt "h11693368gabf5g4e93g8e25g5c8170c7706e"
msgid ""
"Something survived in this hellscape? You should've lead with that. See you "
"there."
msgstr "이 지옥 같은 곳에 뭔가 살아남었어? 그걸 먼저 말했어야지. 거기서 보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 490f306d-debb-cc38-1a3a-cf10b96be37f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:490f306d-debb-cc38-1a3a-cf10b96be37f
msgctxt "h7059a547g8f44g44f7g91f5g20de173d9b03"
msgid "You coward! This is <i>not </i>how you get a ballad written about you."
msgstr "겁쟁이 자식! 그렇게 해서는 결코 영웅 서사시의 주인공이 되지 <i>못할</i> 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Cal
#. NodeID = 4a2ea393-e044-dd70-4df6-e1962c191d2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:4a2ea393-e044-dd70-4df6-e1962c191d2c
msgctxt "h13788d39ge49bg40c9gbe80g7b2f935040ba"
msgid ""
"Just when I think I'm out of luck, you come along change that. Thank you - I "
"hope to see you at Last Light, and soon."
msgstr "내가 운이 없다고 생각할 때, 네가 나타나면 상황이 달라져. 고마워. 최후의 빛 여관에서 곧 볼 수 있길 기대할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 5112507c-8cf0-6ab5-3f35-3f44010c7a21
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:5112507c-8cf0-6ab5-3f35-3f44010c7a21
msgctxt "h5b9a8f64gd052g42b1g93fbg7d1da1369478"
msgid "If I were you, I'd stay on the water. But it's your call."
msgstr "나라면 물 위에 머무르겠어. 하지만 선택은 너의 몫이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lakrissa
#. NodeID = 52b9bf55-0f13-974c-7e6a-bd11ca0d8df8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_EscapingInCombat(6) = True
#.      - MOO_Jailbreak_State_BoatLeader(6) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:52b9bf55-0f13-974c-7e6a-bd11ca0d8df8
msgctxt "h636f79a5ge5dcg4164ga968g7b8cca1ec07a"
msgid "We can't wait any longer. Forgive me."
msgstr "더 기다릴 수 없어. 용서해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Danis
#. NodeID = 5455b767-052d-1dd9-35b6-980bc9a9a236
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:5455b767-052d-1dd9-35b6-980bc9a9a236
msgctxt "hbfa80288g9c06g4fb8g877ag55862dbfb649"
msgid "We're ready. At least - I think we are."
msgstr "준비됐어. 최소한 내 생각에는."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 56366e94-e7b2-ca60-70bc-36d14fe5b46a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = True
#.      - HAV_Siege_State_NoProtection = False
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_State_BoatPlayer(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:56366e94-e7b2-ca60-70bc-36d14fe5b46a
msgctxt "h9f5893ffg9666g4013gb9efg33704e0dbe27"
msgid ""
"I'll come with you - I know a place called the Last Light Inn. You'll be "
"safe there."
msgstr "같이 갈게. 내가 최후의 빛 여관이라는 곳을 알아. 거기서는 안전할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Cal
#. NodeID = 622515df-4c78-c530-8c3c-cbb0153b9e41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:622515df-4c78-c530-8c3c-cbb0153b9e41
msgctxt "h4e3a3e21g7862g4135g8251g3d8d875f8222"
msgid ""
"If Elturel has taught me one thing, it's that there's always a way out. "
"Thank you - for everything."
msgstr "엘투렐이 가르쳐 준 게 있다면, 항상 탈출구는 있다는 거야. 모든 게 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Cal
#. NodeID = 66221e2a-009f-98c6-21c7-8f9f0d75d7c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:66221e2a-009f-98c6-21c7-8f9f0d75d7c3
msgctxt "h664e7015g3c35g4aaagacfdga6f71a355379"
msgid ""
"All I want is to lie down and sleep for a tenday, but we're not safe yet."
msgstr "당장이라도 누워서 열흘 동안 자고 싶은데, 아직 안전하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = 69015501-30f8-da43-4df6-a34f10c3a99f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_EscapingInCombat(1) = True
#.      - MOO_Jailbreak_State_CloseToBoatLeader(0) = True
#.      - MOO_Jailbreak_State_BoatLeader(1) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:69015501-30f8-da43-4df6-a34f10c3a99f
msgctxt "hefb5f3c3gddc6g44b7gaff6gfef5a4285aa6"
msgid "There's no time! I'm leaving - hold them off."
msgstr "시간이 없어! 난 갈테니, 저 녀석들을 막아 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nickels
#. NodeID = 6a7a14c0-cbfd-aa7a-445f-1fb855b2d694
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:6a7a14c0-cbfd-aa7a-445f-1fb855b2d694
msgctxt "h002ee2f1gc79eg4006gb363ga736a9107888"
msgid ""
"That is a relief - I do not know how long I could have tolerated the water. "
"Thank you."
msgstr "다행이다. 얼마나 물 위에서 버틸 수 있을지 가늠할 수 없었는데. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 6b35d253-e4d8-0682-e4fc-80bffc64e1b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = False
#.      - HAV_Siege_State_NoProtection = False
#.   Local:
#.      - 30d43adb-dcaf-c0f3-d432-af96a1c2e1ea_spoketowulbren = False
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_State_BoatPlayer(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:6b35d253-e4d8-0682-e4fc-80bffc64e1b8
msgctxt "h4550bea6gb4afg4499g8e74ge3e38affc44e"
msgid "I'll join you on the water - we'll see where we end up."
msgstr "저도 물 위에서 여러분과 함께하겠습니다. 어디로 가는지 지켜봅시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 6bea42c7-8afa-114c-2780-6eaee11dfc76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Siege_State_NoProtection = False
#.      - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#.   Local:
#.      - 30d43adb-dcaf-c0f3-d432-af96a1c2e1ea_speakingtoatiefling = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_State_BoatPlayer(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:6bea42c7-8afa-114c-2780-6eaee11dfc76
msgctxt "h3543bac6g963fg49cag80d8g481a557ee493"
msgid "Let's go there together - I'll show you the way."
msgstr "같이 갑시다. 제가 길을 알려줄게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 6d93eef4-9dab-69fd-63c3-58de518ab872
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_EVIL(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:6d93eef4-9dab-69fd-63c3-58de518ab872
msgctxt "hdbee801fg253fg4333ga21eg14adc973f51e"
msgid "Leave me and I'll bring the wrath of the divine down upon you."
msgstr "나를 버려두고 가면, 너에게 신의 진노를 내리겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 70c8228c-df55-a9be-ed52-35ecf78eec3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = False
#.      - HAV_Siege_State_NoProtection = False
#.   Local:
#.      - 30d43adb-dcaf-c0f3-d432-af96a1c2e1ea_spoketowulbren = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_State_BoatPlayer(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:70c8228c-df55-a9be-ed52-35ecf78eec3c
msgctxt "h87e8f05fgc603g46feg891egaa4a71ac4148"
msgid "I don't - but I'll join you on the boat. We'll see where we end up."
msgstr "저에겐 없지만, 보트에 같이 타겠습니다. 어디로 갈지 두고 봅시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = 71d3834d-539a-b26f-f932-ba7e25d6c8ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:71d3834d-539a-b26f-f932-ba7e25d6c8ad
msgctxt "hea95bbb0gf7d5g4aa1ga5f0g7c2c32d00de9"
msgid ""
"Maybe. But you'll be the first drow celebrated by the Ironhand Gnomes - "
"consider it an honour! Farewell."
msgstr "그럴지도 모르지. 하지만 넌 아이언핸드 노움의 칭송을 받는 첫 번째 드로우가 될테니, 영광으로 알라고! 잘 있어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 72992763-246c-08e5-01f4-1e6aeeed2bb3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:72992763-246c-08e5-01f4-1e6aeeed2bb3
msgctxt "he48ff060g34c9g4ab3gbcb9ge2a3226c7fc9"
msgid "Stop talking - just get on the damn boat!"
msgstr "그만 말하고, 망할 보트에 타!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = 743d20e0-ab08-7a77-38ce-f9affe285775
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:743d20e0-ab08-7a77-38ce-f9affe285775
msgctxt "h571cd70cgef0fg4f65g87f2gfcc1d68656b9"
msgid "'Safe'? No small claim in these parts. Lead the damn way."
msgstr "'안전'이라고? 이 근방에선 찾아보기 힘든 말이지. 앞장서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = 747f73ba-9416-448c-375b-323b009f99cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_EscapingInCombat(1) = True
#.      - MOO_Jailbreak_State_BoatLeader(1) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:747f73ba-9416-448c-375b-323b009f99cf
msgctxt "hef97f89cgacdfg4781g8c8fg0d82c4f3a46f"
msgid "The Ironhand Gnomes thank you - your sacrifice will be remembered."
msgstr "아이언핸드 노움이 감사를 표한다. 너의 희생은 기억될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Cal
#. NodeID = 75193b84-8458-3172-01f6-4314720b7f4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_EscapingInCombat(5) = True
#.      - MOO_Jailbreak_State_BoatLeader(5) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:75193b84-8458-3172-01f6-4314720b7f4e
msgctxt "he3070404g7154g4245g9320gf9215b5ad7a4"
msgid "We can't wait any longer, I'm <i>sorry.</i>"
msgstr "더 이상 기다릴 수 없어, <i>미안해.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 81ab9171-786a-872e-3ab2-40881d2dd708
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:81ab9171-786a-872e-3ab2-40881d2dd708
msgctxt "h825836a6g76e6g48eeg8291g5794f5269911"
msgid "I should have known better than to save a <i>gnome.</i>"
msgstr "너희 <i>노움</i>이란 족속들의 본성을 미리 알았다면 애초에 구하지도 않았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 8b597648-7e0b-ffe5-aa35-2886792e337f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GOOD or PALADIN_GOOD
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:8b597648-7e0b-ffe5-aa35-2886792e337f
msgctxt "hc43ea771ga7bcg4eeaga68ag6aa6abb220c6"
msgid "Take the boat and go! They won't get past me."
msgstr "보트를 타고 떠나시오! 저들은 내가 막을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lakrissa
#. NodeID = 8b7e136b-4159-7745-eb9f-476f508aafc4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:8b7e136b-4159-7745-eb9f-476f508aafc4
msgctxt "h159edcc6ga84bg4499gaf13g2d84d3f7dd7f"
msgid ""
"I knew there was a reason I liked you - you always have the answer. I better "
"see you at Last Light, and in one piece."
msgstr "내가 너를 좋아하는 이유가 있었다니까. 넌 항상 해답을 가지고 있어. 최후의 빛 여관에서 무사히 만났으면 좋겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nickels
#. NodeID = 8ccb33c5-5432-80a0-17f0-39cf73e3ca39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:8ccb33c5-5432-80a0-17f0-39cf73e3ca39
msgctxt "h04ab101fg6f98g4c1fg8dabgc11768b3aea4"
msgid ""
"That is a relief - I do not know how long I could have tolerated the water. "
"May we meet on dry land soon."
msgstr "다행이다. 얼마나 물 위에서 버틸 수 있을지 가늠할 수 없었는데. 마른 땅 위에서 곧 만나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nickels
#. NodeID = 8fff9f02-4ea9-879f-0e6a-4bbe4bcc90b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:8fff9f02-4ea9-879f-0e6a-4bbe4bcc90b2
msgctxt "hbf673bdegd3bbg45b2gaef2g919df8bc5609"
msgid ""
"The boat calls. The thought of leaving the comfort of stone makes my heart "
"pound - but I have no choice."
msgstr "배가 우리를 부르네. 익숙한 돌 위를 떠난다는 생각에 심장이 두근거리지만, 선택의 여지가 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = 964acf62-c641-a439-6699-f91707b9222f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Siege_State_NoProtection = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:964acf62-c641-a439-6699-f91707b9222f
msgctxt "h71a5becbgccdag46d0g9184g7e90fec8e827"
msgid "All I know is that the sooner you leave, the better."
msgstr "내가 아는 건, 빨리 떠날수록 좋다는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Narrator
#. NodeID = 99676b5d-0225-31b4-da18-b7332ae15ada
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Event_PlayerClickedOnBoat = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#.      - GEN_IsSpeakerPresent_7 = False
#.      - GEN_IsSpeakerPresent_4 = False
#.      - GEN_IsSpeakerPresent_3 = False
#.      - GEN_IsSpeakerPresent_8 = False
#.      - GEN_IsSpeakerPresent_6 = False
#.      - GEN_IsSpeakerPresent_5 = False
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_PlayerClickedOnBoat = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:99676b5d-0225-31b4-da18-b7332ae15ada
msgctxt "hc4e0713cg92f0g4991g946cga5f3e2838f4f"
msgid ""
"*The current is powerful, pulling at the boat. Should you leave, you will "
"not be able to return to Moonrise Towers this way.*"
msgstr "*강한 조류가 보트를 잡아당기고 있습니다. 보트를 타고 떠나면, 이 방법으로는 문라이즈 타워로 돌아올 수 없게 됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lakrissa
#. NodeID = 9c8a8f23-aea3-c6da-0f37-fd7cd3417238
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:9c8a8f23-aea3-c6da-0f37-fd7cd3417238
msgctxt "h402a3359g7fb6g4f03gbf60gfcdc5075618c"
msgid ""
"True, I'm pushing my luck just standing here. But I can't leave without a "
"warning."
msgstr "사실이야. 여기 있는 것만으로도 내 운이 다 사라질 거야. 그래도 너에게 경고 없이 떠날 수는 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lakrissa
#. NodeID = a565c1a9-02dc-2c80-ada2-804ecd54b8db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#. SetFlags:
#.   Local:
#.     - 30d43adb-dcaf-c0f3-d432-af96a1c2e1ea_speakingtoatiefling = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:a565c1a9-02dc-2c80-ada2-804ecd54b8db
msgctxt "h1cbb7cceg53feg4b46gb84dg95e2868a2791"
msgid ""
"You mentioned somewhere earlier - Last Light was it? How do we get there?"
msgstr "전에 말한 곳 있었지, 최후의 빛 여관? 거기에 어떻게 가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Cal
#. NodeID = a93e84d7-323c-3d92-114b-36cddee60c3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#. SetFlags:
#.   Local:
#.     - 30d43adb-dcaf-c0f3-d432-af96a1c2e1ea_speakingtoatiefling = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:a93e84d7-323c-3d92-114b-36cddee60c3a
msgctxt "h56820be4gbb7bg40d9ga192g61307b54cb52"
msgid ""
"We need somewhere to bunker down - somewhere safe. You mentioned a place, "
"Last Light was it?"
msgstr "당분간 안전하게 머무를 곳이 필요해. 아까 말했던, 최후의 빛 여관 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = ab4e4e73-1177-5492-a4f1-de419f7bd691
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Siege_State_NoProtection = False
#.      - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#.   Local:
#.      - 30d43adb-dcaf-c0f3-d432-af96a1c2e1ea_speakingtoatiefling = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:ab4e4e73-1177-5492-a4f1-de419f7bd691
msgctxt "h6460a2adg9eadg4758g8fa9g00e347177afd"
msgid "It's to the east - you'll be safe there."
msgstr "동쪽으로 가요. 거기는 안전할 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nimble
#. NodeID = b2fcdac8-5d1e-7009-484f-d1cb1d520d3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:b2fcdac8-5d1e-7009-484f-d1cb1d520d3a
msgctxt "h9f4414b6g978bg4edag8606gbaa81bc28387"
msgid ""
"I knew Gaerdal wouldn't steer me wrong. Thank you - maybe I'll see you there."
msgstr "게르달 아이언핸드가 나를 잘못 인도하지 않을 거란 걸 믿고 있었어. 고마워. 거기서 만나자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nimble
#. NodeID = b46de2df-8177-656a-92a2-193b05b106f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:b46de2df-8177-656a-92a2-193b05b106f8
msgctxt "h647b9bffg59edg4badg88fag188278681323"
msgid "I'm no sailor, but I've prepped the boat as best I can."
msgstr "항해사는 아니지만, 할 수 있는 최선을 다해서 배를 준비했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Cal
#. NodeID = b48ef9d0-d0c3-9a3d-ec78-fa21319bfd27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:b48ef9d0-d0c3-9a3d-ec78-fa21319bfd27
msgctxt "hddf52998g4811g41abg9940g5c85dcd14596"
msgid ""
"We'll get this thing onto the water, far from the curse, and plan our next "
"move."
msgstr "물에 배를 띄우고, 저주에서 멀어지고, 그 다음에 계획을 세우도록 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = bad6209a-eaef-6152-0af3-f4aed36703ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:bad6209a-eaef-6152-0af3-f4aed36703ef
msgctxt "he5c30f98g4d96g48e1g9774g298e5a039c82"
msgid "Only cowards flee a battle unfinished."
msgstr "겁쟁이들이나 끝나지 않은 전투에서 도망칩니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = bc2f2ddc-8ec5-a4bd-32fd-2eb974acd022
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:bc2f2ddc-8ec5-a4bd-32fd-2eb974acd022
msgctxt "hf4b41ba3gdb24g40d8g885fg70bec15f515f"
msgid ""
"From me and every Ironhand Gnome in the realm - thank you. You've done more "
"than you could ever know."
msgstr "나와 도시의 모든 아이언핸드 노움들이 너에게 감사를 표한다. 너는 너가 아는 것보다 훨씬 많은 일을 해줬어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = bd555d48-f43a-3d37-42ac-902b967af698
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = True
#.      - HAV_Siege_State_NoProtection = False
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:bd555d48-f43a-3d37-42ac-902b967af698
msgctxt "h85b4655bgafc0g4c60gaa1eg1ae271cecd39"
msgid "Look to the east for the Last Light Inn. You'll be welcome there."
msgstr "동쪽에 최후의 빛 여관이 있어. 그곳에선 환영받을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = c3cbcd89-7111-8aa3-cd03-e878613ea8c3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:c3cbcd89-7111-8aa3-cd03-e878613ea8c3
msgctxt "hdc2bad13g13acg4a86gaa0ag3d6b3956e905"
msgid "Wait for me!"
msgstr "기다려 줘!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = c404df44-9fe4-4ce8-93dd-1f014e925f25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:c404df44-9fe4-4ce8-93dd-1f014e925f25
msgctxt "h9c3c245cg7496g44e6ga5dbg9fc42f74fb66"
msgid "I will not fall in battle - we will meet again."
msgstr "저는 전투에서 쓰러지지 않을겁니다. 곧 다시 만날 수 있을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Danis
#. NodeID = cbf8272a-974a-a3ca-bde3-a8f4dc7aa101
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:cbf8272a-974a-a3ca-bde3-a8f4dc7aa101
msgctxt "h96fb0bafg6932g446agbe4fg6d579dd72cb4"
msgid ""
"Thank the gods. I'll head out now, while it's quiet, but I hope to see you "
"at Last Light."
msgstr "신이시여, 감사합니다. 조용할 때 떠나야겠어. 그래도 최후의 빛 여관에서 너를 다시 볼 수 있었으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Danis
#. NodeID = d027cf3b-77ce-9448-dcda-28f967b743c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#. SetFlags:
#.   Local:
#.     - 30d43adb-dcaf-c0f3-d432-af96a1c2e1ea_speakingtoatiefling = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:d027cf3b-77ce-9448-dcda-28f967b743c7
msgctxt "he9fe5132gc939g4231g8a82g1620f9afcf9a"
msgid "That place you'd mentioned, what was it called? Last Light?"
msgstr "전에 말했던 장소, 이름이 뭐였지? 최후의 빛 여관?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lia
#. NodeID = d20aea71-6fac-098b-4fe8-ada7d2c18c00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:d20aea71-6fac-098b-4fe8-ada7d2c18c00
msgctxt "h72449faag1bb4g4bf6g8868g7e951a51c132"
msgid ""
"Blessed Tymora, you're sometimes good to me. I'll leave while it's quiet, "
"but you better not be far behind, you hear?"
msgstr "티모라에 축복을, 가끔은 도움을 주시는 군. 난 조용할 때 떠나야겠어. 그래도 너무 뒤처지지는 마. 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lia
#. NodeID = d37ca01e-6c77-54a9-875e-15ecdf978a0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#. SetFlags:
#.   Local:
#.     - 30d43adb-dcaf-c0f3-d432-af96a1c2e1ea_speakingtoatiefling = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:d37ca01e-6c77-54a9-875e-15ecdf978a0e
msgctxt "hb7e58377gaf6bg47a7ga57bg3b8f382d06af"
msgid ""
"What I do need though, is a destination. You mentioned somewhere earlier, "
"Last Light was it?"
msgstr "하지만 목적지가 필요해. 아까 잠깐 최후의 빛 여관에 대해 말했었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lakrissa
#. NodeID = d3880881-bc06-7f2a-8cba-f556bfe57bf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:d3880881-bc06-7f2a-8cba-f556bfe57bf3
msgctxt "hd6d29c14g89aeg4fb5ga33bge05883b0c1e1"
msgid ""
"Always saving the day - I knew there was a reason I liked you. Let's get out "
"of this dump."
msgstr "언제나 어려운 상황을 해결해주네. 내가 너를 좋아하는 이유가 있었어. 이 쓰레기장에서 빨리 나가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = d46a77b4-fabe-f7a6-df83-517c6cb09bfc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = False
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_State_BoatPlayer(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:d46a77b4-fabe-f7a6-df83-517c6cb09bfc
msgctxt "h3ba8cf13gfac2g477dg8c7agb99cf0787dc9"
msgid "<i>Set out - ready for wherever the tide takes you.</i>"
msgstr "<i>떠납니다. 조류가 데려다주는 어디로든 갈 준비가 되어 있습니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lia
#. NodeID = d95414a3-5b4e-2516-d9b7-f3cb3747b323
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:d95414a3-5b4e-2516-d9b7-f3cb3747b323
msgctxt "h14dcee1dg45d8g4fafg82a4gca7a3d2a1629"
msgid ""
"But listen - heard the guards in a tizzy over something big - an army. "
"Whatever these arseholes are up to, it isn't good. Get out - and soon."
msgstr ""
"하지만 내 말 들어봐. 경비병들이 자기들 군대에 곧 큰일이 있을 거라고 소란을 떨었어. 이 자식들이 무슨 꿍꿍이를 꾸미고 있든 간에 좋지 "
"않아. 빨리 이곳을 떠나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nimble
#. NodeID = dab5425f-63fe-8078-ed36-c098ca45e77e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_EscapingInCombat(2) = True
#.      - MOO_Jailbreak_State_BoatLeader(2) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:dab5425f-63fe-8078-ed36-c098ca45e77e
msgctxt "h3a929b14g66dcg4ee8g8666g4df9b2d6b423"
msgid "We can't wait. Give the bastards hell for us!"
msgstr "기다릴 수 없어. 우리를 위해 개자식들에게 지옥을 보여줘!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lia
#. NodeID = dd0dc8d3-c673-e5aa-2f00-d1e2d3487cab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_EscapingInCombat(4) = True
#.      - MOO_Jailbreak_State_BoatLeader(4) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:dd0dc8d3-c673-e5aa-2f00-d1e2d3487cab
msgctxt "h92cf9f24g891bg4002gbfeegb6b9216ac6e5"
msgid "Damn it all, the boat's leaving. I'm sorry!"
msgstr "젠장, 보트가 떠나고 있어. 미안해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nickels
#. NodeID = dd20fc7e-5055-ecc9-90fc-a8bba2ddf005
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:dd20fc7e-5055-ecc9-90fc-a8bba2ddf005
msgctxt "h10e05caeg5b60g441ag9b17g5c73a86a8561"
msgid ""
"Indeed. If I meant to survive, then I will. But know this: the stone in "
"Moonrise screams. Something evil is here, you should leave while you can."
msgstr ""
"맞아. 내가 살아남기로 결정했다면, 그렇게 할 거야. 하지만 이건 명심해. 문라이즈에 있는 돌들이 비명을 지르고 있어. 무언가 사악한 "
"것이 이곳에 있으니, 너도 떠날 수 있을 때 떠나야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = e35be633-3a2e-07e1-b20e-af1378be8dd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:e35be633-3a2e-07e1-b20e-af1378be8dd3
msgctxt "h25e55f74g2f5bg44f4g9a63g493e9b743883"
msgid "In another life, you'd have made an excellent Ironhand Gnome. Farewell."
msgstr "다른 생에서, 넌 훌륭한 아이언핸드 노움이 됐을 거야. 잘 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nickels
#. NodeID = e4e04e2e-8c57-8112-54af-64557be86f08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_EscapingInCombat(3) = True
#.      - MOO_Jailbreak_State_BoatLeader(3) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:e4e04e2e-8c57-8112-54af-64557be86f08
msgctxt "hd8ea40bcgc790g4eb6g9654g1df6c348ee30"
msgid "I'm sorry, I must go now. I'm so sorry."
msgstr "미안해, 진짜 가야 해. 정말 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Lakrissa
#. NodeID = eb0be5b1-4a2f-021b-06c8-c947e12fea4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:eb0be5b1-4a2f-021b-06c8-c947e12fea4c
msgctxt "h7a9ecdfeg55eag446ag848bg1000156f2cfb"
msgid ""
"I heard whispers inside of something big - an army. Do what you have to "
"here, and then scarper. Please."
msgstr "거대한 군사 행동에 관한 소문을 들었어. 네가 여기서 하려는 일을 하고나면, 제발 도망가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = eb2e8b18-29dc-9122-b140-79691a600d4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:eb2e8b18-29dc-9122-b140-79691a600d4b
msgctxt "h9dec8a8bgebeeg47fcgb436g12b144aec625"
msgid "Boat's good to go - all that's left is to ship off."
msgstr "보트가 준비됐으니, 이제 띄우기만 하면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nimble
#. NodeID = eec6dc6d-94b2-5399-c082-00b346442862
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:eec6dc6d-94b2-5399-c082-00b346442862
msgctxt "hea7337c8g48bdg41f8ga435g729c29460b9f"
msgid ""
"I don't know this hellscape. We can hide out from the curse on the water, I "
"guess."
msgstr "이 지옥 같은 곳을 잘 모르겠어. 아마 물 위에서는 저주를 피할 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = effa7cf5-647a-f10d-9f59-c312eb943c53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(0) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeftWithoutPermission = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:effa7cf5-647a-f10d-9f59-c312eb943c53
msgctxt "he8820816gb7ebg4bfbgafd6g4c59979217e9"
msgid "A battle divided is a battle lost - stay and finish this."
msgstr "끝나지 않은 전투는 패배한 전투입니다. 남아서 전투를 마무리합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Player
#. NodeID = f05346c2-7843-7ac7-32ec-d5fbb1acec43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_Siege_State_NoProtection = True
#.      - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#.   Local:
#.      - 30d43adb-dcaf-c0f3-d432-af96a1c2e1ea_speakingtoatiefling = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_BoatLeavesWithoutPlayers = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:f05346c2-7843-7ac7-32ec-d5fbb1acec43
msgctxt "hf885b8bdgb2b0g4b82g8e75g655e1ad2365b"
msgid "I don't think there's anywhere else for you to go. Good luck out there."
msgstr "제 생각엔 여러분이 갈 수 있는 곳은 없어보입니다. 저 밖에서 행운을 빌게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nimble
#. NodeID = f4f5d49e-495e-5c7c-ebe5-8f520792adb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:f4f5d49e-495e-5c7c-ebe5-8f520792adb0
msgctxt "hf3f6f3e6g5274g4246g88a8g91a63c29d52a"
msgid ""
"True - who knows what could come charging out of Moonrise next. Thank you - "
"the Ironhands will remember this."
msgstr "네 말이 맞아. 다음에는 문라이즈에서 뭐가 우리에게 달려올지 알겠어. 고마워. 아이언핸드가 이 일을 기억할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = f500e1b0-67c9-3b49-e976-c73fac341c4c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:f500e1b0-67c9-3b49-e976-c73fac341c4c
msgctxt "haedc1786g3430g4ecag8e14gfc0a4bd7f856"
msgid "Now that is a plan I can get behind."
msgstr "그게 바로 내가 찬성하는 계획이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Cal
#. NodeID = f5a595ee-614a-0a46-9594-082f41aa3eff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:f5a595ee-614a-0a46-9594-082f41aa3eff
msgctxt "h487195d1gf56ag4ac8g93fbg4c1eefbd42d1"
msgid "Have I mentioned I'm really really glad we met? Let's go."
msgstr "우리가 만나게 돼서 정말 기쁘다고 말한 적 있나? 어서 가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Nimble
#. NodeID = f69334e9-f69c-6acf-9f24-a56f12a38288
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:f69334e9-f69c-6acf-9f24-a56f12a38288
msgctxt "hdb755350g49a3g4083g991fgc9d2f32a0ee7"
msgid "Somewhere survived the curse? Count me in."
msgstr "저주에서 안전한 곳이 있다고? 나도 껴줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat
#. Speaker = Wulbren Bongle
#. NodeID = f6bad18a-07fe-f6d3-c718-70b847f03bd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Boat:f6bad18a-07fe-f6d3-c718-70b847f03bd8
msgctxt "h2a80583eg05c2g4df3ga92dg9b8a6a332c84"
msgid ""
"Ballads won't save my people, only action will - and I can do nothing if I'm "
"dead. Farewell."
msgstr "하! 영웅담으로는 내 부하들을 구할 수 없어, 오직 행동으로만 가능하지. 내가 죽으면 아무것도 할 수 없고. 잘 있어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 0b122abc-0153-fff5-19cf-fa9dca7c73e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_FlirtyAtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:0b122abc-0153-fff5-19cf-fa9dca7c73e5
msgctxt "h7a210b19g1ab2g4e53g9dd4g4b068c4ce1a9"
msgid "Did an <i>orc </i>tie this off? Gods - give me a moment."
msgstr "<i>오크</i>가 묶어 놓기라도 했나? 맙소사, 잠깐만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Player
#. NodeID = 0c08a7fc-58ef-2fd9-3c65-495c6f7a260b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_AngryFlirty(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:0c08a7fc-58ef-2fd9-3c65-495c6f7a260b
msgctxt "h66c934c0g1035g47dbg99ccgdefa816836e9"
msgid "Yes. Enjoy rotting in your cell."
msgstr "그래, 감빵에서 잘 썩어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 0c3adfe6-04e1-99dd-36f7-742688d98e9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:0c3adfe6-04e1-99dd-36f7-742688d98e9b
msgctxt "hc2c90a9eg13e2g4753ga91eg28be738e7348"
msgid "Just kill us and be done with it."
msgstr "그냥 우릴 죽이고 다 끝내 ."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 0ce2616e-f9aa-b18c-e07a-8ca82c4dd743
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_Unavailable = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:0ce2616e-f9aa-b18c-e07a-8ca82c4dd743
msgctxt "h54a32790g58b6g4bd5g8e9cg6b3d92253259"
msgid ""
"Oh, thank the stars. When I saw Alfira disappear into the darkness, my heart "
"just about stopped."
msgstr "별들이시여 고맙습니다. 알피라가 어둠 속으로 사라지는 걸 봤을 때, 심장이 멈추는 줄 알았어요. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 15d89b7e-941c-25a4-6fbc-212b1bfbfb1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:15d89b7e-941c-25a4-6fbc-212b1bfbfb1b
msgctxt "h70c226dbg86d2g43e9g96e2g32fbd3c80965"
msgid ""
"We were trekking through the darkness when the cultists jumped us. Bastards "
"gutted half of us - just for the fun."
msgstr "어둠 속을 헤매고 있었는데 갑자기 신봉자들이 우릴 습격했어요. 개자식들이 그냥 재미로 우리 중 절반을 죽였어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 18aef4fb-b204-6e41-78be-a7924724ab96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_AngryFlirty(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:18aef4fb-b204-6e41-78be-a7924724ab96
msgctxt "h73fd4e2fg37b0g4472g960bg9ed9d3a83982"
msgid "I'm not listening to another word you say. Get out of here!"
msgstr "더 이상 말 하지 말고 여기서 나가요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 1b49738f-544c-8781-ed76-c4e28843b97d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:1b49738f-544c-8781-ed76-c4e28843b97d
msgctxt "h86f64a5bg8060g4b6agabebgeac4866eef25"
msgid ""
"I took a blow to the head, then woke up in this hellspit. Barely known which "
"way is up since."
msgstr "머리에 충격을 받은 뒤 이 지옥 같은 곳에서 깨어났어요. 그 뒤로 아직도 어느 곳이 위인지 모르겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Player
#. NodeID = 1dbbaadd-bb92-f9c1-f51e-5dd67c178513
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_AngryFlirty(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:1dbbaadd-bb92-f9c1-f51e-5dd67c178513
msgctxt "ha8ec7cf9g980eg467dgab29geaa90cc8810c"
msgid "I have better things to do. Get out of here your damn self."
msgstr "여기서 해야 할 더 중요한 일이 있어. 너 혼자 나가던지 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 34d106da-682d-05ac-52b1-e6e527a35ffd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:34d106da-682d-05ac-52b1-e6e527a35ffd
msgctxt "h66c2b1b5ga9b9g4476gbeb7g371245803cc1"
msgid "Thank the gods."
msgstr "신이시여 감사합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 38e19e8e-743f-c9c7-5bf6-7e0fbaa440c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:38e19e8e-743f-c9c7-5bf6-7e0fbaa440c0
msgctxt "h8455ddb4g9bdcg43feg94b5g7f3f7f0dd3cf"
msgid ""
"After the attack, I thought I couldn't trust my judgement. Glad to see I was "
"right about you."
msgstr "습격이 있은 뒤로는, 내 판단을 믿을 수 없었어요. 당신에 대해서 만큼은 옳았던 것 같아 다행이네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Player
#. NodeID = 3f049cbe-b825-9d84-86f2-67a03349bf3a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:3f049cbe-b825-9d84-86f2-67a03349bf3a
msgctxt "h7aee817cg4f99g41c7g91d6gc5a856928d07"
msgid "I'm not with the cult, I swear -  I'm here to help."
msgstr "난 절대자를 섬기지 않아, 맹세해. 도와주러 왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 44379200-5e19-9a42-ec23-b5aa8cf1ad1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = False
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Knows_SpeakWithGnomes = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:44379200-5e19-9a42-ec23-b5aa8cf1ad1a
msgctxt "h43afd79fg1dc7g4b0dg86f4gf5ec2a68f0cf"
msgid ""
"Speak to the gnomes - they've been knocking about their cell for days. "
"Whatever they're up to? I'm in."
msgstr "노움들과 얘기를 해 봐요. 며칠간 자기네 감방을 열심히 두드려 댔거든요. 그 계획이 뭐든 간에, 나도 끼겠어요. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 557a1e56-0967-58f9-b9b1-b4587286ada1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_FlirtyTiefling(1) = True
#.      - MOO_Jailbreak_Event_SpeakToTieflingsWarning(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:557a1e56-0967-58f9-b9b1-b4587286ada1
msgctxt "h6ebca463g94e0g4316gbd6ageae23f5ddd80"
msgid "The gnomes - speak to the gnomes!"
msgstr "노움들, 노움들이랑 얘기를 해 봐요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 57e9d2f1-db71-1c52-0e1c-1e9d1b1d16cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:57e9d2f1-db71-1c52-0e1c-1e9d1b1d16cb
msgctxt "h33019e06gb753g4af4g8881g48bff312cd5d"
msgid ""
"After Zevlor, I thought I couldn't trust my judgement. Glad to see I was "
"right about you."
msgstr "제블로어가 그렇게 된 뒤로, 내 판단을 믿을 수 없었어요. 당신에 대해서 만큼은 옳았던 것 같아 다행이네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 58cda0cd-7f34-28c4-09a5-bee0acb69387
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_TieflingLeader(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_FlirtyTiefling(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:58cda0cd-7f34-28c4-09a5-bee0acb69387
msgctxt "h2f9b41afg6972g4be8gb248ge00b45df180e"
msgid "Oh <i>no.</i>"
msgstr "<i>이럴수가.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Player
#. NodeID = 5a0a306c-ca68-350f-a98c-19df3f626199
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:5a0a306c-ca68-350f-a98c-19df3f626199
msgctxt "hbda3b773g044ag47b0gae89g6d00d7b68b29"
msgid "Don't worry, I'm going to get you out of here."
msgstr "걱정 마. 여기서 꺼내줄 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 689b53f9-f7b7-5e1b-e2cc-b6a0c4b0712d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:689b53f9-f7b7-5e1b-e2cc-b6a0c4b0712d
msgctxt "h0924aa8dg0e82g4abfg9047gd72a8f209210"
msgid "I couldn't bear the thought of them being hurt. Not after Zevlor."
msgstr "그들이 다쳤을 거라고 생각했어요. 제블로어도 그렇게 됐으니. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 6c47d839-e5c3-5010-9302-bf8be2c26e04
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_FlirtyTiefling(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:6c47d839-e5c3-5010-9302-bf8be2c26e04
msgctxt "h4bcc192eg80b6g4b86g818eg2481e111c405"
msgid ""
"There must be a way out of here, please. I don't want to end up on some "
"necromancer's slab."
msgstr "빠져나갈 길이 분명 있을 거예요. 웬 사령술사의 실험 재료 신세가 되고 싶진 않거든요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 6ecc52b3-98ea-8644-7e7a-8aa7c8b9698c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:6ecc52b3-98ea-8644-7e7a-8aa7c8b9698c
msgctxt "hb9088abdge723g4b32gacf7gedb749259827"
msgid "Whatever the plan, I'll do what I can to help. You can count on it."
msgstr "계획이 뭐던간에 도울 수 있는 일이라면 도울게요. 말만 해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 73d93ec1-89e6-f06e-6e49-2dc8e01a1ba2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:73d93ec1-89e6-f06e-6e49-2dc8e01a1ba2
msgctxt "hf6f9ac03g1857g4a94gaf2dg31d88b8c3629"
msgid "I'd offer to bet on it, but I know you'll win this one."
msgstr "내기라도 할까 싶은데, 당연히 당신이 이기겠죠. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 7eed8452-0a62-f619-fe15-5335d17b250e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:7eed8452-0a62-f619-fe15-5335d17b250e
msgctxt "h9852d8b7g1dabg4c60gad8bg44d244fb0558"
msgid "...I can't trust anyone, can I?"
msgstr "...믿을 사람이 아무도 없다는 거네?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 7f9b80f0-e0e3-233f-a496-76d96e884440
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:7f9b80f0-e0e3-233f-a496-76d96e884440
msgctxt "ha0bc8c7fg2f3fg470fg8870g2d9439b77076"
msgid "You're still you! Thank the gods."
msgstr "여전히 당신이군요! 신이시여 감사합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Player
#. NodeID = 87ae4da2-538c-2428-abbb-c23e27b37756
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:87ae4da2-538c-2428-abbb-c23e27b37756
msgctxt "h086cbb04g703bg465eg921fg13cbba3bb655"
msgid ""
"Accuse me of being with the Absolute again, and I'll leave you here to die."
msgstr "한 번만 더 날 절대자 편이라고 모함하면, 네가 여기서 죽도록 내버려두겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 8f85715a-503b-f7f3-f031-03b5f87ac93b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:8f85715a-503b-f7f3-f031-03b5f87ac93b
msgctxt "hcad3ef5fg4e77g456fgb7b6g2d180fa1a937"
msgid "I couldn't bear the thought of her being hurt. Not after Zevlor."
msgstr "그녀가 다쳤을 거라는 생각이 들었어요. 제블로어도 그렇게 됐으니. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = 9a10316e-c601-9fa7-4d35-fb6b259846eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:9a10316e-c601-9fa7-4d35-fb6b259846eb
msgctxt "h30ba0c44gc321g4c0bgac05gb3c681f253fe"
msgid "I couldn't bear the thought of them being hurt. Not after the attack."
msgstr "그들이 다쳤을 거라는 생각을 했어요. 습격을 받고 난 뒤였으니까요. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Player
#. NodeID = 9ace601e-878d-b8c9-d490-8eb7ea3e9638
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:9ace601e-878d-b8c9-d490-8eb7ea3e9638
msgctxt "h94f581d6gb423g4c63ga153g4ebe3a451e46"
msgid "Must I save you? <i>Again?</i>"
msgstr "널 구해달라고? <i>또?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Player
#. NodeID = a0aba2bd-871a-b30e-c91c-e576e64898ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_SavingPrisoners_Knows_CapturedTieflings = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:a0aba2bd-871a-b30e-c91c-e576e64898ae
msgctxt "h3c210fc0g5aabg497bg9d38g80594e444100"
msgid ""
"No - the other tieflings sent me. They're in a place called Last Light - "
"it's safe there."
msgstr "아니. 다른 티플링들이 날 보냈어. 최후의 빛이라는 곳에 있는데, 거긴 안전해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = a6e3d5af-b467-8a94-d91c-44cffb9dff4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:a6e3d5af-b467-8a94-d91c-44cffb9dff4a
msgctxt "hd07959dcgc77ag465fga67egbf64af6dd4d2"
msgid "It's always a trick. Just go away."
msgstr "언제나 그렇듯 속임수겠지. 날 내버려둬요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = a800d45f-7fbe-5d1b-9a0e-a9913fa502a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_AngryFlirty(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:a800d45f-7fbe-5d1b-9a0e-a9913fa502a1
msgctxt "h3aff34cag0c6dg493bga846g64e1970d6d47"
msgid "No - no this is a trick isn't it?"
msgstr "아니, 그럴리 없어. 이거 속임수지? "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = c0688f95-e10a-181d-10e1-74f6af8ef783
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:c0688f95-e10a-181d-10e1-74f6af8ef783
msgctxt "h7fbdc1ebgd427g4497g852dgfc5d81cf440f"
msgid "I couldn't bear the thought of her being hurt. Not after the attack."
msgstr "그녀가 다쳤을 거라는 생각이 들었어요. 습격을 받고 난 뒤였으니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = c2ada5a9-bb89-b159-c631-bade54c07874
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:c2ada5a9-bb89-b159-c631-bade54c07874
msgctxt "ha2c2763dg8a53g4ef8gb772gdfb515420046"
msgid ""
"Terribly sorry for the <i>inconvenience, </i>but yes, if you wouldn't mind."
msgstr "<i>번거롭게 해드려</i> 대단히 죄송합니다만, 괜찮으시다면 부탁드릴게요. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Player
#. NodeID = cc918b0f-a72c-a079-450a-a22899727296
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:cc918b0f-a72c-a079-450a-a22899727296
msgctxt "h1839b487gaa83g4e47ga340gad099acda637"
msgid "You were attacked? Where?"
msgstr "공격받았다고? 어디서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = ccb1dc0e-4710-ea80-29dd-51b5fd23b2f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_FlirtyAtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:ccb1dc0e-4710-ea80-29dd-51b5fd23b2f9
msgctxt "ha0d5a3c9g7e23g4ffegb700ga5b4658f0080"
msgid "Are we waiting for Umberlee herself, or what? Let's <i>go.</i>"
msgstr "움버리라도 기다리는 거예요? 어서 <i>가자고요.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = cf709633-b637-cca1-3c09-5a721011b84c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingTieflingPrisoner = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:cf709633-b637-cca1-3c09-5a721011b84c
msgctxt "h697953ecg462dg433ega869g7add6ae2b848"
msgid ""
"I took a blow to the head, then woke up in this hellspit. Haven't seen "
"Zevlor since - he's cosying up with Ketheric for all I know."
msgstr ""
"머리를 한 대 맞고 깨어났더니 이 지옥 구덩이였어요. 그 뒤로 제블로어는 못봤고요. 아마 케서릭한테 환심을 사려 애쓰는 중이겠죠. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = d86eaa01-6fed-2db9-0549-5176d15a756c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_FlirtyTiefling(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:d86eaa01-6fed-2db9-0549-5176d15a756c
msgctxt "h8c56fb47ga31dg4373g9b33g6662e31a72b3"
msgid "You're our one shot at getting out of here - don't leave us behind."
msgstr "탈출의 유일한 희망이 바로 당신이에요. 제발 우릴 버리지 말아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = db5a3941-b09a-8aa5-2314-20f03336b70b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_FlirtyOutcast(1) = True
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:db5a3941-b09a-8aa5-2314-20f03336b70b
msgctxt "hdd10d2dag10f8g45f8g9862g485a14fb8a30"
msgid "Hey - don't go! Please!"
msgstr "이봐요, 가지 말아요! 제발!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = dbfdc08b-6c00-7d38-55b3-8500f1b6b783
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:dbfdc08b-6c00-7d38-55b3-8500f1b6b783
msgctxt "hd04a1189gd8f2g4946ga3efgc9776af833ef"
msgid ""
"Oh, thank the stars. When they disappeared into the darkness, my heart just "
"about stopped."
msgstr "별들이시여 감사합니다. 사람들이 어둠 속으로 사라졌을 때는, 심장이 멈추는 줄 알았어요. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = dc1fe40b-221e-5020-0b71-d494e57bc3f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:dc1fe40b-221e-5020-0b71-d494e57bc3f3
msgctxt "h5a772581ga855g48cagb28cg3bb3f2645119"
msgid "The cult got inside your head too?"
msgstr "교단이 당신도 세뇌한 건가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = e3e0e660-5a8f-4194-6374-d1d33aea858f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_FlirtyAtBoat(1) = False
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_FlirtyAtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:e3e0e660-5a8f-4194-6374-d1d33aea858f
msgctxt "hcc6497ffg4eefg42a2gb712gbc0e2b5e5403"
msgid "I swear, if we get caught now, after making it this far..."
msgstr "여기까지 왔는데, 붙잡힌다면 그땐 정말..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Player
#. NodeID = e54895c5-fa67-c8a7-1b6a-b9ccbfbe4c01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:e54895c5-fa67-c8a7-1b6a-b9ccbfbe4c01
msgctxt "h8195bf26gc938g4f47g9fbfg9065c1ac2832"
msgid "What happened with Zevlor?"
msgstr "제블로어는 어떻게 된 거지?\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = ef7e6754-5ce5-4d08-68f3-b9cd222ba8d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_FlirtyAtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_BoatLeader(0) = True
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:ef7e6754-5ce5-4d08-68f3-b9cd222ba8d5
msgctxt "h17a417aegca60g4ad2g99b3g7344ef196a21"
msgid "Hush up, will you? Go keep watch."
msgstr "조용히 좀 해 줄래요? 주변이나 경계해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Player
#. NodeID = f8050b7f-ca6f-1e46-82ec-1ad992a1ff23
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:f8050b7f-ca6f-1e46-82ec-1ad992a1ff23
msgctxt "ha4fed796g874cg47c3gb244g34667b167d65"
msgid "The gnomes have a plan to escape. We're going to get you out of here."
msgstr "노움들이 탈출 계획을 세웠어. 우리가 널 여기서 꺼내줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling
#. Speaker = Lakrissa
#. NodeID = fc32a2bd-bfc9-c5d2-6754-7da0d20d9373
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_FlirtyOutcast(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_FlirtyTiefling:fc32a2bd-bfc9-c5d2-6754-7da0d20d9373
msgctxt "h630a1731gc8a9g4b6cgbb1dge959702dfe45"
msgid ""
"Hey - the guards have gone stone mad. Get me out of here before they come "
"back, please!"
msgstr "이봐요, 경비들이 난리가 났다고요. 저들이 돌아오기 전에 제발 여기서 내보내줘요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001
#. Speaker = Nimble
#. NodeID = 27cc1dfc-fcf6-490d-962c-e99832753b41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Gnome001(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001:27cc1dfc-fcf6-490d-962c-e99832753b41
msgctxt "hd98f3a1cg979dg472cg8607g37c1c5278433"
msgid "Wulbren is the one you want, not I."
msgstr "울브렌과 얘기해, 나 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001
#. Speaker = Nimble
#. NodeID = 43374111-2e5f-c61e-c94f-3dc18ff57432
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Gnome001AtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001:43374111-2e5f-c61e-c94f-3dc18ff57432
msgctxt "h8d4e0e38gf933g4713ga331ga5c7ceb58b76"
msgid "Gods, go stand in the corner or something - it'd be more useful."
msgstr "제발 좀. 가서 구석에 서 있든가. 그게 차라리 도움이 되겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001
#. Speaker = Nimble
#. NodeID = 4d6f31d8-df05-01bd-688a-747d61b20cef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Gnome001AtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001:4d6f31d8-df05-01bd-688a-747d61b20cef
msgctxt "ha36585fbg5b7bg4ec7g992eg63c0ab08f166"
msgid ""
"See if you can speed this up, will you? The longer we're stuck here, the "
"greater the risk."
msgstr "속도 좀 내게 도와주는 게 어때? 여기 오래 박혀있다간 위험해지기만 할 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001
#. Speaker = Nimble
#. NodeID = 6872b74e-c9b0-5c46-0867-49b42516fa5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Gnome001AtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001:6872b74e-c9b0-5c46-0867-49b42516fa5a
msgctxt "hec1946d6g8330g451ega04dg28e7f4dbe22d"
msgid ""
"You know what doesn't help when you're frantically trying to untie a boat? "
"<i>Being bothered.</i>"
msgstr "묶여있는 배를 정신없이 풀고 있을 때 도움이 안 되는 짓이 뭐게? 이렇게 <i>귀찮게 구는 거.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001
#. Speaker = Nimble
#. NodeID = a1565603-d299-946b-1d78-2b6ceeb7b939
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Gnome001(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001:a1565603-d299-946b-1d78-2b6ceeb7b939
msgctxt "h7a41ad34g8638g4fd9g8e31g3b6cbc3bbe5d"
msgid ""
"Whatever Wulbren says? Do it. He's the only one who can get us out of here."
msgstr "울브렌이 하라는 대로 해. 우릴 여기서 빼낼 수 있는 사람은 그 친구뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001
#. Speaker = Nimble
#. NodeID = d8666352-24b1-b0f2-4018-fd2cb237918a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Gnome001AtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_001:d8666352-24b1-b0f2-4018-fd2cb237918a
msgctxt "h2879c35eg545dg4b9bg9f8cgc49d2a80811b"
msgid "That boat looks damn shaky - it had better hold us."
msgstr "대단히 불안하게 생긴 배인데. 부디 모두를 지탱해줬으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 30a7eac9-9bb8-07fe-9e5d-5f6c33b19500
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Gnome003AtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002:30a7eac9-9bb8-07fe-9e5d-5f6c33b19500
msgctxt "hbe1ed7bfga69cg4aefga84eg80fecb2dff06"
msgid ""
"Nimble said to close my eyes. But I can hear it - the stone is screaming."
msgstr "님블이 나더러 눈을 감으랬지. 그래도 돌이 비명을 지르는 소리는 들려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 33ece5c9-2bbf-e272-19c1-ebd3523f3af5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Gnome003AtBoat(1) = False
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Gnome003AtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002:33ece5c9-2bbf-e272-19c1-ebd3523f3af5
msgctxt "h4855d9e0g5a59g4fdfgbedbg32c509bd1142"
msgid "The stone says we must run! We must flee!"
msgstr "돌이 말하길 어서 뛰래! 도망쳐야 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 371675e2-889c-ee20-f611-44f1ef7e7651
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Gnome003AtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002:371675e2-889c-ee20-f611-44f1ef7e7651
msgctxt "h723d67e6g0af0g4f6fgae3dg8c59e56d6c7e"
msgid "Quiet. The rope is knotted tight - do not distract me."
msgstr "조용히 해. 밧줄이 아주 단단히 묶여있어. 날 방해하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 5141f7d1-a723-4a52-decc-03cfc53db8a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Gnome003AtBoat(1) = False
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Gnome003AtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002:5141f7d1-a723-4a52-decc-03cfc53db8a8
msgctxt "hfb3581bdge77bg47c8gaaa9ga722596f4779"
msgid "We - we have to get on the water. Wulbren said so. But I - I hate it."
msgstr "물로 가야만 해. 울브렌이 그렇게 말했거든. 정말 싫지만 어쩔 수 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = 9d5fcd39-6931-4e1b-10bd-6022210ce112
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Gnome003(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002:9d5fcd39-6931-4e1b-10bd-6022210ce112
msgctxt "hd77b76a5g5683g468bg92d4g0bca8717b8f1"
msgid "The walls were made with blood and pain. They hate it."
msgstr "이 벽은 피와 고통으로 만들어졌어. 아주 싫어하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = a00563dd-23a6-425b-bf66-c46f9b086bb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Gnome003(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Gnome003(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002:a00563dd-23a6-425b-bf66-c46f9b086bb7
msgctxt "hfcca61dcg31b2g448bg995fgbbd379cd435d"
msgid "Can you hear it crying? The stone... it's broken."
msgstr "이 울음 소리가 들려? 돌이... 망가져 있어. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = f12a8c37-a873-5370-a03c-1389e2970b64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Gnome003AtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002:f12a8c37-a873-5370-a03c-1389e2970b64
msgctxt "hdf8b9d3ag2774g4885gbb37g170ff54977ec"
msgid "Moonrise awakens - keep your eyes sharp, and away from me."
msgstr "문라이즈가 깨어난다. 정신 바짝 차리고 있어. 나한테선 좀 떨어지고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002
#. Speaker = Nickels
#. NodeID = fe221b28-8796-960c-f0ca-5477109c9c04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Gnome003AtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_GnomePrisoner_002:fe221b28-8796-960c-f0ca-5477109c9c04
msgctxt "h8bc9a43dgbc44g4556g8c89g14c26f65de36"
msgid "The stone is in pain. We have to <i>go.</i>"
msgstr "돌이 고통에 휩싸여있어. 어서 <i>떠나야만 해.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Guard_002
#. Speaker = Adept Keris
#. NodeID = 177e1128-a686-e147-6bc8-b5aeb7acac44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Guard_002:177e1128-a686-e147-6bc8-b5aeb7acac44
msgctxt "h01699c39gd0f6g4434gb6acg8c126fb0983b"
msgid ""
"Don't get chatty with the prisoners, mind you. The Warden won't like that."
msgstr "말해두는데 죄수들과 이야기하지 마. 간수장이 안 좋아 할 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Guard_002
#. Speaker = Adept Keris
#. NodeID = 7e756fd7-8ac1-4b7e-945f-84d0bb05ade5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Guard002(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Guard002(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Guard_002:7e756fd7-8ac1-4b7e-945f-84d0bb05ade5
msgctxt "h3d04dc74ga597g4e33gbeecgd7325c26d14c"
msgid ""
"Did you request this post too? I'm glad I got the Warden and not Z'rell."
msgstr "너도 이 근무지를 요청한 거야? 즈렐이 아니라 간수장 밑에서 일해서 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Guard_002
#. Speaker = Adept Keris
#. NodeID = f9ee7c72-29ef-6e23-eadb-8c4b94e2cd7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Guard002(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Guard_002:f9ee7c72-29ef-6e23-eadb-8c4b94e2cd7e
msgctxt "hb2111b1dgc55dg4fccgb4fcg3e5b9a686cc2"
msgid "You remind me a little of the Warden. Such <i>gravitas.</i>"
msgstr "넌 간수장님을 떠올리게 하는군. 그 <i>위엄</i> 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Guard_004
#. Speaker = Zealot Nadi
#. NodeID = 14efddb8-f759-4e94-8b5a-b9b9a42d89be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Guard004(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Guard004(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Guard_004:14efddb8-f759-4e94-8b5a-b9b9a42d89be
msgctxt "h87e0714dgf039g43cbg81a1g7b5ed579abe1"
msgid "Don't speak to the prisoners. The Absolute forbids it."
msgstr "죄수들에게 말 걸지 마라. 절대자께서 금지하시니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Guard_004
#. Speaker = Zealot Nadi
#. NodeID = 913f8e1c-b678-159d-f711-a972f2673cac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Guard004(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Guard_004:913f8e1c-b678-159d-f711-a972f2673cac
msgctxt "ha9f5eb73g474fg4db2gaf59g0dc8e04568cf"
msgid "The Warden runs this place like clockwork. Do <i>not</i> fall behind."
msgstr "간수장께서는 이곳을 매우 빡빡하게 관리하신다. 뒤쳐지지 <i>않도록</i> 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 0ad1b70f-94aa-f1a6-0414-f9d468cf9d7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:0ad1b70f-94aa-f1a6-0414-f9d468cf9d7d
msgctxt "hae55e766gc1ffg4d08g96fega148b978d99f"
msgid "...Bex is alive? Oh, thank the gods. Thank you."
msgstr "...벡스가 살아있다고요? 오, 신이시여. 감사합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 0d2b3a92-953a-4e7f-3800-aad6149cd78a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#.   Object:
#.      - MOO_Jailbreak_State_PlayerInTieflingCell(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_LoverOutcast(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:0d2b3a92-953a-4e7f-3800-aad6149cd78a
msgctxt "h32fe7f69gcf55g40ffg9c72ge0beb7f4e51e"
msgid "Something's happening. Please, don't leave me in here. Please!"
msgstr "뭔가 일어나고 있어. 제발, 날 버리지 마. 부탁이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 0daba623-06ec-1d9c-67d4-75e45c3098dc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingTieflingPrisoner = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:0daba623-06ec-1d9c-67d4-75e45c3098dc
msgctxt "h1ad61de9g88bdg4821g8862g11c4ad3c5675"
msgid ""
"I haven't seen Zevlor since. Part of me wonders if he was with them all "
"along."
msgstr "그 이후로는 제블로어를 만나지 못 했어요. 그가 처음부터 놈들과 한 편은 아니었던지 의심이 가더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 0db3734f-39ae-82bc-ea91-adf367201b11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:0db3734f-39ae-82bc-ea91-adf367201b11
msgctxt "h434c2bbdg53e7g4d43g9739g6885f0b76c53"
msgid "We're dead if we don't get out of here."
msgstr "탈출하지 못 하면 우린 죽은 목숨이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 0eb74835-19c3-8272-2bd8-0f0ea4043aa8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingTieflingPrisoner = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:0eb74835-19c3-8272-2bd8-0f0ea4043aa8
msgctxt "h0103a27bg39a7g4044g8630ged29ffae7af1"
msgid ""
"We're dead if we don't get out of here. I can't believe Zevlor wanted us to "
"go with these zealots."
msgstr "여길 벗어나지 못 하면 우린 죽고 말 거예요. 이 광신도들을 따라가게 하다니, 제블로어는 대체 무슨 생각인건지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 14ee8ba9-c20e-14e8-7fc6-986af71b0de4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Hopeful(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_PlayerInTieflingCell(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:14ee8ba9-c20e-14e8-7fc6-986af71b0de4
msgctxt "h1f267503ge789g461bgb092gc59c3a056a0f"
msgid ""
"I keep closing my eyes and praying I'll wake up somewhere else - anywhere "
"else."
msgstr "눈을 감고 다른 곳에서 깨어나게 해달라고 기도하곤 해. 어디든 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 15c904d2-bd21-67a7-5209-7a70f57bc187
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = True
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingTieflingPrisoner = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:15c904d2-bd21-67a7-5209-7a70f57bc187
msgctxt "haac66c19g6ac7g4614ga51fgae574ff4048d"
msgid ""
"Zevlor wanted us to surrender - to these <i>maniacs</i>. A fight broke out, "
"and... well, I'm glad Bex runs quicker than I do."
msgstr ""
"제블로어가 이 <i>미치광이</i>들을 상대로 항복하라더군요. 그리고 나서 싸움이 벌어졌고 그 다음에는... 벡스가 저보다는 발이 빨라서 "
"다행이었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 18cebb25-5a49-269b-8a16-2da27211ae5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:18cebb25-5a49-269b-8a16-2da27211ae5d
msgctxt "he306702fga976g401ag9eebg16adb7951b98"
msgid "If she's not here then the curse..."
msgstr "그녀가 여기 없다는 건 저주가..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 1c7b29de-a4ad-b8d3-eb99-73271ca0d2b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:1c7b29de-a4ad-b8d3-eb99-73271ca0d2b5
msgctxt "h94672382g5777g44a6gbc0dgf4f20b7ff698"
msgid "I was."
msgstr "그래 맞아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 1dc09fba-f9ad-256d-6841-94f096e7f5d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_LoverOutcast(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:1dc09fba-f9ad-256d-6841-94f096e7f5d1
msgctxt "hc643a09dga5f5g4d47g8d6bg4c813a2e1956"
msgid "Something's happening. Please, don't leave me in here. Please!"
msgstr "뭔가 일어나고 있어. 제발, 날 버리지 마. 부탁이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 1f09fb88-89c4-5a59-95ce-a27792d0a755
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_Knows_BexInHaven = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:1f09fb88-89c4-5a59-95ce-a27792d0a755
msgctxt "hafec0754g8e19g4305gaa2dg8a248fa356f5"
msgid "Who?"
msgstr "누구?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 1f818297-99c5-3d70-4351-e64df24a52a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_LoverAtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:1f818297-99c5-3d70-4351-e64df24a52a7
msgctxt "h1be31dc6g2fceg4082gb2c3g9a657e9448cf"
msgid "Hold on - this thing is in <i>knots.</i>"
msgstr "기다려 봐. 이건 <i>매듭지어져</i> 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 225ac035-1f78-d8e8-7423-5e50a7c92b25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:225ac035-1f78-d8e8-7423-5e50a7c92b25
msgctxt "h47e46b52gb98dg41d4g8920g5a64a600ef6b"
msgid ""
"Yes! I was with Bex in the grove. We talked getting a house in Baldur's "
"Gate. Have you seen her?"
msgstr "맞아요! 벡스랑 같이 숲에서 발더스 게이트에서 집을 구한다는 이야기를 하고 있었죠. 혹시 그녀를 보셨나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 2827ec1b-f889-42be-9785-ceff5daeef30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_SadLover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:2827ec1b-f889-42be-9785-ceff5daeef30
msgctxt "haaa1498age02cg4ab4ga545gfb937b02a977"
msgid ""
"All I wanted was a little house in Baldur's Gate with Bex. Not this. Not any "
"of this."
msgstr "내가 원했던 건 발더스 게이트의 조그만 집에서 벡스와 함께 지내는 거였어. 이게 아니라. 이런 게 아니었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 2d1720c7-c60c-ff8c-6666-2ed76f17faec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:2d1720c7-c60c-ff8c-6666-2ed76f17faec
msgctxt "h17a59891g45dbg47efgac14g3489d8ad76e6"
msgid "Get the hells away from me!"
msgstr "내 앞에서 썩 꺼져!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 324f3183-056f-4a47-c1fa-1b3a460cda6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_SadLover(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_PlayerInTieflingCell(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:324f3183-056f-4a47-c1fa-1b3a460cda6d
msgctxt "h3c669839g503ag4ebdga944ge6de0e085671"
msgid ""
"All I wanted was a little house in Baldur's Gate with Bex. Not this. Not any "
"of this."
msgstr "내가 원했던 건 발더스 게이트의 조그만 집에서 벡스와 함께 지내는 거였어. 이게 아니라. 이런 게 아니었다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 3c71db21-5f31-ea02-0114-e4fb9f971a4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:3c71db21-5f31-ea02-0114-e4fb9f971a4c
msgctxt "hfe678decgdc4dg41fdg87a3gc91e7a47d992"
msgid "Shouldn't you be worrying about yourself?"
msgstr "자기 걱정이나 하는 게 낫지 않나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 3cf850db-8a09-2cc1-385d-727cb8ae5b7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:3cf850db-8a09-2cc1-385d-727cb8ae5b7f
msgctxt "hc9eb593cg883dg4458gb8bdg742c4f50e889"
msgid "After Zevlor, I'm second-guessing everyone."
msgstr "제블로어 이후로 모두를 의심하게 됐어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 440aa960-f55b-c8bb-8446-717e3501ac6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:440aa960-f55b-c8bb-8446-717e3501ac6a
msgctxt "h754a2e18gb11ag4171ga38eg34e068064c0a"
msgid "Please, she must be here - in another cell or something."
msgstr "제발, 그녀가 여기 어딘가에 있는 게 분명하다구요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 45613591-19c3-908f-a11c-24c85797d637
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_PlayerInTieflingCell(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Lover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:45613591-19c3-908f-a11c-24c85797d637
msgctxt "hcf490673g1ecdg4a6dgba94g949b78f7c3b9"
msgid "Hey! You were in the grove, right?"
msgstr "이봐요! 당신 에메랄드 숲에 있었죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 478b0ca2-4962-d6e2-167f-6573154cf325
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:478b0ca2-4962-d6e2-167f-6573154cf325
msgctxt "hf3564919g7058g4f71gab54g9afb43e8e59a"
msgid ""
"<i>Bex.</i> She was with me in the grove. If she's not here then the curse..."
msgstr "<i>벡스</i>. 숲에서 저와 함께 있던 여자요. 만일 그녀가 여기 없다면 저주가..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 48a1e640-877d-7a90-142d-5a9532859054
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_LoverAtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:48a1e640-877d-7a90-142d-5a9532859054
msgctxt "h90bfaacbg3871g49ccg8965gbbaa1e8024ce"
msgid "The more you interrupt, the longer this will take."
msgstr "네가 방해할수록 더 오래 걸릴 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 4ce264e3-6d34-d1bc-41aa-a44c4502a4ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:4ce264e3-6d34-d1bc-41aa-a44c4502a4ac
msgctxt "h7e8d5a4aga58bg41a8g8bb5g986cefbf54bc"
msgid "Whatever the plan, I'll do it. Anything to leave this place."
msgstr "계획이 뭐든 간에, 저도 할게요. 이곳을 벗어날 수만 있다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 4d280cb9-228d-ad10-281f-573b0ab90498
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:4d280cb9-228d-ad10-281f-573b0ab90498
msgctxt "h53fb486fgd85bg427cgb5cbgdfbb1b6f50f5"
msgid "No talking, prisoner."
msgstr "입 다물어, 죄수."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 4f0ff3c8-6263-3e80-b2bc-c847700e4043
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:4f0ff3c8-6263-3e80-b2bc-c847700e4043
msgctxt "h6728399cg3e99g4be9gafb3gb3039555cde6"
msgid "After the attack, I'm second-guessing everyone."
msgstr "그 습격 이후로, 모두를 의심하게 됐어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 4fd7a707-55d3-1dc3-753f-c7afef91cc49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:4fd7a707-55d3-1dc3-753f-c7afef91cc49
msgctxt "hc1d4f8f5g580fg41fcgb039g7a330d1d74fc"
msgid ""
"There was screaming - a fight broke out, I think. Last thing I remember is "
"waking up in this place."
msgstr "비명이 울려퍼지고 - 싸움이 벌어지는 것 같더니. 정신을 차리니까 여기서 눈을 뜬 상태였고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 50260c9e-304f-cba0-800d-acc9d691a210
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_Knows_BexInHaven = True
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:50260c9e-304f-cba0-800d-acc9d691a210
msgctxt "hd750224eg430cg4872g96e7g0dde1f55d03e"
msgid "I'm the only other tiefling here."
msgstr "여기서 발견한 티플링은 나 밖에 없는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 520bfc03-1c67-77ec-2bc9-e18040bb75ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:520bfc03-1c67-77ec-2bc9-e18040bb75ff
msgctxt "hfb32c9dbg38b0g4295g9004g56346d00cea2"
msgid "When I woke up and she wasn't here I thought the worst."
msgstr "정신을 차렸을 때 그녀가 없기에, 죽은 줄만 알았어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 5402acd7-2d78-436b-d99f-bb24f1ea8744
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_AngryLover(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_PlayerInTieflingCell(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:5402acd7-2d78-436b-d99f-bb24f1ea8744
msgctxt "hef6c1daege98eg42a2gb33cg3b914dbde68f"
msgid "Let us die in peace."
msgstr "우리가 편히 죽도록 내버려 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 58ee4204-0abb-c0d8-211e-db56d60f2a3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:58ee4204-0abb-c0d8-211e-db56d60f2a3c
msgctxt "ha2472204g929eg4d34g98c7gcdb66a3ed5a5"
msgid "She got away? Oh, thank the gods. Thank you. I was sure the curse..."
msgstr "그녀가 멀쩡하다고요? 아, 신이시여 감사합니다. 당신도요. 전 혹시 저주가 그녀를..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 5a3d2f25-a51e-61c7-b84d-1a73c0a3ce54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:5a3d2f25-a51e-61c7-b84d-1a73c0a3ce54
msgctxt "h90344eabgbeb9g4befgae76gfdb1599fd005"
msgid ""
"Please - there's no one else. They've been dragging us away, one by one. And "
"the ones they take... they don't come back."
msgstr "부탁해요, 달리 사람이 없어요. 저들이 우릴 하나씩 끌고 간다고요. 그리고 끌려간 사람들은... 돌아오지 않아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 5bee0c85-fe0f-1199-2be7-8fb9fc105d0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_TieflingLeader(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Lover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:5bee0c85-fe0f-1199-2be7-8fb9fc105d0f
msgctxt "hb22a1026g4d29g4987g9d64g9ece39cf0e5f"
msgid "I know you - you're from the grove."
msgstr "당신을 알아요, 숲에 있었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 5cac1ef7-203d-155c-8858-159ba7a74cbe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Lover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:5cac1ef7-203d-155c-8858-159ba7a74cbe
msgctxt "h6be40104gb330g4488ga421g51d7aa21ead9"
msgid "Hey! You were in the grove, right?"
msgstr "이봐요! 당신 에메랄드 숲에 있었죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 5d61cea9-7720-4f82-ae4b-ecc9986bab60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Hopeful(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:5d61cea9-7720-4f82-ae4b-ecc9986bab60
msgctxt "h821b6b78g370eg4f2dg8091g7a4d009f0fbc"
msgid ""
"I keep closing my eyes and praying I'll wake up somewhere else - anywhere "
"else."
msgstr "눈을 감고 다른 곳에서 깨어나게 해달라고 기도하곤 해. 어디든 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 5e12e1da-033a-9279-c54e-fb60cb71259b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_AngryLover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:5e12e1da-033a-9279-c54e-fb60cb71259b
msgctxt "hf582ae33g50e4g47b2ga902g32adb0010be0"
msgid "Let us die in peace."
msgstr "우리가 편히 죽도록 내버려 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 618d41f7-59ab-a78a-92c3-be76e31035fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:618d41f7-59ab-a78a-92c3-be76e31035fc
msgctxt "h0912cb97ga903g4ee0ga7e8gd85172fed7b8"
msgid "I met the other tieflings at Last Light Inn. Maybe she's there?"
msgstr "최후의 빛 여관에서 다른 티플링들을 만나긴 했는데. 거기에 있을지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 61ca0c8d-9966-78ce-737b-186427087617
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:61ca0c8d-9966-78ce-737b-186427087617
msgctxt "hc4e2580bg0381g4d26gbd07gcc5b33dff632"
msgid ""
"They got away? They actually made it? Oh, thank the gods. She must be with "
"the others - she <i>must. </i>"
msgstr "그들이 무사하다고요? 정말로요? 아, 신들이시여 감사합니다. 그녀도 그들과 함께 있는 게 분명해요. <i>반드시요. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 62d402af-390f-7aed-456d-025467982724
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:62d402af-390f-7aed-456d-025467982724
msgctxt "h4457c8c1gc587g4973g89f7g3d07142eeb4b"
msgid "Blessed gods - you were with the Absolute this whole time."
msgstr "신이시여. 당신이 내내 절대자의 편이었다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 6da4b404-943e-3d03-b881-60245ddd40e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:6da4b404-943e-3d03-b881-60245ddd40e3
msgctxt "he6e82219g04cfg44e3gac53gfacdc5c6a6db"
msgid "The gnomes have a plan to escape. We're going to get you out of here."
msgstr "노움들이 탈출 계획을 세웠어. 우리가 널 여기서 꺼내줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 707c247c-ce73-6262-423b-250972bee1d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:707c247c-ce73-6262-423b-250972bee1d6
msgctxt "h9644e16dge630g41e9gac54gaaaef7bf4412"
msgid "Wait! I'm sorry - I'm sorry."
msgstr "잠깐만요! 미안해요. 정말 미안해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 720d5c16-06f9-225b-75ef-bd70af739199
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:720d5c16-06f9-225b-75ef-bd70af739199
msgctxt "hb84ce415g8f97g4aceg9effgb517a4daf37d"
msgid "Thank you - a thousand times, thank you."
msgstr "감사합니다. 천 번도 더 감사해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 72135dc1-077d-89ca-50e8-cf099e70c3a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_Knows_BexInHaven = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:72135dc1-077d-89ca-50e8-cf099e70c3a1
msgctxt "h7a378849gb76cg4e34gac5ega63547e52808"
msgid "She's at Last Light Inn with the others - she's safe."
msgstr "그녀는 다른 사람들과 함께 최후의 빛 여관에서 안전하게 머무는 중이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 737a4a52-808f-9a7b-76dd-858e64a57833
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_AngryLover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:737a4a52-808f-9a7b-76dd-858e64a57833
msgctxt "hc75053d4gc517g40adga7bagaebf7d65fbe6"
msgid "I have better things to do. Get out of here your damn self."
msgstr "난 할 일이 있어. 네놈 알아서 탈출하라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 73846905-3f55-fffa-07fe-06ae6ae916b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_LoneLover_Knows_BexInHaven = False
#.   Tag:
#.      - TIEFLING(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:73846905-3f55-fffa-07fe-06ae6ae916b1
msgctxt "hade39e76g40b4g4779g98b6gf5e7cb54af94"
msgid "You're the only tieflings here."
msgstr "여기 있는 티플링은 네가 유일해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 753d50ca-a680-4d5e-6d96-350b25211dac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = False
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Knows_SpeakWithGnomes = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:753d50ca-a680-4d5e-6d96-350b25211dac
msgctxt "hc7b9d1e6g4876g47a6g89b5gaae1f5a63c5d"
msgid ""
"I've heard whispers from the gnomes - their cell is a few doors down. The "
"sound of rock on rock too. If anyone can break us out, it's gnomes."
msgstr ""
"노움들이 속삭이는 걸 들었어요. 가까운 곳에 수감되어 있거든요. 돌끼리 부딪히는 소리도 들었죠. 혹시 탈출할 기회가 생긴다면, 그건 "
"노움들 덕일 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 77390a93-ae75-f4ea-1ecb-093f438cf2b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_PlayerInTieflingCell(1) = True
#.      - MOO_Jailbreak_State_TieflingLeader(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Lover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:77390a93-ae75-f4ea-1ecb-093f438cf2b3
msgctxt "hb0629175g767eg4465gadf8g17f18946cdc2"
msgid "I know you - you're from the grove."
msgstr "당신을 알아요, 숲에 있었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 79cf2681-426f-1e38-ff1f-faac0cc0ef96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:79cf2681-426f-1e38-ff1f-faac0cc0ef96
msgctxt "h977de182g8966g4bb1g92afg1350eac00804"
msgid "You mean she's not in Moonrise? Then the curse..."
msgstr "그녀가 문라이즈에 없다고요? 그렇다면 설마 저주가..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 86aba5f1-61e9-1816-4850-470d944b4214
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:86aba5f1-61e9-1816-4850-470d944b4214
msgctxt "h1cc8fe6fgaca3g4da6g904ag878ebc32d613"
msgid "Must I save you? <i>Again?</i>"
msgstr "내가 널 구해야 하나? <i>이번에도?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 8755c1a0-92ac-68c1-711a-dc5ed4e30eb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:8755c1a0-92ac-68c1-711a-dc5ed4e30eb3
msgctxt "h3f6b924cgc183g4406gaddage5a797981721"
msgid ""
"But you're a traitor - probably been from the start. Get the hells away from "
"me."
msgstr "당신은 배신자야. 아마 처음부터 그랬겠지. 내 앞에서 꺼져."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 882bcf7e-d9b7-d4da-0acb-44bd71508938
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:882bcf7e-d9b7-d4da-0acb-44bd71508938
msgctxt "h2d6e2c43gab02g4c98gb36ag3926e9fc3a23"
msgid ""
"When the necromancer comes for us, make him take me, all right? Just leave "
"her alone - <i>please.</i>"
msgstr "사령술사가 우리들을 데리러 올 때, 절 데려가게 해주세요. <i>제발</i> 그녀만은 무사하도록이요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 8900b2f7-e56d-e925-7675-eff5ffddf8ab
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Hopeful(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:8900b2f7-e56d-e925-7675-eff5ffddf8ab
msgctxt "h059419aagf4fag4ef7g925dgf0052d2542d9"
msgid "Look, tell her to go to Baldur's Gate. I'll... I'll meet her there."
msgstr "그녀에게 발더스 게이트로 향하라고 전해주세요. 그곳에서... 그곳에서 만나자고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 89189dd6-2265-9e83-dec5-a5a0559d25a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:89189dd6-2265-9e83-dec5-a5a0559d25a3
msgctxt "hd5b6607cg688bg4002ga1f3g7ecae07ef7a3"
msgid "...I thought I could trust you. We all did."
msgstr "...당신은 믿을만하다고 생각했는데. 우리 모두."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 8d3982eb-857d-83cc-25c3-27685f4364a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_AngryLover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:8d3982eb-857d-83cc-25c3-27685f4364a3
msgctxt "h1e13fec4g13a4g4b8agbd6fgc905886cd962"
msgid "Yes. Enjoy rotting in your cell."
msgstr "맞아. 감옥에서 즐겁게 썩어가라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 8f79e130-5e3f-55a6-cf9b-a610f6870bea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:8f79e130-5e3f-55a6-cf9b-a610f6870bea
msgctxt "h09da69e4g4cdeg4ef2gbbb5g7d05355e6a97"
msgid "What does it matter? You'll never see her again."
msgstr "그녀가 어디 있던 무슨 상관이지? 어차피 다시 보지도 못 할 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 90cfdfe2-b3a0-f593-ad37-bf24e3db2c3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_LoverAtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:90cfdfe2-b3a0-f593-ad37-bf24e3db2c3c
msgctxt "hdff48cafg36a1g4492gbdfeg10e33fc52650"
msgid "I can't take this - we need to go."
msgstr "더는 못 참겠어. 어서 떠나야만 해. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 95383bd6-f811-e49c-2427-404db25a751d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:95383bd6-f811-e49c-2427-404db25a751d
msgctxt "hb16bf1fdg69b3g4e43g8445gdc870b9f8180"
msgid "Maybe. Maybe not."
msgstr "그럴지도. 아닐 지도 모르고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 95ca06c3-09c3-9e90-9dd0-5197cf221acc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:95ca06c3-09c3-9e90-9dd0-5197cf221acc
msgctxt "ha90321dbg9afbg42a2g80c4gfe301bcbd5e4"
msgid "Thank the gods - after Zevlor I'm second-guessing everyone."
msgstr "신이시여 감사합니다. 제블로어 이후로 모두를 의심하게 됐어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 9c6faad3-f952-60f0-2180-f5e7d01c1eeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:9c6faad3-f952-60f0-2180-f5e7d01c1eeb
msgctxt "h471bf878g91cdg4b92gb8e7g7b3594cd9f3f"
msgid "What happened with Zevlor?"
msgstr "제블로어에게 무슨 일이라도 있었나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = 9dc89241-b5b1-cad8-f60c-ffde613a0e44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_LoverOutcast(1) = True
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:9dc89241-b5b1-cad8-f60c-ffde613a0e44
msgctxt "h6aac526ag73f1g4b67gb2b8gcb978dd0731a"
msgid "The guards will kill me if you don't get me out - please!"
msgstr "날 꺼내주지 않으면 경비들이 날 죽일 거라고, 제발!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = 9fb2b8cb-58cf-fc23-1772-b893094170e1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:9fb2b8cb-58cf-fc23-1772-b893094170e1
msgctxt "hfeec5a57g5c12g49bfgae7ag4c5e0c1e5531"
msgid ""
"Accuse me of being with the Absolute again, and I'll leave you here to die."
msgstr "한 번만 더 날 절대자 편이라고 모함하면, 네가 여기서 죽도록 내버려두겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = a2f7e783-8368-268f-e917-d6ee3b27936a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SadLover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:a2f7e783-8368-268f-e917-d6ee3b27936a
msgctxt "h0fabb9a0gb556g45d8gaf7bgc2a35480e7b2"
msgid "I'm sorry, Bex. I'm so sorry."
msgstr "미안해, 벡스. 정말 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = a50626e4-d5da-fcef-c2e4-08ff88178eb0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SadLover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:a50626e4-d5da-fcef-c2e4-08ff88178eb0
msgctxt "h097a5927g6ce4g4f13g989ag36448ee29188"
msgid ""
"...I know. If - when the necromancer comes for us, tell him to take me "
"first. Spare the others - please."
msgstr ""
"...저도 알아요. 만일 - 사령술사가 우릴 데리러 온다면, 부디 그에게 절 첫 번째로 데려가 달라고 말해주세요. 다른 이들은 무사할 수 "
"있도록 - 제발요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = a6c028c1-c4e7-9891-01df-611f9b492b99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:a6c028c1-c4e7-9891-01df-611f9b492b99
msgctxt "h4c0043e8g8b43g448ag9f3bg8dcf43a23224"
msgid "How did you end up in here?"
msgstr "어쩌다 여기에 갇힌거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = ad93b868-186f-9ac8-fbb1-965911c8aa30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:ad93b868-186f-9ac8-fbb1-965911c8aa30
msgctxt "h22548e81g1f17g40d4g90edg458ca0c70b30"
msgid "You were! I remember you."
msgstr "있었잖아요! 다 기억 한다고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = af817ecd-c8e6-a7aa-b171-24ac51f75ea8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:af817ecd-c8e6-a7aa-b171-24ac51f75ea8
msgctxt "he687299cgb331g4806ga08dg26de52a51497"
msgid ""
"The cultists ambushed us out in the darkness. They butchered half of us - "
"just to make a point."
msgstr "광신도들이 갑자기 나타나 우릴 기습하더니, 우리 중 절반을 도륙했죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = b0a0d481-935b-dbb0-7a24-8e3af1f5ad5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:b0a0d481-935b-dbb0-7a24-8e3af1f5ad5b
msgctxt "ha9413b82g3539g494dga924g158304232acf"
msgid ""
"Please - have you seen Bex? Dark hair, golden eyes - is she in another cell? "
"Is she all right?"
msgstr "맙소사 - 혹시 벡스를 보셨나요? 검은 머리에, 금빛 눈동자인데 - 혹시 다른 감방에 있나요? 무사하긴 한가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = b3b94736-6273-97d3-672c-9655809e42d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:b3b94736-6273-97d3-672c-9655809e42d0
msgctxt "h4ed3a909gad7cg4300gb495g3c475f792c18"
msgid "Oh gods, Bex."
msgstr "오 맙소사, 벡스."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = bc359e29-c30e-2300-4d66-bb8b3658213d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:bc359e29-c30e-2300-4d66-bb8b3658213d
msgctxt "h2522f0d5g9a45g4cc2ga184g79854f199b64"
msgid "I'm next - I know it. Don't let him take me."
msgstr "제가 다음 차례에요. 전 알아요. 절 끌려가게 두지 마요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = bda03770-e053-57fc-16c3-4f4ce42a248f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_LoverOutcast(1) = True
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#.   Object:
#.      - MOO_Jailbreak_State_PlayerInTieflingCell(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:bda03770-e053-57fc-16c3-4f4ce42a248f
msgctxt "h571506dage9f5g4566g8737ge8644b9bc2b9"
msgid "The guards will kill me if you don't get me out - please!"
msgstr "날 꺼내주지 않으면 경비들이 날 죽일 거라고, 제발!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = bf61784c-01db-44b9-2b0e-c30bc0d2a405
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:bf61784c-01db-44b9-2b0e-c30bc0d2a405
msgctxt "hfa1faf8agb853g4915gbd14gb97cf2a38efd"
msgid "If she's not here, she must be dead."
msgstr "여기 없다는 건, 죽었다는 소리겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = c4c30e75-9b93-6677-b68d-d4caefa718e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = True
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:c4c30e75-9b93-6677-b68d-d4caefa718e7
msgctxt "hc9c4c601gf796g4c16gbf72g21f60bad1aab"
msgid "A fight broke out, and... well, I'm glad Bex runs quicker than I do."
msgstr "싸움이 벌어졌고, 그리고 나서는... 벡스가 저보다는 발이 빨라서 다행이었죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = cb59479f-542f-28ec-4495-b69b2de9b2e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_LoverAtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:cb59479f-542f-28ec-4495-b69b2de9b2e0
msgctxt "h66de06bag9fecg4086g8fe9gcd855d0e5e63"
msgid "Can we please hurry this up?"
msgstr "좀 더 서두를 순 없을까요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = cbe17958-5ba2-b040-2e64-177f43ce8f6f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_AngryLover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:cbe17958-5ba2-b040-2e64-177f43ce8f6f
msgctxt "hc1380989gbefcg47fcgb383ga34946f7fbac"
msgid ""
"You were lying this whole time, weren't you? Helped us out from under the "
"heel of the druids so we could be slaves for your cult."
msgstr "여태껏 우릴 속였군요? 드루이드에게서 벗어나는 걸 도와주고 당신네 종교의 노예가 되게 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = d125b620-f255-648f-e2bb-83c9e48022d7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:d125b620-f255-648f-e2bb-83c9e48022d7
msgctxt "h3eed86c9g668eg4d7aga06bg42bdb6950afe"
msgid "I'm not with the cult, I swear - I'm here to help."
msgstr "난 맹세코 사교도 편이 아니야. 도우러 왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = d24f2a55-fd02-605e-df3a-2534f45b8e8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:d24f2a55-fd02-605e-df3a-2534f45b8e8a
msgctxt "hefe4ada9gc0feg47c7g8317gc41d76a8e565"
msgid "Don't worry, I'm going to get you out of here."
msgstr "걱정 마. 여기서 꺼내줄 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = d30d94d7-5ad4-d989-f12c-5a298350d815
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingTieflingPrisoner = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:d30d94d7-5ad4-d989-f12c-5a298350d815
msgctxt "ha3572b26g4c24g46ddgbb67gfca028a5148d"
msgid ""
"Zevlor wanted us to surrender - to these <i>maniacs</i>. Last thing I "
"remember is waking up in this place."
msgstr "제블로어가 이 <i>미치광이</i>들에게 항복하라더군요. 그리고 정신을 차려보니 여기서 눈을 뜬 상태였고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = d5c397f4-ec08-eac5-953e-557727dffda3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Lover(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:d5c397f4-ec08-eac5-953e-557727dffda3
msgctxt "h9c815026gdfa9g4384gaedfgd95b20534a0f"
msgid "Don't leave us here - <i>please.</i>"
msgstr "우릴 여기에 내버려두지 마. <i>제발.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = dae30e2a-e5b4-7bd7-84a1-81c7ecc7449a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_YoungLovers_State_MetPlayer = True
#.      - HAV_LoneLover_Knows_BexInHaven = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:dae30e2a-e5b4-7bd7-84a1-81c7ecc7449a
msgctxt "h0c8214c2g0427g470cgb604g1d7fcc4d97df"
msgid "I remember you - Danis, right?"
msgstr "기억나는군. - 이름이 다니스였나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = e43dc665-7ea9-c421-0e21-5ceb86608432
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = True
#.      - HAV_Area_State_BarrierIsOff = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:e43dc665-7ea9-c421-0e21-5ceb86608432
msgctxt "hd6477de3gcb4dg4eaeg8297g8f50e8b56253"
msgid "Shh. The other tieflings sent me - they're safe."
msgstr "조용. 다른 티플링들이 날 보냈다 - 그들은 안전한 곳에 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Danis
#. NodeID = ed4b6a66-7fa2-92fb-0dc9-9d204cc0e976
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Lover(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_PlayerInTieflingCell(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:ed4b6a66-7fa2-92fb-0dc9-9d204cc0e976
msgctxt "hf8970d6cg65e2g4ee4g81ecg93bd12e8ea3f"
msgid "Don't leave us here - <i>please.</i>"
msgstr "우릴 여기에 내버려두지 마. <i>제발.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover
#. Speaker = Player
#. NodeID = ff34ef25-892a-f78f-1898-770c40561c5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Lover:ff34ef25-892a-f78f-1898-770c40561c5c
msgctxt "hca85d071gc416g4a49g97c5gbc666c85111b"
msgid "I haven't seen Bex."
msgstr "벡스는 못 봤는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = b3136808-a1b7-48e9-a661-9ed754611a58
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:b3136808-a1b7-48e9-a661-9ed754611a58
msgctxt "h9f29b24eg7c42g4854gb359g2117cc80da2a"
msgid "That smell... Despair, desperation - prisoners!"
msgstr "저 냄새... 절망과 절박함이라, 포로들이로군!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = b3136808-a1b7-48e9-a661-9ed754611a58
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:b3136808-a1b7-48e9-a661-9ed754611a58
msgctxt "h28e50412g6570g4772g80b4gc1444f566848"
msgid ""
"The stench, the filth... gods, what a horror to be imprisoned in such a "
"place."
msgstr "악취에 오물까지... 세상에, 이런 곳에 수감된다는 건 그야말로 공포 그 자체겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = b3136808-a1b7-48e9-a661-9ed754611a58
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:b3136808-a1b7-48e9-a661-9ed754611a58
msgctxt "hd4ebbb0ag2da9g46d1g9ff5gf59c163e1446"
msgid "Prisoners. We can't leave them here."
msgstr "포로들이야. 저들을 이대로 둬선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = b3136808-a1b7-48e9-a661-9ed754611a58
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:b3136808-a1b7-48e9-a661-9ed754611a58
msgctxt "h273a6c47g4ec9g48f9g9c86g58ded6124313"
msgid ""
"A throng of prisoners, awaiting their turn for execution - or infection."
msgstr "포로들이다. 차례로 처형되기만을 기다리고 있겠지. 혹은 감염일 수도 있고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = b3136808-a1b7-48e9-a661-9ed754611a58
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:b3136808-a1b7-48e9-a661-9ed754611a58
msgctxt "h2c7703aag1f76g4475ga49agcbbd5e444d33"
msgid "Prisoners. Not long for this world."
msgstr "포로들이야. 곧 목숨을 잃겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = b3136808-a1b7-48e9-a661-9ed754611a58
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:b3136808-a1b7-48e9-a661-9ed754611a58
msgctxt "h3fc21e91g8ef6g4e43gb50bg866cce62a1b3"
msgid "Prisoners? We can't just leave them to suffer."
msgstr "포로들이라니? 저들을 고통 속에 내버려 둬선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = b3136808-a1b7-48e9-a661-9ed754611a58
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:b3136808-a1b7-48e9-a661-9ed754611a58
msgctxt "hb741cb95g4fe4g44bbgbd0dgfd2e4c242dd0"
msgid "Prisoners. More unwilling flesh for the Absolute's schemes."
msgstr "포로들이라. 절대자의 음모에 휘말린 가엾은 육신이 이토록 많을 줄이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = b3136808-a1b7-48e9-a661-9ed754611a58
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:b3136808-a1b7-48e9-a661-9ed754611a58
msgctxt "hdca554d0g436eg4006gb492g2104710a3d28"
msgid ""
"The cult's prisoners become its soldiers. We should not leave them here."
msgstr "교단의 포로들은 병사로 다시 태어난다. 여기 이대로 둬서는 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = b3136808-a1b7-48e9-a661-9ed754611a58
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_GENERIC and !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:b3136808-a1b7-48e9-a661-9ed754611a58
msgctxt "hfa47e01cg45c1g4eedg8a83g4598b6b7c5e6"
msgid "Prisoners. I doubt they'll last long in here."
msgstr "포로들이군. 이런 곳에서 오래 살아남긴 힘들겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
msgctxt "h30a1d723gbc75g4db7g8cf4g915bd26fe882"
msgid "<i>Do</i> be careful, I don't much fancy a stay behind bars."
msgstr "<i>제발</i> 조심해, 철창 뒤에 갇히게 되는 건 질색이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
msgctxt "he4619c4bg13aag4c98ga6e7g624868e39a3f"
msgid ""
"If we plan to open the doors for these poor souls, we must do so quietly, or "
"risk joining them."
msgstr "이 불쌍한 자들을 꺼내줄 생각이라면 조용히 해내야 할 거야. 안 그러면 같은 신세를 지게 될 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
msgctxt "hecdef24fgc72bg42adgb130g44f8a1cc9eda"
msgid "Can't risk getting locked up ourselves."
msgstr "자칫 잘못했다간 우리가 갇힐 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
msgctxt "h79cb9593gc18eg4e97g82b3g67bd4001b0a1"
msgid ""
"I don't want to end up like them. Let's behave - or at least pretend to "
"behave."
msgstr "저들처럼 되고 싶진 않아. 얌전히 있자 - 아니면 적어도 그런 척이라도 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
msgctxt "ha418bfb9gd132g4682ga1f2g886b75621c4e"
msgid "If we rouse the cultists' suspicions, we could meet the same fate."
msgstr "광신도들의 의심을 샀다간, 우리도 저들과 같은 신세가 될 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
msgctxt "hdb5a0494gaf22g4609g9ebfgfe11b5f6a308"
msgid "That's where we'll end up if we're not careful."
msgstr "조심하지 않으면 우리도 저렇게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
msgctxt "hcc9eb65dg2c54g4b8dg8059g0da87b1d4ef4"
msgid "Exercise caution. I do not want to end up in these cells again."
msgstr "조심히 행동해라. 다시는 이곳에 갇히고 싶지 않으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
msgctxt "h4650f27dg9dfbg485cgb543ga71eb214459a"
msgid "We cannot help them just now. Let us not arouse any suspicion."
msgstr "지금 당장은 저들을 도울 수 없네. 의심을 불러일으켜서는 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners
#. Speaker = Player
#. NodeID = f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_GENERIC and !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_ApproachingPrisoners:f16f1d46-1ae0-463b-f7b8-2a9f6916d4da
msgctxt "heec57615gd9c6g442agaabeg1d2c2fb20c4f"
msgid "Careful. One wrong move and we'll be behind bars with them."
msgstr "조심해. 섣불리 행동했다간 저들과 마찬가지로 철창신세를 지게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_CheckingOutBoat
#. Speaker = Narrator
#. NodeID = ffd4657b-fbbb-4b60-9bc3-b90c534e514f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_PAD_CheckingOutBoat:ffd4657b-fbbb-4b60-9bc3-b90c534e514f
msgctxt "hda2eba27g7c75g4f60g98e3g706936fae2d4"
msgid "*While ropes tightly bind this boat to the docks, it cannot be used.*"
msgstr "*배가 밧줄로 부두에 단단히 묶여있는 한, 배를 사용할 수는 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother
#. Speaker = Cal
#. NodeID = 06209790-2895-5300-780f-add72debd5e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_AngrySister(1) = True
#.      - MOO_Jailbreak_HasMet_ProdigyBrother(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother:06209790-2895-5300-780f-add72debd5e2
msgctxt "h90e77f76g194eg4a4bgbd44g739937962807"
msgid "Don't talk to us. You're just making it worse."
msgstr "말 걸지 마. 넌 그저 상황을 악화시킬 뿐이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother
#. Speaker = Cal
#. NodeID = 1a731126-5ef7-4c50-236d-bbfcbc0b32bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_BrotherAtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother:1a731126-5ef7-4c50-236d-bbfcbc0b32bf
msgctxt "h40674009ge8d5g4423gbf06g546db4d17ac0"
msgid "I need to focus - these ropes won't untie themselves."
msgstr "집중해야 해. 밧줄이 저절로 풀리지는 않을테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother
#. Speaker = Cal
#. NodeID = 4788d3d1-0573-a0c5-1eea-cd912e425018
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_BrotherAtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother:4788d3d1-0573-a0c5-1eea-cd912e425018
msgctxt "hc5e10dc1gcfccg4410gb845g4cd6db95e204"
msgid "This waiting is killing me."
msgstr "기다리는 것도 못할 짓이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother
#. Speaker = Cal
#. NodeID = 62685612-f769-4047-baea-ec37183b6731
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_ProdigyBrother(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother:62685612-f769-4047-baea-ec37183b6731
msgctxt "h0e2b3b60g4157g4f69g85e1g55ac3e19e9e3"
msgid "Get us out of here before the necromancer comes back - <i>please.</i>"
msgstr "사령술사가 돌아오기 전에 우릴 여기서 내보내 줘, <i>제발.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother
#. Speaker = Cal
#. NodeID = 83d0159d-bca9-fefe-8f8c-e167eb72edc9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_BrotherOutcast(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother:83d0159d-bca9-fefe-8f8c-e167eb72edc9
msgctxt "h3c181f15ga56bg4e79g8daeg9a6cc20b694e"
msgid "Get us out - hurry!"
msgstr "우릴 내보내 줘, 어서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother
#. Speaker = Cal
#. NodeID = b512d790-8b63-ae48-dd5b-047777d176e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_BrotherAtBoat(1) = False
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_BrotherAtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother:b512d790-8b63-ae48-dd5b-047777d176e3
msgctxt "h3e74fb9ag673cg4681g9828gd224f846ac4e"
msgid "Be ready - if any cultists show up, this will get bloody."
msgstr "준비해. 만약 사교도 놈들이 나타나면, 피를 보게 될 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother
#. Speaker = Cal
#. NodeID = ca89e6a3-72ba-29f2-7d1b-8e1f6db49dc5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_AngrySister(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_ProdigyBrother(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother:ca89e6a3-72ba-29f2-7d1b-8e1f6db49dc5
msgctxt "h0dc98588gad36g469eg97d3g18476fd9ba3e"
msgid "If you're not going to help, there's nothing left to say."
msgstr "도와주지 않을 거라면, 더 할 말 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother
#. Speaker = Cal
#. NodeID = e4de440a-42f8-ef3f-173c-f4f343e79e4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_BrotherAtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother:e4de440a-42f8-ef3f-173c-f4f343e79e4b
msgctxt "h19e69572g4393g48bagb0d3g399954c923ce"
msgid "With respect? <i>Not now.</i>"
msgstr "부탁 좀 하자, 응? <i>지금은 곤란해.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother
#. Speaker = Cal
#. NodeID = e70e013b-5b1a-743b-9273-fedbdab82d75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_BrotherOutcast(1) = True
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother:e70e013b-5b1a-743b-9273-fedbdab82d75
msgctxt "h4d5f53c9gc8bbg4270ga015g349511ce2258"
msgid "Hey! Don't leave us in here."
msgstr "이봐! 우릴 여기에 버려두지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother
#. Speaker = Cal
#. NodeID = fcf3c2e8-2ca1-54e4-02d9-f0121a39e376
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_ProdigyBrother(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigyBrother:fcf3c2e8-2ca1-54e4-02d9-f0121a39e376
msgctxt "hd3f4e6d8g253fg4939g94ebg49695d636435"
msgid "We'll have your back if it comes to a fight - you can be sure of that."
msgstr "만약 싸움이 벌어지면 우리가 뒤를 봐줄게. 믿어도 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 01c2c491-7780-6136-6661-88d1fbbd1bdd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_SisterAtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:01c2c491-7780-6136-6661-88d1fbbd1bdd
msgctxt "hf4e856fagdf0cg4305g9b9egc59563dcd6aa"
msgid ""
"I swear, the moment these ropes are off they're going around your "
"<i>neck.</i>"
msgstr "맹세하는데, 이 밧줄이 풀리자마자 네놈 <i>모가지</i>에 걸릴 줄 알아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = 04f4d200-ea56-e256-8e78-05af898415fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:04f4d200-ea56-e256-8e78-05af898415fd
msgctxt "h2474d7a9g59d2g4f05g81bdg170af4f0297d"
msgid "Told you. He's too stubborn to die."
msgstr "말했잖아. 녀석은 죽기엔 너무 끈질기다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = 09f513a9-8c6a-32dc-9b74-1ed5ae221e91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:09f513a9-8c6a-32dc-9b74-1ed5ae221e91
msgctxt "hbec874ddgc189g461ag91f2g9b053f58cf0b"
msgid "Heh. Told you he'd make it."
msgstr "헤, 녀석이라면 해낼 거라고 했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 0a5d6f58-4786-8ddb-849b-7d125c051c02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:0a5d6f58-4786-8ddb-849b-7d125c051c02
msgctxt "h97b93ea5g8b72g475dg9afbg4e051e65ad70"
msgid "Oh, you clever bastard. I could kiss you!"
msgstr "오, 이 똑똑이 자식 같으니. 뽀뽀라도 갈기고 싶네!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 0ac5e3ba-7931-2aa7-d50f-ec6894d519da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:0ac5e3ba-7931-2aa7-d50f-ec6894d519da
msgctxt "h05480cf6g7f3ag4024g9e94g7bee9999b01c"
msgid "That means Rolan..."
msgstr "그 말은 롤란 녀석도..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 0c3da919-1775-0168-d75e-917c220ddbda
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_ProdigySister(1) = True
#.   Object:
#.      - IsInPrison(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:0c3da919-1775-0168-d75e-917c220ddbda
msgctxt "h28cd27cag11e6g43c2g8c1agbcc7260b842c"
msgid ""
"Don't worry, we'll get out of here - one way or another. We <i>have </i>to."
msgstr "걱정 마. 우린 어떻게든 여길 빠져나가고 말 거니까. 반드시 <i>해낼</i> 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 1399ea8e-efd6-dd66-f862-38d27d624745
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:1399ea8e-efd6-dd66-f862-38d27d624745
msgctxt "h3b45c966g8d58g4a0cg84a2ga5691b9a2712"
msgid "Look, if needs be we'll do it, but only as a last resort."
msgstr "잘 들어, 정 필요하다면 우리가 움직이겠지만, 정말 최후의 방법일 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 171dfea8-f4e8-16c0-6af5-6cf7e2b5b25b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#.   Object:
#.      - MOO_Jailbreak_State_HasToolForGnomes(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:171dfea8-f4e8-16c0-6af5-6cf7e2b5b25b
msgctxt "h0c720950gc398g4f8ag8a0agd38832aeee0c"
msgid "Yes, they need tools."
msgstr "그래, 도구들이 필요한 모양이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 1bcc6566-336b-4b74-a93e-dceb40c32a23
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:1bcc6566-336b-4b74-a93e-dceb40c32a23
msgctxt "h0c040dafg5e1cg4a27g9ac0g9ed03e993d91"
msgid "Why don't you and Zevlor take a long walk off a short cliff?"
msgstr "제블로어랑 낭떠러지 근처에서 사이좋게 산책이나 하는 건 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 1d5fdc00-e583-7dc6-a9c4-e972ed730513
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - IsInPrison(1) = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_ProdigySister(1) = True
#.   Global:
#.     - MOO_Jailbreak_Event_ProdigyIntro = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:1d5fdc00-e583-7dc6-a9c4-e972ed730513
msgctxt "hb48ccee8g532cg40d7gaaaag3e26e7c12099"
msgid "You! You're from the <i>grove.</i> Are you all right?"
msgstr "거기 너! <i>에메랄드 숲</i>에서 온 거 맞지? 괜찮아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 1f9880b5-80c5-f6e9-c158-530046b03c7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:1f9880b5-80c5-f6e9-c158-530046b03c7e
msgctxt "h1adea71cg5673g40f3ga2begc69c2f219763"
msgid "Not a <i>chance</i>. We'll be butchered."
msgstr "<i>절대</i> 안돼. 학살당할 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 1fafe206-6dd9-3724-9592-aa9dc7abbd3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:1fafe206-6dd9-3724-9592-aa9dc7abbd3d
msgctxt "h3bd44b41g05d0g4c23g97b7g9c3f1a62f6ce"
msgid "He made it? He's all right?"
msgstr "살아 있다고? 괜찮은 거 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = 20494414-73d3-24e9-f638-619c0866cb71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:20494414-73d3-24e9-f638-619c0866cb71
msgctxt "h81eaef23g2046g43e6gb28fg55854d9cef1c"
msgid "We did what we could, Lia."
msgstr "우린 할 만큼 한 거야, 리아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 20b0cdc1-1db8-d4d4-a767-13f3641c2496
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:20b0cdc1-1db8-d4d4-a767-13f3641c2496
msgctxt "h606b72fdg553ag4851ga590g91b757cafabd"
msgid "The gnomes have a plan. I'm going to get you out of here."
msgstr "노움들이 계획을 짜고 있어. 여기서 널 구해줄게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 26eeb4eb-ce4f-a585-1f1f-a22d0f4a585f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingTieflingPrisoner = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:26eeb4eb-ce4f-a585-1f1f-a22d0f4a585f
msgctxt "h09d8aa07g4d3fg454bgb76dg43247f4ece12"
msgid ""
"Ended up here while Zev has all but vanished. Bet he was with the pricks "
"from the start."
msgstr "제블로어가 사라지고 정신 차려보니 여기더라고. 처음부터 이놈들이랑 한패였던 게 틀림없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 2ab45886-01e2-077a-6847-66ce67cb1297
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Wulbren(1) = True
#.      - MOO_Jailbreak_HasMet_SisterToGnomes(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SisterReadyToGo(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:2ab45886-01e2-077a-6847-66ce67cb1297
msgctxt "ha89ef793g6e77g4bd4g8481gc264f4d51d80"
msgid "Any luck with the gnomes?"
msgstr "노움들과 얘기해봤어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = 2ec2edf7-5033-f500-5667-d3976ae6c140
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:2ec2edf7-5033-f500-5667-d3976ae6c140
msgctxt "h888e30e5g7c32g47cbg987dg16d5547f7a05"
msgid "Not in front of me, please. I've suffered enough."
msgstr "내 앞에서 그러진 말아줄래. 이미 충분히 괴로운 상황이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 2ff6e5c7-6daa-3ede-57b7-58fd5c976d36
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_AngrySister(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:2ff6e5c7-6daa-3ede-57b7-58fd5c976d36
msgctxt "h3bdeadcfgdc2bg4255ga445g93b923bfec87"
msgid "This isn't my problem."
msgstr "내가 신경 쓸 일은 아니군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 30e7c9fb-0873-42c2-3470-d97d0dfa5e5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:30e7c9fb-0873-42c2-3470-d97d0dfa5e5e
msgctxt "h6dad8a4agb757g4dfag8d86gee8a9e5052ad"
msgid "Then get a move on - we'll be ready to run."
msgstr "그럼 빨리 시작해 - 우리는 도망칠 준비가 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 31f061e1-f89e-50c6-bdde-0b78a24de31a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:31f061e1-f89e-50c6-bdde-0b78a24de31a
msgctxt "h2e2063a5g5a47g4a00g8b1bg72b983fe8a2f"
msgid "It's the thought that counts?"
msgstr "마음만 앞선 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 334298f5-0b42-b4ca-34ef-aaf46bbc7575
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Prodigy_Knows_Dead = False
#.      - HAV_Area_State_BarrierIsOff = False
#.      - HAV_ProdigyLament_Knows_RolanAlive = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:334298f5-0b42-b4ca-34ef-aaf46bbc7575
msgctxt "h24a35a31gc479g4e8egb9f3g0e8df83e59d9"
msgid "Listen - your brother Rolan is <i>alive</i>. He's in Last Light Inn."
msgstr "잘 들어. 너희 형제 롤란은 <i>살아 있어</i>. 지금 최후의 빛 여관에 묵고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 3368047e-08d1-6281-a5b8-1a2fbb6b3a80
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SisterToGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:3368047e-08d1-6281-a5b8-1a2fbb6b3a80
msgctxt "h0bc9484eg6330g4712gba97ga81cd7011539"
msgid "To help. What can I do?"
msgstr "도우러 왔지. 뭘 해주면 좋을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 353af67d-7f2f-d205-8d5e-cf7fe34fdf06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Prodigy_Knows_Dead = False
#.      - HAV_Area_State_BarrierIsOff = False
#.      - HAV_SavingPrisoners_Knows_CapturedTieflings = True
#.      - HAV_ProdigyLament_Knows_RolanAlive = False
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_State_ToldTieflingsAboutHaven = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:353af67d-7f2f-d205-8d5e-cf7fe34fdf06
msgctxt "hf5e4778dg7042g4bb6g8f08g33e4fc94c13d"
msgid "Listen - the others are <i>alive</i>. They're in the Last Light Inn."
msgstr "잘 들어. 모두들 아직 <i>살아 있어</i>. 최후의 빛 여관에 대피해 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 361469f9-afcc-ba41-30d7-ef9f5c8c44de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:361469f9-afcc-ba41-30d7-ef9f5c8c44de
msgctxt "h9eb05d1bg8ff0g43efg91dbg95325f9f7218"
msgid "How did you two end up in here?"
msgstr "너희 둘은 어쩌다가 여기에 갇히게 된거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 3a2c54b7-34d2-aab4-199f-ae736baff909
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:3a2c54b7-34d2-aab4-199f-ae736baff909
msgctxt "hb27c736bgd960g47cfg9bc3g87f4f8db026d"
msgid "Why don't you take a long walk off a short cliff?"
msgstr "이제 좀 꺼져주면 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = 3a930f2d-d182-4197-bb31-d8a4f48e7812
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:3a930f2d-d182-4197-bb31-d8a4f48e7812
msgctxt "hdb76294bgefd1g48cagb148g26d3d67d9d0b"
msgid "<i>We </i>don't know that for sure."
msgstr "그건 아직 모르는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 3d8c845b-10fe-1e5c-1cb9-fec5b1d5c0f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:3d8c845b-10fe-1e5c-1cb9-fec5b1d5c0f9
msgctxt "hde2c16cdg461ag4c83g9c84ga4f2e39bbc66"
msgid ""
"You're in a cell next to me, mate. Not exactly in a position to negotiate, "
"are you?"
msgstr "넌 지금 내 옆에 똑같히 갇혀있다고, 친구. 뭘 흥정할 만한 처지는 아닐텐데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 3f4a62da-a4c1-3139-cc36-27a00476d6a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingTieflingPrisoner = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:3f4a62da-a4c1-3139-cc36-27a00476d6a1
msgctxt "h28003c73g420bg4789g9738gc403fd904891"
msgid ""
"Like <i>what? </i>Listen, we need to get out of here - Zev has killed us. "
"These people are nuts."
msgstr "무슨 <i>할 일?</i> 이봐, 빨리 여기서 나가야 해. 제블로어가 우릴 죽음으로 몰아갔어. 이놈들은 죄다 제정신이 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = 40a1fd0a-899f-5de7-2b8d-6008fa09023c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:40a1fd0a-899f-5de7-2b8d-6008fa09023c
msgctxt "h63051cb4g9528g4b57g82d8gb5f97a647134"
msgid "If it comes to a fight, we can handle it - we always do."
msgstr "싸우게 된다면 우리가 나서도록 하지 - 항상 그래왔듯이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = 42fda9f3-58e3-e13d-1b77-031fb8bd09c1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Knows_SpeakWithGnomes = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:42fda9f3-58e3-e13d-1b77-031fb8bd09c1
msgctxt "h7d0bb332g724eg4994g9668g9cd9d2372aaf"
msgid ""
"No, this is perfect! You're by the gnomes. They've been whispering like mad "
"for days - they're up to something."
msgstr "네 말이 맞아, 때가 왔어! 넌 노움 편이지. 저들은 며칠 내내 미친 듯이 속삭이더군, 뭘 꾸미고 있는 게 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 44855e43-2460-ec6b-a8c9-e1aa03147992
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SisterAtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:44855e43-2460-ec6b-a8c9-e1aa03147992
msgctxt "h329cea27g0fbcg4b3egb109gbdaf348ed0f1"
msgid "Argh! I almost had it - bugger off, will you?"
msgstr "아악! 거의 다 됐는데... 저리 꺼져 주지 않을래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 46dd1c88-9345-a18d-1e0a-16e8220660bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:46dd1c88-9345-a18d-1e0a-16e8220660bf
msgctxt "h380662bfg40ecg4539gb461gf6c8e798d144"
msgid "Whatever you lot are up to - hurry<i>. </i>And <i>thank you.</i>"
msgstr "뭘 꾸미고 있던간에 <i>서둘러줘</i>. 그리고 <i>고마워.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 4842fbc3-1d84-a260-0474-1a02d689e9fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_AngrySister(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:4842fbc3-1d84-a260-0474-1a02d689e9fc
msgctxt "h254a2d28g65c2g4e21g8635g61f9c90b6d1b"
msgid "Like you lot care what happens to us."
msgstr "우리 일에 신경 깨나 쓰는 것처럼 지껄이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 49b2bef9-b698-58dd-8f0a-a61b823467b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:49b2bef9-b698-58dd-8f0a-a61b823467b8
msgctxt "hab4d9f5cg853eg444eg9a67g7db8255ea621"
msgid "I can't lose anyone else - I won't."
msgstr "다시는 누구도 잃을 수 없어 - 그리 두지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 4d201662-c34f-76fa-ed7e-ea3d80373e7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:4d201662-c34f-76fa-ed7e-ea3d80373e7a
msgctxt "h12b93807g12dfg4296g8e86g1b448feeaebf"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 519ce640-1533-aa33-02eb-28e3f92255e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:519ce640-1533-aa33-02eb-28e3f92255e7
msgctxt "h40b37053g904ag48d0g88a0gcf05f09af6f6"
msgid "How did you end up in here?"
msgstr "어쩌다가 여기에 갇히게 된거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 5271aa57-491f-3a5a-9261-917ffaa3deb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_ProdigySister(1) = True
#.   Global:
#.     - MOO_Jailbreak_Event_ProdigyIntro = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:5271aa57-491f-3a5a-9261-917ffaa3deb5
msgctxt "hfc80545cg8d3eg4ff8g9ea7g6fbc571fe052"
msgid "Let me guess - 'The Absolute is the only way.'? Don't bother."
msgstr "맞춰보지 - '절대자님이 유일한 길이다' 같은 소리나 할 거지? 귀찮게 굴지마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 527e8a7f-66c1-52d8-d3a3-da09124fd6a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:527e8a7f-66c1-52d8-d3a3-da09124fd6a4
msgctxt "h40dccaf3g949cg42fegbd6fg2e094634e30b"
msgid ""
"Well it clearly doesn't take much brains because, as you can see, we left "
"our mountains of gold at home."
msgstr "지금 상황에 부연 설명이 필요할 줄은 몰랐네. 보시다시피 우린 산더미 같은 금을 집에 두고 온 참이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 53079c38-4d47-bf9a-dc90-6697e0646a08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:53079c38-4d47-bf9a-dc90-6697e0646a08
msgctxt "hbf6f2376gd910g457ag9454g8519ab7a498a"
msgid "Well, I was planning on rescuing you..."
msgstr "구해줄 생각이었는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 55a49e0d-9b9c-a1d7-b350-4a3ee3f47939
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:55a49e0d-9b9c-a1d7-b350-4a3ee3f47939
msgctxt "h7c4daae2ga0dfg47b8gb684g557aa25a2d40"
msgid "Whatever it is, we're in. Don't leave us in here."
msgstr "뭐든 간에 우리도 함께하겠어. 이곳에 버려두고 가지 말아줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 55d358cb-7356-534f-5ea3-d940862d86ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#.   Object:
#.      - MOO_Jailbreak_State_HasToolForGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:55d358cb-7356-534f-5ea3-d940862d86ba
msgctxt "h76c4e371gbce7g4b39g9157gb8b57bdeb754"
msgid "Yes, I've got tools for them."
msgstr "그래, 노움들을 위해 도구들을 가져왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 56e9254d-1e4f-a3de-41e5-cc020f4c9e12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:56e9254d-1e4f-a3de-41e5-cc020f4c9e12
msgctxt "h0f331670gf2c4g420cga924g34d8c5eda82b"
msgid "Escape first - then we'll talk payment."
msgstr "우선은 탈출이야 - 보상은 그 뒤에 얘기하도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = 57cedd6f-f35c-d0d9-08ca-3296168bd07e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Knows_SpeakWithGnomes = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:57cedd6f-f35c-d0d9-08ca-3296168bd07e
msgctxt "h1e5c70dcg8a0dg449fg8d0fgc7455f103a14"
msgid "Gnomes next door are up to something. They've been whispering like mad."
msgstr "옆 방 노움들이 뭔가를 꾸미고 있어. 계속 끊임없이 서로 속닥거린다니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 5b3424ca-8f4b-bed8-7316-6d4b8a1be998
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:5b3424ca-8f4b-bed8-7316-6d4b8a1be998
msgctxt "h0942a381g8cb0g4e2agb33dg29d5e2aa6f0d"
msgid "Bastard. Enjoy tonguing Ketheric you treacherous <i>shit.</i>"
msgstr "개새끼. 케서릭 똥꼬나 열심히 핥아 봐라, <i>등신아.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 5d181ef4-cc30-049b-03da-11699e95d05b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:5d181ef4-cc30-049b-03da-11699e95d05b
msgctxt "h96f7aedeg222bg4799g911ag82a3a6140140"
msgid "Don't mind me, what about you?"
msgstr "난 괜찮아, 너야말로 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 67dcec30-6789-67e8-bbbf-8133cde135c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:67dcec30-6789-67e8-bbbf-8133cde135c4
msgctxt "h80acb1d6g528fg46f4gac39gb3a50015e9c9"
msgid "Let's fight our way out."
msgstr "싸워서 뚫고 나가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 69219c5b-d56e-38b6-20fa-2d9154c202d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:69219c5b-d56e-38b6-20fa-2d9154c202d5
msgctxt "h67953868ge536g4e1bg916cgb75e8407a290"
msgid ""
"Well hurry - who knows when that nutcase of a necromancer will come for us."
msgstr "그럼 서둘러줘 - 언제 그 미치광이 사령술사가 우릴 찾아올지 모르니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 6b45d942-b2d7-c6b5-a856-d63c1ab2690c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:6b45d942-b2d7-c6b5-a856-d63c1ab2690c
msgctxt "h64b4d469g339dg40ecg8d2egfbbb22285a21"
msgid ""
"Like <i>what? </i>Listen, we need to get out of here - these people are nuts."
msgstr "무슨 <i>할 일?</i> 이봐, 빨리 여기서 나가야 해. 이놈들은 죄다 제정신이 아니라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 6cbedf7b-c9b8-7781-c97d-d6b140c981bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:6cbedf7b-c9b8-7781-c97d-d6b140c981bf
msgctxt "h39aac549g1d0fg481dg8fd1gdb217c2ac61e"
msgid "That depends. How badly do you want to get out of here?"
msgstr "한번 보지 뭐. 여기서 얼마나 나가고 싶은데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 6e297a56-96b5-467a-cf11-1efa71ff2190
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:6e297a56-96b5-467a-cf11-1efa71ff2190
msgctxt "hc761b143gbb0fg4b47gbbddg932fdf1185ee"
msgid "I take it getting locked up wasn't part of it?"
msgstr "갇혀버리는 것도 계획의 일부였던건 아니겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 757e1c9b-fb6d-bb95-00b0-e87a2097ec3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:757e1c9b-fb6d-bb95-00b0-e87a2097ec3e
msgctxt "h52d5b07agce36g431bg821agc4b15adf88b6"
msgid ""
"Check the Warden's office, in the centre of the prison. Miss High-and-Mighty "
"keeps the good stuff close."
msgstr "이 감옥 가운데 있는 간수장의 사무실을 찾아봐. 위대해 자빠지신 그분께서는 괜찮은 물건들은 다 가까이에 둔다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 7a6895b7-dbd2-4453-0d0b-d7d187156aea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_SpeakToTieflingsWarning(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SisterToGnomes(1) = True
#.   Global:
#.     - MOO_Jailbreak_Knows_SpeakWithGnomes = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:7a6895b7-dbd2-4453-0d0b-d7d187156aea
msgctxt "h652d2549g1c9bg42a3ga628g0dae086888b8"
msgid ""
"Shh. The guards will blow a gasket. Talk to the gnomes - they're up to "
"something."
msgstr "쉿. 들키면 간수들이 미쳐 날뛸 거야. 노움들과 얘기해봐 - 뭔가를 꾸미고 있는 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 7efc918c-645e-f764-dd19-c470580549be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:7efc918c-645e-f764-dd19-c470580549be
msgctxt "h897c9fe9gd2bbg4c8bg9234ge50864b132a0"
msgid "Fit to murder half this damn tower. What are you even doing here?"
msgstr "이 망할 탑의 절반 정도는 죽일 준비 됐지. 여긴 무슨 볼일이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 7fdc81ec-07e5-7c78-d3d2-2aa49b38e504
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_SisterAtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:7fdc81ec-07e5-7c78-d3d2-2aa49b38e504
msgctxt "h2e91bbe7g1399g42deg9b9egc25f4d9eb435"
msgid "Could this be taking any longer? We haven't got all damn day!"
msgstr "대체 얼마나 더 걸리는 거야? 하루 종일 여기 처박혀 있을 순 없다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 84e92c71-8cca-1656-8959-1c4a530da699
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:84e92c71-8cca-1656-8959-1c4a530da699
msgctxt "hb625410bg1513g496bg9e00geae5897bea42"
msgid "What are the gnomes planning?"
msgstr "노움들이 뭘 꾸미고 있는 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = 86f4e0ec-4dae-b907-72e2-fbd76da38398
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:86f4e0ec-4dae-b907-72e2-fbd76da38398
msgctxt "hbb272addg820cg47b9g9149ge2aec008e85a"
msgid "<i>Shit.</i>"
msgstr "<i>젠장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 8a1f2041-aeb0-198f-0def-0ae2bc8ab4d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:8a1f2041-aeb0-198f-0def-0ae2bc8ab4d0
msgctxt "h12d32753g886ag46dagbfcfga54b8fdd8355"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 8b6f3c43-cd11-01b1-ce45-800fb5f63b3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:8b6f3c43-cd11-01b1-ce45-800fb5f63b3e
msgctxt "h29d09216gc58bg4a7cg884bgffe4b01e1b41"
msgid "We can grieve later - once we get out of this pit."
msgstr "슬퍼하는 건 우선 이 구덩이에서 나간 후에도 할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 8c2db97d-4add-0ef6-7a78-7a2a1ea72b69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:8c2db97d-4add-0ef6-7a78-7a2a1ea72b69
msgctxt "hbf6adb76g5f10g41e9g862cg1f7b50e68f77"
msgid "So, other than to break my damn heart in two - why are you here?"
msgstr "그래서 내 마음을 찢어놓는 것 말고는 이곳에 온 이유가 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 8e3c7e11-f1ff-783b-fc07-7561cd73bf09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:8e3c7e11-f1ff-783b-fc07-7561cd73bf09
msgctxt "hd26b8af0g556eg4fd4gb93fgb53cd90edf61"
msgid "I can't read bloody minds. Go on - before someone sees."
msgstr "난 독심술사가 아니야. 어서 가 - 누가 우릴 보기라도 하기 전에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 8ff3ace2-2a2b-825e-3751-88cb774e2e1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Wulbren(1) = False
#.      - MOO_Jailbreak_HasMet_SisterToGnomes(1) = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Knows_SpeakWithGnomes = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:8ff3ace2-2a2b-825e-3751-88cb774e2e1a
msgctxt "h5cd6477bg04f5g40a9gbbd4g5a75cb43c3d3"
msgid "Gods, the <i>gnomes.</i> Speak to the gnomes."
msgstr "맙소사, <i>노움들</i>이라고 했잖아. 말을 걸어봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 92605d28-f846-48ac-bd84-5cdda3d32fd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:92605d28-f846-48ac-bd84-5cdda3d32fd1
msgctxt "h088c8e71gb696g43f8gbf5bg9d0901f49f57"
msgid "You manage to pick these locks, and I owe you a pint."
msgstr "네가 이 자물쇠를 따는 데 성공한다면 다음에 한잔 사주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 947f8850-5a22-1c11-3d9a-a74063f21169
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:947f8850-5a22-1c11-3d9a-a74063f21169
msgctxt "h256d0812g84a6g497bg932fgfca77743b749"
msgid "If you're not at the Absolute's beck and call, why are you <i>here?</i>"
msgstr "네가 절대자의 개가 아니라면, <i>여기에는</i> 왜 온 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 9c862b28-4e0e-c738-3d90-4e55f0f7e8b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:9c862b28-4e0e-c738-3d90-4e55f0f7e8b1
msgctxt "h7c2abeaagec90g4cb6g9053geaebf6d4e221"
msgid "I knew it. I just... knew."
msgstr "그럴 거 같았어. 그냥... 그런 느낌이 들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = 9e6f51b9-1f44-f4b4-8835-5b8f419d3344
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:9e6f51b9-1f44-f4b4-8835-5b8f419d3344
msgctxt "h8f20211agca2ag413fg8c54gbb1d6a09378d"
msgid "I've already spoken to them - we have a plan."
msgstr "이미 얘기 해봤어 - 탈출 계획이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = 9f24db95-7479-6113-7a81-f4d4d592f6f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:9f24db95-7479-6113-7a81-f4d4d592f6f5
msgctxt "h6305653bg6044g4d84ga597gba13d6fd7fdd"
msgid ""
"And started gutting us one at a time. We fought back while the others ran - "
"lot of good it did them."
msgstr "그러더니 한 명씩 끌어내 내장을 뽑기 시작했어. 다른 이들이 달아나는 동안 우리는 맞서 싸웠어. 그나마 다행이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = a3c2addc-12af-c828-5dc3-dd453f5f60c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:a3c2addc-12af-c828-5dc3-dd453f5f60c4
msgctxt "h2d61d526g73efg455egadb1g1e703c660f0e"
msgid "I'm working on it."
msgstr "아직 하는 중이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = a5c81461-71b1-da7d-ba3d-b943ec8171cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:a5c81461-71b1-da7d-ba3d-b943ec8171cc
msgctxt "hd7174dabg8a06g4e01g96e3g5196fdea55b0"
msgid "No kidding. What are you even doing here?"
msgstr "그랬겠지. 그래서 대체 여기서 뭘 하고 있는 건데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = a7e469ab-7538-ecce-8d98-e40bed65d9a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:a7e469ab-7538-ecce-8d98-e40bed65d9a8
msgctxt "hb55297b5gf3c9g4b46g9c27gcd36eac8d430"
msgid "Why are you even here? Go run and play with the Absolute, yeah?"
msgstr "그럼 여기서 대체 뭘 하는 거야? 가서 절대자나 실컷 놀아 주지 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = ace9483a-738f-aacb-6c80-1b235edd53b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:ace9483a-738f-aacb-6c80-1b235edd53b9
msgctxt "h35d79751g08fdg4ccfgbc92g75088a19eb11"
msgid ""
"Oh for - you try staying calm with a pack of nutcases circling you. Hurry - "
"please."
msgstr "이런 씹... 입장 바꿔서 네가 이 미치광이들 사이에 갇혀 있다고 생각해 봐. 제발. 부탁할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = b643b225-95fa-d8d8-bc52-f524dcc8dc0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:b643b225-95fa-d8d8-bc52-f524dcc8dc0a
msgctxt "h54bf28e1g8a39g41d2g8380gf6f3d4716bb5"
msgid "Lulling them into a false sense of security - this cell can't hold me."
msgstr "안전 불감증을 심어 주고 있던 참이야. 이런 감방 따윈 날 가둘 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = bd5b47e4-82ec-756e-313c-a2fc60b05188
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_SpeakToTieflingsWarning(1) = True
#.   Global:
#.      - MOO_Jailbreak_State_PrisonerInterogationAllowed = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SisterToGnomes(1) = True
#.   Global:
#.     - MOO_Jailbreak_Knows_SpeakWithGnomes = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:bd5b47e4-82ec-756e-313c-a2fc60b05188
msgctxt "h06e556a4ga6f6g4fb3ga842g9fb61a3b6170"
msgid ""
"You want to help? The gnomes, couple cells down, are up to something. And "
"we're in."
msgstr "돕고 싶어? 두 칸 더 가면 있는 노움들이 뭔가를 꾸미고 있어. 우리도 거기 끼워줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = c05b7e23-bacf-299b-cfd0-63c4c458ea91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:c05b7e23-bacf-299b-cfd0-63c4c458ea91
msgctxt "h20bfcfa6g9254g4207ga7f8g050b5b7c274a"
msgid "I've had better days."
msgstr "지금까진 괜찮았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = c06bed3c-ac7f-5bdf-3caa-a43d888ba72a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SisterToGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:c06bed3c-ac7f-5bdf-3caa-a43d888ba72a
msgctxt "h258585b7ga99fg40b0g95f0gd7f8def1a2ad"
msgid "That depends. Being a hero is a costly business, you know."
msgstr "보상에 달려 있지. 영웅 활동에는 비용이 제법 들거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = c15c7dfa-05a5-b8ed-d94f-80d8b7c801fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_SisterOutcast(1) = True
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#.   Object:
#.      - IsInPrison(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:c15c7dfa-05a5-b8ed-d94f-80d8b7c801fd
msgctxt "h288b6f00g10d0g4e14ga301g1882107e50eb"
msgid "Please! Something's happening. Get us out of here!"
msgstr "부탁이야! 뭔가 일어나고 있어. 여기서 꺼내 줘!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = c2979175-23bc-7b5c-e006-2e436b8214eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Prodigy_Knows_Dead = True
#. SetFlags:
#.   Global:
#.     - GLO_Prodigy_State_ToldSiblingsProdigyDead = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:c2979175-23bc-7b5c-e006-2e436b8214eb
msgctxt "h3a36c0cagfa99g4a8egafd1gac2ad7230d9d"
msgid "I have some bad news - your brother, Rolan, is dead."
msgstr "안 좋은 소식이 있어 - 네 남매, 롤란이 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = c2c08131-b0d8-ba79-3750-9a15d58781e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#.   Object:
#.      - IsInPrison(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SisterOutcast(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:c2c08131-b0d8-ba79-3750-9a15d58781e1
msgctxt "h98724966ga516g40c1gb4ebg28ea16d66ea5"
msgid "Don't leave us here, damn it!"
msgstr "우릴 여기 두고 가지마, 젠장!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = c35b07af-00cc-91ca-1be3-8ef0e54efd75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:c35b07af-00cc-91ca-1be3-8ef0e54efd75
msgctxt "h8f7c7b62gc5b2g4b66ga561geea17c4dcd26"
msgid ""
"Look, I've no bright ideas, but whatever the gnomes have cooked up? We're "
"in. Don't leave us in here."
msgstr "이봐, 난 뾰족한 수가 없어. 하지만 노움들이 뭘 꾸미고 있든 간에 우린 함께 하겠어. 이곳에 버려두고 가지 말아줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = c4d6bd3d-54a4-a247-3c2e-1e6b37ec2220
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:c4d6bd3d-54a4-a247-3c2e-1e6b37ec2220
msgctxt "he3ffed6fgb6b0g459cg8257g0a4c9297d7f4"
msgid "The gnomes have a plan. We're getting out of here."
msgstr "노움들이 계획을 세워놨어. 여기서 나가자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = c8777c2f-06bc-ba43-dd48-67417c8a20d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:c8777c2f-06bc-ba43-dd48-67417c8a20d3
msgctxt "hb4bbe2a7gb029g4285g8e64g7095d0c382df"
msgid "Have a little faith, Lia. If anyone can get us out, she can."
msgstr "믿음을 좀 가져봐, 리아. 우릴 구해줄 수 있는 건 저 여자뿐이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = c8777c2f-06bc-ba43-dd48-67417c8a20d3
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:c8777c2f-06bc-ba43-dd48-67417c8a20d3
msgctxt "he6d2a9c8g1897g453cgaf47gc9037080d3d2"
msgid "Have a little faith, Lia. If anyone can get us out, he can."
msgstr "믿음을 좀 가져봐, 리아. 우릴 구해줄 수 있는 건 저 남자뿐이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = c8777c2f-06bc-ba43-dd48-67417c8a20d3
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:c8777c2f-06bc-ba43-dd48-67417c8a20d3
msgctxt "h22d62294g13c9g4456g96ecg11ed1c644d45"
msgid "Have a little faith, Lia. If anyone can get us out, they can."
msgstr "믿음을 좀 가져봐, 리아. 우릴 구해줄 수 있는 건 저 사람뿐이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = caed04a2-03ac-5873-de18-ab4ab334e466
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:caed04a2-03ac-5873-de18-ab4ab334e466
msgctxt "h36bbad68g4262g4d57ga247g9d859d852e40"
msgid "Cultists ambushed us in the darkness - lined us up one by one..."
msgstr "숭배자 놈들이 어둠 속에 매복하고 있었어. 우릴 한 명씩 줄 세워 놓더니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = cf6abb9d-c3a7-cc4a-6486-27bbf83d3d1c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_AngrySister(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:cf6abb9d-c3a7-cc4a-6486-27bbf83d3d1c
msgctxt "h71e70b72gafeag4e26g973dgea712c31fb6c"
msgid "<i>Bull.</i>"
msgstr "<i>헛소리.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = d14e9848-9c8d-dae1-1b42-f6df9fd1c7a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:d14e9848-9c8d-dae1-1b42-f6df9fd1c7a7
msgctxt "h1e7dc2e2g5229g40f7g9439gdc23fbaaae7d"
msgid "Watch your tone."
msgstr "말투가 마음에 안 드는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = d2f665f9-4304-0baf-22e4-ce6cbe0b8805
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SisterToGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:d2f665f9-4304-0baf-22e4-ce6cbe0b8805
msgctxt "h6e7a44b1g9c8eg4f7fga9ddg06841637e428"
msgid "Get ready. We're going to fight our way out."
msgstr "준비해. 빠져나가려면 싸워야 할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = dc2b818d-9a72-7b9d-976e-5d45007903fd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:dc2b818d-9a72-7b9d-976e-5d45007903fd
msgctxt "he5f3d028gb977g4fcbgbf47gc9a25b3aa609"
msgid "I'm not with the cultists - I swear it."
msgstr "난 광신도 편이 아니야. 맹세하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = e1d75745-94a2-0f1c-1e32-f7b942cdae86
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:e1d75745-94a2-0f1c-1e32-f7b942cdae86
msgctxt "hf7c75e85g4818g42aeg80deg2a91b425be86"
msgid "Why are you even here? Go run and play with Zev, yeah?"
msgstr "그럼 여기서 대체 뭘 하는 거야? 가서 제블로어나 실컷 놀아 주지 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = e3bb20e1-5ad1-ccc7-63ec-8a0c5ea36343
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_AngrySister(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:e3bb20e1-5ad1-ccc7-63ec-8a0c5ea36343
msgctxt "h5265cc88g1964g42d0ga2dag88b136937071"
msgid "Go on. I think Absolute's boots need another licking."
msgstr "계속해 봐. 절대자는 노상 똥꼬빨이에 혈안이 돼 있으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = e4517e18-d704-8964-8830-723274306021
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_AngrySister(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:e4517e18-d704-8964-8830-723274306021
msgctxt "h5c01b607g0359g40bcg9a87g33f8db8818be"
msgid "You're not getting any help from me - enjoy your cell."
msgstr "내게서 도움을 받을 순 없을 거다. 즐겁게 지내라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = ec6c15d5-662c-82c1-cc79-d9645420796e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:ec6c15d5-662c-82c1-cc79-d9645420796e
msgctxt "h03df976fg3d55g4315gab4cg7f855641564f"
msgid "Say I'm with the Absolute again, and I'll leave you here to die."
msgstr "한 번만 더 내가 절대자 편에 붙었다고 말하면, 여기서 죽게 내버려두겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = ee337331-ac6e-f120-1bf3-fb84ed06b63d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_ProdigySister(1) = True
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:ee337331-ac6e-f120-1bf3-fb84ed06b63d
msgctxt "h18ad6083g0924g4946gb88fgb3737d6bbb2c"
msgid ""
"Get us out of here. <i>Please. </i>Before that headcase of a necromancer "
"comes back."
msgstr "우릴 꺼내줘. <i>부탁이야.</i> 저 정신 나간 사령 술사들이 돌아오기 전에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = f05a284e-e62f-f22c-4944-8d4b3a1fa634
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:f05a284e-e62f-f22c-4944-8d4b3a1fa634
msgctxt "h66dc84b4gf6e5g417agb59fg5615753ae9fa"
msgid "I hope every single one of you drown in your own <i>shit.</i>"
msgstr "너희 놈들이 한 놈도 남김없이 <i>똥통</i>에 빠져 죽었으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Cal
#. NodeID = f1ddb3c9-becb-06b3-c373-472429f500a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - COL_FindZevlor_Knows_MissingTieflingPrisoner = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:f1ddb3c9-becb-06b3-c373-472429f500a3
msgctxt "h2a41e16cge164g479dg890bg81a594e804ed"
msgid ""
"Cultists ambushed us in the darkness and Zevlor - well, he <i>surrendered. </"
"i>The others got away, but we..."
msgstr "숭배자 놈들이 어둠 속에 매복하고 있었고, 제블로어는... 그래, <i>항복했어.</i>. 다른 사람들은 달아났지만, 우린..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Player
#. NodeID = f750043a-dddd-9e60-1a72-dae519e698bb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SisterToGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:f750043a-dddd-9e60-1a72-dae519e698bb
msgctxt "h41c540fbgb71fg447cg82b7g6f7ee8d95052"
msgid "I have some things to take care of."
msgstr "아직 해야 할 일이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = fc8d099d-b456-2799-0001-8e9cbc3859d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_SisterReadyToGo(1) = True
#.      - MOO_Jailbreak_HasMet_SisterToGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:fc8d099d-b456-2799-0001-8e9cbc3859d2
msgctxt "h08293cf7g0af2g4756g8214g4b7ae81dc8f4"
msgid "We're good to go. Now get those bloody gnomes moving."
msgstr "우린 준비됐어. 이제 망할 노움들이 움직일 차례야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister
#. Speaker = Lia
#. NodeID = fdaa0064-182d-621a-5795-7af0fb23307e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_SisterAtBoat(1) = False
#.   Object:
#.      - MOO_Jailbreak_State_Escaping(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_SisterAtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_ProdigySister:fdaa0064-182d-621a-5795-7af0fb23307e
msgctxt "h3aeda7ffg4d6cg4b7cgbe04gb3cf1770ace3"
msgid "I swear, my grandmother could untie that boat faster."
msgstr "장담하는데, 우리 할머니가 배를 더 빨리 풀겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 0147267b-c162-efb5-6b62-1590bbd1bb7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:0147267b-c162-efb5-6b62-1590bbd1bb7f
msgctxt "ha87ea0f3g3468g47a7g82a6g8128417029ff"
msgid "That was so well-played, I'm not even mad."
msgstr "참 잘도 속여넘기는군, 화도 안나는 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 04401be8-1332-25f7-9fa1-18b979de4e65
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:04401be8-1332-25f7-9fa1-18b979de4e65
msgctxt "h34b6a370g1137g4040g8e94g34560746a962"
msgid "No wonder I didn't remember you. You have such a dull face."
msgstr "네가 기억나지 않는 게 당연하군. 얼굴 참 재미없게 생겼어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 04401be8-1332-25f7-9fa1-18b979de4e65
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:04401be8-1332-25f7-9fa1-18b979de4e65
msgctxt "h661180f3g9db8g4e8fg8f88g3b5dfc2071b2"
msgid "Your face is pretty bland too."
msgstr "네 얼굴도 꽤 밋밋해 보이는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 07b28910-c605-4047-2883-74fd1eca9112
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:07b28910-c605-4047-2883-74fd1eca9112
msgctxt "he4fa2daege1c1g4aebg8137g1f5c868926c8"
msgid "Who is Disciple Balthazar?"
msgstr "신봉자 발타자르가 누구야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 090d2e68-1314-fb66-9130-f5ce08e193f1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:090d2e68-1314-fb66-9130-f5ce08e193f1
msgctxt "h983e6289gf082g4275g8465g8796886c6e0c"
msgid "You know, you should go check on them - just in case."
msgstr "그래도 가서 살펴보지 그래 - 혹시 모르니 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 09621f69-5eb0-aee4-aa7b-5f62868aebfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:09621f69-5eb0-aee4-aa7b-5f62868aebfa
msgctxt "hcc9e12f5geb1cg4a5bgaf08g42d18d511f13"
msgid "A pity I am in no mood for hide-and-seek."
msgstr "숨바꼭질을 할 기분은 아니라서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 09b8fa3b-a639-7302-af54-cc4edf50efc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:09b8fa3b-a639-7302-af54-cc4edf50efc9
msgctxt "hc4044a60g04b8g4b0dgb5bcgd0951cd64a9d"
msgid "I'm glad I snuck the prisoners out when I did."
msgstr "포로들을 몰래 빼낸 보람이 있네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 0ad25181-a0d1-4c52-09aa-4b54d84636b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:0ad25181-a0d1-4c52-09aa-4b54d84636b1
msgctxt "h463045afged21g4a91gb731g921a2be3e6a3"
msgid "Not a chance."
msgstr "어림도 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 0c74ac03-2d50-a2dc-2ef4-9f45a4394a20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:0c74ac03-2d50-a2dc-2ef4-9f45a4394a20
msgctxt "he61d8e04g5a2dg41a8ga34ag0158db7b87a0"
msgid "Seen what coming?"
msgstr "뭘 알아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 10a0e833-fce5-6dc3-1785-46a4d113a6d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:10a0e833-fce5-6dc3-1785-46a4d113a6d2
msgctxt "hb15a0cf7g297ag4accga49agab77f3f8161a"
msgid ""
"You have the same black-tongued sense of humour as ever, I don't believe you "
"for a heartbeat."
msgstr "그 시커먼 혀에서 나오는 유머 감각은 예전 그대로군. 네 말은 조금도 믿지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 11de057d-726a-79a0-94da-1ac6caf2b2f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:11de057d-726a-79a0-94da-1ac6caf2b2f8
msgctxt "h782f71b5g4f4fg44d5ga2cdg64d10a1b3664"
msgid "I can take care of them, if you wish."
msgstr "원한다면, 내가 처리해 줄 수 있는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Narrator
#. NodeID = 1654d8e9-ce5f-ba72-7d7e-7c2c0118c6d3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4fd17065-2c50-f39b-8768-3403f291e43e_insightsuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:1654d8e9-ce5f-ba72-7d7e-7c2c0118c6d3
msgctxt "h13f13734gb878g48dcga115gbfd38c9e236b"
msgid "*Her smirk hides her intent - she's toying with you.*"
msgstr "*그녀의 능글맞은 웃음에 의도가 숨겨져 있습니다, 당신을 가지고 놀고 있군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 168a376a-8673-9a24-4b29-6751393e07dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:168a376a-8673-9a24-4b29-6751393e07dc
msgctxt "he238f04cg4c80g4508ga63age97bea419ce7"
msgid "But this is no less than what I deserve for failing Her."
msgstr "하지만 그분을 실망시킴으로써 내가 받아야 할 처벌만큼 두렵지는 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 1e31422c-65e7-0976-35be-97291b1d4e36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Desire_State_AgreedToFindDuke = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:1e31422c-65e7-0976-35be-97291b1d4e36
msgctxt "ha31a7fc1g889ag48cdgb027ga7d81b1eb461"
msgid "I'm looking for a particular prisoner - Duke Ravengard?"
msgstr "난 어떤 포로를 찾고 있는데... 레이븐가드 대공이라고 아나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 219346e1-f152-f4e2-100c-6f1447e28e62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DARK_URGE(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Warden(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:219346e1-f152-f4e2-100c-6f1447e28e62
msgctxt "hfeac31b3gc2ccg4e46gb858g0d5cc3cc0972"
msgid ""
"You. Not you. Lord Ketheric may think you pose no threat to him in your "
"disgrace, but I know the things you've done."
msgstr "너. 넌 안돼. 케서릭 님은 네놈이 별 위협이 안 된다고 생각하시겠지만, 난 네가 한 짓을 안다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 231758f9-ae88-c81e-628e-430377a23f90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:231758f9-ae88-c81e-628e-430377a23f90
msgctxt "h121fe7d7gea29g4d0fga36fg93786738dc4b"
msgid "Why tame a wild horse when it's so close to breaking its own spirit?"
msgstr "왜 야생마를 길들이려고 하는 거지? 이제 그 기백이 박살나기 직전인데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 2324e827-113b-8982-d11b-3afe213f8e8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:2324e827-113b-8982-d11b-3afe213f8e8e
msgctxt "h7c4b9f33g0f2eg49c4gb0bfg4ce0a6cdfe46"
msgid "Ha... hahaha."
msgstr "하... 하하하."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 24dd9af1-235c-1205-4f17-c3cf8d01634a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFLING(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:24dd9af1-235c-1205-4f17-c3cf8d01634a
msgctxt "h8402f4a4gf942g44dcga5c7g7283a5347765"
msgid "And if I do talk to them?"
msgstr "내가 말을 걸면 어떻게 되는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 253d2bce-9689-dd7f-1387-d681436b5c49
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Warden_Event_ThreatenedPlayer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:253d2bce-9689-dd7f-1387-d681436b5c49
msgctxt "hb8b1f829g5216g4f39ga294g02972c51872f"
msgid "Good day to you, True Soul."
msgstr "그럼 좋은 하루 되시게, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 257a57a9-5c30-daee-7a69-5f9f2ed2f11a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:257a57a9-5c30-daee-7a69-5f9f2ed2f11a
msgctxt "h1f7e3a86g086dg4e35gb183g2d14e0ffb433"
msgid ""
"He is chief advisor to General Ketheric and one of the Absolute's favoured. "
"His necromancy is second only to the General's - it is an honour to serve "
"him."
msgstr ""
"케서릭 장군님의 수석 고문이며 절대자님의 가장 총애받는 자 중 하나야. 그의 사령술은 장군님 다음으로 뛰어나다고 할 수 있지, 그 사람을 "
"위해 일한다는 건 영광스러운 것이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 2612ab48-8e76-bd7d-f976-07bca148a12b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:2612ab48-8e76-bd7d-f976-07bca148a12b
msgctxt "hbd68459dg1b34g41f3g8525ga36a78caa5a5"
msgid ""
"Indeed, but all are kept out of reach and under constant surveillance in the "
"office above. Prison security is my highest priority."
msgstr "맞아, 하지만 전부 사무실 위층 손닿지 않는 곳에 두고 항상 감시중이지. 감옥 보안은 내 최우선 과제니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 28bbe123-81be-e6b1-4b95-40599b4b862a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:28bbe123-81be-e6b1-4b95-40599b4b862a
msgctxt "hb63238a7g2c44g466dga434g230f418f5efe"
msgid ""
"No need. Once they realise escape is impossible, the Absolute will extend "
"Her hand - and they <i>will </i>accept."
msgstr ""
"그럴 필요없어. 탈옥하는 게 불가능하다는 걸 깨닫는 순간, 절대자님께서 손을 내밀 것이고, 그들은 받아들이게 <i>되겠지</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 2d0086f5-e847-481d-deff-4b95cb6cc09d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:2d0086f5-e847-481d-deff-4b95cb6cc09d
msgctxt "h6e8418c2g1090g4f30g9442gbde58d8a3695"
msgid "You thief - give me back my gold."
msgstr "이 도둑놈, 내 돈 돌려내."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 2f2d58b1-df55-582b-15b2-0a76c8cc1427
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFLING(1) = False
#.      - REALLY_DARK_URGE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:2f2d58b1-df55-582b-15b2-0a76c8cc1427
msgctxt "h8376c3f6g3da7g4360g98cdgae19ab5aee6c"
msgid "Do not disrespect me - I am a True Soul."
msgstr "나에게 무례하게 굴지 마라, 난 참된 영혼이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 2f99a711-68d4-8fc4-1736-5c6f90a03065
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Executioner_Knows_BalthazarIsMissing = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:2f99a711-68d4-8fc4-1736-5c6f90a03065
msgctxt "ha9d3a18dgf737g4d59ga52cg805839d2a28c"
msgid "Z'rell herself has entrusted me with an important mission."
msgstr "즈렐이 직접 나에게 중요한 임무를 맡겼다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 2fe47a54-972b-a5e7-6725-c84e52655271
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:2fe47a54-972b-a5e7-6725-c84e52655271
msgctxt "h5b047448g3a30g4c76ga192g2752a36587de"
msgid "Whatever happened in the past is irrelevant now."
msgstr "과거에 있었던 일은 지금 관계없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 35ba1726-5f6e-a04a-8385-a0f9abeaf9b3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:35ba1726-5f6e-a04a-8385-a0f9abeaf9b3
msgctxt "h70aec28fg6b98g417agbb88g51c1c3d145ee"
msgid "I'm Ketheric's new favourite."
msgstr "케서릭이 새로이 가장 총애하는 자가 바로 나다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 3601607f-b5b5-82ab-393b-324241dad4dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:3601607f-b5b5-82ab-393b-324241dad4dc
msgctxt "hf9a1357dga28bg491ag9cc4g5a941f54981a"
msgid ""
"Your name, your place was kept from all of us last time, but you were to be "
"shown the utmost of respect."
msgstr "네 이름, 그리고 지위는 당시에 그 누구도 알지 못했다. 다만 최고 수준의 존경으로 받들어야 했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 37b1acd0-79bd-0f30-2fba-4f739ae7d82f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Warden(1) = True
#.   Global:
#.      - MOO_Jailbreak_State_PrisonerInterogationAllowed = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:37b1acd0-79bd-0f30-2fba-4f739ae7d82f
msgctxt "h77129619g1e9bg41bdgaab9g18c4719c56bb"
msgid ""
"The floor is yours, but stay your tongue. Do not speak to those behind bars."
msgstr "돌아다니는 건 자유지만, 입은 다물고 있어라. 철창에 갇혀 있는 자들과 대화는 금지다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 391741ce-e3ff-d71f-72a6-7b07eddd093b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:391741ce-e3ff-d71f-72a6-7b07eddd093b
msgctxt "h6ef2fdf7g3debg4003ga308g4f2da27b8b89"
msgid "What gold?"
msgstr "무슨 돈?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 396437fa-4550-3724-2291-e69a9a56a6d6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Warden(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:396437fa-4550-3724-2291-e69a9a56a6d6
msgctxt "h936fd3acg6c86g4fe8g8c3dg29bab19f189c"
msgid "You spark of the familiar. Do I know you, True Soul?"
msgstr "넌 익숙한 느낌이 드는군. 우리가 아는 사이던가, 참된 영혼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 3a6a5fa6-65f5-3587-b472-893c7d967659
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#. TagRule: SORCERER_WILDMAGIC
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:3a6a5fa6-65f5-3587-b472-893c7d967659
msgctxt "hc6de2e4dgf098g4157gace7gf8656235e41f"
msgid ""
"Arcana runs through my veins - my magic is as powerful as it is tempestuous."
msgstr "비전력이 내 혈관을 타고 흐른다. 내 마법은 격렬한 것 만큼이나 강력하기도 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 3a6a5fa6-65f5-3587-b472-893c7d967659
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:3a6a5fa6-65f5-3587-b472-893c7d967659
msgctxt "h2203b4bfg3cc1g4824g8a01ga855602eba3f"
msgid "Arcana runs through my veins - I am a sorcerer."
msgstr "비전력이 내 혈관을 타고 흐른다. 난 소서러거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 3c112b62-23b4-8896-664e-c1fa940fff0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:3c112b62-23b4-8896-664e-c1fa940fff0c
msgctxt "h97523e36g133eg4c74g840cg063e92df5036"
msgid ""
"Have you considered they might be shaking from laughter? Just a thought."
msgstr "그들이 몸을 떠는 게 웃느라 그런 거라고는 생각 안 해봤나? 왠지 그런 생각이 드네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 3e054106-b336-8cf3-cdde-889bccb60664
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFLING(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:3e054106-b336-8cf3-cdde-889bccb60664
msgctxt "h1f2dcc5eg89e2g447cgb302gf5a1ccb50f86"
msgid "I'll speak to them if I want."
msgstr "난 내가 하고싶은 대로 할 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 42e3ccd1-100b-34c9-1c4c-859bc008d224
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Warden_Event_ThreatenedPlayer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:42e3ccd1-100b-34c9-1c4c-859bc008d224
msgctxt "h41da4934gc1fdg4322gb458gb6b3aac5f1b3"
msgid "You don't look very busy to me."
msgstr "내가 보기엔 그렇게 바빠보이지 않는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 4338e13a-8078-60e6-b0df-76e31d930874
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:4338e13a-8078-60e6-b0df-76e31d930874
msgctxt "h89ee8709g941eg44e3gb19agc65818a92b07"
msgid "Move along, True Soul - have a pleasant day."
msgstr "비켜, 참된 영혼. 좋은 날 되시고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 45de6f00-5eb0-6306-da89-8206d473190f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:45de6f00-5eb0-6306-da89-8206d473190f
msgctxt "hb2448e10g7cf2g498cgaa30g6ca809a4a8ea"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 4635ef77-c5b6-f3e7-d052-03587c062747
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:4635ef77-c5b6-f3e7-d052-03587c062747
msgctxt "h6d002b0eg1615g447fg8815g5d7f0a069805"
msgid "So you can read? Congratulations."
msgstr "그렇담 읽을 수 있다는 거야? 축하해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 50986ce1-1c44-8496-cae6-2ff2a22af150
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:50986ce1-1c44-8496-cae6-2ff2a22af150
msgctxt "h89ebbf62g5f0cg48b6g9a33gb4ff1e01ff82"
msgid "How in the Hells do you know me?"
msgstr "대체 날 어떻게 아는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 50cfe356-35d3-8b93-55f1-1a2af0043731
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:50cfe356-35d3-8b93-55f1-1a2af0043731
msgctxt "hd5789258g6802g43c7g9b2ag86a640800cdc"
msgid "Pity - I was about to grant you an exception."
msgstr "아쉽군, 너한텐 예외를 허락할 참이었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Narrator
#. NodeID = 5114ddc5-a93b-4dc1-8c28-430167be00e4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4fd17065-2c50-f39b-8768-3403f291e43e_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:5114ddc5-a93b-4dc1-8c28-430167be00e4
msgctxt "h15da52a7g99efg4ef4g8213gee4145a203a1"
msgid ""
"*Your mind swirls with information about the prison: the small levers behind "
"the Warden's desk open every cell, while the larger one triggers the alarm.*"
msgstr ""
"*감옥에 대한 정보가 머리속에 소용돌이칩니다, 간수장의 책상 뒤에 있는 작은 레버들로 감옥문을 열 수 있고, 큰 레버로는 경보를 "
"작동시킵니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 511c46ef-9049-fadd-d3d3-abcd85a50cba
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:511c46ef-9049-fadd-d3d3-abcd85a50cba
msgctxt "h20628c3ag8f92g499cga6bcg1e2b7650c557"
msgid ""
"The Absolute shines upon me. She tests me - then She gifts me you. I will "
"now rip you apart - in Her name."
msgstr "절대자께서 날 인도하신다. 날 시험에 들게 하시더니 너를 선물로 주셨구나. 널 갈기갈기 찢어놓겠다. 그분의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 513dd3da-4aee-34b9-615a-4cd3a4104cb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:513dd3da-4aee-34b9-615a-4cd3a4104cb2
msgctxt "hd4084706g5d7bg4b2dga1b1ga7b3a2f9d279"
msgid ""
"Not as impressive as you. It is rare to find someone so<i> </i>singularly "
"devoted to a task."
msgstr "너만 할까. 자기가 맡은 임무에 그토록 헌신하는 사람은 정말이지 드물거든. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 54e41290-a337-b360-9930-e579b3572058
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:54e41290-a337-b360-9930-e579b3572058
msgctxt "h40a50d41g1279g42b1g94e3g8d41b4905976"
msgid ""
"There will be no trial, no jury. I will split you from head to heel - and "
"the Absolute will thank me for it."
msgstr "재판 같은 건 없을 거야, 배심원따위도 없을 거고. 널 머리부터 발끝까지 쪼개버릴테다, 절대자님께서 이에 고마움을 표해주실테지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 559f3642-caff-288d-2d14-685082a5c433
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:559f3642-caff-288d-2d14-685082a5c433
msgctxt "h77c352d3ga262g48a1ga67ag0d5d8dc2ecac"
msgid ""
"He sounds important, and I'm afraid the mere dregs are the only ones left in "
"my care."
msgstr "중요한 인물인 것 같군. 유감스럽게도 내가 관리하는 건 잔챙이들뿐이라서 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 5633fd43-fe8b-aa4f-a0eb-f6c42024d709
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:5633fd43-fe8b-aa4f-a0eb-f6c42024d709
msgctxt "h2cd02bdfg1f08g47f4gad38gef2fb3a4cad8"
msgid "Pockets running a little empty, are they?"
msgstr "주머니가 조금 가벼우신 모양이군?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 5ab406a3-66aa-5b46-85bc-2d7b187b0f7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:5ab406a3-66aa-5b46-85bc-2d7b187b0f7a
msgctxt "hec01972cg26d4g46dbg8b51g5773984c53a6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 5c372fdd-dae5-13b1-d774-25ee26580e4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:5c372fdd-dae5-13b1-d774-25ee26580e4b
msgctxt "h0490692eg754ag4c34g823bgcdbf426c1c3a"
msgid "You must confiscate lots of interesting things from prisoners."
msgstr "수감자들 한테서 재밌는 걸 많이 압수했나 본데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 5f357d12-c561-7471-5357-b8403ded02c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:5f357d12-c561-7471-5357-b8403ded02c7
msgctxt "h2a60ff53g5951g4771ga5f5g3872d7730338"
msgid "A pity you're already failing then."
msgstr "그건 이미 실패하는 중이니 안까깝군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 607be5cf-a832-5d73-0180-c9874bc78b7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:607be5cf-a832-5d73-0180-c9874bc78b7e
msgctxt "h3dcb0230g147cg475ag9060g52d551c61ab8"
msgid "They're not leaving here alive - let them learn it the hard way."
msgstr "그들은 살아서 나가지 못한다는 걸, 고통스러운 대가를 치르며 알게 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 60a4ff3d-2563-f520-6e0a-e6d2bd71b534
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Warden(1) = True
#.   Global:
#.      - MOO_Jailbreak_State_PrisonerInterogationAllowed = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Warden_Event_ThreatenedPlayer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:60a4ff3d-2563-f520-6e0a-e6d2bd71b534
msgctxt "h0eda8840g4c35g42cegb2a4g055988f4e1ed"
msgid "I am a busy woman, True Soul. What is it?"
msgstr "난 바쁜 몸이다, 참된 영혼. 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 60b2564f-8cdd-81e5-ff21-e9d458d0bf89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:60b2564f-8cdd-81e5-ff21-e9d458d0bf89
msgctxt "hc37ad0c4gbaf6g420bg824ag7018dc9e60aa"
msgid "The rules don't apply to me."
msgstr "내게 적용되는 규칙은 아니군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 61021a64-7596-4b74-9672-c23fc6eeed0c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 4fd17065-2c50-f39b-8768-3403f291e43e_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:61021a64-7596-4b74-9672-c23fc6eeed0c
msgctxt "hd41627e7g143ag4117g80e4gb2fde71a0c28"
msgid "<i>Gently probe the Warden's mind.</i>"
msgstr "<i>정중한 태도로 간수장의 정신을 살펴본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 643c7365-ab8b-b06c-263d-b4071212a325
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:643c7365-ab8b-b06c-263d-b4071212a325
msgctxt "hbaa9e172ga905g4b47ga35cgedce679617b6"
msgid "Why ban speaking to prisoners?"
msgstr "왜 수감자들과의 대화를 금지하는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 69da5029-5080-b2c3-03ee-3733a153a856
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:69da5029-5080-b2c3-03ee-3733a153a856
msgctxt "he20ac00cg476bg478agb2edgfa461495231b"
msgid "I should have seen that coming."
msgstr "이럴 줄 알았다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 6bcc7b16-01a6-c9fa-2602-c88243d1c5b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:6bcc7b16-01a6-c9fa-2602-c88243d1c5b0
msgctxt "hdc880caeg71d4g4479g9b7bga2504a95511f"
msgid "Actually, never mind. I'll leave the prisoners be."
msgstr "있잖아, 신경 쓰지 마. 수감자들은 내버려둘게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 6d507087-c5c0-72ec-209c-1529edcbc2ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:6d507087-c5c0-72ec-209c-1529edcbc2ec
msgctxt "h31600ca4g44ceg429egb00bg7c89d89f03a6"
msgid "I didn't know he had such... refined taste."
msgstr "그 사람한테 이런... 세련된 취향이 있었을 줄이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 70cda357-37d4-8c23-7cce-d097d1c18020
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:70cda357-37d4-8c23-7cce-d097d1c18020
msgctxt "he52f44abg7590g422eg9e56g60d405a9cda8"
msgid "You're not going to stop them?"
msgstr "막지 않을 텐가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 7d6136cc-5bd3-0c85-4d24-a4a8b2be3a2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Hasmet_Warden_State_PrisonersEscaped(1) = True
#.   Global:
#.      - MOO_Jailbreak_State_Over = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:7d6136cc-5bd3-0c85-4d24-a4a8b2be3a2a
msgctxt "h8bfa511ag2979g4a32gaa6dgd4f59a258d46"
msgid "Farewell, True Soul. Serve Her well."
msgstr "작별이다, 참된 영혼. 그분을 잘 섬기도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 7db84513-4650-087b-f9ec-f06e839676c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:7db84513-4650-087b-f9ec-f06e839676c5
msgctxt "h1e09cfd8g5e37g4b8bg9ca6g3f32aad6ffe1"
msgid "They always think that."
msgstr "다들 그렇게 생각하더라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 7ddbd26c-8ae9-5447-7e7a-c2e26b1a6766
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:7ddbd26c-8ae9-5447-7e7a-c2e26b1a6766
msgctxt "h9cf54b00g8dbdg4de6ga9f4gbf77d2104194"
msgid ""
"That makes sense, True Soul - you clearly don't know the meaning of the word."
msgstr "말 되는군, 참된 영혼. 네가 진짜로 그 말 뜻을 모른다는 게 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 8004354a-b4d7-5840-61f9-98cecce817f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:8004354a-b4d7-5840-61f9-98cecce817f1
msgctxt "h1192dc45g0508g4e5cg99f3gc38df59f6bae"
msgid ""
"I know. We <i>all </i>know. Their 'whispers' are as subtle as a knife in the "
"ear."
msgstr "알고 있어. 우리 <i>모두</i> 알고 있다. 그 '속삭임'이 어찌나 조용한지 귀에 마치 칼날처럼 와서 박히더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 8023d12a-7614-539c-fd10-1e3875717b9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:8023d12a-7614-539c-fd10-1e3875717b9b
msgctxt "hc6fdd616g95c3g4afegb454ga9141551c4eb"
msgid "That sounds like a venereal disease."
msgstr "말만 들으면 성병이라도 걸린 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 81f7fa9a-87c8-cbbd-4acb-415a5ff3d97a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:81f7fa9a-87c8-cbbd-4acb-415a5ff3d97a
msgctxt "hba6ad67cgc4e1g40a2ga085g674affe19b81"
msgid "Please try - I could use a laugh."
msgstr "제발 해줘, 웃음이 필요하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 83689697-0ae5-9163-582b-9c8027e3a296
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:83689697-0ae5-9163-582b-9c8027e3a296
msgctxt "hfeace3a8g813bg4059gb281g5ff05fc0aea0"
msgid ""
"Disciple Balthazar has plans for them - and were I you I would not get in "
"the way."
msgstr "신봉자 발타자르에게 그들을 위한 계획이 있다, 내가 너라면 거기 끼려 하지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 8a66b719-cea1-05b8-3315-980c23f524ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:8a66b719-cea1-05b8-3315-980c23f524ca
msgctxt "h37ba3957ge4bbg450fgbf56g8d9b978162e0"
msgid "I burned down the grove."
msgstr "난 에메랄드 숲을 불태웠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 8b08511d-1e53-f444-41d4-f1b1be7a3d87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:8b08511d-1e53-f444-41d4-f1b1be7a3d87
msgctxt "h29310f2ag1805g489cgb655gec2ebdfb3d22"
msgid ""
"Little good it'll do - no lockpick can breach the Absolute's domain. But "
"watching them try is almost endearing."
msgstr "소용없다. 락픽으로는 절대자님의 영역에서 빠져나갈 수 없어. 하지만 그 애쓰는 모습만은 참으로 귀엽단 말이지. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 8b1af123-ca16-2c25-8167-261ae33e9b89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:8b1af123-ca16-2c25-8167-261ae33e9b89
msgctxt "h2571d81cg181dg49b4gb338g7cd3bcf88906"
msgid ""
"Is that so? If you are above the General's chief advisor, you must be most "
"<i>impressive</i>."
msgstr "그래? 네가 장군님의 수석 고문보다 윗사람이라면, 넌 진짜 <i>엄청난</i> 사람이겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 91065575-6cec-5464-9eb9-a49591c66131
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:91065575-6cec-5464-9eb9-a49591c66131
msgctxt "h42a73343gb7e1g47edga7aag127d4343de8b"
msgid "You don't."
msgstr "넌 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 917fc2b1-be80-ff62-b067-8fda75c82716
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:917fc2b1-be80-ff62-b067-8fda75c82716
msgctxt "hc7b44be4gcff5g42a3ga830ge05970f75dd2"
msgid "Oh, don't mind me. My brain is all but mincemeat - I'm harmless now!"
msgstr "오, 신경 쓰지 마. 내 뇌는 거의 다진 고기야. 난 이제 안전하다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 94b6b00a-7c8a-4e59-9541-12cb2f63f02b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:94b6b00a-7c8a-4e59-9541-12cb2f63f02b
msgctxt "hcdd7f82bg18bbg493ag8b6ege3d26c347f10"
msgid ""
"I assumed you overstayed your welcome. Little did I expect you to intrude "
"again."
msgstr "허락된 것보다 더 오래 머물렀나보다 싶었는데. 여기서 다시 만날 줄은 몰랐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 952fd3cc-4ea4-2f87-3717-11f33e15f653
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:952fd3cc-4ea4-2f87-3717-11f33e15f653
msgctxt "hf692aa40gf6b3g44ccg8dc9gbe4069dc6946"
msgid ""
"If you're looking for a soft bed and warm fire, I have a cell that would "
"suit you perfectly."
msgstr "푹신한 침대랑 따뜻한 불이 필요한 거면, 딱 맞는 감방이 하나 있긴 한데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 9837362f-4f46-697c-5640-a88d88e84f15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_GnomeEscape = True
#.      - MOO_Jailbreak_Event_ToldWardenInspection = False
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_ToldWardenInspection = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:9837362f-4f46-697c-5640-a88d88e84f15
msgctxt "h543f0189g83fag4378g8df1ga3e95ef289aa"
msgid "I overheard the gnomes planning an escape."
msgstr "우연히 들은건데 노움들이 탈옥을 계획하고 있다더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 9b33b30d-3c24-e3d5-9e91-7f65e240cb4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Global:
#.     - MOO_Background_Nobel_BribedWarden = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:9b33b30d-3c24-e3d5-9e91-7f65e240cb4b
msgctxt "hc9bdfcdbgbf2ag4a86g85d8gfe86f45f0c05"
msgid ""
"Fine.  ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr "알겠어.  ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = 9c2eb42d-c91c-9c2f-3c4b-c4867c84787e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:9c2eb42d-c91c-9c2f-3c4b-c4867c84787e
msgctxt "hf1b596b0g02dcg4b7fga412gfdfaf6008cd2"
msgid "I'm actually Balthazar's closest confidante."
msgstr "사실 난 발타자르랑 아주 가까운 친구야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = 9cc34f5c-7171-8147-0587-3d5d53a9a725
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:9cc34f5c-7171-8147-0587-3d5d53a9a725
msgctxt "h5319ebeagb528g438egaffagb2e9c8b031a8"
msgid "Kindly keep your fur and faeces to yourself."
msgstr "부탁이니 네 털이랑 대변이나 잘 좀 간수해 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = a4586d1f-1070-ef9a-af86-e9e4a8f42cfa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:a4586d1f-1070-ef9a-af86-e9e4a8f42cfa
msgctxt "h441a2647gb685g4e27g8d8fge36ad808c8b7"
msgid "I am a wizard - an expert in magic and all its mysteries."
msgstr "난 마법사다, 마법과 온갖 신비한 것들에 대한 전문가지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = a9193e39-76f9-180b-fb4b-ff1a730553ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:a9193e39-76f9-180b-fb4b-ff1a730553ef
msgctxt "haa01ec7fg4eb7g4e8fg974fg73cc7bc2375b"
msgid "As it should be."
msgstr "그래 마땅하지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = abca9440-351d-59c9-a165-cf4779288dbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4fd17065-2c50-f39b-8768-3403f291e43e_insightsuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:abca9440-351d-59c9-a165-cf4779288dbc
msgctxt "h4911d3ceg0020g4658g8ff9g560dc7034684"
msgid "I'm not here to play games - I need to speak to the prisoners. Now."
msgstr "난 장난하러 온 게 아니다, 죄수들과 이야기하겠다. 지금 당장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = ac4a379b-de21-78a3-2fc3-8fc5e7b21a8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:ac4a379b-de21-78a3-2fc3-8fc5e7b21a8b
msgctxt "hb73e09dfg34d6g4262g9920g61bd0284290b"
msgid ""
"Regardless, know this - I am the Warden. The prisoners are my charges, and I "
"answer to Disciple Balthazar <i>himself</i>. Stay on my good side."
msgstr ""
"어째됐든, 이건 명심해라 - 나는 이곳의 간수고, 죄수들은 내 관리하에 놓여있다. 그리고 난 신봉자 발타자르께 <i>직접</i> 보고를 "
"올리지. 내 눈을 거스르지 말도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = aff59551-8b20-4241-183b-88cb854880fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:aff59551-8b20-4241-183b-88cb854880fd
msgctxt "hdc1749a2g5abbg48f0g9e77g622b77f65fb1"
msgid ""
"My face might be bland, but yours? It is now carved into my memory - forever."
msgstr "내 인상이 흐릿할지도 모르지, 하지만 네 얼굴은 기억에 똑똑히 새겨뒀다. 영원히 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = b073079a-4c12-e42f-571e-ecd0ed563aec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:b073079a-4c12-e42f-571e-ecd0ed563aec
msgctxt "h6f177202gacb1g4769ga22bg635c64dfcba7"
msgid ""
"That tone might work on swaddled babes and puppies, but I am neither, True "
"Soul."
msgstr "그런 목소리로 말하면 갓난애나 강아지 정도는 겁줄 수 있겠지만, 난 둘 다 아니야, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = b113faff-6e39-4164-2586-f3106ee6ce32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:b113faff-6e39-4164-2586-f3106ee6ce32
msgctxt "hf4fd1616g74f8g461eg9feeg57621b8a20ad"
msgid ""
"I could regale you with tales of my daring deeds - and there are many. But I "
"really must speak to the prisoners."
msgstr "나의 대담한 행적에 관한 이야기로 널 즐겁게 해 줄수도 있어, 엄청 많거든. 근데 진짜 수감자들하고 이야기 좀 해야겠거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = b58dcf08-ccbe-45cc-02ed-c32b05205a02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:b58dcf08-ccbe-45cc-02ed-c32b05205a02
msgctxt "h9b1d3708g8398g4165ga5a6g296d89b3902d"
msgid ""
"Oh, dear - does someone think they're important? You are small, True Soul, "
"insignificant, and above all? <i>Replaceable. </i>Do not forget that."
msgstr ""
"오, 이런, 누군가는 그걸 중요하게 여기나 봐? 참된 영혼아, 넌 사소하고 하찮지. 더한 건 뭔지 알아? <i>대체 가능하다는 거야.</"
"i> 그걸 잊지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = b8574195-f4e1-4e1e-a2e5-eec56ed0cdf8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:b8574195-f4e1-4e1e-a2e5-eec56ed0cdf8
msgctxt "h6dfd732bg880cg47bcg85dbg7b01a38ff9c7"
msgid "<i>Argh</i>. You are no True Soul! I'll kill you, traitor."
msgstr "<i>아악</i>. 넌 참된 영혼이 아니군! 죽여버리겠다, 배신자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = bc59a142-3ef7-abf4-7140-f6b657d14627
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:bc59a142-3ef7-abf4-7140-f6b657d14627
msgctxt "h3793a9b7g53b2g4cf8ga573gf9eecb48b890"
msgid "Let them think they chose their fate - it is better, I find."
msgstr "자신의 운명을 스스로 결정했다고 생각하게 두자고, 내 경험상, 그게 더 나아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = bf25bda4-4289-8f58-4e55-755d7ba5a522
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:bf25bda4-4289-8f58-4e55-755d7ba5a522
msgctxt "hac5313c3gdd8dg4bd8g81ceg2c24fdc12707"
msgid "I was - for a time."
msgstr "두려웠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = bf83f411-b26c-b873-b343-49dc6f467b1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:bf83f411-b26c-b873-b343-49dc6f467b1b
msgctxt "h0917f293g4c87g41b8gab20gd1604bf77106"
msgid "I could kill you, you know."
msgstr "널 죽여버릴 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = c106c8d2-3f52-99f4-98d3-d4a8ef21835e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:c106c8d2-3f52-99f4-98d3-d4a8ef21835e
msgctxt "hcfc422a2g17c5g4ac7g8740gd7a203cfd59b"
msgid "I didn't know setting fire to <i>trees</i> was so admirable."
msgstr "<i>나무</i>에 불 좀 지르는 게 그렇게 대단한 일인지는 몰랐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = c288c27d-c9de-da1b-e911-dde75c6eabb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:c288c27d-c9de-da1b-e911-dde75c6eabb7
msgctxt "h869d3755ga665g4e03gbeb9g8b139f05129f"
msgid "A fool, perhaps, but a dangerous fool."
msgstr "말마따나 바보가 됐을지는 몰라도, 여전히 위험해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = c3c504af-6982-017c-043c-9ac5e8ffd687
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:c3c504af-6982-017c-043c-9ac5e8ffd687
msgctxt "h4c7facacg3fdcg4008g876bgcfbf91f548f3"
msgid ""
"Anyone who refutes the Absolute is an enemy of mine, True Soul. You would do "
"well to remember that."
msgstr "절대자님의 뜻을 거스르는 자라면 누가됐건 내 적으로 간주한다, 참된 영혼. 기억해 두는 게 좋을거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = c4d013da-ff47-85a4-18c8-9f65c8e565f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:c4d013da-ff47-85a4-18c8-9f65c8e565f1
msgctxt "h38fd5f3cg7e58g4807g9b2dga7d2f0032771"
msgid ""
"I'm glad to be recognised by someone of such... <i>staggering</i> repute."
msgstr "날 인정해주는 이가 있다니 영광이로군... <i>대단한</i> 명성은 익히 들었다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = c5303ded-4557-28f3-976c-7a1f56832a00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:c5303ded-4557-28f3-976c-7a1f56832a00
msgctxt "hb29ff1cegd57bg4284g975dgaecab1ec5b99"
msgid "Please, you have to help me, I really don't know what's going on."
msgstr "제발, 나 좀 도와줘. 뭐가 어떻게 돌아가는지 하나도 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = c7452b4d-c438-7dca-448e-ab8b63d31817
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:c7452b4d-c438-7dca-448e-ab8b63d31817
msgctxt "hd3deefbdg5a38g43a2g8cb8g9903ce273d06"
msgid ""
"You set foot in our tower once. You did not leave, at least not through any "
"door I have watch over."
msgstr "넌 예전에도 타워에 발을 들인 적이 있었지. 그러나 떠나는 모습은 보지 못했다. 적어도 내 눈으로는."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = c9db471c-b704-ca11-f445-8ae53b18d310
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:c9db471c-b704-ca11-f445-8ae53b18d310
msgctxt "hb5896223g7f68g419fg8168gb7eea9308b3d"
msgid "Hm. Fascinating."
msgstr "흠. 재밌네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = cacee20c-797e-d083-040f-8ad7389d805e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:cacee20c-797e-d083-040f-8ad7389d805e
msgctxt "h8182cbe0ge5aeg420fg960agc023e1dc44eb"
msgid ""
"I am the fiercest warrior you'll ever meet. My enemies shake when they hear "
"my roar."
msgstr "나처럼 흉포한 전사는 앞으로도 영영 만나볼 수 없을 거다. 내가 함성을 내지르면 적들은 몸을 떨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = cb9e22a5-ed0a-e355-9e43-439fdcae760b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:cb9e22a5-ed0a-e355-9e43-439fdcae760b
msgctxt "h037621dbg153fg4786gb233gd9f97f3636e5"
msgid "I'll do my utmost to impress you."
msgstr "네게 감동을 줄 수 있게 최선을 다할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = ce475725-14a6-059f-93d6-5a54fbbf7862
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:ce475725-14a6-059f-93d6-5a54fbbf7862
msgctxt "hf5a66d1fgcb31g4076gbe70g72a175e401d0"
msgid "I'm afraid none, no matter how generous, may speak to the prisoners."
msgstr "안됐지만, 얼마를 냈든지 간에, 수감자들과는 대화할 수 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = cf378ace-25cb-60e4-8872-830fad123032
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Global:
#.     - MOO_Background_Nobel_BribedWarden = True
#.   Object:
#.     - GEN_TransferNPCPayment_2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:cf378ace-25cb-60e4-8872-830fad123032
msgctxt "h8bcd7ad2gad9fg4f8dg8944gaf71a0a45f39"
msgid ""
"How about a large donation? ([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-"
"aba3-875cf81c38ca])"
msgstr ""
"많이 기부하는 건 어떤가? ([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-"
"aba3-875cf81c38ca])"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = d619d47f-deb4-5938-bf38-d389f3ba9117
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_TieflingsInJail = True
#. TagRule: !REALLY_TIEFLING
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:d619d47f-deb4-5938-bf38-d389f3ba9117
msgctxt "h21df366fg1820g475bgac8fg3040f6f214a0"
msgid "Other tieflings, your own people, are in a cell. Aren't you bothered?"
msgstr "다른 티플링들, 네 동족이 감옥에 있어. 아무 생각도 안 드나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = d619d47f-deb4-5938-bf38-d389f3ba9117
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_TieflingsInJail = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:d619d47f-deb4-5938-bf38-d389f3ba9117
msgctxt "h11c87b08gc1afg4c8egb450ga97a7cf87f8d"
msgid ""
"Our people suffered enough in Elturel - only to be locked up here, by one of "
"their own. Aren't you bothered?"
msgstr ""
"우리 동족들은 고초라면 이미 엘투렐에서 충분히 겪었다. 그런데 여기서까지, 그것도 동족에 의해 갇히게 되었군. 신경 쓰이지는 않나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = d62284ba-a168-1e4a-3c2c-748ed782e725
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:d62284ba-a168-1e4a-3c2c-748ed782e725
msgctxt "h14c7609eg5abag48cbgbd59g029fe4093235"
msgid ""
"The Absolute thanks you for this generous donation, True Soul. You can go "
"now."
msgstr "절대자님께서도 너의 후한 기부에 감사하신다는군, 참된 영혼. 이제 가봐도 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = d6d17c5d-a667-46c5-3aeb-09d5eecb2d83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:d6d17c5d-a667-46c5-3aeb-09d5eecb2d83
msgctxt "h07b48137ge7d8g4f52g91f3geab1b7f8c4f8"
msgid "Keep your bloody thoughts to yourself and your head down."
msgstr "네 빌어먹을 생각은 홀로 간직하고 숨죽인 채 지내라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = d6f46454-25ba-88ce-87e2-39365f5d3f43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:d6f46454-25ba-88ce-87e2-39365f5d3f43
msgctxt "ha66ffed7gfbb0g4463ga641g4775def3c972"
msgid "Do not be. It is fitting - I failed her. Try not to do the same."
msgstr "그럴 필요 없어. 내가 그분을 실망시킨 탓이니. 나 같은 실수를 저지르지 말도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = d6f77022-0d5a-3b49-1abc-c4d69ee10832
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:d6f77022-0d5a-3b49-1abc-c4d69ee10832
msgctxt "h4e07efcag88c4g4089g8a94g1e0374c0330b"
msgid "I'm a master of stealth and subterfuge."
msgstr "난 은신과 기만의 대가라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = d82a8930-4b98-c058-0c09-2b296a485458
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_Over = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Hasmet_Warden_State_PrisonersEscaped(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:d82a8930-4b98-c058-0c09-2b296a485458
msgctxt "h7f28337dgba98g4954g8de9gdac9ef9dfdab"
msgid "I am dead."
msgstr "난 죽은 목숨이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = d96591af-b778-2017-d8f2-00b61090e781
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:d96591af-b778-2017-d8f2-00b61090e781
msgctxt "h9b07acc3g3ee5g42cagb4a1g6695327afb60"
msgid "...My, they are letting all sorts become a True Soul these days."
msgstr "...맙소사, 요즘엔 진짜 개나 소나 참된 영혼이 되는 모양이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = daaf8b9d-3c9e-201f-e865-6298d16d48fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_PrisonerInterogationAllowed = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:daaf8b9d-3c9e-201f-e865-6298d16d48fe
msgctxt "h7926b221ga647g4391ga522g225283ab0c3f"
msgid ""
"Whatever your business, a warning: none may speak to the prisoners - "
"Disciple Balthazar was most clear."
msgstr "무슨 일인지는 모르겠지만, 경고 하나 하지. 죄수들과 대화를 해서는 안 돼. 신봉자 발타자르 님의 지시다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = de5088ff-874c-ece0-b328-ecd9ada72967
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:de5088ff-874c-ece0-b328-ecd9ada72967
msgctxt "h9d4a8f82g33ffg4f1bg81a0g369efab2ee28"
msgid ""
"You should see me in a fight - I can transform into powerful beasts from "
"across the realms."
msgstr "내가 싸우는 모습을 봐야 하는데. 난 온갖 강력한 짐승들로 자유롭게 변신할 수  있다고. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = dfb56b70-bc25-6a4b-e747-3576e53f1863
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:dfb56b70-bc25-6a4b-e747-3576e53f1863
msgctxt "h6839237cgf2abg40begb71dg2ba472e772b2"
msgid ""
"Respect you must have proven yourself unworthy of. And now you waste my time."
msgstr "가치를 잃어버린 너를 더 이상 존경할 이유는 없겠군. 이 이상 대화하는 건 시간 낭비야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = e0097fc8-06f7-7569-e616-fccf8c0ddb7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:e0097fc8-06f7-7569-e616-fccf8c0ddb7c
msgctxt "h183ca991g0bb8g44d0gad28gd7dc1cca6af8"
msgid ""
"Careful. You may be a True Soul, but I will not <i>hesitate</i> to enforce "
"Her will."
msgstr "조심해라. 네가 참된 영혼일 수는 있지만, 내가 그 분의 의지를 집행할 때는 <i>망설이지</i> 않을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = e3c41442-48a6-53b5-d3c1-1fc3c37d9b25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:e3c41442-48a6-53b5-d3c1-1fc3c37d9b25
msgctxt "hf2fe10a8gfda1g460fg91a4gbd851a994ea2"
msgid "I didn't know we were so hard-pressed for staff."
msgstr "인력이 그렇게나 부족한 줄은 미처 몰랐군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = e458f3d2-779b-daa3-f3b6-c5139749ca43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_PrisonerInterogationAllowed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:e458f3d2-779b-daa3-f3b6-c5139749ca43
msgctxt "h85e98942g7e24g4cb2gb685g652d0b0e0324"
msgid ""
"Is someone feeling rebellious, True Soul? Fine. Speak to them if you wish - "
"but when I catch you, and I <i>will </i>catch you."
msgstr ""
"누군가 반항심을 느끼는가 보군, 참된 영혼? 좋아. 원한다면 이야기 해, 하지만 나한테 걸리기만 하면, 참고로 널 잡으러 갈 "
"<i>거야</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = e468d4dc-cbcb-c74c-0ab2-07bbc0c42fa7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:e468d4dc-cbcb-c74c-0ab2-07bbc0c42fa7
msgctxt "ha57e9875g7d12g43a2g9e28g14d19ee8b87f"
msgid ""
"I'm not sure why someone of your stature must converse with prisoners. "
"Perhaps a small donation would convince me."
msgstr ""
"왜 너 정도의 위상이 있는 자가 죄수들과 대화하고 싶어하는지 이해할수 없군. 약간 기부해 준다면 내가 이해할수 있을지도 모르지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = e4daab49-bb96-3593-f2f1-d132b39d8561
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:e4daab49-bb96-3593-f2f1-d132b39d8561
msgctxt "h53415b31g2963g4883gb1c8g96db69150827"
msgid ""
"I am a paladin - my word is my bond. I have good reason to speak to the "
"prisoners, I swear it."
msgstr "나는 팔라딘이다. 허튼 말은 하지 않아. 맹세컨대, 죄수들과 이야기를 나눠야만 하는 중대한 이유가 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = e59e107b-62be-919c-88c4-636fb10dd9b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:e59e107b-62be-919c-88c4-636fb10dd9b0
msgctxt "h5ee346b8gef65g4f29g932fgd512c89c9a53"
msgid "Then you'll get your own cell."
msgstr "그럼 너도 감옥에 방 하나 얻는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = e870218c-65f1-6a19-3e16-4523a0efd7f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFLING(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:e870218c-65f1-6a19-3e16-4523a0efd7f6
msgctxt "h7cb09c2dge15fg4661gb65dg143f9009cb5e"
msgid "Not the cheeriest greeting I've ever had."
msgstr "썩 반가운 인사 방법은 아니로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = ee191c92-8193-c422-aafb-da44beb2f13f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:ee191c92-8193-c422-aafb-da44beb2f13f
msgctxt "h9d99a6b9g6279g41f9g9892gf6f2de008b7e"
msgid ""
"I'm <i>sure </i>you do. Alas, I am not quite convinced. Perhaps a small "
"donation would help."
msgstr "<i>당연히 </i> 그러시겠지. 하지만, 난 별로 설득될 기분이 아니로군. 어쩌면 약간의 기부가 도움이 될지도 모르겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Narrator
#. NodeID = f30b5f4b-5857-b502-5d53-c926fe1f26fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:f30b5f4b-5857-b502-5d53-c926fe1f26fd
msgctxt "hc35b8aa7g225bg48eeg8c2dgf8babae287a7"
msgid ""
"*And interesting items confiscated from prisoners lie above the Warden's "
"office, just up the ladder.*"
msgstr "*그리고 수감자들로 부터 압수한 흥미로운 물건들은 사무실 위층에 있습니다. 사다리를 타고 올라갈 수 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = f34f5a11-f028-01f6-60cd-2e1e7aeb2e54
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_State_WardenInspecting = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:f34f5a11-f028-01f6-60cd-2e1e7aeb2e54
msgctxt "h9e0ba012gb796g49f6gb19eg194929fc9e9d"
msgid ""
"A fair point. And they should remember who decides their fate - it will do "
"them <i>good.</i>"
msgstr "일리 있군. 그러고 나면 자기들 운명이 누구 손에 달려 있는지 아주 <i>잘</i> 알게 되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = f44ebfcf-e590-eb95-4208-3dc75ffbe90f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:f44ebfcf-e590-eb95-4208-3dc75ffbe90f
msgctxt "h93305c61g1bd5g44fegb82cgbd02d960e9d5"
msgid ""
"Disciple Balthazar's orders still stand - none may speak to the prisoners. "
"You can go now."
msgstr "누구도 죄수와 대화할 수 없다는 신봉자 발타자르의 명령은 아직 유효하다. 이제 가보도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = f6979d7a-877a-9d6f-c941-6c04983fcccf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:f6979d7a-877a-9d6f-c941-6c04983fcccf
msgctxt "h6b501a3cg493cg486egb786g04d1f4bd2052"
msgid ""
"No need. The scrying eyes are keeping watch, and my patrols can handle "
"<i>gnomes.</i>"
msgstr "그럴 필요까지야. 감시하는 수정구가 경계를 서고 있고, 내 순찰병들도 <i>노움</i> 따위야 감당하고도 남지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = f6f46b10-9cb8-aa18-eda4-800787cda66e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:f6f46b10-9cb8-aa18-eda4-800787cda66e
msgctxt "h2da49313g289ag455dg82f2g7419c1ac98bc"
msgid "You're not bothered that you'll be killed?"
msgstr "죽음이 두렵지는 않나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = f8f2e6e6-9b0f-6807-a31b-e34d44126196
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:f8f2e6e6-9b0f-6807-a31b-e34d44126196
msgctxt "ha7b8d526g20dag4c19g9904g9cd590ddb1c1"
msgid ""
"The prisoners have escaped - and the blame falls on me. I will be split "
"open, my innards splayed before the eyes of the Absolute."
msgstr "죄수들이 탈출했고 - 전부 나 때문이로군. 곧 내 배가 갈라지고, 그 내장들이 절대자의 눈앞에 놓이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = f9779f20-4cbd-25ca-bbad-b83d195a5c3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Warden_Event_ThreatenedPlayer(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:f9779f20-4cbd-25ca-bbad-b83d195a5c3a
msgctxt "hf636f86ag0701g4842ga5e3g9310c543d35e"
msgid "I heard you the first time."
msgstr "그 말은 아까도 들었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = fb0f20d0-428a-2b87-f4b3-b8cc2b801ce7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:fb0f20d0-428a-2b87-f4b3-b8cc2b801ce7
msgctxt "hd28e3c58g66e1g497agae84g1bcf1de79626"
msgid "You're going to tell me <i>everything </i>you know."
msgstr "네가 아는 것을 <i>전부</i> 말해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = fb6f484a-ecca-9356-f270-a6b19f889b74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:fb6f484a-ecca-9356-f270-a6b19f889b74
msgctxt "h794b2442g190cg4583gaacfg6b792bc6f36c"
msgid ""
"If you are going to stare, kindly do it elsewhere. As I said - you are free "
"to roam where you wish, but do not speak to the prisoners."
msgstr ""
"계속 그렇게 쳐다볼 거면, 부탁이니 다른 데 가서 그러도록. 이미 말했다시피 - 돌아다니는 건 네 자유지만, 죄수들과 대화를 나누지만 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = Player
#. NodeID = fc1f787c-0ba2-902c-f8c6-4c747be7942a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:fc1f787c-0ba2-902c-f8c6-4c747be7942a
msgctxt "h85d86df3g847cg43e1g9f0agcafdada05fbb"
msgid "I'm sorry."
msgstr "유감이로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = fcf97068-87cc-dc7e-4c0c-da4cf3ddde8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:fcf97068-87cc-dc7e-4c0c-da4cf3ddde8d
msgctxt "hd0342b6eg8b91g4227g8849ge6ae90066b0a"
msgid "Hm. Perhaps not - your face is rather <i>bland.</i>"
msgstr "흠. 아닌 것 같기도 하고. 네 얼굴은 꽤나 <i>밋밋한걸.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden
#. Speaker = The Warden
#. NodeID = fef70f69-30ea-7403-403d-323420598b61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Warden:fef70f69-30ea-7403-403d-323420598b61
msgctxt "h685fa99fg8ad7g4c88gb698gc73076285d2b"
msgid "Most wise, True Soul."
msgstr "현명한 선택이야, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 0278cd11-84ad-cb55-bc35-a2ca07513e95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:0278cd11-84ad-cb55-bc35-a2ca07513e95
msgctxt "h407aa1dbg50c2g4098g9038gddd5f917c06d"
msgid "...Barcus is out here? Didn't think he had the stones."
msgstr "...바커스가 날 찾으러 왔다고? 그럴 배짱이 있는 줄은 몰랐는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 030fada6-5a44-fb57-383c-a37b45baf834
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:030fada6-5a44-fb57-383c-a37b45baf834
msgctxt "hbc08a2a8ga3beg4944g9503g6cd6796b7deb"
msgid "Freedom - both yours and mine, I'm hoping."
msgstr "자유로 향하는 길이길 빌어야지. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 03eddc6e-07a3-a7d8-f25f-151e0dcf1130
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:03eddc6e-07a3-a7d8-f25f-151e0dcf1130
msgctxt "h749104eeg0fdfg4d15gb307gb3c5a7c8426a"
msgid ""
"We need tools. That headcase of a Warden robbed ours, but anything that "
"breaks rock will do - even if it's not Ironhand quality."
msgstr ""
"일단 도구가 필요해. 그 나사 풀린 간수장이 우리 물건을 뺏어가긴 했지만, 바위를 부수는 데 도움이 될 물건이라면 아무거나 괜찮아 - "
"아이언핸드 수준까진 바라지도 않는다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 0574ec91-3e30-dfc8-29da-73f093625d4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:0574ec91-3e30-dfc8-29da-73f093625d4b
msgctxt "heaabee75g43cdg4b79gb076gcbb69210fc2d"
msgid ""
"Daring is the heart of courage, but we can't risk it - not unless there's no "
"other choice."
msgstr "용감한 행동이긴 하지만, 우린 위험을 감수할 처지가 아니야 - 아직 다른 선택지가 남아있는 한은 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 05b65480-feb0-8cde-e489-d048676ea9a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:05b65480-feb0-8cde-e489-d048676ea9a5
msgctxt "h92a48c50gfd96g4b1bgba62ga54df18ef566"
msgid "Stop whining - at least I'm fighting back against the Absolute."
msgstr "징징대지 좀 마. 어찌됐건 난 절대자에 맞서 싸우는 중이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 060d4980-e173-c8bb-3fe9-123dbf322d8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:060d4980-e173-c8bb-3fe9-123dbf322d8e
msgctxt "h781f672egce37g4240g9cfbg58624c509688"
msgid "Gaerdal help me."
msgstr "게어달이시여 도와주소서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 074b7d81-a643-a25d-1e33-56af10ca0844
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:074b7d81-a643-a25d-1e33-56af10ca0844
msgctxt "h96b7029ege468g4593g8c9cg79fd6df6125d"
msgid "Hurry - or we're all <i>dead.</i>"
msgstr "서둘러 - 아니면 우린 모두 <i> 죽을 거야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 086effe9-4e3e-0759-6f28-c92b4986e1fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:086effe9-4e3e-0759-6f28-c92b4986e1fa
msgctxt "hb70ce43agece0g4925ga877g94c5ffa4b051"
msgid "Determined? Good - we'll need it. Now, go - before the guards see."
msgstr "의지가 대단한데? 좋아. 나쁘지 않지. 어서 가자. 경비들이 알아채기 전에. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 0ccdeca2-91aa-3d45-e96f-8c6930a4efaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:0ccdeca2-91aa-3d45-e96f-8c6930a4efaa
msgctxt "h9e05b24bgd750g4e64g839agcfb8d2117cde"
msgid "Shh. I'm going to get you out of here."
msgstr "쉿. 당신들을 여기서 풀어주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 0ed3b2e9-75cc-7694-a521-63dc9b3e7797
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:0ed3b2e9-75cc-7694-a521-63dc9b3e7797
msgctxt "hf2ad1abegbe7fg4ac9g839dg513700096996"
msgid ""
"Hey! We're dead if you don't help, all right? Either throw me something to "
"crack open the back wall, or get these damn doors open. Hurry!"
msgstr "이봐! 당신이 돕지 않으면 우린 죽은 목숨이야, 뒤쪽 벽을 부술만한 걸 던져주던가, 문을 열어줘. 어서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 0f35eab4-d389-66b0-ca46-7d958c78f6d7
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_TieflingsInJail = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:0f35eab4-d389-66b0-ca46-7d958c78f6d7
msgctxt "h3ec086a3gbb10g4a7cg909bgcbaf7fb21912"
msgid "Trusted by other prisoners"
msgstr "다른 죄수들이 신뢰함"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 0f35eab4-d389-66b0-ca46-7d958c78f6d7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_TieflingsInJail = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:0f35eab4-d389-66b0-ca46-7d958c78f6d7
msgctxt "h4fa3b431g7dafg4b3cg8384g4bd3d6734065"
msgid "I know the tieflings imprisoned here - I want to break you all out."
msgstr "티플링들이 여기 갇힌 걸 알아. 너희 전부 탈출시켜 주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 12d6bf79-eae6-36ff-e413-947bf083b937
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:12d6bf79-eae6-36ff-e413-947bf083b937
msgctxt "h4ba2e2d9gd0c1g442bgb462g4b326914ea9b"
msgid "If it ruins the Absolute's day, I'm in."
msgstr "절대자에게 한 방 먹여줄 수만 있다면야, 그렇게 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 136d26be-3957-6e75-b877-cf55bb108b94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:136d26be-3957-6e75-b877-cf55bb108b94
msgctxt "h9d80a27bgb61eg41begb35ag0de8514aa08e"
msgid "Be my guest."
msgstr "네가 하지 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 1498999c-d555-eca6-b710-7044a66067e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_WulbrenSuspicious(1) = False
#.   Global:
#.      - MOO_Jailbreak_State_WulbrenSuspicious = True
#.      - MOO_Jailbreak_Knows_ToolsNeeded = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Wulbren(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:1498999c-d555-eca6-b710-7044a66067e2
msgctxt "h03702fcfgb385g44f7gbc1fgc3a8da4a2fb5"
msgid ""
"Your friend is some smooth talker to shut a guard down like that. What do "
"you lot want with me, exactly?"
msgstr "경비를 몇 마디 말로 물리치다니 정말 대단한 혀를 가졌군. 나한테 원하는 게 정확히 뭐지? "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 15649d4b-35d0-6bca-12ed-857d270dc6d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:15649d4b-35d0-6bca-12ed-857d270dc6d1
msgctxt "hbc003583g9a47g479dgb603g07956569b188"
msgid "I wouldn't be so foolish as to think I could escape the Absolute."
msgstr "절대자에게서 탈출할 수 있다고 생각할 만큼 어리석진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 15d5e0b6-eaf8-fd32-cca1-ab4512f944b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_WulbrenAlerted = True
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Wulbren(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:15d5e0b6-eaf8-fd32-cca1-ab4512f944b6
msgctxt "h066258ebgc592g458fga4e6gfd3f0db22a0c"
msgid ""
"Your mate spooked the guards - we can't afford another slip up, not with the "
"eyes of the Absolute everywhere."
msgstr "네 동료가 경비들을 놀래켰잖아. 다시는 그런 실수를 해서는 안 돼. 절대자의 눈은 어디에나 있단 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 1634cbc1-1eeb-863f-7ecb-b4f98fb140e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:1634cbc1-1eeb-863f-7ecb-b4f98fb140e7
msgctxt "ha9f427afgf91cg4e03gb044gef3b1fde38c8"
msgid "Lies, lies lies - I owe your sort <i>nothing</i>."
msgstr "거짓말, 거짓말 거짓말... 너와 같은 부류한텐 <i>아무것도</i> 빚지지 않겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 1791d845-f5fa-0e87-1282-2f5ca9d46188
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#.   Object:
#.      - IsInPrison(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:1791d845-f5fa-0e87-1282-2f5ca9d46188
msgctxt "h3ebfadbega034g44e7g9476g16245bb4728e"
msgid "...A minor hiccup in our escape plan, I see."
msgstr "...우리 탈출 계획에 조그마한 차질이 빚어진 모양이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 17f191d9-0ec5-1f46-72e2-4fa8748d1ac3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:17f191d9-0ec5-1f46-72e2-4fa8748d1ac3
msgctxt "h65e03e55g6609g46c6g8c81g649b5ce4f014"
msgid ""
"The Absolute thinks she's got you by the scruff of the neck, but it's the "
"other way round, isn't it?"
msgstr "절대자는 자기가 네 목덜미를 쥐고 있다고 생각하겠지만, 사실은 그 반대다 이거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 1b8963e9-b3e5-5804-12f9-1bf2ce9ab28c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:1b8963e9-b3e5-5804-12f9-1bf2ce9ab28c
msgctxt "h48e84000g97a5g4b49gbff6g7306e5fbbcaa"
msgid "Run along, True Soul."
msgstr "저리 가, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 1bcf022c-845d-a416-6d7d-684da83d112d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:1bcf022c-845d-a416-6d7d-684da83d112d
msgctxt "h4248414bga798g44afg8e5dgb5441aef9521"
msgid "Not surprised - the egos around here are made of bloody glass."
msgstr "놀랄 일도 아니군. 여기 있는 녀석들의 자의식은 망할 유리로 되어있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 1beae0fb-716f-639a-66f9-181793519a75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:1beae0fb-716f-639a-66f9-181793519a75
msgctxt "h9dd761cegd9abg4affg9dd9g07e41c13405a"
msgid "The guards are out for blood - and their eyes are on us."
msgstr "보초들이 피를 보려고 작정했어. 그리고 우리에게 눈독을 들였지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 1c4b6c19-d14d-eb8f-b6fe-fb288057bdd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:1c4b6c19-d14d-eb8f-b6fe-fb288057bdd5
msgctxt "ha4856d6bg916dg417dgb1a2g1f76b5f550e4"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 1da9fb70-420f-17d8-71b5-b0e6c1312d3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_SpeakToGnomesWarning(1) = True
#.   Global:
#.      - MOO_Jailbreak_State_WulbrenAlerted = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:1da9fb70-420f-17d8-71b5-b0e6c1312d3c
msgctxt "h820c25ceg6263g4fccga7f7gf47a46d00bc5"
msgid ""
"Look, I'm all out of options, so I'm going to trust you. Don't make me "
"regret it."
msgstr "보다시피, 별다른 선택지가 없으니, 일단은 널 믿겠어. 부디 후회하게 만들지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 1ef00d52-78fe-ea3a-741a-a1c77239d95e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:1ef00d52-78fe-ea3a-741a-a1c77239d95e
msgctxt "h600e0d7agfa62g48eagb508gd2cac669c1ae"
msgid "My mind is my own - the Absolute has no control over me."
msgstr "내 정신은 나의 것이야. 절대자는 나를 통제하지 못해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 1f9b79e1-4417-f5a6-025f-73abed689fd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_ToldAboutHole(1) = True
#.   Object:
#.      - IsInPrison(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:1f9b79e1-4417-f5a6-025f-73abed689fd7
msgctxt "hecb84a1dg8ee5g49f1gb3f0g50fe08183f17"
msgid ""
"Don't let fear cloud your heart, friend. Jump - or risk rotting here with "
"the rest of us."
msgstr "두려움에 잠식되지 않도록 해. 뛰어넘든지, 아니면 우리랑 함께 여기서 썩든지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 2048cac0-402b-9d9c-4369-70e861073740
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#. TagRule: CLERIC_EVIL or OATHBREAKER or PALADIN_EVIL or PALADIN_VENGEANCE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:2048cac0-402b-9d9c-4369-70e861073740
msgctxt "h67a0c025g3030g48bdgacfbg31b043697ceb"
msgid "Helping you hurts the Absolute - and I take pleasure in that."
msgstr "널 돕는 게 절대자를 해치는 길이지, 그리고 난 그게 즐겁다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 216f8c0d-aabc-1ea5-3aa9-1c2e0d44a1b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:216f8c0d-aabc-1ea5-3aa9-1c2e0d44a1b3
msgctxt "hcd5727d4g09cag4749g9cb8gc60cd5320130"
msgid "What if I were here to help you escape?"
msgstr "만약 내가 탈출을 도와주러 온 거라면?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 21967e1a-0d71-fab3-8fdc-b2eb6c00b16c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:21967e1a-0d71-fab3-8fdc-b2eb6c00b16c
msgctxt "haa31e8d7g691bg4348g8998gdc64c5cdc0b1"
msgid ""
"If it gave the Absolute and her cronies a headache all I can say is - well "
"bloody done."
msgstr "그걸로 절대자와 그 무리들의 골치를 아프게 하기만 했다면, 아주 훌륭한 일을 한 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 224012bf-84e0-a397-b1cb-faa0194a49f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:224012bf-84e0-a397-b1cb-faa0194a49f4
msgctxt "hc8e8f083g72afg48e2g8df8gffb6a41a93be"
msgid "I could help you get out of here - for a price."
msgstr "탈출하는 걸 도와줄 수도 있어. 값만 치른다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 24691a8f-7dec-1882-0c50-888cfd577b7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:24691a8f-7dec-1882-0c50-888cfd577b7d
msgctxt "hfa1935e7g9b14g4a09g95f2gbf0ed3000343"
msgid "These cultists had it coming."
msgstr "사교도 놈들이 자처한 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 25ab97ae-9fef-4c73-ef45-a8497079f437
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:25ab97ae-9fef-4c73-ef45-a8497079f437
msgctxt "h5faa89f6g4b6cg4250gb237g43c52e14192d"
msgid "The Warden has eyes everywhere. And ears."
msgstr "간수장은 사방에 눈이 있어. 그리고 귀도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 26e87bf1-f150-193f-5992-4e9797778dae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:26e87bf1-f150-193f-5992-4e9797778dae
msgctxt "h38be699ag6410g4103gacd7g2a84d18b748a"
msgid ""
"Nickels: tools - get creative. This rock is basalt - it'll crack with enough "
"pressure."
msgstr "니클스: 공구를 잘 활용해봐. 이 바위들은 현무암이니 - 충분한 힘이 가해지면 부서질거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 28b2f058-1578-16e4-b076-d7049274c815
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_ToldAboutHole(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:28b2f058-1578-16e4-b076-d7049274c815
msgctxt "h7eff5709gfd13g4413g84cfgd455a66b43ca"
msgid ""
"Cast your eyes to the back - see that hole yonder? I'd bet my last copper "
"that's your ticket out."
msgstr "저 뒤쪽을 좀 봐 - 저기 구멍 보여? 저게 바로 네 탈출구라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 2dbd82db-79d7-914b-e669-5ef6497022b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_WulbrenAlerted = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:2dbd82db-79d7-914b-e669-5ef6497022b7
msgctxt "h343acdcage4afg496fgb502g72e4f0cbbca1"
msgid "Listen, your mate nearly got done in by the eyes - there's no time."
msgstr "잘 들어, 네 동료가 하마터면 놈들한테 걸릴 뻔 했어. 시간이 없다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 2dc33229-eb3b-a075-65b9-82274fe91010
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:2dc33229-eb3b-a075-65b9-82274fe91010
msgctxt "h9b1f15a6g5ccfg4214gba70gfdb7d02391a8"
msgid "It's not without risk, but the same can be said for all great causes."
msgstr "위험이 없는 건 아니야. 하지만 대의에는 늘 위험이 따르는 법이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 2e6b6d07-c910-ac47-a391-f7a0877c2d24
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:2e6b6d07-c910-ac47-a391-f7a0877c2d24
msgctxt "h3032a45bg6299g47f6g8ad5ge374de5624dc"
msgid "I'm an undercover agent for the Flaming Fist."
msgstr "나는 플레이밍 피스트의 비밀 요원이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 2eba023c-4fe3-3d1b-83a8-10ebce0c8092
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_HasToolForGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:2eba023c-4fe3-3d1b-83a8-10ebce0c8092
msgctxt "h57b367a5gc8b3g4d6dga203g76293ab1067e"
msgid "I have the tools you need - take them."
msgstr "필요한 도구를 가지고 왔어 - 받아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 3083d61d-7794-1a7d-6888-df8c616f49c0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_WulbrenSuspicious(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:3083d61d-7794-1a7d-6888-df8c616f49c0
msgctxt "h3948f731gacc8g4bd1gb4cegaaf984842288"
msgid "I'm here to help you escape."
msgstr "탈출을 도와주러 왔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 308b854d-8341-a965-d15c-4c7a6529ab85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:308b854d-8341-a965-d15c-4c7a6529ab85
msgctxt "h84b8828bgbcc2g4015gb8c8gaaacee5b43d6"
msgid ""
"*Sigh.* Of course one of my own would be my undoing. Fine - we're planning "
"to escape. So, are you gonna run off and tell your little Warden?"
msgstr ""
"*한숨.* 내 일을 방해하는 게 동족일 줄이야. 그래, 우린 지금 탈출을 계획중이야. 이제 쪼르르 달려가서 간수장한테 이르기라도 할 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 315365fa-9126-4c71-2e72-ecc97c98815d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:315365fa-9126-4c71-2e72-ecc97c98815d
msgctxt "h01c1e329g0c63g4604gb74fgc89cb1cbb467"
msgid "I <i>could </i>tell the Warden, or I could help you - for a price."
msgstr "간수장한테 말을 <i>할 수도</i> 있고, 널 도와줄 수도 있고. 값만 치르면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 31b9269a-7c31-5985-7afa-74529dfc0040
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:31b9269a-7c31-5985-7afa-74529dfc0040
msgctxt "h3b65e9a3g3943g4b79g9143g4255df58a03b"
msgid "I know exactly what I'm doing."
msgstr "다 내 계획대로 진행되고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 31d5116d-a799-21b4-4254-ef6804d91f75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:31d5116d-a799-21b4-4254-ef6804d91f75
msgctxt "h6a058835g9d74g4ba5gb7b9g4dbfd09c056a"
msgid "Huh. And why would you be so inclined?"
msgstr "하. 도대체 무슨 속셈으로?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 34ee5586-3618-52a7-e248-96d1d30e28f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:34ee5586-3618-52a7-e248-96d1d30e28f4
msgctxt "h55e42ec3g43feg44b2gb78fgc17588114253"
msgid "Why don't we fight our way out?"
msgstr "그냥 싸워서 탈출하면 안 되나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 37fdb8c7-a857-05b6-6bcd-e2bae605351d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:37fdb8c7-a857-05b6-6bcd-e2bae605351d
msgctxt "h76fa925bgd952g4865gbbcbgdd9b2aea8f56"
msgid ""
"Those spitfires? They certainly gave the guards a run for their money. And "
"they'd be a help in the escape..."
msgstr "그 다혈질 녀석들? 확실히 경비들에게 한 방 먹였었지. 탈출할 때 도움이 될 거야..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 3d4b551e-2456-c954-0cbb-761da38f280a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:3d4b551e-2456-c954-0cbb-761da38f280a
msgctxt "he4ccb441gd60cg4b70g8691gec157c1c585f"
msgid "How did you end up in here?"
msgstr "어쩌다 여기 갇힌 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 3e23279f-b655-446a-48fd-59d77549d4f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:3e23279f-b655-446a-48fd-59d77549d4f7
msgctxt "ha04ad6a2gd9e4g4216ga1bbge0787a431a3a"
msgid "Didn't doubt you for a moment, friend."
msgstr "조금도 의심한 적 없다고, 친구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 42ba1e08-968d-ff74-ce15-4b2788efc6b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:42ba1e08-968d-ff74-ce15-4b2788efc6b5
msgctxt "h2efe0373g9044g4451g8ea8g497a1b9c6d7e"
msgid "What are you talking about?"
msgstr "뭔 말을 하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 46fe1a7c-1ce7-6702-37bd-e1fec4125cf1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Wulbren(1) = True
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:46fe1a7c-1ce7-6702-37bd-e1fec4125cf1
msgctxt "h33188807g7698g44fdgbfedg112b91875500"
msgid "Your feet fly fast, my friend. Any luck with those tools?"
msgstr "더럽게 빠르군, 친구. 도구는 좀 찾았나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 48dbf90e-2ac2-51f0-41fa-6bdee8bd2b55
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:48dbf90e-2ac2-51f0-41fa-6bdee8bd2b55
msgctxt "h3178ce44gf8afg4687gbe79g372e47bcbd26"
msgid "ACCEPT MY HELP. OR DIE. <b>CHOOSE.</b>"
msgstr "<b>내 도움을 받아라. 아니면 죽든가. 선택해.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 48dbf90e-2ac2-51f0-41fa-6bdee8bd2b55
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:48dbf90e-2ac2-51f0-41fa-6bdee8bd2b55
msgctxt "h45871567g0c02g41f1g87c4g46c14075a60b"
msgid "Accept my help or die in this pit - choose."
msgstr "내 도움을 수락하던가 이 구덩이에서 죽던가, 골라라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 4b30ca60-a5a2-8189-c4a2-c4206c2a7bf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:4b30ca60-a5a2-8189-c4a2-c4206c2a7bf6
msgctxt "haedb0521gc3d3g4ed4ga637g5d9c565a4fdb"
msgid "Let's talk escape plan - what do you need?"
msgstr "탈출 계획에 대해 얘기해 보자. 뭐가 필요하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 4ed82991-2974-f6d4-2e46-e10a674427af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:4ed82991-2974-f6d4-2e46-e10a674427af
msgctxt "h2c7a9a50gf3ceg4ecegbe5dge4d226a27a27"
msgid ""
"We've a plan - but all the determination in the world is nothing without the "
"right equipment."
msgstr "계획이 있어, 하지만 세상 결심을 다 끌어모아도 알맞은 장비 없인 무용지물인 법이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 4f7852bb-eaa7-2e78-834e-3f385c3a5933
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:4f7852bb-eaa7-2e78-834e-3f385c3a5933
msgctxt "h734d1f93g2901g4093g9472gff8bfb1ce81f"
msgid "The usual criminal debauchery."
msgstr "으레 하는 범죄 행위를 저질렀지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 4fb6455a-67a0-b8c3-3234-1c81e347693e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:4fb6455a-67a0-b8c3-3234-1c81e347693e
msgctxt "h402f4ae3gea78g4680g9e6ege974c8422441"
msgid "Get out of here - while you have the chance."
msgstr "여기서 나가. 기회가 있을 때 놓치지 말라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 5086741f-e545-7b2f-d4e4-86f1877d4345
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:5086741f-e545-7b2f-d4e4-86f1877d4345
msgctxt "h0ead8fd2g8760g4262g814dg8fbdc4518171"
msgid "You'll owe me a favour after. Besides - I never liked prisons much."
msgstr "넌 내게 하나 빚진 거야. 무엇보다, 난 감옥이 썩 맘에 들지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 510c386a-f67a-9588-3669-ec2a0ec1f0b7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#. TagRule: PALADIN and !(OATHBREAKER and PALADIN_EVIL and PALADIN_VENGEANCE)
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:510c386a-f67a-9588-3669-ec2a0ec1f0b7
msgctxt "he3501290ge23bg407fga03fg323490a3d88a"
msgid ""
"My oath bids me so - I infiltrated this place just to undermine the Absolute."
msgstr "내가 한 맹세 때문이지. 난 절대자를 무너뜨리고자 이곳에 잠입했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 510c386a-f67a-9588-3669-ec2a0ec1f0b7
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#. TagRule: CLERIC
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:510c386a-f67a-9588-3669-ec2a0ec1f0b7
msgctxt "h84c6ac05g01f4g4d8fg9d83gcea55f47e8d7"
msgid ""
"I am sworn to a higher power - I infiltrated this place just to undermine "
"the Absolute."
msgstr "난 그보다 더 높은 힘을 섬긴다. 난 절대자를 무너뜨리고자 이곳에 잠입했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 511b4a4c-194d-b573-fe21-985f75e726f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:511b4a4c-194d-b573-fe21-985f75e726f8
msgctxt "h7938a3b0g467ag4037g97b8g1e51f8b47cd3"
msgid "Me neither. Nasty little boxes too often used to quash genius."
msgstr "나도 마찬가지야. 천재를 억압하기 위해 지나치게 많이 사용되는 역하고 조그만 공간이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 513c5596-f938-899d-4a15-a5189190987c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:513c5596-f938-899d-4a15-a5189190987c
msgctxt "h1a008244g3518g40ccgb829g8e933b4c278d"
msgid ""
"...You're welcome. If you change your mind, I'll be here - not that I have "
"much choice."
msgstr "...천만에. 마음이 바뀌면 여기 오라고. 내겐 별다른 수가 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 51e29972-c407-7310-c922-c84c51c3e6d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:51e29972-c407-7310-c922-c84c51c3e6d0
msgctxt "h185fccf1g8d4fg4f6cga8c7g858536a2210c"
msgid "Are you Wulbren? Barcus sent me."
msgstr "네가 울브렌인가? 바커스가 보냈다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 549a4184-fa48-9c48-df4e-c38ac091f301
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_GnomesHaveTools = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_WulbrenWithTool(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:549a4184-fa48-9c48-df4e-c38ac091f301
msgctxt "hcae9189eg3d7fg4daeg915bg3f9ef6f481b3"
msgid ""
"Good work - we're gonna wait until it's quiet, then bust out the back wall."
msgstr "잘 했어 - 이제 때를 기다렸다가, 벽을 무너뜨리고 탈출해야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 54e373a8-a67b-f124-e367-c8d9dad2a41c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:54e373a8-a67b-f124-e367-c8d9dad2a41c
msgctxt "h936f2c48g1d06g4b41g9290g4b6b86822bc3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 55e08402-9fee-cd4b-810e-9155d1c51239
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Wulbren(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:55e08402-9fee-cd4b-810e-9155d1c51239
msgctxt "h0c5b718cgeffdg4fa9g9c6dg948f8cdd1eb7"
msgid ""
"Your friend is lending a hand, but I'll not turn down extra help. Got any "
"tools?"
msgstr "네 친구가 도와주고 있지만, 추가적인 도움을 마다하진 않겠어. 도구 가져왔나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 58a1409f-713e-ea5e-4633-ecc481068029
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:58a1409f-713e-ea5e-4633-ecc481068029
msgctxt "h86dbd9a3gcfd1g443ag9ce2ge77ac9719495"
msgid "Because we can't let the Absolute win. Not now, not ever."
msgstr "절대자가 이기게 둘 순 없기 때문이지. 지금도, 앞으로도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 596ef554-f099-4e09-60cd-824da622ac23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:596ef554-f099-4e09-60cd-824da622ac23
msgctxt "hc6a2ab87gc528g42f0gbfb9gb85b42438f78"
msgid "Thank you - for fighting back when so few do."
msgstr "고마워. 거의 아무도 그러지 않는데 맞서 싸워줘서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 5b46cb98-124b-6f2a-c1ce-2a34724aa95e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#.   Global:
#.      - MOO_Jailbreak_State_WulbrenAlerted = True
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_WulbrenAlert(1) = True
#.     - MOO_Jailbreak_HasMet_Wulbren(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:5b46cb98-124b-6f2a-c1ce-2a34724aa95e
msgctxt "h3c6b2f38g23f5g4424g882ag1da38d779a0d"
msgid ""
"You've had a change of heart, have you? I'd question it, but there's no time."
msgstr "심경에 변화라도 생긴 모양이지? 의구심이 없는 건 아니지만, 지금은 시간이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 5ee1a548-8585-754f-2ae2-06ca7333cf04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:5ee1a548-8585-754f-2ae2-06ca7333cf04
msgctxt "h3d171058g2704g43f6g8ad1g44065e338114"
msgid "Hold in your cell until I return."
msgstr "내가 돌아올 때까지 가만히 기다려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 61b7b3a2-9340-007a-1d2c-73f22ba95f53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:61b7b3a2-9340-007a-1d2c-73f22ba95f53
msgctxt "h9153c88dg52a9g4f1ag8abagb841138462ea"
msgid "All that matters is how we're gonna get out."
msgstr "지금 중요한 건 어떻게 빠져나가느냐야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 636c409d-578a-91ab-781a-85298f42722f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:636c409d-578a-91ab-781a-85298f42722f
msgctxt "h1c454773g6a06g41d5g97b8g8a226da1df7d"
msgid "Remind me to stay on your good side."
msgstr "너랑은 꼭 척지지 말고 같이 다녀야겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 63d662a0-bb48-c6d7-1217-e12cf89ac077
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:63d662a0-bb48-c6d7-1217-e12cf89ac077
msgctxt "h6e202ad9g8b7bg475eg8b7eg9ebb482c5b0d"
msgid "What do I get out of it?"
msgstr "그래서 내가 얻는 게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 6696d36d-141a-08fd-34c6-d9e1f8b1958e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:6696d36d-141a-08fd-34c6-d9e1f8b1958e
msgctxt "h79f83696g64b5g481dg8ce2gcd2fb2b64dc3"
msgid "I've a plan that'll make all of Moonrise rue the day they met us."
msgstr "왜냐면 우릴 만났다는 사실 자체를 문라이즈 전체가 저주하게 만들 계획이 이 몸한테 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 69c8522d-ff37-95bf-8f88-5b14b8eb9c35
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:69c8522d-ff37-95bf-8f88-5b14b8eb9c35
msgctxt "h78d54d9fg9fb9g45ddga844g109fae5f8d93"
msgid "I don't have time for this. You're on your own."
msgstr "이럴 시간 없다. 네가 알아서 하도록 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 6a179ffd-28eb-9352-afb5-1ffdf0062532
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_WulbrenAtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:6a179ffd-28eb-9352-afb5-1ffdf0062532
msgctxt "ha8a20d6dg7620g4fe8gb06fgc4712bcde49b"
msgid "Not now - this boat is tied up tight."
msgstr "나중에 얘기해 - 이 보트를 풀어야 한다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 6a60ecb0-3249-406e-c876-ed1a903c2043
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:6a60ecb0-3249-406e-c876-ed1a903c2043
msgctxt "h1a10abfeg1467g4003g96c8g22333410b99b"
msgid ""
"...<i>Tools. </i>Something that can crack rock - like a hammer. Without it, "
"we're doomed to rot in this hellspit."
msgstr ""
"...<i>도구</i> 말이야. 바위를 부술 수 있는 것들, 망치라던지. 그런 게 없으면, 우린 이 지옥 구덩이에서 썩어갈 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 6c8c0e2b-5237-7943-bb01-cc4c34857f53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:6c8c0e2b-5237-7943-bb01-cc4c34857f53
msgctxt "h56a5e9a2g7ef4g4237gb223g507c655dcbc7"
msgid ""
"Shouldn't you be assisting the Absolute - perhaps by torturing a sweet "
"grandmother, or brainwashing school children?"
msgstr "넌 절대자를 도와야 하지 않나? 사랑스러운 할머니를 고문하거나, 학교 아이들을 세뇌하거나 해서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 6d6eeec0-d354-b1fc-d283-c7f7c6a8d27f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:6d6eeec0-d354-b1fc-d283-c7f7c6a8d27f
msgctxt "hb2de96f6g244bg4e9ega724g7c137563ee4f"
msgid "I've been in worse spots - and I ain't dead yet. Move along, True Soul."
msgstr "난 더 열악한 곳에도 있어봤어. 그리고 아직 죽지 않았지. 저리 가, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 6da5566e-fc46-26ea-3bfb-60c146bace82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:6da5566e-fc46-26ea-3bfb-60c146bace82
msgctxt "h2e4bfc39gcb1bg4dd6gbc60g70d6cec081e9"
msgid "Pissed off the wrong people."
msgstr "건드리면 안 될 사람을 열받게 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 6eb224ed-f6c1-fce8-f3d0-0fd910ad46dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:6eb224ed-f6c1-fce8-f3d0-0fd910ad46dc
msgctxt "haac61d1fg68cdg49e0gb0bfg35cf3a2a9b9d"
msgid ""
"Ain't one in my cell, friend, or I'd be long gone. Luckily, I've a plan to "
"get out."
msgstr "내 감옥엔 없어, 친구. 있었다면 오래전에 탈출했겠지. 다행히도 난 빠져나갈 계획이 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 7112c355-bfc6-773d-28d7-2e87124d82d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:7112c355-bfc6-773d-28d7-2e87124d82d4
msgctxt "he6e33b45g285dg40b5gbe98g8f35cd04d876"
msgid "How did you know?"
msgstr "어떻게 알았지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 7376a8e1-bd2e-b5cf-8ad7-c7ae5291a7c1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_GnomesStartEscape = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:7376a8e1-bd2e-b5cf-8ad7-c7ae5291a7c1
msgctxt "h17682192g6bddg41d3ga2b8g01a87c9cf5e0"
msgid "It's time. Let's do this."
msgstr "지금이야. 해보자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 7384e5ae-a3d6-f640-fe68-29d1ce5d8bf2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:7384e5ae-a3d6-f640-fe68-29d1ce5d8bf2
msgctxt "h8f4ecbd5g385eg41a8gaed5g8bfde20f2d9b"
msgid "Convenient."
msgstr "편리하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 738c8f2b-73c7-cb0c-2be3-3ca06414fc52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#.   Global:
#.      - MOO_Jailbreak_State_WulbrenAlerted = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_WulbrenAlert(1) = True
#.     - MOO_Jailbreak_HasMet_Wulbren(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:738c8f2b-73c7-cb0c-2be3-3ca06414fc52
msgctxt "h33e2efd4gc359g4fddg9e08g51571035f528"
msgid "Walk on, True Soul. I ain't risking a beating for the likes of you."
msgstr "저리 가, 참된 영혼. 너 같은 놈 때문에 얻어맞긴 싫으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 7554f1d2-e9aa-9f88-aaf3-f9a1e888729d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:7554f1d2-e9aa-9f88-aaf3-f9a1e888729d
msgctxt "h4d3035efg61efg40ceg8dffg3d81a485d2cb"
msgid "At what cost? Do we deserve the knife for your folly?"
msgstr "그리고 그 대가는? 네놈의 바보짓 때문에 우리가 대신 칼을 맞아야 하나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 763c84d5-5da3-13ae-99da-6f8607971633
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:763c84d5-5da3-13ae-99da-6f8607971633
msgctxt "h1ca1c4efg92fdg40d9gba96g494cd697b7ab"
msgid ""
"Fair enough. I just figure with the two of us in a cell, we might have a "
"common enemy."
msgstr "뭐, 좋아. 난 그저 감옥에 갇힌 두 사람이 공통의 적을 가지고 있진 않을까 해서 물어본 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 76a2c2a6-9796-ccce-eab4-a490277c4762
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:76a2c2a6-9796-ccce-eab4-a490277c4762
msgctxt "h2312ab2eg2f67g4972gaf82gbc1e64b9f08b"
msgid "I could help you - for a price."
msgstr "도와줄 수 있어. 대가를 받고 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 76ac6edc-be4a-da9a-0938-0ed91a37a001
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:76ac6edc-be4a-da9a-0938-0ed91a37a001
msgctxt "h8e316eedg91b8g4e17gbb88g0170a9f61bb0"
msgid "You want my help? Shut it."
msgstr "내 도움을 바란다면 조용하시지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 7752d392-a420-2d84-d7af-cbfca95b6325
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_WulbrenAtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_WaitingForBoat(0) = False
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:7752d392-a420-2d84-d7af-cbfca95b6325
msgctxt "hcec564cdg641dg44ecg87b4g44a36f8194e3"
msgid "The more you interrupt, the longer this will take."
msgstr "네가 방해할수록 더 오래 걸릴 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 7ae31b4f-6a16-0590-312b-31e53db4fafd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:7ae31b4f-6a16-0590-312b-31e53db4fafd
msgctxt "h795f6ef2g3065g451fgac3bg124b2e2964f3"
msgid "'Cause I'm hoping you'll return the favour."
msgstr "네가 이 호의를 되갚길 바라니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 7b0df622-dfe1-d4fa-4de9-10e7ef0fed54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:7b0df622-dfe1-d4fa-4de9-10e7ef0fed54
msgctxt "hae181d4bgc8e0g4149gb255g100cd9910231"
msgid "Gaerdal help me - just bring them. Or we're all very, very dead."
msgstr "맙소사, 가에르달이시여. 그냥 가져오기나 해. 안 그러면 우린 죽은 목숨이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 7cddda10-38ac-abef-e972-1a0e06c7c309
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Wulbren(1) = True
#.   Global:
#.     - MOO_Jailbreak_Knows_GnomeEscape = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:7cddda10-38ac-abef-e972-1a0e06c7c309
msgctxt "h3df9576ag7975g4e23g87d4g4d3d373963fb"
msgid "Nimble! Check for gaps, cracks - anything to leverage the rock."
msgstr "님블! 균열이 있나 확인해 봐 - 분명 바위들을 움직일 방법이 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 7d2439c6-ac57-d6b1-21f3-3badf802ef10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_TieflingsInJail = True
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Event_SaveTieflings = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:7d2439c6-ac57-d6b1-21f3-3badf802ef10
msgctxt "h0b05fbbag1440g430agafd2g0530134f9091"
msgid ""
"We'll grab the tieflings along the way - we'll need 'em if it comes to a "
"fight."
msgstr "빠져나가는 길에 티플링들도 데려가도록 하지 - 싸움이 벌어지면 손이 더 필요할 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 7d91b168-a89f-705d-8e68-dd9891d8d8f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:7d91b168-a89f-705d-8e68-dd9891d8d8f7
msgctxt "hfd80a2edgff75g460fg89e9g83cffccdc803"
msgid ""
"Tell her - she's already taken my freedom. And there's little worse than "
"that."
msgstr "가서 말해봐 - 어차피 이미 내 자유를 빼앗아갔으니, 이제 더 빼앗아 갈 것도 없다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 7fbd6ec3-b994-bbf0-7551-1e4be6dca192
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_SpeakToGnomesWarning(1) = True
#.      - MOO_Jailbreak_HasMet_WulbrenSuspicious(1) = False
#.   Global:
#.      - MOO_Jailbreak_State_WulbrenSuspicious = True
#.      - MOO_Jailbreak_Knows_ToolsNeeded = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Wulbren(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:7fbd6ec3-b994-bbf0-7551-1e4be6dca192
msgctxt "haaecf847g60f6g4258gb0dcg584911515e4e"
msgid ""
"You ordered that guard about as if you were the Absolute herself. What do "
"you want with us, exactly?"
msgstr "꼭 네가 그 절대자라도 되는 것 마냥 경비들한테 명령을 내리시는군. 우리랑은 무슨 볼일이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 813d5647-1441-2bc4-44fe-18d8f90b9091
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#.   Object:
#.      - IsInPrison(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:813d5647-1441-2bc4-44fe-18d8f90b9091
msgctxt "h34a11a7ag8c69g4f6cgbbaege1b71ed8b74a"
msgid ""
"The Absolute turned her back on you, did she? Don't take it to heart - it'll "
"happen to the rest of them in due time."
msgstr "절대자께서 널 저버리셨나? 개의치 말라고 - 곧 다른 놈들도 같은 신세가 될 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 83beffe5-e0d7-5bab-2902-3e55f79c27ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:83beffe5-e0d7-5bab-2902-3e55f79c27ee
msgctxt "h0af4b5b3g10c3g4cedg8d65g0b31bccdd709"
msgid "None of your business."
msgstr "네가 신경 쓸 바 아니야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 85d11f1f-7ca3-f728-c3bb-5426b7059164
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:85d11f1f-7ca3-f728-c3bb-5426b7059164
msgctxt "h6f95c66fgccd5g4d4egb2b5ga91a0f9cb481"
msgid "Why are you helping me?"
msgstr "왜 날 도우려는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 865ed6b2-098c-a93a-80f7-549c7afcfe5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:865ed6b2-098c-a93a-80f7-549c7afcfe5d
msgctxt "h907b8f06gbc1fg427bg8d63g0fad9653e56a"
msgid "Fine, die in here for all I care."
msgstr "좋아, 여기서 죽든 말든 알아서 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 8754ff15-e7db-1247-646f-57a88a122636
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:8754ff15-e7db-1247-646f-57a88a122636
msgctxt "h68a02fc2ga890g44b2g8be5g38bd8df968c5"
msgid "Efficient? Good."
msgstr "효율적이네? 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 8b927ee6-ab54-143c-cd57-1cbd349e91d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:8b927ee6-ab54-143c-cd57-1cbd349e91d8
msgctxt "h77efd3a4g6f6eg47fcgb230g72da893cdf82"
msgid ""
"Makes sense. Your eyes are dull - <i>obedient</i>. Why don't you run along "
"and go play with your Warden?"
msgstr "말 되는군. 네 눈은 둔하고, <i>순종적이니. </i> 저리 가서 간수장이랑 같이 노는 게 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 8bcfc1be-d8bb-fc97-f1e1-2df3c04cabd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:8bcfc1be-d8bb-fc97-f1e1-2df3c04cabd7
msgctxt "he39854a2gba1bg4de1g86b6g86ffaf751013"
msgid "...You're bound for Baldur's Gate, then? Our paths align."
msgstr "...그렇다면 발더스 게이트로 가야만 하겠지? 우리의 길이 겹치는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 8d060217-2af8-f226-9832-474da109db0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Wulbren(1) = True
#.     - MOO_Jailbreak_HasMet_WulbrenOutcast(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:8d060217-2af8-f226-9832-474da109db0b
msgctxt "ha039c511g398dg4170g918egaca2c4e39c18"
msgid "Hey - hey! You're the one who has Moonrise up in arms, aren't you?"
msgstr "이봐, 이봐! 너 문라이즈를 뒤집어 놓은 녀석 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 8e63745a-5d1d-c6cd-e5fb-563a4ced585b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:8e63745a-5d1d-c6cd-e5fb-563a4ced585b
msgctxt "h9b086c62g3fc1g439dga2feg80f9a14700fa"
msgid ""
"I'm [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53] - pleasure to meet "
"you."
msgstr "난 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]. 만나서 반갑군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 91571f1c-8390-9c81-1269-0ba91dca70b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:91571f1c-8390-9c81-1269-0ba91dca70b5
msgctxt "h4f0f1164gbbcfg484ega6f9ge9b2715e6430"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 9446b365-85a6-c657-ad03-e0c71226f4b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - IsInPrison(1) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_ToldAboutHole(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:9446b365-85a6-c657-ad03-e0c71226f4b1
msgctxt "h4e37c117gfad3g4b51gb870gb84673f30713"
msgid ""
"A new neighbour? If you're locked up in here, you must be doing something "
"right."
msgstr "새 이웃인가? 여기 갇힌 걸 보니 옳은 일을 했나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 946b2ffd-def5-cc71-e208-9b5739a53661
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:946b2ffd-def5-cc71-e208-9b5739a53661
msgctxt "hd6be50f8g48cdg4aabgb40eg5a9f1b3c62ff"
msgid "Maybe. Maybe not."
msgstr "그럴지도. 아닐지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 9afe0e25-a3a3-e6ea-9c61-d7cb2d2ad6c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_HasToolForGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:9afe0e25-a3a3-e6ea-9c61-d7cb2d2ad6c1
msgctxt "h72b8991bgcb79g409ag97b6g8e62940088b1"
msgid "I might have something that could help."
msgstr "도움이 될 만한 물건을 갖고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = 9c486462-c94b-b7e6-6aa2-e563853f4626
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:9c486462-c94b-b7e6-6aa2-e563853f4626
msgctxt "hc06507e9gcafag4b08g8f95g34ee81ffb604"
msgid ""
"Ah! Don't mind us, True Soul. The back wall is weak - we're working to brace "
"it."
msgstr "아! 참된 영혼님, 우린 신경 쓰지 마십쇼. 뒤쪽 벽이 좀 약해 보이길래 보강 작업 중이니까요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 9d1418d9-6706-d868-d630-972beaf87307
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:9d1418d9-6706-d868-d630-972beaf87307
msgctxt "h1c0fdcaeg7d47g4facgad2cg6e5f05f3594a"
msgid "Got it - I'll be back soon."
msgstr "알았어 - 금방 돌아오지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = 9da7ef07-06cb-9271-6976-948c00f835da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:9da7ef07-06cb-9271-6976-948c00f835da
msgctxt "h335b7c81gd122g43edg9054g83864892cf43"
msgid "What are you talking about?"
msgstr "뭔 말을 하는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = a394801d-f313-d6d4-107d-df3310878fff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_HasToolForGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:a394801d-f313-d6d4-107d-df3310878fff
msgctxt "h4d56833cg9fc6g4ce6g95edgfdbe6a4c72ae"
msgid "I have something that can break stone."
msgstr "돌벽을 무너뜨릴 만한 물건이라면 이미 가지고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = a5755551-ba10-80e3-3047-848f28cd3c17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:a5755551-ba10-80e3-3047-848f28cd3c17
msgctxt "h1b8db190gfe8bg4a7egae5egfd1e8b62833a"
msgid ""
"Were I to get such help, I'd be appreciative. But <i>why</i> would a True "
"Soul be offering?"
msgstr "도와준다면야 고맙지. 하지만 <i>왜</i> 참된 영혼이 그런 제안을 하는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = a7781d43-5354-b698-8883-3e38887c2205
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:a7781d43-5354-b698-8883-3e38887c2205
msgctxt "h58ca5660gcb60g4f86gb7a9g27eccd50332b"
msgid ""
"Other than the joy of saving lives? I know powerful people in Baldur's Gate -"
" and I remember my friends."
msgstr "목숨을 구해주는 보람 말고도? 난 발더스 게이트에서 유력한 인물들을 알고 있어. 그리고 난 친구를 기억한다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = a9e75830-3d2a-adf6-12dd-c33b7de012b4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:a9e75830-3d2a-adf6-12dd-c33b7de012b4
msgctxt "h43127a10gd1e2g4996g9f4dg9c6feb181da4"
msgid "The prettiest words hide the damndest lies."
msgstr "가장 아름다운 말은 가장 끔찍한 거짓을 숨기고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = aa1101ed-65e4-0250-21fa-c2559b587c6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_HasWulbrenHammer(1) = True
#. SetFlags:
#.   Object:
#.     - MOO_Jailbreak_Event_GiveHammer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:aa1101ed-65e4-0250-21fa-c2559b587c6f
msgctxt "h0f85b206g9f7bg447fg920bg8c57c28692fa"
msgid "Here. I found this hammer, is it yours?"
msgstr "여기. 망치를 찾았어. 네 것 맞나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = aee7bbff-2ca5-6fff-1b16-72f7193b250b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:aee7bbff-2ca5-6fff-1b16-72f7193b250b
msgctxt "h1d98fb47g1b74g47degb1feg3be36a3e5bb5"
msgid "The Warden would want to hear about this."
msgstr "간수장이 이 이야기에 아주 관심이 많을 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = af5a7e49-f45c-7f33-4342-7ebff989b840
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_TieflingsInJail = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:af5a7e49-f45c-7f33-4342-7ebff989b840
msgctxt "h577a7b9fgf78eg4f4fg8427g998d6bf86e22"
msgid ""
"The necromancer has been hauling people off like cattle. We don't get out, "
"we're dead - us, the tieflings, <i>everyone.</i>"
msgstr ""
"강령술사가 사람들을 무슨 가축처럼 다루고 있어. 빠져나가지 못한다면, 우린 죽은 목숨이야 - 우리, 티플링, <i>모두가.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = b272b493-2449-7550-f3aa-f68eb4697bbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:b272b493-2449-7550-f3aa-f68eb4697bbc
msgctxt "h59b54e1cg742dg4b75g8deegcdc232e9a575"
msgid "I didn't bloody ask you."
msgstr "네놈에게 물은 적 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = b35336ab-7589-7bcb-7935-05ad81f896cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:b35336ab-7589-7bcb-7935-05ad81f896cd
msgctxt "h7715150agfd78g444bg830egb6a95423805b"
msgid "I reckon you and I were meant to meet - I'm Wulbren."
msgstr "아무래도 이렇게 만날 운명이었던 것 같네. 난 울브렌이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = b4d54046-fef2-ad0c-bc3c-dca0609d2c7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:b4d54046-fef2-ad0c-bc3c-dca0609d2c7b
msgctxt "h42fcbb56g1b70g4c9bgbdfbgb5ac607d7a39"
msgid "I can smell the blood from here."
msgstr "여기까지 피 냄새가 풍긴단 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = b68e7ebc-cb8a-0498-3870-bcab922f08a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:b68e7ebc-cb8a-0498-3870-bcab922f08a9
msgctxt "h11be8a3bg8827g4135gb63fgff354841c731"
msgid ""
"We need to get out of here or we're stone dead. Get us tools, anything that "
"could crack the wall behind us."
msgstr "당장 빠져나가지 않으면 우린 죽은 목숨이야. 어서 벽을 부수는데 쓸 도구들을 가져다줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = b7005079-0df1-15fd-cbac-2dc55f4b7aca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:b7005079-0df1-15fd-cbac-2dc55f4b7aca
msgctxt "hdcd27d83g3c3ag401cgb766g8757b16ed3df"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = b88e3405-a30e-fb9e-03b7-823f43a46a02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:b88e3405-a30e-fb9e-03b7-823f43a46a02
msgctxt "h6d903649g92abg4740ga3aeg8f2ec9b25e7f"
msgid ""
"I'd scamper sharpish - I've seen what the Warden does to the insubordinate. "
"Leave, before she catches you."
msgstr "나라면 잽싸게 도망치겠어. 간수장이 반항하는 놈을 어떻게 하는 지 똑똑히 봤거든. 어서 떠나, 그년한테 잡히기 전에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = b8b3b5db-1887-f21e-dd38-d3451da01b96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:b8b3b5db-1887-f21e-dd38-d3451da01b96
msgctxt "h82cc526cga3d4g490eg8723gb2615e1b631a"
msgid ""
"You, however, are the clincher. Once we move, keep the patrols busy. If the "
"bastards spot us, all of bloody Moonrise will come down on us."
msgstr ""
"그리고 넌 뒤를 맡아줘야겠어. 우리가 탈출하고 나면, 경비들을 처리하도록 해. 만일 그 자식들이 우릴 발견한다면, 탑 전체가 우릴 쫓아올 "
"테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = b9af1c54-11e9-a3fd-1fd7-6476dfa2c5f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_WulbrenAtBoat(1) = True
#.   Object:
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:b9af1c54-11e9-a3fd-1fd7-6476dfa2c5f7
msgctxt "h6d02db9cgff31g433dg95degef8b6c5f189a"
msgid "How long does it take to untie a boat?"
msgstr "배 하나 묶인 거 푸는 데 시간이 얼마나 걸리는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = bae25e07-2191-0fd0-6ad1-c0819c35bd58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:bae25e07-2191-0fd0-6ad1-c0819c35bd58
msgctxt "h4442e5a2g3322g4bbdgb5bcga458ad11726d"
msgid ""
"If he sent you, you're no slave to the Absolute. You're a damn wolf among "
"sheep, aren't you?"
msgstr "녀석이 보낸 거라면 절대자의 노예는 아니겠지. 양으로 변장한 늑대가 따로 없으시구만?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = bb6ca884-0fdb-87e7-a2d1-19ff1ae235b6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:bb6ca884-0fdb-87e7-a2d1-19ff1ae235b6
msgctxt "h1d262a18g0083g4551ga8acg19bec65da541"
msgid "Like you care what happens to the likes of us."
msgstr "꼭 우리 신세가 걱정이라도 된다는 투로 말씀하시는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = bb84f842-c208-1be7-7902-f5d1081f03d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:bb84f842-c208-1be7-7902-f5d1081f03d8
msgctxt "h156ed9b8g63d1g41d9gb851gfb44da16471a"
msgid "What do you need tools for?"
msgstr "도구가 왜 필요한 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = bdf54347-791c-7c6a-7faf-59794e7e2ecf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_SpeakToGnomesWarning(1) = True
#.   Global:
#.      - MOO_Jailbreak_State_WulbrenAlerted = True
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_Wulbren(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:bdf54347-791c-7c6a-7faf-59794e7e2ecf
msgctxt "hf8913743g5fa9g42degbb69gaef0e7b8095c"
msgid ""
"We're low on time - the guards are spooked and will be watching us both. "
"I've got a plan, if you're up to the task."
msgstr "시간이 모자라 - 경비들이 안달이 나서는 우리들을 감시하고 있다고. 네가 그럴 생각만 있다면, 내게 계획이 있지만 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = bf047d9e-4bf2-33e5-2376-ff1109a4af03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_Event_GnomesStartEscape = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:bf047d9e-4bf2-33e5-2376-ff1109a4af03
msgctxt "h66be7b53gf991g4bbagba8cg297543a5ce8e"
msgid "We'll move once it's quiet - until then, be ready."
msgstr "좀 잠잠해지면 시작할 테니 - 그때까지 준비하고 있으라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = bfc68e4e-7303-09a0-376f-aca2d475cd09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:bfc68e4e-7303-09a0-376f-aca2d475cd09
msgctxt "h4ead88f4ge615g4327gb6edgc813f4c35f90"
msgid ""
"Whatever you find, throw it through the bars. But for the love of Gaerdal "
"make sure a guard doesn't see you - or we're both done for."
msgstr "뭐가 됐든 가져와서 여기 철창 너머로 던지라고. 근데 제발 경비들한테 들키지는 마 - 안 그러면 우리 둘 다 죽은 목숨이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = c0c1e518-df6a-74a3-e6c9-6c7f6ff7dfdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c0c1e518-df6a-74a3-e6c9-6c7f6ff7dfdd
msgctxt "hda9ece3eg144ag44b8g9ee6ge07f6d72a692"
msgid "I promise nothing - thanks for the tip about the hole though."
msgstr "아무것도 약속하지 않겠어. 다만 구멍이 있다는 걸 알려줘서 고맙군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = c0d5401b-981f-cbc3-7fcf-0948bf8c5f0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c0d5401b-981f-cbc3-7fcf-0948bf8c5f0c
msgctxt "hd443cba8gd578g421egb130gd772d8bc24a3"
msgid "Out of here - isn't that all that matters?"
msgstr "일단 여긴 아니잖아. 그거면 된 거 아닐까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = c0ff44bf-d47a-6c82-ff17-7939079bea8a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 6
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c0ff44bf-d47a-6c82-ff17-7939079bea8a
msgctxt "h7a541988gd40fg41a7gb672g248b5bf47709"
msgid "No. I want to help you escape."
msgstr "아니. 난 너희 탈출을 돕고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = c163884d-16c1-b962-44d1-71af69eca809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c163884d-16c1-b962-44d1-71af69eca809
msgctxt "h4c802f51gf975g405fg8621g55e79b502ab7"
msgid "I'm not the enemy here - the Absolute is."
msgstr "난 네 적이 아니야. 적은 절대자라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = c1f3ffbb-d191-6c82-8473-03ac88c395c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_HasToolForGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c1f3ffbb-d191-6c82-8473-03ac88c395c7
msgctxt "h743f8ddfg2fcfg4bf7g9d10g05d2c19e37db"
msgid "Yes. I found some."
msgstr "그래. 몇 개 찾아냈지. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = c20d2c9d-70a6-f160-87b8-00c065cc4030
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c20d2c9d-70a6-f160-87b8-00c065cc4030
msgctxt "hcb019326g20a8g4594g92c1ga44fa932dd56"
msgid "I follow the Absolute, of course I'm going to report this."
msgstr "난 절대자님을 섬긴다. 당연히 가서 보고해야지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = c4b3c04b-ecbf-83e9-8f87-9516ed04776c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_WulbrenAlerted = True
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_WulbrenAlert(1) = True
#.     - MOO_Jailbreak_HasMet_Wulbren(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c4b3c04b-ecbf-83e9-8f87-9516ed04776c
msgctxt "h7c64085cg451fg4171gac0ag903338ab3fbc"
msgid "Blasted eyes did a number on your friend, but there's still hope."
msgstr "네 친구가 놈들한테 걸려버렸어. 하지만 아직 희망은 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = c5e4fbc0-6cc7-760b-da59-4d5ada3f2b35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_Wulbren(1) = True
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_WulbrenOutcast(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c5e4fbc0-6cc7-760b-da59-4d5ada3f2b35
msgctxt "heea9ecc6g4f9ag40abga34cgc06ccafab036"
msgid ""
"What in the Nine Hells have you <i>done</i>? Moonrise has lost its damn mind "
"- and we're next on the cutting block."
msgstr "빌어먹을 도대체 <i>무슨 짓</i>을 한 거야? 문라이즈 전체가 눈깔이 돌아버렸고 - 우리도 곧 목이 달아나게 생겼다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = c5e82dfa-37b1-ca3b-09cb-3de71fa183b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GNOME(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c5e82dfa-37b1-ca3b-09cb-3de71fa183b9
msgctxt "hf80283dcg2a20g4076g807bgad40b97d1b0e"
msgid "That is not how you brace a wall, and we both know it."
msgstr "그건 벽을 보강하는 행위가 아니야, 너도 알다시피."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = c743075b-6a85-88a1-e438-794f8e5d3797
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_WulbrenOutcast(1) = True
#.   Global:
#.      - MOO_MoonriseTower_State_Outcast = True
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c743075b-6a85-88a1-e438-794f8e5d3797
msgctxt "hfe060124gb0e1g40e7ga082g92d9110c43c5"
msgid "About time - any luck with those tools?"
msgstr "드디어 돌아왔군. 도구는 좀 찾았나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = c7cfeb30-c835-9819-0c94-9bd80819ae33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - MOO_Jailbreak_State_BoatEscape(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_WulbrenAtBoat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c7cfeb30-c835-9819-0c94-9bd80819ae33
msgctxt "hebac940fg4969g4a92ga144gdb960816b92e"
msgid ""
"I should've taken charge of that damn boat - we'd be out of here by now."
msgstr "내가 배 쪽을 담당했어야 하는데. 지금쯤이면 여길 뜨고도 남았겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = c80a6507-7198-30ad-58a2-6265e12bce48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:c80a6507-7198-30ad-58a2-6265e12bce48
msgctxt "hd1385465ge609g4a1bgafbbg71a5a0ad9bfd"
msgid "Enjoy being in the Absolute's pocket. I'm sure it's nice and cosy."
msgstr "그럼 절대자의 안락한 손 안에서 잘 놀아나 보시라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = cde46996-11b7-022b-303c-ec2fdc848102
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_HasMet_WulbrenAlert(1) = True
#.   Global:
#.      - MOO_Jailbreak_State_WulbrenAlerted = True
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:cde46996-11b7-022b-303c-ec2fdc848102
msgctxt "hd0a455beg9bd2g4714g91c5g1de5bc58ab4c"
msgid "We're short on time, friend. Any luck with those tools?"
msgstr "시간이 모자라, 친구. 도구는 좀 찾았나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = cee1db6b-bd3d-3109-87cc-9967bbc0cfc5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:cee1db6b-bd3d-3109-87cc-9967bbc0cfc5
msgctxt "hd406f0cfg9064g4a67gbb68g314d5ba832eb"
msgid "I don't have time for this. You're on your own."
msgstr "이럴 시간 없다. 네가 알아서 하도록 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = d1e0f70a-c837-38fd-8b14-67c32943c318
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:d1e0f70a-c837-38fd-8b14-67c32943c318
msgctxt "ha60fb512g21fbg4bdag9137g6725e9473d05"
msgid "Nice try, but I'm no motherless babe - have your fun with someone else."
msgstr "좋은 시도군, 하지만 난 엄마 잃은 아이가 아니야. 다른 놈들과 즐기지그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = d203e5f5-2849-56a1-9e21-81b762a8e99c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:d203e5f5-2849-56a1-9e21-81b762a8e99c
msgctxt "h81ab374eg3ed4g4989gbf37ga8c8a97557d1"
msgid "Barcus told me you were here, and asked me to help."
msgstr "바커스가 네가 여기에 있을 거라며, 나보고 도와달라더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = d436b9b0-4958-b1bd-c991-1153d4622091
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:d436b9b0-4958-b1bd-c991-1153d4622091
msgctxt "h3f189bf0ge133g44a9gbdfbgc2ac180a0aff"
msgid "Not yet, I'll be back soon."
msgstr "아직, 금방 돌아오도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = d5cf740a-558e-4f9f-29c9-754d046c57c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:d5cf740a-558e-4f9f-29c9-754d046c57c1
msgctxt "hd021db6cg90c1g4110g8626ge403134653db"
msgid "I messed up, all right?"
msgstr "실수 좀 할 수도 있지, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = d5d83a50-84c2-6efd-c3c0-9c9ea95ab94d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:d5d83a50-84c2-6efd-c3c0-9c9ea95ab94d
msgctxt "h54187ec4gbe34g4caagb567gc9c3ca8bfa43"
msgid "The plan is to wait for a quiet moment, then bust out the back wall."
msgstr "조용한 순간이 오기를 기다렸다가, 벽을 부수고 나가는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = d7e22d0a-fd35-6480-c511-42df710952b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:d7e22d0a-fd35-6480-c511-42df710952b7
msgctxt "h46dbfbd5gb649g49e3g8342g9a7b6da8f272"
msgid "Blessed, Gaerdal - I never thought I'd see it again. Thank you."
msgstr "게어달이시여, 감사합니다. 다시는 못 볼 줄 알았는데. 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = da13ad40-7ccd-3d6b-161b-97c6e71ca470
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:da13ad40-7ccd-3d6b-161b-97c6e71ca470
msgctxt "hf3c1bc01gbfe4g4609gabf2gfd83ab3a05e0"
msgid "Got it. I'll be back soon."
msgstr "좋아. 금방 돌아오도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = dab6f19c-f8a6-d33e-7021-d44f097342b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:dab6f19c-f8a6-d33e-7021-d44f097342b7
msgctxt "h8ce87936g95a5g46bag9838g2d335131b9a5"
msgid "Don't bother trying - you're going to die here."
msgstr "뭐 하러 애를 쓰나. 어차피 여기서 죽게 될 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = dd58ec0c-4fa5-60f6-fa7d-efc62ac0a28f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:dd58ec0c-4fa5-60f6-fa7d-efc62ac0a28f
msgctxt "h0282dc8fge093g4f47gac35gb29d8a4d1a27"
msgid "I just want to torment you in peace."
msgstr "그냥 편한 곳에서 널 괴롭혀보고 싶을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = e000f52f-7a35-d34e-6f55-f0bbb930412a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:e000f52f-7a35-d34e-6f55-f0bbb930412a
msgctxt "h923b6820ge02cg4f2bg9327gac41fbabb88a"
msgid "You're clearly planning an escape."
msgstr "탈출을 계획하고 있는 게 분명하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e14715b2-0ef7-7157-5255-97e7879dbd2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:e14715b2-0ef7-7157-5255-97e7879dbd2d
msgctxt "hd6c919fcg4c92g40b4g9561g27dd5db79bfa"
msgid "All right, all right! Gods, remind me not to get on your bad side."
msgstr "알겠어, 알겠다고! 맙소사, 너랑은 꼭 척지지 않도록 조심해야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e15f729c-c0f4-b605-adc2-1944fbc7199b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:e15f729c-c0f4-b605-adc2-1944fbc7199b
msgctxt "h5aec2045g84ecg4916ga435g5ae9e8b177bc"
msgid ""
"Look - the guards are on a rampage, and we're next on the chopping block."
msgstr "이봐, 보초들이 완전히 눈깔이 뒤집혔다고. 우린 당장에라도 목이 날아갈 판이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e165f039-3066-4af4-b71f-9048338a58ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:e165f039-3066-4af4-b71f-9048338a58ea
msgctxt "h8f895bcdgc407g40a0gac68g2b74d9485839"
msgid "Or find a way to get this damn door open. Hurry!"
msgstr "아님 이 망할 문을 열 방법이나 좀 찾아 보든지. 서둘러!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e3b1acaf-55d1-00b4-ad82-fbf4a1327870
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:e3b1acaf-55d1-00b4-ad82-fbf4a1327870
msgctxt "h1da9d2fdg1987g4d34g959cg97cea8229f54"
msgid ""
"There's likely a <i>reason</i> the cultists haven't blocked it off. But it "
"leads out of here - and that's all that matters."
msgstr "광신도 놈들이 저걸 방치한 <i>이유</i> 가 있겠지만. 일단 탈출구가 있다는 정도면 충분한 기회지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = e4624deb-bcea-82a0-1bbc-2262a5c142ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:e4624deb-bcea-82a0-1bbc-2262a5c142ed
msgctxt "h6d899c77g69d9g490dg8b3eg2af3271dd684"
msgid "In my defence, it was an accident."
msgstr "변명하자면, 그건 사고였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e62db5bf-6fa8-7cbd-a6ff-8127f44cbbd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:e62db5bf-6fa8-7cbd-a6ff-8127f44cbbd1
msgctxt "h617b77a9g1d2ag4b6fg9041g97386afe0fad"
msgid "You've killed us, you prick of the absolute - stone dead."
msgstr "네가 우릴 죽인 거야. 이 절대자 개자식아. 우린 죽은 거나 마찬가지라고. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e9d3c190-fb2f-3cb2-22d8-dea951dd5cc2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_TieflingsInJail = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:e9d3c190-fb2f-3cb2-22d8-dea951dd5cc2
msgctxt "h22048c25gcaabg4289gbd21gc8e06d78d062"
msgid ""
"All that matters is how we're gonna get out - us and the tieflings both. An "
"Ironhand leaves no one behind."
msgstr "지금 중요한 건 어떻게 빠져나가느냐야, 우리와 티플링 모두. 아이언핸드는 아무도 버리지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = e9f61e25-9d65-7334-9f4f-df0a5fe62690
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Jailbreak_State_TieflingsInJail = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:e9f61e25-9d65-7334-9f4f-df0a5fe62690
msgctxt "h1965a3cdg5340g45fagb97cg40c51be23071"
msgid ""
"We've got a plan, for us and the tieflings both, but we're scuppered without "
"the right equipment."
msgstr "우리와 티플링 모두를 위한 계획이 있지만, 알맞은 장비 없이는 망한 신세야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = ea331382-c547-7ae2-cc87-c3ecc65f54bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:ea331382-c547-7ae2-cc87-c3ecc65f54bc
msgctxt "h119929b3g8607g4859ga6a4g8e77c442bfe9"
msgid "Why are you helping me?"
msgstr "왜 날 돕는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = ed2f85e4-87a7-984d-48e4-fecffb6a0c48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:ed2f85e4-87a7-984d-48e4-fecffb6a0c48
msgctxt "hd11e278agdb66g4e74g9c61gb7dbf18fbd63"
msgid "What's it to you?"
msgstr "그게 어쨌단 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = ed4170e9-f21a-a22e-620a-c587054d19a2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:ed4170e9-f21a-a22e-620a-c587054d19a2
msgctxt "h97f2c864g1fd1g4e18g8bc3ge40b188d7bca"
msgid "And I'm a damn hollyphant."
msgstr "그럼 난 홀리펀트다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = f2f48622-c7bd-c8a9-2e09-e481259eacdd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Jailbreak_Event_SpeakToGnomesWarning(1) = True
#.   Global:
#.      - MOO_Jailbreak_State_WulbrenAlerted = True
#.      - MOO_Jailbreak_Knows_ToolsNeeded = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_HasMet_WulbrenAlert(1) = True
#.     - MOO_Jailbreak_HasMet_Wulbren(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:f2f48622-c7bd-c8a9-2e09-e481259eacdd
msgctxt "hb9bd92edgb05fg4c5dgbb6dg113249d1ea99"
msgid "Blasted eyes - there's no time."
msgstr "지켜보는 눈이 너무 많아. 시간이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = f4aab9db-9828-d47e-ca2b-619063a1a1ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:f4aab9db-9828-d47e-ca2b-619063a1a1ec
msgctxt "hc33bcc41gcf0bg4682g93c7g180fec261e1c"
msgid "I'd never presume to comment - only advise."
msgstr "훈수 두려는 건 아니야, 조언일 뿐이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = f4b5a2a0-6942-5469-d9e9-23ab98935a71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:f4b5a2a0-6942-5469-d9e9-23ab98935a71
msgctxt "hade7c0dcgc2e8g4b08gb5ddg65fca08b4508"
msgid "That doesn't look suspicious at all."
msgstr "의심스러운 구석이라고는 조금도 보이지 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = fa388fe9-2460-fa93-9645-d531a7b98751
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:fa388fe9-2460-fa93-9645-d531a7b98751
msgctxt "hea6d4e0dgc070g4334g94e9gc588a1e4f019"
msgid "Where does it lead?"
msgstr "어디로 이어지지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Player
#. NodeID = fcb9ad64-3c99-0ae2-ac7c-68068ffcc740
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Jailbreak_Event_RefusedToHelpGnomes(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:fcb9ad64-3c99-0ae2-ac7c-68068ffcc740
msgctxt "h5c804db7gae31g4508g9f0egcc525621735f"
msgid "And I'm one of those ears."
msgstr "그리고 난 그 귀 중 하나지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = fe8462bb-f4d0-de84-1ee4-21f4d33791e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:fe8462bb-f4d0-de84-1ee4-21f4d33791e4
msgctxt "h3926c02dg8dcag4ad2g9210g860934e28e4b"
msgid "Every situation can be turned to your advantage - remember that."
msgstr "그 어떤 상황에 놓이더라도 그걸 이용할 줄 알아야 해. 명심하라고. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren
#. Speaker = Wulbren Bongle
#. NodeID = ff0104fe-88fc-d416-8ba1-b451f24b71d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Jailbreak_Wulbren:ff0104fe-88fc-d416-8ba1-b451f24b71d3
msgctxt "hd4445037g373fg433cg9b3cgb3ce28e1cd2b"
msgid "Help me and we'll stick it to the Absolute - together."
msgstr "날 도와줘. 함께 절대자에게 대항하자. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_AD_Bark
#. Speaker = Squire
#. NodeID = aa1f19b7-6e93-343a-8fb4-8b1bbd90a1f2
