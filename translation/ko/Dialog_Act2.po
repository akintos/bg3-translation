#: Mods/GustavDev/Story/Dialogs/Act2/Haven/Haven+Outcasts/HAV_HavenOutcasts_DockGuard_Left_Ranger:45870496-6786-46a1-a45f-22995ca90ea0
msgctxt "h07077a0agcfd1g40deg8994gbcdd0d276df9"
msgid "Be safe. Stay in the light."
msgstr "조심해. 빛 속에 있으라구."

