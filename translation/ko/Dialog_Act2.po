msgid ""
"*The countless distant silhouettes leave you no doubt - a veritable army "
"swarms the path ahead.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_MarchingArmy_Arrest
#. Speaker = Karlach
#. NodeID = 70a4fc45-d7e1-4f45-b2b5-10cdef03bf02
