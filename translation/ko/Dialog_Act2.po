#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:b9181939-196a-9709-2de6-8ee4350fac88
msgctxt "h97ebc76fg6b9bg4a69gb1b6g70bf956752e1"
msgid "Here's the gold."
msgstr "돈은 여기 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = b964b64d-f821-4db1-bede-8caba54869db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 932401b1-7763-7fd7-bee1-8731fe62084f_DeadThree = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:b964b64d-f821-4db1-bede-8caba54869db
msgctxt "h179da8a5gcdf2g46f6gb06bg50ce50cba9b7"
msgid "Can the Dead Three hope to reclaim full godhood?"
msgstr "삼악신이 완전한 신성을 되찾기를 바라는 건가요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Withers
#. NodeID = bba6fc80-70e4-cce7-49e2-11180a6d2133
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:bba6fc80-70e4-cce7-49e2-11180a6d2133
msgctxt "h8c1257c4gf52ag42e3ga36dgad6b58176efa"
msgid ""
"Yet the Three amass an illithid army, void of apostolic souls that could "
"imbue them with power."
msgstr "그럼에도 셋은 일리시드 군세를 널리 일으켜, 자신들에게 힘을 불어넣고 있으매."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = c115a06c-fe1a-5ba0-d01d-d7283551e42c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_Jergal_State_PlayerDead_2 = True
#: Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief:c115a06c-fe1a-5ba0-d01d-d7283551e42c
msgctxt "hc66b222bg3d0ag40baga75bge84f79f31357"
msgid ""
"I want to resurrect [CAMP_Jergal_PlayerToResurrect_2_b1161c91-1bde-6a1c-297e-"
"ee0bfc1a57c4]."
msgstr ""
"[CAMP_Jergal_PlayerToResurrect_2_b1161c91-1bde-6a1c-297e-ee0bfc1a57c4]을(를) "
"부활시키고 싶어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
#. Speaker = Player
#. NodeID = c3f6af0e-f624-cba2-9bc6-90ab813c2c1e
