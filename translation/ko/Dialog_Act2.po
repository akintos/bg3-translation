msgctxt "h59a15ad0g816fg4e3cg8614gbda08e76b98f"
msgid "<i>Pateface mihi cursum rerum!</i>"
msgstr "<i>파테파세 미히 쿠르숨 레룸!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_AD_Haruspicy
#. Speaker = Balthazar
#. NodeID = f29f4a0c-9120-4163-be35-87831923b8e0
