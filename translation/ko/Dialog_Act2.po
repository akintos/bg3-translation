#.     - d6f9f7d9-31df-c40d-497c-abb054b28ec2_B = False
#.     - d6f9f7d9-31df-c40d-497c-abb054b28ec2_A = False
#.     - d6f9f7d9-31df-c40d-497c-abb054b28ec2_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut:54306cf7-cf07-4023-81fe-146d27ea0b54
msgctxt "h2a4874cdgc354g43bcgb0a7g5f9338ef5a19"
msgid "The curse is too strong - my torch won't stay lit."
msgstr "저주가 너무 강력해. 횃불이 버틸 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
#. Speaker = Player
#. NodeID = 5c465f50-30df-4c18-97fa-e9b3e43962a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d6f9f7d9-31df-c40d-497c-abb054b28ec2_A = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut:5c465f50-30df-4c18-97fa-e9b3e43962a3
msgctxt "hc1e78d23g1329g47acgbf01g767854172672"
msgid "The dark's strong enough to snuff out a torch? Well I don't love that."
msgstr "어둠이 횃불을 꺼버릴 만큼 강하다고? 좋아할 수가 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
#. Speaker = Player
#. NodeID = 5c465f50-30df-4c18-97fa-e9b3e43962a3
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - d6f9f7d9-31df-c40d-497c-abb054b28ec2_A = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut:5c465f50-30df-4c18-97fa-e9b3e43962a3
msgctxt "hb0fad97cg6228g4b6aga2b0ga3368d9a504d"
msgid "Damn. The curse has snuffed my light."
msgstr "젠장. 저주가 내 빛을 꺼버렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
#. Speaker = Player
#. NodeID = 5c465f50-30df-4c18-97fa-e9b3e43962a3
