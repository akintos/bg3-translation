#.      - HAV_EnteringHaven_State_GainedAccess = True
#.      - HAV_IsobelGaveOintment = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:2c2ca3b1-f140-b509-bf49-1ffc2dc14126
msgctxt "hd55c2c3bgdb4fg43aag9f37g2cb3d78e5d7f"
msgid ""
"I've infiltrated an encampment of Harpers protected by a cleric of Selûne."
msgstr "셀루네 클레릭이 보호하는 하퍼 숙영지에 잠입했었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = 401a17e6-0766-4e9e-9b19-0b7240ffaac1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = True
#.      - HAV_IsobelGaveOintment = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:401a17e6-0766-4e9e-9b19-0b7240ffaac1
msgctxt "h166f6ef2gf8bbg4196gbfa9ga696783469d9"
msgid ""
"I've infiltrated an encampment of Harpers protected by a cleric of Selûne."
msgstr "셀루네 클레릭이 보호하는 하퍼 숙영지에 잠입했었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = 41d9ddb6-3e88-6b4d-99cf-8ac1388ae2f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_GeneralHaven_State_HavenDestroyed = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:41d9ddb6-3e88-6b4d-99cf-8ac1388ae2f5
msgctxt "hfb49d63dg9fceg4011g8592g210aa9e2a51a"
msgid "My apologies. Welcome back, True Soul - what news?"
msgstr "사과하지. 돌아온 걸 환영한다, 참된 영혼. 새로운 소식이라도 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = 3cdd5d27-21c1-adf5-f542-eec0db5d4282
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:3cdd5d27-21c1-adf5-f542-eec0db5d4282
msgctxt "h59440377g8f3fg4c1bg9679g92c47d8bf109"
msgid "Little from the field. What news inside?"
msgstr "현장에서 소식을 가져왔다. 안에선 별 소식 없나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = 4fa09a30-b602-46b3-ae84-41385774ddb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:4fa09a30-b602-46b3-ae84-41385774ddb9
msgctxt "h470e7dc7g20f4g4decgb5f7g4eede65ed80a"
msgid "Little to report. What news inside?"
msgstr "보고할 것이 있다. 안에는 별일 없나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = 3d1f588f-58d6-eee6-864a-dff76deae151
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:3d1f588f-58d6-eee6-864a-dff76deae151
msgctxt "h473a6539g7c81g4490gac94g1b61478c8b65"
msgid "Nightwarden Minthara."
msgstr "밤지기 민타라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = 523b8674-fbc6-4040-92b2-e6f5fac61cf8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MINTHARA(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:523b8674-fbc6-4040-92b2-e6f5fac61cf8
msgctxt "h7f01463ag7d73g428ag95bagb7eefbe96c01"
msgid "Nightwarden Minthara - you were not expected here."
msgstr "밤지기 민타라, 당신이 온다는 얘기는 못들었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Lae'zel
#. NodeID = 5b8b146d-77ff-0765-8b28-d259b6b7ed30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:5b8b146d-77ff-0765-8b28-d259b6b7ed30
msgctxt "hfde4ec0dg4f50g4794gb43eg738ad7317ed9"
msgid "Our path leads to Z'rell. Let us not keep her waiting."
msgstr "우리는 즈렐에게 가야만 해. 지체하지 않도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = 5c0932aa-926a-7029-be6f-7265266f036d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:5c0932aa-926a-7029-be6f-7265266f036d
msgctxt "h493c9faag6dc4g4f67gae02gfb649e9a0023"
msgid "'Welcome back'? I've never been here before."
msgstr "'돌아온 걸 환영한다'? 난 여기 처음인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Wyll
#. NodeID = 5c1beb28-bfa6-5311-4151-c1b119e8b3b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:5c1beb28-bfa6-5311-4151-c1b119e8b3b6
msgctxt "hd7a3ef21g73b7g4232gbf15g7573364fe48e"
msgid ""
"Z'rell - fancy name. Let's put our best foot forward. Or is it best feet?"
msgstr "즈렐이라, 멋진 이름이네. 첫 단추를 잘 끼워 보자고. 단추들이라고 해야 맞나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = 6d0d8699-0f69-b28b-ce11-04f8ce1bdb89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:6d0d8699-0f69-b28b-ce11-04f8ce1bdb89
msgctxt "h5a4cb2dbg16ecg417cg9bc1ge8bbb168573e"
msgid "She's in the audience chamber. Go on in."
msgstr "즈렐 님은 알현실에 계신다. 들어가도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = 6736ffc0-0115-1c80-e31a-2d852a1db6b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:6736ffc0-0115-1c80-e31a-2d852a1db6b4
msgctxt "h6506d4c6g6453g4e4bgba43g476d46a8fd33"
msgid "That's far enough."
msgstr "거기 멈춰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = 7631a5ab-fb39-4d19-9811-4beb8d19da31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:7631a5ab-fb39-4d19-9811-4beb8d19da31
msgctxt "h4fccf110ga9d5g4097gb9bbgb000649b8727"
msgid "You - halt!"
msgstr "거기, 정지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = 7811371e-5f3a-b8f7-8a2e-f2dc1416a59a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_GeneralHaven_State_HavenDestroyed = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:7811371e-5f3a-b8f7-8a2e-f2dc1416a59a
msgctxt "h96ab8e47g3f92g40e0g86e9g35b0cfb0e282"
msgid ""
"How delightful. The scouts reported your victory against the Harpers, but "
"Disciple Z'rell was looking forward to hearing about it from you in person."
msgstr ""
"기쁜 일이로군. 하퍼에 맞서 승리를 거뒀다는 소식은 척후를 통해 이미 들었지만, 신봉자 즈렐 님께서는 직접 만나 보고 받기를 고대하고 "
"계신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = 6b62f41f-dc24-a87a-503e-e97385e78025
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:6b62f41f-dc24-a87a-503e-e97385e78025
msgctxt "h854ad9acgdb77g4185ga331g8807cc5e4756"
msgid "Minthara sent me."
msgstr "민타라가 날 보냈다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = 7bb759e3-118e-44c5-9e92-059291e1a2fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaiderVictory = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:7bb759e3-118e-44c5-9e92-059291e1a2fb
msgctxt "h8917c749gbe31g4c5bgb8d1gf0e5064d2796"
msgid "Minthara sent me."
msgstr "민타라가 날 보냈다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = 77f9c375-6e2a-2608-cc78-3a30fb6f690a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:77f9c375-6e2a-2608-cc78-3a30fb6f690a
msgctxt "h80ca235egcb27g4f54gac45g712828c6909d"
msgid "I might ask the same. Why is one of our rank on guard duty?"
msgstr "나도 질문 하나 하지. 왜 참된 영혼이 고작 경비 일이나 하고 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = 8321354a-99e0-43af-9cc8-d37657aa16ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:8321354a-99e0-43af-9cc8-d37657aa16ed
msgctxt "h8b0a754eg2aebg4771g82b3g92bbe5b34c3e"
msgid "More importantly, why is one of our rank on guard duty?"
msgstr "그보다, 왜 참된 영혼씩이나 돼서 경비를 서고 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = 83ca71e3-0d41-c9f3-ae11-a8717bf0438b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:83ca71e3-0d41-c9f3-ae11-a8717bf0438b
msgctxt "h9c95e577g5f4ag49b4g91a6g0bc522590b55"
msgid "I knew it. Traitor!"
msgstr "그럴 줄 알았다, 이 배신자!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = 87a56ec6-cd04-c486-ed37-89c4fd19d790
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:87a56ec6-cd04-c486-ed37-89c4fd19d790
msgctxt "h6f47328eg16eeg4ba4ga25fgbf32505dabee"
msgid "Surprise - I'm here to take your head."
msgstr "짜잔 - 네 머리를 가지러 왔다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = 8aec500d-1fc5-9be8-2099-1c0461d290b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:8aec500d-1fc5-9be8-2099-1c0461d290b6
msgctxt "hb25c2f2ag3710g42c2g9937gc95c5490779b"
msgid "She's in the audience chamber, True Soul. Go right ahead."
msgstr "즈렐 님은 알현실에 계시다, 참된 영혼이여. 안으로 들어가도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = 7ad8ee34-3ec4-bffa-11d8-817b897b0b6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:7ad8ee34-3ec4-bffa-11d8-817b897b0b6f
msgctxt "hee3d53cegecf7g4fc5g9d25gce6e1bb581a2"
msgid "Who better to suss out his like?"
msgstr "동족을 가려내는 일에 더 나은 적임자가 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = 8bbfb734-7525-4afe-968d-7720990200e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:8bbfb734-7525-4afe-968d-7720990200e4
msgctxt "h7dff75efg6ca1g4a67g8a6dg6b8e815fcc4e"
msgid ""
"To greet those of our like, and weed out those who walk where they do not "
"belong."
msgstr "우리와 같은 자들을 맞이하는 동시에, 여기 와서는 안 되는 이들을 걸러내기 위함이지. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = 90667eb6-35c6-b344-92d2-17cb8c76776b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:90667eb6-35c6-b344-92d2-17cb8c76776b
msgctxt "h95c9a4efg329eg46d0gb37bgadaa17efb174"
msgid ""
"My mistake - your mind tasted familiar. Where <i>are </i>you reporting from?"
msgstr "실수를 했군. 그대의 정신이 친숙하게 느껴졌거든. <i>그럼 </i>어디서 오는 길이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = 93a8df19-051e-1edf-f3b6-9adc61c29701
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:93a8df19-051e-1edf-f3b6-9adc61c29701
msgctxt "h0c588838g7c6ag4650g81c8gdffe7fdadeb1"
msgid "Where do you think you're going?"
msgstr "어딜 가려는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Narrator
#. NodeID = a05a77d6-9331-fbb1-5b41-37ea553b59d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(2) = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:a05a77d6-9331-fbb1-5b41-37ea553b59d2
msgctxt "h02a1b8f6g30b8g4d14gbb72g858041edf7c4"
msgid ""
"*His mind attempts to connect with yours and finds - nothing. You have no "
"tadpole, and no welcome in this place.*"
msgstr "그의 정신은 당신과 연결하려고 시도하지만, 아무것도 찾지 못합니다. 당신은 올챙이가 없기 때문에 이곳에서 환영받지 못합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Narrator
#. NodeID = a05c4a6c-bd68-4fa8-b185-488e15de027c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(1) = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:a05c4a6c-bd68-4fa8-b185-488e15de027c
msgctxt "h5eed2694g818eg4304g9065g6bc38daf691b"
msgid ""
"*Her mind attempts to connect with yours and finds - nothing. You have no "
"tadpole, and no welcome in this place.*"
msgstr ""
"*그녀가 당신과 정신을 연결하려 해 보지만 아무것도 발견하지 못합니다. 당신에겐 올챙이가 없기 때문에, 이 곳에서 환영받지 못합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Gale
#. NodeID = a92ea081-f8be-a306-f357-fb9518f3f6d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:a92ea081-f8be-a306-f357-fb9518f3f6d0
msgctxt "h275eea00ge065g4856g9618g480ee71631f6"
msgid "If it's an audience she desires, an audience let us provide."
msgstr "알현을 원하신다면야, 그렇게 해 드려야겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = a8b7a996-fd0d-0ae7-7a51-25d1ec945a15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:a8b7a996-fd0d-0ae7-7a51-25d1ec945a15
msgctxt "hb6188b62g3946g47a9gae12ge2ff8938760e"
msgid "Z'rell will be glad to hear it. The scrying eyes only see so much."
msgstr "즈렐 님께서 듣고 싶어하실 거다. 감시하는 수정구로는 한계가 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = aaf8bf0b-02ee-4599-9084-ce780f701514
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:aaf8bf0b-02ee-4599-9084-ce780f701514
msgctxt "h7c4b72d1g3ed2g4fe5gb03dg3ce51f6d9145"
msgid "Glad to hear it. Z'rell will be too. The scrying eyes only see so much."
msgstr "다행이로군. 즈렐 님께서도 그리 생각하실거다. 감시하는 수정구들은 보는 일밖에 못 하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = ae20d772-8548-8f73-f4ae-d8486452fb73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Necromancer_State_AtMoonrise = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:ae20d772-8548-8f73-f4ae-d8486452fb73
msgctxt "h19b0f856gb135g463cgaabeg1918ac81b04c"
msgid ""
"General Ketheric's advisor went off on a field trip - Z'rell's in charge "
"'til he gets back."
msgstr "케서릭 장군님의 자문관이 지금 파견을 나간지라, 즈렐 님이 그 자릴 대신하고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = accf2b79-b45a-4a86-99cd-fd7b704ca2bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Necromancer_State_AtMoonrise = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:accf2b79-b45a-4a86-99cd-fd7b704ca2bb
msgctxt "h0f65f8bbga361g42e7gbe11g007c272d8823"
msgid ""
"General Ketheric's advisor went off on a field trip - Z'rell's in charge "
"'til he gets back."
msgstr "케서릭 장군님의 자문관이 지금 파견을 나간지라, 즈렐 님이 그 자릴 대신하고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = adaae895-d440-4be6-98e1-4a69aad0176d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:adaae895-d440-4be6-98e1-4a69aad0176d
msgctxt "hd84f2f0agb71fg4becgb19ag657deb9a43af"
msgid "Impressive. I'm sure Z'rell will want to hear all about it."
msgstr "훌륭하군. 즈렐 님도 그 얘길 듣고 싶어하실 거다. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = baffb768-5de8-d57c-fe3f-a68f19e683ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:baffb768-5de8-d57c-fe3f-a68f19e683ca
msgctxt "hea1f9832g6728g43b3ga60fg69841443aec7"
msgid ""
"Did she now? You'll find her inside, although she may not be disposed to "
"welcome you."
msgstr "그랬단 말이지? 안에 그 여자도 있긴 하다만, 아마 환영 인사를 건넬 처지는 못 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = af982a49-c9bb-453e-9281-d9a1a6882f93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:af982a49-c9bb-453e-9281-d9a1a6882f93
msgctxt "h47307eecgd934g4626g91d0gd217ef6092cc"
msgid ""
"Did she now? You'll find her inside, though you'll want to speak to Z'rell "
"first."
msgstr "그랬단 말이지? 안에 그 여자도 있긴 하다만, 그 전에 즈렐 님과 먼저 대화를 하는 게 좋을 거야. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Narrator
#. NodeID = c1c98c52-63c7-6863-6b04-359add0aa1cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:c1c98c52-63c7-6863-6b04-359add0aa1cd
msgctxt "hd2ed1f34gf15ag4518gb2c7gf0c0743b9063"
msgid ""
"*His thoughts invade your own, probing for purchase. Your parasite purrs in "
"recognition.*"
msgstr "*그의 정신이 당신에게 침투해 뭔가를 얻기 위해 들쑤시고 있습니다. 당신의 기생충이 알아보고 기분 좋게 가르랑거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Narrator
#. NodeID = b00da98c-a792-4262-8f85-7444ab30e588
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:b00da98c-a792-4262-8f85-7444ab30e588
msgctxt "h0e6a8619g51d6g4b9eg94e4gff5b07579f4c"
msgid ""
"*Her thoughts invade your own, hunting for recognition. Your parasite offers "
"it, readily.*"
msgstr "*그녀의 생각이 당신 머릿속을 침범하더니, 인지되길 갈구합니다. 당신의 기생충이 기다렸다는 듯 응답합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Narrator
#. NodeID = b379e107-245a-029d-3d08-02919e84652b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:b379e107-245a-029d-3d08-02919e84652b
msgctxt "hb4d81eabge45cg4cfegba3dg9f23cf5b66c7"
msgid "*Her thoughts probe your own, finding - freedom. <i>Heresy</i>.*"
msgstr "*그녀의 생각이 당신 머릿속을 탐색하고, 자유를 찾아냅니다. <i>이단</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = c26f4885-0949-eddc-52b0-dc1aa2d28509
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:c26f4885-0949-eddc-52b0-dc1aa2d28509
msgctxt "hb4cf9937g0911g4687gb9b1g2f2030242517"
msgid "In Her name."
msgstr "그분의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = bc7bc523-8bb8-4c0a-8d3f-86bdbf8ea9af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:bc7bc523-8bb8-4c0a-8d3f-86bdbf8ea9af
msgctxt "he0960a9fg8d0bg40c9gbb4bg4f96a8781266"
msgid "In Her name."
msgstr "그분의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = cffd8b86-bd66-039c-7fed-c0f5ff2a501f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:cffd8b86-bd66-039c-7fed-c0f5ff2a501f
msgctxt "heb2be97cge7c8g428bgbeccgcd548e896795"
msgid "Ah, one blessed like myself. What news, True Soul?"
msgstr "아, 나처럼 축복 받았군. 어떤 소식이 있지, 참된 영혼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = c1e32fe5-0779-495a-a203-33284198ecc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:c1e32fe5-0779-495a-a203-33284198ecc9
msgctxt "h07c2339cg03a0g4fb4gb5eag9251725fec57"
msgid "True Soul. A pleasure. What news from the field?"
msgstr "참된 영혼이여. 반갑군. 밖에 새로운 소식이 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Zealot Malik
#. NodeID = d81e6aac-b464-ca3f-28ad-2777a11e74e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:d81e6aac-b464-ca3f-28ad-2777a11e74e5
msgctxt "h1ab6283bg931cg46a2g8093g48543f940a32"
msgid "Right enough."
msgstr "응당 그래야겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = c2e8ee0f-f354-4540-a5a2-bc8ad909e7f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:c2e8ee0f-f354-4540-a5a2-bc8ad909e7f2
msgctxt "hfc24d3cbg78bdg4e7eg8dc1g9b2a287b5a18"
msgid "Oh they will."
msgstr "그렇게 될 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Astarion
#. NodeID = c8023ea5-7c49-e692-923b-949489e284af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:c8023ea5-7c49-e692-923b-949489e284af
msgctxt "h80223ed8gc138g41b2gb98bg3a03fb40f388"
msgid "Well then, let's not keep her waiting."
msgstr "좋아 그럼, 기다리게 할 순 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = d3fb8e35-748f-ea12-a8de-5a7b169a761d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_EnteringHaven_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:d3fb8e35-748f-ea12-a8de-5a7b169a761d
msgctxt "h1d609317g9dafg4c50gab98g18a593fcc982"
msgid "I infiltrated a group of Harpers at an Inn, out in the shadows."
msgstr "그림자 너머 한 여관에 있는 하퍼 무리에 잠입했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = dd9d44ef-e7c6-31e5-fe2f-2068892bafd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_NightsongPrison_Event_NightsongSentToMoonrise = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:dd9d44ef-e7c6-31e5-fe2f-2068892bafd5
msgctxt "h7f3ffe35g333fg479bgb9e4g30bc9444cbaa"
msgid ""
"How delightful. It's <i>you</i>. Disciple Z'rell was looking forward to "
"meeting the one who aided Balthazar. She was very pleased indeed<i> </i>to "
"see him return with the Nightsong."
msgstr ""
"기쁜 일이로군. <i>당신</i>이라니. 신봉자 즈렐 님께서 발타자르 님을 도와주신 분을 만나고 싶어하셨다. 밤의 노래와 함께 돌아온 "
"발타자르 님을 보시며 <i>정말로</i> 기뻐하셨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = de86b84e-6401-b7cc-18dd-658df6354d25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:de86b84e-6401-b7cc-18dd-658df6354d25
msgctxt "h689ccd7eg5644g4f45g92afg636dcdd789bd"
msgid "Nowhere of importance. What news inside?"
msgstr "중요한 곳은 아니다. 안에선 별 소식 없나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Adept Merim
#. NodeID = e8897d26-9d58-046f-9202-b27f3e0f2f18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:e8897d26-9d58-046f-9202-b27f3e0f2f18
msgctxt "h535064efg5b97g49b7gb649g3e92b71aeb2b"
msgid ""
"You'll find Z'rell in the audience chamber, True Soul. She'll be wanting to "
"hear from you."
msgstr "즈렐 님은 알현실에서 찾을 수 있을 거다, 참된 영혼. 소식을 직접 듣고 싶어하실 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Zealot Krizt
#. NodeID = e3e5f92f-837e-46fa-be0c-05adcf027a3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:e3e5f92f-837e-46fa-be0c-05adcf027a3b
msgctxt "hb64975a8gd2b7g41e7g9556g17ab5b60ab41"
msgid "Z'rell's in the audience chamber, True Soul. Go right ahead."
msgstr "즈렐 님은 알현실에 계시다. 참된 영혼. 바로 앞으로 가면 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = ea1aedcb-3075-898a-a7b9-7182c1847bec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:ea1aedcb-3075-898a-a7b9-7182c1847bec
msgctxt "h01c32cabg7dd8g4be2gb53bgeed2a3127ea2"
msgid "Great news: I'm here to take your head."
msgstr "좋은 소식이 있지. 네놈들의 머리를 취하러 왔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = e4be9e8d-8e03-4e26-a794-13b7991b7e22
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:e4be9e8d-8e03-4e26-a794-13b7991b7e22
msgctxt "heb453ec2g72eeg4f7egb483g0bd2f75b8116"
msgid "Great news: your imminent death."
msgstr "좋은 소식, 네가 곧 죽을 거라는 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Karlach
#. NodeID = f0a26696-9cb8-dcec-fafd-4b9dc8e72973
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:f0a26696-9cb8-dcec-fafd-4b9dc8e72973
msgctxt "hfebd1295gf3eeg4f23g88d0gaae7448ed40b"
msgid ""
"That's what I call an invitation. Let's find Z'rell and get this caravan "
"moving."
msgstr "이 정도는 돼야 초대라고 할 수 있지. 이제 즈렐을 찾아서 앞으로 나아가자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = f16ec225-0322-8efa-382a-0c7ab8b3911a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_EntranceCheckpoint_AllowedIn = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:f16ec225-0322-8efa-382a-0c7ab8b3911a
msgctxt "h99763018gdd40g4e5dg9c38gd99052320f8e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = f2135464-9ef0-4c41-a5e2-2b41285f2d2b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_EntranceCheckpoint_AllowedIn = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:f2135464-9ef0-4c41-a5e2-2b41285f2d2b
msgctxt "h08f6ad52gbde3g4939g90abgd1e9abbb6d51"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint
#. Speaker = Player
#. NodeID = fafdebaa-4c08-41dc-efd5-c639f6697986
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_Event_ToldGeneral = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_EntranceCheckpoint:fafdebaa-4c08-41dc-efd5-c639f6697986
msgctxt "h0efdbc31ge83eg48d6gbfbegb6399a83ec86"
msgid "I have a message from Nere. Who should I report to?"
msgstr "니어의 전갈을 가져왔다. 누구에게 보고하면 되지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint
#. Speaker = Player
#. NodeID = f4ba880f-565c-40fa-85be-80beecc40a80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_Event_ToldGeneral = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Checkpoint:f4ba880f-565c-40fa-85be-80beecc40a80
msgctxt "hfd2604a2g0c48g482ag978egbf899dc129d1"
msgid "I have a message from Nere. Who should I report to?"
msgstr "니어의 전갈을 가져왔다. 누구에게 보고하면 되지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 06485d9b-7f94-7dd2-b9b6-8700234ef89d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:06485d9b-7f94-7dd2-b9b6-8700234ef89d
msgctxt "hc04234dfg56a1g4f4bga265g3dbcb37ed59e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = 11c842a8-9b7d-65e3-e22f-9fc43295edc6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_Knows_TadpoleVats = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:11c842a8-9b7d-65e3-e22f-9fc43295edc6
msgctxt "h5bc63e05g1a92g4e3cgbc8ega96a37a19d67"
msgid ""
"*Tadpoles. His mind had rejected the knowledge, forced it behind a mental "
"wall. A wall you just took a hammer to.*"
msgstr "*올챙이들입니다. 그의 정신은 앎을 거부하고, 정신의 장벽 뒤로 밀어 넣었습니다. 당신은 벽을 부술 망치를 들이밉니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 1bdb999b-56c3-25be-8fec-1514adbf2ae1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:1bdb999b-56c3-25be-8fec-1514adbf2ae1
msgctxt "hf93124e6g4152g4bc7g8629g60e6f751d3c7"
msgid "What's in the boxes?"
msgstr "상자 안에 뭐가 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = 1fb7e794-4621-1a2c-4695-797467c807de
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_State_PersuasionSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:1fb7e794-4621-1a2c-4695-797467c807de
msgctxt "h9ffd280cgf685g46d5ga631g05edf24aa15a"
msgid "Eh... right you are, I suppose. Check away."
msgstr "에... 옳은 말 같군. 확인해 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 27ce64c1-3f6c-9aac-fa26-0a614d0001ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:27ce64c1-3f6c-9aac-fa26-0a614d0001ad
msgctxt "h682d78e1gcaddg4012gb754g44dd4a7548e6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 2814f3c6-4bac-24d3-553d-c04a292d23bb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:2814f3c6-4bac-24d3-553d-c04a292d23bb
msgctxt "he99d1040ge4b8g4ab9g8560gc162be880d14"
msgid "Guard duty's boring. You're letting your imagination run away with you."
msgstr "경비는 지루한 법이지. 네 상상이 주체가 안 되는 모양이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = 28c6be55-c99e-4b24-b808-576e620588a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:28c6be55-c99e-4b24-b808-576e620588a0
msgctxt "hc88b6d0fgcfb1g40bfg8eaaga83ab8be3efe"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떠한 것도 느껴지지 않습니다. 일리시드 능력을 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = 29b03e14-08e8-4f3f-929f-9d8761e629cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:29b03e14-08e8-4f3f-929f-9d8761e629cd
msgctxt "h6c7998a1gc845g41d7gbd94gdfc605657848"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 2e74e297-4db2-09d7-6cfd-f82e9f2685e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:2e74e297-4db2-09d7-6cfd-f82e9f2685e3
msgctxt "hc4eb7327g40a3g471egb5caga0de36e49976"
msgid "What cargo?"
msgstr "무슨 화물이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = 335f3bca-7aee-4ccd-a607-428169d7137e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:335f3bca-7aee-4ccd-a607-428169d7137e
msgctxt "h74b2889cg2645g4d6cgbf9dg503538cde66a"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 345e0a57-9391-4d99-a80f-a90f9a282963
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:345e0a57-9391-4d99-a80f-a90f9a282963
msgctxt "hf6408c84gbe0cg45a3g82b4g017902e79dca"
msgid "Think hard. What's <i>really</i> in the boxes?"
msgstr "잘 생각해 봐. <i>정말로</i> 상자 안에 뭐가 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = 36367849-0261-42b4-bfeb-029b3202a849
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_State_FailedTadpoleRoll(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:36367849-0261-42b4-bfeb-029b3202a849
msgctxt "h3d022999g7050g42c7gbc00g0bdd069599b6"
msgid "It's just food. Supplies. Like I said."
msgstr "그저 식량이야. 보급물자라고. 내가 말한 것처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 3a1ba994-d8e9-4170-86fa-96c65ef7f2a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#.      - GLO_Tadpoled_UsedToday2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:3a1ba994-d8e9-4170-86fa-96c65ef7f2a2
msgctxt "hfdaa00afgbb77g4854gab75gc8b91694be2e"
msgid "Think hard. What's <i>really</i> in the boxes?"
msgstr "잘 생각해봐. <i>정말로</i> 상자 안엔 뭐가 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 3ef18d3d-d64e-8545-64de-8283b00e2c9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:3ef18d3d-d64e-8545-64de-8283b00e2c9f
msgctxt "ha7c33cecgeac8g42abgbbefg81df0158c4c1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 413c3e71-def0-8fd4-33d7-6b782e18cca9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = False
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:413c3e71-def0-8fd4-33d7-6b782e18cca9
msgctxt "hcc6b3387ge32eg4047g9f73g3a3fbb87ca5a"
msgid "Then you won't mind stepping aside and letting me look."
msgstr "그렇다면 내가 들여다보게 해줘도 개의치 않겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 45f0514c-0b7b-87a9-8acb-c84d2b0fb34d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:45f0514c-0b7b-87a9-8acb-c84d2b0fb34d
msgctxt "h10752534g5fc4g4a97gb609g141ae9f7126e"
msgid "You had best wash them off."
msgstr "물로 씻어내는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = 4b3e9376-caa8-90f2-876a-8c9542fb56a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_State_ToldTrueSoul = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:4b3e9376-caa8-90f2-876a-8c9542fb56a9
msgctxt "h8e9bc994g7933g4be4g89b9g5bea5b65491a"
msgid "Worms. Do you feel them? Feel them crawling?"
msgstr "벌레들. 느껴지나? 그것들이 기어 다니는 게?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = 4e3a42d0-276e-e1f5-b7ae-b889d15157cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:4e3a42d0-276e-e1f5-b7ae-b889d15157cc
msgctxt "h85e77ee3g8c39g4b83gbef0g92540a248b86"
msgid "W-worms. Worms in their <i>heads</i>. <i>Worms all over!</i>"
msgstr "버, 벌레야. 그들의 <i>머리</i>에 벌레가 있어. <i>사방이 벌레다!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = 53c696de-8182-3eea-1597-26ddf736efd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_State_FailedTadpoleRoll(1) = False
#.      - MOO_Docks_HasMet_DockJumper(1) = True
#.   Global:
#.      - MOO_Docks_State_ToldTrueSoul = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:53c696de-8182-3eea-1597-26ddf736efd5
msgctxt "he7b20bb0g4452g4f93gac7fgd7262afa0dc7"
msgid "Not long before they march on the city."
msgstr "군대가 곧 진격을 시작할 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = 540e1d85-e04a-43a1-44ab-b0b3cb241a3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:540e1d85-e04a-43a1-44ab-b0b3cb241a3d
msgctxt "h3ffeb5a1gd76fg47d6ga332gb8f7d19e1782"
msgid "Locals need to see Her truth - take their place in Her design."
msgstr "그들이 그분의 진실을 봐야지. 그분의 설계에 동참할 수 있도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 5b8d43f9-5c54-5267-860e-bfa6b879e59e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:5b8d43f9-5c54-5267-860e-bfa6b879e59e
msgctxt "h0c5822e0g97c2g4e8cg8933g6241701be193"
msgid "Your friends are bringing unusual cargo with them."
msgstr "네 동료들이 평소와는 다른 화물을 가져왔던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = 5cc38493-90ec-5ad6-0ba2-bcc2af173520
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_HasMet_DockJumper(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_HasMet_DockJumper(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:5cc38493-90ec-5ad6-0ba2-bcc2af173520
msgctxt "hdb67bcf8gbef3g44b0ga869g2227e965cf48"
msgid "I'm afraid you missed the ship, True Soul."
msgstr "안타깝게도 배를 놓쳤어, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = 63d4e6c3-eff8-41ed-a1f2-e07f2ab6a530
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:63d4e6c3-eff8-41ed-a1f2-e07f2ab6a530
msgctxt "h384c14b4gbd05g4f50g82cbg580cd1e9f170"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 69e3a34f-0fe4-d0b6-51dd-e189e984eecb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = False
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#.      - GLO_Tadpoled_UsedToday2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:69e3a34f-0fe4-d0b6-51dd-e189e984eecb
msgctxt "h5b5cd18cg25afg468bg8969g6b4448b43ac2"
msgid "Then you won't mind stepping aside and letting me look."
msgstr "그렇다면 내가 들여다보게 해줘도 개의치 않겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 6d83f004-cb09-c609-3fad-05695e1a6035
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:6d83f004-cb09-c609-3fad-05695e1a6035
msgctxt "h8a1502cdg8cf1g406fgb428g85a4b5269bb8"
msgid "Where are the ships heading?"
msgstr "배가 어디로 가는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 71d5aacd-f8f2-2270-ced9-a67150ac2f60
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:71d5aacd-f8f2-2270-ced9-a67150ac2f60
msgctxt "hb5bca0c1g18eag4b65g9141g89aeec0af5ce"
msgid "The cargo's important. Another look can't do any harm."
msgstr "화물은 중요해. 한 번 더 확인한다고 나쁠 것 없잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = 7b2a4035-eb61-4594-8591-0e38d00088cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_Companion(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_Companion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:7b2a4035-eb61-4594-8591-0e38d00088cd
msgctxt "hd2cc6104g6580g4eeaga965g92c3b734009a"
msgid ""
"*A strange sensation courses through you, and your companion's mind unfolds, "
"secrets half-revealed.*"
msgstr "*기묘한 감각이 당신을 관통하고, 동료의 정신이 펼쳐지며 그가 지닌 비밀이 반쯤 드러납니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 80e609a8-dfe6-cb77-1b63-0e35148282b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:80e609a8-dfe6-cb77-1b63-0e35148282b8
msgctxt "h3b7affcbg0cf4g4479g8194g0ad2bdc1e121"
msgid "Why does the Absolute want to make war with the city?"
msgstr "왜 절대자님께서 발더스 게이트와 전쟁을 치르시려는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = 81f5b890-ccd1-92c7-0fad-dd70c662b4d5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_Event_GuardJumped = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:81f5b890-ccd1-92c7-0fad-dd70c662b4d5
msgctxt "h8508f775g1d73g476fg9171g19e9704ca92e"
msgid "P-parasites! <i>Worms!</i>"
msgstr "기, 기생충이다! <i>벌레다!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = 8a7a1213-3631-46e3-bbc5-75b2e4f5b90d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:8a7a1213-3631-46e3-bbc5-75b2e4f5b90d
msgctxt "hbdd0867fga8e8g4904gb07bg8d851182d8f6"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 9790b578-d65e-5d70-594d-6e3e9b7186e1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:9790b578-d65e-5d70-594d-6e3e9b7186e1
msgctxt "h3ba865aega715g4665g93a3gd1cfc732c648"
msgid "Your job is to guard. Leave the details to me, yes?"
msgstr "네 임무는 경비를 서는 것이지. 세세한 건 나한테 맡기라고, 알아들어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = 9bd2130d-7a9a-2b47-27be-f3d12ed3d45e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:9bd2130d-7a9a-2b47-27be-f3d12ed3d45e
msgctxt "h42d0627egd859g4442ga4a6gaf0fac1c694f"
msgid ""
"But there'll be another along soon enough. We're already stacking the cargo."
msgstr "곧 다른 배가 올 거야. 이미 화물은 쌓아뒀어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = 9d930dcc-1cf0-6af6-96d4-d1fa3d468117
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_GuardJumper_FixedMind = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:9d930dcc-1cf0-6af6-96d4-d1fa3d468117
msgctxt "h293c3241gf928g4ed0ga4a3gc1ce3c4e0a80"
msgid ""
"*And as quickly as you tore down his defences, you shore them back up. His "
"mind is blank, and blissfully ignorant once more.*"
msgstr "*당신은 그의 정신 방벽을 허물자마자 다시 구축합니다. 그의 정신은 텅 비었고, 다시 무지라는 축복을 누립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = 9fd4d261-ef2d-dcd4-bb14-b5d1e266390c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:9fd4d261-ef2d-dcd4-bb14-b5d1e266390c
msgctxt "had263d19g4b30g48dbg9e62g028d27bb1c6a"
msgid "What cargo are they bringing?"
msgstr "어떤 화물을 싣고 가는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = a67b840e-51cf-6da6-3014-42d05639349b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:a67b840e-51cf-6da6-3014-42d05639349b
msgctxt "h5b5da249g09eeg4df1gbdb5gb06432081d13"
msgid "I checked the cargo. It's a little unusual."
msgstr "화물을 확인했어. 평소 같지 않던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = ae2d1c1b-c0db-a227-0c48-abeebcb68d5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = False
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#.      - GLO_Tadpoled_UsedToday2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:ae2d1c1b-c0db-a227-0c48-abeebcb68d5f
msgctxt "h5230a53ag30ddg45a0ga823g2bb8ef3e0b11"
msgid "Then you won't mind stepping aside and letting me look."
msgstr "그렇다면 내가 들여다보게 해줘도 개의치 않겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = b137060b-525f-4555-2856-24446c35159c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = False
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:b137060b-525f-4555-2856-24446c35159c
msgctxt "h8a32edd3g2226g4146g9ef1gb3cccd06d126"
msgid "Then you won't mind stepping aside and letting me look."
msgstr "그렇다면 내가 들여다보게 해줘도 개의치 않겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = b4753362-7d04-03f6-18bb-3c31b8b0aff2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:b4753362-7d04-03f6-18bb-3c31b8b0aff2
msgctxt "h51e0539dgdfa2g4fa4g877fgb10c4f4f8693"
msgid "Don't see how, True Soul. It's just supplies going ahead of the troops."
msgstr "어디가 그렇다는 건지 모르겠는데, 참된 영혼. 그저 군대보다 앞서 가는 보급물자 일 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = c112e306-de1b-4d35-8abf-5c94300a6255
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#.      - GLO_Tadpoled_UsedToday2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:c112e306-de1b-4d35-8abf-5c94300a6255
msgctxt "h819b6f23ga326g4f4ag8041g27f9acf0d2c6"
msgid "Think hard. What's <i>really</i> in the boxes?"
msgstr "잘 생각해봐. <i>정말로</i> 상자 안엔 뭐가 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = c4658ad2-17e7-2583-a2e3-4f7883f6c361
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:c4658ad2-17e7-2583-a2e3-4f7883f6c361
msgctxt "ha04997e9g0701g452bg8f67gf5cb22a71861"
msgid ""
"Or they don't, and we send them to meet the old gods they cling to. Doesn't "
"matter much either way."
msgstr "거부하면 놈들이 매달리는 구닥다리 신 곁으로 보내줘야지. 어느 쪽이던 상관 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = c93a5792-3ebc-49d7-8007-b5c338b6da7c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 14
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:c93a5792-3ebc-49d7-8007-b5c338b6da7c
msgctxt "h18e62229gfabbg4464g9a59g35db00cecb3f"
msgid "Think hard. What's <i>really</i> in the boxes?"
msgstr "잘 생각해봐. <i>정말로</i> 상자 안엔 뭐가 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = ccbf543d-b28d-46f5-b739-b316ef094360
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:ccbf543d-b28d-46f5-b739-b316ef094360
msgctxt "h2bb28374g95bag4d13gb15ag1a64c15bf725"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Player
#. NodeID = d056efa9-1917-e82b-d6ad-4c3bfda16454
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:d056efa9-1917-e82b-d6ad-4c3bfda16454
msgctxt "h1c825356g4949g4213g9090g11e3470495e0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = d511003f-6853-4283-86f7-b791888c1b9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:d511003f-6853-4283-86f7-b791888c1b9f
msgctxt "hf49ebf18gaa7eg488bgbe54gb49afd8dbf9f"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = d654008a-0a3d-cd75-0f1f-a306a8b5c6f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_GuardJumper_FixedMind = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:d654008a-0a3d-cd75-0f1f-a306a8b5c6f6
msgctxt "h1f1941c2gcafdg4e8bg99f5gdcaf17f59c7f"
msgid "Another along soon, True Soul. Another. Another..."
msgstr "다른 배가 곧 올거다, 참된 영혼. 다른 배. 다른 배..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = d8b68305-f472-4ea2-82d0-2d3dc59d15eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:d8b68305-f472-4ea2-82d0-2d3dc59d15eb
msgctxt "h501eea6bg5252g468agbb57g72cf1f93fcc4"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = df10e4be-f79b-7fad-180a-283a8337fa1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Event_GuardJumped = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:df10e4be-f79b-7fad-180a-283a8337fa1e
msgctxt "h6aed7ab8gdb65g49cag9442g869e74b37707"
msgid "<i>Worms. </i>Crawling under my skin. Get them off, get them off!"
msgstr "<i>벌레다. </i>내 살갗 아래를 기어다니고 있어. 없애 줘, 없애 달라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = e126eda1-098d-03d0-42e2-1a32927ae4dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:e126eda1-098d-03d0-42e2-1a32927ae4dc
msgctxt "h12de2e62g91f8g49f7gbe67g2dd47914d597"
msgid ""
"Baldur's Gate. The army marches overland, but we've sent some friends ahead "
"to smooth the way."
msgstr "발더스 게이트로 가고 있어. 군대는 육로로 가지만, 길을 닦으려고 친구 몇 명을 앞서 보냈지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = e6dba862-0f36-8bca-425d-ba8a50b565b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:e6dba862-0f36-8bca-425d-ba8a50b565b5
msgctxt "hc3e6f4bfgce30g49fegad06gbaf701881265"
msgid ""
"Nothing of note. Just supplies for the battle ahead - I've already checked "
"it twice over."
msgstr "별거 아니야. 그냥 곧 있을 전투를 위한 보급물자지. 내가 이미 두 번 확인했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = e9d1da55-b0b7-482c-8374-66fbb8fdcbc9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:e9d1da55-b0b7-482c-8374-66fbb8fdcbc9
msgctxt "ha35b6e45g2d1bg48bbg98c8g1b8b38d575e2"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = e9e42bf2-a09a-4cea-b2bd-5bb697961f06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:e9e42bf2-a09a-4cea-b2bd-5bb697961f06
msgctxt "h7d041f83gbe9fg4f2cg83e7g72e241657fad"
msgid ""
"*You focus on the source of the power, but it is quiet and still. It needs "
"to rest.*"
msgstr "*힘의 원천인 존재에 정신을 집중하지만, 응답이 없습니다. 휴식이 필요한 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = eaa3e0f5-f59c-4bee-ac36-02b6974e47f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:eaa3e0f5-f59c-4bee-ac36-02b6974e47f8
msgctxt "h94aa85c9g104ag42e2gb37dg68f097097ea2"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Narrator
#. NodeID = fa37b41e-c939-499a-95fb-d394d7c05075
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_State_ToldTrueSoul = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:fa37b41e-c939-499a-95fb-d394d7c05075
msgctxt "h6d6623fcg2217g4e56ga1e0gc2ccb895a14b"
msgid ""
"*As you bear down on his mind, you feel a pulse in response. A <i>thousand</"
"i> pulses, echoing from the nearby crates.*"
msgstr "*그의 정신에 압박을 가하자, 그 반응으로 박동이 느껴집니다. 천 개의 박동이 근처 상자들에서 메아리칩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = fb0b0e68-997d-881c-4548-881ad6c46e56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:fb0b0e68-997d-881c-4548-881ad6c46e56
msgctxt "hc116a2beg4fa4g4315g94f9ge92558a252d8"
msgid ""
"...Hm? Oh, True Soul. You just missed the ship - but there'll be another one "
"along soon."
msgstr "...흠? 오, 참된 영혼이군. 배는 방금 막 떠났지만, 곧 또 다른 배가 도착할 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper
#. Speaker = Acolyte Marls
#. NodeID = feda97ad-9651-2011-dc33-97dac1cd1907
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_State_FailedTadpoleRoll(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardJumper:feda97ad-9651-2011-dc33-97dac1cd1907
msgctxt "h53572a77g2af5g4979g80ecg134c99732e2d"
msgid "I'm on duty, True Soul. Sorry."
msgstr "임무 중이라서 말이야, 참된 영혼. 미안해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = 1321b739-e0a9-9f2b-2e8c-1cb2005e1348
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_State_PersuasionSuccess = False
#.      - MOO_Docks_Knows_TadpoleVats = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:1321b739-e0a9-9f2b-2e8c-1cb2005e1348
msgctxt "h7aa54b14gf8d8g4052g81d6g56a492daec35"
msgid "He tried to stop me from inspecting the cargo."
msgstr "놈은 내가 화물을 검사하는 걸 막으려고 했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 180a889b-7c01-a585-3d14-ca7b55f2b8ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_HasMet_OberverTadpolePowers(1) = False
#.   Object:
#.      - MOO_Docks_State_GuardWitnessTrueSoul(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_HasMet_OberverTadpolePowers(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:180a889b-7c01-a585-3d14-ca7b55f2b8ee
msgctxt "hc4503d11gecc6g4147ga43agb6c2be8b8fa8"
msgid "I see Marls took... took a bit of a dive."
msgstr "말스가... 물에 뛰어든 것 같던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = 191be084-4388-2a47-9821-2354a7bd3314
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Event_GuardJumped = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_State_TalkedAboutJumper(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:191be084-4388-2a47-9821-2354a7bd3314
msgctxt "h9925466fg9207g4cedg9cb0g24bf2076b490"
msgid "Just letting you know that your soldier's taken a dive into the lake."
msgstr "그냥 네 병사가 호수에 뛰어들었다는 걸 알려주려고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 19370b3e-dffe-c048-d867-4b0131116fde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:19370b3e-dffe-c048-d867-4b0131116fde
msgctxt "h773fc4f2gd815g49fagb318g7166b732e113"
msgid "Of course, True Soul! As you say."
msgstr "물론입니다, 참된 영혼! 분부대로 합죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 1a26af0c-1884-1ca2-049f-b653658daab4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:1a26af0c-1884-1ca2-049f-b653658daab4
msgctxt "hb9e238e9g7bb5g4cabga182g22a5ea276ba3"
msgid ""
"They're not to be opened until they reach the city. The Absolute smiles on "
"them that <i>follow orders.</i>"
msgstr "발더스 게이트로 가기 전까지 열어서는 안 됩니다. 절대자께서는 <i>명령을 따르는</i> 자들에게 미소 지으십니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = 1d368aa9-b679-1a1b-97b6-27285ad3192c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_State_TalkedAboutJumper(1) = False
#.   Global:
#.      - MOO_Docks_Event_GuardJumped = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_State_TalkedAboutJumper(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:1d368aa9-b679-1a1b-97b6-27285ad3192c
msgctxt "h8dfbee1ag9c18g4128g8468g1e699a8d095e"
msgid "I see. Then you'd better fish your man out of the lake."
msgstr "그렇군. 그러면 네 동료나 좀 호수에서 건져 올려 주지 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 1d95520c-8ea0-908c-f164-f0447f1fbcab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_State_ReportJump = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:1d95520c-8ea0-908c-f164-f0447f1fbcab
msgctxt "h7417ad24g7777g440dgaf5dg651d6d0311b7"
msgid "He was from the city, I think. Well... down there's his home now."
msgstr "놈은 발더스 게이트 출신일 겁니다. 뭐... 이제는 저 밑이 놈의 집이 됐지만요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = 1f6cc658-13a1-7bf6-8755-4209bb72a6aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:1f6cc658-13a1-7bf6-8755-4209bb72a6aa
msgctxt "hc936fe0cgffa5g4ebdg9979g774a07cf3669"
msgid "Tell me why you're shipping tadpoles to the city."
msgstr "왜 발더스 게이트로 올챙이를 운송하는 건지 말해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = 2839f98d-c3a6-f9aa-d144-2e31d9b9e7fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:2839f98d-c3a6-f9aa-d144-2e31d9b9e7fb
msgctxt "hdd1a62fdg66e1g4431g8343gba875734cb2e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = 32ab74c0-e515-e800-f111-31104c770494
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:32ab74c0-e515-e800-f111-31104c770494
msgctxt "he49b131ag3ea6g4d15gb8b0g93be6aa685b8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 407104a5-9018-d750-539f-f73b4c051709
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_State_PersuasionSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:407104a5-9018-d750-539f-f73b4c051709
msgctxt "hb18c01c5g40f8g4d41g886eg4a1b455c87f6"
msgid ""
"Fool. He always took orders too literally. Of course <i>you</i> can check "
"the cargo."
msgstr "바보 같은 자식. 놈은 언제나 명령을 곧이곧대로 받아들이곤 했죠. 물론 <i>당신은</i> 화물을 확인하실 수 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 47b8af48-975a-5fe4-8d13-8f9b3a3504f9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_State_ReportJump = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:47b8af48-975a-5fe4-8d13-8f9b3a3504f9
msgctxt "hca74e9feg2397g4bd2gb27ega21da5a814a5"
msgid "We're not supposed to leave the cargo un-... oh."
msgstr "화물이 있는 곳을 떠날 수는... 오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = 499ca14a-c0da-e59a-90f2-24081a22ccf7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_State_TalkedAboutJumper(1) = False
#.   Global:
#.      - MOO_Docks_Event_GuardJumped = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_State_TalkedAboutJumper(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:499ca14a-c0da-e59a-90f2-24081a22ccf7
msgctxt "h488d0c9fgbe4cg45a6g828fgaeef670f0bd6"
msgid "Your soldier abandoned his post. You'd best go report it."
msgstr "병사 중 하나가 위치를 벗어났다. 가서 보고라도 하는 게 어때."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 49c25a45-4582-7ae9-679b-e73756fb1636
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:49c25a45-4582-7ae9-679b-e73756fb1636
msgctxt "hf44a7c0cg0db2g4529ga3c9gfc3618b91b91"
msgid ""
"Just doing my job. They say the Absolute sees our work, and elevates the "
"worthy."
msgstr "할 일을 할 뿐입니다. 절대자께서는 저희를 지켜보시고, 가치 있는 자는 승급시켜주신다고 하더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 65a2117f-e1c8-f075-9f5c-f6cf04e82262
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:65a2117f-e1c8-f075-9f5c-f6cf04e82262
msgctxt "h25ec1d45g000cg41b0g950dg54b8ae25f873"
msgid "<i>Thank</i> you."
msgstr "<i>감사</i>합니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = 6ed2dbe7-31bf-8fd2-5329-8676727b1dc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:6ed2dbe7-31bf-8fd2-5329-8676727b1dc3
msgctxt "hc4da50aag6940g4be0g93a4g5af731212268"
msgid "I showed him the truth of the tadpoles you're shipping."
msgstr "너희가 운송하는 올챙이에 대한 진실을 보여줬지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 77e49329-f44b-fc3b-9328-0f73f2ea5605
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_HasMet_OberverTadpolePowers(1) = True
#.   Object:
#.      - MOO_Docks_State_GuardWitnessTrueSoul(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:77e49329-f44b-fc3b-9328-0f73f2ea5605
msgctxt "h3a31645bgb956g4d68ga23fgd2047d395f27"
msgid "Aye, True Soul?"
msgstr "예, 참된 영혼?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 79089bcb-f46d-3efa-aff6-4dbba8d703f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:79089bcb-f46d-3efa-aff6-4dbba8d703f8
msgctxt "h94139736g9e18g4246g8e47g4dbfa0619637"
msgid "...Eh, <i>respectfully</i>, True Soul."
msgstr "...어, <i>주십시오</i>, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = 793981bd-fab9-d0c7-3516-814abf8f8779
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:793981bd-fab9-d0c7-3516-814abf8f8779
msgctxt "h997fa7cbgf8cdg4b90gb2b1g11ecc7eb2c94"
msgid "Tell me why you're shipping tadpoles to the city."
msgstr "왜 올챙이들을 발더스 게이트로 수송하는지 말해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 83731d19-f34a-a3ae-f2c9-d9e3123967f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_State_ObserverWitnessDamage = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:83731d19-f34a-a3ae-f2c9-d9e3123967f3
msgctxt "hffab4242g9adag49fbgb643g084391fcdfd8"
msgid "Ah, sorry True Soul. Cargo's been tampered with - I'd best see to it."
msgstr "아, 미안합니다, 참된 영혼. 화물에 누가 손을 댄 모양인데, 확인해 봐야겠어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = 853876e3-e46b-f715-e063-7dab516fcb32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:853876e3-e46b-f715-e063-7dab516fcb32
msgctxt "h70afd89cg429eg4227gadc6g6bb7261754cd"
msgid "You definitely have the attitude of a True Soul, at least."
msgstr "적어도 네 태도만큼은 참된 영혼 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = 87ced0b9-710c-73b1-1707-947e597b1da0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:87ced0b9-710c-73b1-1707-947e597b1da0
msgctxt "h87e39f57g5fd2g48c5gb8f4gd82a024199ac"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 904d8458-352c-65c9-9cd8-357609ec7971
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:904d8458-352c-65c9-9cd8-357609ec7971
msgctxt "hed69f277gaaceg4a3dgb9e9g62a2d0b8a2e0"
msgid "Beg pardon, True Soul - but you're distracting me."
msgstr "용서하십시오, 참된 영혼. 하지만 절 방해하고 계십니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 90fab6ff-3a82-2ee4-e319-f2cdd5c000cd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_State_PersuasionSuccess = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:90fab6ff-3a82-2ee4-e319-f2cdd5c000cd
msgctxt "hfc8d67abg8e84g4279g8d05g08fe82696c22"
msgid ""
"No, True Soul. Not I. Too busy doing my job. Which... I'll get back to, aye?"
msgstr "아니요, 참된 영혼. 별로 못합니다. 일하느라 바쁘거든요. 그니까... 다시 일하러 가 볼게요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 93ea7f6f-0c0c-6ebd-7cce-6b7571448f3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_HasMet_DockObserver(1) = True
#.      - MOO_Docks_State_TalkedAboutJumper(1) = False
#.   Global:
#.      - MOO_Docks_Event_GuardJumped = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:93ea7f6f-0c0c-6ebd-7cce-6b7571448f3d
msgctxt "h6b6ee4adg24b1g448agaf63g9b25e65fd867"
msgid "Aye?"
msgstr "예?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 953a2cf0-f3ed-6c81-3622-82c157292a5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:953a2cf0-f3ed-6c81-3622-82c157292a5a
#, fuzzy
msgctxt "h44edfdc6g5aa6g400bg9c04g1a0057e7b3f9"
msgid "Good riddance. He deserved it! ... whatever he did."
msgstr "잘 됐다. 꼴 좋군요! ...그놈이 뭘 했던 간에 말입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = 95f356ca-d30c-f81e-87fa-8182dca99110
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:95f356ca-d30c-f81e-87fa-8182dca99110
msgctxt "hb09808acg125fg471ag8292g36a080d24ba5"
msgid "And I don't plan on being a guard for long, <i>True Soul.</i>"
msgstr "그리고 저는 오래 보초 노릇을 할 생각은 없습니다, <i>참된 영혼.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = a2a64bf2-5223-8005-0be7-6d798f3f0048
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:a2a64bf2-5223-8005-0be7-6d798f3f0048
msgctxt "h8555fdb8gda3eg42a9g86edge53db87083d9"
msgid "What's so important about these boxes?"
msgstr "이 상자들이 뭐가 그렇게 중요한 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = a80cd006-5ebb-b18e-c0d5-e5c34e4f2846
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:a80cd006-5ebb-b18e-c0d5-e5c34e4f2846
msgctxt "h8f5ccfc0g6affg42d8g9091g8155e2bfaa6b"
msgid "Please. Be my guest."
msgstr "자. 뜻대로 하시지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = a8dfbb7e-c6c1-f2e1-0d65-643099237081
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:a8dfbb7e-c6c1-f2e1-0d65-643099237081
msgctxt "h61417998gb771g40d2g9fafgcb62c578529d"
msgid "I'm not <i>hearing </i>much respect."
msgstr "그닥 예의있게 <i>들리진</i> 않는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = acb67a60-cdeb-4075-bfc3-f48feff3a79c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_HasMet_DockObserver(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_HasMet_DockObserver(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:acb67a60-cdeb-4075-bfc3-f48feff3a79c
msgctxt "h35019436g3164g483dgac08ge5557f257e47"
msgid "<i>Stand clear of the cargo!</i>"
msgstr "<i>화물에서 물러나!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = c01715b5-4c4b-8bf7-945f-a87ee21bc70a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:c01715b5-4c4b-8bf7-945f-a87ee21bc70a
msgctxt "h025b3b09g49c3g4588gba49g8f0ddca7fa97"
msgid ""
"<i>What? </i>Beshaba's black bones - wait here. I'll find something to drag "
"him out."
msgstr "<i>뭐라고요? </i> 베샤바의 검은 뼈같으니 - 여기서 기다려 주십시오. 뭔가 끌어올릴만 한 걸 찾아오겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = eede56d6-a6b0-286a-aa4b-c11319b6ed74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#.      - MOO_Docks_Event_GuardJumped = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:eede56d6-a6b0-286a-aa4b-c11319b6ed74
msgctxt "hfb4942e8gc68dg41d1gb195gb1a0ae060d19"
msgid "Tell me why you're shipping tadpoles to the city."
msgstr "왜 발더스 게이트로 올챙이를 운송하는 건지 말해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = f6c00e69-17ca-d89b-7f06-1cd6b8e2ceb8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_State_ReportJump = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:f6c00e69-17ca-d89b-7f06-1cd6b8e2ceb8
msgctxt "hb353358cg1b22g4a47g9d7fgd890e310777c"
msgid "Not letting a decent suit of armour rot down there on my watch."
msgstr "멀쩡한 갑옷 한 벌이 저 밑에서 썩어가게 둘 순 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = f7ac20fd-4cce-7074-1926-0258e5ed2687
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_State_ReportJump = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:f7ac20fd-4cce-7074-1926-0258e5ed2687
msgctxt "h4f20fd24g2050g43dcgb437g6aa986d5be37"
msgid ""
"I'm just a soldier. Which, speaking of... I'd best go report my man missing. "
"If you'll excuse me..."
msgstr "전 그저 군인입니다. 말이 나왔으니 말인데... 제 동료가 사라진 걸 보고해야겠습니다. 그럼 실례하겠습니다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = fb706b7e-fd33-0b69-4549-bf9ca7abb119
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:fb706b7e-fd33-0b69-4549-bf9ca7abb119
msgctxt "h083ba4f5gc0e5g476fg9aa9g1e96cdb67d3c"
msgid "Are you much of a swimmer?"
msgstr "너는 수영 잘 하나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Player
#. NodeID = fbdd1aea-38aa-699a-0cdd-5a9800a6370c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:fbdd1aea-38aa-699a-0cdd-5a9800a6370c
msgctxt "h256b9477g4c72g4820gae1ag84debf383279"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver
#. Speaker = Zealot Arden
#. NodeID = fe24d6ed-d15f-48eb-2e7b-e4ce2108a12c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardObserver:fe24d6ed-d15f-48eb-2e7b-e4ce2108a12c
msgctxt "hef604f2ega597g4c94g8211g9e3535656e96"
msgid ""
"...Tadpoles? Like... a delicacy? I wouldn't know much about that, True Soul."
msgstr "...올챙이요? 그... 미식가들이 먹는 거? 그건 잘 모르겠습니다, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller000
#. Speaker = Zealot Renan
#. NodeID = 33a80ed4-47b1-415e-92cd-61f9fa1d96fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller000:33a80ed4-47b1-415e-92cd-61f9fa1d96fd
msgctxt "h47b00c2cg89d8g4106g9e89ga11de4c73bfb"
msgid ""
"Hold your nose 'round the crates. Some got a little ripe down in the cellar."
msgstr "상자 주위에선 냄새 맡지 마. 몇 개가 저장고에서 좀 숙성됐거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller000
#. Speaker = Zealot Renan
#. NodeID = 4dc74993-3c96-357a-990d-2809230741e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_HasMet_Patroller000TadpolePower(1) = False
#.   Object:
#.      - MOO_Docks_State_GuardWitnessTrueSoul(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_HasMet_Patroller000TadpolePower(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller000:4dc74993-3c96-357a-990d-2809230741e1
msgctxt "h2447f678g4706g497bg8a68gf65bef8d6fce"
msgid ""
"Shame about Marls. But the Absolute breaks those that don't truly believe, I "
"suppose."
msgstr "말스 일은 참 유감입니다. 하지만 진정으로 믿지 않는 자를 처단하는 것도 절대자님의 뜻이겠지요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller000
#. Speaker = Zealot Renan
#. NodeID = 4e79383c-1eb4-4e1b-8164-e78a31f254ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_HasMet_DockPatroller000(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_HasMet_DockPatroller000(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller000:4e79383c-1eb4-4e1b-8164-e78a31f254ca
msgctxt "h483fbadagee0dg404bgbed6g322b59388b23"
msgid "Feel free to haul a few boxes. We need all the hands we can get."
msgstr "괜찮으면 상자 몇 개 좀 옮겨 줘. 도움이란 도움은 다 필요하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller000
#. Speaker = Zealot Renan
#. NodeID = ddfdad70-9970-e79e-e69a-a09a7db4ea45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_HasMet_Patroller000TadpolePower(1) = True
#.   Object:
#.      - MOO_Docks_State_GuardWitnessTrueSoul(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller000:ddfdad70-9970-e79e-e69a-a09a7db4ea45
msgctxt "h9d1a97f1g0e04g4964ga200gabe0e3d2af3e"
msgid "You won't find my faith lacking, True Soul. I'll do anything for Her."
msgstr "제 신앙심은 완전합니다, 참된 영혼. 전 그분을 위해선 무엇이든 할 수 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller001
#. Speaker = Adept Bel
#. NodeID = 288a9421-e631-e24e-c487-5f32c4e9b6e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_HasMet_Patroller001TadpolePowers(1) = True
#.   Object:
#.      - MOO_Docks_State_GuardWitnessTrueSoul(0) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller001:288a9421-e631-e24e-c487-5f32c4e9b6e6
msgctxt "he6b28c01g1f11g4551ga925g73a21eea0818"
msgid "By your leave, True Soul."
msgstr "실례했습니다, 참된 영혼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller001
#. Speaker = Adept Bel
#. NodeID = 4be2933f-8ce0-47df-9ca6-1f086184e5e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller001:4be2933f-8ce0-47df-9ca6-1f086184e5e5
msgctxt "he104b104ga355g447fgacc5g831defbaa5e1"
msgid "Go on then, budge."
msgstr "그럼 가 봐, 움직이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller001
#. Speaker = Adept Bel
#. NodeID = 4f4aeec6-0a46-44a9-a820-79434ca25d02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_HasMet_DockPatroller001(1) = False
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_HasMet_DockPatroller001(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller001:4f4aeec6-0a46-44a9-a820-79434ca25d02
msgctxt "hc94044fag5d50g4ec5gbba4g8315f7d8bc05"
msgid ""
"Look busy or they'll set you lifting too. And whatever's inside is heavy."
msgstr "바쁜 척 안 하면 너한테도 거들라고 할 거야. 뭔지는 몰라도 무거운 게 들어있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller001
#. Speaker = Adept Bel
#. NodeID = b8105f85-8a99-3834-9d4e-1027202e6b16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_HasMet_Patroller001TadpolePowers(1) = False
#.   Object:
#.      - MOO_Docks_State_GuardWitnessTrueSoul(0) = True
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_HasMet_Patroller001TadpolePowers(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_GuardPatroller001:b8105f85-8a99-3834-9d4e-1027202e6b16
msgctxt "ha51fc820g7cebg41e0gbadag84cc39c49897"
msgid "Whatever Marls did, I had no part in it."
msgstr "말스가 무슨 짓을 했든, 전 아무 관련 없어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat
#. Speaker = Player
#. NodeID = 32f3f45e-ff8d-4d75-a127-a34e48623e3b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat:32f3f45e-ff8d-4d75-a127-a34e48623e3b
msgctxt "h83eb623eg563bg4febg85bdga117579f948e"
msgid "These parasites have some grim purpose to fulfil."
msgstr "이 기생충들에게는 뭔가 음흉한 목적이 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat
#. Speaker = Player
#. NodeID = 32f3f45e-ff8d-4d75-a127-a34e48623e3b
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat:32f3f45e-ff8d-4d75-a127-a34e48623e3b
msgctxt "h0b427c66g480dg424bg9c31gc72d24da6a67"
msgid "Be a shame if these never made it onto the ship..."
msgstr "이것들이 배에 실리지 못하게 된다면 참 유감이겠군..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat
#. Speaker = Player
#. NodeID = bfc1f3ca-4eec-45f9-b133-9ac42d392c26
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat:bfc1f3ca-4eec-45f9-b133-9ac42d392c26
msgctxt "hb54e3ddcg5586g456egad76gd56b5058a0cc"
msgid "Filled to the top with tadpoles... Must be hundreds in there."
msgstr "올챙이들로 가득 차 있군... 수백 마리는 되겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat
#. Speaker = Player
#. NodeID = bfc1f3ca-4eec-45f9-b133-9ac42d392c26
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat:bfc1f3ca-4eec-45f9-b133-9ac42d392c26
msgctxt "hb2e6786cg2511g4c99g857bg109934d0c88a"
msgid "Are these... parasites? There must be hundreds!"
msgstr "이게 다... 기생충인 건가? 수백 마리는 되겠어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat
#. Speaker = Player
#. NodeID = eb83d1f7-06ee-40d3-a8d2-b5c0632e736d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat:eb83d1f7-06ee-40d3-a8d2-b5c0632e736d
msgctxt "h59437b60gb226g4be3gb244g9cb6c0410860"
msgid "Somehow I doubt they're being bred for their companionship."
msgstr "단순히 좋아서 사육하는 건 아닌 것 같은데 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat
#. Speaker = Player
#. NodeID = eb83d1f7-06ee-40d3-a8d2-b5c0632e736d
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_PAD_Vat:eb83d1f7-06ee-40d3-a8d2-b5c0632e736d
msgctxt "h41062206gb04dg484bg801bg16d1688c4c0f"
msgid "Whatever the cult is planning - it's nothing good."
msgstr "뭘 꾸미고 있는지는 몰라도, 좋은 일은 아닌 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Karlach
#. NodeID = 0cc3f512-f664-45d6-9d4c-43c5b3b22030
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:0cc3f512-f664-45d6-9d4c-43c5b3b22030
msgctxt "hc1e34ef1gdedbg4a97g8117g95f78169dec3"
msgid "Look at all those tads. Enough to make an army of Absolutists."
msgstr "저 올챙이 수 좀 봐. 절대자 군대를 만들 수도 있겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = 15d46e51-1354-3821-e221-a174973164ae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - MOO_Docks_State_FailedInvestigateVat(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:15d46e51-1354-3821-e221-a174973164ae
msgctxt "h4ad873d0g12c9g4a4ag8705g38b8a3fde048"
msgid ""
"*There is no ledger to hint at a destination. Only a seal stamped on the "
"lid, unknown to you.*"
msgstr "*목적지를 알리는 장부는 없습니다. 뚜껑에 당신이 알아보지 못하는 도장이 찍혀있을 뿐입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = 196e9e54-5615-3cb6-2929-8b932b0c62b6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - MOO_Docks_State_FailedInfluence(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:196e9e54-5615-3cb6-2929-8b932b0c62b6
msgctxt "hdd090631gf1dag45eag917cg29c44e7115fa"
msgid ""
"*A mental churning as your interference stokes the tadpoles into a boiling "
"frenzy. The connection snaps.*"
msgstr "*당신의 개입이 올챙이들을 광란의 상태로 몰자 정신이 뒤틀리고 연결이 갑작스레 끊어집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Wyll
#. NodeID = 1ccd0429-d968-a220-c02e-29a555347193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:1ccd0429-d968-a220-c02e-29a555347193
msgctxt "h775672e5gb405g4515gbcbcga150c5a5b079"
msgid "No. Annihilation is the only option."
msgstr "아니다. 말살만이 답이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Karlach
#. NodeID = 2dbadd00-1922-4bb3-a012-e3dd73d23aaf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:2dbadd00-1922-4bb3-a012-e3dd73d23aaf
msgctxt "h61e9e42cg3c9dg46dagb50ag3d7c97a44298"
msgid ""
"It's not too late to stop the cult from using these things. Now's our chance "
"to change them - or fry 'em."
msgstr "아직 교단이 이것들을 사용하는 걸 막을 수 있어. 지금이 이것들을 바꿀 기회야. 아니면 구워버리든지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = 2f357203-c40e-8d5e-90b6-a2ecb43fd862
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_Vat_Knows_Zhentarim = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:2f357203-c40e-8d5e-90b6-a2ecb43fd862
msgctxt "hf9f3cfcbg8bebg482agba91gc5b056a535e9"
msgid ""
"*No ledger or shipping manifest presents itself - but there is a seal "
"stamped on the lid.*"
msgstr "*장부나 운송 목록은 전혀 보이지 않으나, 뚜껑에 도장이 하나 찍혀 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Lae'zel
#. NodeID = 375f7241-90d5-4c79-baa6-008e84cc8098
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:375f7241-90d5-4c79-baa6-008e84cc8098
msgctxt "h9d8c7059gc589g4aeagaec4g98ef10061e31"
msgid ""
"Empty. Void of essence, void of purpose. We <i>cannot</i> allow their birth."
msgstr "텅 빈 채, 생기도, 목표도 없는 존재로다. <i>절대로</i> 태어나게 두어선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = 46058519-8094-4b9f-9c87-32e142ffd6d7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Zhentarim_Knows_Zhentarim = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:46058519-8094-4b9f-9c87-32e142ffd6d7
msgctxt "hde492d0egc96cg4bd9gb790gf7b10daaf848"
msgid ""
"*The winged serpent of the Zhentarim - a network of merchant and "
"mercenaries, known for their deep pockets and shallow scruples.*"
msgstr "*막대한 재력은 있지만 양심은 없는 것으로 알려진 상인과 용병 네트워크, 젠타림의 상징인 날개 달린 뱀입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Shadowheart
#. NodeID = 5c1264b1-d730-47f4-b88e-d484e6728a86
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:5c1264b1-d730-47f4-b88e-d484e6728a86
msgctxt "hab201ec3g4448g4e7egac2bg4d55a4d81342"
msgid "Look at them all... enough to infect an entire army."
msgstr "저것들 좀 봐... 군 전체를 감염시키기에 충분한 양이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = 62de6fa3-0595-cda1-7afc-d37f0e965fe1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Zhentarim_Knows_Zhentarim = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:62de6fa3-0595-cda1-7afc-d37f0e965fe1
msgctxt "hdac2719bg723fg4a01gb5aagb6ca1b630595"
msgid ""
"*The winged serpent of the Zhentarim. It seems their pursuit of profit "
"extends even here.*"
msgstr "*젠타림의 표식인 날개달린 뱀입니다. 이윤을 위해 이곳까지 사업을 확장했나 봅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Wyll
#. NodeID = 78b03a8e-3ecd-4f0c-b166-075cb66a485f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:78b03a8e-3ecd-4f0c-b166-075cb66a485f
msgctxt "hab26b2a5ga444g4075g8b33g5af17f677662"
msgid "They came from below. We could destroy them, or perhaps..."
msgstr "이것들은 타워 아래에서 왔어. 없애버리든지, 아니면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Gale
#. NodeID = 7e452052-990c-4392-87da-7ec0aad1ecea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:7e452052-990c-4392-87da-7ec0aad1ecea
msgctxt "h212a253eg7774g4ec5g86a5g49c8600e31d8"
msgid "Burn them, I say. Burn them all."
msgstr "태워버리자. 싹 태워버리자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Shadowheart
#. NodeID = 8c95c371-4765-4ba3-9697-8f66ec23686a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:8c95c371-4765-4ba3-9697-8f66ec23686a
msgctxt "h0e4a5864gcaeeg41f3gb54cg1ff0879c7623"
msgid ""
"These tadpoles came from beneath the tower. If we use them, we'll deny the "
"cultists of their power."
msgstr "탑 밑에서 온 올챙이들이야. 우리가 사용한다면, 광신도들이 쓸 힘을 대신 빼앗는 거겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = 9633862f-93ed-410e-9ab8-bb3f81fd5568
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_State_InfluenceTadpoles = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:9633862f-93ed-410e-9ab8-bb3f81fd5568
msgctxt "h09fba41dg1b51g4578gb705ga792d3819278"
msgid ""
"*A pattern of blank minds, newly born. They carry only a bare shred of "
"memory, inherited from something older.*"
msgstr "*새로 태어난 것이 지닌 텅 빈 정신. 이것들은 더 오래된 것으로부터 물려받은 기억의 단편만을 지니고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Gale
#. NodeID = 9a816918-0ccb-4960-8646-a219be66f884
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:9a816918-0ccb-4960-8646-a219be66f884
msgctxt "hdfcdd8bega7bag49d1gb103gad6da5783342"
msgid ""
"These tadpoles come from an ancient colony down below the tower. Whatever we "
"do with them, we must deny their use to the Absolute."
msgstr "이 올챙이들은 탑 아래에 있는 오래된 군락지에서 왔어. 우리가 뭘 하든, 절대자가 이걸 손에 넣는 일은 결코 없어야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = 9c366854-3536-3413-22f4-913b35cc859f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_State_FailedInfluence(1) = True
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:9c366854-3536-3413-22f4-913b35cc859f
msgctxt "hd99a6d5dgef01g45b0ga203g210a4516faa7"
msgid ""
"*Your tadpole squirms and shrinks away - inside the vat is a churning mass "
"you can do nothing to quell.*"
msgstr "*당신의 올챙이가 움츠러들더니 물러납니다. 통 안에는 당신이 결코 진정시킬 수 없는 수많은 벌레가 떼로 꿈틀대고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = 9f89f3fe-53b3-4bee-ad91-2988ae13475c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_Knows_TadpoleVats = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:9f89f3fe-53b3-4bee-ad91-2988ae13475c
msgctxt "hfb32a6a1g0bf7g4311g8c11ga15f7a4a437c"
msgid "*A wave of sick familiarity radiates from one barrel amidst the cargo.*"
msgstr "*화물 중에 한 통에서 이젠 넌더리 나는 친숙한 파동이 퍼져나옵니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = b2d724c7-432c-452e-9c5b-f75d9522c676
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - MOO_Docks_Knows_TadpoleVats = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:b2d724c7-432c-452e-9c5b-f75d9522c676
msgctxt "h1883ba83g5e9cg4dbdg97c1g1690dce2a896"
msgid ""
"*Tadpoles. Sleeping and scarcely aware, but echoing yours a hundredfold.*"
msgstr "*올챙이들. 잠들어 있으며 의식이 거의 없지만 머릿속의 동족을 엄청나게 울려대고 있습니다. *"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Player
#. NodeID = b6706164-7088-48a3-b52f-0508602e4045
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:b6706164-7088-48a3-b52f-0508602e4045
msgctxt "h7bca442cg3726g4822g8300gd7250f35238a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Wyll
#. NodeID = b9af82e3-1993-463a-b4df-b21b712c044d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:b9af82e3-1993-463a-b4df-b21b712c044d
msgctxt "h668d9fc7g2a0ag4f7cg8cfcg9bdfabae01bb"
msgid "Holy hells. Each one, a mind flayer in waiting."
msgstr "맙소사. 한 마리 하나하나가 전부 미래의 마인드 플레이어야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Player
#. NodeID = c4a7fd9b-cf25-5ffd-442a-f6c826239694
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 16
#. CheckFlags:
#.   Global:
#.      - GLO_Zhentarim_Knows_Zhentarim = False
#.   Object:
#.      - MOO_Docks_State_FailedInvestigateVat(1) = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:c4a7fd9b-cf25-5ffd-442a-f6c826239694
msgctxt "hf6d7b123gc7b1g4605g86d2g04938ce49985"
msgid "<i>Examine the barrel.</i>"
msgstr "<i>통을 조사한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = c7d07268-3ea5-b6e2-1db7-1801522d3a41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Bazaar_Zhent00_ConfrontedAboutCargo(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:c7d07268-3ea5-b6e2-1db7-1801522d3a41
msgctxt "hdad575bag1496g485bg8209g9a74fb73b40c"
msgid ""
"*The winged serpent of the Zhentarim. These must be the 'goods' that Roah "
"agreed to move into the city.*"
msgstr "*젠타림의 날개 달린 뱀. 이건 로아가 도시로 운송하기로 약속한 '물건'이 분명합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = cb20bb77-2906-c921-24a9-c26bc10fb3d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#.      - MOO_Docks_State_InfluenceTadpoles = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:cb20bb77-2906-c921-24a9-c26bc10fb3d3
msgctxt "h2219eb3fg431ag49efg9396g2c0c34935921"
msgid ""
"*The vat is still, placid - thousands of tadpoles happily awaiting their "
"hosts.*"
msgstr "*용기는 고요하고 평온합니다. 수천 마리의 올챙이들이 기쁘게 숙주를 기다리고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Astarion
#. NodeID = d15ef8d5-8cd8-4008-996e-b3ea3911ae45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:d15ef8d5-8cd8-4008-996e-b3ea3911ae45
msgctxt "he3c5ec25ga56eg4e14ga6f2g5ad55f141f78"
msgid ""
"They don't know what they are - not yet. Unless we taught them to be "
"something else..."
msgstr "자기가 무엇인지도 모르는 것들이야. 아직은. 우리가 다른 것이 되도록 가르칠 수 있을지도..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = e0b06e98-1166-a4ce-aed4-564fc7789d3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:e0b06e98-1166-a4ce-aed4-564fc7789d3e
msgctxt "h17aad35fgf3b4g4e08g9c30gae06914db1ae"
msgid ""
"*A sleep of centuries, the birth and destruction of a settlement above "
"forming only background noise to the dream.*"
msgstr "*수 세기에 걸친 잠. 그 꿈에서 위쪽 정착지의 탄생과 파괴는 그저 잔잔한 소음에 불과했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Astarion
#. NodeID = eac90da9-8667-4a91-b499-5af56a9605ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:eac90da9-8667-4a91-b499-5af56a9605ce
msgctxt "h8a8c0214g11ceg4439g823bg24e40aa0a310"
msgid "There's so many. Enough for an army of mindless slaves."
msgstr "엄청나게 많군. 세뇌당한 노예 군대를 만들 수도 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = ee04628f-c2c5-ecaa-b208-229c62aef2db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:ee04628f-c2c5-ecaa-b208-229c62aef2db
msgctxt "h3dacb942gcf71g4ac8gb6a5g965f4ccf9263"
msgid ""
"*Until something descended down into the darkness... and the dreamer awoke.*"
msgstr "*하지만 무언가가 그 어둠 속으로 내려오자... 꿈에서 깨어났습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Lae'zel
#. NodeID = f412189d-0a37-435b-bad0-f4f8416a153d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:f412189d-0a37-435b-bad0-f4f8416a153d
msgctxt "hc0f750adga38dg4b3cgb41bgafda66135de0"
msgid "An army's worth of slithering parasites. Sickness, waiting to spread."
msgstr "군대를 일으키기에 충분한 수의 기생충이 꿈틀댄다. 퍼지기를 기다리는 질병이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Player
#. NodeID = f87f9038-dbfa-48b0-bd05-76e180f30a5a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_State_FailedInfluence(1) = False
#.   Global:
#.      - MOO_Docks_State_InfluenceTadpoles = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:f87f9038-dbfa-48b0-bd05-76e180f30a5a
msgctxt "h0ed5d6bdg6dd3g4cd0gb0d6ga9b70e457a12"
msgid "<i>Reach out, tadpole-to-tadpole.</i>"
msgstr "<i>올챙이 사이의 소통을 시도한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Player
#. NodeID = f8a5479b-8f69-3c83-368c-0e14c8d6f5bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Zhentarim_Knows_Zhentarim = True
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:f8a5479b-8f69-3c83-368c-0e14c8d6f5bb
msgctxt "hd5e8aa51ga5d6g44eega429gdffd7648a1dc"
msgid "<i>Examine the seal - it looks familiar to you.</i>"
msgstr "<i>익숙해 보이는 봉인을 조사한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat
#. Speaker = Narrator
#. NodeID = fd7e1df8-f577-a975-82d7-85fa24e38913
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - MOO_Docks_State_FailedInfluence(1) = False
#.   Global:
#.      - MOO_Docks_Knows_TadpoleVats = True
#.      - MOO_Docks_State_InfluenceTadpoles = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_Docks_Vat:fd7e1df8-f577-a975-82d7-85fa24e38913
msgctxt "hef57d83cg27cfg47f1ga5c0g1bfdd8745f40"
msgid "*Your tadpole squirms, and feels a legion of echoes in response.*"
msgstr "*당신의 올챙이가 꿈틀대자 그 반응으로 엄청난 수의 메아리가 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_DriderCaravan_AD_GoingForBreak
#. Speaker = Warrior Gronag
#. NodeID = 28a84d80-d466-6a4a-2237-2fc01789a476
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_DriderCaravan_AD_GoingForBreak:28a84d80-d466-6a4a-2237-2fc01789a476
msgctxt "h056a470cg7ed2g48b1g9a3bge27985175b52"
msgid "Drink."
msgstr "그러자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_DriderCaravan_AD_GoingForBreak
#. Speaker = Sharp-Eye Lora
#. NodeID = 5910fe5f-8984-8d8f-da66-efb5b3de2917
#. HandlePath = TaggedText[0].TagText[0]
