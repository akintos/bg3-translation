msgctxt "h956a51cdg9d3fg4ed6g8b01g9453c69a3997"
msgid "In the dark again. Damn this curse."
msgstr "다시 어둠 속이군. 젠장 할 저주 같으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_ShadowCurse_PAD_LightsSnuffedOut
