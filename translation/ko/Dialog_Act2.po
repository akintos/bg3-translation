msgctxt "h97818c96gf7e0g4a58gaec8ga52da3014720"
msgid "There shall be dire consequences for this mistake."
msgstr "이 오판에는 분명 엄청난 대가가 따를 걸세."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 32471cbd-3f40-4796-8ee9-5f1ff275e673
