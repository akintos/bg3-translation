msgctxt "hdea726e5g6633g4871g8e3agc0d3323cae21"
msgid "NO! TAKE NO MORE!"
msgstr "<b>안돼! 더 가져가지 마</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon_InstrumentRequest_001_Combat
