msgctxt "h16c40cfdgcb14g4a38g8840g061355ff8f62"
msgid "Don't know how much longer I'll last in this darkness."
msgstr "이 어둠 속에서 내가 얼마나 버틸 수 있을지 모르겠는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 60a97c95-9f01-4aea-b7c1-2fbca8b731b7
