msgctxt "h6780af3fg1844g4ac8ga136g84e164df3261"
msgid "<i>Gaze at the statue.</i>"
msgstr "<i>석상을 가만히 바라본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_ObjectOfDarknessTrial
#. Speaker = Player
#. NodeID = 4c516674-8a50-4eac-994c-c67b86da8f15
