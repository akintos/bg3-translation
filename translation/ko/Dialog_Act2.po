msgctxt "h6f38821eg4dedg4c14gab19g86948a59571c"
msgid "*Hiss!*"
msgstr "*쉬익!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_LastJusticiar_RatsCalm
#. Speaker = Player
#. NodeID = 9838eebf-e630-5a92-f09f-9787e9c4cb55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
