msgctxt "hd1e2d734gaa68g4a56g9f1cg5dd5542cb891"
msgid ""
"I would like to dismiss "
"[HirelingName_2_c4187b58-a2f9-61d1-9899-e456945876fd]."
msgstr "[HirelingName_2_c4187b58-a2f9-61d1-9899-e456945876fd]을(를) 해고하고 싶습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Epilogue/SCE_Jergal_Debrief
