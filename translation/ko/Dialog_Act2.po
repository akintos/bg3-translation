#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_SurgeonPermaDefeated = True
#.   Local:
#.      - 7cb61031-a8dd-1d49-5052-621c7050c9cb_B = True
#. SetFlags:
#.   Local:
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_C = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:6c44406a-cbab-4b28-b656-f5f584ebc238
msgctxt "h8224e58bg11aeg4cc4ga631gde4c428805ab"
msgid "It will sting for just a moment, kitten. I promise."
msgstr "잠깐 따끔할 거예요, 아기고양이야. 약속해요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = 85f5b3b9-6451-4213-9bd5-b88fe7d0bd24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_SurgeonPermaDefeated = True
#. SetFlags:
#.   Local:
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_A = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:85f5b3b9-6451-4213-9bd5-b88fe7d0bd24
msgctxt "h23d5aa6eg485eg4a27g906ag5924460b6598"
msgid "Hush, little one. Dry your tears."
msgstr "쉿, 아가야. 눈물을 닦아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = 8ac380f3-299f-1c4b-ff98-3af15794c076
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD:8ac380f3-299f-1c4b-ff98-3af15794c076
msgctxt "h1299f483gee9dg4665g9787g6bf3e6e78130"
msgid "Here, darling. Let me soothe the pain."
msgstr "얘야, 내가 아픔을 달래줄게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_ZealousAssistant_003_AD
#. Speaker = Sister Anya
#. NodeID = a83c5d9b-b7ca-4dcf-ac93-e999c844f431
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TWN_Hospital_State_NursesKilledSurgeon = True
#.   Local:
#.      - 7cb61031-a8dd-1d49-5052-621c7050c9cb_B = True
#. SetFlags:
#.   Local:
#.     - 7cb61031-a8dd-1d49-5052-621c7050c9cb_C = True
