msgctxt "h67326716gb953g4006g8bceg4c2ea94c2e68"
msgid "Rolan! There you are."
msgstr "롤란! 여기 있었구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Haven/HAV_ProdigyLament_AD_SiblingsReturn
#. Speaker = Rolan
#. NodeID = a533c2d5-ae95-4981-bfb3-4524739be1cf
