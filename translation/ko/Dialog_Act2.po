#. SetFlags:
#.   Local:
#.     - f4169abb-abdc-be87-1a9d-91387440472c_B = False
#.     - f4169abb-abdc-be87-1a9d-91387440472c_A = False
#.     - f4169abb-abdc-be87-1a9d-91387440472c_C = False
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon:c9978e2b-ccba-af4b-7d24-2d5fad8cd5b5
msgctxt "h49ac597dg20bcg44b6gb269g89d80e00b329"
msgid "Only in absence is one healed."
msgstr "오직 부재 안에서만 치유받을 수 있나니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_AD_Surgeon
#. Speaker = Malus Thorm
#. NodeID = e45abfa8-d26d-9024-01ca-273392aa1dbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
