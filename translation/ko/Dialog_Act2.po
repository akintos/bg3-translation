msgctxt "hf49026cfg3b96g4f35g999fgdb0b54b0c10b"
msgid "Nearly there... have to keep going..."
msgstr "거의 다 왔어... 계속 가야 해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_Prayer
#. Speaker = Shadowheart
#. NodeID = 7ab02561-afe1-46c7-a5f2-00b3b62e9aa6
#. HandlePath = TaggedText[0].TagText[0]
