msgctxt "h134f1cbcgb0dfg4532gb49bge317036de5f1"
msgid "Ketheric's Netherstone - it's in his armour. Take it."
msgstr "케서릭의 네더스톤이 갑옷 안에 있어. 가져가야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_KethericShowdown_DaisyAD_ElderBrain
