#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_MyrkulSymbol:64f5eb25-9631-a3ab-2f07-2304ffbfaf0a
msgctxt "h6cae422eg07aag43a8g8abegc7d945aca6a2"
msgid "Myrkul was here. Or one of his fans, anyway."
msgstr "머큘이 왔었나봐. 아니면 그의 추종자가 남겼거나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_MyrkulSymbol
#. Speaker = Player
#. NodeID = 64f5eb25-9631-a3ab-2f07-2304ffbfaf0a
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Mausoleum_State_PassedMyrkulReligionCheck = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_MyrkulSymbol:64f5eb25-9631-a3ab-2f07-2304ffbfaf0a
msgctxt "h6d31019dg3295g4a25ga0ddg11d219ab9eff"
msgid "This is Myrkul's symbol. The Lord of Bones has touched this place."
msgstr "이건 머큘의 상징이군. 뼈의 군주가 이곳에 손길을 남겼어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_MyrkulSymbol
#. Speaker = Player
#. NodeID = 64f5eb25-9631-a3ab-2f07-2304ffbfaf0a
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Mausoleum_State_PassedMyrkulReligionCheck = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_MyrkulSymbol:64f5eb25-9631-a3ab-2f07-2304ffbfaf0a
msgctxt "h89e67671g47c0g4eebg8dd6gcbfbbde07c30"
msgid ""
"That's Myrkul's symbol. I suppose a mausoleum's a fitting place for the Lord "
"of the Dead."
msgstr "저건 머큘의 상징이야. 영묘는 망자의 군주에게 어울리는 장소인 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_MyrkulSymbol
#. Speaker = Player
#. NodeID = 64f5eb25-9631-a3ab-2f07-2304ffbfaf0a
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_Mausoleum_State_PassedMyrkulReligionCheck = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_MyrkulSymbol:64f5eb25-9631-a3ab-2f07-2304ffbfaf0a
msgctxt "he9fdf83ag4f3fg4331gacdag08adbebcc901"
msgid "Myrkul's symbol. The Lord of the Dead."
msgstr "머큘의 상징이군. 망자의 군주라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Mausoleum_PAD_MyrkulSymbol
#. Speaker = Player
#. NodeID = 64f5eb25-9631-a3ab-2f07-2304ffbfaf0a
