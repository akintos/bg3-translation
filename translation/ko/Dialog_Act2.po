msgctxt "h9dc1299dg1c9cg4a99g8549g541f62c5123a"
msgid "Looks like he's not all there - in more ways than one."
msgstr "이녀석 정신이 온전하지 않은 거 같아 - 육체적으로도 그렇지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_01
#. Speaker = Player
#. NodeID = 8c3c1f53-d336-48fd-835e-32163aa87534
