msgctxt "h6b2d6159g6038g4e62g94b3g40fddfe8199f"
msgid "The gore almost looks real. Superb! Encore!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Player
#. NodeID = 9c78907c-d6aa-9b08-6b54-d28d770bee6d
