msgctxt "hff5083aagfcecg4142g9cf6gd4d77714fb66"
msgid "Hopefully this will all be over soon."
msgstr "바라건대 이 사태도 곧 있으면 끝나겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
#. Speaker = Player
#. NodeID = 40afc622-dde1-4d54-9d6f-e491cb5ce3d2
