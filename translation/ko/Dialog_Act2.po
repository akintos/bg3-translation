msgctxt "he9262e40gf4dag4d6ega1d2g0fef7aedf987"
msgid "Why are you still in master's den?"
msgstr "왜 아직도 주인님의 둥지에서 어슬렁 거리는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Player
#. NodeID = e0829a11-b3c9-0985-b534-9df46bafff60
#. HandlePath = TaggedText[0].TagText[0]
