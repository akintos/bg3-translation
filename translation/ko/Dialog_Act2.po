#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Visage of Guilt
#. NodeID = 438a3bfd-51f0-0c16-2d5b-208bd165127e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:438a3bfd-51f0-0c16-2d5b-208bd165127e
msgctxt "h219438f2g8d1dg44feg9d0ege24441fda951"
msgid "My guilt is my payment. My debts, bottomless."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Player
#. NodeID = 47f6fd2d-8ad9-c2eb-1f84-a6488dc98437
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:47f6fd2d-8ad9-c2eb-1f84-a6488dc98437
msgctxt "h9dec943fgf564g41b5gb264gf2fef9d082cf"
msgid "Perhaps you'd feel less guilty if you paid for your crimes too."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Visage of Guilt
#. NodeID = 4aafdb3d-fbb7-066f-4595-3e8382926ccf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:4aafdb3d-fbb7-066f-4595-3e8382926ccf
msgctxt "h5d98f11fg7c63g4401g91b3g0a2da92d354a"
msgid "Yes - yes yes. Help me. Make me <i>pay</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Player
#. NodeID = 634ccebe-5c0b-872c-aef0-86e87ea5efbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:634ccebe-5c0b-872c-aef0-86e87ea5efbd
msgctxt "h3d7846eeg0eeeg4d23gacc1g86ec26b8e9fd"
msgid "Smart - the most precious things are often hidden deepest."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Player
#. NodeID = 745656c0-9441-f0e3-bde6-9fe8f55d16cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:745656c0-9441-f0e3-bde6-9fe8f55d16cb
msgctxt "h10d9e5dbg6967g4ecdg9da6g48ce35c3e06a"
msgid "People die all the time. Stop being dramatic, and get over it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Visage of Guilt
#. NodeID = 7f8c63bd-9cab-d672-60e0-e95709e1cc99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:7f8c63bd-9cab-d672-60e0-e95709e1cc99
msgctxt "h77dfe8d2g911ag4401gb089g8f3616297f48"
msgid "They paid a different price in the end."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Visage of Guilt
#. NodeID = 8a9d4ede-c14f-451a-ae2f-cd35a5908446
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:8a9d4ede-c14f-451a-ae2f-cd35a5908446
msgctxt "hc01c07a0gc645g40c4gb8dfg109efc91ebdb"
msgid "They paid more than their share."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Visage of Guilt
#. NodeID = 8c8bcd77-91d6-927d-ce7b-9852a77a3f38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:8c8bcd77-91d6-927d-ce7b-9852a77a3f38
msgctxt "hd0f3ad38g224fg4cc5gabe7gdcebd6933bce"
msgid "Yes, yes. I have gold. So much gold. Take it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Visage of Guilt
#. NodeID = 92b9b142-2d33-f7b5-4226-cc727feb722c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:92b9b142-2d33-f7b5-4226-cc727feb722c
msgctxt "h73f482e1g3b56g47b3gaf5bgab07a3eb8189"
msgid "That's what I thought. But I found nothing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Player
#. NodeID = aa8138e6-67db-31e9-978c-ba2116bae4d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:aa8138e6-67db-31e9-978c-ba2116bae4d2
msgctxt "h4e882740g9f93g40d3gb1a3g5ef8b972dd13"
msgid "No - there's always more to take."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Visage of Guilt
#. NodeID = ca8c2a3e-4111-a12c-3a72-bb00a1cdcf37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:ca8c2a3e-4111-a12c-3a72-bb00a1cdcf37
msgctxt "h3fcdf2b3g494dg4b39g94d2g3e896201c92b"
msgid "Some wouldn't pay their dues. Some couldn't."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Visage of Guilt
#. NodeID = d457859d-ccb2-9049-f0df-39055ff0d3cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:d457859d-ccb2-9049-f0df-39055ff0d3cd
msgctxt "h49491035g775fg4a60gbaa6g5bc3d8232354"
msgid "Yes. Many died - all for trying to pass. I took too much from them.\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Visage of Guilt
#. NodeID = da44bc13-d9c6-177b-5f25-d2d5be6bf6cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:da44bc13-d9c6-177b-5f25-d2d5be6bf6cb
msgctxt "h456ac921gff77g4ca9gba05gaf9f97c22185"
msgid "I opened them. Searched inside them."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Player
#. NodeID = e28e1473-500b-614c-10f8-fd738688bb9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:e28e1473-500b-614c-10f8-fd738688bb9e
msgctxt "h30b8a4d5gcfecg4cdcg96deg6552eb463fec"
msgid "That sounds like it might have proved fatal."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Visage of Guilt
#. NodeID = e82c5e43-d50b-9edf-7dd8-66fdf09465aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:e82c5e43-d50b-9edf-7dd8-66fdf09465aa
msgctxt "h892fff3bgbb4dg490egbde9gd6219c8b2947"
msgid "So many. <i>Too</i> many."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Player
#. NodeID = ed19afb0-6f6a-ad24-3ae0-083419c5e8ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:ed19afb0-6f6a-ad24-3ae0-083419c5e8ce
msgctxt "h0f5edd04g27aag49e4g8416g05d559de5e5c"
msgid "Yes. But I guess you didn't."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt
#. Speaker = Visage of Guilt
#. NodeID = fb77a8de-8c13-84ca-cdd0-b2ad4d1ff526
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Guilt:fb77a8de-8c13-84ca-cdd0-b2ad4d1ff526
msgctxt "hb34d00aeg46d4g4119gb1a6gbfbc1f84cb42"
msgid "Take it all, whatever the cost."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Heartlessness
#. Speaker = Visage of Heartlessness
#. NodeID = 0cab7842-e8cc-4edf-96a8-9ad18806177d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Tollhouse_HasMet_Heartlessness(1) = False
#. SetFlags:
#.   Dialog:
#.     - TWN_Tollhouse_HasMet_Heartlessness(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Heartlessness:0cab7842-e8cc-4edf-96a8-9ad18806177d
msgctxt "h05f82c90gaba9g470bg812dga8a68491217a"
msgid ""
"You'll find much of sentimental value among the confiscated goods. That is "
"to say - junk."
msgstr "압수품 중에서도 정서적인 가치가 큰 것들을 찾을 수 있지. 즉 - 고물이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Heartlessness
#. Speaker = Visage of Heartlessness
#. NodeID = 53ad2ccb-48fe-405f-b2ea-52f0b4d7cfc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Heartlessness:53ad2ccb-48fe-405f-b2ea-52f0b4d7cfc9
msgctxt "hf2302bc5g0a15g479cga7fcg47488eeee44e"
msgid ""
"People treasure the most insignificant things - pets, children, memories."
msgstr "사람들은 사소한 것을 보물처럼 여기곤 하지 - 반려동물, 자녀, 기억들."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Obedience
#. Speaker = Visage of Obedience
#. NodeID = 45a470e5-47e4-4e41-b508-19123326c9ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Tollhouse_HasMet_Obedience(1) = False
#. SetFlags:
#.   Dialog:
#.     - TWN_Tollhouse_HasMet_Obedience(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Obedience:45a470e5-47e4-4e41-b508-19123326c9ae
msgctxt "h6f676fbdg2514g48d9g8547g16d7b862a548"
msgid "Report to the tollmaster. Pay the toll."
msgstr "징수관을 만나세요. 통행료를 내세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Obedience
#. Speaker = Visage of Obedience
#. NodeID = 6d3004e8-ec87-4312-aac2-21ab277e763e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Obedience:6d3004e8-ec87-4312-aac2-21ab277e763e
msgctxt "hc91eeb3fgd27fg4175g9458g25e6d7d1e063"
msgid "No payment, no passage."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Regret
#. Speaker = Visage of Regret
#. NodeID = 761cb245-9685-46cc-926f-244b30598f32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - TWN_Tollhouse_HasMet_Regret(1) = False
#. SetFlags:
#.   Dialog:
#.     - TWN_Tollhouse_HasMet_Regret(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Regret:761cb245-9685-46cc-926f-244b30598f32
msgctxt "hfe1d0a7fg44e6g4f29g87cfg3dd8269e4529"
msgid "You should leave now. I should have left when I still could."
msgstr "지금 떠나세요. 저라면 떠났을 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Regret
#. Speaker = Visage of Regret
#. NodeID = f57ee8d5-552c-4c74-8ca7-6a0f67c54c0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_Face_Regret:f57ee8d5-552c-4c74-8ca7-6a0f67c54c0b
msgctxt "h6ec84a84g978eg49b2gbb8eg6adbae50e4ab"
msgid "So many ships came, so many ships left. And I remained."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Tollhouse_PAD_BlockedDoor
