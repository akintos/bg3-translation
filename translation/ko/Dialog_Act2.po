msgctxt "hcf949d30g4410g4dd1gbf84g747286cfe8da"
msgid "The curse is feeding on me - Shar's withdrawn her protection."
msgstr "저주가 날 먹어치우고 있어. 샤님이 보호를 철회하신 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shadowland/SCL_EntryPoint_PAD_Curse
#. Speaker = Player
#. NodeID = 60a97c95-9f01-4aea-b7c1-2fbca8b731b7
