msgctxt "he3ac9055ge507g456bg8c20g95486b02280b"
msgid "Rgrl. Gn - ungh. Ngh!"
msgstr "읍. 끙 - 음. 끄읍!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Patient
#. Speaker = Player
