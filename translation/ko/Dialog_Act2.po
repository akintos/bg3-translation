#.     - b693223e-c2c2-7219-7926-6cdbc4da95ce_C = False
#.     - b693223e-c2c2-7219-7926-6cdbc4da95ce_A = False
#.     - b693223e-c2c2-7219-7926-6cdbc4da95ce_B = False
#: Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_AD_BackToWork:5073c017-8ea9-4e16-9a5c-88144ce1c608
msgctxt "h988d66d5ga7bdg4740g8e6age720a4240985"
msgid "Clean paws, my loves. We want no more crunchy surprises in the stew."
msgstr "발바닥 깨끗이 해야지. 스튜에서 더 이상 돌이 나와서는 안 되잖니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KitchenFight_AD_FoodPrepComment
#. Speaker = Linsella
#. NodeID = 0a16b4bd-111b-4a04-b8da-1c349a463eae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ae02eeb5-f7ff-1acd-f876-094b74795d0f_A = False
