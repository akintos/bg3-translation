msgctxt "h3412cd3eg2d97g4509g9e2bg35b27bb54ff4"
msgid "Imbecile. I shall make dust of your bones."
msgstr "저능한 놈. 그 뼈를 가루로 만들어주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_Displacer
#. Speaker = Displacer Beast
