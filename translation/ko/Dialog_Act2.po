msgctxt "h010097c2g3c32g442agaaf0gfdbc4a281b1f"
msgid "Githyanki trouble! Githyanki trouble!"
msgstr "기스양키 문제야! 기스양키 문제야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2b/Intermezzo/INT_EmperorRevealed_AD_IntellectDevourer_Interaction
