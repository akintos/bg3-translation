msgctxt "h8ccb61efg88dfg45c6g97b3gac6500053327"
msgid ""
"There's a... big tent, funny costumes... circus! Yes, that's it... I was "
"going to the circus..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Blighted Actor
#. NodeID = d63e8a54-4ede-09cb-02be-6e986cde3717
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04:d63e8a54-4ede-09cb-02be-6e986cde3717
msgctxt "hb47b80d4g1bc2g4eb9gb937g7048ee7d0d01"
msgid ""
"I was... performing... and then the lights went out. I'm waiting for the "
"curtain call.\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Distillery_Brewer_Zombie_04
#. Speaker = Player
#. NodeID = da2e0889-2206-6881-5e43-d08d4dd629c7
