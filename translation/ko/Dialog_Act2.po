msgctxt "h74124b0fg5552g482dgade2g064c263c64b4"
msgid "*Whine.*"
msgstr "*낑낑.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/MoonriseTowers/MOO_KethericHound_AD_Patrol
