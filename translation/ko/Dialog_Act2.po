msgctxt "h02a9f996g2781g4078g8c11ga3a46e44f72e"
msgid "An eyepatch...?"
msgstr "안대...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch
#. Speaker = Player
#. NodeID = ac9e8214-30d4-d3d2-c814-435034cdda7b
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch:ac9e8214-30d4-d3d2-c814-435034cdda7b
msgctxt "h52430b2fgc5bbg401aga28egd323a6c8a9a0"
msgid "An eyepatch. Not quite my style."
msgstr "안대인데... 내 스타일은 아니군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch
#. Speaker = Player
#. NodeID = ac9e8214-30d4-d3d2-c814-435034cdda7b
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch:ac9e8214-30d4-d3d2-c814-435034cdda7b
msgctxt "h73c56871g33cbg466dgaf06g3e1faabf8d8c"
msgid ""
"Someone's lost their eyepatch - which means someone's lost an eye. I can "
"relate."
msgstr "누군가 안대를 잃어버렸어. 내가 느끼는 것처럼 이건 눈을 잃어버린 거랑 똑같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch
#. Speaker = Player
#. NodeID = ac9e8214-30d4-d3d2-c814-435034cdda7b
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch:ac9e8214-30d4-d3d2-c814-435034cdda7b
msgctxt "ha2df2cb8g0efeg4eecg8401g29ca6abbefcb"
msgid "Someone with a bum eye's missing their patch."
msgstr "눈이 엉덩이만큼 부은 사람이 안대를 흘리고 갔나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Colony/COL_Necromancer_PAD_MolEyepatch
#. Speaker = Player
#. NodeID = ac9e8214-30d4-d3d2-c814-435034cdda7b
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_JAHEIRA
