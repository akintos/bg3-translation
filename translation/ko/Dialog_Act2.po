#.     - TWN_Hospital_Reception_CorpseTender_TriedDruidDeception(1) = True
#: Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender:244cc52d-d64f-4ee1-c5c6-620f0ec49a78
msgctxt "h5c489fc7gc8eeg4363gb244g761152f32e12"
msgid ""
"Actually, the doctor requested my presence - I'm a master of natural remedy."
msgstr "사실은, 의사 선생님이 나더러 가보라고 한 거야, 난 자연 치유 전문가거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Town/TWN_Hospital_Reception_CorpseTender
#. Speaker = Shadowheart
#. NodeID = 2715904d-2331-6eac-c1e1-ebfb9ac370d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
