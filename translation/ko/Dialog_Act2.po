msgctxt "heca7ab06g1443g4423ga13dgab6dea0257b3"
msgid "I have vanquished your foes."
msgstr "당신의 적을 물리쳤나이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_Prayer
#. Speaker = Shadowheart
#. NodeID = c056d99b-93ae-49d7-b8b0-03a80e4ca545
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
