msgctxt "hda9f1b8egadb9g454agbd89g598897b935b8"
msgid "A light that bright cannot stay quenched."
msgstr "저토록 밝은 빛이 꺼진 채로 있을 리 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act2/Shar/SHA_NightsongPrison_PAD_NightsongsFateReaction_Solo
